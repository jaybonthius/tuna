; An unloaded importer is left alone when a module it imported reloads or
; loads again: it is recompiled only when it is loaded again, so it may no
; longer compile, or its file may be gone.
> (put-version! "base-1.sls" ".config/tuna/lib/base.sls")
> (put-version! "user-1.sls" ".config/tuna/lib/user.sls")
> (import (user))
> (user:h)
(1 g)
> (unload-owner! (module-owner '(user)))
> (put-version! "base-2.sls" ".config/tuna/lib/base.sls")
