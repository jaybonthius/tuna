; A terminal's buffer gives files:directory the folder its program last
; reported with OSC 7, so C-x C-f, M-!, M-s r and compile started from
; it start there.
> (import (echo-area) (file-picker) (shell-commands) (grep) (completion))
> (define (at path) (string-append (getenv "HOME") "/" path))
> (for-each (lambda (f) (mkdir (at f))) '("proj" "proj/src"))
> (with-output-to-file (at "proj/src/notes.txt") (lambda () (display "a needle in proj\n")))
> (define t (terminal:start (list "sh" "-c" (string-append "printf '\\033]7;file://localhost" (at "proj/src/../") "\\007'; sleep 30"))))
> (testing:wait-until (lambda () (equal? (terminal:directory t) (at "proj/"))))
> (list (terminal:directory t) (files:directory t))
("$HOME/proj/" "$HOME/proj/")
> (in-client (lambda () (layout:switch-to-buffer t)))
> (define (start! thunk) (spawn-task (lambda (restore) (in-client thunk))))
> (define (result task) (testing:wait-until (lambda () (eq? (task-state task) 'done))) (guard (c [#t (condition-message c)]) (testing:join task)))
> (define task (start! (lambda () (press! "C-x" "C-f"))))
> (testing:wait-until (lambda () (minibuffer:current-prompt)))
> (minibuffer:input (minibuffer:current-prompt))
"~/proj/"
> (press! "C-g")
! &cancelled
> (result task)
> (define task (start! (lambda () (commands:run shell-commands:shell-command "pwd" #f))))
> (result task)
> (echo-area:current-message)
"$HOME/proj"
> (define task (start! (lambda () (commands:run grep:grep))))
> (testing:wait-until (lambda () (minibuffer:current-prompt)))
> (in-client (lambda () (minibuffer:set-input! (minibuffer:current-prompt) "needle")))
> (define (texts s)
    (let ([ms (completion:session-matches s)])
      (map (lambda (k) (completion:text s (completion:matches-ref ms k))) (iota (completion:matches-count ms)))))
> (define s (in-client completion:current-session))
> (testing:wait-until (lambda () (and s (not (completion:session-busy? s)) (pair? (texts s)))))
> (texts s)
("src/notes.txt:1:a needle in proj")
> (press! "C-g")
! &cancelled
> (result task)
> (define task (start! (lambda () (commands:run shell-commands:compile "pwd"))))
> (result task)
#<buffer *compilation*>
> (define built (buffers:find "*compilation*"))
> (testing:wait-until (lambda () (runs:status built)))
> (list (runs:status built) (files:directory built))
(0 "$HOME/proj/")
; A terminal started in a folder written with ~ or .. records it with ~
; expanded and .. removed.
> (define u (terminal:start '("sleep" "30") (processes:options [directory "~/proj/src/.."])))
> (list (terminal:directory u) (files:directory u))
("$HOME/proj" "$HOME/proj/")
; A report of a folder that is not here is refused and the terminal keeps
; its folder; each folder taken runs terminal:directory-changed.
> (define changes '())
> (hooks:add! terminal:directory-changed (lambda (t) (set! changes (cons (terminal:directory t) changes))))
> (define v (terminal:start (list "sh" "-c" (string-append "printf '\\033]7;file://localhost/no/such/folder\\007reported\\n'; read x; printf '\\033]7;file://localhost" (at "proj/src") "\\007'; sleep 30")) (processes:options [directory "~/"])))
> (wait-for v "reported")
> (list changes (terminal:directory v))
(() "$HOME/")
> (terminal:send! v "\r")
> (testing:wait-until (lambda () (pair? changes)))
> (list changes (terminal:directory v))
(("$HOME/proj/src") "$HOME/proj/src")
; A kitty-shell-cwd:// path is taken as written, without percent
; decoding, as kitty's integration writes it.
> (mkdir (at "a%41b"))
> (define k (terminal:start (list "sh" "-c" (string-append "printf '\\033]7;kitty-shell-cwd://localhost" (at "a%%41b") "\\007'; sleep 30"))))
> (testing:wait-until (lambda () (equal? (terminal:directory k) (at "a%41b"))))
> (terminal:directory k)
"$HOME/a%41b"
