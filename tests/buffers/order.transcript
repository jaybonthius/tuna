; buffers:all gives the live buffers most recently used first. A new
; buffer goes at the end; moving one to the front or the back is a use.
> (define (raised thunk) (guard (c [#t (list (condition-who c) (condition-message c))]) (thunk)))
> (define (names) (map buffers:name (remp (lambda (b) (buffers:internal-name? (buffers:name b))) (buffers:all))))
> (define a (buffers:make "a" ""))
> (define b (buffers:make "b" ""))
> (define c (buffers:make "c" ""))
> (names)
("a" "b" "c")
> (buffers:move-to-front! c)
> (names)
("c" "a" "b")
> (buffers:move-to-back! c)
> (names)
("a" "b" "c")
> (buffers:move-to-front! b)
> (define d (buffers:make "d" ""))
> (names)
("b" "a" "c" "d")
> (buffers:kill! b)
#t
> (names)
("a" "c" "d")
> (raised (lambda () (buffers:move-to-front! b)))
(buffers:move-to-front! "not a live buffer")
> (raised (lambda () (buffers:move-to-back! 'a)))
(buffers:move-to-back! "not a buffer")
