; A read's first match waits for its setups, so a stream's first prefix
; is the input an outer setup gives, and the stream gets it once.
> (define given '())
> (define (recorder emit) (lambda (prefix) (unless (eof-object? prefix) (set! given (cons prefix given)))))
> (define t (start! (lambda ()
    (minibuffer:call-with-setup (lambda (p) (minibuffer:set-input! p "ab/"))
      (lambda () (completion:read "? " (list (completion:source (stream recorder) (split after-slash))) h))))))
