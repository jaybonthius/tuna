; A worker that imports a library, and a task that waits for a job's
; values.
> (jobs:define-worker (word-count text emit)
    (import (wordlib))
    (emit (word-count text)))
> word-count
#<worker word-count>
> (jobs:start word-count "to be or not" (lambda (n) (display n)))
#<job word-count>
> (sleep-for 0.1)
4
> (define (job-values worker input)
    (let ([results '()])
      (define (add! v) (set! results (cons v results)))
      (define (result ended)
        (if (condition? ended) (raise ended) (reverse results)))
      (suspend
        (lambda (resume)
          (jobs:start worker input add!
            (lambda (ended) (resume (lambda () (result ended)))))))))
> (job-values count-up 5)
(0 1 2 3 4)
; A body sees Chez's names and its imports only: not the REPL's, and no
