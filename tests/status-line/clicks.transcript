; A window's status line is drawn in the window's element of the layout,
; so a click on it is a mouse key in layout:screen-view at the window's
; atom. No buffer or view is made for it.
> (define notes (buffers:make "notes" "one\ntwo\n"))
> (views:set-buffer! (view) notes)
> (layout-split:split-view! (view) (layout-split:direction row))
#<view 3>
> (define windows (layout:views))
> (length (screen-status-lines client))
2
> (buffers:find " *status-line*")
#f
; A click with no segment keymap of its own is looked up in
; status-line:keymap, then at the window's atom: layout's keymap selects
; the clicked window. A click on a locked window's line selects nothing.
> (map (lambda (b) (cons (car b) (commands:command-name (cdr b)))) (keys:bindings status-line:keymap))
(("<mouse-2>" . status-line:mouse-reset-layout) ("<mouse-3>" . status-line:mouse-delete-view) ("<down-mouse-1>" . keys:ignore) ("<drag-mouse-1>" . keys:ignore))
> (layout:select! (car windows))
> (click-status! (cadr windows) 1)
