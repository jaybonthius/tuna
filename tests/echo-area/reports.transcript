; A condition that is a warning and also serious shows in the error face.
> (report (condition (make-warning) (make-error) (make-message-condition "both")))
! both
> (list (echo-area:current-message) (echo-area:face))
("both" #f)
> (echo-area-element)
"<div class=\"echo-area-message\" role=\"status\" data-face=\"error\"><div class=\"line\" id=\"v3-12\" data-line=\"1\" data-before=\"0\" data-at=\"1\">both</div></div>"
; A message that raises while the queue shows drops only its own report;
; the reports after it show at the next batch.
> (define (refuse-second message! format-string . vs)
    (if (equal? vs '("second"))
        (error 'notes:show "cannot show")
        (apply message! format-string vs)))
> (begin
    (for-each (lambda (m) (report (condition (make-error) (make-message-condition m)))) '("first" "second" "third"))
    (advice-add! echo-area:message! refuse-second)
    (void))
! first
! second
! third
! (echo-area) notes:show: cannot show
> (advice-remove! echo-area:message! refuse-second)
> (let ([log (messages)]) (substring log (- (string-length log) 41) (string-length log)))
"both\nfirst\nthird\nnotes:show: cannot show\n"
; A command's reports show as it ends, before the other after-command
; entries, and a report is logged even when the message that shows it
; logs nothing.
> (commands:define-command (fail) "Raises." (error 'notes:fail "no"))
> (keys:bind! keys:global "C-c f" fail)
> (define seen #f)
> (define (note-message command) (set! seen (echo-area:current-message)))
> (hooks:add! commands:after-command note-message)
> (press! "C-c" "f")
! notes:fail: no
> (hooks:remove! commands:after-command note-message)
> seen
"no"
> (begin
    (report (condition (make-error) (make-message-condition "quiet")))
    (options:with ([echo-area:log-max 0]) (echo-area:message! "unlogged"))
    (echo-area:current-message))
! quiet
"unlogged"
> (let ([log (messages)]) (substring log (- (string-length log) 21) (string-length log)))
"notes:fail: no\nquiet\n"
; An error raised where the log is off is logged all the same, as Emacs
; logs a command's error once its bindings unwind.
> (commands:define-command (quiet-fail) "Raises where nothing is logged."
    (options:with ([echo-area:log-max 0]) (error 'notes:quiet "lost")))
> (keys:bind! keys:global "C-c q" quiet-fail)
> (press! "C-c" "q")
! notes:quiet: lost
> (let ([log (messages)]) (substring log (- (string-length log) 18) (string-length log)))
"notes:quiet: lost\n"
