; Hooks follow every prompt; add-keymap! keys win while point is in the
; input; set-content! adds after it.
> (define seen '())
> (define (note what) (lambda (p) (set! seen (cons (list what (minibuffer:input p)) seen))))
> (define note-started (note 'started))
> (define note-changed (note 'changed))
> (define note-ended (note 'ended))
> (add-hook! minibuffer:prompt-started note-started)
> (add-hook! minibuffer:input-changed note-changed)
> (add-hook! minibuffer:prompt-ended note-ended)
> (define-table extra)
> (commands:define-command (shout) "Answers in capitals." (let ([p (minibuffer:current-prompt)]) (minibuffer:exit! p (string-upcase (minibuffer:input p)))))
> (keys:bind! extra "RET" shout)
> (define t (start! (lambda () (minibuffer:call-with-setup (lambda (p) (minibuffer:add-keymap! p extra) (minibuffer:set-content! p '("[list]"))) (lambda () (minibuffer:read "Name: "))))))
> (datums minibuf)
((minibuffer:%prompts () (minibuffer:prompt ((depth . 1)) (minibuffer:question () "Name: ") (minibuffer:input-field ()) "\n" (minibuffer:content () "[list]"))))
