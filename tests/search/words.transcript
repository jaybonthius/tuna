; A regexp's \w, \W, \b and \B follow the buffer's word characters:
; letters, digits and syntax:buffer-word-characters, $ and % in
; fundamental, where _ is a symbol character and not a word character.
> (define b (text-buffer "w" "user_id foo$x a-b\n"))
> (define (rx text) (all-in b (search:make-query text search:regexp)))
> (rx "\\w+")
((1 5 "user") (6 8 "id") (9 14 "foo$x") (15 16 "a") (17 18 "b"))
> (rx "\\buser\\b")
((1 5 "user"))
> (rx "\\bfoo\\b")
()
> (rx "o\\B")
((10 11 "o") (11 12 "o"))
> (rx "\\W")
((5 6 "_") (8 9 " ") (14 15 " ") (16 17 "-") (18 19 "\n"))
; In a class, \w adds the word characters and \W the others, negated or
; not; [\W] and [^\W] are the negation and the class.
> (rx "[\\w_]+")
((1 8 "user_id") (9 14 "foo$x") (15 16 "a") (17 18 "b"))
> (rx "[^\\w ]")
((5 6 "_") (16 17 "-") (18 19 "\n"))
> (rx "[-\\W]")
((5 6 "_") (8 9 " ") (14 15 " ") (16 17 "-") (18 19 "\n"))
> (rx "[^-\\W]+")
((1 5 "user") (6 8 "id") (9 14 "foo$x") (15 16 "a") (17 18 "b"))
> (equal? (rx "[\\W]") (rx "\\W"))
#t
> (equal? (rx "[^\\W]") (rx "\\w"))
#t
; An escaped backslash, \Q...\E and a comment leave \w alone.
> (define lit (text-buffer "lit" "a\\w \\Q\\w\\E\n"))
> (all-in lit (search:make-query "\\\\w" search:regexp))
((2 4 "\\w") (7 9 "\\w"))
> (all-in lit (search:make-query "\\Q\\w\\E" search:regexp))
((2 4 "\\w") (7 9 "\\w"))
> (all-in lit (search:make-query "a(?#\\w)" search:regexp))
((1 2 "a"))
; [[:word:]] and \p{...} keep PCRE2's meaning, with _.
> (rx "[[:word:]]+")
((1 8 "user_id") (9 12 "foo") (13 14 "x") (15 16 "a") (17 18 "b"))
; A hyphen next to \w in a class is refused, as PCRE2 refuses [\w-z].
> (guard (c [(search:pattern-error? c) (condition-message c)]) (rx "[\\w-z]"))
"invalid range in character class"
; A mode's own word characters, written \x{hex}, each matching only
; itself: s, d, ] , - and \.
> (define-table odd-keymap)
> (define-hook odd-hook)
> (modes:define-major-mode odd-mode (keymap odd-keymap) (hook odd-hook))
> (table-set! syntax:word-characters odd-mode "sd]-\\")
> (define o (text-buffer "odd" "a]b-c\\d e+f\n"))
> (modes:set-major-mode odd-mode o)
> (all-in o (search:make-query "\\w+" search:regexp))
((1 8 "a]b-c\\d") (9 10 "e") (11 12 "f"))
> (all-in o (search:make-query "\\bb-c\\b" search:regexp))
()
; Advice on syntax:buffer-word-characters reaches regexps and the word
; style, as it reaches the word commands.
> (define (with-underscore chars buffer) (if (eq? buffer b) (string-append (chars buffer) "_") (chars buffer)))
> (advice-add! syntax:buffer-word-characters with-underscore)
> (rx "\\w+")
((1 8 "user_id") (9 14 "foo$x") (15 16 "a") (17 18 "b"))
> (all-in b (search:make-query "user" search:word))
()
> (advice-remove! syntax:buffer-word-characters with-underscore)
> (all-in b (search:make-query "user" search:word))
((1 5 "user"))
; The class holds what syntax counts as a word character: Alphabetic,
; so Devanagari's vowel sign, and numbers of every kind.
> (define k (text-buffer "k" "किताब Ⅻ² x\n"))
> (all-in k (search:make-query "\\w+" search:regexp))
((1 6 "किताब") (7 9 "Ⅻ²") (10 11 "x"))
> (all-in k (search:make-query "ताब" search:word))
()
> (map char-alphabetic? (string->list "ि"))
(#t)
; Over every character, \w agrees with what syntax counts as a word
; character in fundamental, letters, digits, $ and %, apart from the
; characters Chez's newer Unicode version counts and PCRE2's does not:
; PCRE2 counts none that Chez does not.
> (define chars (filter (lambda (n) (not (or (<= #xD800 n #xDFFF) (= n 10)))) (iota #x30000)))
> (define every (text-buffer "every" (list->string (map integer->char chars))))
> (define word? (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\$ #\%)))))
> (define (matched text)
    (map (lambda (m) (char->integer (string-ref (buffers:text-between (buffers:document every) (search:match-start m) (search:match-end m)) 0)))
         (search:scan-matches (scanned every (search:make-query text search:regexp)) 0 (end-of every))))
> (define (missing from in)
    (let ([t (make-eqv-hashtable)])
      (for-each (lambda (n) (hashtable-set! t n #t)) in)
      (filter (lambda (n) (not (hashtable-ref t n #f))) from)))
> (define by-chez (filter (lambda (n) (word? (integer->char n))) chars))
> (define by-pcre2 (matched "\\w"))
> (list (length by-chez) (length (missing by-pcre2 by-chez)) (length (missing by-chez by-pcre2)))
(135679 0 5665)
