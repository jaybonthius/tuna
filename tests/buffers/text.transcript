; The text of a range is its characters and the text each atom's kind
; gives; openings and closings give nothing.
> (import (cards))
> (define r (fresh (cards:rows '() (cards:row '((label . "one"))) (cards:row '((label . "two"))))))
> (buffers:text-between (buffers:document r) 0 4)
"one\ntwo\n"
> (buffers:atom-texts (buffers:document r) 0 4)
((1 . "one\n") (2 . "two\n"))
> (buffers:atom-texts (buffers:document r) 2 4)
((2 . "two\n"))
> (define mixed (fresh (md:doc '() (md:para '() "a " (cards:tag '((label . "TAG"))) " b\n"))))
> (buffers:text-between (buffers:document mixed) 0 (document:length (buffers:document mixed)))
"a TAG b\n"
> (buffers:text-between (buffers:document mixed) 3 6)
" TAG "
; A character U+FFFC in the text is no atom.
> (define literal (fresh (md:doc '() (md:para '() (string #\x #\xFFFC #\y #\newline)))))
> (buffers:atom-texts (buffers:document literal) 0 (document:length (buffers:document literal)))
()
> (string-length (buffers:text-between (buffers:document literal) 0 (document:length (buffers:document literal))))
4
; An atom of a kind with no text clause, or of an undefined kind, gives
; none; a raw byte gives U+FFFD. A text procedure that raises, or
; returns what is not a string, goes to report as the kind's module's,
; and its atom gives none.
> (define odd (fresh (list 'cards:rows '() (cards:blank '()) (vector 'nowhere:atom '()) (cards:broken '()) (cards:number '()) (cards:row '((label . "ok"))))))
> (buffers:atom-texts (buffers:document odd) 0 (document:length (buffers:document odd)))
! (cards) car: () is not a pair
! (cards) cards:number: a text procedure returned what is not a string with irritant 42
((1 . "") (2 . "") (3 . "") (4 . "") (5 . "ok\n"))
> (define raw (fresh (list 'buffers:text '() "a" (vector 'document:raw-byte '((byte . 233))) "b\n")))
> (char->integer (string-ref (buffers:text-between (buffers:document raw) 0 6) 1))
65533
; Content a node takes only as text goes in as its text, atoms included.
> (define form (fresh (cards:rows '() (cards:plain '() "x\n"))))
> (buffers:replace! form 2 2 (cards:field '() "a " (cards:tag '((label . "TAG"))) " "))
#<edit 1>
> (root form)
(cards:rows () (cards:plain () "a TAG x\n"))
; A travelling span after an atom moves by the length its text adds.
> (buffers:define-layer responses (travels) (sticky after))
> (define form (fresh (cards:rows '() (cards:plain '() "x\n"))))
> (define source (fresh (md:doc '() (md:para '() (cards:field '() "a" (cards:tag '((label . "TAG"))) "bc" (cards:blank '()) "de") "\n"))))
> (buffers:add-span! (buffers:layer source responses) 8 10 'x)
> (define field (buffers:piece source 2 11))
> (list (document:datums (buffers:piece-document field)) (buffers:piece-text field))
(((cards:field () "a" #(cards:tag ((label . "TAG"))) "bc" #(cards:blank ()) "de")) "aTAGbcde")
> (buffers:replace! form 2 2 field)
#<edit 1>
> (root form)
(cards:rows () (cards:plain () "aTAGbcdex\n"))
> (buffers:spans (buffers:layer form responses) 0 (document:length (buffers:document form)))
((8 10 x))
> (document:text (buffers:document form) 8 10)
"de"
; The arguments are a document, or a slice of one, and a range of it.
> (buffers:text-between 'x 0 1)
! buffers:text-between: not a document with irritant x
> (buffers:atom-texts (buffers:document r) 3 1)
! buffers:atom-texts: not a range of the document with irritants (3 1)
> (buffers:text-between (buffers:document r) 0 99)
! buffers:text-between: not a range of the document with irritants (0 99)
> (define part (document:slice (buffers:document r) 2 (document:length (buffers:document r))))
> (list (buffers:text-between part 0 (document:length part)) (buffers:atom-texts part 0 (document:length part)))
("two\n" ((0 . "two\n")))
; The clause is for atoms only, and reads no other thread's call.
> (buffers:define-kind wrong (text cards:row))
! buffers:define-kind: a text clause needs (content atom) (text cards:row) in (buffers:define-kind wrong (text cards:row))
> (let ([doc (buffers:document r)] [result #f])
    (let ([t (fork-thread (lambda () (set! result (guard (c [#t (condition-message c)]) (buffers:text-between doc 0 4)))))])
      (thread-join t))
    result)
"not on the main thread"
; Stops after a block's last line break: none, except at the root's end
; and in an inline node, where a line break is text.
> (all-stops (fresh (md:doc '() (md:para '() "ab\n") (md:para '() "cd\n"))))
(2 3 4 7 8 9)
> (all-stops (fresh "ab\n"))
(1 2 3 4)
> (all-stops (fresh (md:doc '() (md:para '() "x" (cards:field '() "a\n") "\n"))))
(2 4 5 6)
