; *Help* derives from modes:special, whose keymap gives the keys for
; reading: q, SPC, S-SPC, DEL, <, >, ?, h, digits and -. g runs
; buffers:revert-buffer, which runs help:refresh, the value help:mode's
; hook sets locally.
> (define notes (buffers:make "notes" "x\n"))
> (layout:switch-to-buffer notes)
> (press! "C-h" "b")
> (layout:select! (help-view))
> (define (bound key) (in-client (lambda () (commands:command-name (keys:lookup client key)))))
> (list (modes:derived? help:mode modes:special) (modes:ancestry help:mode))
(#t (help:mode modes:special))
> (map bound '("q" "SPC" "S-SPC" "DEL" "<" ">" "?" "h" "3" "-" "g" "x"))
(layout:quit-view views:scroll-up views:scroll-down views:scroll-down editing:beginning-of-buffer editing:end-of-buffer help:describe-mode help:describe-mode keys:digit-argument keys:negative-argument buffers:revert-buffer keys:undefined)
> (eq? (buffers:with-buffer (help-buffer) (buffers:revert-function)) help:refresh)
#t
> (press! ">")
> (define at-end (views:point (help-view)))
> (press! "<")
> (list (views:point (help-view)) (= at-end (buffers:previous-stop (help-buffer) (document:length (buffers:document (help-buffer))))))
(2 #t)
; ? describes the mode, and g describes it again through
; buffers:revert-buffer.
> (press! "?")
> (title)
"Modes"
> (define refreshed 0)
> (advice-add! help:refresh (lambda (refresh) (set! refreshed (+ refreshed 1)) (refresh)))
> (press! "g")
> (list refreshed (title))
(1 "Modes")
> (press! "q")
> (shown)
(("notes" #t))
