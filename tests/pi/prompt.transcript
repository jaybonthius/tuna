> (define chat (pi:start (getenv "HOME")))
> (define f (fake-of chat))
> (wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (in-client (lambda () (pi-chat:show! chat)))
> (define b (pi-chat:buffer chat))
; The chat is a buffer of its own mode, named after its folder, linked to
; Pi's process, and keeping no undo history.
> (list (buffers:name b) (modes:major-mode b) (eq? (pi-chat:chat-of b) chat) (eq? (processes:buffer (pi:chat-process chat)) b))
("*pi: home*" pi-chat:mode #t #t)
> (buffers:with-buffer b (undo:limit))
0
; Point is in the prompt; RET sends it with pi:send!, the text moving at
; once into the prompt history. A key that waits for Pi pauses the task
; it runs in, so the test presses it in a task of its own.
> (type! "Fix it")
> (shown chat)
"Fix it\n"
; The prompt's text is kept in saved data, so typing leaves the chat
; unmodified.
> (buffers:modified? b)
#f
> (answer! f "prompt" (lambda (f r) #f))
> (define t (start! (lambda () (press! "RET"))))
> (define r (wait-held f "prompt"))
> (list (ref r "message") (ref r "streamingBehavior") (shown chat) (pi-chat:prompt-history))
("Fix it" "steer" "\n" ("Fix it"))
> (respond! f r '(("disposition" . "started")))
; M-RET follows up instead, and S-RET adds a line.
> (type! "Then")
> (press! "S-RET")
> (type! "test")
> (shown chat)
"Then\ntest\n"
> (define t (start! (lambda () (press! "M-RET"))))
> (define r (wait-held f "prompt"))
> (list (ref r "message") (ref r "streamingBehavior"))
("Then\ntest" "followUp")
; When Pi refuses, the text comes back before anything typed since, and
; the chat says why.
> (type! "more")
> (refuse! f r "Cannot submit a prompt while compaction is in progress")
> (wait-until (lambda () (string=? (shown chat) "Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nThen\ntest\nmore\n")))
> (shown chat)
"Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nThen\ntest\nmore\n"
> (fake-answers-set! f '())
; M-p and M-n walk the prompt history, newest first, and come back to
; what was typed.
> (pi-chat:prompt-history)
("Then\ntest" "Fix it")
> (press! "M-p")
> (shown chat)
"Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nThen\ntest\n"
> (press! "M-p")
> (shown chat)
"Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nFix it\n"
> (press! "M-n" "M-n")
> (shown chat)
"Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nThen\ntest\nmore\n"
; The transcript refuses edits; typing goes only into the prompt.
> (in-client (lambda () (views:set-point! (view) 2)))
> (press! "x")
! buffers:replace!: a read-only span refuses the edit with irritant pi-chat:%read-only
> (shown chat)
"Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nThen\ntest\nmore\n"
; An unsent prompt is saved data, by the chat's session.
> (sleep-for 0.1)
> (equal? (pi-chat:drafts) (list (cons (pi:chat-session-id chat) "Then\ntest\nmore")))
#t
; Pi's queue shows under the conversation. M-<up> takes it back into the
; prompt, steers first; C-c C-k stops Pi and does the same.
> (answer! f "clear_queue" (lambda (f r) '(("steering" . #("a")) ("followUp" . #("b")))))
> (say! f (event "queue_update" '("steering" . #("a")) '("followUp" . #("b"))))
> (wait-until (lambda () (string=? (shown chat) "Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nSteer a\nFollow-up b\nThen\ntest\nmore\n")))
> (shown chat)
"Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nSteer a\nFollow-up b\nThen\ntest\nmore\n"
> (press! "M->")
> (define t (start! (lambda () (press! "M-<up>"))))
> (result t)
> (shown chat)
"Pi refused the prompt: Cannot submit a prompt while compaction is in progress\nSteer a\nFollow-up b\na\nb\nThen\ntest\nmore\n"
