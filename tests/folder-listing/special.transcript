; A listing's mode derives from modes:special, and its hook sets
; buffers:revert-function to folder-listing:refresh, so g, from the
; parent's keymap, and buffers:revert-buffer read the folder again,
; keeping marks.
> (for-each (lambda (n) (touch! (string-append "sp/" n ".txt") n "\n")) '("a" "b" "c" "d" "e"))
> (define b (folder-listing:visit (at "sp")))
> (layout:switch-to-buffer b)
> (list (modes:derived? (modes:major-mode b) modes:special)
        (eq? (buffers:with-buffer b (buffers:revert-function)) folder-listing:refresh))
(#t #t)
> (define (bound key) (in-client (lambda () (commands:command-name (keys:lookup client key)))))
> (goto "a.txt")
> (press! "m")
> (touch! "sp/f.txt" "f\n")
> (press! "g")
> (settle)
> (listing-lines b)
("  ." "  .." "* a.txt" "  b.txt" "  c.txt" "  d.txt" "  e.txt" "  f.txt")
> (touch! "sp/g.txt" "g\n")
> (in-client (lambda () (commands:run buffers:revert-buffer)))
> (settle)
> (listing-lines b)
("  ." "  .." "* a.txt" "  b.txt" "  c.txt" "  d.txt" "  e.txt" "  f.txt" "  g.txt")
; Digits and - come from the parent, so 3 n moves three entries.
> (goto "a.txt")
> (press! "3" "n")
> (point-name)
"d.txt"
; SPC, S-SPC, DEL, n and p keep the listing's own commands.
> (map bound '("SPC" "S-SPC" "DEL" "n" "p" "g" "q" "<"))
(folder-listing:next-line folder-listing:previous-line folder-listing:unmark-backward folder-listing:next-line folder-listing:previous-line buffers:revert-buffer layout:quit-view editing:beginning-of-buffer)
; A printing key the listing leaves unbound is undefined, and q quits
; the listing's view.
> (press! "z")
! z is undefined
> (listing-lines b)
("  ." "  .." "* a.txt" "  b.txt" "  c.txt" "  d.txt" "  e.txt" "  f.txt" "  g.txt")
> (press! "q")
> (views:showing b)
()
