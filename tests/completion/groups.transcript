; Actions act on a grouped list's candidates: a grep line's whole text,
; without the search, as M-w copies it. A narrowed read's input takes
; the category of the sources it shows, as its matches do.
> (use-plugin actions)
> (define (act! . keys)
    (let ([t (start! (lambda () (apply press! keys)))])
      (testing:wait-until (lambda () (or (task-done? t) (keys:reading client))))
      t))
> (set-option! grep:command-line (list (string-append (getenv "HOME") "/bin/grouped-rg")))
