; isearch:started, isearch:updated and isearch:ended are called with the
; search; ended after its keymap and highlights are gone.
> (define events '())
> (define (note! . e) (set! events (cons e events)))
> (add-hook! isearch:started (lambda (s) (note! 'started (isearch:search-direction s))))
> (add-hook! isearch:ended (lambda (s cancelled?) (note! 'ended cancelled? (keys:prompt client))))
> (define b (show "s" "alpha beta gamma beta\n"))
> (press! "C-s" "b" "e")
> (isearch:prompt (isearch:current client))
("I-search: " (#f . "be"))
> (press! "RET")
> (reverse events)
((started forward) (ended #f #f))
; A search that ends away from where it started records the start in the
; jump history; one that ends where it started records nothing.
> (jump-history:places)
((#<buffer s> . 1))
> (views:set-point! (view) 1)
> (start! "C-s" "RET")
> (press! "RET")
> (length (jump-history:places))
1
; Another client's search runs apart: each has its own keymap and search.
> (define v2 (views:make b))
> (views:set-point! v2 1)
> (parameterize ([web:current-client other])
    (views:call-with-view v2 (lambda () (keys:press! other "C-s") (keys:press! other "g"))))
> (press! "C-s" "b")
> (list (isearch:search-view (isearch:current other)) (point) (views:point v2))
(#<view 5> 8 13)
> (keys:prompt other)
("I-search: " (#f . "g"))
> (press! "RET")
> (parameterize ([web:current-client other]) (views:call-with-view v2 (lambda () (keys:press! other "RET"))))
> (isearch:current other)
#f
; isearch:start! starts a search for code, with a query and a client.
> (views:set-point! (view) 1)
> (define s (isearch:start! (view) client (search:make-query "gamma" search:literal 'exact) 'forward))
> (list (isearch:search-origin s) (point) (keys:prompt client))
(1 17 ("I-search: " (#f . "gamma")))
> (isearch:end! s)
> (list (isearch:current client) (keys:prompt client))
(#f #f)
; isearch:wrap immediately wraps at once, and never stops at the last match.
> (define sy (show "sy" "(foo-bar x) foo-bar foo-barz foo-bar\n"))
> (set-option! isearch:wrap 'immediately)
> (views:set-point! (view) 30)
> (press! "C-s" "f" "o" "o" "-" "b" "a" "r" "C-s")
> (here)
(9 "Wrapped I-search: foo-bar" "foo-bar")
> (press! "RET")
> (set-option! isearch:wrap 'never)
> (views:set-point! (view) 30)
> (press! "C-s" "f" "o" "o" "-" "b" "a" "r" "C-s" "C-s")
> (here)
(37 "Failing I-search: foo-bar" "foo-bar")
> (press! "C-g" "C-g")
! &quit
> (set-option! isearch:wrap 'pause)
; With repeat-on-direction-change on, turning around goes to another match.
> (set-option! isearch:repeat-on-direction-change #t)
> (views:set-point! (view) 1)
> (press! "C-s" "f" "o" "o" "C-s" "C-r")
> (here)
(2 "I-search backward: foo" "foo")
> (press! "RET")
; A quit during a long find fails the state it was making; the quit key
; then runs, and C-g goes back to the last state that matched.
> (set-option! isearch:repeat-on-direction-change #f)
> (define make-quit (record-constructor (record-constructor-descriptor &quit)))
> (define (quitting find . args) (raise (make-quit)))
> (define qb (show "qb" "abc abd abe\n"))
> (press! "C-s" "a" "b")
> (advice-add! search:find quitting)
> (press! "d")
> (advice-remove! search:find quitting)
> (here)
(3 "Failing I-search: ab{d}" "ab")
> (press! "C-g")
> (here)
(3 "I-search: ab" "ab")
> (press! "RET")
; A backward regexp foo\b and a backward symbol search, from between foo
; and bar in foobar, do not find that foo, as in Emacs; typed, the symbol
; search finds the symbols its text starts, so it finds that foo.
> (define fb (show "fb" "foo foobar\n"))
> (views:set-point! (view) 9)
> (press! "C-M-r" "f" "o" "o" "\\" "b")
> (here)
(1 "Regexp I-search backward: foo\\b" "foo")
> (press! "RET")
> (views:set-point! (view) 9)
> (press! "C-r" "M-s" "_" "f" "o" "o")
> (here)
(5 "Symbol I-search backward: foo" "foo")
> (press! "RET")
> (views:set-point! (view) 9)
> (define fs (isearch:start! (view) client (search:make-query "foo" search:symbol) 'backward))
> (here)
(1 "Symbol I-search backward: foo" "foo")
> (press! "RET")
; isearch:start! keeps the query's own filter, with the folds filter
; added when folds are passed over.
> (define fl (show "fl" "ab ab ab\n"))
> (define (not-first b start end) (> start 2))
> (define fs2 (isearch:start! (view) client (search:make-query "ab" search:literal 'smart 'literal not-first) 'forward))
> (here)
(6 "I-search: ab" "ab")
> (press! "C-s")
> (here)
(9 "I-search: ab" "ab")
> (press! "RET")
; A client removed mid-search ends its search at its match.
> (define rc (show "rc" "foo\n"))
> (views:set-point! (view) 1)
> (press! "C-s" "f")
> (web:remove-client! client)
> (list (isearch:current client) (point))
(#f 2)
> (set! client (web:add-client! 3))
; Unloading isearch ends every search.
> (press! "C-s" "f" "o")
> (unload-module! '(isearch))
> (keys:prompt client)
#f
