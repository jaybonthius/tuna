; A group clause's title procedure names each candidate's group; matches
; come by group, groups in the order of their first match, each group's
; matches in the source's order, so each title shows once.
> (define (titles s) (map (lambda (m) (completion:title s m)) (match-list s)))
> (define (drawn-in v after)
    (let ([html (lines-html v)] [open (string-append "<" after ">")])
      (let loop ([i 0] [acc '()])
        (cond
          [(> (+ i (string-length open)) (string-length html)) (reverse acc)]
          [(string=? (substring html i (+ i (string-length open))) open)
           (let* ([from (+ i (string-length open))]
                  [to (let find ([j from]) (if (char=? (string-ref html j) #\<) j (find (+ j 1))))])
             (loop to (cons (substring html from to) acc)))]
          [else (loop (+ i 1) acc)]))))
> (define (drawn after) (drawn-in (list-view) after))
> (define (fruit-title text value) (if (memv (string-ref text 0) '(#\a #\b)) "Early" "Late"))
> (define fruit
    (completion:source
      (candidates (vector "cherry" "apple" "date" "banana" "avocado"))
      (group fruit-title)))
> (define t (start! (lambda () (completion:read "? " (list fruit) #f))))
> (define s (session))
> (texts s)
("date" "cherry" "apple" "banana" "avocado")
> (titles s)
("Late" "Late" "Early" "Early" "Early")
> (eq? (car (titles s)) (cadr (titles s)))
#t
> (type! "a")
> (texts s)
("date" "apple" "banana" "avocado")
> (drawn "li class=\"ui-list-heading\"><span")
("Late" "Early")
; A title is drawn beside its row's element, not inside it, so it names
; no row: a click on it, which names the list's own node, chooses
; nothing and keeps the selection.
> (define (list-start)
    (let ([doc (buffers:document (views:buffer (list-view)))])
      (let loop ([p 0])
        (let ([x (document:token doc p)]) (if (and (document:node? x) (eq? (document:node-kind x) 'ui:list)) p (loop (+ p 1)))))))
> (let* ([html (lines-html (list-view))] [heading "<li class=\"ui-list-heading\"><span>Late</span></li><div class=\"node whole"])
    (let loop ([i 0]) (and (<= (+ i (string-length heading)) (string-length html))
                           (or (string=? (substring html i (+ i (string-length heading))) heading) (loop (+ i 1))))))
#t
