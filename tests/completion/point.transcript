> (let ([s (html->string (views:draw lv client))]) (let loop ([i 0] [n 0]) (cond [(> (+ i 11) (string-length s)) n] [(string=? (substring s i (+ i 11)) "ui-list-row") (loop (+ i 11) (+ n 1))] [else (loop (+ i 1) n)])))
2
; The list is as tall as the most rows it has shown in the read, so it
; keeps its height as the matches narrow.
> (define (list-rows)
    (let* ([s (lines-html lv)] [start (+ 24 (string-length "<div class=\"completion-list\" style=\"--completion-list-rows:"))])
      (let loop ([i start]) (if (char-numeric? (string-ref s i)) (loop (+ i 1)) (string->number (substring s start i))))))
