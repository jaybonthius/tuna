((0 1 completion.match-2) (1 4 completion.match-1) (14 16 completion.match-2) (17 21 completion.match-0))
! &cancelled
; The list draws each match in its face.
> (define (marks html)
    (let loop ([i 0] [acc '()])
      (let ([open (let find ([k i]) (cond [(> (+ k 30) (string-length html)) #f] [(string=? (substring html k (+ k 30)) "<span class=\"completion-match\"") k] [else (find (+ k 1))]))])
        (if open
            (let ([close (let find ([k open]) (if (string=? (substring html k (+ k 7)) "</span>") (+ k 7) (find (+ k 1))))])
              (loop close (cons (substring html open close) acc)))
            (reverse acc)))))
> (define t (start! (lambda () (press! "M-x"))))
> (type! "file find")
> (wait-matches (session))
> (texts (session))
("file-picker:find-file" "file-picker:find-file-other-view")
