; A buffer whose only node is its root takes a shorter way to its stops;
; it finds the stops that the same text has before another node, away
; from that node.
> (define (stop-answers b n)
    (map (lambda (p) (list (buffers:stop b p) (buffers:next-stop b p) (buffers:previous-stop b p))) (iota n)))
