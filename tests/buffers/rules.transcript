; Anchors stay before text inserted at them, or move after it; one that
; an edit leaves without the token before it says so.
> (define t (fresh "abcdef\n"))
> (define before (buffers:anchor t 3))
> (define after (buffers:anchor-after t 3))
> (list (buffers:anchor? before) (buffers:anchor? 3))
(#t #f)
> (buffers:replace! t 3 3 "XY")
#<edit 1>
> (list (buffers:anchor-position before) (buffers:anchor-position after))
(3 5)
> (buffers:replace! t 1 2 "")
#<edit 2>
> (list (buffers:anchor-position before) (buffers:anchor-deleted? before))
(2 #f)
> (buffers:replace! t 1 3 "")
#<edit 3>
> (list (buffers:anchor-position before) (buffers:anchor-deleted? before) (buffers:anchor-position after))
(1 #t 2)
> (buffers:set-anchor! before 2)
> (list (buffers:anchor-position before) (buffers:anchor-deleted? before))
(2 #f)
> (define n (fresh '(md:doc () (md:para () "one\n") (md:para () "two\n"))))
