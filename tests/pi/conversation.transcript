((reply 4 "a3" tool-use ((thinking "Let me look") (tool "bash" done "a.txt\nb.txt\n"))) (reply 5 "a4" error ((text "Partial"))) (notice error "Compaction failed: too long") (notice error "Retrying failed: still overloaded") (notice error "Extension /x/guard.ts: boom") (notice warning "Blocked rm"))
> (pi:tool-call-duration (cadr (pi:reply-parts (list-ref (pi:chat-transcript chat) 4))))
3/2
; An extension's message is shown when it says so, as is Pi's summary of
; a compaction or of a branch left behind, and a command run with !.
; Pi reads entries again when an extension appends one.
> (append-entry! f '(("type" . "custom_message") ("id" . "c1") ("parentId" . "a4") ("customType" . "subagent-notify")
                     ("content" . "Run **done**") ("display" . #t)))
> (append-entry! f '(("type" . "custom_message") ("id" . "c2") ("parentId" . "c1") ("customType" . "hidden") ("content" . "x") ("display" . #f)))
> (append-entry! f '(("type" . "compaction") ("id" . "k1") ("parentId" . "c2") ("summary" . "We read files.") ("tokensBefore" . 150000)
                     ("firstKeptEntryId" . "a4")))
> (append-entry! f '(("type" . "branch_summary") ("id" . "b1") ("parentId" . "k1") ("fromId" . "a2") ("summary" . "Tried A.")))
> (append-entry! f (entry "x1" "b1" '(("role" . "bashExecution") ("command" . "make") ("output" . "ok\n") ("exitCode" . 2)
                                      ("cancelled" . #f) ("truncated" . #f) ("timestamp" . 5))))
