()
; Unloading a module stops its paused timer tasks, past their handlers.
> (load-module! '(ticker))
#<owner (ticker) 3>
> (begin
    (call-as-owner (module-owner '(ticker)) (lambda () (timers:run-after 0
        (lambda ()
          (guard (c [(cancelled? c) (display "ticker's timer quit") (newline)])
            (timers:sleep 3600))))))
    (void))
