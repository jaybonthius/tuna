; a submodule whose checkout moved shows as a modified row; its body
; is the Subproject commit hunk.
> (sh "git init -q -b main lib && cd lib && echo 1 > l.txt && git add l.txt && git commit -qm one")
> (sh "git init -q -b main top && cd top && git -c protocol.file.allow=always submodule -q add ../lib lib && git commit -qm sub")
> (sh "cd top/lib && echo 2 > l.txt && git commit -qam two")
> (define repo (git:find-repository (at "top")))
> (git-status:show repo)
> (status)
("Head:     main sub" "Unstaged changes (1)" "modified   lib…" "Recent commits…")
> (go-to-section! '(file . "lib") '(unstaged . #f))
> (press! "TAB")
> (map (lambda (l) (if (> (string-length l) 18) (substring l 0 18) l)) (list-head (list-tail (status) 3) 4))
("@@ -1 +1 @@" "-Subproject commit" "+Subproject commit" "Recent commits…")
; s stages it.
> (press! "s")
> (settle!)
> (git-out "top" "status" "--short")
"M  lib\n"
; k on it asks, and git checkout leaves the submodule's own checkout.
> (sh "cd top && git reset -q")
> (git-mode:refresh-repository repo)
> (go-to-section! '(file . "lib") '(unstaged . #f))
> (answer! #t)
> (press! "k")
> (settle!)
> (list (take-asked!) (git-out "top" "status" "--short") (git-out "top/lib" "log" "-1" "--format=%s"))
(("Discard unstaged changes in \"lib\"? ") " M lib\n" "two\n")
; RET on its row shows the submodule's own status buffer in the selected
; view.
> (go-to-section! '(file . "lib") '(unstaged . #f))
> (press! "RET")
> (settle!)
> (shown-buffer)
"*git: lib*"
