; A buffer's major mode is modes:fundamental until it is set.
> (define b (buffers:make "b" "one two"))
> (modes:major-mode b)
modes:fundamental
> (show! b)
#<buffer b>
> (active-keymaps)
(modes:fundamental-keymap layout:keymap keys:global)
; Setting it gives the buffer a new scope: local values and local hook
; entries go, a view's own values stay.
> (define-hook probe)
> (define (probed) 'probed)
> (buffers:with-buffer b (set-option-local! fill:column 99) (add-local-hook! probe probed))
> (views:set-option! (view) fill:mode #t)
> (list (local fill:column b) (buffers:with-buffer b (map (lambda (e) (e)) (hook-entries probe))))
(99 (probed))
> (modes:set-major-mode text:mode b)
> (list (local fill:column b) (buffers:with-buffer b (map (lambda (e) (e)) (hook-entries probe))))
(70 ())
> (map modes:lighter (modes:active-minor-modes (view)))
("Fill")
> (views:remove-option! (view) fill:mode)
; Setting the mode it already has resets it too.
> (buffers:with-buffer b (set-option-local! fill:column 99))
> (modes:set-major-mode text:mode b)
> (local fill:column b)
70
; Code inside with-buffer of the buffer moves to the new scope.
> (buffers:with-buffer b
    (set-option-local! fill:column 50)
    (modes:set-major-mode text:mode b)
    (let ([after (fill:column)])
      (set-option-local! fill:column 51)
      (list after (fill:column))))
(70 51)
> (local fill:column b)
51
> (modes:set-major-mode text:mode b)
; Hooks run outermost first, with the buffer current; major-mode-changed
; runs once, after them, and run-mode-hooks alone does not call it.
> (define calls '())
> (define (note! what) (set! calls (cons what calls)))
> (define (prog-entry) (note! (list 'prog (buffers:name (buffers:current)) (modes:major-mode (buffers:current)))))
> (define (python-entry) (note! 'python))
> (define (changed buffer) (note! (list 'changed (buffers:name buffer) (eq? buffer (buffers:current)))))
> (add-hook! prog:mode-hook prog-entry)
> (add-hook! python:mode-hook python-entry)
> (add-hook! modes:major-mode-changed changed)
> (modes:set-major-mode python:mode b)
> (reverse calls)
((prog "b" python:mode) python (changed "b" #t))
> (set! calls '())
> (modes:run-mode-hooks b)
> (reverse calls)
((prog "b" python:mode) python)
> (set! calls '())
; A mode's local values rank by the order of changes, not by which hook
; runs first: the REPL's value, set in the parent's hook, beats the python
; plugin's own, though the python hook runs after it.
> (local editing:word-characters b)
"_"
> (add-hook! prog:mode-hook (lambda () (set-option-local! editing:word-characters "repl")))
> (modes:set-major-mode python:mode b)
> (local editing:word-characters b)
"repl"
> (set! calls '())
; The checks at the public entries.
> (raised (lambda () (modes:set-major-mode 'nothere:mode b)))
(modes:set-major-mode "not a major mode")
> (raised (lambda () (modes:set-major-mode text:mode "b")))
(modes:set-major-mode "not a live buffer")
> (define gone (buffers:make "gone" "x"))
> (buffers:kill! gone)
#t
> (raised (lambda () (modes:set-major-mode text:mode gone)))
(modes:set-major-mode "not a live buffer")
> (raised (lambda () (modes:run-mode-hooks gone)))
(modes:run-mode-hooks "not a live buffer")
> (raised (lambda () (modes:major-mode 'b)))
(modes:major-mode "not a buffer")
> (raised (lambda () (modes:ancestry "python")))
(modes:ancestry "not a mode")
> (raised (lambda () (modes:active-minor-modes b)))
(modes:active-minor-modes "not a view")
> (raised (lambda () (modes:derived? python:mode 5)))
(modes:derived? "not a mode")
; A malformed hook entry is no major mode, and the buffer keeps its mode
; and its local values.
> (table-set! modes:hooks 'odd:mode 5)
> (raised (lambda () (modes:set-major-mode 'odd:mode b)))
(modes:set-major-mode "not a major mode")
> (list (modes:major-mode b) (local editing:word-characters b))
(python:mode "repl")
> (table-remove! modes:hooks 'odd:mode)
> (raised (lambda () (buffers:reset-scope! gone)))
(buffers:reset-scope! "not a live buffer")
> (import (rename (only (chezscheme) fork-thread) (fork-thread chez:fork-thread)))
> (define result #f)
> (define (wait-for-result)
    (let loop ([n 0])
      (unless (or result (= n 500))
        (sleep-for 0.01)
        (loop (+ n 1)))))
> (chez:fork-thread (lambda () (set! result (raised (lambda () (modes:set-major-mode text:mode b))))))
#<thread 4>
> (wait-for-result)
> result
(modes:set-major-mode "not on the main thread")
> (set! result #f)
> (chez:fork-thread (lambda () (set! result (raised (lambda () (modes:major-mode b))))))
#<thread 5>
> (wait-for-result)
> result
(modes:major-mode "not on the main thread")
; Ancestry follows parents and stops at a cycle.
> (modes:ancestry modes:fundamental)
(modes:fundamental)
> (modes:ancestry 'nothere:mode)
(nothere:mode)
> (list (modes:derived? python:mode prog:mode) (modes:derived? prog:mode python:mode) (modes:derived? python:mode python:mode))
(#t #f #t)
> (table-set! modes:parents prog:mode python:mode)
> (modes:ancestry python:mode)
(python:mode prog:mode)
> (table-remove! modes:parents prog:mode)
> (modes:ancestry python:mode)
(python:mode prog:mode)
; The lighter: the table's entry, else for a major mode its module's part
; of its name; a minor mode or anything else without one has none.
> (table-remove! modes:lighters text:mode)
> (list (modes:lighter text:mode) (modes:lighter fill:mode) (modes:lighter 'nothere:mode) (modes:lighter 5))
("text" "Fill" #f #f)
> (table-set! modes:lighters text:mode "Text")
; The form's clauses: keymap and hook required, each once, any order,
; matched as symbols.
> (define-table keymap "Keys.")
> (define-hook hook "Setup.")
> (modes:define-major-mode mine (hook hook) (keymap keymap) (parent text:mode))
> mine
mine
> (list (modes:ancestry mine) (modes:lighter mine) (eq? (table-ref modes:keymaps mine) keymap))
((mine text:mode) "mine" #t)
> (modes:define-major-mode bad (hook hook))
! modes:define-major-mode: a keymap clause is required (modes:define-major-mode bad (hook hook))
> (modes:define-major-mode bad (keymap keymap))
! modes:define-major-mode: a hook clause is required (modes:define-major-mode bad (keymap keymap))
> (modes:define-major-mode bad (keymap keymap) (hook hook) (keymap keymap))
! modes:define-major-mode: clause given twice (keymap keymap) in (modes:define-major-mode bad (keymap keymap) (hook hook) (keymap keymap))
> (modes:define-major-mode bad (keymap keymap) (hook hook) (colour "red"))
! modes:define-major-mode: invalid clause (colour "red") in (modes:define-major-mode bad (keymap keymap) (hook hook) (colour "red"))
> (modes:define-major-mode bad (keymap keymap) (hook))
! modes:define-major-mode: invalid clause (hook) in (modes:define-major-mode bad (keymap keymap) (hook))
> (modes:define-major-mode "bad" (keymap keymap) (hook hook))
! modes:define-major-mode: expected (modes:define-major-mode id clause ...) (modes:define-major-mode "bad" (keymap keymap) (hook hook))
> (modes:define-major-mode bad (keymap 1) (hook hook))
! modes:define-major-mode: not a keymap with irritant 1
> (modes:define-major-mode bad (keymap keymap) (hook hook) (lighter 'x))
! modes:define-major-mode: not a string with irritant x
> (modes:define-major-mode bad (keymap keymap) (hook 5))
! modes:define-major-mode: not a hook with irritant 5
> (modes:define-major-mode bad (keymap keymap) (hook hook) (parent "text"))
! modes:define-major-mode: not a mode with irritant "text"
> (table-ref modes:hooks 'bad)
#f
; Evaluating the form again without a clause drops what that clause gave.
> (modes:define-major-mode mine (hook hook) (keymap keymap) (lighter "Mine"))
> (list (modes:ancestry mine) (modes:lighter mine))
((mine) "Mine")
> (modes:define-major-mode mine (hook hook) (keymap keymap))
> (list (modes:ancestry mine) (modes:lighter mine))
((mine) "mine")
; Minor modes' keymaps come by depth, then in the order their keys were
; first set; the major mode's and its ancestors' after them, innermost
; first; the layout's containers after all modes.
> (define-option one #f boolean?)
> (define-option two #f boolean?)
> (define-option three #f boolean?)
> (define-table one-keymap)
> (define-table two-keymap)
> (define-table three-keymap)
> (know! one-keymap 'one-keymap two-keymap 'two-keymap three-keymap 'three-keymap)
> (table-set! modes:minor-modes one 0)
> (table-set! modes:minor-modes two -5)
> (table-set! modes:minor-modes three 0)
> (table-set! modes:keymaps one one-keymap)
> (table-set! modes:keymaps two two-keymap)
> (table-set! modes:keymaps three three-keymap)
> (set-option! one #t three #t)
> (active-keymaps)
(fill:keymap one-keymap three-keymap python:keymap prog:keymap layout:keymap keys:global)
> (buffers:with-buffer b (set-option-local! two #t three #f))
> (active-keymaps)
(two-keymap fill:keymap one-keymap python:keymap prog:keymap layout:keymap keys:global)
> (views:set-option! (view) three #t)
> (active-keymaps)
(two-keymap fill:keymap one-keymap three-keymap python:keymap prog:keymap layout:keymap keys:global)
> (map (lambda (m) (cond [(eq? m one) 'one] [(eq? m two) 'two] [(eq? m three) 'three] [else m]))
       (modes:active-minor-modes (view)))
(two #<procedure> one three)
; A minor mode with no keymap gives none; any procedure is a minor mode.
> (table-remove! modes:keymaps one)
> (define (always) #t)
> (table-set! modes:minor-modes always 10)
> (active-keymaps)
(two-keymap fill:keymap three-keymap python:keymap prog:keymap layout:keymap keys:global)
> (table-remove! modes:minor-modes always)
> (views:remove-option! (view) three)
> (set-option! one #f three #f)
; Minor modes are read in the view: one view on and another off.
> (define other (views:make b))
> (views:set-option! other one #t)
> (list (length (modes:active-minor-modes (view))) (length (modes:active-minor-modes other)))
(2 3)
; A view's value set inside the view counts at once.
> (in-frame (lambda () (views:set-option! (view) one #t) (length (modes:active-minor-modes (view)))))
3
> (views:remove-option! (view) one)
; A minor mode that raises, or a depth that is not a number, is reported
; and skipped; the other modes and their keymaps stay.
> (define (broken) #t)
> (table-set! modes:minor-modes broken 'high)
> (define (raising) (error 'raising "broken minor mode"))
> (table-set! modes:minor-modes raising 0)
> (length (modes:active-minor-modes (view)))
! modes:minor-modes: not a real number with irritant high
! raising: broken minor mode
2
> (active-keymaps)
! (modes) modes:minor-modes: not a real number with irritant high
! (modes) raising: broken minor mode
(two-keymap fill:keymap python:keymap prog:keymap layout:keymap keys:global)
> (table-remove! modes:minor-modes broken)
> (table-remove! modes:minor-modes raising)
; A command is for a view when nothing marks it, or when a mode it is
; marked for is on in the view; marked for no mode, it is for no view.
> (commands:define-command (anywhere) "Runs anywhere." (void))
> (commands:define-command (in-python) "Runs in Python." (void))
> (commands:define-command (in-one) "Runs in text or while one is on." (void))
> (commands:define-command (nowhere) "Runs nowhere." (void))
> (table-set! commands:command-modes in-python (list python:mode))
> (table-set! commands:command-modes in-one (list text:mode one))
> (table-set! commands:command-modes nowhere '())
> (define (for-view) (map (lambda (c) (modes:command-for-view? c (view))) (list anywhere in-python in-one nowhere)))
> (for-view)
(#t #t #f #f)
> (views:set-option! (view) one #t)
> (for-view)
(#t #t #t #f)
> (views:remove-option! (view) one)
> (raised (lambda () (modes:command-for-view? 'anywhere (view))))
(modes:command-for-view? "not a command")
> (raised (lambda () (modes:command-for-view? anywhere b)))
(modes:command-for-view? "not a view")
; A mouse key looks in the view of its position, after the keymaps there.
> (define-table click-keymap)
> (know! click-keymap 'click-keymap)
> (buffers:define-kind clickable (content atom) (keymap click-keymap))
> (define clicks (buffers:make "clicks" (list 'buffers:text '() "ab" (clickable '()) "cd")))
> (modes:set-major-mode text:mode clicks)
> (define clicks-view (views:make clicks))
> (map keymap-name (modes:active-keymaps client (views:%make-posn clicks-view 3)))
(text:keymap)
> (commands:define-command (on-kind) "Notes a click on the atom." (note! 'kind))
> (commands:define-command (on-text) "Notes a click in text mode." (note! 'mode))
> (keys:bind! click-keymap "<mouse-1>" on-kind)
> (keys:bind! text:keymap "<mouse-1>" on-text)
> (set! calls '())
> (keys:press! client (list "<mouse-1>" (views:%make-posn clicks-view 3)))
> (keys:press! client (list "<mouse-1>" (views:%make-posn clicks-view 1)))
> (reverse calls)
(kind mode)
> (keys:unbind! text:keymap "<mouse-1>")
