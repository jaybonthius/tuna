("<p data-at=\"1\"><div class=\"line\" id=\"v6-1\" data-line=\"1\" data-at=\"1\"><span data-face=\"verb\">B<span data-face=\"mark\" title=\"a &quot;quote&quot; &amp; &lt;tag&gt;\"><span data-face=\"strong\">uy</span></span></span><span data-face=\"mark\" title=\"a &quot;quote&quot; &amp; &lt;tag&gt;\"><span data-face=\"strong\"><span class=\"datum\" data-at=\"4\" data-to=\"4\"><img src=\"b.png\"></span> <span class=\"datum\" data-at=\"5\" data-to=\"5\">[x] </span>milk</span></span> <span data-face=\"date\"><span class=\"datum\" data-at=\"10\" data-to=\"15\">now</span><span class=\"cursor primary\"></span></span>.</div></p>" "<p data-at=\"17\"><div class=\"line\" id=\"v6-2\" data-line=\"2\"><span data-face=\"mine\">And</span> bread.</div></p>" "<p data-at=\"28\"><div class=\"line\" id=\"v6-3\" data-line=\"3\"><br></div></p>")
; Folded text draws as one mark: inside a line it joins the line's text
; before and after; across nodes it stands where the first wholly folded
; node was, and a cursor at its start rests on a line of its own.
> (define t (views:make (buffers:make "t" "one\ntwo\nthree\n")))
> (views:fold! t 5 9)
> (show t)
<div class="view" data-view="74" data-version="0" data-showing="0" data-placement="*" data-place-line="1" data-place-align="top" data-place-offset="0" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end style="white-space:pre"><div class="view-lines"><div class="line" id="v74-1" data-line="1" data-at="1"><span class="cursor primary"></span>one</div><div class="line" id="v74-2" data-line="2"><span class="fold" data-at="5" data-to="9">…</span>three</div><div class="line" id="v74-4" data-line="4"><br></div></div></div>
> (define across
    (views:make (buffers:make "across" (md:doc '() (md:para '() "one\ntwo\n") (md:para '() "three\n") (md:para '() "four\nfive\n")))))
> (views:fold! across 6 21)
> (show across)
<div class="view" data-view="75" data-version="0" data-showing="0" data-placement="*" data-place-line="1" data-place-align="top" data-place-offset="0" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end style="white-space:pre"><div class="view-lines"><article><div class="node" data-at="1" data-to="11"><div class="line" id="v75-1" data-line="1" data-at="2"><span class="cursor primary"></span>one</div></div><span class="fold" data-at="6" data-to="21">…</span><div class="node" data-at="19" data-to="31"><div class="line" id="v75-4" data-line="4" data-at="21">our</div><div class="line" id="v75-5" data-line="5">five</div></div></article></div></div>
