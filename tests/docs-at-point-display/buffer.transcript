      (docs-at-point:doc-options [thing "total"] [face faces:function] [spans (list (list 7 12 faces:highlight))])))
> (add-hook! docs-at-point:sources faced)
> (press! "C-h" ".")
> (sleep-for 0.3)
> (list (echo-area:current-message) (echo-area:current-spans))
("total: (total items)" ((0 5 function) (14 19 highlight)))
> (define (holds? text piece)
    (let loop ([i 0])
      (and (<= (+ i (string-length piece)) (string-length text))
           (or (string=? (substring text i (+ i (string-length piece))) piece) (loop (+ i 1))))))
> (define html (html->string (views:draw (car (views:showing (buffers:find "*Docs*"))) client)))
> (list (holds? html "<span data-face=\"function\"><span class=\"cursor-on primary\">t</span>otal</span>") (holds? html "<span data-face=\"highlight\">items</span>") (holds? html "markdown-code-block"))
