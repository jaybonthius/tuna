; A read pauses its command until the client whose keys ran it types
; again. A read pauses the task it runs in, so each reading command
; starts in a task of its own and the keys come from the REPL's.
> (define one (layout:current-frame))
> (define two (layout:other-frame))
> (define got '())
> (define (take-got!) (let ([g (reverse got)]) (set! got '()) g))
> (define (recorded thunk) (guard (c [(quit-condition? c) 'quit]) (thunk)))
> (commands:define-command (read-one)
    "Records the next key and the prefix argument."
    (let ([key (recorded keys:read-key)])
      (set! got (cons (list key (commands:prefix-argument) (keys:command-keys)) got))))
> (commands:define-command (read-sequence)
    "Records the next key sequence."
    (set! got (cons (recorded keys:read-key-sequence) got)))
> (keys:bind! keys:global "C-c k" read-one)
> (keys:bind! keys:global "C-c s" read-sequence)
> (keys:bind! keys:global "C-x C-f" file-picker:find-file)
> (keys:bind! keys:global "M-x" editing:next-line)
> (define (start-in frame . keys)
    (spawn-task (lambda () (apply press-all! frame keys)))
    (sleep-for 0.02))
> (define (settle) (sleep-for 0.02))
; A key read returns the next key without looking it up: nothing runs.
> (start-in one "C-c" "k")
> (list (keys:reading one) (keys:reading two))
("C-c k" #f)
> (press-all! one "C-x")
> (settle)
> (list (take-got!) (keys:pending one) (keys:reading one))
((("C-x" #f "C-c k")) #f #f)
> (start-in one "C-c" "k")
> (press-all! one "<f5>")
> (settle)
> (list (take-got!) (editing:take!) (file-picker:take!))
((("<f5>" #f "C-c k")) () ())
; A read returns every key, quit keys included, and C-g and ESC quit
; nothing.
> (start-in one "C-c" "k")
> (press-all! one "C-g")
> (settle)
> (start-in one "C-c" "k")
> (press-all! one "ESC")
> (settle)
> (take-got!)
(("C-g" #f "C-c k") ("ESC" #f "C-c k"))
; A mouse key is read as its event. A press or a move never ends a read,
; even when bound: the read goes on to the click or drag.
> (keys:bind! keys:global "<down-mouse-1>" keys:ignore)
> (start-in one "C-c" "k")
> (press-all! one '("<down-mouse-1>" #(3 7)) '("<mouse-movement>" #(3 8)) "<down-mouse-1>")
> (settle)
> (list (take-got!) (keys:reading one))
(() "C-c k")
> (press-all! one '("<drag-mouse-1>" #(3 7) #(3 9)))
> (settle)
> (take-got!)
((("<drag-mouse-1>" #(3 7) #(3 9)) #f "C-c k"))
; The reading command keeps its own prefix argument, and the read leaves
; the client's alone: a C-u read is data, not universal-argument.
> (start-in one "C-u" "3" "C-c" "k")
> (press-all! one "C-u")
> (settle)
> (take-got!)
(("C-u" 3 "C-c k"))
> (press-all! one "C-x" "C-f")
> (file-picker:take!)
(("notes.txt" #f))
; No temporary keymap is tested and advice on keys:press! sees the key.
> (define-table temporary)
> (define tested 0)
> (define end-temporary
    (keys:push-keymap! one temporary (lambda (found command) (set! tested (+ tested 1)) #t)))
> (define pressed '())
> (define (note-press press client key) (set! pressed (cons key pressed)) (press client key))
> (advice-add! keys:press! note-press)
> (start-in one "C-c" "k")
> (set! tested 0)
> (set! pressed '())
> (press-all! one "a")
> (settle)
> (list (take-got!) tested pressed)
((("a" #f "C-c k")) 0 ("a"))
> (advice-remove! keys:press! note-press)
> (end-temporary)
; A sequence read is finished by keys:press!'s rules and returned as
; typed, with no fallback applied; the keys read so far are pending.
> (define (read-sequence-of . keys)
    (start-in one "C-c" "s")
    (apply press-all! one keys)
    (settle)
    (car (take-got!)))
> (start-in one "C-c" "s")
> (press-all! one "C-x")
> (list (keys:pending one) (keys:reading one))
("C-x" "C-c s")
> (press-all! one "C-f")
> (settle)
> (list (take-got!) (file-picker:take!) (keys:pending one))
(("C-x C-f") () #f)
> (map (lambda (keys) (apply read-sequence-of keys))
    '(("ESC") ("C-F") ("C-g") ("C-x" "C-g") ("C-c" "z") (("<mouse-1>" #(3 7)))
      (("<down-mouse-1>" #(3 7)) ("<drag-mouse-1>" #(3 7) #(3 9))) ("C-x" ("<mouse-1>" #(3 7)))))
("ESC" "C-F" "C-g" "C-x C-g" "C-c z" ("<mouse-1>" #(3 7)) ("<drag-mouse-1>" #(3 7) #(3 9)) "C-x <mouse-1>")
; ESC as the Meta prefix, for a user who takes it out of the quit keys
; and unbinds it, waits for the next key and is returned as typed.
> (set-option! keys:quit-keys '("C-g"))
> (keys:unbind! keys:global "ESC")
> (read-sequence-of "ESC" "x")
"ESC x"
> (set-option! keys:quit-keys '("C-g" "ESC"))
> (keys:bind! keys:global "ESC" keys:keyboard-quit)
; Keys typed while a command waited before reading are an unfinished
; sequence: a sequence read continues them, and a key read drops them.
> (define go #f)
> (commands:define-command (wait-then-read [sequence? (commands:prefix-argument)])
    "Waits for go, then records the next key, or with a prefix argument the next key sequence."
    (suspend (lambda (resume) (set! go resume)))
    (set! got (cons (raised (if sequence? keys:read-key-sequence keys:read-key)) got)))
> (keys:bind! keys:global "C-c w" wait-then-read)
> (start-in one "C-u" "C-c" "w")
> (press-all! one "C-x")
> (go void)
> (settle)
> (list (keys:pending one) (keys:reading one))
("C-x" "C-c w")
> (press-all! one "C-f")
> (settle)
> (list (take-got!) (file-picker:take!))
(("C-x C-f") ())
> (start-in one "C-c" "w")
> (press-all! one "C-x")
> (go void)
> (settle)
> (list (keys:pending one) (keys:reading one))
(#f "C-c w")
> (press-all! one "C-f")
> (settle)
> (list (take-got!) (editing:take!))
(("C-f") ())
; A read may take a prompt, which keys:reading-prompt gives while the
; read waits; without one it gives #f.
> (commands:define-command (read-asking [sequence? (commands:prefix-argument)])
    "Records the next key, or with a prefix argument the next key sequence, read with a prompt."
    (set! got (cons (recorded (lambda () (if sequence? (keys:read-key-sequence "Keys: ") (keys:read-key "Key: ")))) got)))
> (keys:bind! keys:global "C-c a" read-asking)
> (start-in one "C-c" "a")
> (list (keys:reading one) (keys:reading-prompt one) (keys:reading-prompt two))
("C-c a" "Key: " #f)
> (press-all! one "x")
> (settle)
> (list (take-got!) (keys:reading-prompt one))
(("x") #f)
> (start-in one "C-u" "C-c" "a")
> (press-all! one "C-x")
> (list (keys:reading-prompt one) (keys:pending one))
("Keys: " "C-x")
> (press-all! one "C-f")
> (settle)
> (take-got!)
("C-x C-f")
> (start-in one "C-c" "k")
> (keys:reading-prompt one)
#f
> (press-all! one "y")
> (settle)
> (take-got!)
(("y" #f "C-c k"))
> (map (lambda (read) (raised (lambda () (read 'x)))) (list keys:read-key keys:read-key-sequence))
((keys:read-key "neither a string nor #f") (keys:read-key-sequence "neither a string nor #f"))
> (on-thread (lambda () (keys:reading-prompt one)))
(keys:reading-prompt "not on the main thread")
; A client has one read at a time.
> (start-in one "C-c" "w")
> (start-in one "C-c" "k")
> (go void)
> (settle)
> (take-got!)
((keys:read-key "a key is already being read for this client"))
; Another client's keys run while one reads, and each client reads on
; its own.
> (press-all! two "C-x" "C-f")
> (file-picker:take!)
(("notes.txt" #f))
> (start-in two "C-c" "k")
> (list (keys:reading one) (keys:reading two))
("C-c k" "C-c k")
> (press-all! two "c")
> (press-all! one "d")
> (settle)
> (take-got!)
(("c" #f "C-c k") ("d" #f "C-c k"))
; keys:lookup takes an event, with the fallbacks keys:press! applies.
> (keys:bind! keys:global "<mouse-1>" file-picker:find-file)
> (map (lambda (k) (name-of (keys:lookup one k)))
    '(("<mouse-1>" #(3 7)) ("<drag-mouse-1>" #(3 7) #(3 9)) ("S-<double-mouse-1>" #(3 7)) "<mouse-1>"))
(file-picker:find-file file-picker:find-file file-picker:find-file file-picker:find-file)
; Reading needs the main thread and a command a key ran.
> (map on-thread (list keys:read-key keys:read-key-sequence (lambda () (keys:reading one))))
((keys:read-key "not on the main thread") (keys:read-key-sequence "not on the main thread") (keys:reading "not on the main thread"))
> (map raised (list keys:read-key keys:read-key-sequence))
((keys:read-key "no command a key ran is running") (keys:read-key-sequence "no command a key ran is running"))
> (raised (lambda () (keys:lookup one 'C-x)))
(keys:lookup "not a valid key sequence")
; While a client reads, its page marks no key as a quit; it has its quit
; keys back once the read has its key.
> (define (calls)
    (map (lambda (call) (cons (web:client-number (car call)) (cdr call))) (web:take-calls!)))
> (define c1 (web:make-client 1))
> (define c2 (web:make-client 2))
> (web:connect! c1)
> (web:connect! c2)
> (calls)
((1 "keys-settings" (("quitKeys" . #("C-g" "ESC")) ("leftOptionMeta" . #t) ("rightOptionMeta" . #f))) (2 "keys-settings" (("quitKeys" . #("C-g" "ESC")) ("leftOptionMeta" . #t) ("rightOptionMeta" . #f))))
> (start-in c1 "C-c" "k")
> (calls)
((1 "keys-settings" (("quitKeys" . #()) ("leftOptionMeta" . #t) ("rightOptionMeta" . #f))))
> (press-all! c1 "C-g")
> (settle)
> (list (take-got!) (calls))
((("C-g" #f "C-c k")) ((1 "keys-settings" (("quitKeys" . #("C-g" "ESC")) ("leftOptionMeta" . #t) ("rightOptionMeta" . #f)))))
; When its client is removed, a read raises &quit in its command, also
; when the key it took has not yet reached the command.
> (start-in c1 "C-c" "k")
> (web:client-removed c1)
> (settle)
> (list (take-got!) (keys:reading c1))
(((quit #f "C-c k")) #f)
> (start-in c2 "C-c" "k")
> (start-in c1 "C-c" "k")
> (begin (keys:press! c1 "e") (web:client-removed c1))
> (settle)
> (list (take-got!) (keys:reading c2))
(((quit #f "C-c k")) "C-c k")
; Reloading the plugin raises &quit in every read, whether or not its
; key is in hand. The commands' keys were the old instance's.
> (import (tuna eval))
> (start-in one "C-c" "k")
> (begin (keys:press! c2 "f") (eval-file (string-append (getenv "TUNA_LIBRARY") "/keys.sls")))
> (settle)
> (list (take-got!) (keys:reading one) (keys:reading c2))
(((quit #f #f) (quit #f #f)) #f #f)
> (start-in one "C-c" "k")
> (press-all! one "g")
> (settle)
> (take-got!)
(("g" #f "C-c k"))
; Known defect: keys admitted in one burst should keep their order, so
; x should run after the reading command has TAB. The command resumes at
; the tail of the main thread's queue, behind x, so x runs first.
> (commands:define-command (read-after-typing)
    "Records the next key and what was typed before the command had it."
    (let ([key (keys:read-key)])
      (set! got (cons (list key (editing:take!)) got))))
> (keys:bind! keys:global "C-c t" read-after-typing)
> (begin
    (for-each (lambda (keys) (spawn-task (lambda () (apply press-all! one keys))))
              '(("C-c" "t") ("TAB") ("x")))
    (void))
> (settle)
> (take-got!)
(("TAB" ((self-insert #\x 1))))
