#<edit 3>
; A segment's keymap comes first. A command it runs finds its window as
; the part the clicked node of the layout leads to.
> (define clicked '())
> (commands:define-command (note-click [event (keys:command-event)])
    "Notes where a click on the segment ran."
    (set! clicked (list (eq? (views:current) layout:screen-view)
                        (eq? (layout:part-view (views:posn-node (keys:event-end event))) (cadr windows)))))
> (tables:define-table name-keys "Clicks on the name.")
> (define (show-name view) (buffers:name (views:buffer view)))
> (status-line:define-segment name (show show-name) (keymap name-keys))
> (keys:bind! name-keys "<mouse-1>" note-click)
> (tables:set! status-line:segments name (status-line:left 25))
> (click-status! (cadr windows) 1 name-keys)
> clicked
(#t #t)
; A segment whose keymap binds the left button is marked clickable; one
; that binds only the right button, and the line, whose keymap binds no
; left click, carry no state.
> (tables:define-table menu-keys "Right clicks on a segment.")
> (keys:bind! menu-keys "<mouse-3>" note-click)
> (map (lambda (k) (let ([m (views:keymap-mark k)]) (substring m (string-length (number->string (mark-number k))) (string-length m))))
       (list name-keys menu-keys status-line:keymap))
(" clickable" "" "")
; A key the segment's keymap does not bind falls through to
; status-line:keymap, as Emacs's local-map on a mode-line string falls
; through to the mode line's mouse bindings: the middle button keeps only
; the clicked window in its level.
> (click-status! (cadr windows) 2 name-keys)
> (list (length (layout:views)) (eq? (view) (cadr windows)))
(1 #t)
