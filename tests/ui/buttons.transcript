; A click on the label of a button whose module is gone finds no
; button.
> (define c (buffers:make "*gone*" "\n"))
> (with-output-to-file (string-append (getenv "HOME") "/.config/tuna/lib/gone.sls")
    (lambda ()
      (display "#!tuna\n")
      (write '(import (ui) (commands)))
      (write '(commands:define-command (hi) "Hi." (display "hi\n")))
      (write '(ui:define-button bye hi))))
> (load-module! '(gone))
#<owner (gone) 1>
> (buffers:replace! c 1 1 (list 'gone:bye '() "Bye"))
#<edit 1>
> (show! c)
> (click-at! (view) 3)
hi
> (unload-owner! (module-owner '(gone)))
