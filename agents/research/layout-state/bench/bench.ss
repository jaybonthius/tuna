prelude: :gerbil/core
(import :std/text/markup/sxml/print)
(export main)

(def sink 0)
(def (say . xs) (for-each display xs) (newline))
(def (now) (real-time))
(def (bench-fn label n thunk)
  (let* ((t0 (now))
         (_ (let lp ((i 0)) (when (fx< i n) (set! sink (thunk)) (lp (fx1+ i)))))
         (dt (- (now) t0)))
    (say "  " label ": " (/ (round (* 1e9 (/ dt n))) 1000.) " us/op (n=" n ")")))
(defrule (bench label n body) (bench-fn label n (lambda () body)))

(def mask #xFFFFFFF)
(def (mix h x) (fxand (fx+ (fx* (fxand h #xFFFFFF) 31) x) mask))

;;; ---- persistent node (immutable by convention): path copy + cached Merkle hash
(defstruct pn (id payload kids hash) final: #t)
(def (leaf-hash id payload) (mix (mix 7 id) payload))
(def (kids-hash id kids)
  (let lp ((i 0) (h (mix 11 id)))
    (if (fx< i (vector-length kids)) (lp (fx1+ i) (mix h (pn-hash (vector-ref kids i)))) h)))
(def next-id 0)
(def (build-p fanouts)
  (set! next-id (fx1+ next-id))
  (let (id next-id)
    (if (null? fanouts)
      (pn id 0 #f (leaf-hash id 0))
      (let (kids (make-vector (car fanouts) #f))
        (let lp ((i 0)) (when (fx< i (vector-length kids)) (vector-set! kids i (build-p (cdr fanouts))) (lp (fx1+ i))))
        (pn id 0 kids (kids-hash id kids))))))
(def (count-p n) (if (pn-kids n) (let lp ((i 0) (c 1)) (if (fx< i (vector-length (pn-kids n))) (lp (fx1+ i) (fx+ c (count-p (vector-ref (pn-kids n) i)))) c)) 1))
;; path = list of child indexes; update leaf payload, path-copy, recompute hash on path only
(def (update-p n path payload)
  (if (null? path)
    (pn (pn-id n) payload #f (leaf-hash (pn-id n) payload))
    (let* ((kids (vector-copy (pn-kids n)))
           (i (car path)))
      (vector-set! kids i (update-p (vector-ref kids i) (cdr path) payload))
      (pn (pn-id n) (pn-payload n) kids (kids-hash (pn-id n) kids)))))
;; same without hash maintenance
(def (update-p-nohash n path payload)
  (if (null? path)
    (pn (pn-id n) payload #f 0)
    (let* ((kids (vector-copy (pn-kids n))) (i (car path)))
      (vector-set! kids i (update-p-nohash (vector-ref kids i) (cdr path) payload))
      (pn (pn-id n) (pn-payload n) kids 0))))
;; full recompute (what you pay with Merkle hashes but no caching)
(def (full-hash-p n)
  (if (pn-kids n)
    (let (kids (pn-kids n))
      (let lp ((i 0) (h (mix 11 (pn-id n))))
        (if (fx< i (vector-length kids)) (lp (fx1+ i) (mix h (full-hash-p (vector-ref kids i)))) h)))
    (leaf-hash (pn-id n) (pn-payload n))))
;; list-children variant (what buffers.ss uses today: children is a list)
(defstruct ln (id payload kids) final: #t)
(def (build-l fanouts)
  (set! next-id (fx1+ next-id))
  (ln next-id 0 (if (null? fanouts) '() (let lp ((i 0) (acc '())) (if (fx< i (car fanouts)) (lp (fx1+ i) (cons (build-l (cdr fanouts)) acc)) acc)))))
(def (list-set l i v) (if (fx= i 0) (cons v (cdr l)) (cons (car l) (list-set (cdr l) (fx1- i) v))))
(def (update-l n path payload)
  (if (null? path) (ln (ln-id n) payload '())
      (ln (ln-id n) (ln-payload n) (list-set (ln-kids n) (car path) (update-l (list-ref (ln-kids n) (car path)) (cdr path) payload)))))

;;; ---- mutable node with parent pointer, revisions, change journal
(defstruct mn (id payload kids parent rev) final: #t)
(def journal '())
(def journal-len 0)
(def global-rev 0)
(def (build-m fanouts parent)
  (set! next-id (fx1+ next-id))
  (let (n (mn next-id 0 #f parent 0))
    (when (pair? fanouts)
      (let (kids (make-vector (car fanouts) #f))
        (let lp ((i 0)) (when (fx< i (vector-length kids)) (vector-set! kids i (build-m (cdr fanouts) n)) (lp (fx1+ i))))
        (set! (mn-kids n) kids)))
    n))
(def (leaf-at-m n path) (if (null? path) n (leaf-at-m (vector-ref (mn-kids n) (car path)) (cdr path))))
;; mutate + bump rev on ancestors (per-node revisions) + journal entry (bounded 1000)
(def (update-m! leaf payload)
  (set! global-rev (fx1+ global-rev))
  (set! (mn-payload leaf) payload)
  (set! journal (cons (cons global-rev (mn-id leaf)) journal))
  (set! journal-len (fx1+ journal-len))
  (when (fx> journal-len 1000) (set! journal (list-head journal 500)) (set! journal-len 500))
  (let lp ((n leaf)) (when n (set! (mn-rev n) global-rev) (lp (mn-parent n)))))
(def (list-head l k) (if (or (fx= k 0) (null? l)) '() (cons (car l) (list-head (cdr l) (fx1- k)))))
;; mutable + Merkle hash invalidated on path then recomputed lazily on path
(defstruct hn (id payload kids parent hash) final: #t)
(def (build-h fanouts parent)
  (set! next-id (fx1+ next-id))
  (let (n (hn next-id 0 #f parent #f))
    (when (pair? fanouts)
      (let (kids (make-vector (car fanouts) #f))
        (let lp ((i 0)) (when (fx< i (vector-length kids)) (vector-set! kids i (build-h (cdr fanouts) n)) (lp (fx1+ i))))
        (set! (hn-kids n) kids)))
    n))
(def (hash-h! n)
  (or (hn-hash n)
      (let (h (if (hn-kids n)
                (let (kids (hn-kids n)) (let lp ((i 0) (h (mix 11 (hn-id n)))) (if (fx< i (vector-length kids)) (lp (fx1+ i) (mix h (hash-h! (vector-ref kids i)))) h)))
                (leaf-hash (hn-id n) (hn-payload n))))
        (set! (hn-hash n) h) h)))
(def (leaf-at-h n path) (if (null? path) n (leaf-at-h (vector-ref (hn-kids n) (car path)) (cdr path))))
(def (update-h! leaf payload)
  (set! (hn-payload leaf) payload)
  (let lp ((n leaf)) (when n (set! (hn-hash n) #f) (lp (hn-parent n)))))
(def (root-of-h n) (if (hn-parent n) (root-of-h (hn-parent n)) n))

;;; ---- arena of ids: id -> record in hash table; children are id vectors
(defstruct an (payload kids parent rev) final: #t)
(def (build-a fanouts parent tbl)
  (set! next-id (fx1+ next-id))
  (let* ((id next-id) (n (an 0 #f parent 0)))
    (hash-put! tbl id n)
    (when (pair? fanouts)
      (let (kids (make-vector (car fanouts) #f))
        (let lp ((i 0)) (when (fx< i (vector-length kids)) (vector-set! kids i (build-a (cdr fanouts) id tbl)) (lp (fx1+ i))))
        (set! (an-kids n) kids)))
    id))
(def (update-a! tbl id payload)
  (set! global-rev (fx1+ global-rev))
  (let (n (hash-ref tbl id)) (set! (an-payload n) payload)
    (let lp ((n n)) (set! (an-rev n) global-rev) (when (an-parent n) (lp (hash-ref tbl (an-parent n)))))))

;;; ---- rendering
(def (render-p n port)   ; full traversal -> HTML string port
  (write-string "<div id=\"n" port) (write (pn-id n) port) (write-string "\">" port)
  (if (pn-kids n)
    (let (kids (pn-kids n)) (let lp ((i 0)) (when (fx< i (vector-length kids)) (render-p (vector-ref kids i) port) (lp (fx1+ i)))))
    (begin (write (pn-payload n) port)))
  (write-string "</div>" port))
(def (traverse-p n)  ; traversal only, count
  (if (pn-kids n)
    (let (kids (pn-kids n)) (let lp ((i 0) (c 1)) (if (fx< i (vector-length kids)) (lp (fx1+ i) (fx+ c (traverse-p (vector-ref kids i)))) c)))
    1))
(def (sxml-p n)  ; build SXML tree for whole thing
  (if (pn-kids n)
    (let (kids (pn-kids n)) `(div (@ (id ,(string-append "n" (number->string (pn-id n))))) ,@(let lp ((i (fx1- (vector-length kids))) (acc '())) (if (fx< i 0) acc (lp (fx1- i) (cons (sxml-p (vector-ref kids i)) acc))))))
    `(div (@ (id ,(string-append "n" (number->string (pn-id n))))) ,(number->string (pn-payload n)))))
;; memoized render: eq-keyed cache of rendered strings per persistent node
(def (render-memo n cache)
  (or (hash-get cache n)
      (let (s (if (pn-kids n)
                (let (port (open-output-string))
                  (write-string "<div>" port)
                  (let (kids (pn-kids n)) (let lp ((i 0)) (when (fx< i (vector-length kids)) (write-string (render-memo (vector-ref kids i) cache) port) (lp (fx1+ i)))))
                  (write-string "</div>" port) (get-output-string port))
                (string-append "<div>" (number->string (pn-payload n)) "</div>")))
        (hash-put! cache n s) s)))
(def (render-dirty-m n since port) ; mutable tree: visit only subtrees with rev > since
  (when (fx> (mn-rev n) since)
    (if (mn-kids n)
      (let (kids (mn-kids n)) (let lp ((i 0)) (when (fx< i (vector-length kids)) (render-dirty-m (vector-ref kids i) since port) (lp (fx1+ i)))))
      (begin (write (mn-id n) port) (write (mn-payload n) port)))))
(def (data-p n)  ; plain-data (for persistence)
  (if (pn-kids n) (cons (pn-id n) (vector->list (vector-map data-p (pn-kids n)))) (list (pn-id n) (pn-payload n))))

(def (path-for fanouts) (map (lambda (f) (quotient f 2)) fanouts))

(def (run-size label fanouts iters)
  (say "") (say "== " label "  fanouts=" fanouts)
  (set! next-id 0)
  (let* ((p (build-p fanouts)) (total (count-p p)) (path (path-for fanouts)))
    (say "  nodes: " total "  depth: " (length fanouts))
    (bench "persistent path-copy, vector kids, no hash   " iters (update-p-nohash p path 5))
    (bench "persistent path-copy + Merkle hash on path   " iters (pn-hash (update-p p path 5)))
    (set! next-id 0)
    (let (l (build-l fanouts))
      (bench "persistent path-copy, LIST kids (buffers.ss)" iters (ln-id (update-l l path 5))))
    (bench "Merkle FULL recompute (no cache)             " (max 3 (quotient iters 100)) (full-hash-p p))
    (set! next-id 0)
    (let* ((m (build-m fanouts #f)) (leaf (leaf-at-m m path)))
      (bench "mutable set + ancestor revs + journal entry  " iters (begin (update-m! leaf 5) 1)))
    (set! next-id 0)
    (let* ((h (build-h fanouts #f)) (leaf (leaf-at-h h path)))
      (hash-h! h)
      (bench "mutable + invalidate hash on path + relazy   " iters (begin (update-h! leaf 5) (hash-h! h))))
    (set! next-id 0)
    (let* ((tbl (make-hash-table-eqv)) (root (build-a fanouts #f tbl))
           (leaf (let lp ((id root) (path path)) (if (null? path) id (lp (vector-ref (an-kids (hash-ref tbl id)) (car path)) (cdr path))))))
      (bench "arena (id->record table) set + ancestor revs " iters (begin (update-a! tbl leaf 5) 1)))
    ;; rendering
    (bench "full traversal (count only)                  " (max 5 (quotient iters 100)) (traverse-p p))
    (bench "full render to HTML string port              " (max 5 (quotient iters 200)) (string-length (let (port (open-output-string)) (render-p p port) (get-output-string port))))
    (let (cache (make-hash-table-eq))
      (render-memo p cache)
      (bench "memoized render after 1 path-copy update     " iters (string-length (render-memo (update-p p path 5) cache))))
    (set! next-id 0)
    (let* ((m (build-m fanouts #f)) (leaf (leaf-at-m m path)))
      (update-m! leaf 5)
      (bench "render only dirty subtrees (mutable, revs)   " iters (begin (let (port (open-output-string)) (render-dirty-m m (fx1- global-rev) port) (string-length (get-output-string port))))))
    ;; persistence
    (bench "persist: write plain data to string          " (max 3 (quotient iters 200)) (string-length (call-with-output-string "" (lambda (port) (write (data-p p) port)))))
    (let (s (call-with-output-string "" (lambda (port) (write (data-p p) port))))
      (say "  persisted size: " (string-length s) " bytes")
      (bench "persist: read plain data from string         " (max 3 (quotient iters 200)) (length (read (open-input-string s)))))))

(def (main . args)
  (say "Gerbil " (gerbil-version-string))
  (run-size "layout tree" '(3 4 3) 20000)
  (run-size "buffer 10k"  '(20 10 50) 2000)
  (run-size "buffer 50k"  '(100 10 50) 2000)
  (run-size "buffer 100k" '(200 10 50) 2000)
  ;; wide flat case: one parent with 50k children (e.g. one-node-per-line buffer)
  (run-size "flat 50k (root with 50k kids)" '(50000) 500)
  ;; SXML -> HTML cost for a visible window of ~500 nodes (full morph of what the user sees)
  (set! next-id 0)
  (let (w (build-p '(10 50)))
    (bench "SXML build + write-sxml, 511 nodes (viewport)" 200 (string-length (call-with-output-string "" (lambda (port) (write-sxml (sxml-p w) port: port xml?: #f))))))
  (displayln "sink " sink))
