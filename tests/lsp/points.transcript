> (lsp:define-server shaper (fake-command "shaper"))
> (define path (string-append project "/c.fk"))
> (write-file! path "(define (f x)\n")
> (define (edit line from to text) `(("range" ("start" ("line" . ,line) ("character" . ,from)) ("end" ("line" . ,line) ("character" . ,to))) ("newText" . ,text)))
> (define (answer! . edits)
    (configure! "shaper" '(capabilities ("textDocumentSync" . 2) ("documentOnTypeFormattingProvider" ("firstTriggerCharacter" . "\n")))
                         `(responses ("textDocument/onTypeFormatting" . ,(if (and (pair? edits) (eq? (car edits) 'delay)) `(delay ,(cadr edits) ,(list->vector (cddr edits))) (list->vector edits))))
                         '(name . "shaper")))
> (answer! (edit 1 0 0 "  "))
> (table-set! lsp:language-servers "fakelang" (list shaper))
> (add-hook! fake-mode-hook lsp:ensure)
> (define c (visit! path))
> (wait-for "shaper" "textDocument/didOpen")
> (define (around v) (let ([doc (buffers:document c)] [p (views:point v)]) (list (document:text doc 0 p) (document:text doc p (document:length doc)))))
> (define (ret! answered)
    (press! "RET")
    (let ([version (buffers:version c)])
      (wait-for "shaper" "textDocument/onTypeFormatting" answered)
      (testing:wait-until (lambda () (not (= version (buffers:version c)))))))
; On-type formatting is off by default: RET asks the server nothing.
> (in-client (lambda () (views:set-point! (view) (+ 1 (string-length "(define (f x)")))))
> (define changes (length (of-method "shaper" "textDocument/didChange")))
> (press! "RET")
> (wait-for "shaper" "textDocument/didChange" (+ changes 1))
> (list (around (view)) (length (of-method "shaper" "textDocument/onTypeFormatting")))
(("(define (f x)\n" "\n") 0)
> (set-option! lsp:on-type-formatting? #t)
> (buffers:replace! c 1 (- (document:length (buffers:document c)) 1) "(define (f x)\n")
#<edit 2>
; RET at the end of a line: the server inserts the new line's indentation
; at point, and point ends after it.
> (in-client (lambda () (views:set-point! (view) (+ 1 (string-length "(define (f x)")))))
> (ret! 1)
> (around (view))
("(define (f x)\n  " "\n")
> (define (fresh! content before)
    (buffers:replace! c 1 (- (document:length (buffers:document c)) 1) content)
    (in-client (lambda () (views:set-point! (view) (+ 1 (string-length before))))))
; RET in the middle of a line: point ends after the indentation, before
; the text that followed it, whether the server inserts the indentation,
; replaces the whole line or sends several edits on it.
> (fresh! "(define (g y)(+ y 1))\n" "(define (g y)")
> (ret! 2)
> (around (view))
("(define (g y)\n  " "(+ y 1))\n")
> (answer! (edit 1 0 8 "  (+ y 1))"))
> (fresh! "(define (g y)(+ y 1))\n" "(define (g y)")
> (ret! 3)
> (around (view))
("(define (g y)\n  " "(+ y 1))\n")
> (answer! (edit 1 0 0 "  ") (edit 1 5 7 " ") (edit 1 8 11 " "))
> (fresh! "(define (h z)(list  z   1))\n" "(define (h z)")
> (ret! 4)
> (around (view))
("(define (h z)\n  " "(list z 1))\n")
; RET before a space: the server rewrites the new line's leading space
; as its indentation, and point, which was in that whitespace, ends at
; the end of the new indentation.
> (answer! (edit 2 0 1 "     "))
> (fresh! "(define (f x)\n  (+ x 1))\n" "(define (f x)\n  (+ x")
> (ret! 5)
> (around (view))
("(define (f x)\n  (+ x\n     " "1))\n")
; Every view's cursors are carried: a point where the server inserted
; ends after the insertion, and a mark there stays before it, as a mark
; is an anchor; a mark elsewhere keeps its place.
> (answer! 'delay 0.3 (edit 1 0 0 "  "))
> (fresh! "(define (k w)\n" "(define (k w)")
> (define v1 (view))
> (define v2 (layout-split:split-view! v1 (layout-split:direction row)))
> (layout:select! v1)
> (press! "RET")
> (wait-for "shaper" "textDocument/onTypeFormatting" 6)
> (in-client (lambda () (views:set-mark! v1 1) (views:set-point! v2 (views:point v1)) (views:set-mark! v2 (views:point v1))))
> (define version (buffers:version c))
> (testing:wait-until (lambda () (not (= version (buffers:version c)))))
> (list (around v1) (views:mark v1) (around v2) (- (views:point v2) (views:mark v2)))
(("(define (k w)\n  " "\n") 1 ("(define (k w)\n  " "\n") 2)
; With an indenter for its mode, RET indents in its own command, so the
; buffer has changed since the line break and on-type formatting asks
; nothing. A line break inserted after it by code asks, and is the only
; break asked about.
> (table-set! indentation:indenters fake-mode
    (lambda (buffer position) (if (= (document:line (buffers:document buffer) position) 1) 0 2)))
> (answer!)
> (fresh! "(define (m v)\n" "(define (m v)")
> (define asked (length (of-method "shaper" "textDocument/onTypeFormatting")))
> (press! "RET")
> (around (view))
("(define (m v)\n  " "\n")
> (let ([end (- (document:length (buffers:document c)) 1)]) (buffers:replace! c end end "\n") (void))
> (wait-for "shaper" "textDocument/onTypeFormatting" (+ asked 1))
> (map (lambda (m) (ref m "params" "position" "line")) (list-tail (of-method "shaper" "textDocument/onTypeFormatting") asked))
(3)
> (table-remove! indentation:indenters fake-mode)
; Edits at one start apply as the specification says: inserts there in
; the list's order, then the replacement that starts there; an insert
; listed after the replacement, which the specification does not allow,
; is kept, before it.
> (define (format-answer! . edits)
    (configure! "shaper" '(capabilities ("textDocumentSync" . 2) ("documentFormattingProvider" . #t))
                         `(responses ("textDocument/formatting" . ,(list->vector edits)))
                         '(name . "shaper")))
> (format-answer! (edit 0 0 0 "a") (edit 0 0 0 "b") (edit 0 0 1 "Z"))
> (lsp:reconnect (car (lsp:connections)))
> (wait-for "shaper" "textDocument/didOpen" 2)
> (fresh! "xyz\n" "xyz")
> (in-client (lambda () (lsp:format-buffer c)))
> (around (view))
("abZyz" "\n")
> (format-answer! (edit 0 0 1 "Z") (edit 0 0 0 "a"))
> (fresh! "xyz\n" "xyz")
> (in-client (lambda () (lsp:format-buffer c)))
> (around (view))
("aZyz" "\n")
