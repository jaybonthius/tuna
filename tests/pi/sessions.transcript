> (define (write-file! path lines)
    (call-with-output-file path (lambda (p) (for-each (lambda (l) (put-string p l) (newline p)) lines)) '(replace)))
> (define folder (string-append (getenv "HOME") "/agent/sessions/--home-groucho-src-tuna--"))
> (system (string-append "mkdir -p " folder))
0
; A folder's sessions, read from Pi's files: the session's id, its name,
; your first message on one line, how many messages it holds, and when
; it last changed, newest first.
> (write-file! (string-append folder "/2026-11-01_aaa.jsonl")
    (list (json->string '(("type" . "session") ("version" . 3) ("id" . "aaa") ("cwd" . "/home/groucho/src/tuna")))
          (json->string (entry "s" #f '(("role" . "system") ("content" . "") ("timestamp" . 0))))
          (json->string (entry "u" "s" (user-message "Fix the\nbuild")))
          (json->string (entry "a" "u" (assistant-message "stop" (text-block "Done"))))
          (json->string '(("type" . "session_info") ("id" . "i") ("parentId" . "a") ("name" . "Build fix")))))
