; In a table, C-n and C-p move to the cell below and above in the same
; column, at the same character of the cell as far as its text goes.
> (import (page))
> (define t (page:make "*table*" "Before\n\n| name | size |\n|---|---|\n| alpha | 1 |\n| b | 22 |\n\nAfter\n"))
> (show! t)
> (define (at text) (let* ([b (views:buffer (view))] [s (document:text (buffers:document b))]) (let loop ([i 0]) (if (string=? (substring s i (+ i (string-length text))) text) (buffers:stop b (document:position (buffers:document b) i (document:unit characters))) (loop (+ i 1))))))
> (define (cell-text) (let* ([doc (buffers:document (views:buffer (view)))] [p (views:point (view))] [n (document:enclosing doc p)]) (list (document:node-kind n) (document:text doc (document:node-start n) p) (document:text doc p (document:node-end n)))))
> (views:set-point! (view) (+ (at "name") 3))
> (press! "C-n")
> (cell-text)
(markdown:table-cell "alp" "ha\n")
> (press! "C-n")
> (cell-text)
(markdown:table-cell "b" "\n")
> (press! "C-p" "C-p")
> (cell-text)
(markdown:table-cell "nam" "e\n")
> (views:set-point! (view) (+ (at "size") 4))
> (press! "<down>" "<down>")
> (cell-text)
(markdown:table-cell "22" "\n")
; A count moves that many rows; past the table's edge, to the lines
; before or after the table, at the same column.
> (views:set-point! (view) (at "name"))
> (press! "C-u" "2" "C-n")
> (cell-text)
(markdown:table-cell "" "b\n")
> (press! "C-n")
> (cell-text)
(markdown:paragraph "" "After\n")
> (views:set-point! (view) (at "size"))
> (press! "C-p")
> (cell-text)
(markdown:paragraph "" "Before\n")
; The column is kept through a run of line motions, into the table and
; out of it.
> (views:set-point! (view) (+ (at "alpha") 4))
> (press! "C-n" "C-n")
> (cell-text)
(markdown:paragraph "Afte" "r\n")
> (views:set-point! (view) (+ (at "Before") 4))
> (press! "C-n" "C-n")
> (cell-text)
(markdown:table-cell "alph" "a\n")
; Shift extends the region from where point was, and the next motion
; without it clears that region.
> (views:set-point! (view) (at "name"))
> (press! "S-<down>")
> (list (views:mark (view)) (views:point (view)) (at "name") (at "alpha"))
(13 29 13 29)
> (press! "C-n")
> (list (views:mark (view)) (cell-text))
(#f (markdown:table-cell "" "b\n"))
; Other cursors in cells move by row too, and cursors outside the table
; by line.
> (views:set-point! (view) (at "name"))
> (views:add-cursor! (view) (at "size"))
#<cursor>
> (views:add-cursor! (view) (at "Before"))
#<cursor>
> (press! "C-n")
> (list (map views:cursor-point (views:cursors (view))) (at "alpha") (at "1\n") (at "name"))
((29 37 13) 29 37 13)
; Cursors that reach one cell merge, so typing there inserts once.
> (for-each (lambda (c) (views:remove-cursor! (view) c)) (cdr (views:cursors (view))))
> (views:set-point! (view) (at "name"))
> (views:add-cursor! (view) (at "alpha"))
#<cursor>
> (press! "C-u" "5" "C-n")
> (list (map views:cursor-point (views:cursors (view))) (cell-text))
((59) (markdown:paragraph "After" "\n"))
> (press! "x")
> (document:text (buffers:document t))
"Before\nname\nsize\nalpha\n1\nb\n22\nAfterx\n"
; At the buffer's edges, as next-line and previous-line: to the edge,
; then an error.
> (define e (page:make "*edges*" "| name | size |\n|---|---|\n| alpha | 1 |\n| b | 22 |\n"))
> (views:set-buffer! (view) e)
> (views:set-point! (view) (at "b\n"))
> (press! "C-n")
> (cell-text)
(markdown:table-cell "22" "\n")
> (press! "C-n")
! markdown:next-row: end of buffer
> (views:set-point! (view) (+ (at "size") 1))
> (press! "C-p")
> (cell-text)
(markdown:table-cell "" "name\n")
> (press! "C-p")
! markdown:previous-row: beginning of buffer
; The table remaps next-line and previous-line, so other keys bound to
; them move by row too.
> (keys:bind! keys:global "C-c n" editing:next-line)
> (views:set-buffer! (view) t)
> (views:set-point! (view) (at "name"))
> (press! "C-c" "n")
> (cell-text)
(markdown:table-cell "" "alpha\n")
; Where point is in a table: the header or a row counted after it, and
; the column; in a code block its own line and column.
> (define c (page:make "*code*" "Text\n\n```\none\ntwo\n```\n"))
> (views:set-buffer! (view) t)
> (views:set-point! (view) (at "22"))
> (views:with-view (view) (views:describe-at-point (view)))
"row 2, column 2"
> (views:set-point! (view) (at "size"))
> (views:with-view (view) (views:describe-at-point (view)))
"header, column 2"
> (views:set-buffer! (view) c)
> (views:set-point! (view) 14)
> (list (views:with-view (view) (views:describe-at-point (view))) (views:describe-line (document:token (buffers:document c) 0) (view)))
("L2" "L3")
> (raised (lambda () (markdown:describe-cell (document:token (buffers:document c) 0) (view))))
(markdown:describe-cell "not a Markdown table cell")
> (raised (lambda () (markdown:previous-row 'x)))
(markdown:previous-row "not an exact integer")
; Cells are isolating: no edit takes text into or out of one, and every
; row keeps its cells. On *sheet*, "Hi" is at 2-4, cell a at 9-10, cell
; b at 13-14 and "Yo" at 19-21.
> (define (sheet) (page:page '() (markdown:paragraph '() "Hi\n") (markdown:table '((columns . 2)) (markdown:table-row '() (markdown:table-cell '() "a\n") (markdown:table-cell '() "b\n"))) (markdown:paragraph '() "Yo\n")))
> (define made 0)
> (define (fresh-sheet point)
    (set! made (+ made 1))
    (let ([b (buffers:make (format "s~a" made) (sheet))]) (show! b) (views:set-point! (view) point) b))
> (define (on-sheet point . keys)
    (let ([b (fresh-sheet point)])
      (apply press! keys)
      (list (cddr (car (datums b))) (views:point (view)))))
> (define (unchanged? result) (equal? (car result) (cddr (sheet))))
> (map (lambda (case) (unchanged? (apply on-sheet case)))
       '((4 "C-d") (10 "C-d") (14 "C-d") (9 "DEL") (13 "DEL") (19 "DEL") (4 "C-k") (10 "C-k") (14 "C-k")
         (4 "M-d") (10 "M-d") (14 "M-d") (13 "M-DEL") (19 "M-DEL") (9 "M-^") (13 "M-^") (19 "M-^") (10 "M-u")))
(#t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t)
; A kill that removes nothing adds no entry, so the kill before stays
; the one C-y yanks and the clipboard holds.
> (let ([b (fresh-sheet 2)])
    (views:set-mark! (view) 4)
    (press! "M-w")
    (views:set-point! (view) 10)
    (press! "C-k" "C-y")
    (list (kill-ring:text (kill-ring:current)) (cddr (car (datums b)))))
("Hi" ((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "aHi\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")))
> (map (lambda (case) (cadr (apply on-sheet case))) '((4 "M-f") (10 "M-f") (9 "M-b") (19 "M-b")))
(4 10 9 19)
> (on-sheet 9 "C-u" "3" "C-d")
(((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "\n") (markdown:table-cell () "\n"))) (markdown:paragraph () "Yo\n")) 9)
> (on-sheet 9 "C-k")
(((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 9)
> (list (on-sheet 9 "C-u" "2" "C-k") (on-sheet 14 "C-u" "-" "1" "C-k"))
((((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 9) (((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "\n"))) (markdown:paragraph () "Yo\n")) 13))
> (on-sheet 2 "C-u" "2" "C-k")
(((markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 4)
> (list (on-sheet 9 "C-S-DEL") (on-sheet 13 "C-S-DEL"))
((((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 9) (((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "\n"))) (markdown:paragraph () "Yo\n")) 13))
> (list (on-sheet 2 "C-S-DEL") (on-sheet 19 "C-S-DEL"))
((((markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 4) (((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "\n")) 19))
> (on-sheet 2 "M-3" "M-u")
(((markdown:paragraph () "HI\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 4)
> (on-sheet 10 "C-t")
! editing:transpose-chars: no two characters to transpose
(((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 10)
> (on-sheet 13 "M-t")
! editing:transpose-words: no two words to transpose
(((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 13)
; Lines in different cells move as texts, so the cells stay.
> (list (on-sheet 13 "C-x" "C-t") (on-sheet 9 "M-<down>") (on-sheet 19 "C-x" "C-t"))
((((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "b\n") (markdown:table-cell () "a\n"))) (markdown:paragraph () "Yo\n")) 19) (((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "b\n") (markdown:table-cell () "a\n"))) (markdown:paragraph () "Yo\n")) 13) (((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "Yo\n"))) (markdown:paragraph () "b\n")) 21))
; Regions: typing over one deletes it first and goes where the deletion
; leaves the cursor; a kill reaching into cells yanks back as text.
> (options:set! editing:delete-selection #t)
> (define (over-sheet point mark . keys)
    (let ([b (fresh-sheet point)])
      (views:set-mark! (view) mark)
      (apply press! keys)
      (list (cddr (car (datums b))) (views:point (view)))))
> (over-sheet 14 3 "x")
(((markdown:paragraph () "Hx\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "\n") (markdown:table-cell () "\n"))) (markdown:paragraph () "Yo\n")) 4)
> (over-sheet 13 2 "x")
(((markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "x\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 5)
> (over-sheet 20 10 "x")
(((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "ax\n") (markdown:table-cell () "\n"))) (markdown:paragraph () "o\n")) 11)
> (options:set! editing:delete-selection #f)
> (list (over-sheet 13 2 "C-w" "C-y") (kill-ring:text (kill-ring:current)))
((((markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "Hi\na\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 8) "Hi\na")
> (kill-ring:push! (list (buffers:piece (page:make "*plan*" "# Plan\n\nBuy.\n") 1 8)))
> (on-sheet 9 "C-y")
(((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "Plan\na\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 14)
> (kill-ring:push! (list "one"))
> (kill-ring:push! (list "two"))
> (on-sheet 9 "C-y" "M-y")
(((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "onea\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 12)
> (on-sheet 10 "RET")
(((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n\n") (markdown:table-cell () "b\n"))) (markdown:paragraph () "Yo\n")) 11)
; The primary selection and duplicate-dwim read a region as M-w does.
> (begin (fresh-sheet 14) (views:set-mark! (view) 3) (press! "C-f" "C-b") (kill-ring:text (list (editing:primary-selection))))
"iab"
> (let ([b (fresh-sheet 14)]) (views:set-mark! (view) 9) (in-client (lambda () (commands:run editing:duplicate-dwim 1))) (cddr (car (datums b))))
((markdown:paragraph () "Hi\n") (markdown:table ((columns . 2)) (markdown:table-row () (markdown:table-cell () "a\n") (markdown:table-cell () "bab\n"))) (markdown:paragraph () "Yo\n"))
; A row of one cell is a line, which C-S-DEL removes, unless the table
; is the buffer's last block.
> (define one (page:make "*one*" "Hi\n\n| a |\n|---|\n| b |\n\nYo\n"))
> (show! one)
> (views:set-point! (view) (at "b\n"))
> (press! "C-S-DEL")
> (list (cddr (car (datums one))) (views:point (view)))
(((markdown:paragraph ((key . 0)) "Hi\n") (markdown:table ((key . 1) (columns . 1)) (markdown:table-row ((key . 0) (header . #t)) (markdown:table-cell ((key . 0)) "a\n"))) (markdown:paragraph ((key . 2)) "Yo\n")) 15)
> (define last (page:make "*last*" "Hi\n\n| a |\n|---|\n| b |\n"))
> (show! last)
> (views:set-point! (view) (at "b\n"))
> (press! "C-S-DEL")
> (cddr (car (datums last)))
((markdown:paragraph ((key . 0)) "Hi\n") (markdown:table ((key . 1) (columns . 1)) (markdown:table-row ((key . 0) (header . #t)) (markdown:table-cell ((key . 0)) "a\n")) (markdown:table-row ((key . 1)) (markdown:table-cell ((key . 0)) "\n"))))
; A table of two rows: a region from "Hi" into the second row's first
; cell removes the first row and shortens that cell.
> (define two (page:make "*two*" "Hi\n\n| a | b |\n|---|---|\n| c | d |\n\nYo\n"))
> (show! two)
> (views:set-point! (view) (+ (at "c\n") 1))
> (views:set-mark! (view) (at "Hi"))
> (press! "C-w")
> (list (cddr (car (datums two))) (views:point (view)))
(((markdown:table ((key . 1) (columns . 2)) (markdown:table-row ((key . 1)) (markdown:table-cell ((key . 0)) "\n") (markdown:table-cell ((key . 1)) "d\n"))) (markdown:paragraph ((key . 2)) "Yo\n")) 4)
