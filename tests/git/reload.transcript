; A reload of git keeps each repository's queue and log: a command
; called after the reload waits for the one running from before it, and
; both stay in the log.
> (define (reload! name) (eval-file (string-append (getenv "TUNA_LIBRARY") "/" name ".sls")))
> (sample-repository! "repo")
> (define repo (git:find-repository (at "repo")))
> (define old-ended #f)
> (define sleeper (git:start repo '("-c" "alias.nap=!sleep 2" "nap") (lambda (c) (set! old-ended (real-time)))))
> (testing:wait-until (lambda () (git:running repo)))
> (reload! "git")
> (list (eq? (git:running repo) sleeper) (git:queued? repo))
(#t #t)
> (git:run repo '("tag" "after-reload"))
#vu8()
> (define new-ended (real-time))
> (and old-ended (< old-ended new-ended))
#t
> (map git:command-arguments (git:commands repo))
(("-c" "alias.nap=!sleep 2" "nap") ("tag" "after-reload"))
> (map git:command-exit (git:commands repo))
(0 0)
