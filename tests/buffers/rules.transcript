; An edit to a buffer inside with-silent-edits of it is silent: undo
; records none, and it leaves modified? as it was. Edits to other
; buffers there are not.
> (define quiet (fresh "abc\n"))
> (define other (fresh "xyz\n"))
> (buffers:with-silent-edits quiet (buffers:replace! other 1 1 "o") (buffers:replace! quiet 1 1 "q") (values 'one 'two))
one
two
> (list (buffers:modified? quiet) (buffers:modified? other) (map buffers:edit-silent? (buffers:edits-since quiet 0)) (map buffers:edit-silent? (buffers:edits-since other 0)))
(#f #t (#t) (#f))
> (buffers:replace! quiet 1 1 "Q")
#<edit 2>
> (buffers:with-silent-edits quiet (buffers:replace! quiet 1 1 "q"))
#<edit 3>
> (list (buffers:modified? quiet) (buffers:save-stamp quiet))
(#t 1)
; A task that pauses inside the body is still inside it.
