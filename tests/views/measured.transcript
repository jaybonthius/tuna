; Point at line 1 moved last, so the newest placement follows point. The
; desktop confirms it at line 1, then its view moves to line 100 by no
; hand, as the browser's find in page moves it. The run stays around
; what the browser shows, and point stays where it is.
> (define b (buffers:make "long" (lines 1000)))
> (define v (views:make b))
> (drawn v desktop)
(1 201 201 () ())
> (report! desktop v 1 0 #f '("hand" . #f))
> (drawn v desktop)
(1 81 81 () (20207))
> (report! desktop v 100 0 #f '("hand" . #f))
> (list (drawn v desktop) (drawn v desktop) (drawn v desktop))
((60 160 101 (1180) (20207)) (60 160 101 (1180) (20207)) (60 160 101 (1180) (20207)))
> (report! desktop v 100 0 #t '("hand" . #f))
> (list (drawn v desktop) (drawn v desktop))
((60 160 101 (1180) (20207)) (60 160 101 (1180) (20207)))
> (list (line-of v (views:top v desktop)) (line-of v (views:point v)))
(100 1)
; Until the browser has measured the newest placement, a client drawn
; with no map yet waits to scroll, then scrolls by the map its report
; made.
> (define (run client command) (views:with-view v (as-client client (lambda () (commands:run command)))))
> (define tablet (web:make-client 5))
> (drawn v tablet)
(1 201 201 () ())
> (run tablet views:scroll-up)
> (report! tablet v 1 0 #f)
> (placement v tablet)
(new position 19)
; A view atom that names a view already drawn makes a copy at its place,
; which measures its own maps: an edit keeps the original's.
> (import (md))
> (report! desktop v 100 0 #f)
> (drawn v desktop)
(60 160 101 (1180) (20207))
> (define host (buffers:make "host" (md:doc '() (views:view `((view . ,(views:id v)) (buffer . "long"))) (views:view `((view . ,(views:id v)) (buffer . "long"))))))
> (define doc (buffers:document host))
> (define copy (let* ([original (views:atom-view (document:token doc 1))] [copy (views:atom-view (document:token doc 2))])
                 (assert (eq? original v))
                 copy))
> (eq? copy v)
#f
> (drawn copy desktop)
(1 300 300 () ())
> (buffers:replace! b 5 5 "x")
#<edit 1>
> (drawn v desktop)
(60 160 101 (1180) (20207))
; The scroll sizer is the map's total again after a narrowing, a widening
; or a fold.
> (define w (views:make b))
> (drawn w desktop)
(1 201 201 () ())
> (report! desktop w 1 0 #t)
> (drawn w desktop)
(1 81 81 () (20205))
> (views:narrow! w (line-start w 100) (+ 3 (line-start w 300)))
> (drawn w desktop)
(100 160 61 () (4006))
> (views:widen! w)
> (drawn w desktop)
(50 150 101 (980) (19998))
> (views:fold! w (line-start w 130) (line-start w 600))
> (drawn w desktop)
(50 130 81 (980) (19998))
; A fold hides the newlines it holds, so its first line and the text
; after it are one item. Once a report measures it, the run goes on
; past it.
> (report! desktop w 125 0 #t)
> (drawn w desktop)
(85 655 101 (1680) (10600))
> (and (search (html-of w desktop) "</span>line 600</div>" 0) #t)
#t
> (views:unfold! w (line-start w 130))
; A report of a character narrower than a px estimates a row as no
; wider in characters than in px.
> (views:set-option! w views:wrap-lines #t)
> (drawn w desktop)
(1 325 325 () ())
> (report! desktop w 120 0 #f '("charWidth" . 1e-300))
> (drawn w desktop)
(60 200 141 (1180) (20174))
; A device keeps the maps of only the widths its clients last reported:
; back at a width it left, a client measures a map anew.
> (define u (views:make b))
> (drawn u desktop)
(1 201 201 () ())
> (report! desktop u 1 0 #t)
> (drawn u desktop)
(1 81 81 () (20205))
> (report! desktop u 1 0 #t '("items" . #(#((("at" . 1)) 900))))
> (drawn u desktop)
(1 37 37 () (21085))
> (report! desktop u 1 0 #t '("width" . 700))
> (report! desktop u 1 0 #t)
> (drawn u desktop)
(1 63 63 () (20159))
