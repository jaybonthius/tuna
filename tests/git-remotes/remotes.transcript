> (define repo (fresh! "repo"))
> (sh "cd repo && git config user.name Tuna && git config user.email tuna@example.org")
> (define (last-command) (git:command-arguments (car (reverse (git:commands repo)))))
> (define (menu-now) (settle!) (menu))
; P shows the push menu; p and u name the push-remote branch and the
; upstream when set.
> (press! "P")
> (menu-now)
("Push" ("Arguments" ("- f" "Force with lease" "--force-with-lease") ("- F" "Force" "--force") ("- h" "Disable hooks" "--no-verify") ("- n" "Dry run" "--dry-run") ("- T" "Include all tags" "--tags") ("- t" "Include related annotated tags" "--follow-tags")) ("Push main to" ("p" "pushRemote, setting that") ("u" "origin/main") ("e" "elsewhere")))
> (press! "C-g")
; P u pushes to the upstream; Git finished; Unmerged into goes.
> (press! "P" "u")
> (settle!)
> (list (last-command) (take-said!) (list-head (status) 2) (exists (lambda (l) (and (> (string-length l) 8) (string=? (substring l 0 8) "Unmerged"))) (status)))
(("push" "-v" "origin" "main:refs/heads/main") ("Git finished") ("Head:     main long" "Merge:    origin/main long") #f)
; P p with no push-remote reads one, sets it and pushes.
> (answer! "origin")
> (press! "P" "p")
> (settle!)
> (list (take-asked!) (last-command) (git-out "repo" "config" "branch.main.pushRemote"))
(("Set branch.main.pushRemote and push there (default origin): ") ("push" "-v" "origin" "refs/heads/main:refs/heads/main") "origin\n")
; with a push-remote, P p pushes without asking; C-u P p asks again.
> (press! "P" "p")
> (settle!)
> (take-asked!)
()
> (answer! "origin")
> (press! "P" "C-u" "p")
> (settle!)
> (take-asked!)
("Set branch.main.pushRemote and push there (default origin): ")
; P u with no upstream reads one and pushes with --set-upstream.
> (sh "cd repo && git checkout -q -b topic")
> (git-mode:refresh-repository repo)
> (answer! "origin/topic")
> (press! "P" "u")
> (settle!)
> (list (take-asked!) (last-command) (git-out "repo" "rev-parse" "--abbrev-ref" "topic@{upstream}"))
(("Set upstream of topic and push there: ") ("push" "-v" "--set-upstream" "origin" "topic:refs/heads/topic") "origin/topic\n")
; P e reads a remote branch and pushes there.
> (answer! "origin/elsewhere")
> (press! "P" "e")
> (settle!)
> (list (take-asked!) (last-command))
(("Push topic to: ") ("push" "-v" "origin" "topic:refs/heads/elsewhere"))
; git-remotes:push-arguments sets the switches the menu starts with.
> (options:set! git-remotes:push-arguments '("--force-with-lease"))
> (press! "P")
> (cadr (menu-now))
("Arguments" ("- f" "Force with lease" "*--force-with-lease") ("- F" "Force" "--force") ("- h" "Disable hooks" "--no-verify") ("- n" "Dry run" "--dry-run") ("- T" "Include all tags" "--tags") ("- t" "Include related annotated tags" "--follow-tags"))
> (press! "u")
> (settle!)
> (options:set! git-remotes:push-arguments '())
> (last-command)
("push" "-v" "--force-with-lease" "origin" "topic:refs/heads/topic")
; f u fetches the upstream's remote, f a every remote, and
; Unpulled from appears.
> (sh "cd repo && git checkout -q main")
> (sh "git clone -q origin-repo.git o && cd o && echo o > o.txt && git add o.txt && git -c user.name=o -c user.email=o@x commit -qm 'Origin commit' && git push -q")
> (git-mode:refresh-repository repo)
> (press! "f")
> (menu-now)
("Fetch" ("Arguments" ("- p" "Prune deleted branches" "--prune") ("- t" "Fetch all tags" "--tags") ("- F" "Force" "--force")) ("Fetch from" ("p" "origin") ("u" "origin") ("e" "elsewhere") ("a" "all remotes")))
> (press! "u")
> (settle!)
> (list (last-command) (and (member "Unpulled from origin/main (1)…" (status)) #t))
(("fetch" "origin") #t)
> (press! "f" "a")
> (settle!)
> (last-command)
("fetch" "--all")
; f e reads a remote and fetches it.
> (answer! "origin")
> (press! "f" "e")
> (settle!)
> (list (take-asked!) (last-command))
(("Fetch remote: ") ("fetch" "origin"))
; F u pulls from the upstream, with with-editor's environment;
; buffers of files it changed are reverted.
> (take-said!)
("Git finished" "Git finished" "Git finished" "Git finished" "Git finished" "Git finished" "Git finished" "Git finished" "Git finished")
> (sh "cd repo && git stash -q -u")
> (write-file! "repo/o.txt" "")
> (define o (files:visit (at "repo/o.txt")))
> (sh "cd repo && rm o.txt")
> (press! "F")
> (menu-now)
("Pull" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- r" "Rebase local commits" "--rebase") ("- F" "Force" "--force")) ("Pull into main from" ("p" "origin/main") ("u" "origin/main") ("e" "elsewhere")))
> (press! "u")
> (settle!)
> (list (last-command) (take-said!) (document:text (buffers:document o)))
(("pull" "origin" "refs/heads/main") ("Git finished") "o\n")
; a pull that merges asks for the message: MERGE_MSG opens, and
; C-c C-c makes the merge commit.
> (sh "cd o && echo again >> o.txt && git -c user.name=o -c user.email=o@x commit -qam 'Origin again' && git push -q")
> (sh "cd repo && echo l > local.txt && git add local.txt && git commit -qm local")
> (sh "cd repo && git config pull.rebase false")
> (press! "F" "u")
> (testing:wait-until (lambda () (equal? (shown-buffer) "MERGE_MSG")))
> (shown-buffer)
"MERGE_MSG"
> (press! "C-c" "C-c")
> (settle!)
> (git-out "repo" "log" "-1" "--format=%s %p")
"Merge branch 'main' of ../origin-repo f140e94 19b6bca\n"
; F p pulls from the push-remote; F e from a branch read.
> (press! "F" "p")
> (settle!)
> (last-command)
("pull" "origin" "refs/heads/main")
> (answer! "origin/main")
> (press! "F" "e")
> (settle!)
> (list (take-asked!) (last-command))
(("Pull from: ") ("pull" "origin" "refs/heads/main"))
; F u with no upstream reads one and sets it.
> (sh "cd repo && git checkout -q -b lone")
> (answer! "origin/main")
> (press! "F" "u")
> (settle!)
> (list (take-asked!) (git-out "repo" "rev-parse" "--abbrev-ref" "lone@{upstream}"))
(("Set upstream of lone and pull from there: ") "origin/main\n")
; a failure says Git error with git's last fatal or error line, and
; the status buffer shows it.
> (sh "cd repo && git checkout -q main && git remote set-url origin /nowhere")
> (press! "f" "u")
> (settle!)
> (list (take-said!) (car (status)))
(("Type C-c C-c to finish, C-c C-k to cancel" "Type C-c C-c to finish, C-c C-k to cancel, and M-p and M-n to recover older messages" "Git finished" "Git finished" "Git finished" "Git finished" "Git error: Could not read from remote repository. [Type $ for details]") "GitError! Could not read from remote repository.  [Type $ for details]")
; git asks for no credentials: a remote that would ask fails at once.
> (map (lambda (v) (assoc v (git:environment))) '("GIT_TERMINAL_PROMPT" "GIT_SSH_COMMAND"))
(("GIT_TERMINAL_PROMPT" . "0") ("GIT_SSH_COMMAND" . "ssh -o BatchMode=yes"))
; keys work while a command runs, and C-g does not stop it.
> (write-file! "repo/.git/hooks/pre-push" "#!/bin/sh\nsleep 1\n")
> (sh "chmod +x repo/.git/hooks/pre-push && cd repo && git remote set-url origin ../origin-repo.git")
> (press! "P" "u")
> (press! "C-g" "n")
> (git:command? (git:running repo))
#t
> (settle!)
> (list (git:command-exit (car (reverse (git:commands repo)))) (last-command))
(0 ("push" "-v" "origin" "main:refs/heads/main"))
; a menu shown in another repository shows placeholders until that
; repository's branch is read, never the last menu's branch.
> (press! "P")
> (car (reverse (menu-now)))
("Push main to" ("p" "origin/main") ("u" "origin/main") ("e" "elsewhere"))
> (press! "C-g")
> (sh "git init -q -b side side && cd side && git commit -q --allow-empty -m one")
> (git-status:show (git:find-repository (at "side")))
> (settle!)
> (begin (press! "P") (car (reverse (menu))))
("Push HEAD to" ("p" "pushRemote, setting that") ("u" "@{upstream}, setting it") ("e" "elsewhere"))
> (car (reverse (menu-now)))
("Push side to" ("p" "pushRemote, setting that") ("u" "@{upstream}, setting it") ("e" "elsewhere"))
