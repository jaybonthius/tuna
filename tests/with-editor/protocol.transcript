; Neither a newline on the program's standard input nor RET typed on its
; terminal answers for the user.
> (sh "git init -q -b main repo && cd repo && echo a > a.txt && git add a.txt")
> (define repo (git:find-repository (at "repo")))
> (define (committing options)
    (let* ([editing (with-editor:output-wrapper)] [status #f]
           [process (processes:start "git" '("commit" "-q") (editing (lambda (bytes end) (void)))
                      (lambda (s) (set! status s)) options)])
      (lambda (message) (if message (begin (processes:send! process message) process) status))))
> (define piped
    (committing (processes:options [directory (at "repo")] [environment (with-editor:environment "GIT_EDITOR")])))
> (wait-until (lambda () (equal? (shown) "COMMIT_EDITMSG")))
> (piped "\n")
#<process 2 git>
> (sleep-for 0.3)
> (list (shown) (piped #f))
("COMMIT_EDITMSG" #f)
> (buffers:replace! (views:buffer (layout:selected-view)) 1 1 "Through a pipe\n")
#<edit 1>
> (press! "C-c" "C-c")
> (wait-until (lambda () (piped #f)))
> (list (piped #f) (subjects repo))
(0 "Through a pipe\n")
