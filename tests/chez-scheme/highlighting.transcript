#t
> (syntax:mode-symbol-characters chez-scheme:mode)
"!$%&*/:<=>?^_~+-.@"
; The lexer: each kind's class; a node's opening or closing is no
; character, and an atom lexes as part of a symbol.
> (define (classes text)
    (map (lambda (l) (list (syntax:lexeme-class l) (syntax:lexeme-start l) (syntax:lexeme-end l)))
         (vector->list (chez-scheme:lexer (document:from-datum text)))))
> (classes "(a 'b \"c\" ; d\n #;e #!eof #\\x #t . 1)")
((open 0 1) (atom 1 2) (prefix 3 4) (atom 4 5) (string 6 9) (comment 10 13) (comment 15 18) (atom 19 24) (atom 25 28) (atom 29 31) (atom 32 33) (atom 34 35) (close 35 36))
> (map (lambda (l) (list (syntax:lexeme-class l) (syntax:lexeme-start l) (syntax:lexeme-end l)))
       (vector->list (chez-scheme:lexer (document:from-datum '(p () "(a" #(img ()) " b)") '(p () "c")))))
((open 1 2) (atom 2 4) (atom 5 6) (close 6 7) (atom 9 10))
> (map syntax:lexeme-open-ended? (vector->list (chez-scheme:lexer (document:from-datum "\"a ; b\n; c"))))
(#t)
; Highlighting: a buffer whose mode derives from chez-scheme:mode is
; highlighted by a job; the faces of each kind of text.
> (tables:define-table derived-keymap)
> (hooks:define-hook derived-hook)
> (modes:define-major-mode derived (parent chez-scheme:mode) (keymap derived-keymap) (hook derived-hook))
