; Key syntax: modifiers C- M- S- s- in that order, then a character or a
; named key; shift on a character is in the character.
> (define-table km)
> (define (valid? keys) (not (pair? (raised (lambda () (keys:bind! km keys files:find-file))))))
> (map valid? '("a" "A" "C-a" "C-A" "M-x" "C-M-x" "s-a" "C-M-s-a" "C--" "M-<" "C->" "é" "≈"
                "RET" "SPC" "TAB" "ESC" "DEL" "<f1>" "<left>" "S-<left>" "C-S-<right>" "M-S-RET"
                "<printing-char>" "C-x C-f" "C-c p f" "C-x 4 C-f"))
(#t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t #t)
> (map valid? '("" " " "C-" "M-C-x" "S-a" "C-S-a" "S-1" "s-C-a" "C-x  C-f" " C-x" "C-x " "ret" "<>"
                "<a b>" "<f1" "f1>" "C-<" "ab" "C-ab" "x\x7;" "\x7;" "S-" "C-M-"))
(#f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #t #f #f #f #f #f #f)
> (raised (lambda () (keys:bind! km "M-C-x" files:find-file)))
(keys:bind! "not a valid key sequence")
> (raised (lambda () (keys:bind! km "C-x" 'find-file)))
(keys:bind! "neither a command nor a keymap")
> (raised (lambda () (keys:bind! 'km "C-x" files:find-file)))
(keys:bind! "not a keymap")
> (raised (lambda () (keys:press! (layout:current-frame) "C-x C-f")))
(keys:press! "not one valid key")
> (raised (lambda () (keys:lookup (layout:current-frame) "C-x  C-f")))
(keys:lookup "not a valid key sequence")
; Binding marks each leading part as a prefix; bindings leaves the marks out.
> (define-table m)
> (keys:bind! m "C-x 4 C-f" files:find-file)
> (keys:bind! m "C-x o" layout:other-view)
> (map (lambda (e) (cons (car e) (name-of (cdr e)))) (table-entries m))
(("C-x" . #t) ("C-x 4" . #t) ("C-x 4 C-f" . files:find-file) ("C-x o" . layout:other-view))
> (map (lambda (e) (cons (car e) (name-of (cdr e)))) (keys:bindings m))
(("C-x 4 C-f" . files:find-file) ("C-x o" . layout:other-view))
; The binding in effect is the last change: a binding of a prefix hides
; the longer bindings, and binding a longer one marks it a prefix again.
> (keys:bind! m "C-x" editing:next-line)
> (keys:bind! m "C-x 4 C-f" files:find-file)
> (map (lambda (e) (cons (car e) (name-of (cdr e)))) (keys:bindings m))
(("C-x 4 C-f" . files:find-file) ("C-x o" . layout:other-view))
> (keys:unbind! m "C-x o")
> (keys:bindings m)
(("C-x 4 C-f" . #<procedure>))
; A leading part bound to a keymap stays that keymap.
> (keys:bind! m "C-c p" cape:prefix-map)
> (keys:bind! m "C-c p x" layout:other-view)
> (eq? (table-ref m "C-c p") cape:prefix-map)
#t
; A binding under another module's prefix keymap keeps its prefix when
; that module unloads.
> (define (write-module name text)
    (call-with-output-file (string-append (getenv "HOME") "/.config/tuna/lib/" name ".sls")
      (lambda (p) (display text p))))
> (write-module "pa" "#!tuna\n(import (keys) (cape))\n(keys:bind! keys:global \"C-c q\" cape:prefix-map)\n")
> (write-module "pb" "#!tuna\n(import (keys) (layout))\n(keys:bind! keys:global \"C-c q x\" layout:other-view)\n")
> (load-module! '(pa))
> (load-module! '(pb))
> (name-of (keys:lookup (layout:current-frame) "C-c q x"))
layout:other-view
> (unload-module! '(pa))
> (name-of (keys:lookup (layout:current-frame) "C-c q x"))
layout:other-view
> (unload-module! '(pb))
> (list (keys:lookup (layout:current-frame) "C-c q x") (table-ref keys:global "C-c q"))
(#f #f)
; Bindings are each module's changes: unloading the binder takes its
; bindings back and leaves another module's marks of the same prefix.
> (define (where frame command) (keys:where-is frame command))
> (define frame (layout:current-frame))
> (keys:bind! keys:global "C-x m" files:find-file)
> (table-owner keys:global "C-x m")
(repl)
> (table-owner keys:global "C-x")
(repl)
> (unload-module! '(layout))
> (table-owner keys:global "C-x")
(repl)
> (load-module! '(layout))
> (keys:where-is frame files:find-file)
("C-x m")
; A lib/ module removes the REPL's binding; unloading it brings it back.
> (call-with-output-file (string-append (getenv "HOME") "/.config/tuna/lib/unbinder.sls")
    (lambda (p) (display "#!tuna\n(import (keys))\n(keys:unbind! keys:global \"C-x m\")\n" p)))
> (load-module! '(unbinder))
> (table-ref keys:global "C-x m")
#f
> (unload-module! '(unbinder))
> (table-owner keys:global "C-x m")
(repl)
; A posted thunk binds as the module that posted it.
> (as-module '(files) (post! (lambda () (keys:bind! keys:global "C-p" files:find-file))))
> (wait-until (lambda () (table-ref keys:global "C-p")))
> (table-owner keys:global "C-p")
(files)
; Active keymaps: temporary ones, newest first, then the entries of
; keys:find-keymaps in the hook's order, then the global keymap.
> (define-table a)
> (define-table b)
> (define-table c)
> (define-table t1)
> (define-table t2)
> (define (names keymaps)
    (map (lambda (k) (cond [(eq? k a) 'a] [(eq? k b) 'b] [(eq? k c) 'c] [(eq? k t1) 't1] [(eq? k t2) 't2]
                           [(eq? k keys:global) 'global] [else k]))
         keymaps))
> (define (inner frame) (list a b))
> (define (outer frame) (list c))
> (add-hook! keys:find-keymaps inner)
> (add-hook! keys:find-keymaps outer 10)
> (define end1 (keys:push-keymap! frame t1 (lambda (found command) #t)))
> (define end2 (keys:push-keymap! frame t2 (lambda (found command) #t)))
> (names (keys:active-keymaps frame))
(t2 t1 a b c global)
> (names (keys:active-keymaps (layout:other-frame)))
(a b c global)
> (end2)
> (end2)
> (end1)
> (names (keys:active-keymaps frame))
(a b c global)
; The first keymap that binds the sequence, or a longer one, decides.
> (keys:bind! a "C-c x" layout:other-view)
> (keys:bind! b "C-c" files:find-file)
> (names (list (keys:lookup frame "C-c")))
(a)
> (name-of (keys:lookup frame "C-c x"))
layout:other-view
> (keys:bind! c "C-x o" files:find-file)
> (name-of (keys:lookup frame "C-x o"))
files:find-file
; An entry that raises, or returns what is not a list of keymaps, is
; reported and the others are searched.
> (define (broken frame) (car '()))
> (define (wrong frame) 'a)
> (add-hook! keys:find-keymaps broken 5)
> (add-hook! keys:find-keymaps wrong 6)
> (names (keys:active-keymaps frame))
! car: () is not a pair
! keys:find-keymaps: an entry returned what is not a list of keymaps with irritant a
(a b c global)
> (remove-hook! keys:find-keymaps broken)
> (remove-hook! keys:find-keymaps wrong)
; A warning is reported and the entry goes on.
> (define (warned frame) (warning 'warned "careful") (list t1))
> (add-hook! keys:find-keymaps warned 5)
> (names (keys:active-keymaps frame))
! warned: careful
(a b t1 c global)
> (remove-hook! keys:find-keymaps warned)
> (remove-hook! keys:find-keymaps outer)
> (remove-hook! keys:find-keymaps inner)
; One printing character with no binding in a keymap uses that keymap's
; <printing-char>, before the keymaps after it.
> (add-hook! keys:find-keymaps (lambda (frame) (list a)))
> (keys:bind! a "<printing-char>" layout:other-view)
> (keys:bind! a "q" files:find-file)
> (map (lambda (k) (name-of (keys:lookup frame k))) '("x" "é" "q" "SPC" "C-x" "<f1>"))
(layout:other-view layout:other-view files:find-file editing:self-insert keys:global #f)
> (keys:unbind! a "<printing-char>")
> (name-of (keys:lookup frame "x"))
editing:self-insert
; ESC then a key is that key with M-, when nothing binds ESC and the key.
> (keys:bind! keys:global "M-x" layout:other-view)
> (keys:bind! keys:global "C-M-f" files:find-file)
> (keys:bind! keys:global "M-g g" editing:next-line)
> (map (lambda (k) (name-of (keys:lookup frame k)))
       '("ESC x" "ESC C-f" "ESC g g" "C-x ESC x" "ESC" "ESC ESC" "ESC M-x"))
(layout:other-view files:find-file editing:next-line #f #f #f #f)
> (keys:bind! a "ESC x" files:find-file)
> (name-of (keys:lookup frame "ESC x"))
files:find-file
; A sequence that finds nothing and whose last key has shift is looked up
; without it; ESC X is M-X before it is anything without shift.
> (map (lambda (k) (name-of (keys:lookup frame k))) '("S-<right>" "C-F" "C-N" "M-X" "ESC X" "C-x O" "C-S-<f1>"))
(editing:forward-char editing:forward-char editing:next-line layout:other-view layout:other-view layout:other-view #f)
> (keys:bind! keys:global "C-F" files:find-file)
> (name-of (keys:lookup frame "C-F"))
files:find-file
; The command found is remapped by the first keymap searched that remaps
; it, and a replacement is not remapped again.
> (keys:remap! keys:global editing:forward-char files:find-file)
> (keys:remap! a files:find-file layout:other-view)
> (map (lambda (k) (name-of (keys:lookup frame k))) '("<right>" "C-f" "q"))
(files:find-file files:find-file layout:other-view)
> (keys:remap! a editing:forward-char editing:next-line)
> (name-of (keys:lookup frame "<right>"))
editing:next-line
> (raised (lambda () (keys:remap! a editing:forward-char 'x)))
(keys:remap! "not a command")
> (keys:bindings a)
(("C-c x" . #<procedure>) ("q" . #<procedure>) ("ESC x" . #<procedure>))
; where-is lists what runs a command now, remapping included, shortest first.
> (keys:where-is frame editing:next-line)
("C-n" "C-f" "<right>" "M-g g")
> (keys:where-is frame layout:other-view)
("q" "C-p" "M-x" "C-M-f" "C-F" "C-c x" "ESC x" "C-x o" "C-x m")
> (keys:bind! keys:global "C-c P" cape:prefix-map)
> (keys:where-is frame cape:file)
("C-c P f")
> (raised (lambda () (keys:where-is frame 'x)))
(keys:where-is "not a command")
; A keymap bound inside itself is walked once.
> (keys:bind! b "C-z" b)
> (keys:where-is frame cape:dabbrev)
("C-c P d")
