> (lsp:define-server types (fake-command "types") (capabilities '(("experimental" ("tunaTest" . #t)))))
> (lsp:define-server style (fake-command "style"))
> (define (loc path line from to) `(("uri" . ,(lsp:path->uri path)) ("range" ("start" ("line" . ,line) ("character" . ,from)) ("end" ("line" . ,line) ("character" . ,to)))))
> (define a-path (string-append project "/a.fk"))
> (define b-path (string-append project "/b.fk"))
> (write-file! a-path "total(1)\n")
> (write-file! b-path "x\ndef total(n):\n")
> (configure! "types" `(capabilities ("textDocumentSync" . 2) ("definitionProvider" . #t) ("hoverProvider" . #t) ("signatureHelpProvider" ("triggerCharacters" . #("("))))
                       `(responses ("textDocument/definition" . #(,(loc b-path 1 4 9)))
                                   ("textDocument/hover" . (("contents" ("kind" . "markdown") ("value" . "total: types")))))
                       '(name . "types"))
> (configure! "style" `(capabilities ("textDocumentSync" . 2) ("definitionProvider" . #t) ("hoverProvider" . #t))
                       `(responses ("textDocument/definition" . #(,(loc a-path 0 0 5)))
                                   ("textDocument/hover" . (delay 0.5 (("contents" . "total: style")))))
                       '(name . "style"))
> (table-set! lsp:language-servers "fakelang" (list types style))
> (add-hook! fake-mode-hook lsp:ensure)
> (define a (visit! a-path))
> (wait-for "types" "textDocument/didOpen")
> (wait-for "style" "textDocument/didOpen")
; A server's capabilities clause is merged into what initialize offers.
> (ref (last-of "types" "initialize") "params" "capabilities" "experimental")
(("tunaTest" . #t))
; Definitions from both servers are merged; M-. asks between them, and
; the one in a file no buffer visits shows its line, read from the file.
> (in-client (lambda () (views:set-point! (view) 2)))
> (define t (start! (lambda () (press! "M-."))))
> (wait-matches (session))
> (texts (session))
("~/project/b.fk:2: def total(n):" "~/project/a.fk:1: total(1)")
> (press! "RET")
> (result t)
> (list (buffers:name (views:buffer (view))) (views:point (view)))
("b.fk" 7)
> (press! "M-,")
; Docs at point: each server's hover is a source of its own, so the slow
; server's does not hold back the fast one's.
> (in-client (lambda () (docs-at-point:ask-sources (view))))
> (testing:wait-until (lambda () (equal? (echo-area:current-message) "total: types")))
> (echo-area:current-message)
"total: types"
> (testing:wait-until (lambda () (not (equal? (echo-area:current-message) "total: types"))))
> (echo-area:current-message)
"total: types\ntotal: style"
; A signature shows with its active parameter in the highlight face.
> (configure! "types" `(capabilities ("textDocumentSync" . 2) ("signatureHelpProvider" ("triggerCharacters" . #("("))))
                       '(responses ("textDocument/signatureHelp" ("signatures" . #((("label" . "total(items, start)") ("parameters" . #((("label" . "items")) (("label" . #(13 18))))))))
                                                                 ("activeSignature" . 0) ("activeParameter" . 1)))
                       '(name . "types"))
> (configure! "style" '(capabilities ("textDocumentSync" . 2)) '(name . "style"))
> (define opened (map (lambda (name) (length (of-method name "textDocument/didOpen"))) '("types" "style")))
> (lsp:reconnect (car (lsp:connections)))
> (lsp:reconnect (car (lsp:connections)))
> (for-each (lambda (name n) (wait-for name "textDocument/didOpen" (+ n 1))) '("types" "style") opened)
> (in-client (lambda () (docs-at-point:ask-sources (view))))
> (testing:wait-until (lambda () (equal? (echo-area:current-message) "total(items, start)")))
> (list (echo-area:current-message) (echo-area:current-spans))
("total(items, start)" ((13 18 highlight)))
; Highlights come after the idle delay, from the first server that gives
; them, and the next command clears them; they stay with docs-at-point off.
> (configure! "types" '(capabilities ("textDocumentSync" . 2) ("documentHighlightProvider" . #t))
                       '(responses ("textDocument/documentHighlight" . #((("range" ("start" ("line" . 0) ("character" . 0)) ("end" ("line" . 0) ("character" . 5)))))))
                       '(name . "types"))
> (define opened (length (of-method "types" "textDocument/didOpen")))
> (lsp:reconnect (car (lsp:connections)))
> (wait-for "types" "textDocument/didOpen" (+ opened 1))
> (define (lit)
    (let ([l (find (lambda (l) (= (buffers:layer-priority l) 5)) (buffers:layers a (view)))])
      (if l (map (lambda (s) (list (car s) (cadr s) (cdr (assq 'face (caddr s))))) (buffers:spans l 0 (document:length (buffers:document a)))) '())))
> (set-option! docs-at-point:mode #f)
> (press! "C-a")
> (lit)
()
> (testing:wait-until (lambda () (pair? (lit))))
> (lit)
((1 6 (lsp.highlight highlight)))
> (press! "C-f")
> (lit)
()
> (set-option! docs-at-point:mode #t)
; A hover's echo is the first line its Markdown shows, a fence's marks
; left out.
> (configure! "types" '(capabilities ("textDocumentSync" . 2) ("hoverProvider" . #t))
                       '(responses ("textDocument/hover" ("contents" ("kind" . "markdown") ("value" . "```python\ndef total(items) -> int\n```\n---\nSums the items."))))
                       '(name . "types"))
> (define opened (length (of-method "types" "textDocument/didOpen")))
> (lsp:reconnect (car (lsp:buffer-connections a)))
> (wait-for "types" "textDocument/didOpen" (+ opened 1))
> (define asked (start! (lambda () (lsp:hover (car (lsp:buffer-connections a)) (view)))))
> (let ([doc (result asked)]) (list (docs-at-point:doc-markdown? doc) (docs-at-point:doc-echo doc)))
(#t "def total(items) -> int")
