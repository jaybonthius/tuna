; s toggles the sort between name and time, newest first, in this
; listing only; C-u s reads a sort; the header shows it.
> (touch! "d/old.txt" "old\n")
> (touch! "d/new.txt" "new, and longer\n")
> (touch! "d/mid.c" "m\n")
> (system (string-append "touch -d '2020-01-02 03:04' " (at "d/old.txt") " && touch -d '2021-01-01' " (at "d/mid.c")))
0
> (define b (dired:visit (at "d")))
> (layout:switch-to-buffer b)
> (dired:open (at "d"))
> (listing-lines b)
("  ." "  .." "  mid.c" "  new.txt" "  old.txt")
> (goto "old.txt")
> (press! "s")
> (settle)
> (list (listing-lines b) (point-name) (buffers:with-buffer b (dired:sort)) (dired:sort))
(("  ." "  .." "  new.txt" "  mid.c" "  old.txt") "old.txt" time name)
> (drawn-has? "by time")
(#t)
> (options:set! ask:line-reader (answer "size"))
> (press! "C-u" "s")
> (settle)
> (list (questions) (listing-lines b))
(("Sort by (name, time, size or extension): ") ("  ." "  .." "  new.txt" "  old.txt" "  mid.c"))
> (dired:sort-by b (dired:sorting extension))
> (listing-lines b)
("  ." "  .." "  mid.c" "  new.txt" "  old.txt")
> (buffers:with-buffer b (options:set-local! dired:reverse-sort? #t))
> (press! "g")
> (settle)
> (list (listing-lines b) (drawn-has? "by extension, reversed"))
(("  ." "  .." "  old.txt" "  new.txt" "  mid.c") (#t))
> (raised (lambda () (dired:sort-by b 'colour)))
(dired:sort-by "not a dired:sorting name")
; Each entry draws its mark, mode, links, owner, group, size and time,
; then its name, which a click opens; ( hides every column but the mark
; and the name, and the line of space used.
> (drawn-has? "dired-mode\">-rw" "dired-size\">16<" "dired-time\">Jan  2  2020<" "total used in directory" "data-keymap")
(#t #t #t #t #t)
> (press! "(")
> (list (buffers:with-buffer b (dired:hide-details?)) (drawn-has? "dired-mode" "total used" "by extension"))
(#t (#f #f #t))
> (and (memq dired:hide-details? (modes:active-minor-modes (view))) #t)
#t
> (press! "(")
; dired:columns chooses the columns, in order, from a closed
; set.
> (options:set! dired:columns (list (dired:column size) (dired:column time)))
> (drawn-has? "dired-mode" "dired-owner" "dired-size" "--dired-columns:1ch 4ch 12ch auto 1fr")
(#f #f #t #t)
> (raised (lambda () (options:set! dired:columns '(size colour))))
(options:set! "(size colour) is not a valid value for dired:columns")
> (options:unset! dired:columns)
; Sizes and times are drawn by changeable definitions.
> (advice-add! dired:size-text (lambda (original size) (string-append (original size) "B")))
> (press! "g")
> (settle)
> (drawn-has? "dired-size\">16B<")
(#t)
; A time within six months gives the hour, an older one the year, as
; ls -l does.
> (list (dired:time-text 1600000000) (string-length (dired:time-text (time-second (current-time 'time-utc)))))
("Sep 13  2020" 12)
