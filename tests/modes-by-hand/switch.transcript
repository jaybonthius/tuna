; Entries record what runs, in order, with the buffer current and the
; value of fill:column they read; option-changed records the values of
; fill:column and rainbow-delimiters:mode it reports; the command hooks
; and the prompt record when the command starts, asks and ends; the keys
; typed at the prompt are commands of their own, left out.
> (define recorded '())
> (define (record! . what) (set! recorded (cons what recorded)))
> (define (prog-entry) (record! 'prog-hook (eq? (buffers:current) b) (fill:column)))
> (define (python-entry) (record! 'python-hook (eq? (buffers:current) b) (fill:column)) (set-option-local! fill:column 79))
> (define (changed-entry buffer) (when (eq? buffer b) (record! 'major-mode-changed (eq? (buffers:current) b) (fill:column))))
> (define (option-entry option value)
    (when (and (eq? (buffers:current) b) (memq option (list fill:column rainbow-delimiters:mode)))
      (record! 'option-changed (if (eq? option fill:column) 'fill:column 'rainbow-delimiters:mode) value)))
> (add-hook! prog:mode-hook prog-entry)
> (add-hook! python:mode-hook python-entry)
> (add-hook! modes:major-mode-changed changed-entry)
> (add-hook! option-changed option-entry)
> (define (before-entry command) (when (eq? command modes:switch-major-mode) (record! 'before-command)))
> (define (after-entry command) (when (eq? command modes:switch-major-mode) (record! 'after-command)))
> (define (prompt-entry p) (record! 'prompt (question)))
> (add-hook! commands:before-command before-entry)
> (add-hook! commands:after-command after-entry)
> (add-hook! minibuffer:prompt-started prompt-entry)
> (modes:set-major-mode modes:fundamental b)
> (buffers:with-buffer b (set-option-local! rainbow-delimiters:mode #t fill:column 50))
> (set! recorded '())
> (define t (spawn-task (lambda () (in-client (lambda () (commands:run modes:switch-major-mode))))))
> (sleep-for 0.05)
> (answer! "python:mode")
> (result t)
> (reverse recorded)
((before-command) (prompt "Major mode: ") (prog-hook #t 70) (python-hook #t 70) (option-changed fill:column 79) (major-mode-changed #t 79) (after-command))
