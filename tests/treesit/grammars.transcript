; Python's grammar is tree-sitter-python at a pinned commit, built into
; Tuna's data folder, and Python's highlighter is the plugin's.
> (define python-grammar (table-ref treesit:grammars "python" #f))
> (map (lambda (get) (get python-grammar)) (list treesit:grammar-name treesit:grammar-source treesit:grammar-commit))
("python" "https://github.com/tree-sitter/tree-sitter-python" "293fdc02038ee2bf0e2e206711b69c90ac0d413f")
> (treesit:grammar-file python-grammar)
"$HOME/.local/share/tuna/grammars/libtree-sitter-python-293fdc02038e.so"
> (eq? (table-ref syntax-highlighting:highlighters "python" #f) treesit:highlighter)
#t
; A grammar's name is a C identifier's tail; a commit is a full one.
> (treesit:make-grammar "py-thon" "https://example.org/x" python-commit)
! treesit:make-grammar: not a grammar's name: letters, digits and _ with irritant "py-thon"
> (treesit:make-grammar "python" 'url python-commit)
! treesit:make-grammar: not a URL or folder with irritant url
> (treesit:make-grammar "python" "https://example.org/x" "293fdc0")
! treesit:make-grammar: not a full commit: 40 hexadecimal digits with irritant "293fdc0"
> (treesit:make-prebuilt-grammar "" "/x.so")
! treesit:make-prebuilt-grammar: not a grammar's name: letters, digits and _ with irritant ""
> (treesit:make-prebuilt-grammar "djot" #f)
! treesit:make-prebuilt-grammar: not a file name with irritant #f
> (define prebuilt (treesit:make-prebuilt-grammar "python" "/opt/grammars/python.so"))
> (list (treesit:grammar? prebuilt) (treesit:grammar-source prebuilt) (treesit:grammar-commit prebuilt) (treesit:grammar-file prebuilt))
(#t #f #f "/opt/grammars/python.so")
> (define b (python "a.py" "def f(x):\n    return x\n"))
> (faces b)
(("def" keyword.function) ("f" function) ("x" variable.parameter) ("return" keyword.return))
; A grammar from source whose file is missing draws its buffers plain,
; and tells nothing: getting the file is the installer's business.
> (table-set! treesit:grammars "python"
    (treesit:make-grammar "python" "https://github.com/tree-sitter/tree-sitter-python"
                          "0000000000000000000000000000000000000000"))
> (syntax-highlighting:update!)
> (define c (python "c.py" "def f(x):\n    return x\n"))
> (in-order (faces b) (faces c) (told-messages))
(() () ())
; A grammar built elsewhere is loaded as it is.
> (copy-file built-grammar (string-append home "/elsewhere/python.so"))
> (table-set! treesit:grammars "python" (treesit:make-prebuilt-grammar "python" (string-append home "/elsewhere/python.so")))
> (syntax-highlighting:update!)
> (in-order (faces b) (faces c) (told-messages))
((("def" keyword.function) ("f" function) ("x" variable.parameter) ("return" keyword.return)) (("def" keyword.function) ("f" function) ("x" variable.parameter) ("return" keyword.return)) ())
; A prebuilt grammar's missing file is told, once a session.
> (table-set! treesit:grammars "python" (treesit:make-prebuilt-grammar "python" (string-append home "/nowhere/python.so")))
> (syntax-highlighting:update!)
> (in-order (faces b) (faces c) (told-messages))
(() () ("No tree-sitter grammar for python at $HOME/nowhere/python.so"))
> (define d (python "d.py" "x = 1\n"))
> (in-order (faces d) (told-messages))
(() ())
; A file that does not load is told once a session, and its buffers are
; plain.
> (write-file (string-append home "/damaged/python.so") "not a shared object\n")
> (table-set! treesit:grammars "python" (treesit:make-prebuilt-grammar "python" (string-append home "/damaged/python.so")))
> (syntax-highlighting:update!)
> (in-order (faces b) (faces c) (faces d) (told-messages))
(() () () ("Loading the tree-sitter grammar for python failed: cannot load tree_sitter_python from $HOME/damaged/python.so: $HOME/damaged/python.so: file too short"))
> (define e (python "e.py" "x = 1\n"))
> (in-order (faces e) (told-messages))
(() ())
; A table entry that is not a grammar is reported.
> (table-set! treesit:grammars "python" "python")
> (define f (python "f.py" "x = 1\n"))
! (syntax-highlighting) treesit:grammars: not a grammar with irritant "python"
> (faces f)
()
