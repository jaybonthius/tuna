; An entry that moves the range it is told of runs the hook again once
; the move is drawn; moving it once, it runs twice and stops.
> (define moves 0)
> (define (move-once view buffer)
    (when (and (eq? view v) (= moves 0))
      (set! moves (+ moves 1))
      (views:scroll-to! v (line-start v 100) (views:align top))))
> (hooks:add! views:drawn-ranges-changed move-once)
> (views:scroll-to! v (line-start v 20) (views:align top))
> (list (ranges v) moves (told))
(((1 200)) 1 ((v "long" #t) (v "long" #t)))
> (list (ranges v) moves (told))
(((1 200)) 1 ())
> (hooks:remove! views:drawn-ranges-changed move-once)
; An entry that moves the range on every call runs the hook every batch,
; and forms are still read and run between rounds.
> (define rounds 0)
> (define (move-always view buffer)
    (when (eq? view v)
      (set! rounds (+ rounds 1))
      (views:scroll-to! v (line-start v (if (even? rounds) 20 200)) (views:align top))))
> (hooks:add! views:drawn-ranges-changed move-always)
> (views:scroll-to! v (line-start v 150) (views:align top))
> (> rounds 0)
#t
> (> rounds 1)
#t
> (hooks:remove! views:drawn-ranges-changed move-always)
> (define stopped rounds)
> (begin (told) (void))
> (list (= rounds stopped) (told))
(#t ())
; A dropped view runs the hook for the buffer it showed, which no longer
; lists it among the views showing it, and has no ranges to ask for.
> (define (showing view buffer) (when (eq? view v) (set! seen (and (memq view (views:showing buffer)) #t))))
> (hooks:add! views:drawn-ranges-changed showing)
> (begin (show! desktop w x) (views:drop! v))
> (list seen (told) (raised (lambda () (views:drawn-ranges v))))
(#f ((v "long" #t)) (views:drawn-ranges "a dropped view"))
> (hooks:remove! views:drawn-ranges-changed showing)
; Where lines do not wrap, a one-line file is one range of the whole
; file; where they wrap, the range holds only the long line's pieces
; drawn.
> (define m (buffers:make "minified" (make-string 100000 #\x)))
> (define y (views:make m))
> (name! y 'y)
> (show! desktop w x y)
> (list (views:drawn-ranges y) (told))
(((1 . 100001)) ((y "minified" #t)))
> (views:set-option! y views:wrap-lines #t)
> (list (views:drawn-ranges y) (told))
(((1 . 20993)) ((y "minified" #t)))
