; A server that ignores diagnostics gives none: neither pulled nor pushed.
> (define (pull-response message) `(("kind" . "full") ("items" . #((("range" ("start" ("line" . 0) ("character" . 0)) ("end" ("line" . 0) ("character" . 3))) ("severity" . 2) ("message" . ,message))))))
> (configure! "lint" `(capabilities ("textDocumentSync" . 2) ("diagnosticProvider" ("interFileDependencies" . #f) ("workspaceDiagnostics" . #f)))
                      `(responses ("textDocument/diagnostic" . ,(pull-response "pulled")))
                      '(name . "lint"))
> (lsp:define-server lint (fake-command "lint") (ignored-capabilities (lsp:capabilities diagnostics)))
> (tables:set! lsp:language-servers "fakelang" (list lint))
> (hooks:add! fake-mode-hook lsp:ensure)
> (define a-path (string-append project "/a.fk"))
> (write-file! a-path "one\ntwo\n")
> (define a (visit! a-path))
> (wait-for "lint" "textDocument/didOpen")
> (define (push! path message)
    (let ([diagnostic `(("range" ("start" ("line" . 1) ("character" . 0)) ("end" ("line" . 1) ("character" . 3)))
                        ("severity" . 1) ("message" . ,message))])
      (lsp:notify (car (lsp:connections)) "fake/send"
        `(("message" ("jsonrpc" . "2.0") ("method" . "textDocument/publishDiagnostics")
           ("params" ("uri" . ,(lsp:path->uri path)) ("diagnostics" . ,(vector diagnostic))))))))
> (push! a-path "pushed")
> (buffers:replace! a 1 1 "x")
#<edit 1>
> (wait-for "lint" "textDocument/didChange")
> (timers:sleep 0.3)
> (list (diagnostics:in a) (length (of-method "lint" "textDocument/diagnostic")) (diagnostics:under project))
(() 0 ())
; Set locally, lsp:ignored-capabilities does the same in one buffer
; alone.
> (lsp:define-server lint (fake-command "lint"))
> (define b-path (string-append project "/b.fk"))
> (define c-path (string-append project "/c.fk"))
> (write-file! b-path "three\n")
> (write-file! c-path "four\n")
> (buffers:with-buffer a (options:set-local! lsp:ignored-capabilities (lsp:capabilities diagnostics)))
> (lsp:reconnect (car (lsp:connections)))
> (define b (visit! b-path))
> (define c (visit! c-path))
> (testing:wait-until (lambda () (= 2 (length (of-method "lint" "textDocument/diagnostic")))))
> (push! a-path "pushed")
> (push! b-path "pushed")
> (testing:wait-until (lambda () (equal? (map diagnostics:diagnostic-message (diagnostics:in b)) '("pushed"))))
> (timers:sleep 0.2)
> (define (messages x) (map diagnostics:diagnostic-message (diagnostics:in x)))
> (list (messages a) (messages b) (messages c))
(() ("pushed") ("pulled"))
; A change sent asks again for every open document of the server, the
; changed one first, since no server yet sends the documents it affects.
> (buffers:replace! b 1 1 "x")
#<edit 1>
> (testing:wait-until (lambda () (= 4 (length (of-method "lint" "textDocument/diagnostic")))))
> (map (lambda (m) (substring (ref m "params" "textDocument" "uri") (string-length (lsp:path->uri project)) (string-length (ref m "params" "textDocument" "uri")))) (of-method "lint" "textDocument/diagnostic"))
("/b.fk" "/c.fk" "/b.fk" "/c.fk")
