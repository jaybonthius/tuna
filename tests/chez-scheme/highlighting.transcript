         "#!/usr/bin/petite --script\n" "#!r6rs\n" "#!chezscheme\n"))
(chez-scheme:mode chez-scheme:mode chez-scheme:mode chez-scheme:mode chez-scheme:mode chez-scheme:mode chez-scheme:mode)
