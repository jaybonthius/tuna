; Quits requested every millisecond land in presses, the resize commands
; and the entries that start and end repetitions. Afterwards C-g leaves
; the client with no temporary keymap, and keys repeat as before.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define c1 (web:add-client! 1))
> (press! c1 "C-x" "3")
> (define reported 0)
> (define (count-reports report c) (set! reported (+ reported 1)))
> (advice-add! report count-reports)
> (define quits-caught 0)
> (define presses 0)
> (define quitting #t)
> (define stopped #f)
> (define (quitter)
    (let loop ()
      (if quitting
          (begin
            (request-quit!)
            (chez:sleep (make-time 'time-duration 1000000 0))
            (loop))
          (set! stopped #t))))
> (define keys-pressed '("C-x" "}" "}" "{" "{" "C-x" "{" "}" "C-u" "C-x" "o" "C-x" "}" "{" "C-g"))
> (define (stress until)
    (let again ()
      (guard (c [(quit-condition? c) (set! quits-caught (+ quits-caught 1)) (again)])
        (with-exception-handler
          (lambda (c) (if (warning? c) (set! reported (+ reported 1)) (raise-continuable c)))
          (lambda ()
            (let loop ()
              (when (< (real-time) until)
                (for-each (lambda (k) (press! c1 k) (set! presses (+ presses 1))) keys-pressed)
                (loop))))))))
> (begin
    (fork-thread quitter)
    (stress (+ (real-time) 1500))
    (set! quitting #f)
    (let wait ()
      (guard (c [(quit-condition? c) (set! quits-caught (+ quits-caught 1)) (wait)])
        (let spin () (unless stopped (spin)))
        (let settle ([n 0]) (when (< n 100000) (settle (+ n 1))))))
    (list (> (+ reported quits-caught) 100) (> presses 1000)))
(#t #t)
> (advice-remove! report count-reports)
> (press! c1 "C-g" "C-g")
> (keymap-names c1)
(layout:keymap keys:global)
> (press! c1 "C-x" "+" "C-x" "}" "}")
> (list (list-sort < (weights)) (keymap-names c1))
((3/5 7/5) (layout-split:resize-keymap layout:keymap keys:global))
