; Every match is a row, with a heading above each group's first row; C-v
; pages the selection by completion-list:lines, 15 here.
> (define long-group
    (completion:source
      (candidates (list->vector (append (map (lambda (i) (format "a.txt:~a:x" (+ i 1))) (iota 30)) (list "b.txt:1:x"))))
      (in-order)
      (group (lambda (text value) (substring text 0 5)) (lambda (text value) (substring text 6 (string-length text))))))
> (define t (start! (lambda () (completion:read "? " (list long-group) #f))))
> (define s (session))
> (list (drawn "li class=\"ui-list-heading\"><span") (length (drawn "span class=\"completion-text\"")))
