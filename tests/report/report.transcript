; Modules change what report and module-loaded do with advice.
> (define (tagged report c) (display "reported") (report c))
> (advice-add! report tagged)
> (car 1)
reported
! car: 1 is not a pair
> (advice-remove! report tagged)
> (define loads '())
> (define (note loaded name) (set! loads (cons name loads)) (loaded name))
> (advice-add! module-loaded note)
; Tuna runs the body of each imported module, its imports first, whether or
; not the importer refers to their names.
> (import (report b))
> loads
((report b) (report a))
> (import (report unused))
> loads
((report unused) (report c) (report b) (report a))
; An advice of report that raises does not lose the condition.
> (advice-add! report (lambda (report c) (car '())))
> (vector-ref (vector) 0)
! vector-ref: 0 is not a valid index for #()
! car: () is not a pair
