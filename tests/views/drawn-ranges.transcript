> (begin (show! laptop v) (report! laptop v 240 0 #f))
> (list (ranges v) (told))
(((201 298) (201 298)) ((v "long" #t)))
> (begin (show! laptop) (web:client-removed laptop))
> (list (ranges v) (told))
(((201 298)) ((v "long" #t)))
; A draw for no client adds no range.
> (define o (buffers:make "other" (lines 50)))
> (define w (views:make o))
> (name! w 'w)
> (begin (views:draw w #f) (void))
> (list (views:drawn-ranges w) (ranges v) (told))
(() ((201 298)) ())
; A screen that leaves a view out holds no range of it from then on; the
; hook runs for it a batch later.
> (define seen #f)
> (define (look view buffer) (when (eq? view w) (set! seen (views:drawn-ranges v))))
> (hooks:add! views:drawn-ranges-changed look)
> (show! desktop w)
> (list (ranges w) (ranges v) seen (told))
(((1 50)) () () ((w "other" #t) (v "long" #t)))
> (hooks:remove! views:drawn-ranges-changed look)
> (show! desktop v w)
> (list (ranges w) (ranges v) (told))
(((1 50)) ((201 298)) ((v "long" #t)))
; A view that shows another buffer runs the hook for the buffer it left,
; then for the one it shows, each current.
> (define t (buffers:make "third" (lines 100)))
