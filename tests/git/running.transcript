; A query returns git's standard output as bytes and is not logged.
> (sample-repository! "repo")
> (define repo (git:find-repository (at "repo")))
> (utf8->string (git:query repo '("rev-parse" "--abbrev-ref" "HEAD")))
"main\n"
> (git:query repo '("hash-object" "--stdin") (bytevector 99 97 102 233 10))
#vu8(54 102 56 51 51 57 53 100 57 55 51 99 52 52 56 99 100 98 55 48 97 55 98 50 49 102 55 102 99 56 48 49 56 55 57 55 97 99 102 54 10)
> (git:commands repo)
()
; A command is logged with its arguments, without the global ones, and
; its exit status; git:command-ended follows it.
> (define ended '())
> (hooks:add! git:command-ended (lambda (r c) (set! ended (cons (git:command-arguments c) ended))))
> (git:run repo '("tag" "v1"))
#vu8()
> (log-lines repo)
((0 ("tag" "v1")))
> ended
(("tag" "v1"))
; A failure raises a git:&failed condition whose message is the last
; fatal: or error: line, without that word.
> (failure (lambda () (git:run repo '("fetch" "nowhere"))))
"Could not read from remote repository."
> (log-lines repo)
((0 ("tag" "v1")) (128 ("fetch" "nowhere")))
> (define c (guard (c [#t c]) (git:run repo '("checkout" "no-such-branch"))))
> (git:failure-summary c)
"pathspec 'no-such-branch' did not match any file(s) known to git"
> (condition-message c)
"pathspec 'no-such-branch' did not match any file(s) known to git"
> (git:command-exit (git:failure-command c))
1
> (git:command-output (git:failure-command c))
"error: pathspec 'no-such-branch' did not match any file(s) known to git\n"
> (failure (lambda () (git:query repo '("rev-parse" "--verify" "nothing"))))
"Needed a single revision"
; A query's failure names an entry that is not in the log.
> (define q (guard (c [#t c]) (git:query repo '("cat-file" "-p" "nothing"))))
> (memq (git:failure-command q) (git:commands repo))
#f
; Commands of a repository run one at a time, in the order called. Each
; is queued before its call pauses.
> (define updates '())
> (hooks:add! git:command-updated
    (lambda (r c) (set! updates (cons (list (car (git:command-arguments c)) (git:command-exit c)) updates))))
> (define first-task (spawn-task (lambda (restore) (git:run repo '("tag" "v2")))))
> (define second-task (spawn-task (lambda (restore) (git:run repo '("tag" "v3")))))
> (testing:join first-task)
#vu8()
> (testing:join second-task)
#vu8()
> (let ([seen (reverse updates)]) (list (car seen) (cadr seen)))
(("tag" #f) ("tag" #f))
> (assoc "tag" (filter (lambda (u) (equal? (cadr u) 0)) updates))
("tag" 0)
> (utf8->string (git:query repo '("tag")))
"v1\nv2\nv3\n"
; git:start returns the entry at once; on-end runs with it, then
; git:command-ended.
> (set! ended '())
> (define order '())
> (hooks:add! git:command-ended (lambda (r c) (set! order (cons 'hook order))))
> (define started (git:start repo '("tag" "v4") (lambda (c) (set! order (cons 'on-end order)))))
> (git:command? started)
#t
> (testing:wait-until (lambda () (git:command-exit started)))
> (reverse order)
(on-end hook)
> (git:command-exit started)
0
; Its environment clause is added to git's; any other clause raises.
> (define shown (git:start repo '("var" "GIT_EDITOR") (lambda (c) #f)
                  (processes:options [environment '(("GIT_EDITOR" . "my-editor"))])))
> (testing:wait-until (lambda () (git:command-exit shown)))
> (git:command-output shown)
"my-editor\n"
> (git:start repo '("status") (lambda (c) #f) (processes:options [directory "/"]))
! git:start: git:start takes an environment only with irritant #<processes:options>
; By default git fails at once rather than asking for a password.
> (cdr (assoc "GIT_TERMINAL_PROMPT" (git:environment)))
"0"
; git:stop! ends a running command, which fails with the signal's status.
> (define sleeper (git:start repo '("-c" "alias.nap=!sleep 30" "nap") (lambda (c) #f)))
> (testing:wait-until (lambda () (git:running repo)))
> (eq? (git:running repo) sleeper)
#t
> (git:queued? repo)
#t
> (git:stop! sleeper)
> (testing:wait-until (lambda () (git:command-exit sleeper)))
> (git:command-exit sleeper)
-1
> (git:queued? repo)
#f
> (git:stop! sleeper)
! git:stop!: Process isn't running
; A command marked canceled says so.
> (git:command-canceled? sleeper)
#f
> (git:set-command-canceled! sleeper)
> (git:command-canceled? sleeper)
#t
; The log keeps the last git:command-log-size commands.
> (options:set! git:command-log-size 3)
> (git:run repo '("tag" "v5"))
#vu8()
> (log-lines repo)
((0 ("var" "GIT_EDITOR")) (-1 ("-c" "alias.nap=!sleep 30" "nap")) (0 ("tag" "v5")))
; git:command-updated follows a command as it is queued, starts, gets
; output and ends.
> (define seen '())
> (define (note-update r c) (when (equal? (git:command-arguments c) '("tag" "--list")) (set! seen (cons (cond [(git:command-exit c) 'ended] [(git:running repo) (if (string=? (git:command-output c) "") 'started 'output)] [else 'queued]) seen))))
> (hooks:add! git:command-updated note-update)
> (git:run repo '("tag" "--list"))
#vu8(118 49 10 118 50 10 118 51 10 118 52 10 118 53 10)
> (let ([s (reverse seen)]) (list (car s) (cadr s) (and (memq 'output s) #t) (car (reverse s))))
(queued started #t ended)
; git:program names the program run.
> (options:set! git:program "no-such-git")
> (guard (c [#t (condition-message c)]) (git:run repo '("status")))
! spawn-process: cannot run no-such-git: No such file or directory with irritants ("no-such-git" ("--no-pager" "--literal-pathspecs" "-c" "core.preloadindex=true" "-c" "log.showSignature=false" "-c" "color.ui=false" "-c" "color.diff=false" "-c" "diff.noPrefix=false" "-c" "diff.mnemonicPrefix=false" "-c" "diff.srcPrefix=a/" "-c" "diff.dstPrefix=b/" "-c" "diff.suppressBlankEmpty=false" "-c" "core.quotePath=false" "status"))
"cannot run no-such-git: No such file or directory"
> (options:unset! git:program)
