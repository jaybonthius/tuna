; A terminal has one size, which terminal:fit-size chooses: by default
; the smallest view showing it on the device whose input reached it last.
> (define t (shell!))
> (terminal:send! t "stty size\r")
> (wait-for t "\n24 80\n")
> (in-client (lambda () (layout:switch-to-buffer t)))
> (in-client (lambda () (measure! (view) 400 200)))
> (call-with-values (lambda () (views:body-size (view) client)) list)
(40 10)
> (call-with-values (lambda () (terminal:fit-size t client)) list)
(40 10)
; Until the device sends the terminal input, its size stays.
> (terminal:send! t "stty size\r")
> (wait-for t "\n24 80\n$ stty size\n24 80\n")
> (press! "SPC" "DEL")
> (terminal:send! t "stty size\r")
> (wait-for t "\n10 40\n$ ")
> (list-tail (screen-lines t) (- (length (screen-lines t)) 2))
("10 40" "$ ")
; The plugin asks again when one of that device's views changes size.
> (in-client (lambda () (measure! (view) 600 300)))
> (terminal:send! t "stty size\r")
> (wait-for t "\n15 60\n")
> (call-with-values (lambda () (terminal:fit-size t client)) list)
(60 15)
; A user who wants another rule changes terminal:fit-size.
> (define (fixed fit terminal client) (values 30 12))
> (advice-add! terminal:fit-size fixed)
> (in-client (lambda () (measure! (view) 610 300)))
> (terminal:send! t "stty size\r")
> (wait-for t "\n12 30\n")
> (advice-remove! terminal:fit-size fixed)
> (press! "SPC" "DEL")
> (terminal:send! t "stty size\r")
> (wait-for t "\n15 61\n")
; Another device showing the terminal on a narrower view changes nothing
; until its input reaches the terminal; then the terminal takes its size.
> (define phone (web:add-client! 2))
> (define (phone-measure! v width height)
    (let ([saved client]) (set! client phone) (measure! v width height) (set! client saved)))
> (phone-measure! (view) 200 100)
> (call-with-values (lambda () (views:body-size (view) phone)) list)
(20 5)
> (terminal:send! t "stty size\r")
> (wait-for t "\n15 61\n$ stty size\n15 61\n")
> (parameterize ([web:current-client phone])
    (views:call-with-view (layout:selected-view) (lambda () (keys:press! phone "SPC") (keys:press! phone "DEL"))))
> (terminal:send! t "stty size\r")
> (wait-for t "\n5 20\n")
