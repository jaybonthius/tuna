; The kill ring as its documented examples use it, in order. The
; configuration is the documented one, which skips duplicates, and
; records the text of each entry after-push is called with. Rectangles
; are a stand-in whose yank notes the position.
> (kill-ring:skip-duplicates)
#t
> (import (rectangle))
> (table-set! kill-ring:yankers 'rectangle:block rectangle:yank-block)
; The documented push! of a piece reads the current buffer, which views
; would set; here with-buffer sets it.
> (define notes (buffers:make "notes" "Buy milk.\n"))
> (kill-ring:push! (list "first"))
> (buffers:with-buffer notes
    (kill-ring:push! (list (buffers:piece (buffers:current) 1 6))))
> (kill-ring:entries)
((#<kill>) ("first"))
> (kill-ring:text (kill-ring:current))
"Buy m"
> (kill-ring:push! (list "older"))
> (kill-ring:push! (list "newer"))
> (kill-ring:rotate! 1)
("older")
> (kill-ring:text (list "alpha" "beta"))
"alpha\nbeta"
; Pushing the newest entry's text again only moves the yank pointer to
; it, and still calls after-push.
> (kill-ring:push! (list "newer"))
> (list (kill-ring:current) (length (kill-ring:entries)))
(("newer") 4)
> (take-pushed!)
("first" "Buy m" "older" "newer" "newer")
; A piece whose top node is a rectangle goes to the rectangles' yank.
> (import (md))
> (define grid (buffers:make "grid" (md:doc '() (rectangle:block '() "ab\ncd\n") (md:para '() "end\n"))))
> (kill-ring:push! (list (buffers:piece grid 1 9)))
> (kill-ring:insert! grid 10 (car (kill-ring:current)))
((10 . 16))
> (list rectangle:yanks (root grid))
((10) (md:doc () (rectangle:block () "ab\ncd\n") (md:para () "ab\ncd\nend\n")))
