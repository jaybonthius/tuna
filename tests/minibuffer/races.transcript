; A quit that lands between an answer and its task's resumption: the
; answer stands, and the prompt ends once.
> (define ended 0)
> (define (count-end p) (set! ended (+ ended 1)))
> (add-hook! minibuffer:prompt-ended count-end)
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "x")
> (begin (press! "RET") (signal-task t (make-message-condition "late")) (void))
! late
> (result t)
(raised "late")
> ended
1
; Answering an outer prompt while an inner one waits leaves the inner one
; shown and answerable.
> (define outer-prompt #f)
> (define outer (start! (lambda () (minibuffer:call-with-setup (lambda (p) (set! outer-prompt p)) (lambda () (minibuffer:read "Outer: "))))))
> (define inner (start! (lambda () (minibuffer:read "Inner: "))))
> (minibuffer:exit! outer-prompt 'early)
> (result outer)
early
> (minibuffer:input (prompt))
""
