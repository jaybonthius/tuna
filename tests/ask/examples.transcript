; Until a plugin fills its reader, each question raises.
> (raised (lambda () (ask:file-name "Find file: ")))
(ask:file-name-reader "no reader is loaded")
> (raised (lambda () (ask:line "Rename session to: ")))
(ask:line-reader "no reader is loaded")
> (raised (lambda () (ask:number "Columns: ")))
(ask:number-reader "no reader is loaded")
> (raised (lambda () (ask:yes-or-no? "Exit anyway? ")))
(ask:yes-or-no-reader "no reader is loaded")
> (raised (lambda () (ask:y-or-n? "Save it? ")))
(ask:y-or-n-reader "no reader is loaded")
> (raised (lambda () (ask:choice "Action: " (list (cons "Rename" 'rename)))))
(ask:choice-reader "no reader is loaded")
> (raised (lambda () (ask:line-with-candidates "Identifier: " (list "car" "cdr"))))
(ask:line-with-candidates-reader "no reader is loaded")
; Each question calls its reader with the question and returns its answer.
> (define asked '())
> (define (reader answer) (lambda (question . rest) (set! asked (cons question asked)) answer))
> (set-option! ask:file-name-reader (reader "/tmp/notes.txt"))
> (set-option! ask:line-reader (reader "notes"))
> (set-option! ask:number-reader (reader 80))
> (set-option! ask:yes-or-no-reader (reader #t))
> (set-option! ask:y-or-n-reader (reader #f))
> (list (ask:file-name "Find file: ") (ask:line "Rename session to: ") (ask:number "Columns: ") (ask:yes-or-no? "Exit anyway? ") (ask:y-or-n? "Save it? "))
("/tmp/notes.txt" "notes" 80 #t #f)
> asked
("Save it? " "Exit anyway? " "Columns: " "Rename session to: " "Find file: ")
; A line's reader gets its default, or #f; a choice's reader gets the
; choices, and a line's with candidates gets them and its default.
> (set-option! ask:line-reader (lambda (question default) (list question default)))
> (ask:line "Rename to: " "notes")
("Rename to: " "notes")
> (ask:line "Rename to: ")
("Rename to: " #f)
> (set-option! ask:choice-reader (lambda (question choices) (cdr (cadr choices))))
> (ask:choice "Action: " (list (cons "Rename" 'rename) (cons "Extract" 'extract)))
extract
> (set-option! ask:line-with-candidates-reader list)
> (ask:line-with-candidates "Identifier: " (list "car" "cdr"))
("Identifier: " ("car" "cdr") #f)
> (ask:line-with-candidates "Identifier: " (list "car" "cdr") "car")
("Identifier: " ("car" "cdr") "car")
; A question must be a string.
> (raised (lambda () (ask:y-or-n? 'save)))
(ask:y-or-n? "not a string")
> (raised (lambda () (ask:line 'name)))
(ask:line "not a string")
> (raised (lambda () (ask:line "Name: " 'notes)))
(ask:line "neither a string nor #f")
> (raised (lambda () (ask:choice "Action: " (list 'rename))))
(ask:choice "not a list of pairs of a label and a value")
> (raised (lambda () (ask:line-with-candidates "Identifier: " (vector "car"))))
(ask:line-with-candidates "neither a list of strings nor a procedure")
