; View atoms: the first atom naming a view draws it; a second gets a new
; view with its cursors; a number naming no view gets a view of that
; number; an atom without a number gets a view of its buffer. Each draw
; finds the same views.
> (define first (views:make (buffers:make "buy" "Buy milk.\n")))
> (views:set-point! first 5)
> (define layout
    (buffers:make "*layout*"
      (md:doc '()
        (views:view `((view . ,(views:id first)) (buffer . "buy")))
        (views:view `((view . ,(views:id first)) (buffer . "buy")))
        (views:view '((view . 70) (buffer . "buy")))
        (views:view '((buffer . "buy"))))))
