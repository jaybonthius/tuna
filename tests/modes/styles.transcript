; Keymap styles built on modes. A Vim-style plugin keeps each view's
; state in its own table and adds its own keys:find-keymaps entry at
; depth 25: after the keymaps at the cursor, before every mode's.
> (import (vim) (python))
> (disk:write-text! "~/a.py" "f()\n")
> (define a (show! (files:visit "~/a.py")))
> (views:set-point! (view) 1)
> (know! vim:normal-keymap 'vim:normal-keymap vim:insert-keymap 'vim:insert-keymap)
> (active-keymaps)
(vim:normal-keymap fill:keymap python:keymap prog:keymap layout:keymap keys:global)
; In normal state typing inserts nothing; i enters insert state, ESC
; leaves it.
> (press! "x")
! x is undefined
> (text a)
"f()\n"
> (press! "i" "x" "y")
> (text a)
"xyf()\n"
> (active-keymaps)
(vim:insert-keymap fill:keymap python:keymap prog:keymap layout:keymap keys:global)
> (press! "ESC" "z")
! z is undefined
> (text a)
"xyf()\n"
; A mode's own keys in normal state, found along its ancestry.
> (tables:define-table prog-normal)
> (know! prog-normal 'prog-normal)
> (commands:define-command (forward) "Moves forward one character." (views:set-point! (view) (+ 1 (views:point (view)))))
> (keys:bind! prog-normal "l" forward)
> (tables:set! vim:normal-keymaps prog:mode prog-normal)
> (active-keymaps)
(prog-normal vim:normal-keymap fill:keymap python:keymap prog:keymap layout:keymap keys:global)
> (press! "l" "l")
> (views:point (view))
5
; The state a view starts in, by major mode; a mode switch forgets the
; states of the buffer's views.
> (tables:set! vim:initial-states text:mode vim:insert-keymap)
> (disk:write-text! "~/n.txt" "")
> (define n (show! (files:visit "~/n.txt")))
> (modes:set-major-mode text:mode n)
> (press! "h" "i")
> (text n)
"hi"
> (show! a)
#<buffer a.py>
> (press! "i")
> (active-keymaps)
(vim:insert-keymap fill:keymap python:keymap prog:keymap layout:keymap keys:global)
> (modes:set-major-mode python:mode a)
> (active-keymaps)
(prog-normal vim:normal-keymap fill:keymap python:keymap prog:keymap layout:keymap keys:global)
; A keymap at the cursor still comes first: a kind's keys in normal
; state.
> (tables:define-table button-keymap)
> (know! button-keymap 'button-keymap)
> (commands:define-command (pressed) "Notes the button." (display "pressed\n"))
> (keys:bind! button-keymap "RET" pressed)
> (buffers:define-kind button (content atom) (keymap button-keymap))
> (define form (show! (buffers:make "form" (list 'buffers:text '() "ab" (button '()) "cd"))))
> (views:set-point! (view) 3)
> (active-keymaps)
(button-keymap vim:normal-keymap modes:fundamental-keymap layout:keymap keys:global)
> (press! "RET")
pressed
; A VS Code language contribution: the mode's name is the language id,
; file names and interpreters are auto-mode table entries, and a "when"
; clause on a context key is a minor mode reading the plugin's own state.
> (disk:write-text! "~/tool" "#!/usr/bin/env python3\n")
> (map modes:major-mode (list (files:visit "~/b.py") (files:visit "~/tool")))
! ask:message: (New file)
(python:mode python:mode)
> (define (has-mark?)
    (let ([v (views:current)])
      (and v (views:cursor-mark (car (views:cursors v))) #t)))
> (tables:define-table selection-keymap)
> (know! selection-keymap 'selection-keymap)
> (commands:define-command (selection-command) "Runs only with a selection." (display "selected\n"))
> (keys:bind! selection-keymap "C-c x" selection-command)
> (tables:set! modes:minor-modes has-mark? 0)
> (tables:set! modes:keymaps has-mark? selection-keymap)
> (define py (show! (files:visit "~/tool")))
> (tables:set! vim:initial-states python:mode vim:insert-keymap)
> (modes:set-major-mode python:mode py)
> (press! "C-c" "x")
! C-c x is undefined
> (press! "C-SPC" "C-c" "x")
! ask:message: Mark set
selected
