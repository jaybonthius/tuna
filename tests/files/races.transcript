#t
; Quits land in edits, saves, their jobs' deliveries and the bookkeeping.
; Afterwards each buffer saves, and its file holds its text. The thread
; asks for a quit every tenth of a millisecond, once for each time the
; main thread arms it inside the guard, so no quit lands outside it but in
; whatever runs while the guarded task waits for a job, reported there.
; One made while a task pauses or resumes waits, and one made while no
; task runs quits nothing, so how many land varies. A save waits for the
; disk, which other programs can hold up for hundreds of milliseconds, so
; the storm goes on until enough saves and requests have come, giving up
; twenty seconds on, so that a plugin that stops saving shows as a false
; result rather than a timeout.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define quits 0)
> (define (count-quits report c)
    (if (quit-condition? c) (set! quits (+ quits 1)) (report c)))
> (advice-add! report count-quits)
> (define armed (box #f))
> (define quitting (box #t))
> (define requests 0)
> (define (quitter)
    (let loop ()
      (when (unbox quitting)
        (chez:sleep (make-time 'time-duration 100000 0))
        (when (box-cas! armed #t #f)
          (request-quit!)
          (set! requests (+ requests 1)))
        (loop))))
> (define saves 0)
> (define (stress until)
    (let again ()
      (guard (c [(quit-condition? c) (set! quits (+ quits 1)) (again)])
        (let loop ()
          (when (and (< (real-time) (+ until 20000))
                     (or (< (real-time) until) (<= saves 30) (<= requests 30)))
            (for-each (lambda (b)
                        (set-box! armed #t)
                        (buffers:replace! b 1 1 "q")
                        (set-box! armed #t)
                        (files:save-buffer b)
                        (set! saves (+ saves 1)))
                      (files:buffers))
            (loop)))
        (set-box! armed #f)
        (sleep-for 0.05))))
> (begin
    (fork-thread quitter)
    (stress (+ (real-time) 1500))
    (set-box! quitting #f)
    (list (> saves 30) (> requests 30)))
(#t #t)
> (advice-remove! report count-quits)
