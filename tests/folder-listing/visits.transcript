; C-x d reads a folder, starting in files:directory, or in the listing's
; folder from a listing, and shows its listing.
> (touch! "v/sub/deep.txt" "deep\n")
> (touch! "v/f.txt" "f\n")
> (define started #f)
> (set-option! ask:file-name-reader (lambda (q folder) (set! started (list q folder)) "~/v"))
> (press! "C-x" "d")
> (settle)
> (list started (shown) (point-name))
(("Folder: " "$HOME/") (("~/v/" #t)) "f.txt")
> (press! "C-x" "d")
> (settle)
> started
("Folder: " "$HOME/v/")
; RET visits the entry at point, a folder showing its listing; ^ shows
; the parent's listing with point on the folder; C-x C-j from a file
; shows its folder's listing with point on it.
> (goto "sub")
> (press! "RET")
> (settle)
> (list (shown) (point-name))
((("~/v/sub/" #t)) "deep.txt")
> (press! "RET")
> (settle)
> (shown)
(("deep.txt" #t))
> (press! "C-x" "C-j")
> (settle)
> (list (shown) (point-name))
((("~/v/sub/" #t)) "deep.txt")
> (press! "^")
> (settle)
> (list (shown) (point-name))
((("~/v/" #t)) "sub")
> (press! "^")
> (settle)
> (list (shown) (point-name))
((("~/" #t)) "v")
; o shows the entry in another view and selects it; C-o leaves the
; listing selected; q quits the view.
> (press! "RET")
> (settle)
> (press! "C-x" "3")
> (layout:switch-to-buffer (buffers:find "*scratch*"))
> (press! "C-x" "o")
> (goto "f.txt")
> (press! "C-o")
> (settle)
> (shown)
(("f.txt" #f) ("~/v/" #t))
> (goto "sub")
> (press! "o")
> (settle)
> (shown)
(("~/v/sub/" #t) ("~/v/" #f))
> (press! "q")
> (shown)
(("f.txt" #t) ("~/v/" #f))
; A click on a name opens it as o does, so a name is marked clickable.
> (let ([m (views:keymap-mark folder-listing:name-keymap)])
    (substring m (string-length (number->string (mark-number folder-listing:name-keymap))) (string-length m)))
" clickable"
> (press! "C-x" "o")
> (click-name! "sub")
> (settle)
> (shown)
(("~/v/sub/" #t) ("~/v/" #f))
; The header's path parts are links to their folders' listings.
> (press! "C-x" "o")
> (in-client (lambda () (folder-listing:%follow-folder-link (header-link (string-append home "/")))))
> (settle)
> (shown)
(("~/v/sub/" #f) ("~/" #t))
; Visiting a listing whose folder changed says so, or reads it again
; with folder-listing:refresh-when-revisited?.
> (define v (folder-listing:visit (at "v")))
> (sleep-for 1.1)
> (touch! "v/g.txt" "g\n")
> (eq? v (folder-listing:visit (at "v")))
#t
> (list (message) (listing-lines v))
("Folder changed on disk; type g to refresh" ("  ." "  .." "  f.txt" "  sub"))
> (set-option! folder-listing:refresh-when-revisited? #t)
> (eq? v (folder-listing:visit (at "v")))
#t
> (listing-lines v)
("  ." "  .." "  f.txt" "  g.txt" "  sub")
; A listing whose folder is gone stays as it was read, and g raises.
> (define gone (folder-listing:visit (at "v/sub")))
> (system (string-append "rm -r " (at "v/sub")))
0
> (raised (lambda () (folder-listing:refresh gone)))
(folder-listing:refresh "no such folder")
> (listing-lines gone)
("  ." "  .." "  deep.txt")
> (raised (lambda () (folder-listing:visit (at "v/f.txt"))))
(folder-listing:visit "not a folder")
> (raised (lambda () (folder-listing:visit (at "v/none"))))
(folder-listing:visit "failed for ~/v/none: no such file or directory")
> (guard (c [#t (cons (condition-message c) (condition-irritants c))])
    (folder-listing:refresh gone))
("no such folder" "~/v/sub/")
; A home reached through a symbolic link names a listing, and a
; worker's failure, with ~ too, since a listing's folder is its true path.
> (symlink! home "../home-link")
0
> (folder! "linked")
> (putenv "HOME" (string-append home "-link"))
> (buffers:name (folder-listing:visit "~/linked"))
"~/linked/"
> (raised (lambda () (folder-listing:visit "~/v/none")))
(folder-listing:visit "failed for ~/v/none: no such file or directory")
> (putenv "HOME" home)
; folder-listing:place-point! puts point where a shown listing starts,
; on its first file; advice on it starts point elsewhere, as Emacs's
; dired-initial-position-hook does.
> (touch! "w/a.txt" "a\n")
> (touch! "w/b.txt" "b\n")
> (define (on-last-entry place view)
    (place view)
    (let ([last (car (reverse (entries (views:buffer view))))])
      (views:set-point! view (+ 1 (document:node-start last)))))
> (advice-add! folder-listing:place-point! on-last-entry)
> (set-option! ask:file-name-reader (lambda (q folder) "~/w"))
> (press! "C-x" "d")
> (settle)
> (list (buffers:name (views:buffer (view))) (point-name))
("~/w/" "b.txt")
> (advice-remove! folder-listing:place-point! on-last-entry)
