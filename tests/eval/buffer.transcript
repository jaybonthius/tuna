; C-c C-k evaluates a buffer's file as (repl): what it writes shows, then
; the message Evaluated the NAME buffer. Point stays.
> (write-file! "notes.ss" "(define n 1)\n(display \"hi\")\n")
> (define notes (show! (files:visit (at "notes.ss"))))
> (at! notes "(display" 0)
> (define t (start! "C-c" "C-k"))
> (finish t)
#t
> (list (message) (log-tail 2) n (point-text))
("Evaluated the notes.ss buffer" ("hi" "Evaluated the notes.ss buffer") 1 "(define n 1)\n-!-(display \"hi\")\n")
; A modified buffer asks to be saved first: y saves it, then evaluates the
; file.
> (buffers:insert! notes 1 "(define m 2)\n")
14
> (define t (start! "C-c" "C-k"))
> (prompt-text)
"Save notes.ss first? (y or n) \n"
> (press! "y")
> (finish t)
#t
> (list (buffers:modified? notes) m (message))
(#f 2 "Evaluated the notes.ss buffer")
; n evaluates the file as saved, without the buffer's edits.
> (buffers:insert! notes 1 "(define k 3)\n")
14
> (define t (start! "C-c" "C-k"))
> (press! "n")
> (finish t)
#t
> (list (buffers:modified? notes) (guard (c [#t 'unbound]) (eval 'k)) (message))
(#t unbound "Evaluated the notes.ss buffer")
; C-g at the question saves and evaluates nothing. A prompt's C-g quits
; without the message Quit.
> (define evaluated (length (log-tail 100)))
> (define t (start! "C-c" "C-k"))
> (press! "C-g")
! &cancelled
> (finish t)
#t
> (list (buffers:modified? notes) (= evaluated (length (log-tail 100))) (message))
(#t #t #f)
> (files:save-buffer notes)
; A raise stops a file that is no module: what it wrote is logged before
; the report, the forms after it do not run, and no Evaluated line shows.
> (write-file! "failing.ss" "(display \"a\")\n(car 1)\n(define after #t)\n")
> (begin (show! (files:visit (at "failing.ss"))) (void))
> (define t (start! "C-c" "C-k"))
! car: 1 is not a pair
> (finish t)
#t
> (list (message) (log-tail 2) (guard (c [#t 'unbound]) (eval 'after)))
("1 is not a pair" ("a" "car: 1 is not a pair") unbound)
; A loaded module's file reloads the module.
> (import (greet))
> (define greet-file (files:visit (at ".config/tuna/lib/greet.sls")))
> (begin (show! greet-file) (void))
> (write-file! ".config/tuna/lib/greet.sls" "#!tuna\n(define (text n) (string-append \"Hi, \" n \"!\"))\n")
> (finish (start! "C-c" "C-k"))
#t
> (list (greet:text "a") (message))
("Hi, a!" "Evaluated the greet.sls buffer")
; A reload that fails is reported, the previous version runs again, and
; no Evaluated line shows: a body that raises,
> (write-file! ".config/tuna/lib/greet.sls" "#!tuna\n(define (text n) n)\n(car 1)\n")
> (finish (start! "C-c" "C-k"))
! car: 1 is not a pair
#t
> (list (greet:text "a") (message))
("Hi, a!" "1 is not a pair")
; a compile error,
> (write-file! ".config/tuna/lib/greet.sls" "#!tuna\n(define (text n) n)\n(define)\n")
> (finish (start! "C-c" "C-k"))
! $HOME/.config/tuna/lib/greet.sls: invalid syntax (define-public)
#t
> (list (greet:text "a") (message))
("Hi, a!" "invalid syntax")
; a body that only warns, whose warning shows,
> (write-file! ".config/tuna/lib/greet.sls" "#!tuna\n(define (text n) (string-append \"Hey, \" n))\n(define (w) (car))\n")
> (finish (start! "C-c" "C-k"))
! compile: possible incorrect argument count in call (car)
#t
> (list (greet:text "a") (message) (echo-area:current-face))
("Hey, a" "possible incorrect argument count in call (car)" warning)
; and a good reload during which an advice of module-loaded raises.
> (define (raise-after loaded instance) (loaded instance) (when (equal? (owner-name instance) '(greet)) (car 2)))
> (advice-add! module-loaded raise-after)
> (write-file! ".config/tuna/lib/greet.sls" "#!tuna\n(define (text n) (string-append \"Yo, \" n))\n")
> (finish (start! "C-c" "C-k"))
! car: 2 is not a pair
#t
> (list (greet:text "a") (message))
("Yo, a" "2 is not a pair")
> (advice-remove! module-loaded raise-after)
; A buffer with no file evaluates its text as (repl).
> (define code (show! (buffers:make "code.ss" "(define from-text (+ 1 2))\n")))
> (modes:set-major-mode chez-scheme:mode code)
> (finish (start! "C-c" "C-k"))
#t
> (list (message) from-text)
("Evaluated the code.ss buffer" 3)
; So does a buffer whose file does not exist yet, with its path's scope.
> (define fresh (files:visit (at "fresh.ss")))
> (begin (show! fresh) (buffers:insert! fresh 1 "(define fresh-value 4)\n") (void))
> (finish (start! "C-c" "C-k"))
#t
> (list (message) fresh-value (file-exists? (at "fresh.ss")))
("Evaluated the fresh.ss buffer" 4 #f)
; A plain library under a library root runs its body, then raises.
> (write-file! ".config/tuna/lib/plain.sls" "(library (plain) (export) (import (chezscheme)) (display \"body\"))\n")
> (begin (show! (files:visit (at ".config/tuna/lib/plain.sls"))) (void))
> (finish (start! "C-c" "C-k"))
! load-module!: not a module with irritant (plain)
#t
> (list (message) (log-tail 2))
("not a module with irritant (plain)" ("body" "load-module!: not a module with irritant (plain)"))
