python:mode
; A temporary visit, such as a preview's, sets the mode
; with its hooks delayed and runs files:after-temporary-visit in place of
; files:after-visit; a later visit completes it: the after-visit entries
; and the delayed mode hooks run once, in the same buffer.
> (define visited '())
> (define (note-visit b) (set! visited (cons (buffers:name b) visited)))
> (hooks:add! files:after-visit note-visit)
> (define hooked '())
> (define (note-hook) (set! hooked (cons (buffers:name (buffers:current)) hooked)))
> (hooks:add! python:mode-hook note-hook)
> (define previewed '())
> (define (note-preview b) (set! previewed (cons (list (buffers:name b) (modes:major-mode b)) previewed)))
> (hooks:add! modes:delayed-mode-changed note-preview)
> (disk:write-text! "~/four.py" "4\n")
