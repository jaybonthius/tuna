> (define repo (fresh! "repo"))
; past git-status:file-list-limit untracked files, the list ends in
; how many are not listed.
> (set-option! git-status:file-list-limit 2)
> (sh "cd repo && echo 1 > u1.txt && echo 2 > u2.txt")
> (git-mode:refresh-repository repo)
> (ui:show-section! (view) (section '(untracked . #f)))
> (list-head (list-tail (status) 2) 5)
("Untracked files (3)" "new.txt" "u1.txt" "1 files not listed" "Unstaged changes (4)")
> (set-option! git-status:file-list-limit 100)
; git-status:untracked-files lists every file, none, or a folder as
; itself; #f follows status.showUntrackedFiles.
> (sh "cd repo && mkdir -p folder && echo f > folder/x.txt && echo g > folder/y.txt")
> (define (untracked) (map ui:section-value (filter (lambda (s) (eq? (ui:section-type s) 'file)) (ui:section-children (section '(untracked . #f))))))
> (git-mode:refresh-repository repo)
> (untracked)
("folder/" "new.txt" "u1.txt" "u2.txt")
> (set-option! git-status:untracked-files (git:untracked-listing all))
> (git-mode:refresh-repository repo)
> (untracked)
("folder/x.txt" "folder/y.txt" "new.txt" "u1.txt" "u2.txt")
> (set-option! git-status:untracked-files (git:untracked-listing no))
> (git-mode:refresh-repository repo)
> (section '(untracked . #f))
#f
> (set-option! git-status:untracked-files #f)
> (sh "cd repo && git config status.showUntrackedFiles no")
> (git-mode:refresh-repository repo)
> (section '(untracked . #f))
#f
> (sh "cd repo && git config --unset status.showUntrackedFiles")
; advice on git:untracked leaves paths out.
> (define (without-folder original repository listing) (filter (lambda (p) (not (string=? (utf8->string p) "folder/"))) (original repository listing)))
> (advice-add! git:untracked without-folder)
> (git-mode:refresh-repository repo)
> (untracked)
("new.txt" "u1.txt" "u2.txt")
> (advice-remove! git:untracked without-folder)
; stashes list, hidden at first.
> (sh "cd repo && echo s > s.txt && git add s.txt && git stash push -q -- s.txt")
> (git-mode:refresh-repository repo)
> (filter (lambda (l) (and (>= (string-length l) 7) (string=? (substring l 0 7) "Stashes"))) (status))
("Stashes (1)…")
> (ui:show-section! (view) (section '(stashes . #f)))
> (list-head (member "Stashes (1)" (status)) 2)
("Stashes (1)" "stash@{0} WIP on main: 77c2625 long")
; entries added to git-status:sections and git-status:headers show
; among the built-in ones, by depth.
> (define (notes-section repository status) (list (ui:section '((type . notes) (value . #f)) "Notes" "a note")))
> (define (user-header repository status) (list (list "User:     Tuna")))
> (add-hook! git-status:sections notes-section 15)
> (add-hook! git-status:headers user-header 15)
> (git-mode:refresh-repository repo)
> (list-head (status) 3)
("Head:     main long" "Merge:    origin/main First commit" "User:     Tuna")
> (list-head (member "Notes" (status)) 2)
("Notes" "a note")
> (remove-hook! git-status:sections notes-section)
> (remove-hook! git-status:headers user-header)
> (git-mode:refresh-repository repo)
; a row's buttons run s, u and k on that row whatever point
; is; point and the selected view stay.
> (define (click-button! keymap . identity) (click-marked! (view) (ui:section-heading-start (apply section identity)) keymap))
> (press! "M-<")
> (define before (views:point (view)))
> (click-button! git-status:stage-button-keys '(file . "a.py") '(unstaged . #f))
> (settle!)
> (list (git-out "repo" "status" "--short" "a.py") (= before (views:point (view))))
("M  a.py\n" #t)
> (click-button! git-status:unstage-button-keys '(file . "a.py") '(staged . #f))
> (settle!)
> (git-out "repo" "status" "--short" "a.py")
" M a.py\n"
> (answer! #t)
> (click-button! git-status:discard-button-keys '(file . "a.py") '(unstaged . #f))
> (settle!)
> (list (take-asked!) (git-out "repo" "status" "--short" "a.py") (= before (views:point (view))))
(("Discard unstaged changes in \"a.py\"? ") "" #t)
> (ui:show-section! (view) (section '(file . "long.txt") '(unstaged . #f)))
> (click-button! git-status:stage-button-keys '(hunk . "@@ -1,5 +1,5 @@") '(file . "long.txt") '(unstaged . #f))
> (settle!)
> (git-out "repo" "diff" "--cached" "--stat" "long.txt")
" long.txt | 2 +-\n 1 file changed, 1 insertion(+), 1 deletion(-)\n"
> (answer! #t)
> (click-button! git-status:stage-button-keys '(unstaged . #f))
> (settle!)
> (git-out "repo" "status" "--short")
"M  b.txt\nD  gone.txt\nM  long.txt\n?? folder/\n?? new.txt\n?? u1.txt\n?? u2.txt\n"
; a file row, hunk heading and list heading carry their buttons, drawn
; after the heading, not text.
> (define h (html (view)))
> (list (contains? h "git-status-buttons") (contains? h ">−</button>") (contains? h ">⟲</button>"))
(#t #t #t)
> (contains? (document:text (buffers:document (status-buffer))) "⟲")
#f
