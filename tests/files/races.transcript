; A condition that is not serious, raised at a waiting saver, leaves the
; buffer free for the next save.
> (define (stop-saver b) (let ([saver (current-task)]) (spawn-task (lambda () (signal-task saver (make-message-condition "stop"))))))
> (add-hook! files:before-save stop-saver)
> (buffers:replace! one 1 1 "s")
