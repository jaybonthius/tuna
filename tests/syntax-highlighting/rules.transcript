; A highlighter is a worker, the layer types it fills and its input
; procedure; make-highlighter checks each.
> (syntax-highlighting:highlighter? (table-ref syntax-highlighting:highlighters "marks"))
#t
> (syntax-highlighting:highlighter? marks:%marks)
#f
> (table-ref syntax-highlighting:highlighters "marks")
#<highlighter>
> (syntax-highlighting:make-highlighter 'w (list syntax-highlighting:faces) marks:%input)
! syntax-highlighting:make-highlighter: not a worker with irritant w
> (syntax-highlighting:make-highlighter marks:%marks '() marks:%input)
! syntax-highlighting:make-highlighter: not a list of layer types with irritant ()
> (syntax-highlighting:make-highlighter marks:%marks (list 1) marks:%input)
! syntax-highlighting:make-highlighter: not a list of layer types with irritant (1)
> (syntax-highlighting:make-highlighter marks:%marks (list syntax-highlighting:faces) 'input)
! syntax-highlighting:make-highlighter: not a procedure with irritant input
; The face layer: below other layers, sticky after, evaporating.
> (let ([b (buffers:make "layer" "ab")])
    (buffers:set-spans! (buffers:layer b syntax-highlighting:faces) 0 1 '((0 1 ((face . comment)))))
    (buffers:insert! b 1 "x")
    (buffers:spans (buffers:layer b syntax-highlighting:faces) 0 3))
((0 2 ((face . comment))))
; A buffer gets its job at the end of the batch in which its mode is
; set, so a view made in that batch is there for the input to read.
> (define a (buffers:make "a.mk" "#one two (#three)\n"))
> (begin (modes:set-major-mode marks:mode a) (views:make a) (marks:inputs))
()
> (job-events)
((start #<job %marks>))
> (faces a)
(("#one" comment) ("#three" comment))
> (parens a)
("(" ")")
; The input procedure ran with no data when the job started, then with
; the data the job returned.
> (marks:inputs)
(("a.mk" #f 1) ("a.mk" (1 ()) 1))
; Each edit goes to the job, which highlights the newest text and is
; told each edit, as character offsets: start, removed, inserted.
> (begin (buffers:replace! a 6 9 "#2") (buffers:insert! a 5 "x") #t)
#t
> (faces a)
(("#onex" comment) ("#2" comment) ("#three" comment))
> (marks:inputs)
(("a.mk" (2 ((5 3 2) (4 0 1))) 1))
; Text typed right after a span takes its face until the job's answer.
> (begin (buffers:insert! a 6 "!") (buffers:spans (buffers:layer a syntax-highlighting:faces) 0 8))
((1 7 ((face . comment))))
> (faces a)
(("#onex!" comment) ("#2" comment) ("#three" comment))
> (marks:inputs)
(("a.mk" (3 ((5 0 1))) 1))
; update! calls the input procedure again and sends the job a changed
; input; an unchanged one is not sent, so the job does not run.
> (buffers:with-buffer a (set-option-local! marks:mark "x"))
> (syntax-highlighting:update! a)
> (faces a)
()
> (marks:inputs)
(("a.mk" (3 ((5 0 1))) 1) ("a.mk" (4 ()) 1))
> (syntax-highlighting:update! a)
> (faces a)
()
> (marks:inputs)
(("a.mk" (4 ()) 1))
; Without a buffer, update! reads the input of every buffer with a job.
> (define b (marked "b.mk" "#b x" marks:mode))
> (faces b)
(("#b" comment))
> (marks:inputs)
(("b.mk" #f 0) ("b.mk" (1 ()) 0))
> (buffers:with-buffer a (set-option-local! marks:mark "#"))
> (buffers:with-buffer b (set-option-local! marks:mark "x"))
> (syntax-highlighting:update!)
> (list (faces a) (faces b))
((("#onex!" comment) ("#2" comment) ("#three" comment)) (("x" comment)))
> (list-sort (lambda (x y) (string<? (car x) (car y))) (marks:inputs))
(("a.mk" (4 ()) 1) ("a.mk" (5 ()) 1) ("b.mk" (1 ()) 0) ("b.mk" (2 ()) 0))
> (syntax-highlighting:update! 'a)
! syntax-highlighting:update!: not a buffer with irritant a
; input-changed! reads a running job's input again, and sends it only
; when it changed, as update! does.
> (buffers:with-buffer a (set-option-local! marks:mark "x"))
> (syntax-highlighting:input-changed! a)
> (list (faces a) (marks:inputs))
(() (("a.mk" (5 ()) 1) ("a.mk" (6 ()) 1)))
> (syntax-highlighting:input-changed! a)
> (marks:inputs)
(("a.mk" (6 ()) 1))
> (buffers:with-buffer a (set-option-local! marks:mark "#"))
> (syntax-highlighting:input-changed! a)
> (list (faces a) (marks:inputs))
((("#onex!" comment) ("#2" comment) ("#three" comment)) (("a.mk" (6 ()) 1) ("a.mk" (7 ()) 1)))
> (syntax-highlighting:input-changed! 'a)
! syntax-highlighting:input-changed!: not a buffer with irritant a
; A buffer's highlighter is the entry of the first mode in its mode's
; ancestry that has one, else its mode's language's: a derived mode is
; highlighted through its parent's language, and a mode's own entry wins
; over its language's.
> (job-events)
((start #<job %marks>))
> (define d (marked "d" "#d (x)" marks:derived))
> (faces d)
(("#d" comment))
> (define o (marked "o" "#o !own" marks:own))
> (faces o)
(("!own" comment))
; A mode with no language, or a language with no highlighter, gets no
; job and no message.
> (define u (marked "u" "#u" marks:unnamed))
> (define n (marked "n" "#n" marks:unknown))
> (list (faces u) (faces n) (modes:language marks:unknown))
(() () "nothing")
> (job-events)
((start #<job %marks>) (start #<job %marks>))
; A buffer whose mode changes to one without a highlighter loses its job
; and its spans.
> (modes:set-major-mode modes:fundamental d)
> (job-events)
((stop #<job %marks>))
> (list (faces d) (parens d))
(() ())
; Setting a buffer's mode again restarts its job, which reads its input
; anew.
> (marks:inputs)
(("d" #f 0) ("d" (1 ()) 0) ("o" #f 0) ("o" (1 ()) 0))
> (modes:set-major-mode marks:mode b)
> (job-events)
((stop #<job %marks>) (start #<job %marks>))
> (faces b)
(("#b" comment))
> (marks:inputs)
(("b.mk" #f 0) ("b.mk" (1 ()) 0))
; Killing a buffer stops its job.
> (buffers:kill! o)
#t
> (job-events)
((stop #<job %marks>))
; A job that raises goes to report and leaves its buffer with no spans,
; and no job until its mode or highlighter changes or update! is called
; for it.
> (define r (marked "r" "#r" marks:raising))
> (faces r)
(("#r" comment))
> (buffers:insert! r 3 "!")
4
> (faces r)
! (syntax-highlighting) marks: the highlighter raised
()
> (begin (sleep-for 0.2) (job-events))
((start #<job %raising>))
> (syntax-highlighting:update! r)
> (faces r)
! (syntax-highlighting) marks: the highlighter raised
()
> (job-events)
((start #<job %raising>))
> (modes:set-major-mode marks:mode r)
> (list (faces r) (job-events))
((("#r!" comment)) ((start #<job %marks>)))
; So does an input procedure that raises: the job stops with it.
> (marks:inputs)
(("r" #f 0) ("r" #f 0) ("r" #f 0) ("r" (1 ()) 0))
> (buffers:with-buffer r (set-option-local! marks:input-raises? #t))
> (syntax-highlighting:update! r)
! marks:input: the input raised
> (list (faces r) (job-events))
(() ((stop #<job %marks>)))
> (syntax-highlighting:update! r)
> (job-events)
! (syntax-highlighting) marks:input: the input raised
()
; input-changed! leaves a buffer whose input raised as it is: no job
; starts, and nothing is reported again.
> (syntax-highlighting:input-changed! r)
> (begin (sleep-for 0.2) (job-events))
()
> (buffers:with-buffer r (set-option-local! marks:input-raises? #f))
> (syntax-highlighting:update! r)
> (list (faces r) (job-events))
((("#r!" comment)) ((start #<job %marks>)))
