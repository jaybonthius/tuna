> (define desktop (web:add-client! 1))
> (define a (buffers:make "a" "a\n"))
; Each case builds its layout from view numbers, since a view whose
; atom leaves the layout is dropped.
> (define (v n . attributes) (views:view (cons* (cons 'view n) (cons 'buffer "a") attributes)))
> (define (start! selected . parts)
    (layout:part-mode-leave)
    (apply set-parts! parts)
    (layout:views)
    (layout:select! (views:find selected))
    (press! desktop '("'" "super")))
> (define (row . parts) (apply layout-split:container '((direction . row)) parts))
> (define (column . parts) (apply layout-split:container '((direction . column)) parts))
; J and L swap the selected part with the part before or after it, with
; its place attributes; from an end, nothing changes.
> (start! 4 (row (v 3 '(weight . 2)) (v 4 '(weight . 3)) (v 5)))
> (type! desktop "L")
> (main)
(layout-split:container ((direction . row)) #(views:view ((view . 3) (buffer . "a") (weight . 2))) #(views:view ((view . 5) (buffer . "a"))) #(views:view ((view . 4) (buffer . "a") (weight . 3))))
> (list (part) (selected))
(4 4)
> (type! desktop "L")
> (shape (main))
(3 5 4)
> (press! desktop '("ArrowLeft" "shift") '("ArrowLeft" "shift"))
> (shape (main))
(4 3 5)
> (type! desktop "J")
> (shape (main))
(4 3 5)
; A locked part moves, and others move past it, but a part inside a
; locked part does not.
> (start! 4 (row (v 3) (v 4) (v 5 '(locked . #t))))
> (type! desktop "L")
> (shape (main))
(3 5 4)
> (type! desktop "j" "J")
> (list (shape (main)) (part) (selected))
((5 3 4) 5 4)
> (start! 4 (row (v 3) (layout-split:container '((direction . column) (locked . #t)) (v 4) (v 5))))
> (type! desktop "k" "L")
! layout:shift-forward: a locked part with irritant #<node layout-split:container 3>
> (shape (main))
(3 (4 5))
; Moving the focused column along a strip places the strip again, so it
; scrolls to the column's new place.
> (start! 4 (layout-scroll:container '() (v 3) (v 4) (v 5)))
> (define placed (placement desktop))
> (type! desktop "L")
> (list (shape (main)) (= (placement desktop) placed))
((3 5 4) #f)
; I lifts the part out of its container, to before it from its first
; place and after it from any other. A split left one child collapses,
; and the child takes its place.
> (start! 5 (row (v 3) (column (v 4) (v 5 '(weight . 5)) (v 6))))
> (type! desktop "I")
> (main)
(layout-split:container ((direction . row)) #(views:view ((view . 3) (buffer . "a"))) (layout-split:container ((direction . column)) #(views:view ((view . 4) (buffer . "a"))) #(views:view ((view . 6) (buffer . "a")))) #(views:view ((view . 5) (buffer . "a") (weight . 5))))
> (list (part) (selected))
(5 5)
> (start! 4 (row (v 3) (column (v 4) (v 5 '(weight . 2)))))
> (type! desktop "I")
> (main)
(layout-split:container ((direction . row)) #(views:view ((view . 3) (buffer . "a"))) #(views:view ((view . 4) (buffer . "a"))) #(views:view ((view . 5) (buffer . "a"))))
; A container that does not collapse is kept with one child; one left
; empty goes, and the part takes its place.
> (start! 4 (row (v 3) (layout-tabs:container '((weight . 2)) (v 4) (v 5))))
> (type! desktop "I")
> (main)
(layout-split:container ((direction . row)) #(views:view ((view . 3) (buffer . "a"))) #(views:view ((view . 4) (buffer . "a"))) (layout-tabs:container ((weight . 2)) #(views:view ((view . 5) (buffer . "a")))))
> (start! 4 (row (v 3) (layout-tabs:container '((weight . 2)) (v 4))))
> (type! desktop "I")
> (main)
(layout-split:container ((direction . row)) #(views:view ((view . 3) (buffer . "a"))) #(views:view ((view . 4) (buffer . "a") (weight . 2))))
; Nothing lifts out of the root's first part.
> (type! desktop "I")
> (shape (main))
(3 4)
; K moves the part into the nearest container after it, as its first
; child, else before it, as its last. Into another kind, it sheds the
; place attributes that kind does not name and takes that kind's own.
> (start! 3 (row (v 3 '(weight . 2)) (v 4) (layout-scroll:container '() (v 5 '(size . 1/3)))))
> (type! desktop "K")
> (main)
(layout-split:container ((direction . row)) #(views:view ((view . 4) (buffer . "a"))) (layout-scroll:container () #(views:view ((view . 3) (buffer . "a") (size . 1/2))) #(views:view ((view . 5) (buffer . "a") (size . 1/3)))))
> (list (part) (selected))
(3 3)
