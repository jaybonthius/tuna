; A chat starts Pi as a user process in its folder, with Pi's mode for
; editors and a session id pi chooses, so the session is known before Pi
; writes its file. Its error output is kept apart.
> (define chat (pi:start (getenv "HOME")))
> (pi:chat? chat)
#t
> (define f (fake-of chat))
> (let ([args (fake-args f)]) (list (list-head args 3) (string-length (list-ref args 3))))
(("--mode" "rpc" "--session-id") 36)
> (string=? (utf8->string (file-text (string-append (fake-dir f) "/cwd"))) (string-append (getenv "HOME") "\n"))
#t
> (let ([p (pi:chat-process chat)]) (list (processes:owner p) (bytevector? (processes:error-output p))))
(#f #t)
> (pi:chat-directory chat)
"~"
; Until Pi answers it is starting; then idle, with what Pi said.
> (wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (activities!)
(idle)
> (wait-until (lambda () (= 4 (length (fake-requests f)))))
> (asked f)
("get_state" "get_entries" "get_session_stats" "get_commands")
> (equal? (pi:chat-session-id chat) (list-ref (fake-args f) 3))
#t
> (let ([m (pi:chat-model chat)])
    (list (pi:model? m) (pi:model-provider m) (pi:model-id m) (pi:model-name m) (pi:model-context-window m) (pi:model-reasoning? m)))
(#t "fake" "fake-model" "Fake Model" 200000 #t)
> (list (pi:chat-thinking-level chat) (pi:chat-session-name chat) (pi:chat-auto-compaction? chat)
        (equal? (pi:chat-session-file chat) (string-append "/sessions/" (pi:chat-session-id chat) ".jsonl")))
("medium" #f #t #t)
> (wait-until (lambda () (pi:chat-usage chat)))
> (let ([u (pi:chat-usage chat)])
    (list (pi:usage? u) (pi:usage-tokens u) (pi:usage-cost u) (pi:usage-context-share u) (pi:usage-context-window u)))
(#t 1234 0.41 23/100 200000)
> (pi:chat-transcript chat)
()
; The chats, oldest first; starting on a session a live chat holds gives
; that chat.
> (define other (pi:start (getenv "HOME") "fixed-session"))
> (equal? (pi:chats) (list chat other))
#t
> (eq? (pi:start "/elsewhere" "fixed-session") other)
#t
> (eq? (pi:start (getenv "HOME") (pi:chat-session-id chat)) chat)
#t
> (list-tail (fake-args (fake-of other)) 2)
("--session-id" "fixed-session")
; A chat works in an absolute folder.
> (pi:start "src/tuna")
! pi:start: not an absolute path with irritant "src/tuna"
; Pi's commands, read when Pi starts, after each change of session and
; after each settle.
> (define g (fake-of other))
> (answer! g "get_commands"
    (lambda (g r)
      '(("commands" . #((("name" . "review") ("description" . "Review the diff") ("source" . "extension"))
                        (("name" . "fix-tests") ("description" . "Fix failing tests") ("source" . "prompt"))
                        (("name" . "skill:pdf") ("source" . "skill")))))))
> (say! g (event "agent_settled" '("aborted" . #f)))
> (wait-until (lambda () (= 3 (length (pi:chat-commands other)))))
> (map (lambda (c) (list (pi:slash-command? c) (pi:slash-command-name c) (pi:slash-command-description c) (pi:slash-command-source c)))
       (pi:chat-commands other))
((#t "review" "Review the diff" extension) (#t "fix-tests" "Fix failing tests" prompt) (#t "skill:pdf" "" skill))
; The closed sets are forms that refuse a misspelling.
> (list (pi:activity idle) (pi:method confirm) (pi:stop error) (pi:tool-state running))
(idle confirm error running)
> (pi:activity idel)
! universe of activity does not include specified symbol idel
; pi refuses a Pi older than 1.5.0: it asks Pi's version when it loads
; and whenever pi:command changes.
> (putenv "PI_FAKE_VERSION" "1.4.2")
> (set-option! pi:command '("pi" "--approve"))
> (sleep-for 0.5)
! (pi) Pi 1.4.2 is older than 1.5.0, the version pi supports
> (pi:start "/tmp")
! pi:start: Pi 1.4.2 is older than 1.5.0, the version pi supports
> (putenv "PI_FAKE_VERSION" "1.5.3")
> (set-option! pi:command '("pi"))
> (sleep-for 0.5)
> (pi:chat? (pi:start "/tmp"))
#t
