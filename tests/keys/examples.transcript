; Given a mouse key's position, the active keymaps are those a click
; there searches.
> (tables:define-table clicked-keys "Keys for clicks.")
> (define (at-click client posn) (if posn (list clicked-keys) '()))
> (hooks:add! keys:find-keymaps at-click)
> (list (and (memq clicked-keys (keys:active-keymaps frame)) #t)
        (and (memq clicked-keys (keys:active-keymaps frame 'posn)) #t))
(#f #t)
> (hooks:remove! keys:find-keymaps at-click)
