> (raised (lambda () (options:set! echo-area:echo-keystrokes -1)))
(options:set! "-1 is not a valid value for echo-area:echo-keystrokes")
; A client removed takes its echo with it.
> (options:set! echo-area:echo-keystrokes 0.2)
> (press-in! other-client "C-x")
> (web:client-removed other-client)
> (timers:sleep 0.4)
> (echo-for other-client)
#f
