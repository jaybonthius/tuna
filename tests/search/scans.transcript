; A scan reports the matches around its position first, then those from
; the range's start, and an index is known only once the text before it
; is covered.
> (define lines (apply string-append (map (lambda (k) (format "line ~a has a needle\n" k)) (iota 9000))))
> (define b (text-buffer "s" lines))
> (define q (search:make-query "needle"))
> (define middle (search:match-start (search:find b (search:make-query "line 8000 ") 0 forward)))
> (define first-update #f)
> (define done #f)
> (define s (search:scan b q 0 (end-of b) middle
             (lambda (s)
               (unless first-update
                 (set! first-update (list (search:scan-index s middle) (search:scan-index s (end-of b))
                                          (> (search:match-start (car (search:scan-matches s middle (end-of b)))) middle))))
               (when (search:scan-done? s) (set! done #t)))))
> (let wait () (unless done (sleep-for 0.01) (wait)))
> first-update
(#f #f #t)
> (list (search:scan-count s) (search:scan-index s middle) (search:scan-done? s) (search:scan-query s))
(9000 8000 #t #<query "needle">)
> (map (lambda (m) (span b m)) (search:scan-matches s 1 60))
((14 20 "needle") (34 40 "needle") (54 60 "needle"))
; After a batch that edits the buffer the scan starts again on the new
; text.
> (define updates 0)
> (define e (text-buffer "e" "aa needle bb needle\n"))
> (define es (scanned e q))
> (buffers:replace! e 1 1 "needle ")
#<edit 1>
; The old matches follow the edit, whether or not the new ones have
; arrived yet.
> (map (lambda (m) (span e m)) (filter (lambda (m) (> (search:match-start m) 1)) (search:scan-matches es 0 (end-of e))))
> (let wait ([n 0]) (unless (or (= n 300) (search:scan-done? es)) (sleep-for 0.01) (wait (+ n 1))))
> (map (lambda (m) (span e m)) (search:scan-matches es 0 (end-of e)))
((11 17 "needle") (21 27 "needle"))
((1 7 "needle") (11 17 "needle") (21 27 "needle"))
; A stopped scan keeps its matches and follows no more edits.
> (search:stop-scan! es)
> (buffers:replace! e 1 1 "needle ")
> (sleep-for 0.1)
> (search:scan-count es)
#<edit 2>
3
; A scan of a region in a buffer of many atoms gathers the texts of the
; atoms near it, and those further on only when a match reaching the
; region's end reads on.
> (define (row-text node) (string-append "row " (number->string (document:node-attribute node 'n)) "\n"))
> (buffers:define-kind rows (content nodes))
> (buffers:define-kind row (content atom) (text row-text))
> (define many (buffers:make "many" (cons* 'rows '() (map (lambda (k) (vector 'row (list (cons 'n k)))) (iota 100000)))))
> (define asked '())
> (define (note-atoms atom-texts doc start end) (set! asked (cons (list start end) asked)) (atom-texts doc start end))
> (advice-add! buffers:atom-texts note-atoms)
> (scan-spans many (scanned many (search:make-query "row 1[0-5]$" search:regexp) 10 20))
> (reverse asked)
> (set! asked '())
> (scan-spans many (scanned many (search:make-query "(?s)row 1[0-5]\\n.*row 99990" search:regexp) 10 20 10 (end-of many)))
> (reverse asked)
> (advice-remove! buffers:atom-texts note-atoms)
((11 12 "row 10\n") (12 13 "row 11\n") (13 14 "row 12\n") (14 15 "row 13\n") (15 16 "row 14\n") (16 17 "row 15\n"))
((10 20))
()
((10 65556) (65556 100002))
