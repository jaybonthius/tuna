; A section buffer as a status buffer is drawn: headers, then sections of
; files whose bodies are hunks, whose bodies are lines.
> (define (visible v)
    (let* ([doc (buffers:document (views:buffer v))] [n (document:length doc)] [folds (views:folds-at v 0)])
      (define (hidden? p) (exists (lambda (f) (and (< (car f) p) (<= p (cdr f)))) (fold-right (lambda (f acc) (cons f acc)) '() (all-folds v))))
      (let loop ([p 0] [line '()] [start #f] [acc '()])
        (cond
          [(= p n) (reverse acc)]
          [(char? (document:token doc p))
           (let ([c (document:token doc p)])
             (if (char=? c #\newline)
                 (loop (+ p 1) '() #f
                       (if (and start (not (hidden? start)))
                           (cons (string-append (list->string (reverse line)) (if (folded-here? v p) "…" "")) acc)
                           acc))
                 (loop (+ p 1) (cons c line) (or start p) acc)))]
          [else (loop (+ p 1) line start acc)]))))
> (define (all-folds v)
    (let ([doc (buffers:document (views:buffer v))])
      (let loop ([p 0] [acc '()])
        (if (= p (document:length doc)) acc
            (loop (+ p 1) (fold-left (lambda (acc f) (if (member f acc) acc (cons f acc))) acc (views:folds-at v p)))))))
> (define (folded-here? v p) (exists (lambda (f) (= (car f) p)) (views:folds-at v p)))
> (buffers:define-kind header)
> (buffers:define-kind status (content nodes))
