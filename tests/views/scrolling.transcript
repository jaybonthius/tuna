> (report! desktop v 100 0 #f)
> (drawn v laptop)
(1 70 70 () (6000))
> (web:client-removed desktop)
> (drawn v laptop)
(1 70 70 () (6000))
> (web:client-removed laptop)
> (drawn v (web:make-client 4 "1"))
(1 210 210 () ())
; Showing another buffer forgets what every device measured.
> (report! phone v 100 0 #f)
> (views:set-buffer! v (buffers:make "short" (lines 30)))
> (drawn v phone)
(1 31 31 () ())
> (views:set-buffer! v b)
; An item keeps its element's id while text is inserted above it, so the
; browser keeps the element, and the view still.
> (define (id-of-line view client line)
    (let* ([html (html-of view client)] [i (search html (format "data-line=\"~a\"" line) 0)])
      (let loop ([j i]) (if (string=? (substring html j (+ j 4)) "id=\"") (word-after (substring html j (+ j 40)) "id=\"") (loop (- j 1))))))
> (report! phone v 1 0 #f)
> (define before (id-of-line v phone 20))
> (buffers:replace! b (line-start v 2) (line-start v 2) "new\nlines\n")
#<edit 1>
> (eq? before (id-of-line v phone 22))
#t
; With a huge drawn-screens a client draws every item.
