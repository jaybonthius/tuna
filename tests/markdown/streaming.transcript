; Streamed text: each prefix of a reply, read as text still arriving,
; shows no marker of a construct still open. Only a table's header row
; shows its pipes, until its delimiter row arrives, and no block of a
; prefix holds more headings or emphasis than the same block of the
; whole reply, as one would if a delimiter inside an address were
; closed.
> (define reply "## Plan\n\nFirst, **read** the *guide* at [the site](https://tuna.example \"Tuna\") and run `make check`.\nThen ~~skip~~ go on, as https://tuna.example/_docs/read_me says.\n\n- one\n- two, with **bold**\n  - nested *item*\n\n1. Build\n2. Test\n\n> Quoted **text**\n> - and a list\n\n| a | b |\n|---|---|\n| 1 | **2** |\n\n```scheme\n(define (f x) (* x 2))\n```\n\nDone.\n")
> (define (prefixes) (map (lambda (n) (substring reply 0 n)) (iota (+ 1 (string-length reply)))))
> (define (visible ds)
    (apply string-append
      (map (lambda (d)
             (cond
               [(string? d) d]
               [(vector? d) ""]
               [(memq (car d) '(markdown:code markdown:code-block)) ""]
               [else (visible (cddr d))]))
           ds)))
> (define (marked? s) (exists (lambda (c) (memv c (string->list s))) '(#\* #\` #\~ #\[ #\] #\|)))
> (define (kinds ds) (apply append (map (lambda (d) (if (pair? d) (cons (car d) (kinds (cddr d))) '())) ds)))
> (define marked (filter (lambda (p) (marked? (visible (markdown:unfinished-blocks p)))) (prefixes)))
> (list (string-length (car marked)) (string-length (car (last-pair marked))) (substring reply (- (string-length (car marked)) 1) (string-length (car (last-pair marked)))))
(267 277 "| a | b |\n|")
> (define (counts ds) (map (lambda (kind) (length (filter (lambda (k) (eq? k kind)) (kinds ds)))) '(markdown:heading markdown:strong markdown:emphasis markdown:strikethrough)))
> (counts (markdown:blocks reply))
(1 4 2 1)
> (define (more? blocks finished)
    (and (pair? blocks) (pair? finished)
         (or (exists > (counts (list (car blocks))) (counts (list (car finished))))
             (more? (cdr blocks) (cdr finished)))))
> (filter (lambda (p) (more? (markdown:unfinished-blocks p) (markdown:blocks reply))) (prefixes))
()
; Once all of it has arrived, it reads as the finished text does.
> (equal? (markdown:unfinished-blocks reply) (markdown:blocks reply))
#t
; What is closed: a code span, emphasis, strong emphasis and
; strikethrough, nested or not. Text after an opener's last word waits.
> (markdown:unfinished-blocks "Run `make che")
((markdown:paragraph ((key . 0)) "Run " (markdown:code () "make che") "\n"))
> (markdown:unfinished-blocks "a *b _c ~~d")
((markdown:paragraph ((key . 0)) "a " (markdown:emphasis () "b " (markdown:emphasis () "c " (markdown:strikethrough () "d"))) "\n"))
> (markdown:unfinished-blocks "**bold *ital")
((markdown:paragraph ((key . 0)) (markdown:strong () "bold " (markdown:emphasis () "ital")) "\n"))
> (markdown:unfinished-blocks "**bold ")
((markdown:paragraph ((key . 0)) (markdown:strong () "bold") "\n"))
> (markdown:unfinished-blocks "# Head **in")
((markdown:heading ((key . 0) (level . 1)) "Head " (markdown:strong () "in") "\n"))
> (markdown:unfinished-blocks "| a | b |\n|---|---|\n| x | **y")
((markdown:table ((key . 0) (columns . 2)) (markdown:table-row ((key . 0) (header . #t)) (markdown:table-cell ((key . 0)) "a\n") (markdown:table-cell ((key . 1)) "b\n")) (markdown:table-row ((key . 1)) (markdown:table-cell ((key . 0)) "x\n") (markdown:table-cell ((key . 1)) (markdown:strong () "y") "\n"))))
; An opener with nothing after it yet is left out, as is a lone marker
; that may start a list item.
> (markdown:unfinished-blocks "Some **")
((markdown:paragraph ((key . 0)) "Some\n"))
> (markdown:unfinished-blocks "Para\n*")
((markdown:paragraph ((key . 0)) "Para\n"))
; A link or image whose label, address or title is unfinished is its
; label, emphasis and all.
