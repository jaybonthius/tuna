; lib/'s shadowed replaces the installed plugin's, which is reported at
; start.
! import: (shadowed) in lib/ replaces $HOME/.local/share/tuna/plugins/shadowed/src/shadowed.sls
; A module may define a name #!tuna provides; its own code means its own
; definition, and other code sees the prefixed name.
> (import (lists))
> (lists:twice '(1))
(mine)
> (list (lists:map car '(1)) (map - '(1)))
((mine) (-1))
> (lists:both '(1 2))
((mine) (-1 -2))
; A module cannot define a keyword its own code uses.
> (import (redefine))
! attempt to reference unbound identifier g at line 3, char 10 of $HOME/.config/tuna/lib/redefine.sls
; define-public and macros built on it export their names; Chez's
; definition forms export theirs when written at the top level, and a name
; a macro defines with them stays inside the module.
> (import (macros))
> (macros:greeting)
"hi"
> (define macros:hello (lambda () "hi"))
> (list (macros:hello) (map car (definition-changes macros:hello)))
("hi" (#<owner (repl) 1> #<owner (macros) 1>))
> (macros:entry-key (macros:make-entry 'k))
k
> (list macros:low macros:high)
(1 9)
> (macros:origin)
(0 10)
> (macros:verbose)
#f
> macros:make-pt
! variable macros:make-pt is not bound
> macros:limit
! variable macros:limit is not bound
; A module's procedure is changeable, and a top-level define of its name
; overrides it; a value it defines cannot be defined again, and an
; override is a procedure.
> (define macros:low 2)
! define: macros:low is (macros)'s definition and cannot be defined again
> (define macros:verbose 2)
! override-set!: not a procedure with irritant 2
> (advice-add! macros:make-entry (lambda (make . arguments) (apply make arguments)))
! advice-add!: not a changeable procedure with irritant #<procedure make-entry>
> (import (nodefiner))
! no visible binding for define-property key definer at line 3, char 20 of $HOME/.config/tuna/lib/nodefiner.sls
; Definitions come before expressions; Chez reports the first definition
; after an expression as Tuna expands it, with no position, so the report
; names the file.
> (import (late))
! $HOME/.config/tuna/lib/late.sls: invalid context for definition (define f (define-value (quote (...)) (quote late:f) (let (...) late:f) #f))
; Compiled for an importer, the error still names the file that holds it.
> (import (useslate))
! $HOME/.config/tuna/lib/late.sls: invalid context for definition (define f (define-value (quote (...)) (quote late:f) (let (...) late:f) #f))
; sleep pauses the task, and #!tuna is a module language too.
> (import (sleeper))
> (import (base-sleeper))
; A module may define sleep and exit too.
> (import (shadows))
> (shadows:both)
((slept 1) stayed)
> (import (base))
> (base:name)
(base)
; A module's own set! assigns its variable, from any thread; it exports a
; reader, since an assigned variable is not exported.
> (import (assign))
> (let* ([a (assign:bump!)] [b (assign:bump!)]) (list a b (assign:count)))
(1 2 2)
> (let ([t (fork-task (lambda (restore) (assign:bump!)))]) (join-task t) (assign:count))
3
> (owner-changes (plugins:repl-owner))
((override #<procedure> #f))
