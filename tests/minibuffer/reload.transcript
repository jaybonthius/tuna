; Unloading the minibuffer during a read quits the read. The
; configuration imports it, so its re-read loads a new instance at once:
; the old instance's buffer and readers go, and the new one's come.
> (define old (module-owner '(minibuffer)))
> (define old-minibuf (buffers:find " *Minibuf*"))
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "abc")
> (unload-owner! old)
! &cancelled
> (result t)
(raised #<condition &cancelled>)
> (list (owner-live? old) (eq? (module-owner '(minibuffer)) old) (buffers:live? old-minibuf) (eq? (buffers:find " *Minibuf*") old-minibuf))
(#f #f #f #f)
> (views:buffer (view))
#<buffer *scratch*>
> (eq? (ask:line-reader) (options:default ask:line-reader))
#f
> (eq? (ask:number-reader) minibuffer:read-number)
#t
> (datums layout:buffer)
((layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 1) (buffer . "*scratch*")))) #(views:view ((view . 3) (buffer . " *Echo Area*") (depth . 90) (size . content) (locked . #t))) #(views:view ((view . 5) (buffer . " *Minibuf*") (depth . 100) (size . content) (locked . #t))))))
> (define minibuf (buffers:find " *Minibuf*"))
> (datums minibuf)
((minibuffer:%prompts ()))
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "x")
> (press! "RET")
> (result t)
"x"
> (minibuffer:history)
("x")
; Unloading undo leaves the minibuffer, which does not import it.
> (unload-owner! (module-owner '(undo)))
> (eq? (buffers:find " *Minibuf*") minibuf)
#t
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (press! "RET")
> (result t)
""
> (use-plugin undo)
