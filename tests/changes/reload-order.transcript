; A reloaded module keeps its place in the order of changes; one loaded
; again after unloading counts as loaded then.
> (import (prog))
> (import (prog2))
> (spell:language)
"prog2"
> (reload-modules! '((prog)))
> (spell:language)
"prog2"
> (unload-owner! (module-owner '(prog)))
> (spell:language)
"prog2"
> (load-module! '(prog))
#<owner (prog) 3>
> (spell:language)
"prog2"
