> (load-module! '(harpo))
; The record keeps the newest lossage:size keys and commands. Lowering
; the size drops the rest at once, so raising it brings none back.
> (set-option! lossage:size 3)
> (lossage:recent-keys)
("RET" completion:exit harpo:honk)
> (set-option! lossage:size 6)
> (lossage:recent-keys)
("RET" completion:exit harpo:honk)
> (press! "<f5>" "<f5>")
