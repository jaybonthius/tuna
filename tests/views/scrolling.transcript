; M-r asks the commanding client's page for the start of a row wholly in
; view: the middle one, then, repeated, the top and bottom ones past the
; scroll margin, counted from 0 at the top and -1 at the bottom, as
; move-to-window-line counts; with a prefix, that row.
> (define rows-asked '())
> (define (answer-row ask client name value)
    (set! rows-asked (cons (cdr (assoc "row" value)) rows-asked))
    `(("version" . 0) ("at" . (("line" . ,(+ 270 (let ([r (cdr (assoc "row" value))]) (cond [(eq? r 'null) 10] [(< r 0) (+ 20 r)] [else r]))))))))
