; A click in an empty list selects its view, as a click anywhere does.
> (mode! notes #t)
> (define nv (view))
> (press! "C-c" "l" "b")
> (define lv (car (views:showing (buffers:find "*Diagnostics notes.txt*"))))
> (list (rows lv) (eq? (view) nv))
(() #t)
> (click-in! lv '(("token" . 0)) '() 1)
> (eq? (view) lv)
#t
; With rows, a click on a row's line or severity selects the list and
; that row, and shows nothing elsewhere.
> (define source (diagnostics:make-source))
> (diagnostics:report! source notes
    (list (mark notes "beta" (diagnostics:severity warning) "vague")
          (mark notes "delta" (diagnostics:severity error) "wrong")
          (mark notes "zeta" (diagnostics:severity info) "short")))
#t
> (layout:select! nv)
> (views:set-point! nv 1)
> (click-in! lv (row-token lv 1) '() 1)
> (list (eq? (view) lv) (selected lv) (views:point nv) (pulsed? nv))
(#t 1 1 #f)
; Only the message is drawn as a link; the list and its rows are left to
; the clicks around them.
> (let ([html (drawn lv)])
    (list (and (search html (format "data-keymap=\"~a clickable\"" (mark-number diagnostics-list:link-keymap)) 0) #t)
          (search html "<ul class=\"ui-list\" data-keymap" 0)
          (search html "<li class=\"ui-list-row\" data-keymap" 0)))
(#t #f #f)
; A click on a message, with the source's view selected, selects the
; list, then goes to the row's diagnostic in the view showing the source,
; which it selects; the list stays, the place that view left is recorded,
; and the diagnostic is highlighted there for a moment.
> (layout:select! nv)
> (views:set-point! nv 1)
> (click-in! lv (row-token lv 2) (list (mark-number diagnostics-list:link-keymap)) 1)
> (list (eq? (view) nv) (views:point nv) (word notes "zeta") (and (memq lv (layout:views)) #t) (eq? (views:buffer lv) (buffers:find "*Diagnostics notes.txt*"))
        (map (lambda (p) (cons (buffers:name (car p)) (cdr p))) (jump-history:places)) (pulsed? nv))
(#t 32 32 #t #t (("notes.txt" . 1)) #t)
; The middle button goes from a message too, and elsewhere in a row only
; selects the list.
> (layout:select! nv)
> (click-in! lv (row-token lv 0) (list (mark-number diagnostics-list:link-keymap)) 2)
> (list (eq? (view) nv) (views:point nv) (word notes "beta"))
(#t 7 7)
> (click-in! lv (row-token lv 1) '() 2)
> (list (eq? (view) lv) (selected lv) (views:point nv))
(#t 1 7)
; A click below the rows selects the list and goes nowhere.
> (layout:select! nv)
> (click-in! lv `(("line" . ,(document:line (buffers:document (views:buffer lv)) (document:length (buffers:document (views:buffer lv))))) ("count" . 0)) '() 1)
> (list (eq? (view) lv) (views:point nv))
(#t 7)
