; The part sits at the bottom, locked, below the echo area.
> (datums layout:buffer)
((layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 1) (buffer . "*scratch*")))) #(views:view ((view . 3) (buffer . " *Echo Area*") (depth . 90) (size . content) (locked . #t))) #(views:view ((view . 4) (buffer . " *Minibuf*") (depth . 100) (size . content) (locked . #t))))))
; rename.sls: a command that reads its argument with a history.
> (import (rename))
> (keys:bind! keys:global "C-c r" rename:rename-buffer)
> (define notes (buffers:make "notes" "text\n"))
> (views:set-buffer! (view) notes)
> (define t (start! (lambda () (press! "C-c" "r"))))
> (type! "journal")
> (press! "RET")
> (result t)
> (buffers:name notes)
"journal"
> (rename:rename-history)
("journal")
; call-with-setup gives initial input.
> (define t (start! (lambda ()
    (minibuffer:call-with-setup
      (lambda (prompt) (minibuffer:set-input! prompt (buffers:name (views:buffer (views:current)))))
      (lambda () (minibuffer:read "Rename buffer to: "))))))
> (input)
"journal"
> (views:point (bar))
30
> (press! "RET")
> (result t)
"journal"
