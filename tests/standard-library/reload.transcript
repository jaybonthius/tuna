; Reloading a module keeps its options, hooks and tables, and other
; owners' changes to them.
> (put-version! "spell-1.sls" ".local/share/tuna/plugins/spell/spell.sls")
> (reload-modules! '((spell)))
> (put-version! "speller.sls" ".config/tuna/lib/speller.sls")
> (import (speller))
> (speller:go)
(v1 "z")
> (define held spell:language)
> (put-version! "spell-2.sls" ".local/share/tuna/plugins/spell/spell.sls")
> (reload-modules! '((spell)))
; The module that uses spell's changed macro is recompiled.
> (speller:go)
(v2 "z")
; The configuration's override, setting and removal stay.
> (spell:dictionary-path)
"/home/groucho/words"
> (list (spell:language) (eq? held spell:language))
("en-GB" #t)
> (files:after-save "x")
> (map car (owner-changes (module-owner '(spell))))
(define define define)
; A failed reload is reported, and the previous version runs again.
> (put-version! "spell-broken.sls" ".local/share/tuna/plugins/spell/spell.sls")
> (reload-modules! '((spell)))
! car: () is not a pair
> (speller:go)
(v2 "z")
> (spell:language)
"en-GB"
; Reloading files, which defines hooks, an option and a table, keeps the
; entries, settings and table entries that other modules made.
> (put-version! "spell-2.sls" ".local/share/tuna/plugins/spell/spell.sls")
> (reload-modules! '((spell)))
> (define (noted path) (display "[noted]"))
> (hooks:add! files:after-save noted)
> (tables:set! files:modes "rkt" 'racket)
> (reload-modules! '((files)))
> (files:save! "y")
[noted]
"y"
> (list (files:autosave-seconds) (tables:ref files:modes "rkt"))
(30 racket)
