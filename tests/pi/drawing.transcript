; Tool calls are folded to one line: the tool, its main argument, how
; long it took and whether it failed; while one runs, its last line of
; output shows under it.
> (say! f (update `(("type" . "toolcall_start") ("contentIndex" . 2) ("id" . "t1") ("toolName" . "bash")))
        (update `(("type" . "toolcall_end") ("contentIndex" . 2) ("toolCall" . ,(tool-block "t1" "bash" '(("command" . "make test"))))))
        (event "tool_execution_start" '("toolCallId" . "t1") '("toolName" . "bash") '("args" . (("command" . "make test"))))
        (event "tool_execution_update" '("toolCallId" . "t1") '("toolName" . "bash")
               '("partialResult" . (("content" . #((("type" . "text") ("text" . "building\nrunning 3 tests\n"))))))))
