; Each value a job emits reaches on-result as a task on the main thread,
; in order, on behalf of the code that started it; then on-end runs.
> (jobs:define-worker (match-names query emit)
    (emit (string-append "matches for " query))
    (emit (list 1 2 (vector 3))))
> (list (jobs:worker? match-names) (jobs:worker? car) match-names)
(#t #f #<worker match-names>)
> (finished match-names "spe")
(("matches for spe" (1 2 #(3))) #f)
> (jobs:define-worker (count-up n emit) (do ([i 0 (+ i 1)]) ((= i n)) (emit i)))
> (equal? (finished count-up 1000) (list (iota 1000) #f))
#t
