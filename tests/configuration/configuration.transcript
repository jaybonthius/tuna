; The configuration loads form by form as (init); a form that raises goes
; to report with the form and its position, and the next form runs.
! (boom) boom: failed (import (boom)) at line 12, char 1 of $HOME/.config/tuna/init.ss
! car: () is not a pair (car (quote ())) at line 15, char 1 of $HOME/.config/tuna/init.ss
> (list loaded-by after-error (current-owner))
(#<owner (init) 1> ran #<owner (repl) 1>)
; A module whose body raises leaves the owner (init).
> after-boom
#<owner (init) 1>
> (definition-changes spell:language)
((#<owner (init) 1> override #f) (#<owner (spell) 1> define #f))
; Its define of a module's name overrides the definition, which the
; module's own code then uses, as do the module's own internal modules.
> (spell:check "a.txt")
"mine"
> (magit:status)
mine
; The configuration and the REPL see every loaded module's names, an
; internal module's record procedures included.
> (magit/git:thing-a (magit/git:make-thing 5))
5
; A module loaded within a form is seen from the next form.
> (begin (load-module! '(magit later)) magit/later:x)
! variable magit/later:x is not bound
> magit/later:x
later-x
; At the REPL too, a define of a module's name is an override.
> (define (spell:check path) "mine")
> (define-record-type files:entry (fields a))
; A definition a macro produces is an override too, and an override is a
; procedure.
> (define-syntax define-quietly (syntax-rules () [(_ n v) (define n v)]))
> (define-quietly files:save! 'shadowed)
! override-set!: not a procedure with irritant shadowed
> files:save!
#<procedure>
; A define of a prefixed name that no loaded module exports makes a
; variable, which a define sets again.
> (define nothere:x 1)
> (define mine:x 1)
> (define mine:x 2)
> mine:x
2
; A module loaded after a top-level definition of one of its names
; replaces it.
> (define magit/extra:y 'user)
> (load-module! '(magit extra))
#<owner (magit extra) 1>
> magit/extra:y
extra-y
> (define-public (spell:check path) "mine")
