; Visiting, saving, the key bindings and the autosave example.
> (disk-checks:write-text! "~/notes.txt" "Buy milk.  \nCall Bob.")
> (files:visit "~/notes.txt")
#<buffer notes.txt>
> (define notes (files:visit "~/notes.txt"))
> (files:path notes)
"~/notes.txt"
> (files:buffer-visiting "~/notes.txt")
#<buffer notes.txt>
> (files:buffers)
(#<buffer notes.txt>)
; A before-save entry may edit the buffer; the save writes the result,
; with the final line break the configuration's option asks for.
> (define (delete-trailing-whitespace buffer)
    (let* ([doc (buffers:document buffer)] [s (document:text doc)])
      (let loop ([i (- (string-length s) 1)] [line-end #f])
        (when (>= i 0)
          (let ([c (string-ref s i)])
            (cond
              [(char=? c #\newline) (loop (- i 1) i)]
              [(and line-end (char=? c #\space))
               (let scan ([j i])
                 (if (and (> j 0) (char=? (string-ref s (- j 1)) #\space))
                     (scan (- j 1))
                     (begin
                       (buffers:replace! buffer (+ j 1) (+ i 2) "")
                       (loop (- j 1) #f))))]
              [else (loop (- i 1) #f)]))))))
> (add-hook! files:before-save delete-trailing-whitespace)
> (buffers:replace! notes 1 1 "Today: ")
#<edit 1>
> (files:modified? notes)
#t
> (files:save-buffer notes)
> (disk-checks:read-text "~/notes.txt")
"Today: Buy milk.\nCall Bob.\n"
> (files:modified? notes)
#f
> (text notes)
"Today: Buy milk.\nCall Bob.\n"
; Run by a key, a command's buffer is the current buffer.
> (buffers:replace! notes 1 1 "* ")
#<edit 4>
> (buffers:with-buffer notes (commands:run files:save-buffer))
> (disk-checks:read-text "~/notes.txt")
"* Today: Buy milk.\nCall Bob.\n"
> (map (lambda (k) (commands:command-name (table-ref keys:global k))) '("C-x C-s" "M-~" "C-x C-c"))
(files:save-buffer files:not-modified files:save-buffers-kill-tuna)
; The autosave example saves modified buffers after five seconds of
; idle, and leaves alone a file another program changed.
> (import (autosave))
> (define other (files:visit "~/other.txt"))
> (buffers:replace! notes 1 1 "+ ")
#<edit 5>
> (buffers:replace! other 1 1 "draft")
#<edit 1>
> (disk-checks:write-text! "~/other.txt" "changed elsewhere\n")
> (set-idle! #t)
> (sleep-for 5.5)
> (list (files:modified? notes) (files:modified? other))
(#f #t)
> (list (disk-checks:read-text "~/notes.txt") (disk-checks:read-text "~/other.txt"))
("+ * Today: Buy milk.\nCall Bob.\n" "changed elsewhere\n")
> (guard (c [(files:changed-on-disk-condition? c) (condition-message c)])
    (files:save-buffer other))
"another program changed the file"
> (commands:run files:save-buffers-kill-tuna)
