; While no prompt waits, the echo area draws its message.
> (echo-area:message! "Saved")
> (list (echo-area:hidden?) (echo-drawn?))
(#f #t)
; A prompt clears the echo area as it starts and takes its place: while
; it waits in the part at the bottom, the echo area draws nothing.
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (list (echo-area:current-message) (echo-area:hidden?) (echo-drawn?))
(#f #t #f)
; A message while it waits shows in brackets after the input, in its
; face, and is logged; the next typed key clears it.
> (echo-area:message! "Wrote ~a" "notes.org")
> (bracket)
"<span class=\"minibuffer-message\" role=\"status\"> [Wrote notes.org]</span>"
> (parameterize ([echo-area:face faces:warning]) (echo-area:message! "Low on disk"))
> (list (bracket) (echo-area:current-face) (last-logged))
("<span class=\"minibuffer-message\" role=\"status\" data-face=\"warning\"> [Low on disk]</span>" warning "Low on disk")
> (type! "a")
> (list (echo-area:current-message) (bracket) (input))
(#f #f "a")
; A command's error shows there too, in the error face.
> (press! "M-p")
! minibuffer:previous-history: beginning of history
> (bracket)
"<span class=\"minibuffer-message\" role=\"status\" data-face=\"error\"> [minibuffer:previous-history: beginning of history]</span>"
; The prompt's own message clears the echo area's and shows until the
; next typed key, one that edits nothing included. A message that comes
; while it shows is logged, but the prompt's own message is drawn.
> (echo-area:message! "Before")
> (minibuffer:message! (prompt) "No match")
> (list (echo-area:current-message) (bracket))
(#f "<span class=\"minibuffer-message\" role=\"status\"> [No match]</span>")
> (echo-area:message! "After")
> (list (bracket) (last-logged))
("<span class=\"minibuffer-message\" role=\"status\"> [No match]</span>" "After")
> (press! "C-a")
> (list (echo-area:current-message) (bracket))
(#f #f)
; A nested prompt clears the echo area too, and shows the messages after
; its own input; the outer one shows them again when it comes back.
> (echo-area:message! "Outer")
> (define inner (start! (lambda () (minibuffer:read "Inner: "))))
> (list (echo-area:current-message) (echo-area:hidden?))
(#f #t)
> (echo-area:message! "Inner")
> (bracket)
"<span class=\"minibuffer-message\" role=\"status\"> [Inner]</span>"
> (type! "b")
> (press! "RET")
> (result inner)
"b"
> (echo-area:message! "Back")
> (list (echo-area:hidden?) (bracket))
(#t "<span class=\"minibuffer-message\" role=\"status\"> [Back]</span>")
; Leaving the prompt with C-x o leaves it in the echo area's place.
> (press! "C-x" "o")
> (views:buffer (view))
#<buffer *scratch*>
> (echo-area:message! "Elsewhere")
> (list (echo-area:hidden?) (echo-drawn?) (bracket))
(#t #f "<span class=\"minibuffer-message\" role=\"status\"> [Elsewhere]</span>")
> (press! "C-x" "o")
; When the last prompt ends, the echo area draws again, empty, since the
; key that ended the prompt cleared it.
> (press! "RET")
> (result t)
"a"
> (list (echo-area:hidden?) (echo-drawn?) (echo-area:current-message))
(#f #t #f)
; What a command shows after reading shows in the echo area.
> (commands:define-command (greet [name (minibuffer:read "Name: ")]) "Greets NAME." (echo-area:message! "Hello, ~a" name))
> (keys:bind! keys:global "C-c g" greet)
> (define t (start! (lambda () (press! "C-c" "g"))))
> (echo-area:hidden?)
#t
> (type! "Zeppo")
> (press! "RET")
> (result t)
> (list (echo-area:hidden?) (echo-area:current-message))
(#f "Hello, Zeppo")
; A prompt in a palette leaves the echo area at the bottom, where
; messages show; only the prompt's own message shows in the palette.
> (use-plugin layout-float)
> (table-set! layout:display-rules minibuffer:buffer? layout-float:display-palette)
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (echo-area:message! "Saved")
> (list (echo-area:hidden?) (echo-drawn?) (bracket))
(#f #t #f)
> (minibuffer:message! (prompt) "No match")
> (list (echo-area:current-message) (bracket))
(#f "<span class=\"minibuffer-message\" role=\"status\"> [No match]</span>")
> (press! "C-g")
! &quit
> (result t)
(raised #<condition &quit>)
> (table-remove! layout:display-rules minibuffer:buffer?)
; Advice that keeps the echo area shown keeps messages there, and the
; prompt draws no copy of them.
> (define (keep-echo-area hidden?) #f)
> (advice-add! echo-area:hidden? keep-echo-area)
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (echo-area:message! "Saved")
> (list (echo-area:hidden?) (echo-drawn?) (bracket))
(#f #t #f)
> (press! "C-g")
! &quit
> (advice-remove! echo-area:hidden? keep-echo-area)
; A prompt whose part is removed while it waits gives the echo area back.
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (echo-area:hidden?)
#t
> (layout:delete-part! (layout:view-node (bar)))
> (echo-area:hidden?)
#f
> (in-client (lambda () (commands:run minibuffer:abort)))
! &quit
> (result t)
(raised #<condition &quit>)
; The keys that ran a command that prompts are not echoed again once the
; prompt is answered.
> (set-option! echo-area:echo-keystrokes 0.2)
> (commands:define-command (ask-name) "Reads a name." (minibuffer:read "Name: "))
> (keys:bind! keys:global "C-x r" ask-name)
> (press! "C-x")
> (sleep-for 0.4)
> (echo-area:keys-text client)
"C-x-"
> (define t (start! (lambda () (press! "r"))))
> (type! "abc")
> (press! "RET")
> (sleep-for 0.1)
> (list (prompt) (echo-area:keys-text client))
(#f #f)
; Unloading the minibuffer takes its advice back.
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (echo-area:hidden?)
#t
> (unload-module! '(minibuffer))
! &quit
> (echo-area:hidden?)
#f
