; M-% reads the text and its replacement, then asks about each match:
; y and SPC replace, n and DEL skip, ! replaces the rest.
> (define b (show "r" "foo bar foo Foo FOO foo\n"))
> (start! "M-%")
> (type! "foo")
> (press! "RET")
> (prompt)
> (type! "baz")
> (press! "RET")
> (asked)
> (press! "y")
> (asked)
> (press! "n")
> (asked)
> (press! "SPC" "DEL")
> (asked)
> (press! "!")
> (list (text) (last-message) (session))
#f
(4 "Query replacing foo with baz: (? for help) " "foo")
(12 "Query replacing foo with baz: (? for help) " "foo")
(16 "Query replacing foo with Baz: (? for help) " "Foo")
(24 "Query replacing foo with baz: (? for help) " "foo")
("baz bar foo Baz FOO baz\n" "Replaced 3 occurrences" #f)
; . replaces and ends; q and RET end.
> (define b (show "r2" "a1 a2 a3 a4\n"))
> (replace! "M-%" "a" "b")
> (press! ".")
> (list (text) (session) (last-message))
> (views:set-point! (view) 1)
> (replace! "M-%" "")
> (asked)
> (press! "q")
> (list (text) (session))
> (views:set-point! (view) 1)
> (replace! "M-%" "")
> (press! "RET")
> (session)
("b1 a2 a3 a4\n" #f "Replaced 1 occurrence")
(5 "Query replacing a with b: (? for help) " "a")
("b1 a2 a3 a4\n" #f)
#f
; , replaces and stays on the replacement; the next answer goes on
; without replacing it again.
> (views:set-point! (view) 1)
> (replace! "M-%" "")
> (press! ",")
> (list (text) (asked))
> (press! "y")
> (list (text) (asked))
> (press! "q")
("b1 b2 a3 a4\n" (5 "Query replacing a with b: (? for help) " "b"))
("b1 b2 a3 a4\n" (8 "Query replacing a with b: (? for help) " "a"))
; ^ goes back to the previous match without undoing it; a replaced one
; shows its replacement, which the next answer passes.
> (define c (show "r3" "x1 x2 x3 x4\n"))
> (replace! "M-%" "x" "y")
> (press! "n" "y")
> (asked)
> (press! "^")
> (asked)
> (press! "^")
> (asked)
> (press! "y")
> (list (text) (asked))
> (press! "y")
> (list (text) (asked))
> (press! "q")
(8 "Query replacing x with y: (? for help) " "x")
(5 "Query replacing x with y: (? for help) " "y")
(2 "Query replacing x with y: (? for help) " "x")
("y1 y2 x3 x4\n" (8 "Query replacing x with y: (? for help) " "x"))
("y1 y2 y3 x4\n" (11 "Query replacing x with y: (? for help) " "x"))
; u takes back the last replacement and asks about it again; U takes
; back all of them.
> (define d (show "r4" "x1 x2 x3\n"))
> (replace! "M-%" "x" "y")
> (press! "y" "y")
> (list (text) (asked))
> (press! "u")
> (list (text) (asked) (replace:session-count (session)))
> (press! "y" "y")
> (list (text) (session))
> (define d (show "r5" "x1 x2 x3\n"))
> (replace! "M-%" "x" "y")
> (press! "y" "n")
> (press! "U")
> (list (text) (asked) (replace:session-count (session)))
> (press! "q")
("y1 y2 x3\n" (8 "Query replacing x with y: (? for help) " "x"))
("y1 x2 x3\n" (5 "Query replacing x with y: (? for help) " "x") 1)
("y1 y2 y3\n" #f)
("x1 x2 x3\n" (2 "Query replacing x with y: (? for help) " "x") 0)
; ? shows the answers until the next key.
> (define h (show "r6" "x1 x2\n"))
> (replace! "M-%" "x" "y")
> (press! "?")
> (prompt)
> (press! "n")
> (prompt)
> (press! "q")
"y or SPC replace, n or DEL skip, ! all, . replace and exit, , replace and show, ^ back, u undo, U undo all, e edit replacement, E edit exactly, C-r edit, C-w delete and edit, q or RET exit"
"Query replacing x with y: (? for help) "
; A key the keymap does not bind ends the session and then runs.
> (views:set-point! (view) 1)
> (replace! "M-%" "x" "y")
> (press! "C-f")
> (list (session) (point) (text))
(#f 3 "x1 x2\n")
; C-g ends the session and quits.
> (views:set-point! (view) 1)
> (replace! "M-%" "x" "y")
> (press! "y" "C-g")
> (list (session) (text))
! &quit
(#f "y1 x2\n")
