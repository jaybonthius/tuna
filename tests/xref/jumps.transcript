; Every jump records the place it leaves, so M-, returns there and C-M-,
; comes back to where M-, started.
> (define v (view))
> (define (line! n) (views:set-point! v (document:line-start (buffers:document (views:buffer v)) n)))
; M-< and M->; a second M-< at the start records no second place.
> (line! 3)
> (press! "M-<")
> (list (here) (places))
(("a.txt" 1) (("a.txt" 3)))
> (press! "M-<")
> (places)
(("a.txt" 3))
> (press! "M-,")
> (here)
("a.txt" 3)
> (press! "C-M-,")
> (here)
("a.txt" 1)
> (press! "M->")
> (list (here) (car (places)))
(("a.txt" 6) ("a.txt" 1))
; M-g g, which runs jump-history:after-jump too.
> (line! 3)
> (define jumped '())
> (define (note-jump v) (set! jumped (cons (views:point v) jumped)))
> (add-hook! jump-history:after-jump note-jump)
> (define t (start! (lambda () (press! "M-g" "g"))))
> (type! "5")
> (press! "RET")
> (result t)
> (length jumped)
1
> (remove-hook! jump-history:after-jump note-jump)
> (press! "M-,")
> (here)
("a.txt" 3)
> (press! "C-M-,")
> (here)
("a.txt" 5)
; M-s l.
> (line! 3)
> (define t (start! (lambda () (press! "M-s" "l"))))
> (type! "four")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (here)
("a.txt" 4)
> (press! "M-,")
> (here)
("a.txt" 3)
; M-s r to a line of the file shown.
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "five")
> (wait-matches s)
> (press! "RET")
> (result t)
> (here)
("a.txt" 5)
> (press! "M-,")
> (here)
("a.txt" 3)
; C-x b; its preview records nothing.
> (define defs (files:visit (string-append code "/defs.txt")))
> (define before (places))
> (define t (start! (lambda () (press! "C-x" "b"))))
> (press! "C-n")
> (press! "C-g")
! &quit
> (result t)
> (equal? (places) before)
#t
> (define t (start! (lambda () (press! "C-x" "b"))))
> (type! "defs.txt")
> (press! "RET")
> (result t)
> (here)
("defs.txt" 1)
> (press! "M-,")
> (here)
("a.txt" 3)
> (press! "C-M-,")
> (here)
("defs.txt" 1)
> (press! "M-,")
; C-x C-f.
> (define t (start! (lambda () (press! "C-x" "C-f"))))
> (press! "C-a" "C-k")
> (type! (string-append code "/uses.txt"))
> (press! "RET")
> (result t)
> (here)
("uses.txt" 1)
> (press! "M-,")
> (here)
("a.txt" 3)
; C-x d, a listing's RET and ^.
> (define t (start! (lambda () (press! "C-x" "d"))))
> (press! "RET")
> (result t)
> (buffers:name (views:buffer v))
"~/notes/"
> (press! "M-,")
> (here)
("a.txt" 3)
> (press! "C-M-,")
> (buffers:name (views:buffer v))
"~/notes/"
> (press! "RET")
> (here)
("a.txt" 3)
> (press! "M-,")
> (buffers:name (views:buffer v))
"~/notes/"
> (press! "^")
> (buffers:name (views:buffer v))
"~/"
> (press! "M-,")
> (buffers:name (views:buffer v))
"~/notes/"
> (press! "RET")
; M-g f reads the buffer's diagnostics grouped by severity, most severe
; first; e SPC narrows to errors. It goes to the one chosen, and M-,
; returns.
> (buffers:with-buffer notes (set-option-local! diagnostics:mode #t))
> (define source (diagnostics:make-source))
> (define (on-line n severity message)
    (diagnostics:make-diagnostic (cons n 0) #f severity message))
> (diagnostics:report! source notes
    (list (on-line 2 (diagnostics:severity warning) "two is vague") (on-line 4 (diagnostics:severity error) "four is wrong")
          (on-line 5 (diagnostics:severity info) "five is fine")))
#t
> (line! 1)
> (define t (start! (lambda () (press! "M-g" "f"))))
> (define s (session))
> (wait-matches s)
> (map (lambda (m) (list (completion:title s m) (completion:text s m))) (match-list s))
(("Errors" "a.txt:4: four is wrong") ("Warnings" "a.txt:2: two is vague") ("Infos" "a.txt:5: five is fine"))
> (type! "e ")
> (wait-matches s)
> (texts s)
("a.txt:4: four is wrong")
> (press! "RET")
> (result t)
> (here)
("a.txt" 4)
> (press! "M-,")
> (here)
("a.txt" 1)
; C-u M-g f reads the project's, from files no buffer visits too.
> (define uses (files:visit (string-append code "/uses.txt")))
> (in-client (lambda () (layout:switch-to-buffer uses)))
> (buffers:with-buffer uses (set-option-local! diagnostics:mode #t))
> (diagnostics:report! source uses (list (diagnostics:make-diagnostic '(2 . 4) #f (diagnostics:severity warning) "average is slow")))
#t
> (diagnostics:report! source (string-append code "/sub/twice.txt") (list (diagnostics:make-diagnostic '(2 . 4) #f (diagnostics:severity error) "total twice")))
#t
> (define t (start! (lambda () (press! "C-u" "M-g" "f"))))
> (define s (session))
> (wait-matches s)
> (texts s)
("twice.txt:2: total twice" "uses.txt:2: average is slow")
> (press! "RET")
> (result t)
> (here)
("twice.txt" 2)
> (press! "M-,")
> (here)
("uses.txt" 1)
> (in-client (lambda () (layout:switch-to-buffer notes)))
> (diagnostics:clear! source)
> (press! "M-g" "f")
! diagnostic-picker:diagnostic: No diagnostics
; M-< in a prompt records nothing: the prompt's buffer is internal, so
; M-, never shows it in an ordinary view.
> (define before (places))
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "abc")
> (press! "M-<")
> (equal? (places) before)
#t
> (press! "C-g")
! &quit
> (result t)
(raised #<condition &quit>)
