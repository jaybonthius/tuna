; The mode: parent prog:mode, its keymap and hook, lighter "Scheme";
; its hook runs after prog's.
> (list (tables:ref modes:parents chez-scheme:mode) (modes:lighter chez-scheme:mode)
        (eq? (tables:ref modes:keymaps chez-scheme:mode) chez-scheme:keymap)
        (eq? (tables:ref modes:hooks chez-scheme:mode) chez-scheme:mode-hook))
(prog:mode "Scheme" #t #t)
> (define order '())
> (hooks:add! prog:mode-hook (lambda () (set! order (cons 'prog order))))
> (hooks:add! chez-scheme:mode-hook (lambda () (set! order (cons 'scheme order))))
> (define first (scheme-buffer "first.ss" ""))
> (reverse order)
(prog scheme)
; Files by name, and by the program a first line names.
> (disk:folder! "~/src")
> (define (mode-of name content)
    (disk:write-text! (string-append "~/src/" name) content)
    (modes:major-mode (files:visit (string-append "~/src/" name))))
> (map (lambda (name) (mode-of name "")) '("a.sls" "a.ss" "a.sps" "a.scm" "a.sch" "a.sld" "a.txt"))
(chez-scheme:mode chez-scheme:mode chez-scheme:mode chez-scheme:mode chez-scheme:mode chez-scheme:mode modes:fundamental)
