; Keymaps at the primary cursor: its layers' by priority, then the kinds
; of the nodes holding it, innermost first.
> (import (keyed))
> (define k (buffers:make "k" (keyed:box '() (keyed:field '() "abc\n"))))
> (define kv (views:make k))
> (buffers:add-span! (buffers:layer k keyed:links) 2 4 'link)
> (buffers:add-span! (buffers:layer k keyed:plain) 2 4 'plain)
> (views:keymaps kv)
(link-keys field-keys box-keys)
> (views:set-point! kv 5)
> (views:keymaps kv)
(field-keys box-keys)
; A span's own keymap comes before its layer type's; a span of the same
; layer without one leaves the key to the layer's.
> (define-table own-keys)
> (buffers:add-span! (buffers:layer k keyed:links) 2 3 (list (cons 'keymap own-keys)))
> (views:set-point! kv 2)
> (let ([ks (views:keymaps kv)]) (list (eq? (car ks) own-keys) (cdr ks)))
(#t (link-keys field-keys box-keys))
> (views:set-point! kv 3)
> (views:keymaps kv)
(link-keys field-keys box-keys)
> (views:set-point! kv 5)
; set-buffer! shows another buffer at its last point, here that of the
