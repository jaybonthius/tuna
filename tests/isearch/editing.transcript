; M-e reads the text in the minibuffer; the search's keymap is off
; meanwhile, so characters it binds edit the prompt.
> (define b (show "e" "Foo bar foo baz Bar\n"))
> (press! "C-s" "b" "a")
> (start! "M-e")
> (keys:prompt client)
> (press! "z" "C-s")
> (here)
> (start! "M-e")
> (press! "DEL" "DEL" "DEL" "f" "o" "o" "C-r")
> (here)
#f
(16 "I-search: baz" "baz")
(9 "I-search backward: foo" "foo")
; A quit in the prompt puts the keymap back and runs isearch:abort.
> (start! "M-e")
> (press! "C-g")
> (here)
! &quit
(1 #f #f)
; With no text typed, RET reads the text and searches once.
> (views:set-point! (view) 1)
> (start! "C-s" "RET")
> (press! "b" "a" "z" "RET")
> (list (point) (keys:prompt client))
(16 #f)
; M-r in the prompt picks a past search with completion.
> (views:set-point! (view) 1)
> (press! "C-s" "q")
> (start! "M-e")
> (minibuffer:input (minibuffer:current-prompt))
> (press! "C-g")
> (press! "C-g")
"q"
! &quit
! &quit
