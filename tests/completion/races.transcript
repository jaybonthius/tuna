; Unloading completion-list during a read takes its list away and leaves
; the read going; the configuration loads a new instance, whose keys move
; through the read's matches.
> (define t (start! (lambda () (completion:read "Item: " (list (completion:source (candidates (vector "a" "b")))) h))))
> (unload-owner! (module-owner '(completion-list)))
> (datums minibuf)
((minibuffer:%prompts () (minibuffer:prompt ((depth . 1)) (minibuffer:question () "Item: ") (minibuffer:input-field ()) "\n" (minibuffer:content ()))))
> (press! "C-n" "RET")
> (result t)
"b"
> (use-plugin completion-list)
; A storm of quits while reads over a job start, match and end: no
; session, prompt or list is left behind.
> (define stop #f)
> (define askers
    (map (lambda (i)
           (spawn-task (lambda (restore) (let loop ([n 0])
                 (unless (or stop (= n 100))
                   (guard (c [#t #f])
                     (in-client (lambda () (completion:read "Storm: " (list (completion:source (candidates items))) h))))
                   (loop (+ n 1)))))))
         (iota 3)))
> (define typer
    (spawn-task (lambda (restore) (let loop ([n 0])
          (unless (= n 200)
            (guard (c [#t #f]) (press! (string (string-ref "0123456789" (mod n 10)))))
            (when (= (mod n 3) 0) (for-each (lambda (t) (cancel-task t (make-message-condition "q"))) askers))
            (timers:sleep 0.002)
            (loop (+ n 1)))))))
> (testing:wait-until (lambda () (eq? (task-state typer) 'done)))
> (set! stop #t)
> (for-each (lambda (t) (cancel-task t (make-message-condition "q"))) askers)
> (testing:wait-until (lambda () (for-all testing:done? askers)))
> (for-all testing:done? askers)
#t
