> (http:wait-for-server)
Tuna is at http://127.0.0.1:PORT/
> (define (title-of html)
    (let* ([start (http:search html "<title" 0)] [end (http:search html "</title>" start)])
      (substring html start (+ end 8))))
; A page served before any screen is titled with the program's name.
> (define p (http:page))
> (title-of (http:page-html p))
"<title id=\"tuna-title\">Tuna</title>"
; A screen given with another title morphs the page's title, without
; reloading; the same title again sends nothing, whatever the screen.
> (http:connect! p)
> (define c (car (web:clients)))
> (web:send-screen! c (haml (:p "one")) "notes.org - Tuna")
> (http:take p 2)
((datastar-patch-elements ("elements" "<title id=\"tuna-title\">notes.org - Tuna</title>")) (screen 1 0 "<p>one</p>"))
> (http:confirm! p 1)
204
> (web:send-screen! c (haml (:p "two")) "notes.org - Tuna")
> (http:show (http:next p))
(screen 2 0 "<p>two</p>")
> (http:confirm! p 2)
204
; A new title goes even when the screen is the one last sent, and its
; text is escaped.
> (web:send-screen! c (haml (:p "two")) "<a> & b")
> (http:show (http:next p))
(datastar-patch-elements ("elements" "<title id=\"tuna-title\">&lt;a&gt; &amp; b</title>"))
> (http:next p 0.2)
timeout
; Each client has its own title.
> (define q (http:page))
> (http:connect! q)
> (define d (car (remq c (web:clients))))
> (web:send-screen! d (haml (:p "two")) "mail - Tuna")
> (http:take q 2)
((datastar-patch-elements ("elements" "<title id=\"tuna-title\">mail - Tuna</title>")) (screen 1 0 "<p>two</p>"))
> (http:next p 0.2)
timeout
; A page carries the title of the first screen drawn for it, as a
; display that draws after each batch gives them.
> (advice-add! batch-ended
    (lambda (ended)
      (ended)
      (for-each (lambda (client) (web:send-screen! client (haml (:p "drawn")) "drawn - Tuna")) (web:clients))))
> (title-of (http:page-html (http:page)))
"<title id=\"tuna-title\">drawn - Tuna</title>"
; The title is checked.
> (web:send-screen! c (haml (:p "x")) 'title)
! web:send-screen!: not a string with irritant title
