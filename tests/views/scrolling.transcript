; A report that is not one is refused, as is one with a negative
; distance or a measure no browser lays out, before it changes anything.
> ((table-ref web:input-handlers "scroll") phone '(("type" . "scroll") ("view" . 1)))
! views: not a scroll report with irritant (("type" . "scroll") ("view" . 1))
> (define (refused? . overrides)
    (guard (c [(assertion-violation? c) (condition-message c)])
      (apply report! phone v 150 0 #t overrides)))
> (list (refused? '("spacerDistance" . -1)) (refused? '("offset" . 1e300)) (refused? '("lineHeight" . 0))
        (refused? '("height" . 1000000000000)) (refused? '("top" . (("line" . 0)))))
("not a scroll report" "not a scroll report" "not a scroll report" "not a scroll report" "not a scroll report")
