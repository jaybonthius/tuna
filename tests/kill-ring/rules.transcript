> (kill-ring:append! (list "!"))
> (kill-ring:text (kill-ring:current))
"<two.\nThre+Answer here.!"
; A part refused after others went in takes them back out: the buffer
; and its spans are as they were.
> (define (one-line? node edit) (not (memv #\newline (string->list (document:text (buffers:piece-document (buffers:edit-inserted edit)))))))
> (buffers:define-kind field (consent one-line?))
> (buffers:define-kind form (content nodes))
> (define f (buffers:make "f" '(form () (field () "xy"))))
> (buffers:add-span! (buffers:layer f responses) 3 4 'gpt)
> (define three-parts (car (begin (kill-ring:push! (list "abc")) (kill-ring:append! (list (buffers:piece t 11 23))) (kill-ring:append! (list (buffers:piece w 6 17))) (kill-ring:current))))
> (list (raised (lambda () (kill-ring:insert! f 3 three-parts))) (root f) (spans-of f responses) (buffers:version f))
((buffers:insert! "the node refuses the edit") (form () (field () "xy")) (("y" gpt)) 5)
> (kill-ring:insert! f 3 (car (begin (kill-ring:push! (list "abc")) (kill-ring:append! (list (buffers:piece t 11 23))) (kill-ring:current))))
((3 . 18))
