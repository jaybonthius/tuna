(import (chezscheme) (tuna-test) (tuna core changes) (tuna core modules)
        (except (tuna core main-thread) exit) (tuna options) (tuna scopes)
        (only (tuna hooks) add-hook! remove-hook!))

(define (raised-message thunk)
  (guard (c [#t (if (message-condition? c) (condition-message c) c)]) (thunk) #f))

(define (in-thread thunk)
  (let ([result #f])
    (thread-join (fork-thread (lambda () (set! result (thunk)))))
    result))

(define (local-values owner)
  (filter (lambda (change) (eq? (car change) 'local-value)) (module-changes owner)))

(define-option level 0 fixnum?)

(define (tests)
  (test "other threads read whole values while the main thread changes them"
    (let ([s (make-scope)] [stop? #f] [mutex (make-mutex)] [seen '()])
      (define (reader scope)
        (fork-thread
          (lambda ()
            (parameterize ([current-scope scope])
              (let loop ([values '()])
                (if stop?
                    (with-mutex mutex (set! seen (append values seen)))
                    (loop (let ([v (level)]) (if (memv v values) values (cons v values))))))))))
      (let ([readers (list (reader #f) (reader #f) (reader s) (reader s))])
        (do ([i 0 (+ i 1)]) ((= i 20000))
          (set-option! level (fxmod i 10))
          (parameterize ([current-scope s])
            (set-option-local! level (fx+ 100 (fxmod i 10)))
            (when (fxeven? i) (remove-option-local! level)))
          (as-module '(init) (set-option! level (fx+ 200 (fxmod i 10))))
          (when (fxeven? i) (as-module '(init) (remove-option! level))))
        (set! stop? #t)
        (for-each thread-join readers))
      (check (for-all (lambda (v) (and (fixnum? v) (or (< v 10) (<= 100 v 109) (<= 200 v 209)))) seen))
      (check (memv 0 seen))
      (check (exists (lambda (v) (<= 100 v 109)) seen))
      (as-module '(init) (remove-option! level))
      (parameterize ([current-scope s]) (remove-option-local! level))
      (remove-option! level)))

  (test "a binding holds only on its own thread; a thread forked in it starts with none"
    (set-option! level 3)
    (with-options ([level 7])
      (check-equal? 7 (level))
      (check-equal? 3 (in-thread level))
      (check-equal? '(4 3)
        (in-thread (lambda () (list (with-options ([level 4]) (level)) (level)))))
      (check-equal? 3 (in-thread (lambda () (in-thread level))))
      (check-equal? '(tuna) (in-thread (lambda () (current-owner))))
      (check-equal? 7 (level))
      (with-options ([level 8])
        (check-equal? 8 (level)))
      (check-equal? 7 (level)))
    (check-equal? 3 (in-thread level))
    (let ([m (make-mutex)] [c (make-condition)] [state 'start] [read-there #f])
      (define (wait-for s) (with-mutex m (let loop () (unless (eq? state s) (condition-wait c m) (loop)))))
      (define (move-to s) (with-mutex m (set! state s) (condition-broadcast c)))
      (let ([t (fork-thread
                 (lambda ()
                   (with-options ([level 9])
                     (move-to 'bound)
                     (wait-for 'read)
                     (set! read-there (level)))))])
        (wait-for 'bound)
        (check-equal? 3 (level))
        (move-to 'read)
        (thread-join t)
        (check-equal? 9 read-there)))
    (remove-option! level))

  (test "only the main thread changes options"
    (let ([s (make-scope)])
      (for-each
        (lambda (thunk) (check-equal? "only the main thread makes changes" (in-thread (lambda () (raised-message thunk)))))
        (list (lambda () (set-option! level 5))
              (lambda () (remove-option! level))
              (lambda () (parameterize ([current-scope s]) (set-option-local! level 5)))
              (lambda () (define-option elsewhere 1 fixnum?) elsewhere)))
      (check-equal? '() (option-settings level))
      (check-equal? '() (module-changes '(repl)))))

  (test "a collected scope's local values and their changes are forgotten"
    (let ([kept (list (make-scope) (make-scope))])
      (let ([dropped (map (lambda (i) (make-scope)) (iota 200))])
        (for-each (lambda (s i) (parameterize ([current-scope s]) (set-option-local! level i)))
                  dropped (iota 200))
        (for-each (lambda (s) (parameterize ([current-scope s]) (set-option-local! level 1))) kept)
        (check-equal? 202 (length (local-values '(repl)))))
      (do ([i 0 (+ i 1)]) ((= i 3)) (collect (collect-maximum-generation)))
      (parameterize ([current-scope (car kept)]) (set-option-local! level 2))
      (check-equal? 2 (length (local-values '(repl))))
      (check-equal? '(2 1)
        (map (lambda (s) (parameterize ([current-scope s]) (level))) kept))
      (for-each (lambda (s) (parameterize ([current-scope s]) (remove-option-local! level))) kept)
      (check-equal? '() (module-changes '(repl)))))

  (test "moving a module before its importers notifies of the setting it brings into effect"
    (let ([seen '()])
      (define (note o v) (set! seen (cons v seen)))
      (rank-module! '(earlier-lib) #t)
      (rank-module! '(later-lib) #t)
      (as-module '(earlier-lib) (set-option! level 1))
      (as-module '(later-lib) (set-option! level 2))
      (add-hook! option-changed note)
      (move-before-importers! '(later-lib))
      (check-equal? '(1) seen)
      (check-equal? 1 (level))
      (remove-hook! option-changed note)
      (take-back-changes! '(earlier-lib) '())
      (take-back-changes! '(later-lib) '())))

  (test "a quit never leaves a setting half made"
    (let ([s (make-scope)] [changing? #f] [quits-while-changing 0])
      (define (burn n) (if (fx= n 0) 0 (fx+ 1 (burn (fx- n 1)))))
      (do ([i 0 (+ i 1)]) ((= i 3000))
        (guard (c [(quit-condition? c)
                   (when changing? (set! quits-while-changing (+ quits-while-changing 1)))])
          (burn (random 1500))
          (request-quit!)
          (set! changing? #t)
          (do ([j 0 (fx+ j 1)]) ((fx= j 10))
            (set-option! level j)
            (parameterize ([current-scope s])
              (set-option-local! level j)
              (remove-option-local! level))
            (as-module '(init) (set-option! level j))
            (remove-option! level))
          (set! changing? #f)
          (let loop () (loop))))
      (check (> quits-while-changing 500))
      (for-each (lambda (owner) (take-back-changes! owner '())) '((repl) (init)))
      (check-equal? '() (option-settings level))
      (check-equal? 0 (parameterize ([current-scope s]) (level)))
      (check-equal? '() (module-changes '(repl)))
      (check-equal? '() (module-changes '(init)))))

  (test "option-local? is whether the current scope holds a value of its own"
    (let ([s (make-scope)])
      (check-equal? #f (option-local? level))
      (parameterize ([current-scope s])
        (check-equal? #f (option-local? level))
        (set-option-local! level (option-setting level))
        (check-equal? #t (option-local? level))
        (with-options ([level 7]) (check-equal? #t (option-local? level)))
        (check-equal? #t (in-thread (lambda () (parameterize ([current-scope s]) (option-local? level)))))
        (remove-option-local! level)
        (check-equal? #f (option-local? level))
        (with-options ([level 7]) (check-equal? #f (option-local? level))))
      (check-equal? "not an option" (raised-message (lambda () (option-local? 'level))))
      (check-equal? '() (module-changes '(repl))))))

(post! (lambda ()
         (tests)
         (test-exit)))
(run-main-loop)
