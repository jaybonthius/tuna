; The browser tab names the selected view's buffer, as Emacs's
; frame-title-format does; layout sends the title with each client's
; screen after each batch.
> (define c1 (web:add-client! 1))
> (web:client-title c1)
"*Pager* - Tuna"
> (define notes (buffers:make "notes" "one\n"))
> (layout:switch-to-buffer notes)
> (web:client-title c1)
"notes - Tuna"
; Selecting another view, or renaming the buffer, changes it, for every
; client.
> (define mail (buffers:make "mail" "Dear Harpo,\n"))
> (define v (layout:display-buffer mail))
> (web:client-title c1)
"notes - Tuna"
> (layout:select! v)
> (define c2 (web:add-client! 2))
> (list (web:client-title c1) (web:client-title c2))
("mail - Tuna" "mail - Tuna")
> (buffers:rename! mail "sent")
> (web:client-title c1)
"sent - Tuna"
; layout:page-title makes the title from the buffer's name.
> (set-option! layout:page-title (lambda (name) (string-append name " – Emacs")))
> (web:client-title c1)
"sent – Emacs"
> (remove-option! layout:page-title)
> (web:client-title c1)
"sent - Tuna"
; A page-title that raises costs the pages their title, not their
; screens: it is reported once, and every client shows the program's name.
> (set-option! layout:page-title (lambda (name) (car '())))
! car: () is not a pair
> (sleep-for 0)
> (sleep-for 0)
> (list (web:client-title c1) (web:client-title c2) (substring (web:client-screen c1) 0 26))
("Tuna" "Tuna" "<div class=\"layout-screen\"")
> (remove-option! layout:page-title)
> (web:client-title c1)
"sent - Tuna"
; So does one that returns what is not a string.
> (set-option! layout:page-title (lambda (name) 42))
! layout:page-title: returned what is not a string with irritant 42
> (sleep-for 0)
> (sleep-for 0)
> (list (web:client-title c1) (web:client-title c2))
("Tuna" "Tuna")
> (remove-option! layout:page-title)
> (web:client-title c1)
"sent - Tuna"
