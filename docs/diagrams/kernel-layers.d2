# What is in the kernel, and what sits on top of it?
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: down

classes: {
  kernel: {
    style: {
      fill: "#e8eaf6"
      stroke: "#283593"
      font-color: "#1a237e"
      border-radius: 8
      stroke-width: 3
      font-size: 18
    }
  }
  layer: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 18
    }
  }
}

legend: |md
  **Status:** built (kernel cleanup finished 2026-10-12). Arrows mean "is built on".

  Only the bottom box is fixed; everything above it can be replaced.
|

plugins: "Plugins (Tuna's own and yours)\nkeys and commands, buffers, minibuffer,\nwindows, renderer, browser connection,\nsession saving, ..." {class: layer}
contracts: "Contracts\nwhat a slot promises:\ntext store, buffers, keys, renderer,\nwindows, settings, session" {class: layer}
libraries: "Shared libraries\ntimers, background jobs" {class: layer}
kernel: "Kernel (fixed)\n1. plugins: turn on, turn off, undo, swap\n2. the editor thread: tasks, C-g, the input queue\n3. hooks and IDs\n4. the slots it calls: input, display, messages" {class: kernel}

plugins -> contracts
plugins -> libraries
contracts -> libraries: "the buffers contract\nuses background jobs"
contracts -> kernel
libraries -> kernel
