; A stream gets each new prefix on the main thread and the end-of-file
; object when the session ends; its session is busy from each prefix
; until it says done.
> (define prefixes '())
> (define stream-emit #f)
> (define (letters emit)
    (set! stream-emit emit)
    (lambda (prefix) (set! prefixes (cons prefix prefixes))))
