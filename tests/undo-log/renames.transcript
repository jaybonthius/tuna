; A rename moves the renamed file's log, so a renamed buffer's unsaved
; edits stay kept and the next visit of the new path finds them.
> (checks:write-text! "~/a.txt" "alpha\n")
> (define a (files:visit "~/a.txt"))
> (buffers:replace! a 1 1 "1 ")
#<edit 1>
> (testing:wait-until (lambda () (checks:exists? (checks:log-of "~/a.txt"))))
> (files:rename-file "~/a.txt" "~/b.txt")
> (testing:wait-until (lambda () (checks:exists? (checks:log-of "~/b.txt"))))
> (list (buffers:name a) (files:path a) (checks:exists? (checks:log-of "~/a.txt")) (checks:exists? (checks:log-of "~/b.txt")))
("b.txt" "$HOME/b.txt" #f #t)
> (exists (lambda (entry) (entry a)) (hooks:entries files:unsaved-kept))
#t
> (buffers:replace! a 1 1 "2 ")
#<edit 2>
> (testing:wait-until (lambda () (= (length (checks:log-records "~/b.txt")) 5)))
> (map car (checks:log-records "~/b.txt"))
(undo-history group saved at group)
; Renaming a folder moves the logs of the files under it, also of a file
; no buffer visits.
> (mkdir (string-append (getenv "HOME") "/f"))
> (checks:write-text! "~/f/c.txt" "c\n")
> (define c (files:visit "~/f/c.txt"))
> (buffers:replace! c 1 1 "x")
#<edit 1>
> (testing:wait-until (lambda () (checks:exists? (checks:log-of "~/f/c.txt"))))
> (buffers:kill! c)
#t
> (files:rename-file "~/f" "~/g")
> (testing:wait-until (lambda () (checks:exists? (checks:log-of "~/g/c.txt"))))
> (list (checks:exists? (checks:log-of "~/f/c.txt")) (checks:exists? (checks:log-of "~/g/c.txt")))
(#f #t)
; Its history comes back with the file under the new path, the killed
; edit a redo away.
> (define g (files:visit "~/g/c.txt"))
> (buffers:with-buffer g (undo:redo 1))
> (text g)
"xc\n"
; A rename replaces only a file or an empty folder on any file system, so
; across file systems a folder is not merged into one that holds files,
; and the logs of the files it holds stay with them.
> (define other (format "/dev/shm/tuna-undo-log-~a" (get-process-id)))
> (define keep-path (string-append other "/dst/keep.txt"))
> (mkdir other)
> (mkdir (string-append other "/dst"))
> (checks:write-text! keep-path "keep\n")
> (define keep (files:visit keep-path))
> (buffers:replace! keep 1 1 "k")
#<edit 1>
> (testing:wait-until (lambda () (checks:exists? (checks:log-of keep-path))))
> (mkdir (string-append (getenv "HOME") "/src"))
> (checks:write-text! "~/src/one.txt" "one\n")
> (define one (files:visit "~/src/one.txt"))
> (buffers:replace! one 1 1 "1")
#<edit 1>
> (testing:wait-until (lambda () (checks:exists? (checks:log-of "~/src/one.txt"))))
> (raised (lambda () (files:rename-file "~/src" (string-append other "/dst") (file-options no-fail))))
(files:rename-file "another buffer visits the file")
> (buffers:kill! keep)
#t
> (raised (lambda () (files:rename-file "~/src" (string-append other "/dst") (file-options no-fail))))
(files:rename-file "failed for ~/src: directory not empty")
> (list (files:path one) (checks:exists? "~/src/one.txt") (checks:exists? keep-path)
        (checks:exists? (checks:log-of "~/src/one.txt")) (checks:exists? (checks:log-of keep-path)))
("$HOME/src/one.txt" #t #t #t #t)
> (define kept (files:visit keep-path))
> (buffers:with-buffer kept (undo:redo 1))
> (text kept)
"kkeep\n"
> (buffers:kill! kept)
#t
> (files:delete-file other)
; A rename onto a file with a log deletes that log, whether or not the
; renamed file has one, since its file is no longer there.
> (checks:write-text! "~/logged.txt" "logged\n")
> (define logged (files:visit "~/logged.txt"))
> (buffers:replace! logged 1 1 "2 ")
#<edit 1>
> (testing:wait-until (lambda () (checks:exists? (checks:log-of "~/logged.txt"))))
> (buffers:kill! logged)
#t
> (checks:write-text! "~/plain.txt" "plain\n")
> (files:rename-file "~/plain.txt" "~/logged.txt" (file-options no-fail))
> (testing:wait-until (lambda () (not (checks:exists? (checks:log-of "~/logged.txt")))))
> (list (checks:exists? (checks:log-of "~/logged.txt")) (checks:read-text "~/logged.txt"))
(#f "plain\n")
> (define plain (files:visit "~/logged.txt"))
> (list (text plain) (buffers:modified? plain))
("plain\n" #f)
