; runs:environment takes processes' rule for a variable, so a name
; processes would refuse is refused when it is set.
> (set-option! runs:environment '(("A=B" . "x")))
! set-option!: (("A=B" . "x")) is not a valid value for runs:environment
> (set-option! runs:environment '(("" . "x")))
! set-option!: (("" . "x")) is not a valid value for runs:environment
; The program starts before the buffer is made or emptied, so whatever
; processes refuses leaves no buffer, or the run's buffer as it was, and
; the name free for the next run.
> (runs:start-for-user "*r*" (list "printf" "a\x0;b") home)
! processes:start-for-user: not a list of strings free of NUL characters with irritant ("a\x0;b")
> (buffers:find "*r*")
#f
> (define b (runs:start-for-user "*r*" "echo kept" home))
> (ended? b)
0
> (runs:start-for-user "*r*" (list "printf" "a\x0;b") home)
! processes:start-for-user: not a list of strings free of NUL characters with irritant ("a\x0;b")
> (list (output b) (runs:status b) (runs:command b))
("kept" 0 "echo kept")
> (define b (runs:start-for-user "*r*" "echo next" home))
> (ended? b)
0
> (output b)
"next"
; runs:start raises for the clauses of processes:options it does not
; honour: a run joins standard error, has no terminal and keeps its log
; whole.
> (runs:start-for-user "*c*" "true" (processes:options [separate-stderr #t]))
! runs:start-for-user: options other than a directory and an environment with irritant #<processes:options>
> (runs:start "*c*" "true" (processes:options [terminal (cons 24 80)]))
! runs:start: options other than a directory and an environment with irritant #<processes:options>
> (runs:start "*c*" "true" (processes:options [full-log (processes:full-log drop)]))
! runs:start: options other than a directory and an environment with irritant #<processes:options>
> (buffers:find "*c*")
#f
; A file buffer's folder is its file's: the entry runs adds to
; files:directory-finders answers only for a run's buffer.
> (mkdir (string-append (getenv "HOME") "/src"))
> (define file (files:visit "~/src/a.txt"))
> (map (lambda (entry) (entry file)) (hook-entries files:directory-finders))
("$HOME/src/" #f)
> (files:directory file)
"$HOME/src/"
