; A list holds one atom per row, all of one datum for the rows of one
; call to ui:set-rows!: row i is the atom i + 1 positions after the
; list's start, and the selected row is the one at point.
> (define b (buffers:make "*rows*" (ui:list '())))
> (define (lst) (document:token (buffers:document b) 0))
> (define chosen '())
> (define (choose i) (set! chosen (cons i chosen)))
> (define (number-row i) (ui:label (number->string i)))
> (define (generations) (map (lambda (a) (cdr (assq 'generation (vector-ref a 1)))) (cddr (car (datums b)))))
> (define (selected) (ui:selected-row (lst) (view)))
> (show! b)
> (ui:set-rows! b (lst) 5 number-row choose)
> (generations)
(0 0 0 0 0)
