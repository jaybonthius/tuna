; Browser key items as the page script sends them.
> (import (json))
> (define (key k code . modifiers)
    (keys:item-key `(("type" . "key") ("key" . ,k) ("code" . ,code) ("modifiers" . ,(list->vector modifiers)))))
> (keys:item-key (string->json "{\"type\":\"key\",\"key\":\"g\",\"code\":\"KeyG\",\"modifiers\":[\"control\"],\"quit\":true,\"client\":\"c1\",\"seq\":7}"))
"C-g"
; Control, Alt as Meta, super; shift is in a character and S- on a named key.
> (list (key "x" "KeyX" "control") (key "X" "KeyX" "control" "shift") (key "_" "Minus" "shift")
        (key "_" "Minus" "control" "shift") (key "?" "Slash" "control" "shift") (key "x" "KeyX" "alt")
        (key "X" "KeyX" "alt" "shift") (key "a" "KeyA" "super") (key "é" "KeyE") (key "-" "Minus" "control"))
("C-x" "C-X" "_" "C-_" "C-?" "M-x" "M-X" "s-a" "é" "C--")
> (list (key "ArrowLeft" "ArrowLeft" "super" "shift" "alt" "control") (key "F1" "F1" "shift")
        (key "Tab" "Tab" "shift") (key " " "Space" "shift") (key " " "Space" "control"))
("C-M-S-s-<left>" "S-<f1>" "S-TAB" "S-SPC" "C-SPC")
> (map (lambda (k) (key k k))
    '("Enter" " " "Tab" "Escape" "Backspace" "Delete" "Insert" "ArrowLeft" "ArrowRight" "ArrowUp"
      "ArrowDown" "Home" "End" "PageUp" "PageDown" "F1" "F12" "ContextMenu" "AudioVolumeUp"))
("RET" "SPC" "TAB" "ESC" "DEL" "<delete>" "<insert>" "<left>" "<right>" "<up>" "<down>" "<home>" "<end>" "<prior>" "<next>" "<f1>" "<f12>" "<contextmenu>" "<audiovolumeup>")
; AltGraph types the browser's character, with the Control and Alt some
; systems report beside it.
> (list (key "@" "KeyQ" "alt-graph") (key "€" "KeyE" "control" "alt" "alt-graph")
        (key "{" "Digit7" "alt-graph" "shift"))
("@" "€" "{")
; An Option key that its option makes Meta gives M- and the US key at the
; code; otherwise it types the browser's character. The configuration
; leaves the right Option to typing.
> (list (keys:left-option-meta?) (keys:right-option-meta?))
(#t #f)
> (list (key "≈" "KeyX" "left-option") (key "˛" "KeyX" "left-option" "shift") (key "⁄" "Digit1" "left-option" "shift")
        (key "–" "Minus" "left-option") (key "Ú" "Semicolon" "left-option" "shift") (key " " "Space" "left-option")
        (key "ArrowLeft" "ArrowLeft" "left-option") (key "Dead" "KeyE" "left-option") (key "ƒ" "KeyF" "control" "left-option")
        (key "¡" "IntlBackslash" "left-option") (key "∑" "KeyW" "left-option" "super"))
("M-x" "M-X" "M-!" "M--" "M-:" "M-SPC" "M-<left>" "M-e" "C-M-f" "M-¡" "M-s-w")
> (list (key "≈" "KeyX" "right-option") (key "Dead" "KeyE" "right-option") (key "≈" "KeyX" "left-option" "right-option"))
("≈" "<dead>" "M-x")
> (set-option! keys:left-option-meta? #f keys:right-option-meta? #t)
> (list (key "≈" "KeyX" "left-option") (key "≈" "KeyX" "right-option") (key "≈" "KeyX" "left-option" "right-option"))
("≈" "M-x" "M-x")
> (remove-option! keys:left-option-meta? keys:right-option-meta?)
> (list (keys:left-option-meta?) (keys:right-option-meta?))
(#t #f)
; Items the page script would not send.
> (raised (lambda () (key "x" "KeyX" "meta")))
(keys:item-key "not a modifier name")
> (raised (lambda () (keys:item-key '(("type" . "key") ("key" . "x") ("code" . "KeyX") ("modifiers" . #(control))))))
(keys:item-key "not a modifier name")
> (raised (lambda () (keys:item-key '(("type" . "key") ("code" . "KeyX") ("modifiers" . #())))))
(keys:item-key "an item without a key")
> (raised (lambda () (keys:item-key '(("type" . "key") ("key" . "x") ("code" . "KeyX") ("modifiers" . ("control"))))))
(keys:item-key "an item without a list of modifiers")
> (map (lambda (item) (raised (lambda () (keys:item-key item)))) '("x" (1 2)))
((keys:item-key "not an item") (keys:item-key "not an item"))
> (map (lambda (k) (raised (lambda () (key k "")))) '("" "ab cd" "a-b" "👍🏽"))
((keys:item-key "not a key") (keys:item-key "not a key") (keys:item-key "not a key") (keys:item-key "not a key"))
> (key "👍" "")
"👍"
; Every key item-key gives is one valid key.
> (define (valid? k) (not (pair? (raised (lambda () (keys:lookup (layout:current-frame) k))))))
> (for-all valid?
    (list (key "≈" "KeyX" "left-option") (key "ArrowLeft" "ArrowLeft" "super" "shift" "alt" "control")
          (key "Dead" "KeyE" "right-option") (key "👍" "") (key "<" "Comma" "control" "shift")
          (key "F1" "F1" "shift") (key "\\" "Backslash" "alt") (key "~" "Backquote" "shift" "super")))
#t
; The page script is in the web plugin's scripts, beside this plugin.
> (table-ref web:scripts 'keys)
"keys/keys.js"
> (file-exists? (string-append (getenv "TUNA_LIBRARY") "/keys/keys.js"))
#t
