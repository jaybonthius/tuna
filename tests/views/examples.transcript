> (table-set! views:span-properties 'tag (lambda (v) (list (cons "data-tag" v))))
> (buffers:define-layer tags)
> (buffers:add-span! (buffers:layer notes tags) 3 8 '((tag . "when") (face . bold)))
> (show right)
