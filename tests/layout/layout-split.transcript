; A child's size, along its split, takes the place of its weight: a
; fraction of the split, columns or lines, or its content's size. Across
; the split it means nothing.
> (define (flexes)
    (let ([s (html->string (layout:screen c1))])
      (let loop ([i 0] [acc '()])
        (cond
          [(> (+ i 5) (string-length s)) (reverse acc)]
          [(string=? (substring s i (+ i 5)) "flex:")
           (let end ([j (+ i 5)])
             (if (char=? (string-ref s j) #\") (loop j (cons (substring s (+ i 5) j) acc)) (end (+ j 1))))]
          [else (loop (+ i 1) acc)]))))
