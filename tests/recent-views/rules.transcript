; s-o goes back to the view selected before, by the plugin's own ticks:
; a view gets a tick once it has stayed selected for recent-views:delay
; seconds, or when a press follows another command.
> (options:set! recent-views:delay 0.5)
> (define (named name) (views:make (buffers:make name "")))
> (define a (named "a"))
> (define b (named "b"))
> (define c (named "c"))
> (buffers:replace! layout:buffer 1 (- (document:length (buffers:document layout:buffer)) 1)
    (document:from-datum (layout-split:container '((direction . row)) (atom a) (atom b) (atom c))))
#<edit 1>
> (layout:select! a)
> (press! "C-x" "o")
> (pause!)
> (press! "C-x" "o")
> (pause!)
> (selected)
"c"
; Pressed once it goes back; after the delay, the delay ended the cycle,
; so pressed again it goes back again: it toggles two views.
> (press! "s-o")
> (selected)
"b"
> (pause!)
> (press! "s-o")
> (selected)
"c"
> (pause!)
; Pressed again within the delay it goes on through the cycle, each view
; once, then starts a new one.
> (define (press-and-see!) (press! "s-o") (selected))
> (let* ([x (press-and-see!)] [y (press-and-see!)] [z (press-and-see!)]) (list x y z))
("b" "a" "c")
> (pause!)
; The views a quick run of C-x o passes get no tick: only where it
; stops does. From c, C-x o C-x o passes a and stops at b, so s-o goes
; back to c, not to a.
> (press! "C-x" "o" "C-x" "o")
> (selected)
"b"
> (pause!)
> (press! "s-o")
> (selected)
"c"
> (pause!)
; With a prefix argument, the view selected least recently: a, which
; was only passed.
> (press! "C-u" "s-o")
> (selected)
"a"
> (pause!)
; Another command between two presses ends the cycle and ticks the view
; selected then.
> (press! "s-o")
> (selected)
"c"
> (press! "C-x" "o")
> (selected)
"a"
> (press! "s-o")
> (selected)
"c"
; The delay is a finite number of seconds, as a timer takes.
> (define (raised thunk) (guard (c [#t (condition-message c)]) (thunk)))
> (raised (lambda () (options:set! recent-views:delay +inf.0)))
"+inf.0 is not a valid value for recent-views:delay"
