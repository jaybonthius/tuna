> (define notes (buffers:make "notes" "one\ntwo\n"))
> (define todo (buffers:make "todo" "three\n"))
> (views:set-buffer! (view) notes)
> (import (magit))
> (define (merges) (magit:merges))
> (transient:arguments magit:merge-menu)
()
; A menu's arguments start from its option, read in the menu's view, each
; time it shows; a buffer's local value applies.
> (options:set! magit:merge-arguments '("--no-ff"))
> (buffers:with-buffer todo (options:set-local! magit:merge-arguments '("--ff-only")))
> (press! "C-c" "m")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "*--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (press! "C-g")
> (views:set-buffer! (view) todo)
> (press! "C-c" "m")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "*--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (press! "C-g")
> (views:set-buffer! (view) notes)
> (options:unset! magit:merge-arguments)
; Outside a chosen command, transient:arguments gives the option's value.
> (transient:arguments magit:merge-menu)
()
; A switch puts its argument in or takes it out; of an incompatible set,
; one is in at a time.
> (press! "C-c" "m" "-" "f")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "*--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (press! "-" "n")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "*--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (press! "-" "n")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
; A member of an incompatible set ending in = stands for that argument
; with any value.
> (transient:define-menu strategies "A menu of strategies." (incompatible ("--strategy=" "--ff-only")))
> (transient:add! strategies #f (transient:switch "f" "Fast-forward only" "--ff-only")
    (transient:valued-switch "s" "Strategy" "--strategy=" (lambda (question) "ours")))
> (in-client (lambda () (transient:show! strategies)))
> (press! "f" "s")
> (menu)
((("f" "Fast-forward only" "--ff-only") ("s" "Strategy" "*--strategy=ours")))
> (press! "f")
> (menu)
((("f" "Fast-forward only" "*--ff-only") ("s" "Strategy" "--strategy=")))
> (press! "C-g")
; A valued switch reads its value with its reader, asking its
; description and ": ", and puts in the argument and the value.
> (define t (start! (lambda () (press! "-" "s"))))
> (minibuffer:input-start (minibuffer:current-prompt))
15
> (document:text (buffers:document (buffers:find " *Minibuf*")))
"Strategy: \n"
; While the command chosen waits, the menu stays open and takes no keys:
; they go to the prompt; a click on an entry warns and does nothing.
> (press! "m")
> (minibuffer:input (minibuffer:current-prompt))
"m"
> (memq magit:merge-menu (keys:active-keymaps client))
#f
> (click-entry! "- f")
! a command chosen in a menu is running
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (press! "DEL" "o" "u" "r" "s" "RET")
> (result t)
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "*--strategy=ours")) ("Actions" ("m" "Merge")))
; While it has a value, its key takes it out.
> (press! "-" "s")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
; An empty answer puts in nothing; C-g quits the prompt, and the switch
; keeps its value, here none.
> (define t (start! (lambda () (press! "-" "s"))))
> (press! "RET")
> (result t)
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (define t (start! (lambda () (press! "-" "s"))))
> (press! "C-g")
! &cancelled
> (result t)
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (press! "-" "f")
; The command chosen reads the arguments set when it was chosen; the menu
; has closed.
> (press! "m")
> (list (merges) (menu))
((("--ff-only")) ())
; Arguments are a menu's while it shows: a menu above it leaves them as
; they are, and they start again at the next showing.
> (transient:define-menu inner "An inner menu." (title "Inner"))
> (commands:define-command (show-inner) "Shows the inner menu." (transient:show! inner))
> (transient:add! magit:merge-menu "Other" (transient:staying-command "i" "Inner" show-inner))
> (press! "C-c" "m" "-" "f" "i")
> (menu)
("Inner")
> (press! "C-g")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "*--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")) ("Other" ("i" "Inner")))
> (press! "C-g" "C-c" "m")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")) ("Other" ("i" "Inner")))
> (press! "C-g")
; argument-value gives a valued argument's value.
> (transient:argument-value '("--ff-only" "--strategy=ours") "--strategy=")
"ours"
> (transient:argument-value '("--ff-only") "--strategy=")
#f
> (raised (lambda () (transient:argument-value '(1) "--strategy=")))
(transient:argument-value "not a list of strings")
> (raised (lambda () (transient:argument-value '() 'strategy)))
(transient:argument-value "not a string")
> (press! "C-g")
; When this plugin unloads while a valued switch's prompt waits, the
; command chosen quits, and the prompt goes.
> (press! "C-c" "m")
> (define t (start! (lambda () (press! "-" "s"))))
> (unload-owner! (module-owner '(transient)))
! &cancelled
> (result t)
> (list (popups) (minibuffer:current-prompt))
((layout:popups-root ()) #f)
> (press! "o" "RET")
