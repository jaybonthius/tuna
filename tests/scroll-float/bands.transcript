; Each end of a strip is a band. Past an end with columns the strip does
; not wholly show, the band is a button on the nearest of them, labelled
; with its title and how many more lie past it, holding a card for each,
; up to three; an end with nothing past it is an empty band.
> (define desktop (web:add-client! 1))
> (define (bands client)
    (let ([html (screen-of client)])
      (let loop ([from 0] [acc '()])
        (let ([i (search html "class=\"strip-edge " from)])
          (if i
              (let* ([side (substring html (+ i 18) (search html "\"" (+ i 18)))]
                     [button? (string=? (substring html (- i 7) i) "button ")]
                     [close (search html (if button? "</button>" "</div>") i)]
                     [label (let ([l (search html "aria-label=\"" i)])
                              (and button? l (< l close) (substring html (+ l 12) (search html "\"" (+ l 12)))))]
                     [cards (let count ([f i] [n 0])
                              (let ([k (search html "strip-edge-card" f)])
                                (if (and k (< k close)) (count (+ k 1) (+ n 1)) n)))])
                (loop close (cons (list side label cards) acc)))
              (reverse acc))))))
> (define vs (map (lambda (name) (views:make (buffers:make name (lines name 20)))) '("a" "b" "c" "d" "e")))
> (define (id name) (views:id (list-ref vs (- (char->integer (string-ref name 0)) 97))))
> (set-parts! (apply layout-scroll:container '() (map (lambda (v) (atom v '(size . 1/2))) vs)))
> (layout:select! (list-ref vs 2))
; Before a client reports, the columns drawn on each side of the focused
; one stand in for those wholly in view, so the bands are empty.
> (bands desktop)
(("start" #f 0) ("end" #f 0))
; The strip shows c whole with b and d cut on either side: each cut
; column counts, so each band holds two cards.
> (strip-report-whole! desktop (map id '("b" "c" "d")) (map id '("c")))
> (bands desktop)
(("start" "b, and 1 more" 2) ("end" "d, and 1 more" 2))
; At the strip's start the start band is empty, and the end band holds
; the three columns past c.
> (strip-report-whole! desktop (map id '("a" "b")) (map id '("a" "b")))
> (bands desktop)
(("start" #f 0) ("end" "c, and 2 more" 3))
; A fourth column past the end adds to the count but not to the cards.
> (strip-report-whole! desktop (map id '("a" "b")) (map id '("a")))
> (bands desktop)
(("start" #f 0) ("end" "b, and 3 more" 3))
; A column wider than the strip is never wholly shown; the focused column
; stands in for it.
> (strip-report-whole! desktop (map id '("c")) '())
> (bands desktop)
(("start" "b, and 1 more" 2) ("end" "d, and 1 more" 2))
; A band names its column's positions, as a placeholder does, so a click
; on it selects that column.
> (let ([html (screen-of desktop)])
    (let ([i (search html "<button class=\"strip-edge start\"" 0)])
      (substring html i (search html ">" i))))
"<button class=\"strip-edge start\" type=\"button\" tabindex=\"-1\" aria-label=\"b, and 1 more\" data-at=\"3\" data-to=\"4\""
; The box around the scroller and its bands carries the strip's
; direction and the classes layout gives the part.
> (let* ([html (screen-of desktop)] [i (search html "<div class=\"layout-strip-box" 0)]) (substring html i (search html ">" i)))
"<div class=\"layout-strip-box row focus-path\""
> (set-parts! (apply layout-scroll:container '((direction . column)) (map (lambda (v) (atom v '(size . 1/2))) vs)))
> (and (search (screen-of desktop) "<div class=\"layout-strip-box column" 0) #t)
#t
