; Renames, copies, mode changes, new, deleted and binary files.
> (define many (diff:parse (string->utf8 (string-append
    "diff --git a/old.txt b/new.txt\nsimilarity index 100%\nrename from old.txt\nrename to new.txt\n"
    "diff --git a/c.txt b/d.txt\nsimilarity index 90%\ncopy from c.txt\ncopy to d.txt\nindex 1..2 100644\n--- a/c.txt\n+++ b/d.txt\n@@ -1 +1 @@\n-c\n+d\n"
    "diff --git a/run.sh b/run.sh\nold mode 100644\nnew mode 100755\n"
    "diff --git a/link b/link\nold mode 100644\nnew mode 120000\n"
    "diff --git a/n.txt b/n.txt\nnew file mode 100644\nindex 0000000..3b18e51\n--- /dev/null\n+++ b/n.txt\n@@ -0,0 +1 @@\n+hello\n"
    "diff --git a/g.txt b/g.txt\ndeleted file mode 100644\nindex 3b18e51..0000000\n--- a/g.txt\n+++ /dev/null\n@@ -1 +0,0 @@\n-hello\n"
    "diff --git a/x.bin b/x.bin\nindex 1..2 100644\nBinary files a/x.bin and b/x.bin differ\n"))))
> (map summary many)
(("old.txt" "new.txt" renamed #f #f 0) ("c.txt" "d.txt" copied #f #f 1) ("run.sh" "run.sh" modified #f #f 0) ("link" "link" type-changed #f #f 0) (#f "n.txt" added #f #f 1) ("g.txt" #f deleted #f #f 1) ("x.bin" "x.bin" modified #t #f 0))
> (map (lambda (f) (list (diff:file-old-mode f) (diff:file-new-mode f))) many)
((#f #f) ("100644" "100644") ("100644" "100755") ("100644" "120000") (#f "100644") ("100644" #f) ("100644" "100644"))
; The no-newline marker is a flag of the line before it.
> (lines-of (car (diff:file-hunks (car (diff:parse (string->utf8 "diff --git a/f b/f\n--- a/f\n+++ b/f\n@@ -1,2 +1,2 @@\n a\n-b\n\\ No newline at end of file\n+B\n\\ No newline at end of file\n"))))))
((context " " #vu8(97) #f) (removed "-" #vu8(98) #t) (added "+" #vu8(66) #t))
; A CR before the LF is part of the line.
> (lines-of (car (diff:file-hunks (car (diff:parse (string->utf8 "diff --git a/f b/f\n--- a/f\n+++ b/f\n@@ -1 +1 @@\n-a\r\n+b\r\n"))))))
((removed "-" #vu8(97 13) #f) (added "+" #vu8(98 13) #f))
; git C-quotes a path holding a control byte, " or \; a name holding a
; space ends in a TAB git adds, which is no part of the path.
> (define quoted (diff:parse (string->utf8 (string-append
    "diff --git \"a/tab\\there.txt\" \"b/tab\\there.txt\"\n--- \"a/tab\\there.txt\"\n+++ \"b/tab\\there.txt\"\n@@ -1 +1 @@\n-a\n+b\n"
    "diff --git a/my file.txt b/my file.txt\n--- a/my file.txt\t\n+++ b/my file.txt\t\n@@ -1 +1 @@\n-a\n+b\n"
    "diff --git \"a/caf\\351.txt\" \"b/caf\\351.txt\"\nold mode 100644\nnew mode 100755\n"))))
