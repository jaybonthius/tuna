; Each end has its footer, in faces:success, faces:warning or
; faces:error, and reaches runs:ended and the echo area.
> (define (end-of line) (let ([b (runs:start-for-user "*end*" line home)]) (ended? b) (list (runs:status b) (message))))
> (end-of "exit 2")
(2 "*end* exited with code 2")
> (end-of "kill -9 $$")
(-9 "*end* ended by signal 9")
> (show (buffers:find "*end*"))
Run started at TIME in ~/

kill -9 $$

Run ended by signal 9 at TIME
> (map caddr (spans (buffers:find "*end*")))
(((face . error)))
