; Heading levels take Modus's six heading colours.
> (map (lambda (n) (modus-colour-of (format "--faces-markup-heading-~a-color" n) 'light)) '(1 2 3 4 5 6))
("#000000" "#574316" "#193668" "#721045" "#2a5045" "#7f0000")
> (map (lambda (n) (modus-colour-of (format "--faces-markup-heading-~a-color" n) 'dark)) '(1 2 3 4 5 6))
("#ffffff" "#d2b580" "#82b0ec" "#feacd0" "#88ca9f" "#ef8386")
; Modus's two options are undeclared, so off is unspecified: a face that
; reads one with no fallback takes the weight or slant around it. Faces
; whose bold Modus clears read normal when the option is off; Modus's
; always-bold faces read the bold weight's token.
> (list (modus-declares? "--modus-bold-constructs") (modus-declares? "--modus-italic-constructs"))
(#f #f)
