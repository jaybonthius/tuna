; The modus theme registers its file as the theme.
> (use-plugin modus)
> (table-ref web:stylesheets 'theme #f)
"modus/modus.css"
; Its palette is Modus's: 109 named colours and 39 of Modus's mappings,
; each a pair of the operandi-tinted and the vivendi-tinted value.
> (length modus-colours)
148
> (malformed-modus-colours)
()
> (cdr (assoc "--modus-bg-main" modus-colours))
"light-dark(#fbf7f0, #0d0e1c)"
> (cdr (assoc "--modus-cursor" modus-colours))
"light-dark(#d00000, #ff66ff)"
; It sets every colour among the semantic tokens, ten faces and six
; components' colours, and reads only its own palette.
> (list (length modus-mapping) (left-to-design-tokens) (unknown-in-theme) (unset-by-modus))
(69 () () ())
> (filter (lambda (d) (not (prefix? "--tuna-" (car d)))) modus-mapping)
(("--faces-comment-color" . "var(--modus-comment)") ("--faces-string-color" . "var(--modus-string)") ("--faces-number-color" . "var(--modus-number)") ("--faces-keyword-color" . "var(--modus-keyword)") ("--faces-function-color" . "var(--modus-fnname)") ("--faces-builtin-color" . "var(--modus-builtin)") ("--faces-type-color" . "var(--modus-type)") ("--faces-constant-color" . "var(--modus-constant)") ("--faces-markup-heading-color" . "var(--modus-fg-heading-1)") ("--faces-markup-raw-color" . "var(--modus-fg-prose-code)") ("--minibuffer-prompt-color" . "var(--modus-fg-prompt)") ("--echo-area-prompt-color" . "var(--modus-fg-prompt)") ("--completion-match-0-color" . "var(--modus-fg-completion-match-0)") ("--completion-match-1-color" . "var(--modus-fg-completion-match-1)") ("--completion-match-2-color" . "var(--modus-fg-completion-match-2)") ("--completion-match-3-color" . "var(--modus-fg-completion-match-3)") ("--layout-part-mode-color" . "var(--modus-magenta-cooler)") ("--rainbow-delimiters-depth-1-color" . "var(--modus-fg-main)") ("--rainbow-delimiters-depth-2-color" . "var(--modus-magenta-intense)") ("--rainbow-delimiters-depth-3-color" . "var(--modus-cyan-intense)") ("--rainbow-delimiters-depth-4-color" . "var(--modus-red-warmer)") ("--rainbow-delimiters-depth-5-color" . "var(--modus-yellow-intense)") ("--rainbow-delimiters-depth-6-color" . "var(--modus-magenta-cooler)") ("--rainbow-delimiters-depth-7-color" . "var(--modus-green-intense)") ("--rainbow-delimiters-depth-8-color" . "var(--modus-blue-warmer)") ("--rainbow-delimiters-depth-9-color" . "var(--modus-magenta-warmer)") ("--which-key-key-color" . "var(--modus-keybind)") ("--which-key-label-color" . "var(--modus-type)"))
; Contrast under the theme, light then dark. Text is at least Modus's
; 7:1 on the page, the popup surface, the chrome, the active bar and the
; selection, and on the region in light; Modus's own values for the
; region in dark, dim text and the inactive bar meet 4.5:1.
> (map (lambda (bg) (theme-contrast "text" bg)) '("surface" "surface-raised" "chrome" "bar" "selected" "region"))
((19.66 19.15) (18.08 17.78) (14.48 13.0) (11.09 8.29) (13.23 9.09) (11.15 6.91))
> (map (lambda (fg) (theme-contrast fg "surface")) '("link" "error" "text-muted" "text-faint"))
((7.01 8.08) (7.5 6.41) (6.56 6.64) (6.56 6.64))
> (list (theme-contrast "text-muted" "chrome") (theme-contrast "on-bar-inactive" "bar-inactive"))
((4.83 4.51) (5.07 4.54))
; A link is under 4.5:1 on the selection in dark, so a match on the
; selected row takes the row's text colour.
> (theme-contrast "link" "selected")
(4.72 3.83)
; The faces of any-order's components meet Modus's 7:1 on the page, but
; some fall under 4.5:1 on the selection in dark, so a match on the
; selected row takes the row's text colour there too.
> (define (modus-contrast fg bg)
    (map (lambda (mode)
           (let ([colour (lambda (name)
                           (let ([pair (hex-colours (cdr (assoc (string-append "--modus-" name) modus-colours)))])
                             (hex->linear (if (eq? mode 'dark) (cadr pair) (car pair)))))])
             (/ (round (* 100 (contrast (colour fg) (colour bg)))) 100.0)))
         '(light dark)))
> (map (lambda (k) (let ([fg (format "fg-completion-match-~a" k)]) (list (modus-contrast fg "bg-main") (modus-contrast fg "bg-completion")))) '(0 1 2 3))
(((9.77 8.79) (6.58 4.17)) ((8.11 9.15) (5.46 4.35)) ((7.02 12.23) (4.72 5.81)) ((7.5 9.92) (5.05 4.71)))
; Focus meets 3:1 on the active bar and on the page; then come the
; split's rule, and the chrome against the islands, above 1.20:1.
> (list (theme-contrast "focus" "bar") (theme-contrast "focus" "surface") (theme-contrast "border" "surface") (theme-contrast "chrome" "surface"))
((3.95 3.5) (7.01 8.08) (2.72 3.29) (1.36 1.47))
; A strip's edge cards, bordered in the strong border on the chrome,
; meet WCAG's 3:1 for graphics.
> (theme-contrast "border-strong" "chrome")
(5.22 4.45)
; Turning the theme off takes its file back.
> (unload-module! '(modus))
> (table-ref web:stylesheets 'theme #f)
#f
