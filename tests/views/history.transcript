; A view keeps its state in each buffer it showed: views:set-buffer!
; puts the buffer it leaves at the front of its previous buffers, and a
; buffer shown again comes back with its cursors, scroll position, folds
; and narrowing.
> (define (raised thunk) (guard (c [#t (list (condition-who c) (condition-message c))]) (thunk)))
> (define (names bs) (map buffers:name bs))
> (define a (buffers:make "a" (lines 40)))
> (define b (buffers:make "b" (lines 40)))
> (define c (buffers:make "c" (lines 40)))
> (define v (views:make a))
> (views:set-point! v 30)
> (views:set-mark! v 20)
> (views:fold! v 50 60)
> (views:narrow! v 10 100)
> (views:scroll-to! v 40 (views:align top))
> (views:set-buffer! v b)
> (list (views:point v) (views:folded? v 55) (names (views:previous-buffers v)))
(1 #f ("a"))
> (views:set-buffer! v a)
> (list (views:point v) (views:mark v) (views:folded? v 55) (call-with-values (lambda () (views:bounds v)) list))
(30 20 #t (10 100))
> (placement v desktop)
(new top 6)
> (names (views:previous-buffers v))
("b")
; The kept positions follow edits made while the buffer is not shown.
> (views:set-buffer! v c)
> (buffers:replace! a 1 1 "xyz")
#<edit 1>
> (views:set-buffer! v a)
> (list (views:point v) (views:mark v))
(33 23)
; A second view of a buffer has its own place there.
> (define w (views:make b))
> (views:set-point! w 7)
> (views:set-buffer! w a)
> (list (views:point v) (views:point w))
(33 33)
> (views:set-point! w 12)
> (views:set-buffer! w b)
> (views:set-buffer! w a)
> (list (views:point v) (views:point w))
(33 12)
; A view that never showed a buffer shows it at its last point: while
; views show it, the point of the one where point moved last.
> (views:set-point! v 50)
> (views:last-point a)
50
> (views:set-point! w 18)
> (views:last-point a)
18
> (define u (views:make c))
> (views:set-buffer! u a)
> (views:point u)
18
; Else the point the last view to leave it left there.
> (views:drop! u)
> (views:set-buffer! w c)
> (views:set-buffer! v c)
> (views:last-point a)
50
> (views:set-last-point! a 70)
> (define x (views:make b))
> (views:set-buffer! x a)
> (views:point x)
70
> (raised (lambda () (views:set-last-point! a 100000)))
(views:set-last-point! "not a position in the buffer")
; An internal buffer has no last point and is never in a history.
> (define inner (buffers:make " inner" "i\n"))
> (views:set-buffer! x inner)
> (views:set-point! x 2)
> (views:set-buffer! x a)
> (list (views:last-point inner) (names (views:previous-buffers x)))
(#f ("b"))
; views:previous-buffer! and views:next-buffer! follow Emacs's
; switch-to-prev-buffer and switch-to-next-buffer: the view's previous
; buffers newest first, then the buffer list from its far end, then the
; next buffers; the buffer left goes to the front of the next buffers.
> (define p1 (buffers:make "p1" "1\n"))
> (define p2 (buffers:make "p2" "2\n"))
> (define p3 (buffers:make "p3" "3\n"))
> (define h (views:make p1))
> (views:set-buffer! h p2)
> (views:set-buffer! h p3)
> (names (views:previous-buffers h))
("p2" "p1")
> (names (list (views:previous-buffer! h) (views:previous-buffer! h)))
("p2" "p1")
> (names (views:previous-buffers h))
("p2" "p3")
> (names (list (views:next-buffer! h) (views:next-buffer! h)))
("p2" "p3")
; Past its next buffers it goes on to the buffers it never showed, the
; one used most recently first.
> (buffers:name (views:next-buffer! h))
"a"
; Past its own history it goes through the buffer list from the end,
; the buffer used least recently first, never an internal buffer.
> (define lone (views:make (buffers:make "lone" "l\n")))
> (buffers:move-to-front! c)
> (buffers:move-to-front! b)
> (buffers:move-to-front! a)
> (buffers:move-to-back! b)
> (buffers:name (views:previous-buffer! lone))
"b"
; A buffer a view showed leaves its history when it is killed, and a
; killed buffer's view shows its own previous buffer.
> (views:set-buffer! h p1)
> (buffers:kill! p3)
#t
> (names (views:previous-buffers h))
("a" "p2")
> (buffers:kill! p1)
#t
> (buffers:name (views:buffer h))
"a"
; views:skipped-buffer-predicate passes over buffers for a reason.
> (options:set! views:skipped-buffer-predicate
    (lambda (view buffer reason)
      (and (eq? reason (views:switch-reason previous)) (string=? (buffers:name buffer) "b"))))
> (define s (views:make a))
> (views:set-buffer! s b)
> (views:set-buffer! s c)
> (buffers:name (views:previous-buffer! s))
"a"
> (views:set-buffer! s b)
> (views:set-buffer! s c)
> (buffers:kill! c)
#t
> (buffers:name (views:buffer s))
"b"
> (options:unset! views:skipped-buffer-predicate)
; views:replace-buffer! shows the newest previous buffer and drops the
; one the view showed from its history; with nothing to show it leaves
; the view as it was.
> (define r (views:make (buffers:make "r1" "r\n")))
> (views:set-buffer! r b)
> (buffers:name (views:replace-buffer! r))
"r1"
> (memq b (views:previous-buffers r))
#f
> (define only (buffers:make " only" "o\n"))
> (define q (views:make only))
> (options:with ([views:skipped-buffer-predicate (lambda (view buffer reason) #t)]) (views:replace-buffer! q))
#f
> (buffers:name (views:buffer q))
" only"
; A preview shows a buffer as views:set-buffer! would, and its end puts
; back the buffer, the state and the history.
> (define pv (views:make a))
> (views:set-buffer! pv b)
> (views:set-point! pv 2)
> (views:preview-buffer! pv a)
> (views:preview-buffer! pv (buffers:find "r1"))
> (views:end-preview! pv)
> (list (buffers:name (views:buffer pv)) (views:point pv) (names (views:previous-buffers pv)))
("b" 2 ("a"))
> (views:end-preview! pv)
; A view's element keeps its size when it shows another buffer, so its
; size stays known until the browser measures again, as a display that
; follows a preview needs.
> (define sized (views:make (buffers:make "sized" (lines 50))))
> (report! desktop sized 1 0 #t)
> (call-with-values (lambda () (views:body-size sized desktop)) list)
(80 20)
> (views:set-buffer! sized a)
> (call-with-values (lambda () (views:body-size sized desktop)) list)
(80 20)
; A preview changes no buffer's last point: while another view shows the
; buffer previewed, its point stays the last point.
> (define b2 (buffers:make "b2" (lines 40)))
> (define text-view (views:make b2))
> (views:set-point! text-view 5)
> (views:set-buffer! text-view a)
> (define help-view (views:make b2))
> (views:set-point! help-view 30)
> (define before (list (views:last-point b2) (views:last-point a)))
> before
(30 18)
> (views:preview-buffer! text-view b2)
> (views:point text-view)
5
> (views:end-preview! text-view)
> (equal? (list (views:last-point b2) (views:last-point a)) before)
#t
; The place kept is the shared position in text: the item at the top
; and the fraction of it above the edge, which every page puts there
; again in its own geometry.
> (define d (buffers:make "d" (lines 300)))
> (define u (views:make d))
> (report! desktop u 1 0 #f)
> (report! desktop u 151 5 #f)
> (report! desktop u 151 5 #t)
> (views:set-buffer! u a)
> (views:set-buffer! u d)
> (list (placement u desktop) (and (search (html-of u desktop) "data-place-fraction=\"0.25\"" 0) #t))
((new position 151) #t)
