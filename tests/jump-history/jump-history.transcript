; A jump's ranges are what it marks; with none, the line from its
; indentation; an empty list marks nothing.
> (define indented (buffers:make "indented" "  ten\neleven\n"))
> (jump-history:jump-to indented 4 '((4 6)))
> (define (marked v)
    (let ([h (html->string (views:draw v #f))] [face "data-face=\"pulse.highlight\""])
      (let loop ([i 0] [stack '()] [text '()] [acc '()])
        (define (inside?) (memq #t stack))
        (cond
          [(= i (string-length h)) (reverse acc)]
          [(char=? (string-ref h i) #\<)
           (let* ([j (let find ([j i]) (if (char=? (string-ref h j) #\>) j (find (+ j 1))))] [tag (substring h i (+ j 1))])
             (cond
               [(and (> (string-length tag) 5) (string=? (substring tag 0 5) "<span"))
                (loop (+ j 1) (cons (and (search-html tag face) #t) stack) text acc)]
               [(string=? tag "</span>")
                (let ([closing (and (pair? stack) (car stack) (not (memq #t (cdr stack))))])
                  (loop (+ j 1) (if (pair? stack) (cdr stack) '()) (if closing '() text)
                        (if closing (cons (list->string (reverse text)) acc) acc)))]
               [else (loop (+ j 1) stack text acc)]))]
          [(inside?) (loop (+ i 1) stack (cons (string-ref h i) text) acc)]
          [else (loop (+ i 1) stack text acc)]))))
> (marked (view))
("en")
