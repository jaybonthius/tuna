; A preview visits a file temporarily: no files:after-visit entry
; runs for it, so a quit leaves other plugins as they were, and choosing
; the file completes its visit.
> (import (xref-picker))
> (define visits '())
> (add-hook! files:after-visit (lambda (b) (set! visits (cons (buffers:name b) visits))))
> (define uses (files:visit (string-append code "/uses.txt")))
> (in-client (lambda () (layout:switch-to-buffer uses)))
> (views:set-point! (view) 6)
> (set! visits '())
> (define t (start! (lambda () (press! "M-."))))
> (define s (session))
> (wait-matches s)
> (press! "C-n")
> (wait-until (lambda () (buffers:find "twice.txt")))
> (sleep-for 0.1)
> (list visits (map (lambda (n) (let ([b (buffers:find n)]) (and b (files:temporary? b)))) '("defs.txt" "twice.txt")))
(() (#t #t))
> (press! "C-g")
! &quit
> (result t)
> (list visits (map (lambda (n) (and (buffers:find n) #t)) '("defs.txt" "twice.txt")))
(() (#f #f))
> (define t (start! (lambda () (press! "M-."))))
> (define s (session))
> (wait-matches s)
> (press! "C-n")
> (wait-until (lambda () (buffers:find "twice.txt")))
> (press! "RET")
> (result t)
> (list visits (here) (files:temporary? (buffers:find "twice.txt")) (buffers:find "defs.txt"))
(("twice.txt") ("twice.txt" 2) #f #f)
> (press! "M-,")
; A preview of a file no buffer visits keeps the file's diagnostics: a
; quit kills the temporary buffer the preview opened, which never took
; them.
> (define source (diagnostics:make-source))
> (buffers:with-buffer uses (set-option-local! diagnostics:mode #t))
> (diagnostics:report! source uses (list (diagnostics:make-diagnostic '(2 . 4) #f (diagnostics:severity warning) "average is slow")))
#t
> (diagnostics:report! source (string-append code "/defs.txt") (list (diagnostics:make-diagnostic '(3 . 4) #f (diagnostics:severity error) "tally unused")))
#t
> (define (listed) (map diagnostics:diagnostic-message (diagnostics:under code)))
> (listed)
("tally unused" "average is slow")
> (define t (start! (lambda () (press! "C-u" "M-g" "f"))))
> (define s (session))
> (wait-matches s)
> (wait-until (lambda () (buffers:find "defs.txt")))
> (sleep-for 0.1)
> (list (and (buffers:find "defs.txt") #t) (listed))
(#t ("tally unused" "average is slow"))
> (press! "C-g")
! &quit
> (result t)
> (list (and (buffers:find "defs.txt") #t) (listed))
(#f ("tally unused" "average is slow"))
; xref-picker:preview-delay holds a preview back until the item has stayed
; selected that long.
> (set-option! xref-picker:preview-delay 0.3)
> (views:set-point! (view) 6)
> (define the-view (view))
> (define t (start! (lambda () (press! "M-."))))
> (define s (session))
> (wait-matches s)
> (sleep-for 0.1)
> (buffers:name (views:buffer the-view))
"uses.txt"
> (wait-until (lambda () (equal? (buffers:name (views:buffer the-view)) "defs.txt")))
> (buffers:name (views:buffer the-view))
"defs.txt"
> (press! "C-g")
! &quit
> (result t)
> (set-option! xref-picker:preview-delay 0)
; A report to a previewed file's path stays the file's: a temporary
; buffer is no buffer visiting it, so a quit loses nothing.
> (define twice (string-append code "/sub/twice.txt"))
> (buffers:kill! (files:buffer-visiting twice))
#t
> (define (twice-listed) (filter (lambda (m) (string=? m "total twice")) (listed)))
> (views:set-point! (view) 6)
> (define t (start! (lambda () (press! "M-."))))
> (define s (session))
> (wait-matches s)
> (press! "C-n")
> (wait-until (lambda () (buffers:find "twice.txt")))
> (list (files:temporary? (buffers:find "twice.txt")) (files:buffer-visiting twice))
(#t #f)
> (diagnostics:report! source twice (list (diagnostics:make-diagnostic '(2 . 4) #f (diagnostics:severity error) "total twice")))
#t
> (twice-listed)
("total twice")
> (press! "C-g")
! &quit
> (result t)
> (list (and (buffers:find "twice.txt") #t) (twice-listed))
(#f ("total twice"))
; A file the user visits while its preview shows is visited for real, and
; the end of the read keeps it.
> (define t (start! (lambda () (press! "M-."))))
> (define s (session))
> (wait-matches s)
> (press! "C-n")
> (wait-until (lambda () (buffers:find "twice.txt")))
> (define opened (spawn-task (lambda () (files:visit twice))))
> (wait-until (lambda () (task-done? opened)))
> (list (files:temporary? (buffers:find "twice.txt")) (eq? (files:buffer-visiting twice) (buffers:find "twice.txt")) (twice-listed))
(#f #t ("total twice"))
> (press! "C-g")
! &quit
> (result t)
> (list (and (buffers:find "twice.txt") #t) (twice-listed))
(#t ("total twice"))
