(import (tuna))
(use-plugin sources (git "https://github.com/groucho/tuna-sources"))
(use-plugin compat (git "https://github.com/bob/compat"))
(use-plugin consult)
(use-plugin embark)
(use-plugin embark-consult (commit "c332a5a"))
(use-plugin files)
(use-plugin notes (local "~/src/notes"))
(import (console))
