; Text split into other strings, at any depth, is the same text.
> (define split (fresh '(md:doc () (md:para () "Some " (md:link () "bold") " text\n"))))
> (buffers:reconcile! split (document:token (buffers:document split) 0) '((md:para () "So" "me " (md:link () "bo" "" "ld") " text" "\n")))
> (buffers:version split)
0
