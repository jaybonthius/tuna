; A run records its folder with files:expanded-path when it starts, so
; files:directory of its buffer has the form projects:find and every
; command take; the header still shows the folder with ~.
> (import (projects) (grep))
> (for-each folder! '("src" "src/x" "proj" "proj/sub"))
> (with-output-to-file (at "src/x/notes.txt") (lambda () (display "a needle here\n")))
> (define in-src (runs:start-for-user "*src*" "true" (processes:options [directory "~/src/x/"])))
> (ended? in-src)
0
> (list (files:directory in-src) (header-folder in-src) (projects:find (files:directory in-src)))
("$HOME/src/x/" "~/src/x/" #f)
> (define relative (runs:start-for-user "*relative*" "pwd" (processes:options [directory "."])))
> (ended? relative)
0
> (equal? (files:directory relative) (string-append (current-directory) "/"))
#t
> (runs:start-for-user "*user*" "true" (processes:options [directory "~root/"]))
! files:expanded-path: a path starting with ~user with irritant "~root/"
> (buffers:find "*user*")
#f
; M-s r in that run's buffer searches its folder.
> (layout:switch-to-buffer in-src)
> (define (session) (in-client completion:current-session))
> (define (texts s)
    (let ([ms (completion:session-matches s)])
      (map (lambda (k) (completion:text s (completion:matches-ref ms k))) (iota (completion:matches-count ms)))))
> (start! "M-s" "r")
> (type! "needle")
> (testing:wait-until (lambda () (and (session) (not (completion:session-busy? (session))) (pair? (texts (session))))))
> (texts (session))
("notes.txt:1:a needle here")
> (press! "C-g")
! &cancelled
; The shell-commands page's project-compile runs compile in the
; project's root from a run's buffer inside it, and in the run's folder
; outside a project.
> (options:set! projects:extra-root-markers '(".project"))
> (with-output-to-file (at "proj/.project") void)
> (commands:define-command (project-compile)
    "Runs compile in the current project's root, or in the buffer's folder outside a project, in a buffer of that folder's own."
    (let* ([folder (files:directory (buffers:current))]
           [project (projects:find folder)]
           [root (if project (projects:root project) folder)])
      (options:with ([files:directory-override (cons (buffers:current) root)]
                     [shell-commands:compile-buffer-name
                      (lambda () (string-append "*compilation " root "*"))])
        (commands:run shell-commands:compile))))
> (define in-proj (runs:start-for-user "*proj*" "true" (processes:options [directory "~/proj/sub/"])))
> (ended? in-proj)
0
> (define (compile-from b)
    (layout:switch-to-buffer b)
    (spawn-task (lambda (restore) (in-client (lambda () (commands:run project-compile)))))
    (settle)
    (press! "C-a" "C-k")
    (type! "pwd")
    (press! "RET")
    (settle))
> (compile-from in-proj)
> (define built (buffers:find (string-append "*compilation " (at "proj/") "*")))
> (ended? built)
0
> (output built)
"$HOME/proj"
> (compile-from in-src)
> (define built (buffers:find (string-append "*compilation " (at "src/x/") "*")))
> (ended? built)
0
> (output built)
"$HOME/src/x"
; A folder that climbs with .. is made canonical, so projects:find walks
; the run's real ancestors: a marker in Tuna's working folder, which a
; walk of work/../home/src/x would pass through, is not the project, and
; M-s r searches the run's folder.
> (with-output-to-file (string-append (current-directory) "/.project") void)
> (define up (runs:start-for-user "*up*" "pwd" (processes:options [directory "../home/src/x"])))
> (ended? up)
0
> (list (files:directory up) (output up) (projects:find (files:directory up)))
("$HOME/src/x/" "$HOME/src/x" #f)
> (layout:switch-to-buffer up)
> (start! "M-s" "r")
> (type! "needle")
> (testing:wait-until (lambda () (and (session) (not (completion:session-busy? (session))) (pair? (texts (session))))))
> (texts (session))
("notes.txt:1:a needle here")
> (press! "C-g")
! &cancelled
; An absolute folder with .. is made canonical too, so project-compile
; builds in the project's root.
> (buffers:kill! (buffers:find (string-append "*compilation " (at "proj/") "*")))
#t
> (define climbing (runs:start-for-user "*climbing*" "pwd" (processes:options [directory (at "src/../proj/sub")])))
> (ended? climbing)
0
> (files:directory climbing)
"$HOME/proj/sub/"
> (compile-from climbing)
> (define built (buffers:find (string-append "*compilation " (at "proj/") "*")))
> (ended? built)
0
> (output built)
"$HOME/proj"
