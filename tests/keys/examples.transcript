; A command reading the character typed.
> (import (views) (buffers) (document))
> (commands:define-command (insert-typed [char (keys:typed-char)])
    "Inserts CHAR at point."
    (let ([view (views:current)])
      (buffers:replace! (views:buffer view) (views:point view) (views:point view) (string char))))
> (keys:bind! keys:global "<printing-char>" insert-typed)
> (define notes (views:make (buffers:make "notes" "")))
> (views:with-view notes (press-all! frame "H" "i" "!"))
> (document:text (buffers:document (views:buffer notes)))
"!iH"
; A temporary keymap that stays while its keys are typed.
> (import (sticky))
> (define end-repeat
    (keys:push-keymap! (layout:current-frame) sticky:keymap
      (lambda (found command) (eq? found sticky:keymap))))
> (press-all! frame "o" "o")
