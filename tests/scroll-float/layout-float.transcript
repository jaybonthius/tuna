> (define (floats-of html)
    (let loop ([from 0] [acc '()])
      (let ([i (search html "class=\"float-child" from)])
        (if i
            (let ([e (search html "\">" i)]) (loop (+ i 1) (cons (substring html i e) acc)))
            (reverse acc)))))
