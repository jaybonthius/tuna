; Exit, complete and the moves act on a session that completion:start
; runs over a field in any view, so M-x reaches it.
> (define tags (buffers:make "*tags*" "lis"))
> (views:set-buffer! (view) tags)
> (define tag-session
    (in-client
      (lambda ()
        (completion:start (view) (list (completion:source (candidates (vector "lisp" "list" "listen"))))
          (lambda () (values 1 (- (document:length (buffers:document tags)) 1)))
          (lambda (session match) #f)
          'none))))
> (completion:selected tag-session)
#f
> (define t (start! (lambda () (press! "M-x"))))
> (type! "completion:next")
> (press! "RET")
> (result t)
> (selected-text tag-session)
"lisp"
> (completion:end! tag-session)
; A command run from M-x reads the next key from the client that typed
; M-x, keeping the prefix argument M-x passed on.
> (define quoted (buffers:make "quoted" ""))
> (views:set-buffer! (view) quoted)
> (define t (start! (lambda () (press! "C-u" "2" "M-x"))))
> (type! "editing:quoted-insert")
> (press! "RET")
> (sleep-for 0.05)
> (list (keys:reading client) (keys:reading other-client))
("M-x" #f)
> (press-in! other-client "a")
> (press! "TAB")
> (result t)
> (text quoted)
"a\t\t"
