; M-s o asks for a regexp with search:prompt-regexp-history; once one
; was read, it is the default.
> (define b (src "one foo\ntwo\nfoo three foo\nfour\nFoo five\n"))
> (views:set-point! (view) 5)
> (start! "M-s" "o")
> (question)
> (type! "foo")
> (press! "RET")
> (wait-listed)
"List lines matching regexp: "
; *Occur* is shown, not selected; the source keeps point; the echo
; area names the count; no jump is recorded.
> (list (wins) (last-message) (jump-history:places))
> (listed)
((("src" 5 #t) ("*Occur*" 2 #f)) "Searched 1 buffer; 4 matches for \"foo\"" ())
"4 matches in 3 lines for \"foo\" in buffer: src\none foo\nfoo three foo\nFoo five\n"
; Point in *Occur* is at its start, on the heading.
> (where)
(heading "")
; The heading is underlined, matches in occur.match, numbers in shadow.
> (faced (occur-html))
> (count-of (occur-html) "occur-heading")
(("shadow" "      1:") ("occur.match" "foo") ("shadow" "      3:") ("occur.match" "foo") ("occur.match" "foo") ("shadow" "      5:") ("occur.match" "Foo"))
1
; Smart case: a capital makes the regexp exact.
> (occur! (search:make-query "Foo" search:regexp) 0 #f)
> (last-message)
"Searched 1 buffer; 1 match for \"Foo\""
; An empty answer takes the default, the last regexp read.
> (start! "M-s" "o")
> (question)
"List lines matching regexp (default foo): "
; M-n gives the default.
> (press! "M-n")
> (minibuffer:input (minibuffer:current-prompt))
> (press! "RET")
> (wait-listed)
> (last-message)
"foo"
"Searched 1 buffer; 4 matches for \"foo\""
; With no regexp read, the default is the last regexp search, else
; the last search, quoted.
> (set-saved! search:prompt-regexp-history '())
> (set-saved! search:regexp-history '())
> (set-saved! search:history '("a.b"))
> (start! "M-s" "o")
> (question)
> (press! "C-g")
"List lines matching regexp (default a\\.b): "
! &quit
; No match: *Occur* is killed and its view shows its previous buffer;
; the echo area says so.
> (occur! (search:make-query "zzz" search:regexp) 0 #f)
> (list (occur-buffer) (wins) (last-message))
(#f (("src" 5 #t) ("src" 5 #f)) "Searched 1 buffer; no matches for \"zzz\"")
; The empty regexp is refused.
> (views:call-with-view (view) (lambda () (occur:occur (search:make-query "" search:regexp) 0 #f)))
! occur:occur: Occur doesn’t work with the empty regexp
; Listing *Occur* itself renames it first.
> (occur! (search:make-query "foo" search:regexp) 0 #f)
> (in-occur!)
> (occur! (search:make-query "foo" search:regexp) 0 #f)
> (list (buffers:name (views:buffer (view))) (listed))
> (buffers:kill! (buffers:find "*Occur*<2>"))
("*Occur*<2>" "5 matches in 4 lines for \"foo\" in buffer: *Occur*<2>\n4 matches in 3 lines for \"foo\" in buffer: src\none foo\nfoo three foo\nFoo five\n")
#t
; A region is taken exactly: only the matches inside it are counted
; and highlighted; a listed line shows its whole text.
> (define r (src "foo1 foo2\nfoo3 foo4 foo9\nfoo5\n"))
> (views:set-mark! (view) 3)
> (views:set-point! (view) 15)
> (occur! (search:make-query "foo[0-9]" search:regexp) 0 #f)
> (listed)
> (filter (lambda (f) (string=? (car f) "occur.match")) (faced (occur-html)))
> (views:set-mark! (view) #f)
"2 matches for \"foo[0-9]\" in buffer: src within region: 3-15\nfoo1 foo2\nfoo3 foo4 foo9\n"
(("occur.match" "foo2") ("occur.match" "foo3"))
; A count lists context lines around each match, with a separator;
; a negative count lists lines before only.
> (define c (src "a\nb\nX\nc\nd\ne\nf\nX\ng\n"))
> (occur! (search:make-query "X" search:regexp) 1 #f)
> (listed)
> (count-of (occur-html) "occur-separator")
"2 matches for \"X\" in buffer: src\nb\nX\nc\nf\nX\ng\n"
1
; Context lines are numbered too, the number and the text dimmed.
> (filter (lambda (f) (string=? (car f) "shadow")) (faced (occur-html)))
> (occur! (search:make-query "X" search:regexp) -1 #f)
> (listed)
(("shadow" "") ("shadow" "      2:") ("shadow" "      3:") ("shadow" "") ("shadow" "      4:") ("shadow" "-------") ("shadow" "") ("shadow" "      7:") ("shadow" "      8:") ("shadow" "") ("shadow" "      9:"))
"2 matches for \"X\" in buffer: src\nb\nX\nf\nX\n"
; occur:context-lines is the count with no prefix, negative too.
> (set-option! occur:context-lines -1)
> (start! "M-s" "o")
> (type! "X")
> (press! "RET")
> (wait-listed)
> (listed)
> (set-option! occur:context-lines 0)
"2 matches for \"X\" in buffer: src\nb\nX\nf\nX\n"
; Context lines do not look clickable; listed lines do.
> (occur! (search:make-query "X" search:regexp) 1 #f)
> (count-of (occur-html) "clickable")
2
; The current line is listed in match.other, matching or not, and
; point is at its end.
> (define d (src "one foo\ntwo\nfoo three foo\nfour\n"))
> (views:set-point! (view) 10)
> (set-option! occur:jump-to-current-line #t)
> (occur! (search:make-query "foo" search:regexp) 0 #f)
> (list (listed) (where))
> (count-of (occur-html) "match.other")
> (views:set-point! (view) 2)
> (occur! (search:make-query "foo" search:regexp) 0 #f)
> (set-option! occur:jump-to-current-line #f)
> (list (where) (count-of (occur-html) "match.other"))
("3 matches in 2 lines for \"foo\" in buffer: src\none foo\ntwo\nfoo three foo\n" (2 "two"))
1
((1 "one foo") 1)
; C-u collects: the prompt says so; with no group \& is collected
; unasked; with groups the template is asked, its history starting \1.
> (start! "C-u" "M-s" "o")
> (question)
> (type! "f.o")
> (press! "RET")
> (wait-listed)
> (listed)
> (start! "C-u" "M-s" "o")
> (type! "(f)(o)o")
> (press! "RET")
> (sleep-for 0.05)
> (question)
> (type! "\\2\\1")
> (press! "RET")
> (wait-listed)
> (list (listed) (occur:collect-history))
"Collect strings matching regexp (default X): "
"3 matches in 2 lines for \"f.o\" in buffer: src\nfoo\nfoo\nfoo\n"
"Regexp to collect (default \\1): "
("3 matches in 2 lines for \"(f)(o)o\" in buffer: src\nof\nof\nof\n" ("\\2\\1" "\\1"))
; A parenthesis that is quoted or in a class opens no group, so \& is
; collected unasked.
> (start! "C-u" "M-s" "o")
> (type! "\\Q(\\E|[(]|o")
> (press! "RET")
> (wait-listed)
> (list (minibuffer:current-prompt) (listed))
(#f "9 matches in 4 lines for \"\\Q(\\E|[(]|o\" in buffer: src\no\no\no\no\no\no\no\no\no\n")
; occur:listed is called after each listing with matches, g included,
; and not after one without.
> (define seen '())
> (define (note! b) (set! seen (cons (buffers:name b) seen)))
> (add-hook! occur:listed note!)
> (occur! (search:make-query "foo" search:regexp) 0 #f)
> (in-occur!)
; g lists again, says so, and puts point at the start.
> (buffers:replace! d 1 1 "foo zero\n")
> (views:set-point! (view) 40)
> (press! "g")
> (wait-listed)
> (list (listed) (last-message) (where) seen)
> (buffers:replace! d 1 (- (document:length (buffers:document d)) 2) "nothing")
> (press! "g")
> (wait-listed)
> (list (occur-buffer) (last-message) seen)
> (remove-hook! occur:listed note!)
#<edit 1>
("4 matches in 3 lines for \"foo\" in buffer: src\nfoo zero\none foo\nfoo three foo\n" "Searched 1 buffer; 4 matches for \"foo\"" (heading "") ("*Occur*" "*Occur*"))
#<edit 2>
(#f "Searched 1 buffer; no matches for \"foo\"" ("*Occur*" "*Occur*"))
; g after the source is killed.
> (define e (src "one foo\n"))
> (occur! (search:make-query "foo" search:regexp) 0 #f)
> (buffers:kill! e)
> (in-occur!)
> (press! "g")
> (list (occur-buffer) (last-message))
#t
(#f "Searched 0 buffers (1 killed); no matches for \"foo\"")
; The message names the regexp however long it is, since one message
; goes to every client's echo area, whose widths differ.
> (define long (src "one foo\n"))
> (occur! (search:make-query (string-append "foo|" (make-string 200 #\z)) search:regexp) 0 #f)
> (string=? (last-message) (string-append "Searched 1 buffer; 1 match for \"foo|" (make-string 200 #\z) "\""))
#t
