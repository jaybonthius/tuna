; Moving between groups walks one group's matches: across a group of a
; million, M-} and M-{ still land on the groups' first matches.
> (define million
    (completion:source
      (candidates (let ([v (make-vector 1000000)])
                    (do ([i 0 (+ i 1)]) ((= i 1000000) v) (vector-set! v i (number->string i)))))
      (in-order)
      (group (lambda (text value) (if (string=? text "999999") "small" "big")))))
> (define t (start! (lambda () (completion:read "? " (list million) #f))))
