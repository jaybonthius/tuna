(markdown:heading ((key . 0) (level . 1)) "New Title\n")
; Line motion from a line's start reaches each block, the paragraph
; after a list and after a quote included, since no text block takes
; typing after its last newline.
> (define stops (page:make "*stops*" "- item one\n- item two\n\nAfter the list.\n\n> quoted\n\nEnd.\n"))
> (show! stops)
> (define (walk key n) (let loop ([k n] [at (list (views:point (view)))]) (if (= k 0) (reverse at) (begin (press! key) (loop (- k 1) (cons (views:point (view)) at))))))
> (walk "C-n" 4)
(4 17 30 49 59)
> (walk "C-p" 4)
(59 49 30 17 4)
