; Completion at point does not start by itself unless a buffer sets
; completion-popup:auto-delay.
> (define notes (buffers:make "notes" "alpha almond apple\n"))
> (views:set-buffer! (view) notes)
> (press! "M->")
> (type! "alm")
> (sleep-for 0.3)
> (session)
#f
; start-at-point needs the minimum before point.
> (in-client (lambda () (completion:start-at-point client 4)))
#f
> (in-client (lambda () (completion:start-at-point client 3)))
#t
> (define s (session))
> (texts s)
("alm" "almond")
> (completion:selected s)
#f
> (popups)
((" *Completion-popup-1*" (columns 15) (lines 2)))
; With nothing selected, RET types a newline; the entry gives no region
; at point, so the session ends.
> (press! "RET")
> (text notes)
"alpha almond apple\nalm\n"
> (session)
#f
> (popups)
()
; With a match selected, RET chooses it.
> (type! "al")
> (press! "C-M-i")
> (texts (session))
("al" "alm" "alpha" "almond")
> (press! "M-n" "M-n")
> (selected-text (session))
"alm"
> (press! "M-p")
> (selected-text (session))
"al"
> (press! "RET")
> (text notes)
"alpha almond apple\nalm\nal"
> (session)
#f
; Typing goes on in the session; the popup follows; moving point out of
; the region ends it.
> (press! "SPC")
> (type! "a")
> (press! "C-M-i")
> (texts (session))
("a" "al" "alm" "alpha" "apple" "almond")
> (type! "p")
> (texts (session))
("apple")
> (popups)
((" *Completion-popup-3*" (columns 15) (lines 1)))
> (press! "C-a")
> (session)
#f
; Typing the only match's whole text ends the session.
> (press! "C-e")
> (press! "C-M-i")
> (type! "ple")
> (session)
#f
; C-g ends it.
> (press! "SPC" "a")
> (press! "C-M-i")
> (press! "C-g")
> (session)
#f
> (popups)
()
; TAB inserts the selection, or the longest common start.
> (press! "C-M-i")
> (press! "TAB")
> (text notes)
"alpha almond apple\nalm\nal apple a"
> (press! "C-g")
; A click on a row of the popup chooses it.
> (press! "SPC")
> (type! "alp")
> (press! "C-M-i")
> (define lv (list-view))
> (texts (session))
("alp" "alpha")
> (click-token! lv (row-position lv 1))
> (text notes)
"alpha almond apple\nalm\nal apple a alpha"
> (session)
#f
; In a read, the list shows below the input with its count, and the
; arrow keys move the selection; a click on a row chooses it.
> (define-saved h '() list?)
> (define t (start! (lambda () (completion:read "Word: " (list (completion:source (candidates (vector "alpha" "almond" "apple" "banana")) (title "Words"))) h))))
