; Names in *Help* are links: RET or a click follows one, describing what
; it names from the view of the description it is in.
> (define notes (buffers:make "notes" "harpo:honk\n"))
> (layout:switch-to-buffer notes)
> (modes:set-major-mode harpo:mode notes)
> (in-client (lambda () (help:describe-key "C-c h" (view))))
> (layout:select! (help-view))
> (views:set-point! (help-view) (+ (link-to 'harpo:mode) 1))
> (press! "RET")
> (title)
"harpo:mode"
> (in-client (lambda () (help:describe-key "C-c h" (car (views:showing notes)))))
> (define (on-link name) (list "<mouse-1>" (views:%make-posn (help-view) (+ (link-to name) 2))))
> (press! (cons "<down-mouse-1>" (cdr (on-link 'harpo:honk))) (on-link 'harpo:honk))
> (help)
# harpo:honk
<harpo:honk> is a command in (harpo).
It is on [C-c h].
It is for <harpo:mode>.
Honks once.
; *Help* refuses the user's edits.
> (views:set-point! (help-view) 3)
> (press! "x")
! buffers:replace!: a read-only span refuses the edit with irritant help:%read-only
> (title)
"harpo:honk"
; q quits the view: here *Help* had a part of its own, which goes.
> (press! "q")
> (shown)
(("notes" #t))
; help:select-view? selects the view showing *Help*.
> (set-option! help:select-view? #t)
> (press! "C-h" "l")
> (shown)
(("notes" #f) ("*Help*" #t))
; A killed *Help* is made again by the next description, which runs
; help:mode-hook again.
> (define hooked 0)
> (add-hook! help:mode-hook (lambda () (set! hooked (+ hooked 1))))
> (buffers:kill! (help-buffer))
#t
> (press! "C-h" "l")
> (list (title) hooked)
("Recent keys" 1)
; C-h l: the recent keys, oldest first, one line per command, the keys
; before it then the command, a link while it is a loaded command. Keys
; typed into a prompt are there; g shows the keys typed since.
> (help)
# Recent keys
[RET]             <help:%follow-link>
[<down-mouse-1>]  <keys:ignore>
[<mouse-1>]       <help:%follow-link>
[x]               <editing:self-insert>
[q]               <layout:quit-view>
[C-h l]           <help:view-lossage>
[C-h l]           <help:view-lossage>
> (keys:bind! keys:global "<f5>" harpo:honk)
> (press! "<f5>")
> (start! "C-h" "f")
> (type! "ha")
> (press! "C-g")
> (settle)
! &quit
> (unload-module! '(harpo))
> (layout:select! (help-view))
> (press! "g")
> (help-with "f5" "C-h f" "[a]" "[C-g]" "[g]")
[<f5>]            harpo:honk
[C-h f]           <help:describe-name>
[a]               <editing:self-insert>
[C-g]             <minibuffer:abort>
[g]               <help:refresh>
; Going back to a command or a name that is gone says so, and the
; history goes on past it.
> (press! "l" "l")
> (title)
"harpo:honk is not a loaded command"
> (press! "l")
> (title)
"C-c h is undefined"
> (press! "l")
> (title)
"harpo:mode is not an exported name"
> (press! "r" "r" "r")
> (title)
"Recent keys"
