    (list (list "b" 1 p) (list b -1 p) (list b 1 5) (list b 1 (list p)) (list b 99 "x")))
((kill-ring:insert! "not a buffer") (kill-ring:insert! "not a position") (kill-ring:insert! "not a string or a piece") (kill-ring:insert! "not a string or a piece") (kill-ring:insert! "not a position in the buffer"))
