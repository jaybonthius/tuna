; A paused task whose after-thunk calls exit as the exit leaves it only
; ends: the exit under way still unloads every module, then exits with
; its own status.
> (import (user))
> (define exiting? #f)
> (define paused
    (spawn-task
      (lambda ()
        (dynamic-wind
          void
          (lambda () (suspend (lambda (resume) (void))))
          (lambda () (when exiting? (user:say-leaving) (exit 9)))))))
> (set! exiting? #t)
leaving the task
configuration unloading
user unloading
keeper unloading
