; processes:text-receiver decodes output as UTF-8 across pieces: a
; character cut at a piece's end waits for the rest, and each call gets
; the offset after the bytes it decoded.
> (define got '())
> (define receive (processes:text-receiver 0 (lambda (text end) (set! got (cons (cons text end) got)))))
> (receive (bytevector #x61 #xE2 #x82) 3)
> (receive (bytevector #xAC #x62 #xF0 #x9F) 7)
> (receive (bytevector #x98 #x80) 9)
> (reverse got)
(("a" . 1) ("€b" . 5) ("😀" . 9))
; Invalid bytes become U+FFFD, and at the end what is held is decoded
; before the end-of-file object.
> (set! got '())
> (receive (bytevector #xFF #x63 #xE2) 12)
> (receive (eof-object) 12)
> (reverse got)
(("�c" . 11) ("�" . 12) (#!eof . 12))
; Output that starts after the offset asked for, cut by the log, skips to
; the first byte that can start a character.
> (set! got '())
> (define late (processes:text-receiver 0 (lambda (text end) (set! got (cons (cons text end) got)))))
> (late (bytevector #x82 #xAC #x64) 103)
> (reverse got)
(("d" . 103))
> (processes:text-receiver -1 values)
! processes:text-receiver: not an output offset with irritant -1
