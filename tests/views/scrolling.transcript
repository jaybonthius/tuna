; views:horizontal-scroll-bar on.
> (define (bars view client)
    (let ([html (html-of view client)])
      (map (lambda (axis) (and (search html (format "data-scroll-bar=\"~a\" data-keymap" axis) 0) #t)) '("vertical" "horizontal"))))
