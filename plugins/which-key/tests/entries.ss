(import (tuna) (test) (test-user) (hooks) (options) (tables) (keys) (layout) (which-key) (which-key-test))

(options:set! which-key:delay 0)
(tables:set! which-key:labels "C-c w l" "language")

(keys:bind! keys:global "C-c w l r" which-key-test:honk)
(keys:bind! keys:global "C-c w f f" which-key-test:squeak)
(keys:bind! keys:global "C-c w h" which-key-test:keymap)
(keys:bind! keys:global "C-c w q z" which-key-test:squeak)
(keys:bind! keys:global "C-c w RET" which-key-test:honk)
(keys:bind! keys:global "C-c w SPC" which-key-test:honk)
(keys:bind! keys:global "C-c w z" which-key-test:honk)
(keys:bind! keys:global "C-c w A" which-key-test:honk)
(keys:bind! keys:global "C-c w <f10>" which-key-test:honk)
(keys:bind! keys:global "C-c w <f2>" which-key-test:honk)
(keys:bind! keys:global "C-c w <home>" which-key-test:honk)
(keys:bind! keys:global "C-c w C-z" which-key-test:honk)
(keys:bind! keys:global "C-c w M-a" which-key-test:honk)
(keys:bind! keys:global "C-c w C-M-a" which-key-test:honk)

(test "the popup lists each key that can follow, named keys first, then characters, function keys, and keys with modifiers; a prefix shows + and its label, its keymap's documentation, or prefix"
  (test-user:press! "C-c w")
  (check-equal? '("C-c w" ("RET" "which-key-test:honk") ("SPC" "which-key-test:honk") ("A" "which-key-test:honk")
                  ("f" "+prefix" label) ("h" "+Harpo's horn." label) ("l" "+language" label) ("q" "+prefix" label)
                  ("z" "which-key-test:honk") ("<f2>" "which-key-test:honk") ("<f10>" "which-key-test:honk")
                  ("<home>" "which-key-test:honk") ("C-z" "which-key-test:honk") ("C-M-a" "which-key-test:honk")
                  ("M-a" "which-key-test:honk"))
                (which-key-test:popup))
  (test-user:press! "z"))

(test "each key shows what it runs now, after remapping"
  (keys:remap! keys:global which-key-test:honk which-key-test:squeak)
  (test-user:press! "C-c w")
  (check-equal? '("z" "which-key-test:squeak") (assoc "z" (cdr (which-key-test:popup))))
  (test-user:press! "z")
  (tables:remove! keys:global which-key-test:honk))

(test "a binding an earlier keymap hides is left out, and so are the keys after a prefix an earlier keymap binds to a command"
  (tables:define-table front-keymap)
  (keys:bind! front-keymap "C-c w z" which-key-test:squeak)
  (keys:bind! front-keymap "C-c w q" which-key-test:honk)
  (let ([in-front (lambda (client posn) (list front-keymap))])
    (hooks:add! keys:find-keymaps in-front -50)
    (test-user:press! "C-c w")
    (check-equal? '(("z" "which-key-test:squeak") ("q" "which-key-test:honk") ("h" "+Harpo's horn." label))
                  (map (lambda (k) (assoc k (cdr (which-key-test:popup)))) '("z" "q" "h")))
    (test-user:press! "z")
    (hooks:remove! keys:find-keymaps in-front)))

(test "an entry in which-key:labels wins over the keymap's documentation, and a keymap without documentation shows prefix"
  (tables:define-table bare-keymap)
  (keys:bind! bare-keymap "x" which-key-test:honk)
  (keys:bind! keys:global "C-c w y" bare-keymap)
  (tables:set! which-key:labels "C-c w h" "horn")
  (test-user:press! "C-c w")
  (check-equal? '(("h" "+horn" label) ("y" "+prefix" label)) (map (lambda (k) (assoc k (cdr (which-key-test:popup)))) '("h" "y")))
  (test-user:press! "z")
  (tables:remove! which-key:labels "C-c w h"))

(test "a label that is not a string is reported when the screen is drawn"
  (tables:set! which-key:labels "C-c w h" 'horn)
  (let ([reported '()])
    (let ([keep (lambda (next c) (set! reported (cons c reported)))])
      (advice-add! report keep)
      (test-user:press! "C-c w")
      (advice-remove! report keep))
    (check (pair? reported))
    (check (for-all (lambda (c) (and (eq? 'which-key:labels (condition-who c)) (string=? "not a string" (condition-message c))))
                    reported)))
  (check-raises (lambda (c) (and (who-condition? c) (eq? 'which-key:labels (condition-who c)))) (layout:screen (test-user:client)))
  (tables:remove! which-key:labels "C-c w h")
  (test-user:press! "z"))

(test "the popup holds the pending keys in a header, then a list of entries, and gives the stylesheet the longest key and text in characters"
  (test-user:press! "C-c w h")
  (let ([popup (car (test-user:elements (test-user:screen) "which-key"))])
    (check-equal? "--which-key-key-size:1;--which-key-text-size:21" (test-user:element-attribute popup "style"))
    (check-equal? '(header) (map car (test-user:elements popup "which-key-prefix")))
    (check-equal? '(ul) (map car (test-user:elements popup "which-key-keys")))
    (check-equal? '("C-c w h" ("h" "which-key-test:honk") ("s" "which-key-test:squeak")) (which-key-test:popup)))
  (test-user:press! "s"))

(test "each entry is an on-screen key, a button that types its key; a mouse key's entry is no button"
  (keys:bind! keys:global "C-c w h <mouse-1>" which-key-test:honk)
  (test-user:press! "C-c w h")
  (let ([entries (test-user:elements (test-user:screen) "which-key-entry")])
    (check-equal? '((button "h" "-1") (button "s" "-1") (span #f #f))
                  (map (lambda (e) (list (car e) (test-user:element-attribute e "data-key") (test-user:element-attribute e "tabindex")))
                       entries)))
  (test-user:press! "s")
  (check-equal? #f (keys:pending (test-user:client)))
  (keys:unbind! keys:global "C-c w h <mouse-1>"))
