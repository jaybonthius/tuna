(import (chezscheme) (tuna-test) (tuna core changes) (tuna core modules)
        (except (tuna core main-thread) exit))

(define calls '())

(define (note-update ls before l)
  (set! calls (cons (list (layers-value ls) before l) calls))
  (layers-value-set! ls (map layer-value (layers-in-effect ls))))

(define (setting-layers) (make-value-layers 'setting 'thing layer-after? note-update '()))

(define (entry-layers) (make-procedure-layers 'entry 'thing layer-after? note-update '()))

(define (owners ls) (map (lambda (l) (owner-name (layer-owner l))) (layers-in-effect ls)))

(define (add-as! ls owner value)
  (as-module owner (add-layer! ls (current-owner-record) #f value)))

(define (remove-as! ls owner value)
  (as-module owner (remove-layers! ls (current-owner-record) #f value)))

(define (take-back-all! . names)
  (for-each (lambda (name) (take-back-changes! name '())) names))

(define (tests)
  (rank-module! '(first) #f)
  (rank-module! '(second) #f)
  (rank-module! '(in-lib) #t)

  (test "layers are in the order of changes, the last first"
    (let ([ls (setting-layers)])
      (add-as! ls '(init) 'i)
      (add-as! ls '(in-lib) 'l)
      (add-as! ls '(second) 's)
      (add-as! ls '(first) 'f)
      (check-equal? '((init) (in-lib) (second) (first)) (owners ls))
      (check-equal? '(i l s f) (layers-value ls))
      (take-back-all! '(init) '(in-lib) '(second) '(first))
      (check-equal? '() (layers-value ls))))

  (test "an owner's new layer of a value it sets replaces its old one in one update"
    (let ([ls (setting-layers)])
      (add-as! ls '(first) 1)
      (set! calls '())
      (add-as! ls '(first) 2)
      (check-equal? 1 (length calls))
      (check-equal? '(2) (layers-value ls))
      (check-equal? '((setting thing #f)) (module-changes '(first)))
      (take-back-all! '(first))))

  (test "adding the same procedure again does nothing; others are added"
    (let ([ls (entry-layers)])
      (add-as! ls '(first) car)
      (set! calls '())
      (add-as! ls '(first) car)
      (check-equal? '() calls)
      (add-as! ls '(first) cdr)
      (add-as! ls '(second) car)
      (check-equal? (list car cdr car) (layers-value ls))
      (check-equal? 3 (length (layers-changes ls)))
      (take-back-all! '(first) '(second))))

  (test "updated sees the previous value, the layers in effect before, and the layer that came or went"
    (let ([ls (setting-layers)])
      (add-as! ls '(first) 1)
      (let ([l (car (layers-in-effect ls))])
        (set! calls '())
        (add-as! ls '(second) 2)
        (let ([added (car (layers-in-effect ls))])
          (check-equal? (list (list '(1) (list l) added)) calls)
          (set! calls '())
          (take-back-all! '(second))
          (check-equal? (list (list '(2 1) (list added l) added)) calls)))
      (take-back-all! '(first))))

  (test "removing takes back the owner's own layers and hides others' until the removal is taken back"
    (let ([ls (entry-layers)])
      (add-as! ls '(first) car)
      (add-as! ls '(second) cdr)
      (add-as! ls '(second) car)
      (remove-as! ls '(second) car)
      (check-equal? (list cdr) (layers-value ls))
      (check-equal? '((removal thing #f) (entry thing #f)) (module-changes '(second)))
      (add-as! ls '(first) cdr)
      (check-equal? (list cdr cdr) (layers-value ls))
      (take-back! (find (lambda (c) (eq? (change-kind c) 'removal)) (owner-changes '(second))))
      (check-equal? (list cdr cdr car) (layers-value ls))
      (take-back-all! '(first) '(second))))

  (test "a removal hides by owner, so what the owner makes again after loading again stays hidden"
    (let ([tables (setting-layers)] [hooks (entry-layers)])
      (add-as! tables '(second) 1)
      (add-as! hooks '(second) car)
      (remove-as! tables '(init) #f)
      (remove-as! hooks '(init) car)
      (take-back-all! '(second))
      (unrank-module! '(second))
      (rank-module! '(second) #f)
      (add-as! tables '(second) 2)
      (add-as! hooks '(second) car)
      (add-as! hooks '(second) cdr)
      (check-equal? '() (layers-value tables))
      (check-equal? (list cdr) (layers-value hooks))
      (take-back-all! '(init))
      (check-equal? '(2) (layers-value tables))
      (check-equal? (list cdr car) (layers-value hooks))
      (take-back-all! '(second))))

  (test "each removal is a change of its own; only the remover's own earlier removal makes another redundant"
    (let ([ls (setting-layers)])
      (add-as! ls '(first) 1)
      (remove-as! ls '(init) #f)
      (remove-as! ls '(init) #f)
      (remove-as! ls '(repl) #f)
      (check-equal? 1 (length (module-changes '(init))))
      (check-equal? 1 (length (module-changes '(repl))))
      (take-back-all! '(init))
      (check-equal? '() (layers-value ls))
      (take-back-all! '(repl))
      (check-equal? '(1) (layers-value ls))
      (take-back-all! '(first))))

  (test "moving a lib module before its importers reorders its layers"
    (rank-module! '(moved) #t)
    (let ([ls (setting-layers)])
      (add-as! ls '(in-lib) 'l)
      (add-as! ls '(moved) 'm)
      (check-equal? '(m l) (layers-value ls))
      (set! calls '())
      (move-before-importers! '(moved))
      (check-equal? 1 (length calls))
      (check-equal? '(l m) (layers-value ls))
      (take-back-all! '(in-lib) '(moved))))

  (test "layers stay in order whatever is added, removed and taken back, and come back once the removals go"
    (let ([owners '((first) (second) (in-lib) (init) (repl))] [procedures (list car cdr cons)])
      (define (in-order? ls)
        (let ([in-effect (layers-in-effect ls)])
          (and (equal? in-effect (list-sort layer-after? in-effect))
               (for-all (lambda (l) (memq l (layers-all ls))) in-effect))))
      (do ([round 0 (+ round 1)]) ((= round 200))
        (let ([sets (setting-layers)] [adds (entry-layers)])
          (do ([i 0 (+ i 1)]) ((= i 30))
            (let ([owner (list-ref owners (random (length owners)))]
                  [proc (list-ref procedures (random (length procedures)))])
              (case (random 4)
                [(0) (add-as! sets owner (random 10))]
                [(1) (add-as! adds owner proc)]
                [(2) (remove-as! sets owner #f)]
                [else (remove-as! adds owner proc)])))
          (for-each take-back!
            (filter (lambda (c) (fxzero? (random 2))) (append (layers-changes sets) (layers-changes adds))))
          (for-each
            (lambda (ls)
              (check (in-order? ls))
              (check-equal? (map layer-value (layers-in-effect ls)) (layers-value ls))
              (for-each take-back! (filter (lambda (c) (eq? (change-kind c) 'removal)) (layers-changes ls)))
              (check-equal? (list-sort layer-after? (layers-all ls)) (layers-in-effect ls)))
            (list sets adds))
          (apply take-back-all! owners)
          (check-equal? '() (layers-value sets))
          (check-equal? '() (layers-value adds))))))

  (test "other threads read a layered value whole while the main thread changes it"
    (let ([ls (setting-layers)] [stop? #f] [bad 0] [mutex (make-mutex)])
      (define (reader)
        (fork-thread
          (lambda ()
            (let loop ([wrong 0])
              (if stop?
                  (with-mutex mutex (set! bad (+ bad wrong)))
                  (let ([v (layers-value ls)])
                    (loop (if (and (list? v) (for-all fixnum? v)) wrong (+ wrong 1)))))))))
      (let ([readers (list (reader) (reader) (reader))])
        (do ([i 0 (+ i 1)]) ((= i 20000))
          (add-as! ls '(first) i)
          (add-as! ls '(init) i)
          (when (fxeven? i) (take-back-all! '(init))))
        (set! stop? #t)
        (for-each thread-join readers))
      (check-equal? 0 bad)
      (take-back-all! '(first) '(init))))

  (test "a quit never leaves layers half changed"
    (let ([sets (setting-layers)] [adds (entry-layers)] [changing? #f] [quits-while-changing 0])
      (define (burn n) (if (fx= n 0) 0 (fx+ 1 (burn (fx- n 1)))))
      (do ([i 0 (+ i 1)]) ((= i 3000))
        (guard (c [(quit-condition? c)
                   (when changing? (set! quits-while-changing (+ quits-while-changing 1)))])
          (burn (random 1500))
          (request-quit!)
          (set! changing? #t)
          (do ([j 0 (fx+ j 1)]) ((fx= j 10))
            (add-layer! sets (current-owner-record) #f j #f)
            (add-layer! adds (current-owner-record) #f (if (fxeven? j) car cdr) #f)
            (as-module '(init) (remove-as! adds '(init) car))
            (take-back-all! '(init)))
          (set! changing? #f)
          (let loop () (loop))))
      (check (> quits-while-changing 500))
      (for-each
        (lambda (ls) (check-equal? (map layer-value (layers-in-effect ls)) (layers-value ls)))
        (list sets adds))
      (check-equal? (length (layers-all sets)) (length (filter (lambda (c) (eq? (change-kind c) 'setting)) (owner-changes '(repl)))))
      (take-back-all! '(repl) '(init))
      (check-equal? '() (layers-all sets))
      (check-equal? '() (layers-all adds))
      (check-equal? '() (module-changes '(repl)))))

  ;; Removing takes back the remover's own layer and then hides the
  ;; other's; only a quit between the two leaves the other's alone.
  (test "a quit never leaves a removal half done"
    (let ([adds (entry-layers)] [changing? #f] [quits-while-changing 0] [halves 0])
      (define (burn n) (if (fx= n 0) 0 (fx+ 1 (burn (fx- n 1)))))
      (do ([i 0 (+ i 1)]) ((= i 3000))
        (guard (c [(quit-condition? c)
                   (when changing? (set! quits-while-changing (+ quits-while-changing 1)))
                   (when (equal? '((init)) (owners adds)) (set! halves (+ halves 1)))])
          (burn (random 1500))
          (request-quit!)
          (set! changing? #t)
          (do ([j 0 (fx+ j 1)]) ((fx= j 10))
            (add-as! adds '(repl) car)
            (add-as! adds '(init) car)
            (remove-as! adds '(repl) car)
            (take-back-all! '(init) '(repl)))
          (set! changing? #f)
          (let loop () (loop)))
        (take-back-all! '(init) '(repl)))
      (check (> quits-while-changing 500))
      (check-equal? 0 halves)
      (check-equal? '() (layers-all adds)))))

(post! (lambda ()
         (tests)
         (test-exit)))
(run-main-loop)
