; Folds belong to the session: a new session's blocks start folded,
; though they sit where unfolded ones did.
> (define g (fake-of chat))
> (fake-state-set! g '(("sessionId" . "s-new")))
> (fake-entries-set! g (reverse (list (entry "n1" #f (user-message "New"))
                                      (entry "n2" "n1" (assistant-message "stop" (text-block "Ok")))
                                      (entry "n3" "n2" (assistant-message "stop" (thinking-block "Hmm") (tool-block "t5" "bash" '(("command" . "ls")))
                                                                          (tool-block "t6" "bash" '(("command" . "pwd"))))))))
> (fake-leaf-set! g "n3")
> (result (start! (lambda () (pi:new-session! chat))))
> (wait-until (lambda () (equal? (pi:chat-session-id chat) "s-new")))
