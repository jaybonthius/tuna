; The configuration sets completion:styles to any-order, which puts aside
; the styles plugins give their categories by default: every picker
; matches the words of its input in any order, as Orderless does.
> (define (offered keys text)
    (let ([t (start! (lambda () (apply press! keys)))])
      (testing:wait-until session)
      (type! text)
      (wait-matches (session))
      (let ([r (texts (session))]) (press! "C-g") r)))
> (define (first-spans keys text)
    (let ([t (start! (lambda () (apply press! keys)))])
      (testing:wait-until session)
      (type! text)
      (wait-matches (session))
      (let* ([s (session)] [r (completion:spans s (car (match-list s)))]) (press! "C-g") r)))
> (offered '("M-x") "find file")
("file-picker:find-file" "file-picker:find-file-other-view")
! &cancelled
