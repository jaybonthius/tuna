(layout-split:container ((direction . row)) (layout-float:container () #(views:view ((view . 3) (buffer . "a"))) #(views:view ((view . 6) (buffer . "a") (place box 1/2 1/2)))) #(views:view ((view . 4) (buffer . "a"))))
