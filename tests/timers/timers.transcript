; Arguments are checked; a timer can be made on any thread.
> (timers:run-after -1 ring)
! timers:run-after: not a number of seconds with irritant -1
> (timers:run-after 1 ring 0)
! timers:run-after: not a number of seconds to repeat after with irritant 0
> (timers:run-after 1 'ring)
! timers:run-after: not a procedure with irritant ring
> (timers:cancel! ring)
! timers:cancel!: not a timer with irritant #<procedure ring>
