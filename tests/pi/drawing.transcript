; A batch rewrites only the items that changed, here the reply being
; written: reconciling the whole conversation would take seconds for a
; long session. Point in the prompt follows the reply as it grows.
> (define reconciled '())
> (define (note-reconcile reconcile! b node children)
    (when (eq? b (pi-chat:buffer chat))
      (set! reconciled (cons (document:node-kind node) reconciled)))
    (reconcile! b node children))
> (advice-add! buffers:reconcile! note-reconcile)
> (in-client (lambda () (views:scroll-to! (view) 0 (views:align top))))
> (define (place-kind)
    (let* ([h (html (view))] [key "data-place-kind=\""]
           [i (let loop ([i 0]) (if (string=? (substring h i (+ i (string-length key))) key) (+ i (string-length key)) (loop (+ i 1))))])
      (let loop ([j i]) (if (char=? (string-ref h j) #\") (substring h i j) (loop (+ j 1))))))
> (place-kind)
"top"
