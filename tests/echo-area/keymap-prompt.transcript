; A temporary keymap's prompt shows as the client's keys in progress
; while the keymap is up, on that client only, and is never logged.
> (tables:define-table pick-keymap)
> (commands:define-command (pick) "Stays." (void))
> (keys:bind! pick-keymap "p" pick)
> (define ended '())
> (define end-pick
    (keys:push-keymap! client pick-keymap (lambda (found command) (eq? found pick-keymap))
                       (lambda () (set! ended (cons 'pick ended))) "Pick: "))
> (echo)
"Pick: "
> (echo-for other-client)
#f
> (press! "p")
> (echo)
"Pick: "
; A string prompt is the prompt part, drawn in the prompt look.
> (echo-element)
"<div class=\"echo-area-message\" role=\"status\" data-keymap=\"2 clickable\"><div class=\"echo-area-echo\"><span class=\"echo-area-prompt\">Pick: </span></div></div>"
; A procedure gives the prompt each time the echo is drawn; a pair of a
; face, or #f, and a string is shown text, drawn outside the prompt look.
> (define typed "fo")
> (end-pick)
> ended
(pick)
> (echo)
#f
> (define end-search
    (keys:push-keymap! client pick-keymap (lambda (found command) (eq? found pick-keymap))
                       void (lambda () (list "Failing I-search: " (cons #f typed) (cons 'isearch.fail "x")))))
> (echo-element)
"<div class=\"echo-area-message\" role=\"status\" data-keymap=\"2 clickable\"><div class=\"echo-area-echo\"><span class=\"echo-area-prompt\">Failing I-search: </span>fo<span data-face=\"isearch.fail\">x</span></div></div>"
> (set! typed "foo")
> (echo)
"Failing I-search: foox"
; A message covers the prompt, and a key that leaves the keymap ends it,
; leaving no copy of the prompt.
> (echo-area:message! "Wrapped")
> (echo)
"Wrapped"
> (press! "x")
> (echo)
#f
> (keys:prompt client)
#f
> (messages)
"Wrapped\n"
> (end-search)
; Adjacent strings are one prompt part. A control character shows as ^X
; in escape-glyph, outside the prompt look, in either part.
> (define shown '("[3/17] " "Query replacing a with b: "))
> (define end-shown
    (keys:push-keymap! client pick-keymap (lambda (found command) #t) void (lambda () shown)))
> (echo-element)
"<div class=\"echo-area-message\" role=\"status\" data-keymap=\"2 clickable\"><div class=\"echo-area-echo\"><span class=\"echo-area-prompt\">[3/17] Query replacing a with b: </span></div></div>"
> (set! shown '("Query replacing a\nb with c: "))
> (echo-element)
"<div class=\"echo-area-message\" role=\"status\" data-keymap=\"2 clickable\"><div class=\"echo-area-echo\"><span class=\"echo-area-prompt\">Query replacing a</span><span data-face=\"escape-glyph\">^J</span><span class=\"echo-area-prompt\">b with c: </span></div></div>"
> (set! shown '("Find: " (#f . "a\tb") (isearch.fail . "c\x7f;")))
> (echo-element)
"<div class=\"echo-area-message\" role=\"status\" data-keymap=\"2 clickable\"><div class=\"echo-area-echo\"><span class=\"echo-area-prompt\">Find: </span>a<span data-face=\"escape-glyph\">^I</span>b<span data-face=\"isearch.fail\">c<span data-face=\"escape-glyph\">^?</span></span></div></div>"
> (end-shown)
; A fixed list is a prompt too, with no procedure around it.
> (define end-fixed
    (keys:push-keymap! client pick-keymap (lambda (found command) #t) void (list (cons #f "Repeat with p"))))
> (echo)
"Repeat with p"
> (end-fixed)
; A prompt procedure that raises, or returns what is not a prompt, is
; reported, and no prompt shows.
> (define bad (lambda () (car '())))
> (define end-bad (keys:push-keymap! client pick-keymap (lambda (found command) #t) void (lambda () (bad))))
! (echo-area) car: () is not a pair
> (echo)
"() is not a pair"
> (map (lambda (value) (set! bad (lambda () value)) (echo-area:message! "") (echo)) (list '((3 . "fo")) '(("fo" . #f)) '()))
! (echo-area) keys:push-keymap!: a prompt procedure returned what is not a prompt or #f with irritant ((3 . "fo"))
! (echo-area) keys:push-keymap!: a prompt procedure returned what is not a prompt or #f with irritant (("fo" . #f))
! (echo-area) keys:push-keymap!: a prompt procedure returned what is not a prompt or #f with irritant ()
(#f #f #f)
> (end-bad)
> (map (lambda (bad) (guard (c [#t (condition-message c)]) (keys:push-keymap! client pick-keymap (lambda (found command) #t) void bad)))
       (list '() '("not" ("allowed" . #f)) 'x))
("not a prompt, a procedure or #f" "not a prompt, a procedure or #f" "not a prompt, a procedure or #f")
