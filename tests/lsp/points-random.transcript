; Whole-text edits between random texts give the server's text.
> (lsp:define-server shaper (fake-command "shaper"))
> (define path (string-append project "/r.fk"))
> (write-file! path "\n")
> (define (whole! new)
    (configure! "shaper" '(capabilities ("textDocumentSync" . 2) ("documentFormattingProvider" . #t))
                         `(responses ("textDocument/formatting" . ,(vector `(("range" ("start" ("line" . 0) ("character" . 0)) ("end" ("line" . 1000) ("character" . 0))) ("newText" . ,new)))))
                         '(name . "shaper")))
> (whole! "")
> (tables:set! lsp:language-servers "fakelang" (list shaper))
> (hooks:add! fake-mode-hook lsp:ensure)
> (define c (visit! path))
> (wait-for "shaper" "textDocument/didOpen")
> (random-seed 7)
> (define (random-text) (list->string (map (lambda (i) (string-ref "ab \n" (random 4))) (iota (random 30)))))
> (let loop ([n 0] [wrong '()])
    (if (= n 40)
        wrong
        (let ([old (random-text)] [new (random-text)])
          (whole! new)
          (buffers:replace! c 1 (- (document:length (buffers:document c)) 1) old)
          (in-client (lambda () (lsp:format-buffer c)))
          (loop (+ n 1) (if (equal? (text c) new) wrong (cons (list old new (text c)) wrong))))))
()
