#!tuna
(define %pending '())
(define (ask question resume)
  (set! %pending (cons resume %pending)))
(define (answer! v)
  (let ([resume (car %pending)])
    (set! %pending (cdr %pending))
    (resume (lambda () v))))
(define (yes-or-no? question) (ask question (lambda (thunk) (thunk))))
(define (y-or-n? question) 'y-or-n)
