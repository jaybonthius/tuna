; RET ends the prompt only when its input reads as one expression with
; nothing after it but whitespace and comments. Otherwise the prompt goes
; on, shows why after its input, and moves point to where reading
; stopped.
> (define notes (show! (buffers:make "notes" "alpha\n")))
> (define t (start! "M-:"))
> (type! "(+ 1")
> (press! "RET")
> (list (input) (prompt-message) (input-point))
("(+ 1" " [unexpected end-of-file reading list]" 4)
> (press! "C-a" "C-k" "RET")
> (list (input) (prompt-message))
("" " [no expression]")
; Point goes before the text after the expression, and no mark is set.
> (type! "1 2")
> (press! "RET")
> (list (prompt-message) (input-point) (views:mark (minibuffer:prompt-view (prompt))))
(" [text after the expression]" 2 #f)
> (press! "C-a" "C-k")
> (type! "1 ;; one")
> (press! "RET")
> (finish t)
#t
> (message)
"1"
; C-j ends it as RET does.
> (define t (start! "M-:"))
> (type! "(+ 1 2)")
> (press! "C-j")
> (finish t)
#t
> (message)
"3"
; C-g closes the prompt and evaluates nothing; the history does not
; gain the input. A prompt's C-g quits without the message Quit.
> (define t (start! "M-:"))
> (type! "(+ 1")
> (press! "C-g")
! &quit
> (finish t)
#t
> (list (prompt) (message) (eval:expression-history))
(#f #f ("(+ 1 2)" "1 ;; one"))
; M-p recalls the newest input first. M-: has a history of its own, which
; other prompts' inputs do not reach, and which is saved.
> (set-saved! minibuffer:history '("from another prompt"))
> (define t (start! "M-:"))
> (press! "M-p")
> (input)
"(+ 1 2)"
> (press! "M-p")
> (input)
"1 ;; one"
> (press! "M-p")
! minibuffer:previous-history: beginning of history
> (input)
"1 ;; one"
> (press! "C-g")
! &quit
> (finish t)
#t
> (saved? eval:expression-history)
#t
; TAB completes the Scheme name before point from the REPL's names,
; listing the candidates at once, as completion at point does everywhere;
; TAB again completes the sole one.
> (define t (start! "M-:"))
> (type! "(buffers:ins")
> (press! "TAB")
> (wait-until (lambda () (and (session) (not (completion:session-busy? (session))))))
> (session-texts)
("buffers:insert!")
> (press! "TAB")
> (list (input) (session))
("(buffers:insert!" #f)
> (press! "C-a" "C-k")
; After a quote, completion starts after the quote.
> (import (greet))
> (type! "'greet:te")
> (press! "TAB")
> (wait-until (lambda () (and (session) (not (completion:session-busy? (session))))))
> (press! "TAB")
> (input)
"'greet:text"
> (press! "C-g")
! &quit
> (finish t)
#t
; Another prompt gets no Scheme names: eval's entry of
; completion:find-region answers only in M-:'s prompt.
> (define other (spawn-task (lambda () (in-client (lambda () (minibuffer:read "Other: "))))))
> (wait-until (lambda () (prompt)))
> (type! "buffers:ins")
> (press! "M-TAB")
> (list (input) (session))
("buffers:ins" #f)
> (press! "C-g")
! &quit
> (finish other)
#t
; An entry of eval:expression-prompt-started runs once, with the
; prompt, before minibuffer:prompt-started, and before any key is read.
; A keymap it adds works in this prompt only.
> (define calls '())
> (define-table own-keymap "Keys the test adds to the prompt.")
> (commands:define-command (mark-it) "Notes a key." (set! calls (cons 'key calls)))
> (keys:bind! own-keymap "C-c C-c" mark-it)
> (define (add-own p) (set! calls (cons (minibuffer:prompt? p) calls)) (minibuffer:add-keymap! p own-keymap))
> (define (note-started p) (set! calls (cons 'started calls)))
> (add-hook! eval:expression-prompt-started add-own)
> (add-hook! minibuffer:prompt-started note-started)
> (define t (start! "M-:"))
> (reverse calls)
(#t started)
> (press! "C-c" "C-c")
> (reverse calls)
(#t started key)
> (press! "C-g")
! &quit
> (finish t)
#t
> (remove-hook! eval:expression-prompt-started add-own)
> (define other (spawn-task (lambda () (in-client (lambda () (minibuffer:read "Other: "))))))
> (wait-until (lambda () (prompt)))
> (press! "C-c" "C-c")
! C-c C-c is undefined
> (reverse calls)
(#t started key started)
> (press! "C-g")
! &quit
> (finish other)
#t
