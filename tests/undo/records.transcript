; undo:take-records! gives a history's changes as records: the whole
; history the first time, then what changed since.
> (define r (buffers:make "records" "\n"))
> (define (in-r command . args) (buffers:with-buffer r (apply commands:run command args)))
> (define (shapes records) (map (lambda (x) (list (car x) (cadr x))) records))
> (undo:take-records! r)
#f
> (in-r checks:insert 1 "a")
#<edit 1>
> (shapes (undo:take-records! r))
((undo-history 1) (group 1) (at 1))
> (undo:take-records! r)
()
> (in-r checks:insert 2 "b")
#<edit 2>
> (let ([g (car (undo:take-records! r))])
    (list (car g) (cadr g) (caddr g) (list-ref g 4)
          (map (lambda (e) (list (vector-ref e 0) (document:datums (vector-ref e 1)) (document:datums (vector-ref e 2))))
               (list-tail g 5))))
(group 2 1 () ((2 () ("b"))))
> (in-r undo:undo 1)
> (undo:take-records! r)
((at 1))
> (shapes (undo:take-all-records! r))
((undo-history 1) (group 1) (group 2) (at 1))
; A history built from records holds the same tree. Given the text of
; one of its states, it gives the text of its current state.
> (define-values (copy fits?) (undo:records->history (undo:take-all-records! r)))
> fits?
#t
> (document:text (undo:current-document copy 0 (document:from-datum '(buffers:text () "\n"))))
"a\n"
> (document:text (undo:current-document copy 2 (document:from-datum '(buffers:text () "ab\n"))))
"a\n"
> (list (undo:current-document copy 2 (document:from-datum '(buffers:text () "xyz\n")))
        (undo:current-document copy 9 (document:from-datum '(buffers:text () "\n"))))
(#f #f)
; Installed on a buffer holding the text of its current state, it is
; that buffer's history.
> (define r2 (buffers:make "copy" "a\n"))
> (undo:install! r2 copy 0)
#t
> (tree r2)
(1 1 (0 #f) (1 0) (2 1))
> (buffers:with-buffer r2 (commands:run undo:redo 1))
> (list (text r2) (buffers:modified? r2))
("ab\n" #t)
> (buffers:with-buffer r2 (commands:run undo:undo 2))
> (text r2)
"\n"
> (raised (lambda () (undo:install! r copy 0)))
(undo:install! "not a history on no buffer")
; A buffer last marked unmodified at the version holds the saved state's
; text, and install moves it on to the current state.
> (define-values (again fits?) (undo:records->history (undo:take-all-records! r)))
> (define r3 (buffers:make "saved" "\n"))
> (undo:install! r3 again 0 0)
#t
> (list (text r3) (buffers:modified? r3) (tree r3))
("a\n" #t (1 0 (0 #f) (1 0) (2 1)))
> (buffers:with-buffer r3 (commands:run undo:undo 1))
> (list (text r3) (buffers:modified? r3))
("\n" #f)
; A buffer marked modified holds the current state's text, and the saved
; state becomes the one undo marks unmodified.
> (define-values (third fits?) (undo:records->history (undo:take-all-records! r)))
> (define r4 (buffers:make "unsaved" "a\n"))
> (buffers:set-modified! r4 #t)
> (undo:install! r4 third 0 0)
#t
> (buffers:with-buffer r4 (commands:run undo:undo 1))
> (list (text r4) (buffers:modified? r4))
("\n" #f)
; A state whose text is not as long as the buffer's installs nothing.
> (define-values (fourth fits?) (undo:records->history (undo:take-all-records! r)))
> (undo:install! (buffers:make "longer" "abc\n") fourth 0)
#f
; Replaying stops at the first record that does not fit.
> (let-values ([(h fits?) (undo:records->history '((undo-history 1 0 2 0) (group 1 7 0 () #(1 #f #f))))]) (list (and h #t) fits?))
(#t #f)
> (let-values ([(h fits?) (undo:records->history '((at 1)))]) (list h fits?))
(#f #f)
> (raised (lambda () (undo:records->history 'records)))
(undo:records->history "not a list")
; undo:attach! holds a buffer's edits until undo:install!, which adds
; them to the history it installs; meanwhile a task asking for the
; history waits.
> (define a (buffers:make "attached" "\n"))
> (list (undo:attach! a) (undo:attach! a))
(#t #f)
> (buffers:replace! a 1 1 "x")
#<edit 1>
> (define waiter (spawn-task (lambda () (car (undo:history a)))))
> (undo:install! a #f 0)
#t
> (join-task waiter)
1
> (list (tree a) (undo:attach! a))
((1 0 (0 #f) (1 0)) #f)
> (buffers:with-buffer a (commands:run undo:undo 1))
> (list (text a) (buffers:modified? a))
("\n" #f)
