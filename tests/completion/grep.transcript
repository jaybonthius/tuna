; Several words join into one zero-width look-ahead at the line's start,
; so rg's column is the line's start, and so is the location's.
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "needle h")
> (wait-matches s)
> (map (lambda (m) (cons (completion:text s m) (cdr (completion:value s m)))) (match-list s))
(("c.txt:1:héllo needle" 1 . 0))
> (press! "RET")
> (result t)
> (views:point (view))
1
