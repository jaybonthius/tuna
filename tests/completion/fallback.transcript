; A fallback region whose sources find nothing for its text gives way to
; the region of the next entry of completion:find-region; a region made
; with completion:region does not.
> (define b (buffers:make "fallback" ""))
> (views:set-buffer! (view) b)
> (define (word-start)
    (let* ([v (views:current)] [buffer (views:buffer v)] [p (views:point v)]
           [s (editing:forward-word-position buffer p -1)])
      (and (< s p) (= (editing:forward-word-position buffer s 1) p) s)))
> (define (greek)
    (let ([s (word-start)])
      (and s (completion:fallback-region s (views:point (views:current))
               (list (completion:source (candidates (vector "alpha" "almond"))))))))
> (define (zeds)
    (let ([s (word-start)])
      (and s (completion:region s (views:point (views:current))
               (list (completion:source (candidates (vector "zeta" "zero"))))))))
> (add-hook! completion:find-region greek -2)
> (add-hook! completion:find-region zeds -1)
> (type! "al")
> (press! "C-M-i")
> (texts (session))
("alpha" "almond")
> (press! "C-g" "RET")
> (type! "ze")
> (press! "C-M-i")
> (texts (session))
("zero" "zeta")
> (press! "C-g" "RET")
; An exclusive region keeps its session though nothing matches, and
; C-M-i says so once.
> (type! "q")
> (press! "C-M-i")
> (texts (session))
()
> (echo-area:current-message)
"No match"
> (type! "q")
> (echo-area:current-message)
#f
> (press! "C-g" "DEL" "RET")
; Typing on in a fallback session until nothing matches gives way too:
; after x, the session is the next entry's, whose candidates follow.
> (type! "al")
> (press! "C-M-i")
> (texts (session))
("alpha" "almond")
> (type! "x")
> (texts (session))
()
> (press! "DEL" "DEL")
> (texts (session))
("zeta")
> (press! "C-g" "RET")
> (text b)
"al\nze\nq\na\n"
; A stream gives way once it has said done.
> (define (empty-stream)
    (let ([s (word-start)])
      (and s (completion:fallback-region s (views:point (views:current))
               (list (completion:source (job one-at-a-time 0)))))))
> (add-hook! completion:find-region empty-stream -3)
> (type! "al")
> (press! "C-M-i")
> (testing:wait-until (lambda () (let ([s (session)]) (and s (pair? (texts s))))))
> (texts (session))
("alpha" "almond")
> (press! "C-g" "RET")
; When the last fallback gives way to no region, C-M-i says No match once
; the stream has said done; completion that starts by itself says nothing.
> (remove-hook! completion:find-region zeds)
> (remove-hook! completion:find-region words:complete-word)
> (type! "xy")
> (press! "C-M-i")
> (testing:wait-until (lambda () (equal? (echo-area:current-message) "No match")))
> (list (session) (echo-area:current-message))
(#f "No match")
> (press! "SPC")
> (type! "xy")
> (in-client (lambda () (completion:start-at-point 0)))
#t
> (sleep-for 0.3)
> (list (session) (echo-area:current-message))
(#f #f)
> (add-hook! completion:find-region zeds -1)
> (add-hook! completion:find-region words:complete-word 10)
> (press! "DEL" "DEL" "DEL" "DEL" "DEL" "C-g")
> (remove-hook! completion:find-region empty-stream)
; completion:start-from-entry uses one entry, ignoring the hook, and
; returns whether the entry gave a region; a fallback region that finds
; nothing, with no entry after it, starts no session and calls the
; procedure given for that.
> (type! "al")
> (in-client (lambda () (completion:start-from-entry zeds)))
#t
> (texts (session))
()
> (press! "C-g")
> (in-client (lambda () (completion:start-from-entry greek)))
#t
> (texts (session))
("alpha" "almond")
> (press! "C-g")
> (type! "q")
> (define said 0)
> (in-client (lambda () (completion:start-from-entry greek (lambda () (set! said (+ said 1))))))
#t
> (list (session) said)
(#f 1)
> (press! "SPC")
> (in-client (lambda () (completion:start-from-entry greek)))
#f
> (raised (lambda () (completion:start-from-entry 'greek)))
(completion:start-from-entry "not a procedure")
> (raised (lambda () (completion:start-at-point 0 "No match")))
(completion:start-at-point "not a procedure")
> (raised (lambda () (completion:fallback-region 3 1 '())))
(completion:fallback-region "not a start and an end")
> (press! "RET")
> (remove-hook! completion:find-region greek)
; A file name at point completes from its folder, and gives way where
; the folder does not exist; text before point without a slash is no
; file name.
> (add-hook! completion:find-region file-picker:file-name-region -2)
> (type! "~/notes/")
> (press! "C-M-i")
> (testing:wait-until (lambda () (let ([s (session)]) (and s (not (completion:session-busy? s))))))
> (texts (session))
("sub/" "a.txt")
> (type! "s")
> (wait-matches (session))
> (texts (session))
("sub/")
> (press! "TAB" "C-g" "RET")
> (type! "~/nothere/ze")
> (press! "C-M-i")
> (testing:wait-until (lambda () (let ([s (session)]) (and s (pair? (texts s))))))
> (texts (session))
("zero" "zeta")
> (press! "C-g" "RET")
; A ~/ after a folder starts the name again here too.
> (type! "/nowhere/~/notes/")
> (press! "C-M-i")
> (testing:wait-until (lambda () (let ([s (session)]) (and s (not (completion:session-busy? s))))))
> (texts (session))
("sub/" "a.txt")
> (press! "C-g" "RET")
> (type! "ze")
> (press! "C-M-i")
> (texts (session))
("zero" "zeta")
> (press! "C-g")
> (text b)
"al\nze\nq\na\nal\nalq \n~/notes/sub/\n~/nothere/ze\n/nowhere/~/notes/\nze"
> (remove-hook! completion:find-region zeds)
> (remove-hook! completion:find-region file-picker:file-name-region)
