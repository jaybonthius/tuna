; C-x <left> and C-x <right> step through the selected view's buffer
; history, by Emacs's previous-buffer and next-buffer; a count steps that
; many times.
> (define c1 (web:add-client! 1))
> (define (named name) (buffers:make name (string-append name "\n")))
> (define (shown) (buffers:name (views:buffer (layout:selected-view))))
> (define one (named "one"))
> (define two (named "two"))
> (define three (named "three"))
> (layout:switch-to-buffer one)
> (layout:switch-to-buffer two)
> (layout:switch-to-buffer three)
> (press! c1 '("x" "control") '("ArrowLeft"))
> (shown)
"two"
> (press! c1 '("x" "control") '("ArrowLeft"))
> (shown)
"one"
> (press! c1 '("x" "control") '("ArrowRight"))
> (shown)
"two"
> (press! c1 '("x" "control") '("ArrowRight" "control"))
> (shown)
"three"
> (press! c1 '("u" "control") '("2") '("x" "control") '("ArrowLeft"))
> (shown)
"one"
; A step is no use: the buffers keep the order C-x b left them in.
> (map buffers:name (list-head (remp (lambda (b) (buffers:internal-name? (buffers:name b))) (buffers:all)) 2))
("three" "two")
; With nothing to step to, they say so.
> (define lonely (views:make (named "lonely")))
> (remp buffers:kill! (remp (lambda (b) (or (string=? (buffers:name b) "lonely") (buffers:internal-name? (buffers:name b)))) (buffers:all)))
()
> (set-parts! (atom lonely))
> (layout:select! lonely)
> (raised (lambda () (layout:previous-buffer 1)))
(layout:previous-buffer "No previous buffer")
> (raised (lambda () (layout:next-buffer 1)))
(layout:next-buffer "No next buffer")
; They refuse a locked view.
> (define four (named "four"))
> (define echo (layout:display-buffer (named "*Echo*") (layout-split:display-at-side (layout:direction down) 90 'content '((locked . #t)))))
> (layout:select! echo)
> (raised (lambda () (layout:previous-buffer 1)))
(layout:previous-buffer "a locked part")
> (layout:select! lonely)
; q buries the buffer a display did not make the part for: it goes to
; the back of buffers:all and the view shows its previous buffer. With
; nothing to show, q raises and the view stays.
> (define five (named "five"))
> (layout:switch-to-buffer four)
> (layout:switch-to-buffer five)
> (commands:run layout:quit-view)
> (list (shown) (buffers:name (list-ref (buffers:all) (- (length (buffers:all)) 1))))
("four" "five")
> (commands:run layout:bury-buffer)
> (shown)
"lonely"
> (remp buffers:kill! (remp (lambda (b) (or (string=? (buffers:name b) "lonely") (buffers:internal-name? (buffers:name b)))) (buffers:all)))
()
> (commands:run layout:quit-view)
! layout:quit-view: no other buffer to show
> (shown)
"lonely"
