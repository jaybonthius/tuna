; A prefix command hands the next command a wrapper with
; keys:wrap-next-command!; the client keeps it beside its prefix
; argument, and keys runs the next command a key or click runs inside
; it, the newest wrapper innermost.
> (define one (layout:current-frame))
> (define seen '())
> (define (take-seen!) (let ([s (reverse seen)]) (set! seen '()) s))
> (define marker (make-thread-parameter #f))
> (commands:define-command (note)
    "Notes the marker, the prefix argument and the last command."
    (set! seen (cons (list (marker) (commands:prefix-argument) (name-of (commands:last-command))) seen)))
> (define (marking value) (lambda (run) (parameterize ([marker (cons value (or (marker) '()))]) (run))))
> (commands:define-command (mark-a) "Hands the next command a wrapper." (keys:wrap-next-command! (marking 'a) "C-c a"))
> (commands:define-command (mark-b) "Hands the next command another." (keys:wrap-next-command! (marking 'b) "C-c b"))
> (keys:bind! keys:global "C-c n" note)
> (keys:bind! keys:global "C-c a" mark-a)
> (keys:bind! keys:global "C-c b" mark-b)
> (press-all! one "C-x" "o" "C-c" "a" "C-c" "n" "C-c" "n")
> (take-seen!)
(((a) #f layout:other-view) (#f #f note))
> (press-all! one "C-c" "a" "C-c" "b" "C-c" "n")
> (take-seen!)
(((b a) #f note))
; A prefix command keeps the wrappers it was handed for the command
; after, so a wrapper passes through C-u, as Emacs's prefixes do; and the
; keys in progress describe them before the prefix argument.
> (press-all! one "C-c" "a" "C-u")
> (keys:prefix-description one)
"C-c a C-u"
> (press-all! one "C-c" "n")
> (take-seen!)
(((a) (4) note))
; A prefix argument typed before a wrapper's prefix command is spent by
; it.
> (press-all! one "C-u" "C-c" "a" "C-c" "n")
> (take-seen!)
(((a) #f note))
; Input that is no key, such as a paste, leaves the wrapper waiting.
> (press-all! one "C-c" "a")
> (keys:run-as-input one note)
> (press-all! one "C-c" "n")
> (take-seen!)
((#f #f note) ((a) #f note))
; Each client has its own.
> (press-all! one "C-c" "a")
> (press-all! (layout:other-frame) "C-c" "n")
> (press-all! one "C-c" "n")
> (take-seen!)
((#f #f note) ((a) #f note))
; C-g drops a waiting wrapper, and does no more: it quits no paused
; command, as it would with nothing waiting.
> (commands:define-command (wait)
    "Waits until resumed or quit."
    (suspend (lambda (resume) #f)))
> (keys:bind! keys:global "C-c w" wait)
> (define waiting (spawn-task (lambda () (press-all! one "C-c" "w"))))
> (sleep-for 0.1)
> (press-all! one "C-c" "a")
> (keys:prefix-description one)
"C-c a"
> (press-all! one "C-g")
> (sleep-for 0.1)
> (list (keys:prefix-description one) (task-done? waiting))
(#f #f)
> (press-all! one "C-g")
> (wait-until (lambda () (task-done? waiting)))
! &quit
> (task-done? waiting)
#t
> (raised (lambda () (keys:wrap-next-command! (marking 'c) "C-c c")))
(keys:wrap-next-command! "no key or click is being handled")
> (raised (lambda () (keys:wrap-next-command! 'c "C-c c")))
(keys:wrap-next-command! "not a procedure")
