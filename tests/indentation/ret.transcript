; RET in a Scheme buffer, each case as Emacs's Scheme mode gives it with
; electric-indent-mode on: the cursor is ‸.
; eol after (define (f x)
> (after "(define (f x)‸" "RET")
"(define (f x)\n  ‸"
; eol after (define (f x), twice
> (after "(define (f x)‸" "RET" "RET")
"(define (f x)\n\n  ‸"
; M-2 RET
> (after "(define (f x)‸" "M-2" "RET")
"(define (f x)\n\n  ‸"
; mid line before (g x)
> (after "(define (f x) ‸(g x))" "RET")
"(define (f x)\n  ‸(g x))"
; mid line, blanks on both sides
> (after "(define (f x)  ‸ (g x))" "RET")
"(define (f x)\n  ‸(g x))"
; inside a string
> (after "(define (f x)\n  (display \"hello‸ world\"))" "RET")
"(define (f x)\n  (display \"hello\n‸ world\"))"
; inside a string, after a blank
> (after "(display \"hello ‸world\")" "RET")
"(display \"hello\n‸world\")"
; inside a string, before blanks
> (after "(display \"hello‸   world\")" "RET")
"(display \"hello\n‸   world\")"
; eol inside an open string
> (after "(define (f x)\n  (display \"hello‸" "RET")
"(define (f x)\n  (display \"hello\n‸"
; ending a line that starts in a string
> (after "(f \"a\n   b ‸c\")" "RET")
"(f \"a\n   b\n‸c\")"
; in a trailing comment
> (after "(define (f x) ; a comm‸ent here\n  x)" "RET")
"(define (f x) ; a comm\n  ‸ent here\n  x)"
; in a trailing comment, after a blank
> (after "(f x) ; one‸ two" "RET")
"(f x) ; one\n‸two"
; eol after a trailing comment
> (after "(define (f x) ; c‸" "RET")
"(define (f x) ; c\n  ‸"
; eol of a ;; comment line in a body
> (after "(define (f x)\n  ;; note‸\n  x)" "RET")
"(define (f x)\n  ;; note\n  ‸\n  x)"
; eol of a ; comment line in a body
> (after "(define (f x)\n  ; note‸\n  x)" "RET")
"(define (f x)\n                                        ; note\n  ‸\n  x)"
; eol of a ;;; comment line
> (after ";;; Header‸" "RET")
";;; Header\n‸"
; eol after (let ((a 1))
> (after "(define (f x)\n  (let ((a 1))‸" "RET")
"(define (f x)\n  (let ((a 1))\n    ‸"
; eol after (let ((a 1)
> (after "(define (f x)\n  (let ((a 1)‸" "RET")
"(define (f x)\n  (let ((a 1)\n        ‸"
; eol after (let ([a 1]
> (after "(define (f x)\n  (let ([a 1]‸" "RET")
"(define (f x)\n  (let ([a 1]\n        ‸"
; eol after (let ((a 1) (b 2))
> (after "(let ((a 1)\n      (b 2))‸" "RET")
"(let ((a 1)\n      (b 2))\n  ‸"
; eol after (let loop ((i 0))
> (after "(let loop ((i 0))‸" "RET")
"(let loop ((i 0))\n  ‸"
; eol after a named let's first body form
> (after "(let loop ((i 0))\n  (f i)‸" "RET")
"(let loop ((i 0))\n  (f i)\n  ‸"
; eol after (let
> (after "(let‸" "RET")
"(let\n    ‸"
; eol after (let loop
> (after "(let loop‸" "RET")
"(let loop\n    ‸"
; eol after (let ()
> (after "(let ()‸" "RET")
"(let ()\n  ‸"
; eol after let's bindings on their own line
> (after "(let\n    ((a 1))‸" "RET")
"(let\n    ((a 1))\n  ‸"
; eol after [let ([a 1])
> (after "[let ([a 1])‸" "RET")
"[let ([a 1])\n  ‸"
; eol after (if c
> (after "(if c‸" "RET")
"(if c\n    ‸"
; (if c RET a RET
> (after "(if c‸" "RET" "a" "RET")
"(if c\n    a\n    ‸"
; eol after (if c a
> (after "(if c a‸" "RET")
"(if c a\n    ‸"
; eol after (if
> (after "(if‸" "RET")
"(if\n ‸"
; eol after (lambda (x)
> (after "(lambda (x)‸" "RET")
"(lambda (x)\n  ‸"
; eol after (lambda
> (after "(lambda‸" "RET")
"(lambda\n    ‸"
; eol after (when c
> (after "(when c‸" "RET")
"(when c\n  ‸"
; eol after (when c, then a body form
> (after "(when c\n  a‸" "RET")
"(when c\n  a\n  ‸"
; eol after (unless c
> (after "(unless c‸" "RET")
"(unless c\n  ‸"
; eol after (case x
> (after "(case x‸" "RET")
"(case x\n  ‸"
; eol after (do ((i 0 (+ i 1)))
> (after "(do ((i 0 (+ i 1)))‸" "RET")
"(do ((i 0 (+ i 1)))\n    ‸"
; eol after do's test
> (after "(do ((i 0 (+ i 1)))\n    ((= i n))‸" "RET")
"(do ((i 0 (+ i 1)))\n    ((= i n))\n  ‸"
; eol after (syntax-rules ()
> (after "(define-syntax m\n  (syntax-rules ()‸" "RET")
"(define-syntax m\n  (syntax-rules ()\n    ‸"
; eol after (syntax-case x ()
> (after "(syntax-case x ()‸" "RET")
"(syntax-case x ()\n  ‸"
; eol after (library (foo)
> (after "(library (foo)‸" "RET")
"(library (foo)\n  ‸"
; eol after (library (foo) (export f)
> (after "(library (foo)\n  (export f)‸" "RET")
"(library (foo)\n  (export f)\n  ‸"
; eol after (library
> (after "(library‸" "RET")
"(library\n    ‸"
; eol after (dynamic-wind
> (after "(dynamic-wind‸" "RET")
"(dynamic-wind\n    ‸"
; eol after (define-record-type point
> (after "(define-record-type point‸" "RET")
"(define-record-type point\n  ‸"
; eol after (define-syntax m
> (after "(define-syntax m‸" "RET")
"(define-syntax m\n  ‸"
; eol after (define-foo x
> (after "(define-foo x‸" "RET")
"(define-foo x\n  ‸"
; eol after (define x
> (after "(define x‸" "RET")
"(define x\n  ‸"
; eol after (def a
> (after "(def a‸" "RET")
"(def a\n     ‸"
; eol after (defin a
> (after "(defin a‸" "RET")
"(defin a\n  ‸"
; eol after (let-values (((a b) (f)))
> (after "(let-values (((a b) (f)))‸" "RET")
"(let-values (((a b) (f)))\n  ‸"
; eol after (parameterize ([p 1])
> (after "(parameterize ([p 1])‸" "RET")
"(parameterize ([p 1])\n  ‸"
; eol after (call-with-values
> (after "(call-with-values‸" "RET")
"(call-with-values\n    ‸"
; eol after (case-lambda
> (after "(case-lambda‸" "RET")
"(case-lambda\n ‸"
; eol after (with-x a
> (after "(with-x a‸" "RET")
"(with-x a\n        ‸"
; eol after (cond
> (after "(cond‸" "RET")
"(cond\n ‸"
; eol after (cond [a
> (after "(cond [a‸" "RET")
"(cond [a\n       ‸"
; eol after (foo a
> (after "(foo a‸" "RET")
"(foo a\n     ‸"
; eol after (foo
> (after "(foo‸" "RET")
"(foo\n ‸"
; eol after a call's second line
> (after "(foo a\n     b‸" "RET")
"(foo a\n     b\n     ‸"
; eol after a head alone, then a line of arguments
> (after "(foo\n     bar baz‸" "RET")
"(foo\n bar baz\n ‸"
; eol after ( foo a, a blank after the bracket
> (after "( foo a‸" "RET")
"( foo a\n  ‸"
; eol after (f, then a line of arguments
> (after "(f\n  a b‸" "RET")
"(f\n a b\n ‸"
; eol after (f a, then a line of arguments
> (after "(f a\n b c‸" "RET")
"(f a\n   b c\n   ‸"
; eol after ((f x)
> (after "((f x)‸" "RET")
"((f x)\n ‸"
; eol after ((a) b
> (after "((a) b‸" "RET")
"((a) b\n ‸"
; eol after ((a), then b
> (after "((a)\n b‸" "RET")
"((a)\n b\n ‸"
; eol after ("s" a
> (after "(\"s\" a‸" "RET")
"(\"s\" a\n ‸"
; eol after (1 2
> (after "(1 2‸" "RET")
"(1 2\n   ‸"
; eol after (#t a
> (after "(#t a‸" "RET")
"(#t a\n    ‸"
; eol after '(a b
> (after "'(a b‸" "RET")
"'(a b\n    ‸"
; eol after #(1 2
> (after "#(1 2‸" "RET")
"#(1 2\n    ‸"
; eol after #'(f a
> (after "#'(f a‸" "RET")
"#'(f a\n     ‸"
; eol after `(f ,(g a
> (after "`(f ,(g a‸" "RET")
"`(f ,(g a\n        ‸"
; eol after (f #;(a b)
> (after "(f #;(a b)‸" "RET")
"(f #;(a b)\n ‸"
; eol after (f #| c |# a
> (after "(f #| c |# a‸" "RET")
"(f #| c |# a\n           ‸"
; eol after (f "x"
> (after "(f \"x\"‸" "RET")
"(f \"x\"\n   ‸"
; eol after (f a ; c
> (after "(f a ; c‸" "RET")
"(f a ; c\n   ‸"
; nested (f (g (h x
> (after "(f (g (h x‸" "RET")
"(f (g (h x\n         ‸"
; after a closed argument, (f (g x)
> (after "(f (g x)‸" "RET")
"(f (g x)\n   ‸"
; after a complete top-level form
> (after "(define x 1)‸" "RET")
"(define x 1)\n‸"
; at the start of the buffer
> (after "‸(f x)" "RET")
"\n‸(f x)"
; a blank line between forms
> (after "(define x 1)\n‸\n(define y 2)" "RET")
"(define x 1)\n\n‸\n(define y 2)"
; a blank line in a body
> (after "(define (f x)\n‸\n  x)" "RET")
"(define (f x)\n\n  ‸\n  x)"
; an indented blank line in a body
> (after "(define (f x)\n    ‸\n  x)" "RET")
"(define (f x)\n\n  ‸\n  x)"
; at the start of an indented line
> (after "(define (f x)\n‸  (g x))" "RET")
"(define (f x)\n\n  ‸(g x))"
; inside the indentation
> (after "(define (f x)\n ‸ (g x))" "RET")
"(define (f x)\n\n  ‸(g x))"
; ending a misindented line
> (after "(define (f x)\n      (g x)‸" "RET")
"(define (f x)\n  (g x)\n  ‸"
; ending a line with trailing blanks
> (after "(define (f x)   ‸" "RET")
"(define (f x)\n  ‸"
; before closing brackets
> (after "(define (f x)\n  (g x‸))" "RET")
"(define (f x)\n  (g x\n     ‸))"
; before the last closing bracket
> (after "(define (f x)\n  (g x)‸)" "RET")
"(define (f x)\n  (g x)\n  ‸)"
; ending a line that closes the form
> (after "(define (f x)\n      (g x))‸" "RET")
"(define (f x)\n  (g x))\n‸"
; in a block comment: Emacs indents the comment's lines as code; Tuna
; leaves a line that starts in a comment begun above as it is
> (after "(f #| a\n      b ‸c |# x)" "RET")
"(f #| a\n      b\n‸c |# x)"
; with a region, RET leaves it
> (after "(define (f x) ‸(g x))" "C-SPC" "C-e" "RET")
"(define (f x) (g x))\n‸"
; eol after (define-option name #f boolean?
> (after "(define-option on-type-formatting? #f boolean?‸" "RET")
"(define-option on-type-formatting? #f boolean?\n  ‸"
; eol after (define-condition-type &c &error
> (after "(define-condition-type &c &error‸" "RET")
"(define-condition-type &c &error\n  ‸"
; eol after (define x 1
> (after "(define x 1‸" "RET")
"(define x 1\n  ‸"
; eol after (define-foo a b
> (after "(define-foo a b‸" "RET")
"(define-foo a b\n  ‸"
; eol after (define
> (after "(define‸" "RET")
"(define\n  ‸"
; eol after a define's first argument on its own line
> (after "(define\n  x‸" "RET")
"(define\n  x\n  ‸"
; eol after (define (f x) (g x)
> (after "(define (f x) (g x)‸" "RET")
"(define (f x) (g x)\n  ‸"
; eol after two body forms on the second line
> (after "(define (f x)\n  (g x) (h x)‸" "RET")
"(define (f x)\n  (g x) (h x)\n  ‸"
; eol after (syntax-rules
> (after "(syntax-rules‸" "RET")
"(syntax-rules\n  ‸"
; eol after a syntax-rules clause
> (after "(define-syntax m\n  (syntax-rules ()\n    [(_ a) a]‸" "RET")
"(define-syntax m\n  (syntax-rules ()\n    [(_ a) a]\n    ‸"
; eol after (def a b
> (after "(def a b‸" "RET")
"(def a b\n     ‸"
; eol after a tab and blanks
> (after "(list\n\t(g a\n\t   b‸" "RET")
"(list\n\t(g a\n\t   b\n           ‸"
; eol after a let's bindings indented with a tab
> (after "(define (f)\n\t(let ((a 1)\n\t      (b 2))‸" "RET")
"(define (f)\n\t(let ((a 1)\n\t      (b 2))\n          ‸"
; a line break deleted again after a question joins the two atoms
> (after "(foo‸bar" "RET" "DEL" "DEL" "C-e" "RET")
"(foobar\n ‸"
> (after "(list‸-ref xs 1" "RET" "DEL" "DEL" "C-e" "RET")
"(list-ref xs 1\n          ‸"
; an undone blank, after a question, joins the two atoms
> (after "(foo‸bar" "SPC" "TAB" "C-/" "C-e" "RET")
"(foobar\n ‸"
; a line starting with an opening bracket in column 0 starts a form even
; inside a string, so the next line is indented as code; Emacs, which
; parses from the buffer's start, leaves it at 0 inside the string
> (after "(define x \"a\n(b‸" "RET")
"(define x \"a\n(b\n ‸"
