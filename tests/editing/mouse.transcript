; Mouse items reach the mouse commands through views' handler, as the
; page sends them: a press, moves while the button is held, and a click
; or a drag at the release.
> (define (mouse-in! v action at . fields)
    (parameterize ([web:current-client client])
      ((table-ref web:input-handlers "mouse") client
       (append fields
               `(("type" . "mouse") ("action" . ,action) ("button" . 1) ("clicks" . 1) ("modifiers" . #())
                 ("view" . ,(views:id v)) ("version" . ,(buffers:version (views:buffer v)))
                 ("showing" . ,(views:shown-count v)) ("report" . 1)
                 ,@(if at `(("at" . ,at) ("count" . 0)) '()))))))
> (define (mouse! action at . fields) (apply mouse-in! (view) action at fields))
> (define (double . more) (cons '("clicks" . 2) more))
> (define shift '("modifiers" . #("shift")))
; A click moves point and clears the region.
> (start! "one two three" 1)
("one two three" ((1 #f)))
> (press! "C-SPC")
> (mouse! "down" 5)
> (state)
("one two three" ((5 #f)))
> (mouse! "click" 6)
> (state)
("one two three" ((6 #f)))
; A drag sets the mark at the press only once the pointer moves, and the
; region it makes is temporary: the next unshifted motion clears it.
> (mouse! "down" 2)
> (mouse! "move" 2)
> (state)
("one two three" ((2 #f)))
> (mouse! "move" 6)
> (state)
("one two three" ((6 2)))
> (mouse! "move" 9)
> (mouse! "drag" 10)
> (state)
("one two three" ((10 2)))
> (press! "C-f")
> (state)
("one two three" ((11 #f)))
> (mouse! "down" 10)
> (mouse! "move" 3)
> (mouse! "drag" 2)
> (state)
("one two three" ((2 10)))
; A release outside the view ends the region at point; an empty one is
; taken as a click.
> (mouse! "down" 2)
> (mouse! "move" 7)
> (mouse! "drag" #f)
> (state)
("one two three" ((7 2)))
> (mouse! "down" 3)
> (mouse! "move" 6)
> (mouse! "move" 3)
> (state)
("one two three" ((3 3)))
> (mouse! "drag" 3)
> (state)
("one two three" ((3 #f)))
; Mouse regions put nothing on the kill ring, and delete-selection
; replaces them.
> (define kills-before (length (kill-ring:entries)))
> (mouse! "down" 5)
> (mouse! "move" 8)
> (mouse! "drag" 8)
> (list (state) (= kills-before (length (kill-ring:entries))))
(("one two three" ((8 5))) #t)
