> (faces n)
(("define" keyword) ("area" function) ("\"The area.\"" comment.documentation) ("*" function.builtin) ("define" keyword) ("pi" function) ("3.14" number) ("define-record-type" keyword) ("point" type) ("fields" keyword) ("define-enumeration" keyword) ("color" type) ("python" function) ("define" keyword) ("let" keyword) ("loop" function) ("0" number) ("my" module) ("lib" module) ("define" keyword) ("two" function) ("\"only a string\"" string) ("#%car" function.builtin) ("#2%cdr" function.builtin) ("#3%map" function.builtin))
