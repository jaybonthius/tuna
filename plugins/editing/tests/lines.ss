(import (tuna) (test) (test-user) (commands) (views) (buffers) (editing) (scene) (md))

(test "M-m goes past the line's indentation, and from there to the line's start; shifted, it selects"
  (scene:show! "one\n  \ttwo\n   \nx" 7)
  (check-equal? '(8 5 8) (scene:points-after! "M-m" "M-m" "M-m"))
  (test-user:press! "C-n M-m")
  (check-equal? '((12 #f)) (scene:cursors))
  (test-user:press! "M-m")
  (check-equal? '((15 #f)) (scene:cursors))
  (views:set-point! (scene:view) 9)
  (test-user:press! "M-M")
  (check-equal? '((8 9)) (scene:cursors))
  (scene:show! "  a\n  b" 1 7)
  (test-user:press! "M-m")
  (check-equal? '((3 #f) (5 #f)) (scene:cursors)))

(test "C-S-DEL kills the line with its break; a run of them is one entry; the last line has no break to take"
  (scene:show! "one\ntwo\nthree" 6)
  (test-user:press! "C-S-DEL")
  (check-equal? '(("one\nthree" ((5 #f))) ("two\n")) (list (scene:state) (scene:kills 1)))
  (test-user:press! "C-S-DEL")
  (check-equal? '(("one\n" ((5 #f))) ("two\nthree")) (list (scene:state) (scene:kills 1)))
  (check-equal? '((editing:kill-whole-line "end of buffer")) (scene:press-reports! "C-S-DEL")))

(test "C-S-DEL with a count kills that many lines, back with the break before them for a negative one, and the line's text alone for 0"
  (scene:show! "a\nb\nc\nd" 3)
  (test-user:press! "M-2 C-S-DEL")
  (check-equal? '(("a\nd" ((3 #f))) ("b\nc\n")) (list (scene:state) (scene:kills 1)))
  (test-user:press! "C-y C-p M-- C-S-DEL")
  (check-equal? '(("a\nb\nd" ((4 #f))) ("\nc")) (list (scene:state) (scene:kills 1)))
  (test-user:press! "M-0 C-S-DEL")
  (check-equal? '(("a\n\nd" ((3 #f))) ("\ncb")) (list (scene:state) (scene:kills 1)))
  (scene:show! "\nx" 1)
  (check-equal? '((editing:kill-whole-line "beginning of buffer")) (scene:press-reports! "M-- C-S-DEL")))

(test "C-S-DEL at two cursors kills both lines as one entry, which one undo puts back"
  (scene:show! "one\ntwo" 2 6)
  (test-user:press! "C-S-DEL")
  (check-equal? '(("" ((1 #f))) ("one\n\ntwo")) (list (scene:state) (scene:kills 1)))
  (test-user:press! "C-/")
  (check-equal? '("one\ntwo" ((2 #f) (6 #f))) (scene:state))
  (scene:take-said!))

(test "M-^ joins the line to the one before with one space, or none beside a bracket or an empty line; the first line has nothing to join"
  (scene:show! "one  \n    two" 9)
  (test-user:press! "M-^")
  (check-equal? '("one two" ((4 #f))) (scene:state))
  (test-user:press! "M-^")
  (check-equal? '("one two" ((4 #f))) (scene:state))
  (scene:show! "f(\n  x\n  )\n\n  y" 5)
  (test-user:press! "M-^")
  (check-equal? '("f(x\n  )\n\n  y" ((3 #f))) (scene:state))
  (test-user:press! "C-n C-n M-^")
  (check-equal? '("f(x\n  )\n  y" ((8 #f))) (scene:state))
  (test-user:press! "M-^")
  (check-equal? '("f(x)\n  y" ((4 #f))) (scene:state))
  (scene:show! "a\nb\nc\nd" 3 7)
  (test-user:press! "M-^")
  (check-equal? '("a b\nc d" ((2 #f) (6 #f))) (scene:state))
  (test-user:show! "(one\n|   two")
  (test-user:press! "M-^")
  (check-equal? "(one| two" (test-user:text)))

(test "C-u M-^ joins the next line to this one"
  (test-user:show! "o|ne\n  two\nthree")
  (test-user:press! "C-u M-^")
  (check-equal? "one| two\nthree" (test-user:text))
  (test-user:show! "one\nt|wo")
  (test-user:press! "C-u M-^")
  (check-equal? "one\nt|wo" (test-user:text)))

(test "M-^ with a region joins the region's lines"
  (scene:show! "a\n b\n c\nd" 3)
  (views:set-mark! (scene:view) 8)
  (test-user:press! "M-^")
  (check-equal? '("a\n b c\nd" ((5 #f))) (scene:state)))

(test "duplicate-dwim puts a copy of the line after it, or of the region after the region, which stays; the cursor stays"
  (scene:show! "ab\ncd" 2)
  (scene:run editing:duplicate-dwim 1)
  (check-equal? '("ab\nab\ncd" ((2 #f))) (scene:state))
  (views:set-point! (scene:view) 9)
  (scene:run editing:duplicate-dwim 2)
  (check-equal? '("ab\nab\ncd\ncd\ncd" ((9 #f))) (scene:state))
  (scene:show! "one two" 5)
  (views:set-mark! (scene:view) 8)
  (scene:run editing:duplicate-dwim 1)
  (check-equal? '("one twotwo" ((5 8))) (scene:state))
  (scene:run editing:duplicate-dwim 1)
  (check-equal? '("one twotwotwo" ((5 8))) (scene:state))
  (scene:run editing:duplicate-dwim 0)
  (check-equal? '("one twotwotwo" ((5 8))) (scene:state))
  (scene:show! "a\nb" 1 3)
  (scene:run editing:duplicate-dwim 1)
  (check-equal? '("a\na\nb\nb" ((1 #f) (5 #f))) (scene:state)))

(test "M-<down> and M-<up> move the line, or the lines the region touches, with the cursors and the region; at an edge they raise"
  (scene:show! "one\ntwo\nthree" 2)
  (test-user:press! "M-<down>")
  (check-equal? '("two\none\nthree" ((6 #f))) (scene:state))
  (test-user:press! "M-<down>")
  (check-equal? '("two\nthree\none" ((12 #f))) (scene:state))
  (check-equal? '((editing:move-line-down "end of buffer")) (scene:press-reports! "M-<down>"))
  (test-user:press! "M-<up> M-<up>")
  (check-equal? '("one\ntwo\nthree" ((2 #f))) (scene:state))
  (check-equal? '((editing:move-line-up "beginning of buffer")) (scene:press-reports! "M-<up>"))
  (scene:show! "a\nb\nc\nd\ne" 3)
  (views:set-mark! (scene:view) 7)
  (test-user:press! "M-<down>")
  (check-equal? '("a\nd\nb\nc\ne" ((5 9))) (scene:state))
  (test-user:press! "M-<down>")
  (check-equal? '("a\nd\ne\nb\nc" ((7 10))) (scene:state))
  (check-equal? '((editing:move-line-down "end of buffer")) (scene:press-reports! "M-<down>"))
  (test-user:press! "M-2 M-<up>")
  (check-equal? '("a\nb\nc\nd\ne" ((3 6))) (scene:state))
  (test-user:press! "C-/")
  (check-equal? '("a\nd\ne\nb\nc" ((7 #f))) (scene:state))
  (scene:take-said!))

(test "M-<down> with a count, and cursors closer than the count moving their lines as one block"
  (scene:show! "a\nb\nc\nd\ne" 3)
  (views:set-mark! (scene:view) 7)
  (test-user:press! "M-2 M-<down>")
  (check-equal? '("a\nd\ne\nb\nc" ((7 10))) (scene:state))
  (scene:show! "a\nb\nc\nd\ne" 1 3 5 9)
  (test-user:press! "M-<down>")
  (check-equal? '("d\na\nb\nc\ne" ((3 #f) (5 #f) (7 #f) (9 #f))) (scene:state))
  (scene:show! "a\nb\nc\nd\ne" 7 8)
  (test-user:press! "M-<up>")
  (check-equal? '("a\nb\nd\nc\ne" ((5 #f) (6 #f))) (scene:state))
  (test-user:press! "M-3 M-<up>")
  (check-equal? '("d\na\nb\nc\ne" ((1 #f) (2 #f))) (scene:state))
  (scene:run editing:move-line-down (expt 10 30))
  (check-equal? '("a\nb\nc\ne\nd" ((9 #f) (10 #f))) (scene:state)))

(test "a region made by shift selection stays temporary after a move or a duplicate"
  (scene:show! "one\ntwo\nthree" 2)
  (test-user:press! "S-<down> M-<down>")
  (check-equal? '("three\none\ntwo" ((12 8))) (scene:state))
  (test-user:press! "<right>")
  (check-equal? '("three\none\ntwo" ((13 #f))) (scene:state))
  (scene:show! "ab\ncd" 1 4)
  (test-user:press! "S-<right>")
  (scene:run editing:duplicate-dwim 1)
  (check-equal? '("aab\nccd" ((2 1) (6 5))) (scene:state))
  (test-user:press! "<right>")
  (check-equal? '("aab\nccd" ((3 #f) (7 #f))) (scene:state)))

(test "a refused move or sort leaves a copy of a line, never loses one"
  (scene:show! "one\ntwo\nthree" 5)
  (scene:lock! 9 14)
  (check (scene:refused? (car (scene:press-reports! "M-<down>"))))
  (check-equal? "one\nthree\ntwo\nthree" (scene:text))
  (scene:show! "one\ntwo\nthree" 5)
  (scene:lock! 1 4)
  (check (scene:refused? (car (scene:press-reports! "M-<up>"))))
  (check-equal? "one\ntwo\none\nthree" (scene:text))
  (scene:show! "c\nb\na\n" 1)
  (scene:lock! 1 2)
  (views:set-mark! (scene:view) 7)
  (check (scene:refused? (car (scene:reports-during (lambda () (scene:run editing:sort-lines))))))
  (check-equal? "c\nb\na\na\nb\nc\n" (scene:text)))

(test "C-RET and C-S-RET open a line below or above, indented as the current one, which is not split"
  (scene:show! "  one\ntwo" 4)
  (test-user:press! "C-RET")
  (check-equal? '("  one\n  \ntwo" ((9 #f))) (scene:state))
  (test-user:press! "x C-S-RET")
  (check-equal? '("  one\n  \n  x\ntwo" ((9 #f))) (scene:state))
  (scene:show! "a\nb" 1 3)
  (test-user:press! "C-S-RET")
  (check-equal? '("\na\n\nb" ((1 #f) (4 #f))) (scene:state)))

(test "delete-trailing-whitespace trims every line and the empty lines at the end, or only the region's lines, skipping what it cannot change"
  (scene:show! "a  \n \t\nb\t\n\n\n" 1)
  (scene:run editing:delete-trailing-whitespace)
  (check-equal? '("a\n\nb\n" ((1 #f))) (scene:state))
  (scene:show! "a  \nb  \nc  " 1)
  (views:set-mark! (scene:view) 7)
  (scene:run editing:delete-trailing-whitespace)
  (check-equal? '("a\nb  \nc  " ((1 #f))) (scene:state))
  (scene:show! "a  \nb  \nc  " 1)
  (scene:lock! 5 8)
  (scene:run editing:delete-trailing-whitespace)
  (check-equal? '("a\nb  \nc" ((1 #f))) (scene:state)))

(test "sort-lines sorts the lines the region touches, and raises without a region"
  (scene:show! "c\nb\na\nd\n" 1)
  (views:set-mark! (scene:view) 7)
  (scene:run editing:sort-lines)
  (check-equal? '("a\nb\nc\nd\n" ((1 #f))) (scene:state))
  (check-equal? '((editing:sort-lines "the mark is not set, so there is no region"))
    (scene:reports-during (lambda () (scene:run editing:sort-lines)))))

(test "in nodes a line starts at its node's first stop, and the line commands keep each block's kind"
  (let ([n (scene:show! (md:doc '() (md:para '() "one\n") (md:para '() "  two\n") (md:para '() "three\n")) 10)])
    (test-user:press! "M-m")
    (check-equal? 8 (views:point (scene:view)))
    (test-user:press! "M-<up>")
    (check-equal? '(md:doc () (md:para () "  two\n") (md:para () "one\n") (md:para () "three\n")) (scene:root))
    (test-user:press! "C-n M-^")
    (check-equal? '(md:doc () (md:para () "  two one\n") (md:para () "three\n")) (scene:root))
    (scene:run editing:duplicate-dwim 1)
    (check-equal? '(md:doc () (md:para () "  two one\n  two one\n") (md:para () "three\n")) (scene:root)))
  (scene:show! (md:doc '() (md:para '() "c\nx\n") (md:para '() "b\n") (md:para '() "a\n")) 2)
  (views:set-mark! (scene:view) 13)
  (scene:run editing:sort-lines)
  (check-equal? '(md:doc () (md:para () "a\nb\n") (md:para () "c\n") (md:para () "x\n")) (scene:root)))

(test "two cursors on one line keep their places when it moves, through a file's text and across blocks"
  (scene:show! "one\ntwo\n" 2 3)
  (test-user:press! "M-<down>")
  (check-equal? '("two\none\n" ((6 #f) (7 #f))) (scene:state))
  (test-user:press! "M-<up>")
  (check-equal? '("one\ntwo\n" ((2 #f) (3 #f))) (scene:state))
  (scene:show! (md:doc '() (md:para '() "one\n") (md:para '() "two\n")) 2 3)
  (test-user:press! "M-<down>")
  (check-equal? '((md:doc () (md:para () "two\n") (md:para () "one\n")) ((8 #f) (9 #f))) (list (scene:root) (scene:cursors)))
  (test-user:press! "M-<up>")
  (check-equal? '((md:doc () (md:para () "one\n") (md:para () "two\n")) ((2 #f) (3 #f))) (list (scene:root) (scene:cursors))))
