> (import (tuna eval))
> (http:wait-for-server)
Tuna is at http://127.0.0.1:PORT/
> (define port (web:port))
> (define p (http:page))
> (http:connect! p)
> (web:clients)
(#<client 1>)
; Reloading web stops its server and starts another on the same port. A
; page from before finds no client, reloads, and becomes a new client.
> (eval-file (string-append (getenv "TUNA_LIBRARY") "/web.sls"))
Tuna is at http://127.0.0.1:PORT/
> (= (web:port) port)
#t
> (http:next p)
closed
> (web:clients)
()
> (let ([e (http:show (http:connect-and-next! p))]) (list e (http:next p)))
((script "location.reload()") closed)
> (define q (http:page))
> (http:connect! q)
> (web:clients)
(#<client 1>)
> (web:send-screen! (car (web:clients)) (haml (:p "new")) "Tuna")
> (http:show (http:next q))
(screen 1 0 "<p>new</p>")
; Unloading web stops its server.
> (unload-module! '(web))
> (http:next q)
closed
> (guard (e [(error? e) (condition-message e)]) (http:on-port port (lambda () (http:get "/"))))
"cannot connect"
