; M-s _ starts a symbol search; while its text is typed it finds the
; symbols the text starts, and a repeat finds whole symbols.
> (define sy (show "sy" "(foo-bar x) foo-barz foo-bar\n"))
> (press! "M-s" "_" "f" "o" "o" "-" "b" "a" "r")
> (here)
(9 "Symbol I-search: foo-bar" "foo-bar")
> (press! "C-s")
> (here)
(29 "Symbol I-search: foo-bar" "foo-bar")
> (press! "RET")
; M-s . searches for the symbol at point from its start; a count goes
; that many matches on, a negative one backward, where the first turns
; the search around on the same match, as Emacs's does.
> (views:set-point! (view) 4)
> (press! "M-s" ".")
> (here)
(9 "Symbol I-search: foo-bar" "foo-bar")
> (press! "RET")
> (views:set-point! (view) 4)
> (press! "C-u" "1" "M-s" ".")
> (here)
(29 "Symbol I-search: foo-bar" "foo-bar")
> (press! "RET")
> (views:set-point! (view) 24)
> (press! "M--" "M-s" ".")
> (here)
(22 "Symbol I-search backward: foo-bar" "foo-bar")
> (press! "RET")
> (views:set-point! (view) 12)
> (press! "M-s" ".")
! isearch:forward-symbol-at-point: No symbol at point
> (here)
(12 #f #f)
> (press! "M-s" "M-.")
! isearch:forward-thing-at-point: No thing at point
; M-s M-. takes the active region, deactivating it, or else the symbol
; at point.
> (views:set-point! (view) 2)
> (views:set-mark! (view) 5)
> (press! "M-s" "M-.")
> (list (here) (views:mark (view)))
((5 "I-search: foo" "foo") #f)
> (press! "RET")
> (views:set-point! (view) 15)
> (press! "M-s" "M-.")
> (here)
(21 "I-search: foo-barz" "foo-barz")
> (press! "RET")
; C-M-w adds the next symbols after the match, or a character when none
; follows.
> (views:set-point! (view) 1)
> (press! "C-s" "(" "C-M-w")
> (here)
(9 "I-search: (foo-bar" "(foo-bar")
> (press! "C-M-w")
> (here)
(10 "I-search: (foo-bar " "(foo-bar ")
> (press! "C-M-w" "C-u" "2" "C-M-w")
> (here)
(12 "I-search: (foo-bar x)" "(foo-bar x)")
> (press! "RET")
; A mode's own symbol characters decide each of them.
> (define-table odd-keymap)
> (define-hook odd-hook)
> (modes:define-major-mode odd-mode (keymap odd-keymap) (hook odd-hook))
> (table-set! syntax:symbol-characters odd-mode "!")
> (define o (show "odd" "foo!bar foo-bar foo!bar\n"))
> (views:set-point! (view) 2)
> (press! "M-s" ".")
> (here)
(4 "Symbol I-search: foo" "foo")
> (press! "RET")
> (modes:set-major-mode odd-mode o)
> (views:set-point! (view) 2)
> (press! "M-s" ".")
> (here)
(8 "Symbol I-search: foo!bar" "foo!bar")
> (press! "C-s")
> (here)
(24 "Symbol I-search: foo!bar" "foo!bar")
> (press! "RET")
> (views:set-point! (view) 1)
> (press! "C-s" "C-M-w")
> (here)
(8 "I-search: foo!bar" "foo!bar")
> (press! "RET")
; Advice on syntax:buffer-symbol-characters reaches them too.
> (define f (show "f" "foo!bar foo!bar\n"))
> (define (with-bang chars buffer) (if (eq? buffer f) (string-append (chars buffer) "!") (chars buffer)))
> (advice-add! syntax:buffer-symbol-characters with-bang)
> (views:set-point! (view) 2)
> (press! "M-s" ".")
> (here)
(8 "Symbol I-search: foo!bar" "foo!bar")
> (press! "RET")
> (advice-remove! syntax:buffer-symbol-characters with-bang)
> (views:set-point! (view) 2)
> (press! "M-s" ".")
> (here)
(4 "Symbol I-search: foo" "foo")
> (press! "RET")
