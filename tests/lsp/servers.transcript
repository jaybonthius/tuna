; A server defined in a module is named under the module; a configuration's
; tables:set! on a default server's name wins over the module's entry.
> (import (chez-lsp))
> (list chez-lsp:chez-lsp (lsp:server? (tables:ref lsp:servers chez-lsp:chez-lsp)))
(chez-lsp:chez-lsp #t)
> (define ours (lsp:server '("basedpyright-langserver" "--stdio") (configuration '(("basedpyright" ("analysis" ("typeCheckingMode" . "basic")))))))
> (tables:set! lsp:servers lsp:basedpyright ours)
> (eq? (tables:ref lsp:servers lsp:basedpyright) ours)
#t
> (tables:ref lsp:language-servers "go")
(lsp:gopls)
> (lsp:server '("x") (colour "red"))
! lsp:server: invalid clause (colour "red") in (lsp:server (quote ("x")) (colour "red"))
> (lsp:capabilities hover teleport)
! lsp:capabilities: not a capability (lsp:capabilities hover teleport)
; A list of names gives the first whose program is found.
> (lsp:define-server missing '("no-such-language-server"))
> (lsp:define-server alpha (fake-command "alpha"))
> (configure! "alpha" '(capabilities ("textDocumentSync" . 2)))
> (tables:set! lsp:language-servers "fakelang" (list (list missing alpha)))
> (hooks:add! fake-mode-hook lsp:ensure)
> (write-file! (string-append project "/a.fk") "one\n")
> (define a (visit! (string-append project "/a.fk")))
> (wait-for "alpha" "textDocument/didOpen")
> (map lsp:connection-server (lsp:buffer-connections a))
(alpha)
> (lsp:managed? a)
#t
> (in-client (lambda () (modes:on? lsp:managed? (view))))
#t
; A server none of whose programs is found is reported once per buffer,
; though the mode's hooks run again after each module loads.
> (tables:set! lsp:language-servers "fakelang" (list alpha missing))
> (take-said!)
()
> (buffers:with-buffer a (lsp:ensure))
> (buffers:with-buffer a (lsp:ensure))
> (take-said!)
("lsp: no server of (missing) is installed")
; Two languages that list one name share its connection.
> (tables:define-table other-keymap)
> (hooks:define-hook other-hook)
> (modes:define-major-mode other-mode (keymap other-keymap) (hook other-hook) (language "otherlang"))
> (tables:set! auto-mode:file-names "ot" other-mode)
> (tables:set! lsp:language-servers "otherlang" (list alpha))
> (hooks:add! other-hook lsp:ensure)
> (write-file! (string-append project "/b.ot") "two\n")
> (define b (visit! (string-append project "/b.ot")))
> (wait-for "alpha" "textDocument/didOpen" 2)
> (list (length (lsp:connections)) (eq? (car (lsp:buffer-connections a)) (car (lsp:buffer-connections b))))
(1 #t)
> (ref (cadr (of-method "alpha" "textDocument/didOpen")) "params" "textDocument" "languageId")
"otherlang"
; The configuration evaluated again with a changed description starts no
; second server and keeps the buffers managed; lsp:reconnect then starts
; it with the new description.
> (define first-connection (car (lsp:connections)))
> (lsp:define-server alpha (fake-command "alpha") (initialization-options '(("again" . #t))))
> (buffers:with-buffer a (lsp:ensure))
> (list (length (lsp:connections)) (eq? (car (lsp:connections)) first-connection) (lsp:managed? a) (lsp:managed? b))
(1 #t #t #t)
> (in-client (lambda () (commands:run lsp:reconnect first-connection)))
> (testing:wait-until (lambda () (= 2 (length (of-method "alpha" "initialize")))))
> (ref (cadr (of-method "alpha" "initialize")) "params" "initializationOptions")
(("again" . #t))
> (testing:wait-until (lambda () (= 4 (length (of-method "alpha" "textDocument/didOpen")))))
> (list (length (lsp:connections)) (lsp:managed? a) (lsp:managed? b) (eq? (car (lsp:connections)) first-connection))
(1 #t #t #f)
; Shutting down and reconnecting say so, naming the server as the
; status line does.
> (filter (lambda (m) (or (string=? m "Reconnected!") (string=? m "fake exited with status 0") (and (> (string-length m) 6) (string=? (substring m 0 6) "Asking")))) (take-said!))
("Asking fake politely to terminate" "fake exited with status 0" "Reconnected!")
; A name removed from a language's list releases its buffers at their
; next lsp:ensure.
> (tables:set! lsp:language-servers "otherlang" '())
> (buffers:with-buffer b (lsp:ensure))
> (list (lsp:managed? b) (lsp:managed? a))
(#f #t)
> (wait-for "alpha" "textDocument/didClose")
> (ref (last-of "alpha" "textDocument/didClose") "params" "textDocument" "uri")
"file://$HOME/project/b.ot"
; A root clause of file names gives each module its own connection, while
; projects:find still gives the repository; a procedure's root is its
; answer.
> (lsp:define-server modules (fake-command "modules") (root '("go.mod")))
> (configure! "modules" '(capabilities ("textDocumentSync" . 2)))
> (tables:set! lsp:language-servers "otherlang" (list modules))
> (write-file! (string-append project "/one/go.mod") "")
> (write-file! (string-append project "/two/go.mod") "")
> (define m1 (visit! (string-append project "/one/x.ot")))
> (define m2 (visit! (string-append project "/two/y.ot")))
> (wait-for "modules" "textDocument/didOpen" 2)
> (map (lambda (b) (substring (lsp:connection-root (car (lsp:buffer-connections b))) (string-length home) (string-length (lsp:connection-root (car (lsp:buffer-connections b)))))) (list m1 m2))
("/project/one/" "/project/two/")
> (substring (projects:root (projects:find (string-append project "/one"))) (string-length home) (string-length (projects:root (projects:find (string-append project "/one")))))
"/project/"
> (lsp:define-server rooted (fake-command "rooted") (root (lambda (folder) (string-append folder "../"))))
> (configure! "rooted" '(capabilities ("textDocumentSync" . 2)))
> (tables:set! lsp:language-servers "otherlang" (list rooted))
> (define m3 (visit! (string-append project "/one/z.ot")))
> (wait-for "rooted" "textDocument/didOpen")
> (let ([root (lsp:connection-root (car (lsp:buffer-connections m3)))]) (substring root (string-length home) (string-length root)))
"/project/one/../"
; Two servers for one buffer: each is sent its own initialization options
; and asked for its own configuration; a procedure is called with the
; folder a request names.
> (define folders '())
> (lsp:define-server types (fake-command "types") (initialization-options '(("who" . "types")))
    (configuration (lambda (folder) (set! folders (cons folder folders)) `(("types" ("strict" . #t))))))
> (lsp:define-server style (fake-command "style") (initialization-options '(("who" . "style")))
    (configuration '(("style" ("lineLength" . 88)))) (ignored-capabilities (lsp:capabilities rename)))
> (configure! "types" '(capabilities ("textDocumentSync" . 2) ("documentFormattingProvider" . #t) ("renameProvider" . #t)))
> (configure! "style" '(capabilities ("textDocumentSync" . 2) ("documentFormattingProvider" . #t) ("renameProvider" . #t)))
> (tables:set! lsp:language-servers "otherlang" (list types style))
> (define both (visit! (string-append project "/both.ot")))
> (wait-for "types" "textDocument/didOpen")
> (wait-for "style" "textDocument/didOpen")
> (map (lambda (n) (ref (last-of n "initialize") "params" "initializationOptions" "who")) '("types" "style"))
("types" "style")
> (map (lambda (n) (ref (last-of n "workspace/didChangeConfiguration") "params" "settings")) '("types" "style"))
((("types" ("strict" . #t))) (("style" ("lineLength" . 88))))
> (define (ask-configuration! c id section scope)
    (lsp:notify c "fake/send"
      `(("message" ("jsonrpc" . "2.0") ("id" . ,id) ("method" . "workspace/configuration")
         ("params" ("items" . #((("section" . ,section) ("scopeUri" . ,(lsp:path->uri scope))))))))))
> (define (conn-named b name) (find (lambda (c) (eq? (lsp:connection-server c) name)) (lsp:buffer-connections b)))
> (ask-configuration! (conn-named both types) "q1" "types.strict" (string-append project "/sub/"))
> (ask-configuration! (conn-named both style) "q2" "style" (string-append project "/"))
> (testing:wait-until (lambda () (and (exists (lambda (m) (equal? (ref m "id") "q1")) (received "types")) (exists (lambda (m) (equal? (ref m "id") "q2")) (received "style")))))
> (list (ref (find (lambda (m) (equal? (ref m "id") "q1")) (received "types")) "result")
        (ref (find (lambda (m) (equal? (ref m "id") "q2")) (received "style")) "result"))
(#(#t) #((("lineLength" . 88))))
> (substring (car folders) (string-length home) (string-length (car folders)))
"/project/sub/"
; Ignoring a capability on one server moves it to the next; rename stays
; with the first, which keeps it, and formatting goes to the second when
; the first ignores it.
> (lsp:define-server types (fake-command "types") (initialization-options '(("who" . "types")))
    (ignored-capabilities (lsp:capabilities formatting)))
> (in-client (lambda () (commands:run lsp:reconnect (conn-named both types))))
> (testing:wait-until (lambda () (= 2 (length (of-method "types" "textDocument/didOpen")))))
> (configure! "style" '(capabilities ("textDocumentSync" . 2) ("documentFormattingProvider" . #t) ("renameProvider" . #t))
                       '(responses ("textDocument/formatting" . #((("range" ("start" ("line" . 0) ("character" . 0)) ("end" ("line" . 0) ("character" . 0))) ("newText" . "# "))))))
> (in-client (lambda () (commands:run lsp:format-buffer both)))
> (list (text both) (length (of-method "types" "textDocument/formatting")) (length (of-method "style" "textDocument/formatting")))
("# " 0 1)
> (configure! "types" '(capabilities ("textDocumentSync" . 2) ("renameProvider" . #t)) '(responses ("textDocument/rename" . null)))
> (in-client (lambda () (commands:run lsp:rename "renamed")))
> (list (length (of-method "types" "textDocument/rename")) (length (of-method "style" "textDocument/rename")))
(1 0)
; lsp:ignored-capabilities, set locally, removes a feature in one buffer.
> (buffers:with-buffer both (options:set-local! lsp:ignored-capabilities (lsp:capabilities formatting)))
> (raised (lambda () (in-client (lambda () (lsp:format-buffer both)))))
(lsp:format-buffer "No server formats here")
; initialize offers all the plugin can do, a feature a server ignores
; included, as Eglot's does: the setting is checked where a feature is
; used.
> (map (lambda (n) (list (and (ref (last-of n "initialize") "params" "capabilities" "textDocument" "rename") #t)
                         (and (ref (last-of n "initialize") "params" "capabilities" "textDocument" "formatting") #t)))
       '("types" "style"))
((#t #t) (#t #t))
