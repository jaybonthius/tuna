; A locked view and a level inside the selected view's level stay.
> (define first (views:make notes))
> (define second (views:make mail))
> (define third (views:make notes))
> (define fourth (views:make notes))
> (set-parts! (layout-split:container '((direction . column))
                (layout:level '()
                  (layout-split:container '((direction . row))
                    (atom first) (atom second) (layout:level '() (atom third)) (atom fourth '(locked . #t))))
                (atom echo '(depth . 90) '(size . content) '(locked . #t))))
> (layout:select! second)
> (commands:run layout:reset-layout)
> (tree)
(layout:level () (layout-split:container ((direction . column)) (layout:level () (layout-split:container ((direction . row)) #(views:view ((view . 8) (buffer . "mail"))) (layout:level () #(views:view ((view . 9) (buffer . "notes")))) #(views:view ((view . 10) (buffer . "notes") (locked . #t))))) #(views:view ((view . 5) (buffer . "*Echo*") (depth . 90) (size . content) (locked . #t)))))
