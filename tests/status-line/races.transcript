; Quits requested every millisecond land in drawing status lines, in
; changes of the segments, in window commands and in clicks on status lines.
; Afterwards every status line draws as before.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define notes (buffers:make "notes" "one\ntwo\n"))
> (views:set-buffer! (view) notes)
> (define (show-a view) "a")
> (status-line:define-segment seg-a (show show-a))
> (define reported 0)
> (define (count-reports report c) (set! reported (+ reported 1)))
> (advice-add! report count-reports)
> (define quitting #t)
> (define stopped #f)
> (define (quitter)
    (let loop ()
      (if quitting
          (begin
            (request-quit!)
            (chez:sleep (make-time 'time-duration 1000000 0))
            (loop))
          (set! stopped #t))))
> (define rounds 0)
> (define quits-caught 0)
> (define (window-count) (length (layout:views)))
> (define forked #f)
; A quit lands up to a thousand calls after its request, and the
; quitter's last request may come after the stress ends. One guard
; holds from before the quitter starts until long after it stops,
; since a quit landing between two guards would end the form. Quits
; land at least a thousand calls apart, so none lands in the handler
; before it enters the guard again.
> (define (stress until)
    (let again ()
      (guard (c [(quit-condition? c) (set! quits-caught (+ quits-caught 1)) (again)])
        (unless forked
          (set! forked #t)
          (fork-thread quitter))
        (let loop ([k 0])
          (when (< (real-time) until)
            (case (mod k 6)
              [(0) (layout:screen client) (layout:screen other-client)]
              [(1) (if (even? (quotient k 6))
                       (table-set! status-line:segments seg-a (status-line:left (mod k 50)))
                       (table-remove! status-line:segments seg-a))]
              [(2) (if (< (window-count) 4)
                       (in-client (lambda () (commands:run layout-split:split-right)))
                       (in-client (lambda () (commands:run layout:delete-view))))]
              [(3) (click-status! (view) 1)]
              [(4) (batch-ended)]
              [else (status (view))])
            (set! rounds (+ rounds 1))
            (loop (+ k 1))))
        (set! quitting #f)
        (let spin () (unless stopped (spin)))
        (let settle ([n 0]) (when (< n 100000) (settle (+ n 1)))))))
> (begin
    (stress (+ (real-time) 2000))
    (list (> (+ quits-caught reported) 100) (> rounds 1000)))
(#t #t)
> (advice-remove! report count-reports)
> (table-set! status-line:segments seg-a (status-line:left 25))
> (in-client (lambda () (for-each (lambda (v) (views:set-buffer! v notes)) (layout:views))))
> (define lines (screen-status-lines client))
> (= (length lines) (window-count))
#t
> (for-all (lambda (l) (equal? l (car lines))) lines)
#t
> (car lines)
(("status-line:modified" . "") ("status-line:buffer-name" . "notes") ("seg-a" . "a") ("status-line:position" . "L1") ("status-line:percent-position" . "Top") ("status-line:region-size" . "") ("status-line:major-mode" . "Fundamental") ("status-line:minor-modes" . ""))
> (equal? lines (screen-status-lines other-client))
#t
