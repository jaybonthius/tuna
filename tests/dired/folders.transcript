; dired answers files:directory-finders with the listed folder,
; so files:directory of a listing, where C-x d and C-x C-f start, is
; that folder; for a file buffer its entry answers #f.
> (touch! "deep/inner/x.txt" "x\n")
> (define listing (dired:visit (at "deep/inner")))
> (define file (files:visit (at "deep/inner/x.txt")))
> (list (files:directory listing) (dired:folder file) (files:directory file))
("$HOME/deep/inner/" #f "$HOME/deep/inner/")
> (layout:switch-to-buffer listing)
> (define started '())
> (set-option! ask:file-name-reader
    (lambda (question . folder)
      (set! started (cons (list question (if (pair? folder) (car folder) (files:directory))) started))
      (at (if (string=? question "Folder: ") "deep/inner" "deep/inner/x.txt"))))
> (press! "C-x" "d")
> (settle)
> (press! "C-x" "C-f")
> (settle)
> (reverse started)
(("Folder: " "$HOME/deep/inner/") ("Find file: " "$HOME/deep/inner/"))
