; Text that is no buffer's is drawn with span values by the rule a
; buffer's spans follow: each value through views:span-properties,
; faces nested, the first innermost, and before, after and replace
; drawn beside or in place of the range.
> (define b (buffers:make "plain" "x"))
> (define v (views:make b))
> (define (text-html text spans) (html->string (haml (:span (views:draw-text v text spans)))))
> (text-html "define x" '((0 6 ((face . keyword)))))
"<span><span data-face=\"keyword\">define</span> x</span>"
> (text-html "define x" '((0 8 ((face . string))) (0 6 ((face keyword bold)))))
"<span><span data-face=\"string\"><span data-face=\"bold\"><span data-face=\"keyword\">define</span></span> x</span></span>"
> (text-html "ab" '((1 1 ((before . "[")))))
"<span>a[b</span>"
> (text-html "abc" '((1 2 ((replace . "-")))))
"<span>a-c</span>"
> (text-html "a\x7;b" '())
"<span>a<span data-face=\"escape-glyph\">^G</span>b</span>"
; A span value is drawn with the view's buffer and options current, so a
; buffer's local values decide how it looks, as when the buffer is drawn.
> (options:define-option shade "light" string?)
> (tables:set! views:span-properties 'shade (lambda (v) (list (cons "data-shade" (shade)))))
> (buffers:with-buffer b (options:set-local! shade "dark"))
> (text-html "ab" '((0 1 ((shade . #t)))))
"<span><span data-shade=\"dark\">a</span>b</span>"
> (views:draw-text v "ab" '((0 3 ((face . keyword)))))
! views:draw-text: not a list of spans in the text with irritant ((0 3 ((face . keyword))))
> (views:draw-text v 'ab '())
! views:draw-text: not a string with irritant ab
