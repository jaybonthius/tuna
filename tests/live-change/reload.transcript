; spell advises files:save!, under the configuration's advice.
> (files:save! "a")
saving a [spell] 
"a"
; Evaluating a module's file runs its definitions again, though the file
; is unchanged, so an assigned definition starts again from its initial
; value.
> (spell:check "a")
checking a against /home/groucho/words
> spell:checked
1
> (eval-file "~/.local/share/tuna/plugins/spell/spell.sls")
> spell:checked
0
; Removing spell's advice is (repl)'s change, and the removal stays when
; spell reloads and advises again.
> (advice-remove! files:save! spell:log-save)
> (files:save! "b")
saving b 
"b"
> (put-version! "spell-macro.sls" ".local/share/tuna/plugins/spell/spell.sls")
> (eval-file "~/.local/share/tuna/plugins/spell/spell.sls")
> (files:save! "c")
saving c 
"c"
> (map (lambda (change) (list-head change 2)) (definition-changes files:save!))
(((spell) advice) ((repl) removal) ((init) advice) ((files) define))
> (eq? (caddr (car (definition-changes files:save!))) spell:log-save)
#t
; Other owners' changes stay: the configuration's override is in effect.
> (spell:dictionary-path)
"/home/groucho/words"
; A module that uses spell's macro is recompiled when spell's file is
; evaluated with the macro changed, and runs after spell.
> (put-version! "speller.sls" ".config/tuna/lib/speller.sls")
> (import (speller))
> (speller:go)
(v1 "z")
> (define (use-words) (spell:with-words "q"))
> (define loads '())
> (advice-add! module-loaded (lambda (loaded name) (set! loads (cons name loads)) (loaded name)))
> (put-version! "spell-macro-2.sls" ".local/share/tuna/plugins/spell/spell.sls")
> (eval-file "~/.local/share/tuna/plugins/spell/spell.sls")
speller unloading
> loads
((speller) (spell))
> (speller:go)
(v2 "z")
; A top-level form keeps its expansion until it is evaluated again.
> (use-words)
(v1 "q")
> (spell:dictionary-path)
"/home/groucho/words"
> (map car (module-changes '(spell)))
(advice define define define define define)
