> (modes:set-major-mode derived h)
> (faces h)
(("; c" comment) ("#| b |#" comment) ("#;(x y)" comment) ("\"s" string) ("\\n" string.escape) ("\\x3bb;" string.escape) ("t\"" string) ("#\\a" character) ("1.5" number) ("#t" boolean) ("#!r6rs" keyword.directive) ("#!eof" constant.builtin) ("'" punctuation.special) ("#0=" punctuation.special) ("a" string.special.symbol) ("#0#" punctuation.special) ("`" punctuation.special) ("b" string.special.symbol) ("," punctuation.special) (",@" punctuation.special) ("#'" punctuation.special))
> (define n (scheme-buffer "n.ss" "(define (area r) \"The area.\" (* r r))\n(define pi 3.14)\n(define-record-type point (fields x))\n(define-enumeration color (red) colors)\n(modes:define-major-mode python (keymap k))\n(define ((curried a) b) a)\n(let loop ([i 0]) (loop i))\n(library (my lib) (export) (import (rnrs)))\n(define (two) \"only a string\")\n(#%car #2%cdr #3%map)\n"))
; Its library form gives the scope: (rnrs), which binds no library,
