; Buttons, links and a list's rows are clickable; a disabled button or
; link is inert, since ui:disabled-keys answers its click first.
> (define (clicks v)
    (let ([s (html v)])
      (let loop ([from 0] [acc '()])
        (let ([i (let find ([i from])
                   (cond
                     [(> (+ i 12) (string-length s)) #f]
                     [(string=? (substring s i (+ i 12)) "data-click=\"") i]
                     [else (find (+ i 1))]))])
          (if i
              (let* ([start (+ i 12)] [end (let find ([j start]) (if (char=? (string-ref s j) #\") j (find (+ j 1))))])
                (loop end (cons (string->symbol (substring s start end)) acc)))
              (reverse acc))))))
> (commands:define-command (note) "Notes a push." (void))
> (ui:define-button go note)
> (ui:define-link more note)
> (define b (buffers:make "*buttons*" (buffers:text '() (go '() "Go") " " (go '((disabled . #t)) "No") " " (more '() "more") " " (more '((disabled . #t)) "less") "\n")))
> (show! b)
> (clicks (view))
(clickable inert clickable inert)
; A list's own element is neither: a click on it names its first row's
; place. A click on a heading runs ui:choose-row, which chooses nothing,
; since the click named no row.
> (define rows (buffers:make "*rows*" (ui:list '())))
> (define (lst) (document:token (buffers:document rows) 0))
> (define chosen '())
> (show! rows)
> (ui:set-rows! rows (lst) 3 (lambda (i) (ui:label (number->string i))) (lambda (i) (set! chosen (cons i chosen))) (lambda (i) "odd"))
> (clicks (view))
(clickable clickable clickable)
> (views:set-point! (view) 2)
> (click-token! (view) 0)
> (list chosen (views:point (view)) (commands:command-name (commands:last-command)))
(() 2 ui:choose-row)
