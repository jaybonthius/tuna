; Input that is no key, such as a paste or dictated text, runs its
; command through keys:run-as-input: remapped by the client's keymaps,
; with web:current-client bound to the client, and as a command no key
; ran, with no prefix argument.
> (define one (layout:current-frame))
> (define seen '())
> (define (take-seen!) (let ([s (reverse seen)]) (set! seen '()) s))
> (commands:define-command (insert-text text)
    "Records TEXT and what the command sees of its run."
    (set! seen (cons (list text (keys:command-keys) (keys:typed-char) (commands:prefix-argument)
                           (eq? (web:current-client) one) (commands:command-name (commands:this-command)))
                     seen)))
> (keys:run-as-input one insert-text "hi")
> (list (take-seen!) (commands:command-name (commands:last-command)) (web:current-client))
((("hi" #f #f #f #t insert-text)) insert-text #f)
; After C-u, the prefix argument and its keymap stay for the next key.
> (keys:bind! keys:global "C-x C-f" file-picker:find-file)
> (press-all! one "C-u")
> (keys:run-as-input one insert-text "a")
> (list (take-seen!) (keys:prefix-description one))
((("a" #f #f #f #t insert-text)) "C-u")
> (press-all! one "5" "C-x" "C-f")
> (file-picker:take!)
(("notes.txt" 5))
; A sequence in progress stays pending, and the next key ends it.
> (press-all! one "C-x")
> (keys:run-as-input one insert-text "b")
> (list (take-seen!) (keys:pending one))
((("b" #f #f #f #t insert-text)) "C-x")
> (define switched layout:switches)
> (press-all! one "o")
> (list (keys:pending one) (- layout:switches switched))
(#f 1)
; A temporary keymap stays, unasked, and its remapping applies.
> (define-table replacing)
> (commands:define-command (replaced-insert text)
    "Records TEXT as replaced."
    (set! seen (cons (list 'replaced text) seen)))
> (keys:remap! replacing insert-text replaced-insert)
> (define asked 0)
> (define end! (keys:push-keymap! one replacing (lambda (found command) (set! asked (+ asked 1)) #t)))
> (keys:run-as-input one insert-text "c")
> (list (take-seen!) asked (length (keys:active-keymaps one)))
(((replaced "c")) 0 2)
> (end!)
> (keys:run-as-input one insert-text "d")
> (take-seen!)
(("d" #f #f #f #t insert-text))
; Run inside a key's command, it still runs as no key.
> (commands:define-command (run-input)
    "Runs insert-text as input."
    (keys:run-as-input one insert-text "e"))
> (keys:bind! keys:global "C-c i" run-input)
> (press-all! one "C-u" "C-c" "i")
> (take-seen!)
(("e" #f #f #f #t insert-text))
; C-g quits a command run as input that waits, as it quits a key's.
> (define waiting '())
> (commands:define-command (wait)
    "Waits until resumed or quit."
    (set! waiting '(waiting))
    (guard (c [(quit-condition? c) (set! waiting '(quit))])
      (suspend (lambda (resume) #f))))
> (define as-input (spawn-task (lambda () (keys:run-as-input one wait))))
> (wait-until (lambda () (pair? waiting)))
> (list (task-done? as-input) waiting)
(#f (waiting))
> (keys:press! one "C-g")
> (wait-until (lambda () (task-done? as-input)))
> (list (task-done? as-input) waiting)
(#t (quit))
> (keys:run-as-input one 'insert-text "f")
! keys:run-as-input: not a command with irritant insert-text
> (on-thread (lambda () (keys:run-as-input one insert-text "g")))
(keys:run-as-input "not on the main thread")
