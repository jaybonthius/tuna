; The plugin advises keys:press! and layout:screen. The screen is the
; layout's screen and, while the popup shows, the popup after it, in one
; div.which-key-screen.
> (map car (definition-changes keys:press!))
((which-key) (minibuffer) (echo-area) (keys))
> (map car (definition-changes layout:screen))
((which-key) (layout))
> (define (ends-with html end) (string=? end (substring html (- (string-length html) (string-length end)) (string-length html))))
> (define wrapped "<div class=\"which-key-screen\"><div class=\"layout-screen\"")
> (let ([html (screen-of client)]) (list (search html wrapped 0) (ends-with html "</div></div></div>")))
(0 #t)
> (set-option! which-key:delay 0)
> (press! "C-c")
> (let ([html (screen-of client)]) (list (search html wrapped 0) (ends-with html "</span></button></li></ul></div></div>")))
(0 #t)
> (press! "z")
; A client that web removes takes its timer with it.
> (set-option! which-key:delay 0.5)
> (press-in! other-client "C-c")
> (define before (length (timers)))
> (web:client-removed other-client)
> (- before (length (timers)))
1
; Unloading it takes back its advice, its entry in web:client-removed
; and its timer.
> (press! "C-c")
> (set! before (length (timers)))
> (define entries-before (length (hook-entries web:client-removed)))
> (unload-module! '(which-key))
> (list (- before (length (timers))) (- entries-before (length (hook-entries web:client-removed))))
(1 1)
> (map car (definition-changes layout:screen))
((layout))
> (map car (definition-changes keys:press!))
((minibuffer) (echo-area) (keys))
> (search (screen-of client) "<div class=\"layout-screen\"" 0)
0
> (press! "z")
> (load-module! '(which-key))
> (search (screen-of client) wrapped 0)
0
