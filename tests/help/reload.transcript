; *Help* draws as a div.help with its title, keys and links.
> (define notes (buffers:make "notes" "one\n"))
> (layout:switch-to-buffer notes)
> (in-client (lambda () (help:describe-key "C-x C-f" (view))))
> (let ([html (html->string (views:draw (help-view) client))])
    (map (lambda (s) (contains? html s))
         '("<div class=\"help\">" "<div class=\"help-title\" role=\"heading\" aria-level=\"1\">" "<div class=\"help-text\">" "<kbd class=\"help-key\">"
           "<button class=\"ui-link\" type=\"button\" tabindex=\"-1\">")))
(#t #t #t #t #t)
> (in-client (lambda () (help:describe-bindings (view))))
> (let ([html (html->string (views:draw (help-view) client))])
    (map (lambda (s) (contains? html s)) (quote ("<div class=\"help-heading\" role=\"heading\" aria-level=\"2\">" "<div class=\"help-bindings\">"))))
(#t #t)
> (assq 'help (tables:entries web:stylesheets))
(help . "help/help.css")
; Unloading help takes back its instance's keys, advice and stylesheet,
; and leaves *Help*; the configuration, which imports help, loads a new
; instance at once, which finds *Help* and starts with no history.
> (define old (module-owner '(help)))
> (unload-owner! old)
> (list (owner-live? old) (eq? (tables:owner web:stylesheets 'help) (module-owner '(help)))
        (exists (lambda (c) (eq? (car c) old)) (definition-changes keys:undefined)))
(#f #t #f)
> (buffers:live? (buffers:find "*Help*"))
#t
