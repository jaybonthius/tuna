> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
; A datum starts as its initial value; evaluating its form again keeps the
; value.
> (saved:define-saved answers '() list?)
> (answers)
()
> (saved:set! answers '("yes"))
> (answers)
("yes")
> (saved:define-saved answers '() list?)
> (answers)
("yes")
> (list (saved:saved? answers) (saved:saved? car) (saved:saved? (lambda () '())))
(#t #f #f)
; Evaluating the form again with a check its value fails moves the value
; aside, as at load; a value that is still the initial one is replaced.
> (saved:define-saved kind '(1 2) list?)
> (saved:set! kind '(1 2 3))
> (saved:define-saved kind 0 fixnum?)
! saved:define-saved: $HOME/.local/share/tuna/saved/user/repl/kind.ss holds a value that fails its check; it is moved to $HOME/.local/share/tuna/saved/user/repl/kind.ss.rejected
> (kind)
0
> (saved:define-saved kind "none" string?)
> (kind)
"none"
; Setting checks the value, and only saved:set! sets it.
> (saved:set! answers 5)
! saved:set!: 5 is not a valid value for answers
> (saved:set! answers (list car))
! saved:set!: not plain data with irritant (#<procedure car>)
> (saved:set! car '())
! saved:set!: not saved data with irritant #<procedure car>
> (answers '("no"))
! answers: saved data is set with saved:set!
> (answers)
("yes")
; Removing it gives the initial value back.
> (saved:remove! answers)
> (answers)
()
> (saved:remove! car)
! saved:remove!: not saved data with irritant #<procedure car>
; The initial value must be valid too.
> (saved:define-saved wrong 'x list?)
! saved:define-saved: x is not a valid value for wrong
> (saved:define-saved wrong (vector car) vector?)
! saved:define-saved: not plain data with irritant #(#<procedure car>)
> (saved:define-saved wrong '() 'list?)
! saved:define-saved: not a procedure with irritant list?
; Any thread may set saved data, but only the main thread defines it.
> (begin (join-task (fork-task (lambda (restore) (saved:set! answers '("from a thread"))))) (void))
> (answers)
("from a thread")
> (begin (join-task (fork-task (lambda (restore) (saved:remove! answers)))) (void))
> (answers)
()
> (let ([outcome #f])
    (join-task
      (fork-task
        (lambda (restore)
          (set! outcome (guard (c [#t (condition-message c)]) (saved:define-saved x 0 fixnum?) x)))))
    outcome)
"only the main thread makes changes"
; The configuration's datum is its own: the REPL's of the same name is
; another datum.
> (history)
("start")
> (saved:define-saved history '() list?)
> (history)
()
; A module's stored value is read when it loads; one that cannot be read,
; is not plain data or fails its check is moved aside and reported, and the
; datum starts from its initial value.
> (import (hist))
! (hist) saved:define-saved: $HOME/.local/share/tuna/saved/user/hist/broken.ss cannot be read; it is moved to $HOME/.local/share/tuna/saved/user/hist/broken.ss.rejected
! (hist) saved:define-saved: $HOME/.local/share/tuna/saved/user/hist/trailing.ss cannot be read; it is moved to $HOME/.local/share/tuna/saved/user/hist/trailing.ss.rejected
! (hist) saved:define-saved: $HOME/.local/share/tuna/saved/user/hist/empty.ss cannot be read; it is moved to $HOME/.local/share/tuna/saved/user/hist/empty.ss.rejected
! (hist) saved:define-saved: $HOME/.local/share/tuna/saved/user/hist/boxed.ss holds a value that is not plain data; it is moved to $HOME/.local/share/tuna/saved/user/hist/boxed.ss.rejected
! (hist) saved:define-saved: $HOME/.local/share/tuna/saved/user/hist/cyclic.ss holds a value that is not plain data; it is moved to $HOME/.local/share/tuna/saved/user/hist/cyclic.ss.rejected
! (hist) saved:define-saved: $HOME/.local/share/tuna/saved/user/hist/wrong.ss holds a value that fails its check; it is moved to $HOME/.local/share/tuna/saved/user/hist/wrong.ss.rejected
> (list (hist:entries) (hist:stored) (hist:broken) (hist:trailing) (hist:empty) (hist:boxed) (hist:cyclic) (hist:wrong))
(("first") 42 0 0 0 0 () 0)
; The body's saved:set! is written on another thread, so the listing
; waits for its file.
> (let wait ([n 0])
    (unless (or (file-exists? "~/.local/share/tuna/saved/user/hist/entries.ss") (= n 500))
      (timers:sleep 0.01)
      (wait (+ n 1))))
> (sort string<?
    (filter (lambda (f) (member (path-extension f) '("ss" "rejected")))
      (directory-list "~/.local/share/tuna/saved/user/hist")))
("boxed.ss.rejected" "broken.ss.rejected" "cyclic.ss.rejected" "empty.ss.rejected" "entries.ss" "stored.ss" "trailing.ss.rejected" "wrong.ss.rejected")
; A check that never returns can be ended, and the stored file stays.
> (import (testing))
> (begin
    (fork-task (lambda (restore) (chez:sleep (make-time 'time-duration 200000000 0))
        (testing:request-quit!)))
    (void))
> (import (looping))
! (looping) &cancelled
