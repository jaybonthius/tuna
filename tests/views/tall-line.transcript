; A line taller than the view: a run of 200 atoms, 30 px each, with no
; newline between them, after a heading 100 lines down.
> (import (md) (editing))
> (buffers:define-kind rows (content nodes))
> (buffers:define-kind row (content atom))
> (define (paras from n) (map (lambda (i) (md:para '() (format "line ~a\n" (+ from i)))) (iota n)))
> (define b
    (buffers:make "tall"
      (apply md:doc '()
        (append (paras 1 100)
                (list (md:heading '() "Rows\n") (apply rows '() (map (lambda (i) (row '())) (iota 200))) (md:para '() "after\n"))
                (paras 103 100)))))
> (define v (views:make b))
; Stands for the page: lines 20 px high, atoms 30, each spacer a line
; per row; every redraw keeps the item at the top edge still, then the
; page carries out a new placement; a place in a spacer is the line its
; counts put there.
> (define-record-type item-box (fields mark to top height index))
> (define (item-box-bottom b) (+ (item-box-top b) (item-box-height b)))
> (define (number-in html name) (let ([n (numbers-after html (string-append name "=\""))]) (and (pair? n) (car n))))
> (define (decimal-in html name)
    (let ([i (search html (string-append name "=\"") 0)])
      (if i (let ([from (+ i (string-length name) 2)]) (string->number (substring html from (search html "\"" from)))) 0)))
> (define (spacer-field html side name)
    (let ([i (search html (string-append "data-spacer=\"" side "\"") 0)])
      (and i (number-in (substring html i (search html ">" i)) name))))
> (define (lay-out html)
    (let loop ([line (search html "<div class=\"line\"" 0)] [whole (search html "<div class=\"node whole" 0)]
               [y (* 20 (or (spacer-field html "above" "data-lines") 0))] [acc '()])
      (if (not (or line whole))
          (values (reverse acc) (+ y (* 20 (or (spacer-field html "below" "data-lines") 0))))
          (let* ([i (if (and line whole) (min line whole) (or line whole))]
                 [tag (substring html i (search html ">" i))]
                 [at (numbers-after tag "data-at=\"")]
                 [mark (if (pair? at) (list (cons "at" (car at))) (list (cons "line" (car (numbers-after tag "data-line=\"")))))]
                 [to (and (eqv? i whole) (car (numbers-after tag "data-to=\"")))]
                 [px (if to 30 20)])
            (loop (if (eqv? i line) (search html "<div class=\"line\"" (+ i 1)) line)
                  (if (eqv? i whole) (search html "<div class=\"node whole" (+ i 1)) whole)
                  (+ y px) (cons (make-item-box mark to y px i) acc))))))
> (define scroll-top 0)
> (define shown-placement #f)
> (define shown-boxes '())
> (define (margin-of h) (min 40 (/ h 4)))
> (define (box-of boxes mark) (find (lambda (b) (equal? (item-box-mark b) mark)) boxes))
> (define (item-of html boxes needle)
    (let ([i (search html needle 0)])
      (and i (let ([before (filter (lambda (b) (< (item-box-index b) i)) boxes)]) (and (pair? before) (car (reverse before)))))))
> (define (item-after html boxes needle)
    (let ([i (search html needle 0)]) (and i (find (lambda (b) (> (item-box-index b) i)) boxes))))
> (define (point-box html boxes)
    (or (item-of html boxes "cursor-on primary") (item-of html boxes "at-cursor primary")
        (item-after html boxes "<span class=\"cursor primary\">")))
> (define (centered b h) (- (+ (item-box-top b) (/ (item-box-height b) 2)) (/ h 2)))
> (define (position! html boxes)
    (let ([b (box-of boxes (let ([at (number-in html "data-place-item")] [line (number-in html "data-place-line")])
                             (if line (list (cons "line" line)) (list (cons "at" at)))))])
      (when b (set! scroll-top (+ (item-box-top b) (* (decimal-in html "data-place-fraction") (item-box-height b)))))))
> (define (follow! html boxes h)
    (let ([b (point-box html boxes)] [margin (margin-of h)] [top scroll-top])
      (when b
        (let ([bottom (item-box-bottom b)])
          (unless (if (> (item-box-height b) (- h (* 2 margin)))
                      (and (> bottom top) (< (item-box-top b) (+ top h)))
                      (and (>= (item-box-top b) (+ top margin -1/2)) (<= bottom (+ top h (- margin) 1/2))))
            (set! scroll-top
              (if (< (item-box-top b) (+ top margin))
                  (if (<= (- (+ top margin) (item-box-top b)) h) (- (item-box-top b) margin) (centered b h))
                  (if (<= (- bottom (+ top h (- margin))) h) (+ (- bottom h) margin) (centered b h)))))))))
> (define (box-start v b)
    (let ([m (car (item-box-mark b))]) (if (equal? (car m) "at") (cdr m) (line-start v (cdr m)))))
> (define (place! html boxes h)
    (let ([b (or (item-of html boxes "view-place")
                 (let ([at (number-in html "data-place-at")])
                   (and at (find (lambda (b) (>= (box-start v b) at)) boxes))))])
      (case (word-after html "data-place-kind=\"")
        [(position) (position! html boxes)]
        [(follow) (unless shown-placement (position! html boxes)) (follow! html boxes h)]
        [(top) (when b (set! scroll-top (item-box-top b)))]
        [(center) (when b (set! scroll-top (centered b h)))]
        [(bottom) (when b (set! scroll-top (- (item-box-bottom b) h)))])))
> (define (anchor! boxes)
    (let* ([old (find (lambda (b) (> (item-box-bottom b) scroll-top)) shown-boxes)]
           [new (and old (<= (item-box-top old) scroll-top) (box-of boxes (item-box-mark old)))])
      (when new (set! scroll-top (+ scroll-top (- (item-box-top new) (item-box-top old)))))))
> (define (show! v c)
    (let ([html (html-of v c)] [h (height-of c)])
      (let-values ([(boxes total) (lay-out html)])
        (define (clamp!) (set! scroll-top (max 0 (min scroll-top (- total h)))))
        (anchor! boxes)
        (clamp!)
        (let ([placement (number-in html "data-placement")])
          (unless (eqv? placement shown-placement)
            (place! html boxes h)
            (clamp!))
          (set! shown-placement placement))
        (set! shown-boxes boxes)
        html)))
; A place at Y: an item, or the line a spacer's counts put there.
> (define (place-at html boxes y)
    (let ([first (car boxes)] [last (car (reverse boxes))])
      (cond
        [(and (< y (item-box-top first)) (spacer-field html "above" "data-line"))
         => (lambda (line) (values (list (cons "line" (+ line (exact (floor (/ y 20)))))) (/ (mod y 20) 20) #t #f))]
        [(and (>= y (item-box-bottom last)) (spacer-field html "below" "data-line"))
         => (lambda (line) (let ([d (- y (item-box-bottom last))])
                             (values (list (cons "line" (+ line (exact (floor (/ d 20)))))) (/ (mod d 20) 20) #t #f)))]
        [else (let ([b (find (lambda (b) (> (item-box-bottom b) y)) boxes)])
                (values (item-box-mark b) (/ (- y (item-box-top b)) (item-box-height b)) #f b))])))
> (define (measure v c html hand?)
    (let* ([h (height-of c)] [boxes shown-boxes] [margin (margin-of h)] [room (- h (* 2 margin))]
           [row (lambda (y down?)
                  (let-values ([(mark fraction spacer? b) (place-at html boxes y)])
                    (cond
                      [(and b (item-box-to b) (> (item-box-height b) room)) (item-box-mark b)]
                      [(> fraction 1/40)
                       (let-values ([(next f s n) (place-at html boxes (if down? (+ y (* (- 1 fraction) (if b (item-box-height b) 20)) 1/2)
                                                                           (- y (* fraction (if b (item-box-height b) 20)) 1/2)))])
                         next)]
                      [else mark])))]
           [p (point-box html boxes)])
      (let-values ([(top fraction spacer? b) (place-at html boxes scroll-top)])
        `(("type" . "scroll") ("view" . ,(views:id v)) ("placement" . ,(number-in html "data-placement"))
          ("version" . ,(number-in html "data-version"))
          ("top" . ,top) ("spacer" . ,spacer?) ("fraction" . ,fraction) ("left" . null) ("past" . 0) ("sides" . #())
          ("start" . ,(row (+ scroll-top margin) #t)) ("end" . ,(row (- (+ scroll-top h) margin 1) #f))
          ("atStart" . ,(<= scroll-top 0)) ("atEnd" . #f) ("columns" . 80) ("rows" . ,(quotient h 20))
          ("pointVisible" . ,(and p (>= (item-box-top p) scroll-top) (<= (item-box-bottom p) (+ scroll-top h)) #t))
          ("wanted" . (("aboveLines" . 41) ("aboveChars" . 3280) ("belowLines" . 41) ("belowChars" . 3280) ("side" . 160))) ("hand" . ,hand?) ("edge" . "top")))))
> (define (send! c r settled?)
    (set! reports (+ reports 1))
    ((table-ref web:input-handlers "scroll") c (append r `(("report" . ,reports) ("settled" . ,settled?)))))
> (define (settle-reports! v c hand?)
    (let loop ([k 0] [last #f])
      (let ([r (measure v c (show! v c) hand?)])
        (cond
          [(equal? r last) (send! c r #t) (show! v c) (void)]
          [(= k 50) (error 'settle-reports! "the reports never settle")]
          [else (send! c r #f) (loop (+ k 1) r)]))))
> (define (settle! v c) (settle-reports! v c #f))
> (define (scroll-by-hand! v c px) (set! scroll-top px) (settle-reports! v c #t))
> (define (point-shown? v)
    (let ([b (point-box (html-of v desktop) shown-boxes)])
      (and b (<= scroll-top (item-box-top b)) (<= (item-box-bottom b) (+ scroll-top (height-of desktop))))))
> (settle! v desktop)
> (views:set-point! v (line-start v 101))
> (views:scroll-to! v (line-start v 101) (views:align top))
> (settle! v desktop)
> (list (line-of v (views:point v)) (line-of v (views:top v desktop)))
(101 101)
; C-n from the heading puts point on the run's line, and the view
; follows it there: point stays on that line, and in view, once the
; browser's reports settle, and after another round of reports.
> (views:with-view v (as-client desktop (lambda () (commands:run editing:next-line))))
> (line-of v (views:point v))
102
> (settle! v desktop)
> (list (line-of v (views:point v)) (line-of v (views:top v desktop)) (point-shown? v))
(102 100 #t)
> (settle! v desktop)
> (list (line-of v (views:point v)) (line-of v (views:top v desktop)) (point-shown? v))
(102 100 #t)
; Scrolled by hand to 500 px, the view shows the spacer above the drawn
; run: it stays at line 26, where the hand left it, and point comes into
; view.
> (scroll-by-hand! v desktop 500)
> (list (line-of v (views:point v)) (line-of v (views:top v desktop)) (point-shown? v))
(42 26 #t)
