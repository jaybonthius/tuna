; A stream that emits prefer-input says its prefix is an answer as
; typed: until its next clear, while the input is the prefix, new matches
; select none, so RET takes the input.
> (define (after-slash input)
    (let loop ([i (string-length input)])
      (cond [(= i 0) 0] [(char=? (string-ref input (- i 1)) #\/) i] [else (loop (- i 1))])))
> (define (listing emit)
    (lambda (prefix)
      (unless (eof-object? prefix)
        (emit 'clear)
        (unless (string=? prefix "") (emit 'prefer-input))
        (emit (vector "ab" "abc"))
        (emit 'done))))
> (define t (start! (lambda () (completion:read-or-input "? " (list (completion:source (stream listing) (split after-slash))) h))))
