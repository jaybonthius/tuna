; Each batch ends by drawing every client's screen, as the layout does:
; a screen here is the views drawn for one client. An entry on the hook
; records each call, with whether the buffer was current. A range shows
; as the first and last line it holds.
> (define screens '())
> (define (show! client . vs)
    (set! screens (cons (cons client vs) (remp (lambda (s) (eq? (car s) client)) screens))))
> (advice-add! batch-ended
    (lambda (ended)
      (ended)
      (for-each (lambda (s) (for-each (lambda (v) (views:draw v (car s))) (cdr s))) screens)))
> (define names '())
> (define (name! view name) (set! names (cons (cons view name) names)))
> (define calls '())
> (define (record! view buffer)
    (set! calls (cons (list (cdr (assq view names)) (buffers:name buffer) (eq? buffer (buffers:current))) calls)))
> (hooks:add! views:drawn-ranges-changed record!)
> (define (told) (let ([c (reverse calls)]) (set! calls '()) c))
> (define (ranges v)
    (list-sort (lambda (a b) (< (car a) (car b)))
      (map (lambda (r) (list (line-of v (car r)) (line-of v (- (cdr r) 1)))) (views:drawn-ranges v))))
> (define (raised thunk) (guard (c [#t (list (condition-who c) (condition-message c))]) (thunk)))
; A view no client has drawn has no range.
> (define b (buffers:make "long" (lines 300)))
> (define v (views:make b))
> (name! v 'v)
> (list (views:drawn-ranges v) (told))
(() ())
; A client's first screen draws the view 100 lines beyond each edge, from
; the start of the first line drawn to the end of the last, and the hook
; runs once, with the view and its buffer, current.
> (show! desktop v)
> (list (ranges v) (told))
(((1 101)) ((v "long" #t)))
; The page's first report sets the range to what it asks.
> (report! desktop v 1 0 #f)
> (list (ranges v) (told))
(((1 59)) ((v "long" #t)))
; Each report of a moved page moves the range, and the hook runs.
> (report! desktop v 150 0 #f)
> (list (ranges v) (told))
(((109 191)) ((v "long" #t)))
> (report! desktop v 150 0 #f)
> (list (ranges v) (told))
(((111 208)) ((v "long" #t)))
> (report! desktop v 151 5 #t)
> (list (ranges v) (told))
(((113 209)) ((v "long" #t)))
> (report! desktop v 152 0 #t)
> (list (ranges v) (told))
(((113 210)) ((v "long" #t)))
> (report! desktop v 153 0 #t)
> (list (ranges v) (told))
(((114 211)) ((v "long" #t)))
; A report that repeats the last, and a batch that changes nothing drawn,
; run no hook.
> (report! desktop v 153 0 #t)
> (list (ranges v) (told))
(((114 211)) ())
> (list (ranges v) (told))
(((114 211)) ())
; The ends move with an edit, which runs no hook.
> (begin (buffers:insert! b (line-start v 160) "new line\n") (void))
> (list (ranges v) (told))
(((114 212)) ())
> (begin (buffers:replace! b (line-start v 160) (line-start v 161) "") (void))
> (list (ranges v) (told))
(((114 211)) ())
; Text typed at the end of a buffer whose end is drawn stays in the
; range, as text typed inside it does, and runs no hook.
> (define s (buffers:make "short" "one\ntwo\n"))
> (define u (views:make s))
> (name! u 'u)
> (define (type-at-end! text)
    (buffers:insert! s (- (document:length (buffers:document s)) 1) text)
    (void))
> (show! desktop v u)
> (report! desktop u 1 0 #f)
> (list (views:drawn-ranges u) (told))
(((1 . 9)) ((u "short" #t)))
> (type-at-end! "x")
> (list (views:drawn-ranges u) (told))
(((1 . 10)) ())
> (type-at-end! "y")
> (type-at-end! "\n")
> (list (views:drawn-ranges u) (told))
(((1 . 12)) ())
> (begin (buffers:insert! s 1 "z") (void))
> (list (views:drawn-ranges u) (told))
(((1 . 13)) ())
> (show! desktop v)
> (list (views:drawn-ranges u) (told))
(() ((u "short" #t)))
; An empty buffer, drawn, runs the hook once, and then not again however
; many batches draw it.
> (define e (buffers:make "empty" ""))
> (define ev (views:make e))
> (name! ev 'ev)
> (show! desktop v ev)
> (list (views:drawn-ranges ev) (told))
(((1 . 1)) ((ev "empty" #t)))
> (define ended 0)
> (define (count-batch ended-batch) (set! ended (+ ended 1)) (ended-batch))
> (advice-add! batch-ended count-batch)
> (timers:sleep 0.3)
> (advice-remove! batch-ended count-batch)
> (list (< ended 100) (views:drawn-ranges ev) (told))
(#t ((1 . 1)) ())
> (show! desktop v)
> (list (views:drawn-ranges ev) (told))
(() ((ev "empty" #t)))
; A fold or an unfold changes the range, and runs the hook, only when it
; leaves the range short or long for what the page asks.
> (views:fold! v (line-start v 170) (line-start v 180))
> (list (ranges v) (told))
(((114 221)) ((v "long" #t)))
> (views:unfold! v (line-start v 175))
> (list (ranges v) (told))
(((114 221)) ())
> (views:fold! v (line-start v 120) (line-start v 200))
> (list (ranges v) (told))
(((114 221)) ())
> (views:unfold! v (line-start v 150))
> (list (ranges v) (told))
(((114 221)) ())
; Narrowing to a region holding the place and the range keeps it, and so
; does widening again. Narrowing to a region that does not hold the place
; scrolls to the region's start; widening then leaves the range short.
> (views:narrow! v (line-start v 50) (line-start v 260))
> (list (ranges v) (told))
(((114 221)) ())
> (views:widen! v)
> (list (ranges v) (told))
(((114 221)) ())
> (views:narrow! v (line-start v 20) (line-start v 60))
> (list (ranges v) (told))
(((20 59)) ((v "long" #t)))
> (views:widen! v)
> (list (ranges v) (told))
(((19 101)) ((v "long" #t)))
; A jump draws the range anew around the new place.
> (views:scroll-to! v (line-start v 250) (views:align top))
> (list (ranges v) (told))
(((209 291)) ((v "long" #t)))
> (report! desktop v 250 0 #f)
