; A kill across nodes is a slice open at both edges, whose datum closes
; what it cut; a whole node killed and put back between two others comes
; back as that node.
> (define md
    (document:from-datum
      '(md:doc ()
         (md:heading ((level . 1)) "Title\n")
         (md:para () "Alpha " (md:link ((href . "https://x")) "beta") " gamma.\n")
         (md:list () (md:item () "one\n") (md:item () "two\n") (md:item () "three\n"))
         (md:code ((lang . "scheme")) "(car x)\n")
         (md:para () "Last " #(md:image ((src . "a.png"))) " line.\n"))))
> (define kill (document:slice md (at md "Alpha be") (at md "gamma.\non")))
> (document:datums kill)
((md:para () (md:link ((href . "https://x")) "ta") " gamma.\n") (md:list () (md:item () "on")))
> (list (document:open-start kill) (document:open-end kill))
(2 2)
> (document:text (document:slice md (at md "Alpha ") (at md "gamma.\non")))
"beta gamma.\non"
> (define one-start (- (at md "gamma.\n") 1))
> (define one-end (- (at md "one\n") 1))
> (define item (document:slice md one-start one-end))
> (list (document:datums item) (document:open-start item) (document:open-end item))
(((md:item () "one\n")) 0 0)
> (define without (document:replace md one-start one-end (document:from-datum)))
> (define back (document:replace without (- (at without "two\n") 1) (- (at without "two\n") 1) item))
> (define the-list (document:enclosing back (document:node-start (document:enclosing back (at back "thr")))))
> (document:datums (document:slice back (document:node-start the-list) (document:node-end the-list)))
((md:list () (md:item () "two\n") (md:item () "one\n") (md:item () "three\n")))
; Random documents and edits, every query compared with a flat model of
; tokens: each result is the number of checks and the number that failed.
> (edit-checks 1 12 30 12)
(81142 0)
> (typing-checks 2 6000 15)
(1941 0)
