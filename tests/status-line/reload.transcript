; A user's removal of a segment stays in effect when status-line reloads
; and places it again.
> (define notes (buffers:make "notes" "one\n"))
> (views:set-buffer! (view) notes)
> (tables:remove! status-line:segments status-line:minor-modes)
> (map car (status (view)))
("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size" "status-line:major-mode")
> (reload-modules! '((status-line)))
> (map car (status (view)))
("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size" "status-line:major-mode")
> (screen-status-lines client)
((("status-line:modified" . "") ("status-line:buffer-name" . "notes") ("status-line:position" . "L1") ("status-line:percent-position" . "Top") ("status-line:region-size" . "") ("status-line:major-mode" . "Fundamental")))
; Unloading it leaves every other owner's change to its table, kept by
; name; the configuration, which imports it, loads a new instance at once,
; which places the segments again under the user's removal.
> (define old (module-owner '(status-line)))
> (unload-owner! old)
> (list (owner-live? old) (map car (status (view))))
(#f ("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size" "status-line:major-mode"))
; Unloading the module that defines and places a segment hides it;
; loading it again shows it.
> (import (cursors))
> (views:add-cursor! (view) 2)
#<cursor>
> (assoc "cursors:cursor-count" (status (view)))
("cursors:cursor-count" . "2 cursors")
> (unload-owner! (module-owner '(cursors)))
> (map car (status (view)))
("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size" "status-line:major-mode")
> (load-module! '(cursors))
#<owner (cursors) 2>
> (assoc "cursors:cursor-count" (status (view)))
("cursors:cursor-count" . "2 cursors")
