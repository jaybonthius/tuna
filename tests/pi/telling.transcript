> (define chat (pi:start (getenv "HOME")))
> (define f (fake-of chat))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
; Every message goes as a prompt that says what to do if Pi works: a
; steer, or a follow-up. Each pauses the task until Pi answers.
> (answer! f "prompt" (lambda (f r) #f))
> (define t (start! (lambda () (pi:send! chat "Fix it"))))
> (define r (wait-held f "prompt"))
> (list (ref r "message") (ref r "streamingBehavior") (task-done? t))
("Fix it" "steer" #f)
> (respond! f r '(("disposition" . "started")))
> (result t)
; A command Pi handles itself starts no run, so pi reads the session
; then, with no settle to wait for.
> (asked f)
("get_state" "get_entries" "get_session_stats" "get_commands" "prompt")
> (answer! f "prompt" (lambda (f r) '(("disposition" . "handled"))))
> (result (start! (lambda () (pi:send! chat "/review"))))
> (testing:wait-until (lambda () (= 8 (length (fake-requests f)))))
> (asked f)
("prompt" "get_entries" "get_state")
> (fake-answers-set! f '())
> (answer! f "prompt" (lambda (f r) #f))
> (define t (start! (lambda () (pi:follow-up! chat "Then test"))))
> (define r (wait-held f "prompt"))
> (list (ref r "message") (ref r "streamingBehavior"))
("Then test" "followUp")
; Pi refuses a prompt while you compact; the caller gets pi:&refused.
> (begin (refuse! f r "Cannot submit a prompt while compaction is in progress") (result t))
! pi:follow-up!: Cannot submit a prompt while compaction is in progress
(refused "Cannot submit a prompt while compaction is in progress")
> (fake-answers-set! f '())
; Pi's queue, as it reports it; taking it back returns its texts, steers
; first. Stopping takes back the queue, then stops Pi.
> (say! f (event "queue_update" '("steering" . #("a")) '("followUp" . #("b" "c"))))
> (testing:wait-until (lambda () (call-with-values (lambda () (pi:chat-queue chat)) (lambda (s u) (pair? s)))))
> (call-with-values (lambda () (pi:chat-queue chat)) list)
(("a") ("b" "c"))
> (answer! f "clear_queue" (lambda (f r) '(("steering" . #("a")) ("followUp" . #("b" "c")))))
> (asked f)
("prompt")
> (result (start! (lambda () (pi:take-queue! chat))))
("a" "b" "c")
> (result (start! (lambda () (pi:abort! chat))))
("a" "b" "c")
> (asked f)
("clear_queue" "clear_queue" "abort")
; Session commands; after each, pi reads Pi's state and the whole
; session again, since the old cursor names no entry.
> (result (start! (lambda () (pi:new-session! chat))))
> (asked f)
("new_session" "get_state" "get_entries" "get_session_stats" "get_commands")
> (ref (last-request f "get_entries") "since")
#f
> (result (start! (lambda () (pi:switch-session! chat "/s/other.jsonl"))))
> (ref (last-request f "switch_session") "sessionPath")
"/s/other.jsonl"
> (answer! f "get_fork_messages" (lambda (f r) '(("messages" . #((("entryId" . "u1") ("text" . "Hi")) (("entryId" . "u2") ("text" . "Again")))))))
> (result (start! (lambda () (pi:fork-messages chat))))
(("u1" . "Hi") ("u2" . "Again"))
> (answer! f "fork" (lambda (f r) '(("text" . "Again") ("cancelled" . #f))))
> (result (start! (lambda () (pi:fork! chat "u2"))))
"Again"
> (ref (last-request f "fork") "entryId")
"u2"
> (result (start! (lambda () (pi:clone! chat))))
; An extension may cancel a change of session; that is a refusal too.
> (answer! f "clone" (lambda (f r) '(("cancelled" . #t))))
> (result (start! (lambda () (pi:clone! chat))))
! pi:clone!: an extension cancelled it
(refused "an extension cancelled it")
> (asked f)
("switch_session" "get_state" "get_entries" "get_session_stats" "get_commands" "get_fork_messages" "fork" "get_state" "get_entries" "get_session_stats" "get_commands" "clone" "get_state" "get_entries" "get_session_stats" "get_commands" "clone")
; Naming, compacting and Pi's own compaction.
> (result (start! (lambda () (pi:set-session-name! chat "Refactor"))))
> (list (ref (last-request f "set_session_name") "name") (pi:chat-session-name chat))
("Refactor" "Refactor")
> (result (start! (lambda () (pi:compact! chat "Keep the API"))))
> (ref (last-request f "compact") "customInstructions")
"Keep the API"
> (result (start! (lambda () (pi:compact! chat))))
> (assoc "customInstructions" (last-request f "compact"))
#f
> (result (start! (lambda () (pi:set-auto-compaction! chat #f))))
> (list (ref (last-request f "set_auto_compaction") "enabled") (pi:chat-auto-compaction? chat))
(#f #f)
; Models and thinking levels, for this chat only.
> (answer! f "get_available_models"
    (lambda (f r) '(("models" . #((("id" . "m1") ("name" . "One") ("provider" . "p") ("contextWindow" . 1000) ("reasoning" . #f))
                                  (("id" . "m2") ("name" . "Two") ("provider" . "q") ("contextWindow" . 2000) ("reasoning" . #t)))))))
> (define ms (result (start! (lambda () (pi:models chat)))))
> (map pi:model-name ms)
("One" "Two")
> (answer! f "set_model"
    (lambda (f r)
      (let ([m '(("id" . "m2") ("name" . "Two") ("provider" . "q") ("contextWindow" . 2000) ("reasoning" . #t))])
        (fake-state-set! f (cons (cons "model" m) (fake-state f)))
        m)))
> (result (start! (lambda () (pi:set-model! chat (cadr ms)))))
> (let ([r (last-request f "set_model")]) (list (ref r "provider") (ref r "modelId") (pi:model-name (pi:chat-model chat))))
("q" "m2" "Two")
> (answer! f "get_available_thinking_levels" (lambda (f r) '(("levels" . #("off" "low" "high")))))
> (result (start! (lambda () (pi:thinking-levels chat))))
("off" "low" "high")
> (result (start! (lambda () (pi:set-thinking-level! chat "low"))))
> (list (ref (last-request f "set_thinking_level") "level") (pi:chat-thinking-level chat))
("low" "low")
; Export and Pi's last reply.
> (answer! f "export_html" (lambda (f r) `(("path" . ,(or (ref r "outputPath") "/tmp/session.html")))))
> (result (start! (lambda () (pi:export-html! chat))))
"/tmp/session.html"
> (result (start! (lambda () (pi:export-html! chat "/tmp/x.html"))))
"/tmp/x.html"
> (answer! f "get_last_assistant_text" (lambda (f r) '(("text" . "Done."))))
> (result (start! (lambda () (pi:last-reply chat))))
"Done."
> (answer! f "get_last_assistant_text" (lambda (f r) '(("text" . null))))
> (result (start! (lambda () (pi:last-reply chat))))
#f
; Arguments are checked where they enter.
> (pi:send! chat 'hello)
! pi:send!: not a string with irritant hello
> (pi:set-model! chat "m2")
! pi:set-model!: not a model with irritant "m2"
> (pi:send! 'chat "x")
! pi:send!: not a chat with irritant chat
; A request that Pi's end leaves unanswered is refused.
> (answer! f "get_last_assistant_text" (lambda (f r) #f))
> (define t (start! (lambda () (pi:last-reply chat))))
> (begin (wait-held f "get_last_assistant_text") (void))
> (pi:stop! chat)
! pi:last-reply: the chat was stopped
> (result t)
(refused "the chat was stopped")
> (pi:chats)
()
> (result (start! (lambda () (pi:last-reply chat))))
! pi:last-reply: Pi has ended
(refused "Pi has ended")
