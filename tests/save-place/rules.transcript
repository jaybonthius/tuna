; A file whose buffer is killed reopens where it was left: its last
; point is kept, and set again when the file is visited.
> (write-file! "a.txt" "one\ntwo\nthree\nfour\nfive\n")
> (leave! "~/a.txt" 9)
#t
> (views:last-point (files:visit "~/a.txt"))
9
> (save-place:places)
(("$HOME/a.txt" . 9))
; A place at the buffer's start is not kept.
> (leave! "~/a.txt" 1)
#t
> (list (save-place:places) (views:last-point (files:visit "~/a.txt")))
(() #f)
; Nor are the places of files a version control tool has the user edit.
> (write-file! "COMMIT_EDITMSG" "Fix it\n\nMore\n")
> (leave! "~/COMMIT_EDITMSG" 5)
#t
> (save-place:places)
()
> (map (save-place:ignored-file-predicate) '("/r/.git/COMMIT_EDITMSG" "/tmp/svn-commit.tmp" "/tmp/hg-editor-x1.txt" "/tmp/bzr_log.ab" "/tmp/notes.txt"))
(#t #t #t #t #f)
; The newest save-place:limit places are kept.
> (write-file! "b.txt" "b one\nb two\n")
> (options:set! save-place:limit 1)
> (leave! "~/a.txt" 9)
#t
> (leave! "~/b.txt" 4)
#t
> (save-place:places)
(("$HOME/b.txt" . 4))
> (options:unset! save-place:limit)
; A file changed outside Tuna since opens at the nearest place it has.
> (leave! "~/a.txt" 20)
#t
> (write-file! "a.txt" "short\n")
> (views:last-point (files:visit "~/a.txt"))
7
