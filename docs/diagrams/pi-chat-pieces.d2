# What are the pieces of a Pi chat, and where does Pi run? (built 2026-10-28, but the menu and the pickers, which are planned)
vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
  }
}
direction: down

browser: "Browser tab\n(draws the chat buffer)"
tuna: "Tuna" {
  chat: "Pi chat plugin\nchat buffer, prompt, commands\n(menu: planned)"
  md: "Markdown plugin\ntext to styled blocks"
  others: "Existing plugins\nfiles, pickers, status, notifications"
}
helper: "Pi helper\nits own process, one per chat"
pi: "pi --mode rpc\n(your Pi: models, skills, extensions)"
disk: "Your files and\nPi's session file"

browser -> tuna.chat: "1. you type and press RET"
tuna.chat -> helper: "2. prompt, over a private socket"
helper -> pi: "3. passed on unchanged"
pi -> disk: "4. edits files, saves the conversation"
pi -> helper: "5. events: text, thinking, tool calls"
helper -> tuna.chat: "6. passed on unchanged"
tuna.chat -> tuna.md: "7. reply text"
tuna.chat -> browser: "8. redrawn every 50 ms while streaming"
tuna.chat -> tuna.others: "open file, working / done\n(pickers: planned)"
