; The scroll commands, as Tuna asks the page and moves point: a buffer
; of 200 lines, line 001 to line 200, in a view the page shows 21 rows
; of. Where the page carries a placement out, the screen names it; the
; page's own tests check where it puts the view.
> (show-lines! 200)
> (start-at! 1 1)
; C-v and M-v ask the page to step by the view's height less two rows,
; or by the prefix, back when negative; point that the view left goes to
; its first or last row.
> (press! "C-v")
> (list (requested) (point-at))
(((#t null)) (20 0))
> (press! "C-v")
> (list (requested) (point-at))
(((#t null)) (39 0))
> (press! "M-v")
> (list (requested) (point-at))
(((#f null)) (39 0))
> (press! "C-u" "3" "C-v")
> (list (requested) (point-at))
(((#t 3)) (39 0))
> (press! "C-u" "-" "3" "C-v")
> (list (requested) (point-at))
(((#f 3)) (39 0))
> (press! "C-u" "-" "C-v")
> (list (requested) (point-at))
(((#f null)) (21 0))
; M-> puts point at the end and the view follows it; C-v there finds no
; more; M-< goes back; M-v there finds no more. Neither sets a mark.
> (press! "M->")
> (list (point-at) (placement) (views:mark (view)))
((201 0) (follow) #f)
> (start-at! 181 201)
> (press! "C-v")
! views:scroll-up: end of buffer
> (list (requested) (point-at))
(((#t null)) (201 0))
> (press! "M-<")
> (list (point-at) (placement) (views:mark (view)))
((1 0) (follow) #f)
> (start-at! 1 1)
> (press! "M-v")
! views:scroll-down: beginning of buffer
> (list (requested) (point-at))
(((#f null)) (1 0))
; C-l puts point's row at the centre, then the top, then the bottom,
; then the centre again.
> (start-at! 1 21)
> (press! "C-l")
> (placement)
(center 21)
> (press! "C-l")
> (placement)
(top 21)
> (press! "C-l")
> (placement)
(bottom 21)
> (press! "C-l")
> (placement)
(center 21)
; M-g g goes to the line and puts it at the centre, as Consult does,
; near the end too, where the page stops the view at the end.
> (start-at! 1 1)
> (start! "M-g" "g")
> (type! "150")
> (press! "RET")
> (list (point-at) (placement))
((150 0) (center 150))
> (start-at! 140 150)
> (start! "M-g" "g")
> (type! "145")
> (press! "RET")
> (list (point-at) (placement))
((145 0) (center 145))
> (start-at! 1 1)
> (start! "M-g" "g")
> (type! "195")
> (press! "RET")
> (list (point-at) (placement))
((195 0) (center 195))
; C-l C-l there asks for point's row at the top.
> (start-at! 181 195)
> (press! "C-l" "C-l")
> (placement)
(top 195)
; A search ends with point after or at the match, and the view follows
; it: to the centre from further than a view's height, else by the least
; scroll, as the page decides.
> (start-at! 140 145)
> (press! "C-s")
> (type! "line 190")
> (press! "RET")
> (list (point-at) (placement))
((190 8) (follow))
> (press! "C-r")
> (type! "line 020")
> (press! "RET")
> (list (point-at) (placement))
((20 0) (follow))
> (start-at! 1 1)
> (press! "C-s")
> (type! "line 199")
> (press! "RET")
> (list (point-at) (placement))
((199 8) (follow))
> (start-at! 1 1)
> (press! "C-s")
> (type! "line 030")
> (press! "RET")
> (list (point-at) (placement))
((30 8) (follow))
; C-n and C-p move point and the view follows it.
> (start-at! 1 21)
> (press! "C-n")
> (list (point-at) (placement))
((22 0) (follow))
> (start-at! 12 12)
> (press! "C-p")
> (list (point-at) (placement))
((11 0) (follow))
; M-r asks the page for the middle row, then the top row, then the
; bottom row, and moves point to the start of each.
> (start-at! 1 11)
> (press! "M-r")
> (list (requested) (point-at))
(((null)) (11 0))
> (press! "M-r")
> (list (requested) (point-at))
(((0)) (1 0))
> (press! "M-r")
> (list (requested) (point-at))
(((-1)) (21 0))
; C-v near the end steps as far as the page can, to the end at the
; bottom edge, and point the view left goes to its first row; then C-v
; finds no more.
> (start-at! 170 170)
> (press! "C-v")
> (list (requested) (point-at))
(((#t null)) (181 0))
> (press! "C-v")
! views:scroll-up: end of buffer
> (list (requested) (point-at))
(((#t null)) (181 0))
; M-. goes to the definition and puts it at the centre; M-, comes back,
; and the view follows point.
> (layout:switch-to-buffer (files:visit target-path))
> (set! last-line 200)
> (start-at! 1 2)
> (views:set-point! (view) (+ (line-start 2) 44))
> (press! "M-.")
> (list (point-at) (placement))
((150 0) (center 150))
> (press! "M-,")
> (list (point-at) (placement))
((2 44) (follow))
; Moving point sideways on a line that does not wrap has the view follow
; it; the page scrolls by the least that shows it, or to column 0 where
; the end of point's line fits from there.
> (show-long-line!)
> (start-at! 1 11)
> (press! "C-e")
> (list (point-at) (placement))
((11 300) (follow))
> (press! "C-a")
> (list (point-at) (placement))
((11 0) (follow))
> (views:set-point! (view) (+ (line-start 11) 100))
> (press! "C-n")
> (list (point-at) (placement))
((12 8) (follow))
> (views:set-point! (view) (line-start 11))
> (press! "C-u" "1" "0" "0" "C-f")
> (list (point-at) (placement))
((11 100) (follow))
> (views:set-point! (view) (+ (line-start 11) 60))
> (press! "C-b")
> (list (point-at) (placement))
((11 59) (follow))
; C-x < and C-x > ask the page to scroll sideways by the view's width
; less two columns, or by the prefix, and leave point.
> (views:set-point! (view) (line-start 11))
> (start-at! 1 11)
> (press! "C-x" "<")
> (press! "C-x" "<")
> (press! "C-x" ">")
> (press! "C-u" "5" "C-x" "<")
> (press! "C-x" ">" "C-x" ">" "C-x" ">")
> (list (requested) (point-at))
(((sideways #t 2 null) (sideways #t 2 null) (sideways #f 2 null) (sideways #t 2 5) (sideways #f 2 null) (sideways #f 2 null) (sideways #f 2 null)) (11 0))
