; Selecting a view of the layout moves its buffer to the front of
; buffers:all, as Emacs's select-window records a buffer, and so does
; showing a buffer in the selected view. Selecting by a click, C-x o,
; the part mode or a window history step is a selection; the view
; selected after a deletion is not, as Emacs's delete-window selects
; without recording.
> (define c1 (web:add-client! 1))
> (define (named name) (buffers:make name (string-append name "\n")))
> (define (first-name) (buffers:name (car (buffers:all))))
> (define one (views:make (named "one")))
> (define two (views:make (named "two")))
> (define three (views:make (named "three")))
> (set-parts! (layout-split:container '((direction . row)) (atom one) (atom two) (atom three)))
> (layout:select! two)
> (first-name)
"two"
> (press! c1 '("x" "control") '("o"))
> (first-name)
"three"
> (press! c1 '("'" "super") '("j") '("Enter"))
> (list (buffers:name (views:buffer (layout:selected-view))) (first-name))
("two" "two")
> (layout:switch-to-buffer (buffers:find "one"))
> (map buffers:name (list-head (buffers:all) 2))
("one" "two")
> (layout:select! three)
> (press! c1 '("x" "control") '("2"))
> (press! c1 '("x" "control") '("o"))
> (buffers:move-to-front! (buffers:find "one"))
> (press! c1 '("c" "control") '("ArrowLeft"))
> (list (buffers:name (views:buffer (layout:selected-view))) (first-name))
("three" "three")
> (layout:select! one)
> (press! c1 '("x" "control") '("0"))
> (list (buffers:name (views:buffer (layout:selected-view))) (first-name))
("three" "one")
