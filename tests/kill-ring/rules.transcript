> (kill-ring:push! (list "Hello\nx"))
> (list (length (kill-ring:entries)) (kill-ring:current))
(2 ("Hello" "x"))
> (set-option! kill-ring:skip-duplicates #f)
> (kill-ring:push! (list "Hello" "x"))
> (list (length (kill-ring:entries)) (kill-ring:current))
