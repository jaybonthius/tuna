; Each form's basic use.
> (import (racket) (compile) (keys))
> (tables:set! files:modes "rkt" racket:mode)
> (tables:set! compile:excluded "init.ss")
> (eq? (tables:ref files:modes "rkt") racket:mode)
#t
> (tables:entries compile:excluded)
(("init.ss" . #t))
> (keys:bind! keys:global "C-x m" 'mail)
> (list (tables:ref keys:global "C-x m") (tables:owner keys:global "C-x m"))
(mail #<owner (repl) 1>)
; A module's removal hides only the entries of owners ranked below it;
; the REPL ranks above every module, so its binding stays.
> (load-module! '(groucho keys))
#<owner (groucho keys) 1>
> (list (tables:ref keys:global "C-x m") (tables:ref keys:global "C-x m" 'none) (tables:owner keys:global "C-x m"))
(mail mail #<owner (repl) 1>)
> (unload-owner! (module-owner '(groucho keys)))
> (tables:owner keys:global "C-x m")
#<owner (repl) 1>
; The value in effect is the last in the order of changes, so the REPL's
; wins over a module's.
> (call-as-owner (module-owner '(keys)) (lambda () (tables:set! keys:global "C-x m" 'compose)))
> (tables:ref keys:global "C-x m")
mail
; Removing a key takes back one's own value, and removes the others',
; whichever module set them, as one's own change.
> (tables:remove! keys:global "C-x m")
> (list (tables:ref keys:global "C-x m") (tables:owner keys:global "C-x m"))
(#f #f)
> (tables:set! keys:global "C-x b" 'buffers)
> (tables:set! keys:global "C-x a" 'abbrevs)
> (tables:set! keys:global "C-x b" 'switch)
> (tables:entries keys:global)
(("C-x b" . switch) ("C-x a" . abbrevs))
; The REPL's removal hides what any module sets for the key, before it or
; after.
> (call-as-owner (module-owner '(keys)) (lambda () (tables:set! keys:global "C-x m" 'compose)))
> (tables:ref keys:global "C-x m")
#f
> (call-as-owner (module-owner '(keys)) (lambda () (tables:remove! keys:global "C-x m")))
> (call-as-owner (module-owner '(spell)) (lambda () (tables:set! keys:global "C-x m" 'spell)))
> (tables:entries keys:global)
(("C-x b" . switch) ("C-x a" . abbrevs))
; Evaluating tables:define-table again keeps the entries.
> (tables:define-table colours "Named colours.")
> (tables:set! colours "sea" 'blue)
> (tables:define-table colours)
> (tables:entries colours)
(("sea" . blue))
; Either the configuration or the REPL evaluating the other's
; tables:define-table keeps the entries.
> (import (plugins))
> (call-as-owner (plugins:configuration-owner) (lambda () (plugins:eval-form '(tables:define-table shared))))
> (tables:set! shared "sea" 'blue)
> (tables:define-table shared)
> (tables:entries shared)
(("sea" . blue))
> (call-as-owner (plugins:configuration-owner) (lambda () (plugins:eval-form '(tables:define-table shared))))
> (tables:entries shared)
(("sea" . blue))
; Other threads read tables too.
> (let ([v #f]) (join-task (fork-task (lambda (restore) (set! v (tables:ref colours "sea"))))) v)
blue
> (tables:set! 'colours "sea" 'green)
! tables:set!: not a table with irritant colours
> (list (tables:table? colours) (tables:table? 'colours))
(#t #f)
