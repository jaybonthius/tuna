; Quits requested every millisecond land in the plugin's code on the main
; thread, sending and delivering, and leave no mutex held: afterwards the
; job still answers.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (jobs:define-worker (echo x emit receive) (let loop () (emit (receive)) (loop)))
> (jobs:define-worker (flood n emit) (let loop () (emit n) (loop)))
> (define answers '())
> (define echoing (jobs:start echo 0 (lambda (v) (set! answers (cons v answers)))))
> (define flood-ended #f)
> (define flooding (jobs:start flood 0 (lambda (v) (void)) (lambda (e) (set! flood-ended e))))
> (define quitting #t)
> (define quits 0)
> (define (quitter)
    (let loop ()
      (when quitting
        (request-quit!)
        (chez:sleep (make-time 'time-duration 1000000 0))
        (loop))))
> (define (stress until)
    (guard (c [(quit-condition? c) (set! quits (+ quits 1)) (stress until)])
      (let loop ()
        (when (< (real-time) until)
          (jobs:send! echoing 'stress)
          (loop)))))
> (begin
    (fork-thread quitter)
    (stress (+ (real-time) 2000))
    (set! quitting #f)
    (> quits 100))
#t
> (sleep-for 0.1)
> (set! answers '())
> (jobs:send! echoing 'after)
> (wait-until (lambda () (memq 'after answers)))
> (and (memq 'after answers) #t)
#t
> (jobs:stop! flooding)
> (jobs:stop! echoing)
> (wait-until (lambda () flood-ended))
> flood-ended
stopped
; Quits requested as fast as a thread can, while the main thread delivers
; a job's values, lose no more than those deliveries: afterwards the job
; still sends. The form waits paused, so that no quit lands in it, and
; the reports, whose number varies, go to a string port.
> (define delivered 0)
> (define counting (jobs:start flood 0 (lambda (v) (set! delivered (+ delivered 1)))))
> (define stderr (console-error-port))
> (define reports (open-output-string))
> (define (after-storm thunk)
    (suspend
      (lambda (resume)
        (fork-thread
          (lambda ()
            (chez:sleep (make-time 'time-duration 20000000 0))
            (let ([until (+ (real-time) 2000)])
              (let loop () (when (< (real-time) until) (request-quit!) (loop))))
            (chez:sleep (make-time 'time-duration 100000000 0))
            (resume thunk))))))
> (console-error-port reports)
> (after-storm
    (lambda ()
      (let retry ()
        (guard (c [(quit-condition? c) (retry)])
          (let ([before delivered])
            (sleep-for 0.2)
            (console-error-port stderr)
            (list (> delivered before) (> (string-length (get-output-string reports)) 0)))))))
(#t #t)
> (jobs:stop! counting)
; A quit landing in jobs:start or jobs:stop! leaves no job half started:
; every job started ends.
> (jobs:define-worker (nothing x emit) (void))
> (define started 0)
> (define finished-jobs 0)
> (define landed 0)
> (do ([i 0 (+ i 1)]) ((= i 100))
    (guard (c [(quit-condition? c) (set! landed (+ landed 1))])
      (request-quit!)
      (let loop ()
        (jobs:stop! (jobs:start nothing 0 void (lambda (e) (set! finished-jobs (+ finished-jobs 1)))))
        (set! started (+ started 1))
        (loop))))
> landed
100
> (wait-until (lambda () (>= finished-jobs started)))
> (>= finished-jobs started)
