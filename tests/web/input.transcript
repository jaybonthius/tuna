; A quit item seen before, as when a page resends one whose post failed,
; quits nothing.
> (table-set! web:input-handlers "spin-briefly"
    (lambda (client item)
      (let ([end (+ (real-time) 500)])
        (let loop () (when (< (real-time) end) (loop))))
      (note! 'spun)))
> (define resender (http:page))
> (http:send! resender '(("type" . "keyboard-quit") ("quit" . #t)))
