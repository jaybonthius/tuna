; When a module unloads, the batch's end takes its names from the buffers
; that import it, and their colours go; loading it again brings them back.
> (define hums (scheme-buffer "hums.ss" "(import (tunes))\n(tunes:hum)"))
> (face-of hums "tunes:hum")
function.builtin
> (unload-owner! (module-owner '(tunes)))
> (face-of hums "tunes:hum")
#f
> (load-module! '(tunes))
#<owner (tunes) 2>
> (face-of hums "tunes:hum")
function.builtin
; A module's names are classified again when it loads again, and the
