; Chez's exit, reset and abort, which a body sees, end only the job.
> (jobs:define-worker (quits how emit)
    (emit 'before)
    (case how [(exit) (exit 3)] [(reset) (reset)] [(abort) (abort)])
    (emit 'after))
> (map (lambda (how) (finished quits how)) '(exit reset abort))
(((before) #f) ((before) #f) ((before) #f))
; A long-lived job keeps its state across inputs, takes the newest of
; those waiting with (receive 0), and waits at most a time with
; (receive seconds).
> (jobs:define-worker (parser text emit receive)
    (let loop ([edits 0] [text text])
      (emit (list 'parsed edits text))
      (let ([v (receive)])
        (if (eq? v 'done)
            (emit (list 'idle (eof-object? (receive 0.02))))
            (let newest ([latest v] [n 1])
              (let ([more (receive 0)])
                (if (eof-object? more)
                    (loop (+ edits n) latest)
                    (newest more (+ n 1)))))))))
> (define parsing (jobs:start parser "abc" note! (lambda (ended) (note! (list 'ended ended)))))
> (sleep-for 0.05)
> (jobs:send! parsing "abcd")
> (sleep-for 0.05)
> (begin (jobs:send! parsing "a") (jobs:send! parsing "ab") (jobs:send! parsing "abcdefg"))
> (sleep-for 0.05)
> (jobs:send! parsing 'done)
> (wait-until (lambda () (= (length log) 5)))
> (taken!)
((parsed 0 "abc") (parsed 1 "abcd") (parsed 4 "abcdefg") (idle #t) (ended #f))
> (jobs:send! parsing "after the end does nothing")
; An infinite time waits as no time does.
> (jobs:define-worker (waits-forever x emit receive) (emit (receive +inf.0)))
> (define forever (jobs:start waits-forever 0 note!))
> (jobs:send! forever 'got)
> (wait-until (lambda () (= (length log) 1)))
> (taken!)
(got)
; A stop ends a job waiting to receive or to emit at once, and a busy one
; within its next thousand or so calls; on-end receives stopped. The
; values sent before the stop still run.
> (define waiting (jobs:start parser "x" note! (lambda (ended) (note! (list 'ended ended)))))
> (sleep-for 0.05)
> (jobs:stop! waiting)
> (wait-until (lambda () (= (length log) 2)))
> (taken!)
((parsed 0 "x") (ended stopped))
