; Temporary keymaps: before each command, and when a key finds nothing,
; the newest is tested with the keymap the key was found in and the
; command; one that is not kept ends, and the next is tested.
> (define-table first)
> (define-table second)
> (keys:bind! first "a" record)
> (keys:bind! second "b" layout:other-view)
> (define tests '())
> (define exits '())
> (define (keep-while name ok)
    (lambda (found command)
      (set! tests (cons (list name (name-of found) (name-of command)) tests))
      (ok found command)))
> (define (exit-of name) (lambda () (set! exits (cons name exits))))
> (define end-first
    (keys:push-keymap! one first (keep-while 'first (lambda (found command) #t)) (exit-of 'first)))
> (define end-second
    (keys:push-keymap! one second (keep-while 'second (lambda (found command) (eq? found second)))
      (exit-of 'second)))
> (press-all! one "b" "a")
> (list (reverse tests) exits (map name-of (keys:active-keymaps one)))
(((second keymap layout:other-view) (second keymap record) (first keymap record)) (second) (keymap keys:global))
> (set! tests '())
> (press-all! one "C-x" "C-z")
! C-x C-z is undefined
