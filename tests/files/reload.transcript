; Reloading files alone takes back its live buffers, unsaved edits and
; modified flags included.
> (import (tuna eval))
> (define library (getenv "TUNA_LIBRARY"))
> (define (reload! name) (eval-file (string-append library "/" name ".sls")))
> (disk-checks:write-text! "~/a.txt" "alpha\n")
> (disk-checks:write-text! "~/b.txt" "beta\n")
> (define a (files:visit "~/a.txt"))
> (define b (files:visit "~/b.txt"))
> (buffers:replace! a 1 1 "unsaved ")
#<edit 1>
> (buffers:rename! b "my b")
> (reload! "files")
> (list (equal? (files:buffers) (list a b)) (buffers:modified? a) (buffers:modified? b) (files:path b))
(#t #t #f "$HOME/b.txt")
> (eq? b (files:visit "~/b.txt"))
#t
> (files:save-buffer a)
> (list (disk-checks:read-text "~/a.txt") (buffers:modified? a))
("unsaved alpha\n" #f)
> (buffers:replace! a 1 1 "again ")
#<edit 2>
; Reloading buffers closes every buffer, so files visits each file again.
; Without undo the unsaved edit is lost.
> (reload! "buffers")
> (testing:wait-until (lambda () (= (length (files:buffers)) 2)))
> (define a2 (car (files:buffers)))
> (list (buffers:live? a) (buffers:name a2) (text a2) (buffers:modified? a2) (map buffers:name (files:buffers)))
(#f "a.txt" "unsaved alpha\n" #f ("a.txt" "b.txt"))
; Undo advises files:read-document, so a visit can carry edits made
; before the buffer exists; the buffer starts modified.
> (define (with-unsaved read path)
    (let-values ([(doc length hash) (read path)])
      (values (document:replace doc 1 1 (document:from-datum "restored ")) length hash)))
> (advice-add! files:read-document with-unsaved)
> (disk-checks:write-text! "~/c.txt" "gamma\n")
> (define c (files:visit "~/c.txt"))
> (list (text c) (buffers:modified? c) (call-with-values (lambda () (files:fingerprint c)) (lambda (n h) n)))
("restored gamma\n" #t 6)
> (files:save-buffer c)
> (list (disk-checks:read-text "~/c.txt") (buffers:modified? c))
("restored gamma\n" #f)
> (advice-remove! files:read-document with-unsaved)
; Visits of one file at once keep their reads apart while the advice
; pauses, so the buffer does not start modified.
> (define (slow-read read path)
    (let-values ([(doc length hash) (read path)])
      (sleep-for 0.02)
      (values doc length hash)))
> (advice-add! files:read-document slow-read)
> (disk-checks:write-text! "~/eps.txt" "epsilon\n")
> (define eps (map join-task (map (lambda (i) (spawn-task (lambda () (files:visit "~/eps.txt")))) (iota 2))))
> (list (eq? (car eps) (cadr eps)) (buffers:modified? (car eps)))
(#t #f)
> (advice-remove! files:read-document slow-read)
> (buffers:kill! (car eps))
#t
; An after-visit entry may pause; the visit returns after it.
> (define seen #f)
> (define (slow-entry buffer) (sleep-for 0.05) (set! seen (buffers:name buffer)))
> (add-hook! files:after-visit slow-entry)
> (disk-checks:write-text! "~/d.txt" "delta\n")
> (list (buffers:name (files:visit "~/d.txt")) seen)
("d.txt" "d.txt")
> (remove-hook! files:after-visit slow-entry)
