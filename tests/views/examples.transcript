; The documented examples, in order. The configuration sets
; scroll-margin and wrap-lines as the documented one does.
> (list (views:scroll-margin) (views:wrap-lines))
(2 #f)
> (define notes (buffers:make "notes" "* Today: Buy milk.\n"))
> (define left (views:make notes))
> (define right (views:make notes))
> (views:set-point! right 12)
> (list (views:point left) (views:point right))
(1 12)
> (views:scroll-to! left (views:point left) (views:align center))
> (views:set-option! right views:wrap-lines #t)
> (views:with-view right (views:wrap-lines))
#t
> (views:with-view left (views:wrap-lines))
#f
> (views:view '((buffer . "notes")))
#(views:view ((buffer . "notes")))
> (import (magit))
> (define status
    (buffers:make "*status*"
      (magit:section '()
        (magit:section '() (buffers:text '() "Head: main\n"))
        (magit:section '() (buffers:text '() "Untracked\n")))))
> (show (views:make status))
