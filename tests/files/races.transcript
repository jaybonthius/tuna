; A quit that reaches a renaming task after the job renamed the file but
; before the task resumes, here signalled as the job ends, still finds
; the buffer moved and files:after-rename called.
> (disk-checks:write-text! "~/before.txt" "before\n")
> (define moving (files:visit "~/before.txt"))
> (define renamed '())
> (define (note-rename from to) (set! renamed (list (base from) (base to))))
> (define (base path) (path-last path))
> (add-hook! files:after-rename note-rename)
> (define renamer #f)
> (define (quit-as-job-ends start worker input on-result . on-end)
    (if renamer
        (start worker input on-result
          (lambda (ended)
            (signal-task renamer 'quit)
            ((car on-end) ended)))
        (apply start worker input on-result on-end)))
> (advice-add! jobs:start quit-as-job-ends)
> (guard (c [(symbol? c) c])
    (set! renamer (current-task))
    (files:rename-file "~/before.txt" "~/after.txt"))
quit
> (set! renamer #f)
> (list (files:path moving) (buffers:name moving) renamed (disk-checks:exists? "~/after.txt"))
("$HOME/after.txt" "after.txt" ("before.txt" "after.txt") #t)
; Across file systems a rename copies, then deletes; a quit once the copy
; is whole, here as its first value arrives, finds the buffer on the copy.
