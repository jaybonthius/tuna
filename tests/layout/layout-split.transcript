; C-x w t turns every split in the selected view's level from side by
; side to stacked, or back. Weights and sizes stay, so transposing again
; gives the layout as it was; locked parts and the levels inside the
; level stay as they are.
> (define (transposable)
    (set-parts! (layout-split:container '((direction . row))
                  (layout-split:container '((size columns 30) (direction . column)) (atom (views:find 1) '(weight . 2)) (atom (views:find 7) '(size lines 5)))
                  (layout-split:container '((direction . column) (locked . #t)) (atom (views:find 8)) (atom (views:find 9)))
                  (layout:level '() (layout-split:container '((direction . row)) (atom (views:find 10)) (atom (views:find 12)))))))
