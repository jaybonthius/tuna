; A save renames a new file over the old one, keeping its mode, and
; leaves no temporary file.
> (disk-checks:folder! "~/kept")
> (disk-checks:write-text! "~/kept/mode.txt" "mode\n")
> (disk-checks:set-mode! "~/kept/mode.txt" #o640)
> (define moded (files:visit "~/kept/mode.txt"))
> (buffers:replace! moded 1 1 "a ")
#<edit 1>
> (files:save-buffer moded)
> (list (disk-checks:read-text "~/kept/mode.txt") (number->string (disk-checks:mode "~/kept/mode.txt") 8) (disk-checks:folder-files "~/kept"))
("a mode\n" "640" ("mode.txt"))
; Paths resolve through symbolic links: two names, one buffer, and a link
; stays a link.
> (disk-checks:write-text! "~/kept/target.txt" "target\n")
> (disk-checks:symlink! "~/kept/target.txt" "~/kept/link.txt")
0
> (define linked (files:visit "~/kept/link.txt"))
> (list linked (files:path linked) (eq? linked (files:visit "~/kept/target.txt")) (eq? linked (files:buffer-visiting "~/kept/./link.txt")))
(#<buffer target.txt> "$HOME/kept/target.txt" #t #t)
> (buffers:replace! linked 1 1 "the ")
#<edit 1>
> (files:save-buffer linked)
> (list (disk-checks:symlink? "~/kept/link.txt") (disk-checks:read-text "~/kept/link.txt"))
(#t "the target\n")
; A file with other hard links is written in place, so the links stay one
; file.
> (disk-checks:write-text! "~/kept/a.txt" "shared\n")
> (disk-checks:link! "~/kept/a.txt" "~/kept/b.txt")
0
> (define hard (files:visit "~/kept/a.txt"))
> (buffers:replace! hard 1 1 "still ")
#<edit 1>
> (files:save-buffer hard)
> (list (disk-checks:link-count "~/kept/a.txt") (disk-checks:read-text "~/kept/b.txt"))
(2 "still shared\n")
; Files of one name are named after their folders; killing one renames
; the other back. A buffer that is not a file's, or that the user
; renamed, keeps its name.
> (for-each disk-checks:folder! '("~/docs" "~/work" "~/x" "~/x/docs"))
> (for-each (lambda (p) (disk-checks:write-text! p "n\n")) '("~/docs/n.txt" "~/work/n.txt" "~/x/docs/n.txt"))
> (define docs (files:visit "~/docs/n.txt"))
> (buffers:name docs)
"n.txt"
> (define work (files:visit "~/work/n.txt"))
> (map buffers:name (list docs work))
("n.txt<docs>" "n.txt<work>")
> (define x-docs (files:visit "~/x/docs/n.txt"))
> (map buffers:name (list docs work x-docs))
("n.txt<home/docs>" "n.txt<home/work>" "n.txt<x/docs>")
> (buffers:kill! x-docs)
#t
> (map buffers:name (list docs work))
("n.txt<docs>" "n.txt<work>")
> (buffers:kill! work)
#t
> (buffers:name docs)
"n.txt"
> (buffers:rename! docs "my notes")
> (define work (files:visit "~/work/n.txt"))
> (map buffers:name (list docs work))
("my notes" "n.txt")
> (define other-buffer (buffers:make "m.txt" "not a file"))
> (disk-checks:write-text! "~/work/m.txt" "m\n")
> (buffers:name (files:visit "~/work/m.txt"))
"m.txt<work>"
> (files:path other-buffer)
#f
; A buffer whose name starts with a space is taken for an internal one,
; so a file's gets a bar in front, as in Emacs.
> (disk-checks:write-text! "~/ space.txt" "s\n")
> (disk-checks:write-text! "~/work/ space.txt" "s\n")
> (map buffers:name (list (files:visit "~/ space.txt") (files:visit "~/work/ space.txt")))
("| space.txt<home>" "| space.txt<work>")
; write-file makes a buffer visit a file, renamed after it, and writes
; whatever the file holds.
> (define draft (buffers:make "*draft*" "(+ 1 2)"))
> (files:write-file "~/work/sum.ss" draft)
> (list (buffers:name draft) (files:path draft) (disk-checks:read-text "~/work/sum.ss") (buffers:modified? draft))
("sum.ss" "$HOME/work/sum.ss" "(+ 1 2)\n" #f)
> (disk-checks:write-text! "~/work/sum.ss" "elsewhere\n")
> (buffers:replace! draft 1 1 ";")
#<edit 2>
