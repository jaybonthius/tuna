; A sidebar entry is a button: a click on it visits the file it names, and
; leaves point where it was.
> (call-with-output-file (string-append (getenv "HOME") "/notes.org") (lambda (p) (display "* Notes\n" p)))
> (import (files-sidebar))
> (show! files-sidebar:sidebar)
> (element (view) "<button" "button")
"<button class=\"ui-button\" type=\"button\" tabindex=\"-1\"><span data-at=\"2\"><span class=\"cursor primary\"></span>notes.org</span></button>"
> (views:set-point! (view) 11)
> (mouse-in! (view) "down" '(("at" . 4) ("count" . 0)))
> (views:point (view))
11
> (mouse-in! (view) "click" '(("at" . 4) ("count" . 0)))
> (wait-until (lambda () (buffers:find "notes.org")))
> (buffers:name (views:buffer (view)))
"notes.org"
; RET with point in the entry runs the same command.
> (show! files-sidebar:sidebar)
> (views:set-point! (view) 5)
> (press! "RET")
> (buffers:name (views:buffer (view)))
"notes.org"
; Labels and rows are HTML.
> (html->string (ui:row (ui:label "Name") (ui:label "notes.org" "file")))
"<div class=\"ui-row\"><span class=\"ui-label\">Name</span><span class=\"ui-label file\">notes.org</span></div>"
; The todo buffer: each item ends in a Done button, and a click on one
; removes its todo from the saved list and the buffer.
> (import (todo))
> (show! todo:todo-buffer)
> (text todo:todo-buffer)
"Buy milk Done\nWrite the plan Done\n"
> (click-at! (view) 13)
> (list (todo:todos) (text todo:todo-buffer))
(("Write the plan") "Write the plan Done\n")
> (views:set-point! (view) 18)
> (press! "RET")
> (list (todo:todos) (text todo:todo-buffer))
(() "")
; A buffer list: a list of the live buffers whose buffer keeps no undo
; history, since it is rebuilt from fresh data.
> (import (buffer-list))
> (in-client (lambda () (commands:run buffer-list:list-buffers)))
> (buffers:name (views:buffer (view)))
"*buffer list*"
> (map (lambda (r) (vector-ref r 0)) (cddr (car (datums buffer-list:list-buffer))))
(ui:%list-row ui:%list-row ui:%list-row ui:%list-row ui:%list-row ui:%list-row ui:%list-row)
> (press! "C-n")
> (ui:selected-row (document:token (buffers:document buffer-list:list-buffer) 0) (view))
1
> (press! "C-p" "RET")
> (buffers:name (views:buffer (view)))
"notes.org"
> (length (cddr (undo:history buffer-list:list-buffer)))
1
