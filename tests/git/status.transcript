; git:status reads the branch, HEAD, the upstream and how far each is
; ahead, and one entry per changed tracked file.
> (sample-repository! "repo")
> (define repo (git:find-repository (at "repo")))
> (define s (git:status repo))
> (list (git:status-branch s) (git:status-upstream s) (git:status-ahead s) (git:status-behind s))
("main" "origin/main" 1 0)
> (string-length (git:status-head s))
40
> (entries s)
(("a.py" #f unmodified modified) ("b.txt" #f modified modified) ("gone.txt" #f unmodified deleted))
> (git:status-untracked s)
(#vu8(110 101 119 46 116 120 116))
; Renames, intent-to-add, paths with spaces and paths that are not UTF-8.
> (sh "cd repo && git mv b.txt 'b c.txt' && git add -N new.txt")
> (write-file! "repo/caf\xe9;.txt" "x\n")
> (sh "cd repo && printf 'x' > \"$(printf 'raw\\351')\"")
> (define s (git:status repo))
> (entries s)
(("a.py" #f unmodified modified) ("b c.txt" "b.txt" renamed modified) ("gone.txt" #f unmodified deleted) ("new.txt" #f unmodified added))
; Untracked paths are bytes, sorted bytewise, so one that is not UTF-8
; is staged as it is.
> (git:status-untracked s)
(#vu8(99 97 102 195 169 46 116 120 116) #vu8(114 97 119 233))
> (git:stage repo (git:status-untracked s))
> (map git:entry-path-bytes (filter (lambda (e) (eq? (git:entry-index e) 'added)) (git:status-entries (git:status repo))))
(#vu8(99 97 102 195 169 46 116 120 116) #vu8(114 97 119 233))
; How untracked files are listed: a folder as itself, its files, none,
; or as git's status.showUntrackedFiles says.
> (write-file! "repo/folder/one.txt" "1\n")
> (write-file! "repo/folder/two.txt" "2\n")
> (define (names paths) (map utf8->string paths))
> (names (git:untracked repo (git:untracked-listing normal)))
("folder/")
> (names (git:untracked repo (git:untracked-listing all)))
("folder/one.txt" "folder/two.txt")
> (git:untracked repo (git:untracked-listing no))
()
> (sh "cd repo && git config status.showUntrackedFiles all")
> (names (git:untracked repo #f))
("folder/one.txt" "folder/two.txt")
> (git:untracked-listing sometimes)
! universe of untracked-listing does not include specified symbol sometimes
; Advice on git:untracked changes what the status lists.
> (advice-add! git:untracked
    (lambda (original repository listing)
      (filter (lambda (path) (not (string=? (utf8->string path) "folder/one.txt"))) (original repository listing))))
> (names (git:status-untracked (git:status repo)))
("folder/two.txt")
; A detached HEAD has no branch; a repository with no commit has no HEAD.
> (sh "cd repo && git checkout -q --detach")
> (git:status-branch (git:status repo))
#f
> (sh "git init -q -b main empty")
> (define empty (git:find-repository (at "empty")))
> (let ([s (git:status empty)]) (list (git:status-branch s) (git:status-head s) (git:status-upstream s)))
("main" #f #f)
; A conflicted file is unmerged on both sides.
> (sh "git init -q -b main conflict && cd conflict && echo base > f.txt && git add f.txt && git commit -qm base && git checkout -q -b other && echo other > f.txt && git commit -qam other && git checkout -q main && echo mine > f.txt && git commit -qam mine && (git merge -q other || true)")
> (entries (git:status (git:find-repository (at "conflict"))))
(("f.txt" #f unmerged unmerged))
; A rename's old name keeps its bytes.
> (sh "git init -q -b main moved && cd moved && printf 'x' > \"$(printf 'old\\351')\" && git add -A && git commit -qm c && git mv \"$(printf 'old\\351')\" new.txt")
> (map (lambda (e) (list (git:entry-path e) (git:entry-original-path-bytes e))) (git:status-entries (git:status (git:find-repository (at "moved")))))
(("new.txt" #vu8(111 108 100 233)))
