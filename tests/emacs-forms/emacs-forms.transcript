; A command the macro defines in a module is changeable and exported.
> (call-with-output-file "~/.config/tuna/lib/my-commands.sls"
    (lambda (p)
      (put-string p "#!tuna\n(import (commands))\n(commands:define-command (hello) \"hello\")\n")))
> (import (my-commands))
> (set! my-commands:hello (lambda () "hi"))
> (list (my-commands:hello) (map car (definition-changes my-commands:hello)))
