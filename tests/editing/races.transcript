; Editing across threads, quits and reloads.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)) (tuna eval))
> (define (wait-until done?)
    (let loop ([n 0])
      (unless (or (done?) (= n 1000))
        (sleep-for 0.01)
        (loop (+ n 1)))))
> (define (on-thread thunk)
    (let ([result #f])
      (fork-thread (lambda () (set! result (raised thunk))))
      (wait-until (lambda () result))
      result))
> (start! "one two" 1)
("one two" ((1 #f)))
> (define b (views:buffer (view)))
> (on-thread (lambda () (editing:forward-word-position b 1 1)))
(editing:forward-word-position "not on the main thread")
> (on-thread (lambda () (editing:line-position b 1)))
(editing:line-position "not on the main thread")
> (on-thread (lambda () (commands:run editing:forward-char 1)))
(commands:run "not on the main thread")
; An edit outside a command, as from a job's result, leaves the marks.
> (press! "C-SPC" "C-e")
> (buffers:replace! b 1 1 ">")
#<edit 1>
> (state)
(">one two" ((9 1)))
; Reloading the plugin keeps its commands and bindings and starts its
; passing state afresh: a kill after the reload makes a new entry, and
; yank-pop has nothing to replace.
> (define library (getenv "TUNA_LIBRARY"))
> (define (reload! name) (eval-file (string-append library "/" name ".sls")))
> (start! "alpha beta gamma" 1)
("alpha beta gamma" ((1 #f)))
> (press! "M-d")
> (reload! "editing")
> (press! "M-d")
> (list (state) (kills 1))
((" gamma" ((1 #f))) (" beta"))
> (press! "C-y")
> (reload! "editing")
> (press! "M-y")
! editing:yank-pop: the previous command was not a yank
> (press! "M-f" "x")
> (state)
(" beta gammax" ((13 #f)))
; Quits requested every 100 µs land in typing, killing and yanking at
; three cursors, in the hooks that clear marks and in the bookkeeping
; after each batch. Afterwards every cursor rests on a stop, an edit
; still clears every view's marks, undo returns to the first text, and
; every report is a quit or one of the commands' own refusals.
> (set-option! editing:delete-selection #t)
> (start! "alpha beta\ngamma delta\nepsilon zeta\n" 1 12 24)
("alpha beta\ngamma delta\nepsilon zeta\n" ((1 #f) (12 #f) (24 #f)))
> (define storm (views:buffer (view)))
; The yanks grow the text with every step, and how many steps run
; depends on the machine, so the history is unbounded here to keep the
; first state.
> (buffers:with-buffer storm (set-option-local! undo:limit (greatest-fixnum)))
> (define quits 0)
> (define others '())
> (define (count-quits report c)
    (if (quit-condition? c)
        (set! quits (+ quits 1))
        (let ([m (condition-message c)])
          (unless (member m others) (set! others (cons m others))))))
> (advice-add! report count-quits)
> (define armed (box #f))
> (define quitting (box #t))
> (define requests 0)
> (define (quitter)
    (let loop ()
      (when (unbox quitting)
        (chez:sleep (make-time 'time-duration 100000 0))
        (when (box-cas! armed #t #f)
          (request-quit!)
          (set! requests (+ requests 1)))
        (loop))))
> (define steps 0)
> (define keys '("a" "S-<left>" "b" "C-SPC" "M-b" "M-w" "C-y" "M-y" "C-k" "C-y" "DEL" "M-f" "C-t" "M-u" "C-n" "C-a"))
> (define (stress until)
    (let again ()
      (guard (c [(quit-condition? c) (set! quits (+ quits 1)) (again)])
        (let loop ()
          (when (< (real-time) until)
            (for-each (lambda (k) (set-box! armed #t) (press! k)) keys)
            (sleep-for 0)
            (set! steps (+ steps 1))
            (loop)))
        (set-box! armed #f)
        (sleep-for 0.05))))
> (begin
    (fork-thread quitter)
    (stress (+ (real-time) 1500))
    (set-box! quitting #f)
    (list (> steps 10) (> requests 30) (> quits 30)))
(#t #t #t)
> (advice-remove! report count-quits)
> (list-sort string<? (filter (lambda (m) (not (member m '("end of buffer" "beginning of buffer" "the previous command was not a yank" "no two characters to transpose" "the mark is not set, so there is no region")))) others))
()
> (for-all (lambda (c) (eqv? (buffers:stop storm (views:cursor-point c)) (views:cursor-point c))) (views:cursors (view)))
#t
> (define other (views:make storm))
> (views:set-mark! other 2)
> (press! "C-SPC" "x")
> (list (views:mark (view)) (views:mark other))
(#f #f)
> (undo:go-to! storm 0)
> (text)
"alpha beta\ngamma delta\nepsilon zeta\n"
> (for-all string? (map kill-ring:text (kill-ring:entries)))
#t
