> (lsp:define-server types (fake-command "types"))
> (define a-path (string-append project "/a.fk"))
> (write-file! a-path "import os\nx = 1\n")
> (configure! "types" '(capabilities ("textDocumentSync" . 2)) '(name . "types"))
> (tables:set! lsp:language-servers "fakelang" (list types))
> (hooks:add! fake-mode-hook lsp:ensure)
> (define a (visit! a-path))
> (wait-for "types" "textDocument/didOpen")
> (define c (car (lsp:connections)))
> (define (diag line from to message . more)
    (append `(("range" ("start" ("line" . ,line) ("character" . ,from)) ("end" ("line" . ,line) ("character" . ,to)))
              ("severity" . 2) ("message" . ,message) ("source" . "types"))
            more))
> (define (publish! uri version . diags)
    (lsp:notify c "fake/send"
      `(("message" ("jsonrpc" . "2.0") ("method" . "textDocument/publishDiagnostics")
         ("params" ("uri" . ,uri) ,@(if version `(("version" . ,version)) '()) ("diagnostics" . ,(list->vector diags)))))))
> (define (seen b) (map (lambda (d) (list (diagnostics:diagnostic-message d) (document:text (buffers:document b) (diagnostics:diagnostic-start d) (diagnostics:diagnostic-end d)))) (diagnostics:in b)))
; A report about an old version is counted on that version's text, so a
; line typed above since leaves the mark on the line the server meant.
> (define then (buffers:version a))
> (buffers:replace! a 1 1 "# new line\n")
#<edit 1>
> (publish! (lsp:path->uri a-path) then (diag 0 7 9 "\"os\" is not accessed"))
> (testing:wait-until (lambda () (pair? (diagnostics:in a))))
> (seen a)
(("\"os\" is not accessed" "os"))
> (map diagnostics:diagnostic-origin (diagnostics:in a))
("types")
; A diagnostic of a file no buffer visits has its columns read from the
; file, here UTF-8 bytes after non-ASCII text.
> (lsp:shutdown c)
> (configure! "types" '(capabilities ("textDocumentSync" . 2) ("positionEncoding" . "utf-8")) '(name . "types"))
> (buffers:with-buffer a (lsp:ensure))
> (testing:wait-until (lambda () (= 2 (length (of-method "types" "textDocument/didOpen")))))
> (set! c (car (lsp:connections)))
> (define u-path (string-append project "/u.fk"))
> (write-file! u-path "café = total\n")
> (publish! (lsp:path->uri u-path) #f (diag 0 8 13 "undefined"))
> (testing:wait-until (lambda () (pair? (diagnostics:under project))))
> (map (lambda (d) (list (diagnostics:diagnostic-start d) (diagnostics:diagnostic-end d))) (filter (lambda (d) (equal? (diagnostics:diagnostic-path d) u-path)) (diagnostics:under project)))
(((1 . 7) (1 . 12)))
; A server that offers pulled diagnostics is asked when the buffer opens
; and after each change sent;
; the shut-down server's diagnostics went with it.
> (lsp:define-server lint (fake-command "lint"))
> (configure! "lint" '(capabilities ("textDocumentSync" . 2) ("diagnosticProvider" ("interFileDependencies" . #f) ("workspaceDiagnostics" . #f)))
                      '(responses ("textDocument/diagnostic" ("kind" . "full") ("items" . #((("range" ("start" ("line" . 1) ("character" . 0)) ("end" ("line" . 1) ("character" . 6))) ("severity" . 1) ("message" . "F401") ("source" . "Ruff"))))))
                      '(name . "lint"))
> (tables:set! lsp:language-servers "fakelang" (list types lint))
> (buffers:with-buffer a (lsp:ensure))
> (wait-for "lint" "textDocument/didOpen")
> (buffers:replace! a 1 1 "")
#<edit 2>
> (buffers:replace! a 1 1 "#")
#<edit 3>
> (wait-for "lint" "textDocument/diagnostic" 2)
> (testing:wait-until (lambda () (assoc "F401" (seen a))))
> (seen a)
(("F401" "import"))
> (buffers:replace! a 1 2 "")
#<edit 4>
> (wait-for "lint" "textDocument/diagnostic" 3)
> (list (length (of-method "lint" "textDocument/didChange")) (length (of-method "lint" "textDocument/diagnostic")))
(2 3)
; Code actions from every server, merged and labelled by server, the
; preferred first; one without an edit is resolved first.
> (define (action title . more) (append `(("title" . ,title) ("kind" . "quickfix")) more))
> (define (insert-edit text) `(("changes" (,(lsp:path->uri a-path) . #((("range" ("start" ("line" . 0) ("character" . 0)) ("end" ("line" . 0) ("character" . 0))) ("newText" . ,text)))))))
> (configure! "types" `(capabilities ("textDocumentSync" . 2) ("positionEncoding" . "utf-8") ("codeActionProvider" ("resolveProvider" . #t)))
                       `(responses ("textDocument/codeAction" . #(,(action "Remove import") ,(action "Ignore" '("isPreferred" . #t))))
                                   ("codeAction/resolve" . ,(action "Remove import" (cons "edit" (insert-edit "R")))))
                       '(name . "types"))
> (configure! "lint" `(capabilities ("textDocumentSync" . 2) ("codeActionProvider" . #t))
                      `(responses ("textDocument/codeAction" . #(,(action "Fix all" (cons "edit" (insert-edit "F"))))))
                      '(name . "lint"))
> (for-each (lambda (c) (lsp:reconnect c)) (lsp:connections))
> (testing:wait-until (lambda () (and (= 3 (length (of-method "types" "textDocument/didOpen"))) (= 2 (length (of-method "lint" "textDocument/didOpen"))))))
> (define t (start! (lambda () (press! "C-c" "a"))))
> (wait-matches (session))
> (texts (session))
("Ignore (types)" "Remove import (types)" "Fix all (lint)")
> (press! "C-n" "RET")
> (result t)
> (list (text a) (length (of-method "types" "codeAction/resolve")))
("R# new line\nimport os\nx = 1\n" 1)
; C-u asks for the kind, which goes as the request's only.
> (define t (start! (lambda () (press! "C-u" "C-c" "a"))))
> (wait-matches (session))
> (texts (session))
("quickfix" "refactor.inline" "refactor.extract" "refactor.rewrite" "source.organizeImports")
> (type! "refactor.extract")
> (press! "RET")
> (testing:wait-until (lambda () (session)))
> (press! "C-g")
! &cancelled
> (result t)
> (ref (last-of "types" "textDocument/codeAction") "params" "context" "only")
#("refactor.extract")
; A connection that a reconnect replaces while the code-action hint is
; asking the others gives the hint nothing, and the hint does not fail.
> (configure! "types" `(capabilities ("textDocumentSync" . 2) ("codeActionProvider" . #t))
                       `(responses ("textDocument/codeAction" . (delay 0.5 #(,(action "Slow")))))
                       '(name . "types"))
> (define opened (list (length (of-method "types" "textDocument/didOpen")) (length (of-method "lint" "textDocument/didOpen"))))
> (for-each (lambda (c) (lsp:reconnect c)) (lsp:connections))
> (testing:wait-until (lambda () (and (= (+ 1 (car opened)) (length (of-method "types" "textDocument/didOpen")))
                              (= (+ 1 (cadr opened)) (length (of-method "lint" "textDocument/didOpen"))))))
> (define hint-source (diagnostics:make-source))
> (diagnostics:report! hint-source a (list (diagnostics:make-diagnostic 1 3 (diagnostics:severity warning) "here")))
#t
> (in-client (lambda () (views:set-point! (view) 2)))
> (define asked (start! (lambda () (lsp:code-action-hint (view)))))
> (lsp:reconnect (cadr (lsp:buffer-connections a)))
> (docs-at-point:doc-text (result asked))
"Slow (C-c a)"
; A reconnect leaves the buffer one docs entry of each kind per
; connection, not the replaced connection's as well.
> (define (sources) (length (buffers:with-buffer a (hooks:entries docs-at-point:sources))))
> (define before (sources))
> (for-each (lambda (c) (lsp:reconnect c)) (lsp:connections))
> (testing:wait-until (lambda () (= 2 (length (lsp:buffer-connections a)))))
> (timers:sleep 0.3)
> (= before (sources))
#t
