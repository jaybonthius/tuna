; Who set what: definitions, options, tables and the changes of a module.
> (tables:set! files:modes "rkt" 'racket)
> (definition-changes spell:dictionary-path)
((#<owner (init) 1> override #f) (#<owner (spell) 1> define #f))
> (options:settings spell:language)
(((init) "en-GB"))
> (tables:owner files:modes "rkt")
#<owner (repl) 1>
> (map car (owner-changes (plugins:configuration-owner)))
(advice override)
> (map car (owner-changes (module-owner '(spell))))
(define define define)
> (map car (owner-changes (module-owner '(prog))))
(define define define)
; Evaluating the configuration again takes back its changes, then runs it.
> (import (plugins))
> (plugins:load-configuration!)
> (length (owner-changes (plugins:configuration-owner)))
2
> (list (fill:column) (spell:language))
(80 "en-GB")
