; The ring's text is saved data: written after the batch that changes
; it, and rebuilt from it when the plugin loads again. A kill comes back
; as its text; an entry with a kill over 4,096 characters, and the yank
; pointer, do not.
> (define b (buffers:make "b" "Hello world\n"))
> (buffers:define-layer responses (travels) (sticky after))
> (buffers:add-span! (buffers:layer b responses) 1 6 'gpt)
> (define hello (buffers:piece b 1 6))
> (define long-a (make-string 4096 #\a))
> (kill-ring:push! (list long-a))
> (kill-ring:push! (list "small" (make-string 4097 #\b)))
> (kill-ring:push! (list "one" hello))
> (kill-ring:push! (list "newest"))
> (define one (kill-ring:rotate! 1))
> one
("one" #<kill>)
> (define expected (list '("newest") '("one" "Hello") (list long-a)))
> (testing:wait-until (lambda () (equal? (saved-texts) expected)))
> (equal? (saved-texts) expected)
#t
; Reloading the plugin's source keeps the text, the configuration's
; setting and hook entry; kills made before it are still kills.
> (import (tuna eval))
> (eval-file (string-append (getenv "TUNA_LIBRARY") "/kill-ring.sls"))
> (equal? (ring-texts) expected)
#t
> (list (kill-ring:current) (kill-ring:skip-duplicates))
(("newest") #t)
> (set! pushed '())
> (kill-ring:push! (list "after"))
> (take-pushed!)
("after")
> (list (kill-ring:insert! b 12 (cadr one)) (spans-of b responses))
(((12 . 17)) (("Hello" gpt) ("Hello" gpt)))
> (map car (definition-changes batch-ended))
((kill-ring) (tuna))
; Unloading saves a change made in the same batch, and takes back the
; advice that saves after each batch.
> (begin (kill-ring:push! (list "last")) (unload-module! '(kill-ring)))
> (definition-changes batch-ended)
(((tuna) define #f))
> (testing:wait-until (lambda () (equal? (car (saved-texts)) '("last"))))
> (car (saved-texts))
("last")
> (load-module! '(kill-ring))
> (list (kill-ring:current) (length (kill-ring:entries)) (map car (definition-changes batch-ended)))
(("last") 5 ((kill-ring) (tuna)))
