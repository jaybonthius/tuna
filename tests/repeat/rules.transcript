> (define c1 (web:add-client! 1))
> (define c2 (web:add-client! 2))
> (press! c1 "C-x" "3")
> (weights)
(1 1)
; Only a command run by two or more keys enters, and only when the last
; key is bound to that command in a repeating keymap.
> (keys:bind! keys:global "<f5>" layout-split:enlarge)
> (press! c1 "<f5>")
> (list (weights) (keymap-names c1))
((6/5 4/5) (keys:global))
> (keys:bind! keys:global "C-c e" layout-split:enlarge)
> (press! c1 "C-c" "e")
> (list (weights) (keymap-names c1))
((7/5 3/5) (keys:global))
> (keys:bind! keys:global "C-c }" layout-split:balance)
> (press! c1 "C-c" "}")
> (list (weights) (keymap-names c1))
((1 1) (keys:global))
; A prefix argument before the keys goes to the command; one typed while
; repeating is another key, so it ends the repetition.
> (press! c1 "C-u" "C-x" "}")
> (list (weights) (keymap-names c1))
((9/5 1/5) (layout-split:resize-keymap keys:global))
> (press! c1 "C-u")
> (list (weights) (keymap-names c1))
((9/5 1/5) (keymap keys:global))
> (press! c1 "}")
! } is undefined
> (list (weights) (keymap-names c1))
((9/5 1/5) (keys:global))
; Keys no client typed repeat nothing.
> (press! c1 "C-x" "+")
> (layout:call-with-frame (layout:frame c1) (lambda () (keys:press! c1 "C-x") (keys:press! c1 "}")))
> (list (weights) (keymap-names c1))
((6/5 4/5) (keys:global))
; Each client repeats on its own.
> (press! c1 "C-x" "}")
> (list (keymap-names c1) (keymap-names c2))
((layout-split:resize-keymap keys:global) (keys:global))
> (press! c2 "C-x" "{" "{")
> (press! c1 "}")
> (list (weights) (keymap-names c1) (keymap-names c2))
((6/5 4/5) (layout-split:resize-keymap keys:global) (layout-split:resize-keymap keys:global))
> (press! c2 "C-g")
> (list (keymap-names c1) (keymap-names c2))
((layout-split:resize-keymap keys:global) (keys:global))
; Entering another repeating keymap ends the first.
> (define-table next-keymap)
> (keys:bind! next-keymap "n" layout:other-view)
> (keys:bind! layout-split:resize-keymap "C-c n" layout:other-view)
> (table-set! repeat:keymaps next-keymap)
> (press! c1 "C-c" "n")
> (list (layout:selected-view) (keymap-names c1))
(#<view 2> (keymap keys:global))
> (press! c1 "n" "n")
> (list (layout:selected-view) (keymap-names c1))
(#<view 2> (keymap keys:global))
; Reloading the plugin ends every repetition, and the keymaps it holds
; stay.
> (press! c1 "C-g" "C-x" "}")
> (keymap-names c1)
(layout-split:resize-keymap keys:global)
> (import (tuna eval))
> (eval-file (string-append (getenv "TUNA_LIBRARY") "/repeat.sls"))
> (keymap-names c1)
(keys:global)
> (map (lambda (entry) (eq? (car entry) layout-split:resize-keymap)) (table-entries repeat:keymaps))
(#t #f)
> (press! c1 "C-x" "{" "{")
> (list (weights) (keymap-names c1))
((7/5 3/5) (layout-split:resize-keymap keys:global))
; A command that raises has still run, so its keymap repeats, as Emacs's
; repeat-mode does after an error.
> (press! c1 "C-g" "C-x" "0")
> (press! c1 "C-x" "}")
! layout-split:enlarge: the selected view is in no split
> (keymap-names c1)
(layout-split:resize-keymap keys:global)
> (press! c1 "}")
! layout-split:enlarge: the selected view is in no split
> (keymap-names c1)
(layout-split:resize-keymap keys:global)
