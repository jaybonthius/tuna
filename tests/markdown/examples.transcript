; The blocks of a text are datums of the plugin's kinds, one per
; top-level block, each with its index as its key.
> (markdown:blocks "See **TSPL**.")
((markdown:paragraph ((key . 0)) "See " (markdown:strong () "TSPL") ".\n"))
; Text still arriving reads with what is open at its end closed.
> (markdown:unfinished-blocks "Some **bol")
((markdown:paragraph ((key . 0)) "Some " (markdown:strong () "bol") "\n"))
> (markdown:unfinished-blocks "See [the spec](https://spec.comm")
((markdown:paragraph ((key . 0)) "See the spec\n"))
> (markdown:unfinished-blocks "Steps:\n-")
((markdown:paragraph ((key . 0)) "Steps:\n"))
; An atom drawn with markdown:html.
> (import (page) (notes))
> (define notes (buffers:make "*notes*" (page:page '() (notes:note '((text . "**Buy** [milk](https://shop.example)"))))))
> (show! notes)
> (element (view) "<div class=\"markdown\"" "div")
"<div class=\"markdown\"><div class=\"markdown-paragraph\"><strong class=\"markdown-strong\">Buy</strong> <span class=\"markdown-link\">milk</span>\n</div></div>"
; The configuration's key on links follows the link at point.
> (define b (page:make "*links*" "Read [the guide](https://tuna.example/guide)."))
> (show! b)
> (views:set-point! (view) 9)
> (web:take-page-calls!)
((1 "keys-settings" (("quitKeys" . #("C-g")) ("leftOptionMeta" . #t) ("rightOptionMeta" . #t))))
> (press! "C-c" "C-o")
> (web:take-page-calls!)
((1 "browse-url" "https://tuna.example/guide"))
; The chat: a reply rebuilt once per batch while it streams, read-only,
; with no undo history and never modified.
> (import (chat))
> (show! chat:chat)
> (chat:receive! "Steps:\n-")
> (datums chat:chat)
((chat:reply () (markdown:paragraph ((key . 0)) "Steps:\n")))
> (chat:receive! " **one")
> (datums chat:chat)
((chat:reply () (markdown:paragraph ((key . 0)) "Steps:\n") (markdown:list ((key . 1) (ordered . #f) (tight . #t)) (markdown:item ((key . 0)) (markdown:paragraph ((key . 0)) (markdown:strong () "one") "\n")))))
> (chat:receive! "** and `two`\n")
> (chat:finish!)
> (datums chat:chat)
((chat:reply () (markdown:paragraph ((key . 0)) "Steps:\n") (markdown:list ((key . 1) (ordered . #f) (tight . #t)) (markdown:item ((key . 0)) (markdown:paragraph ((key . 0)) (markdown:strong () "one") " and " (markdown:code () "two") "\n")))))
> (list (buffers:modified? chat:chat) (length (cddr (undo:history chat:chat))))
(#f 1)
> (views:set-point! (view) 5)
> (press! "x")
! buffers:replace!: a read-only span refuses the edit with irritant chat:written
> (text chat:chat)
"Steps:\none and two\n"
