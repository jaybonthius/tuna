(import (tuna) (test) (test-user) (layout) (layout-split) (layout-tabs) (views) (buffers) (document) (commands)
        (keys) (options) (ask) (tables) (web)
        (layout-tabs-test parts))

(define atom layout-tabs-test/parts:atom)
(define outline layout-tabs-test/parts:outline)
(define set-parts! layout-tabs-test/parts:set-parts!)
(define tabs-children layout-tabs-test/parts:tabs-children)
(define raised-with layout-tabs-test/parts:raised-with)
(define refusals-during layout-tabs-test/parts:refusals-during)
(define mouse! layout-tabs-test/parts:mouse!)
(define name-of layout-tabs-test/parts:name-of)

(define (named name) (or (buffers:find name) (buffers:make name (string-append name "\n"))))

(define (fresh name) (views:make (named name)))

(define (selected) (name-of (layout:selected-view)))

(define (start-of n) (document:node-start n))

(define (click! at) (mouse! (list layout-tabs:keymap) 1 at))

(define close-keymaps (list layout-tabs:close-keymap layout-tabs:keymap))

(test "C-x t 2 wraps a view in no tabs in a tabs container, as its first tab, and selects a new view of its buffer at its point in a tab after it"
  (let ([v (views:make (buffers:make (buffers:free-name "notes") "one\ntwo\n"))])
    (set-parts! (atom v))
    (layout:select! v)
    (views:set-point! v 5)
    (test-user:press! "C-x t 2")
    (check-equal? (list 'layout:level (list 'layout-tabs:container (name-of v) (name-of v))) (outline))
    (check (not (eq? v (layout:selected-view))))
    (check-equal? 5 (views:point (layout:selected-view)))))

(test "add-tab! adds a tab after the tab holding the view without selecting it, and checks its arguments"
  (let ([a (fresh "a")] [b (fresh "b")])
    (set-parts! (layout-tabs:container '() (atom a) (atom b)))
    (layout:select! b)
    (let ([new (layout-tabs:add-tab! a (named "other"))])
      (check-equal? '(layout:level (layout-tabs:container "a" "other" "b")) (outline))
      (check (eq? b (layout:selected-view)))
      (check (views:view? new)))
    (check-raises (raised-with 'layout-tabs:add-tab! "not a view") (layout-tabs:add-tab! 'view (named "other")))
    (check-raises (raised-with 'layout-tabs:add-tab! "not a buffer") (layout-tabs:add-tab! a "other"))
    (check-raises (raised-with 'layout-tabs:add-tab! "not a view in the layout") (layout-tabs:add-tab! (fresh "x") (named "other")))))

(test "only the focused tab is drawn, under a strip with a tab per child, each marking its child's range and labelled with its title"
  (let ([a (fresh "a")] [b (fresh "b")])
    (set-parts! (layout-tabs:container '() (atom a) (atom b '(title . "config"))))
    (layout:select! a)
    (test-user:settle)
    (let* ([sxml (test-user:screen)] [tabs (car (test-user:elements sxml "tabs"))])
      (check-equal? "tabs focus-path" (test-user:element-attribute tabs "class"))
      (check-equal? "tablist" (test-user:element-attribute (car (test-user:elements sxml "tabs-strip")) "role"))
      (let ([panel (car (test-user:elements sxml "tabs-panel"))])
        (check-equal? '("tabpanel" "a") (list (test-user:element-attribute panel "role") (test-user:element-attribute panel "aria-label"))))
      (check-equal? (map (lambda (c) (list (number->string (document:node-start c)) (number->string (document:node-end c)))) (tabs-children))
                    (map (lambda (e) (list (test-user:element-attribute e "data-at") (test-user:element-attribute e "data-to")))
                         (test-user:elements sxml "tab")))
      (check-equal? '(("a" "tab" "true") ("config" "tab" "false"))
                    (map (lambda (e) (list (test-user:element-text e) (test-user:element-attribute e "role") (test-user:element-attribute e "aria-selected")))
                         (test-user:elements sxml "layout-tabs-label")))
      (check-equal? '(("×" "true") ("×" "true"))
                    (map (lambda (e) (list (test-user:element-text e) (test-user:element-attribute e "aria-hidden")))
                         (test-user:elements sxml "layout-tabs-close")))
      (check-equal? (list (views:id a)) (map (lambda (e) (string->number (test-user:element-attribute e "data-view"))) (test-user:elements sxml "view"))))
    (check-equal? '("a" "config") (map (lambda (v) (layout:part-title (layout:view-node v))) (list a b)))))

(test "the views of the tabs not shown are not counted, so C-x o, reuse-view and use-other-view pass over them"
  (let ([a (fresh "a")] [b (fresh "b")])
    (set-parts! (layout-tabs:container '() (atom a) (atom b)))
    (layout:select! a)
    (check-equal? (list a) (layout:views))
    (check-equal? #f (layout:reuse-view (views:buffer b)))
    (check (eq? a (layout:reuse-view (views:buffer a))))
    (let ([said '()])
      (options:set! ask:message-writer (lambda (text) (set! said (cons text said))))
      (test-user:press! "C-x o")
      (options:unset! ask:message-writer)
      (check-equal? '("No other view to select") said))
    (check (eq? a (layout:selected-view)))
    (check-equal? #f (layout:use-other-view (named "elsewhere")))
    (options:set! layout:display-action layout:use-other-view)
    (check (eq? a (layout:display-buffer (named "elsewhere"))))
    (options:unset! layout:display-action)))

(define (three-tabs!)
  (let ([a (fresh "a")] [b (fresh "b")] [c (fresh "c")])
    (set-parts! (layout-tabs:container '() (atom a) (atom b) (atom c)))
    (layout:select! a)
    (values a b c)))

(test "C-x t o and C-x t O move through the tabs cyclically, with a count from the prefix argument"
  (three-tabs!)
  (test-user:press! "C-x t o")
  (check-equal? "b" (selected))
  (test-user:press! "C-x t o")
  (check-equal? "c" (selected))
  (test-user:press! "C-x t O")
  (check-equal? "b" (selected))
  (test-user:press! "C-u 2 C-x t o")
  (check-equal? "a" (selected))
  (test-user:press! "M-- C-x t o")
  (check-equal? "c" (selected))
  (commands:run layout-tabs:previous-tab 4)
  (check-equal? "b" (selected))
  (check-raises (raised-with 'layout-tabs:next-tab "not an exact integer") (layout-tabs:next-tab 'x))
  (check-raises (raised-with 'layout-tabs:previous-tab "not an exact integer") (layout-tabs:previous-tab 'x)))

(define (split-tab!)
  (let ([a (fresh "a")] [b (fresh "b")] [c (fresh "c")] [d (fresh "d")])
    (set-parts! (layout-tabs:container '() (atom a) (layout-split:container '((direction . row)) (atom b) (atom c)) (atom d)))
    (layout:select! c)
    (layout:select! a)
    (values a b c d)))

(test "a tab whose child is a container leads to the view selected last in it, not to its first, and C-x t o goes there"
  (let-values ([(a b c d) (split-tab!)])
    (check-equal? (list a b c d) (map (lambda (v) (layout:part-view (layout:view-node v))) (list a b c d)))
    (check (eq? c (layout:part-view (cadr (tabs-children)))))
    (check (eq? a (layout:part-view (document:token (buffers:document layout:buffer) 0))))
    (check-raises (raised-with 'layout:part-view "not a node") (layout:part-view 'node))
    (test-user:press! "C-x t o")
    (check-equal? "c" (selected))
    (test-user:press! "C-x t o")
    (check-equal? "d" (selected))))

(test "tabs leave moving between views to the containers around them"
  (let-values ([(a b c d) (split-tab!)])
    (check-equal? '(#f #f #f #f)
                  (map (lambda (dir) (layout:neighbour d dir))
                       (list (layout:direction left) (layout:direction right) (layout:direction up) (layout:direction down))))
    (layout:select! b)
    (check (eq? c (layout:neighbour b (layout:direction right))))))

(test "a press on a tab selects the view the tab leads to, as its element marks its child and carries layout-tabs:keymap; its release does nothing"
  (let-values ([(a b c d) (split-tab!)])
    (layout:select! c)
    (click! (start-of (layout:view-node a)))
    (check-equal? "a" (selected))
    (click! (start-of (cadr (tabs-children))))
    (check-equal? "c" (selected))
    (layout:select! d)
    (layout:select! b)
    (layout:select! d)
    (click! (start-of (cadr (tabs-children))))
    (check-equal? "b" (selected))
    (mouse! (list) 1 (start-of (layout:view-node c)))
    (check-equal? "c" (selected))
    (mouse! (list layout-tabs:keymap) 1 (start-of (layout:view-node a)) (buffers:version layout:buffer) '("click"))
    (check-equal? "c" (selected))))

(test "a click on a tab closed since its screen was drawn is stale"
  (let-values ([(a b c d) (split-tab!)])
    (layout:select! c)
    (let ([version (buffers:version layout:buffer)] [at (start-of (layout:view-node a))])
      (layout:delete-part! (layout:view-node a))
      (check-equal? '((#f "Stale click: what was clicked is gone"))
                    (refusals-during (lambda () (mouse! (list layout-tabs:keymap) 1 at version '("down" "click")))))
      (check-equal? "c" (selected)))))

(test "C-x t 0 closes the tab holding the selected view, with every part in it, and selects the view selected last before"
  (let-values ([(a b c d) (split-tab!)])
    (layout:select! d)
    (layout:select! c)
    (test-user:press! "C-x t 0")
    (check-equal? '(layout:level (layout-tabs:container "a" "d")) (outline))
    (check-equal? "d" (selected))))

(test "closing the only tab removes its container, and a split left one child collapses; a tabs container left one tab stays"
  (let ([e (fresh "e")] [f (fresh "f")])
    (set-parts! (layout-split:container '((direction . column)) (atom e '(weight . 3)) (layout-tabs:container '((weight . 2)) (atom f))))
    (layout:select! f)
    (test-user:press! "C-x t 0")
    (check-equal? '(layout:level "e") (outline))
    (check-equal? "e" (selected))
    (check-equal? '((layout-tabs:close-tab "the selected view is in no tabs")) (refusals-during (lambda () (test-user:press! "C-x t 0"))))
    (check-raises (raised-with 'layout-tabs:next-tab "the selected view is in no tabs") (layout-tabs:next-tab 1))
    (layout:select! (layout-tabs:add-tab! e (named "e2")))
    (test-user:press! "C-x t 0")
    (check-equal? '(layout:level (layout-tabs:container "e")) (outline))
    (check-raises (raised-with 'layout:delete-part! "the last view of its level") (layout-tabs:close-tab))))

(test "wrapping a view gives the new tabs container the view's place, its weight and depth; its title stays with it"
  (let ([e (fresh "e")] [g (fresh "g")])
    (set-parts! (layout-split:container '((direction . row)) (atom e '(weight . 2) '(depth . 50) '(title . "main")) (atom g)))
    (layout-tabs:add-tab! e (named "other"))
    (let ([tabs (caddr (caddr (layout-tabs-test/parts:tree)))])
      (check-equal? '(layout-tabs:container ((weight . 2) (depth . 50))) (list-head tabs 2))
      (check-equal? '((title . "main")) (cddr (vector-ref (caddr tabs) 1))))))

(define (with-echo part)
  (layout-split:container '((direction . column))
    (layout:level '() part)
    (atom (fresh "*Echo*") '(depth . 90) '(size . content) '(locked . #t))))

(test "a locked view takes no tab, and C-x t o and clicks pass over a tab leading to one"
  (let ([g (fresh "g")] [h (fresh "h")] [k (fresh "k")])
    (set-parts! (with-echo (layout-tabs:container '() (atom g) (atom h '(locked . #t)) (atom k))))
    (let ([echo (layout:find-view (named "*Echo*"))])
      (check-raises (raised-with 'layout-tabs:add-tab! "a locked view") (layout-tabs:add-tab! echo (named "other")))
      (layout:select! echo)
      (check-equal? #f (layout-tabs:display-in-new-tab (named "other"))))
    (layout:select! g)
    (commands:run layout-tabs:next-tab 1)
    (check-equal? "k" (selected))
    (commands:run layout-tabs:next-tab 1)
    (check-equal? "g" (selected))
    (click! (start-of (layout:view-node h)))
    (check-equal? "g" (selected))))

(test "a display rule's new tab goes after the selected view's tab and is selected, so it is shown"
  (let ([g (fresh "g")] [m (fresh "m")])
    (set-parts! (layout-tabs:container '() (atom g) (atom m)))
    (layout:select! g)
    (let ([v (layout-tabs:display-in-new-tab (named "other"))])
      (check-equal? '(layout:level (layout-tabs:container "g" "other" "m")) (outline))
      (check (eq? v (layout:selected-view)))
      (check-equal? (list v) (layout:views)))))

(test "the page's examples: a rule shows a status buffer in a new tab, and code runs a tab command for a client in the selected view"
  (let ([g (fresh "g")])
    (set-parts! (layout-tabs:container '() (atom g) (atom (fresh "init.ss") '(title . "config"))))
    (layout:select! g)
    (let ([status? (lambda (b) (string=? (buffers:name b) "magit: tuna"))])
      (tables:set! layout:display-rules status? layout-tabs:display-in-new-tab)
      (let ([v (layout:display-buffer (named "magit: tuna"))])
        (check-equal? '(layout:level (layout-tabs:container "g" "magit: tuna" "init.ss")) (outline))
        (check-equal? (list v) (layout:views)))
      (tables:remove! layout:display-rules status?))
    (views:call-with-view (layout:selected-view) (lambda () (commands:run layout-tabs:new-tab)))
    (check-equal? '(layout:level (layout-tabs:container "g" "magit: tuna" "magit: tuna" "init.ss")) (outline))))

(test "a zoom draws the zoomed view in place of its level's part, with no strip"
  (let ([g (fresh "g")] [m (fresh "m")] [n (fresh "n")])
    (set-parts! (with-echo (layout-tabs:container '() (atom g) (atom m) (atom n))))
    (layout:select! n)
    (commands:run layout:zoom)
    (check (eq? n (layout:zoomed-view)))
    (test-user:settle)
    (check-equal? '() (test-user:elements (test-user:screen) "tabs-strip"))
    (commands:run layout:zoom)
    (check-equal? #f (layout:zoomed-view))))

(test "balancing a split whose views tabs hide still balances it"
  (let ([g (fresh "g")] [m (fresh "m")] [n (fresh "n")])
    (set-parts! (with-echo (layout-split:container '((direction . row)) (atom g '(weight . 3)) (layout-tabs:container '((weight . 2)) (atom m) (atom n)))))
    (layout:select! g)
    (test-user:press! "C-x +")
    (let ([split (caddr (caddr (caddr (layout-tabs-test/parts:tree))))])
      (check-equal? '(((weight . 1)) ((weight . 1)))
                    (list (cddr (vector-ref (caddr split) 1)) (cadr (cadddr split)))))))

(test "tabs inside a tab each draw their strip, and a click on an inner label is the inner container's"
  (let ([g (fresh "g")] [p (fresh "p")] [q (fresh "q")])
    (set-parts! (layout-tabs:container '() (atom g) (layout-tabs:container '() (atom p) (atom q))))
    (layout:select! q)
    (test-user:settle)
    (check-equal? 2 (length (test-user:elements (test-user:screen) "tabs-strip")))
    (click! (start-of (layout:view-node p)))
    (check-equal? "p" (selected))
    (click! (start-of (layout:view-node g)))
    (check-equal? "g" (selected))))

(test "recent-tab goes to the tab used last before the selected view's, so repeating it goes back and forth; a count goes further"
  (let ([t1 (fresh "t1")] [t2 (fresh "t2")] [t3 (fresh "t3")] [t4 (fresh "t4")])
    (set-parts! (layout-tabs:container '() (atom t1) (atom t2) (atom t3) (atom t4)))
    (for-each layout:select! (list t1 t3 t2))
    (commands:run layout-tabs:recent-tab 1)
    (check-equal? "t3" (selected))
    (commands:run layout-tabs:recent-tab 1)
    (check-equal? "t2" (selected))
    (commands:run layout-tabs:recent-tab 2)
    (check-equal? "t1" (selected))
    (check-raises (raised-with 'layout-tabs:recent-tab "no more recent tabs") (layout-tabs:recent-tab 3))
    (check-raises (raised-with 'layout-tabs:recent-tab "not a positive exact integer") (layout-tabs:recent-tab 0))
    (check-raises (raised-with 'layout-tabs:recent-tab "not a positive exact integer") (layout-tabs:recent-tab 'x))))

(test "a tab is as recent as the view selected last in it, which it leads to, and a tab leading to a locked view is passed over"
  (let ([t1 (fresh "t1")] [t2 (fresh "t2")] [t5 (fresh "t5")] [t6 (fresh "t6")] [t7 (fresh "t7")])
    (set-parts! (layout-tabs:container '() (atom t1) (layout-split:container '((direction . row)) (atom t5) (atom t6)) (atom t7 '(locked . #t)) (atom t2)))
    (for-each layout:select! (list t1 t6 t5 t7 t2))
    (commands:run layout-tabs:recent-tab 1)
    (check-equal? "t5" (selected))))

(define (in-layout name)
  (let atoms ([d (layout-tabs-test/parts:tree)])
    (if (vector? d)
        (let ([v (views:find (cdr (assq 'view (vector-ref d 1))))]) (and (equal? name (name-of v)) v))
        (exists atoms (cddr d)))))

(define (other-tabs!)
  (let ([vs (map fresh '("u0" "u1" "u2" "u3" "u4" "u5"))])
    (define (u k) (list-ref vs k))
    (set-parts! (layout-tabs:container '() (atom (u 0)) (layout-split:container '((direction . row)) (atom (u 1)) (atom (u 2) '(locked . #t)))
                  (atom (u 3)) (layout-tabs:container '() (atom (u 4)) (atom (u 5)))))
    (layout:select! (u 3))
    vs))

(test "C-x t 1 deletes every other tab of the innermost tabs holding the selected view, but a tab holding a locked part, and window history takes it back in one step"
  (other-tabs!)
  (let ([before (outline)])
    (test-user:press! "C-x t 1")
    (check-equal? '(layout:level (layout-tabs:container (layout-split:container "u1" "u2") "u3")) (outline))
    (check-equal? "u3" (selected))
    (test-user:press! "C-c <left>")
    (check-equal? before (outline))
    (test-user:press! "C-c <right>")
    (check-equal? '(layout:level (layout-tabs:container (layout-split:container "u1" "u2") "u3")) (outline))
    (test-user:press! "C-c <left>")
    (layout:select! (in-layout "u4"))
    (test-user:press! "C-x t 1")
    (check-equal? '(layout:level (layout-tabs:container "u0" (layout-split:container "u1" "u2") "u3" (layout-tabs:container "u4"))) (outline))))

(test "selecting a tab changes no part, so window history records no step for it"
  (let ([v1 (fresh "v1")] [v2 (fresh "v2")])
    (set-parts! (layout-split:container '((direction . row)) (layout:level '() (layout-tabs:container '() (atom v1) (atom v2))) (atom (fresh "v3"))))
    (layout:select! v1)
    (test-user:press! "C-x t o")
    (test-user:press! "C-x t 1")
    (test-user:press! "C-c <left>")
    (check-equal? '(layout:level (layout-split:container (layout:level (layout-tabs:container "v1" "v2")) "v3")) (outline))
    (check-equal? "v2" (selected))
    (check-equal? '((layout:history-back "no more back history in this level")) (refusals-during (lambda () (test-user:press! "C-c <left>"))))))

(test "close-other-tabs and recent-tab need the selected view in tabs, and C-x t 1 tabs inside its level"
  (set-parts! (atom (fresh "alone")))
  (layout:select! (car (layout:views)))
  (check-raises (raised-with 'layout-tabs:close-other-tabs "the selected view is in no tabs") (layout-tabs:close-other-tabs))
  (check-raises (raised-with 'layout-tabs:recent-tab "the selected view is in no tabs") (layout-tabs:recent-tab 1))
  (let ([w1 (fresh "w1")] [w2 (fresh "w2")] [w3 (fresh "w3")])
    (set-parts! (layout-tabs:container '() (atom w1) (layout:level '() (layout-split:container '((direction . row)) (atom w2) (atom w3)))))
    (layout:select! w1)
    (layout:select! w3)
    (let ([before (outline)])
      (check-equal? '((layout-tabs:close-other-tabs "the selected view is in no tabs inside its level"))
                    (refusals-during (lambda () (test-user:press! "C-x t 1"))))
      (check-raises (raised-with 'layout-tabs:close-other-tabs "the selected view is in no tabs inside its level") (layout-tabs:close-other-tabs))
      (check-equal? before (outline)))))

(test "tabs a history step brings back are new parts, none of whose views has been selected since"
  (let ([w1 (fresh "w1")] [w2 (fresh "w2")])
    (set-parts! (layout-tabs:container '() (atom w1) (atom w2)))
    (layout:select! w1)
    (layout:select! w2)
    (test-user:press! "C-x t 1")
    (test-user:press! "C-c <left>")
    (check-equal? '(layout:level (layout-tabs:container "w1" "w2")) (outline))
    (check-raises (raised-with 'layout-tabs:recent-tab "no more recent tabs") (layout-tabs:recent-tab 1))))

(test "the close button closes the tab clicked, with every part in it, without selecting it; the middle button closes a tab, on it or on its button"
  (let ([r1 (fresh "r1")] [r2 (fresh "r2")] [r3 (fresh "r3")])
    (set-parts! (layout-tabs:container '() (atom r1) (layout-split:container '((direction . row)) (atom r2) (atom r3))))
    (layout:select! r1)
    (mouse! close-keymaps 1 (start-of (cadr (tabs-children))))
    (check-equal? '("r1" 1) (list (selected) (length (tabs-children))))
    (let ([r4 (layout-tabs:add-tab! r1 (named "other"))])
      (mouse! (list layout-tabs:keymap) 2 (start-of (car (tabs-children))))
      (check-equal? (list "other" 1) (list (selected) (length (tabs-children))))
      (layout:select! (layout-tabs:add-tab! r4 (named "other")))
      (mouse! close-keymaps 2 (start-of (car (tabs-children))))
      (check-equal? 1 (length (tabs-children))))))

(test "a tab holding a locked part stays when its close button is clicked, and the button's press does nothing"
  (let ([r5 (fresh "r5")] [r6 (fresh "r6")])
    (set-parts! (layout-tabs:container '() (atom r5) (atom r6 '(locked . #t))))
    (layout:select! r5)
    (mouse! close-keymaps 1 (start-of (cadr (tabs-children))))
    (check-equal? 2 (length (tabs-children)))
    (check-equal? '(("<down-mouse-1>" . keys:ignore) ("<mouse-1>" . layout-tabs:mouse-close-tab))
                  (map (lambda (b) (cons (car b) (commands:command-name (cdr b)))) (keys:bindings layout-tabs:close-keymap)))))

(test "a tab's child names the tab even when it is a tabs container, whose first tab's child starts where the outer tab's child is entered"
  (let ([r7 (fresh "r7")] [r8 (fresh "r8")] [r9 (fresh "r9")])
    (set-parts! (layout-tabs:container '() (atom r7) (layout-tabs:container '() (atom r8) (atom r9))))
    (layout:select! r7)
    (let ([inner-first (document:token (buffers:document layout:buffer) (+ (start-of (cadr (tabs-children))) 1))])
      (check-equal? (+ (start-of (cadr (tabs-children))) 1) (start-of inner-first))
      (mouse! close-keymaps 1 (start-of inner-first))
      (check-equal? '(layout:level (layout-tabs:container "r7" (layout-tabs:container "r9"))) (outline))
      (mouse! close-keymaps 1 (start-of (cadr (tabs-children))))
      (check-equal? '(layout:level (layout-tabs:container "r7")) (outline)))))

(test "the kind's stylesheet is in web's table of stylesheets"
  (check-equal? "layout-tabs/layout-tabs.css" (tables:ref web:stylesheets 'layout-tabs #f)))
