> (define (library-file name) (string-append (getenv "TUNA_LIBRARY") "/" name))
> (system (string-append "mkdir -p " (getenv "HOME") "/long"))
0
> (define chat (pi:start (string-append (getenv "HOME") "/long") "long-session"))
> (define f (fake-of chat))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (for-each (lambda (n)
              (let ([u (string-append "u" (number->string n))] [a (string-append "a" (number->string n))])
                (append-entry! f (entry u (if (= n 0) #f (string-append "a" (number->string (- n 1)))) (user-message (string-append "Ask " (number->string n)))))
                (append-entry! f (entry a u (assistant-message "stop" (text-block (string-append "Reply **" (number->string n) "**")))))))
            (iota 50))
; The history pi reads after a change of session or a reload comes in
; whole; its Markdown is made on a thread of pi-chat's own, and each
; message shows as its plain text until its blocks arrive.
> (eval-file (library-file "pi.sls"))
> (define chat (car (pi:chats)))
> (testing:wait-until (lambda () (= 100 (length (pi:chat-transcript chat)))))
> (load-module! '(pi-chat))
> (in-client (lambda () (chat:show! chat)))
> (testing:wait-until (lambda () (and (= 100 (length (drawn chat))) (equal? (list-ref (drawn chat) 99) '(reply (stop . stop) (md "Reply 49\n"))))))
> (list (length (drawn chat)) (list-ref (drawn chat) 98) (list-ref (drawn chat) 99))
(100 (user-message (md "Ask 49\n")) (reply (stop . stop) (md "Reply 49\n")))
> (cddr (caddr (list-ref (part-datums chat 'chat:transcript) 99)))
((markdown:paragraph ((key 0 . 0)) "Reply " (markdown:strong () "49") "\n"))
; With no chat in a buffer's project, C-c a r asks to start one.
> (in-client (lambda () (layout:switch-to-buffer (buffers:make "notes" "a line\n"))))
> (in-client (lambda () (views:set-point! (view) 1) (views:set-mark! (view) 3)))
> (define t (start! (lambda () (in-client (lambda () (commands:run chat:add-region))))))
> (press! "y")
> (result t)
> (list (length (pi:chats)) (pi:chat-directory (cadr (pi:chats))) (shown (cadr (pi:chats))))
