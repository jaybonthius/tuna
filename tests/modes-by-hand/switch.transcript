; build.py visits ~/src/build.py in modes:fundamental, with point at 10
; and a region from 4 to 10 in the view v; a second view w shows it too.
; Two clients show the one layout.
> (disk:folder! "~/src")
> (disk:write-text! "~/src/build.py" "import os\nprint(os.name)\n")
> (define b (files:visit "~/src/build.py"))
> (modes:set-major-mode modes:fundamental b)
> (define v (view))
> (views:set-buffer! v b)
> (views:set-point! v 10)
> (views:set-mark! v 4)
> (define w (layout-split:split-view! v (layout-split:direction row)))
> (views:set-buffer! w b)
> (layout:select! v)
> (define (ask-major! . prefix)
    (let ([t (apply start! (append prefix (list "M-x")))])
      (type! "modes:switch-major-mode")
      (press! "RET")
      (sleep-for 0.05)
      t))
> (define (answer! text) (type! text) (press! "RET"))
