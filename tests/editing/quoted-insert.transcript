; C-q inserts the next key's character, whatever the key is bound to.
; The read pauses C-q's task, so C-q is pressed in a task of its own and
; the next key from the REPL's.
> (define (quote! . keys)
    (spawn-task (lambda (restore) (apply press! keys)))
    (timers:sleep 0.02))
> (define (settle) (timers:sleep 0.02))
> (start! "ab" 2)
("ab" ((2 #f)))
> (quote! "C-q")
> (keys:reading client)
"C-q"
> (press! "TAB")
> (settle)
> (list (state) (keys:reading client))
(("a\tb" ((3 #f))) #f)
; A quit key is read as data: C-q C-g inserts U+0007 and quits nothing.
> (quote! "C-q")
> (press! "C-g")
> (settle)
> (state)
("a\t\ab" ((4 #f)))
; Each key's character: itself, the five named keys, and C- with a
; letter or one of @ [ \ ] ^ _ SPC ?.
> (define (inserted key)
    (start! "" 1)
    (quote! "C-q")
    (press! key)
    (settle)
    (text))
> (map inserted '("x" "é" "SPC" "TAB" "RET" "ESC" "DEL" "C-a" "C-A" "C-z" "C-@" "C-SPC" "C-[" "C-\\" "C-]" "C-^" "C-_" "C-?"))
("x" "é" " " "\t" "\r" "\x1B;" "\x7F;" "\x1;" "\x1;" "\x1A;" "\x0;" "\x0;" "\x1B;" "\x1C;" "\x1D;" "\x1E;" "\x1F;" "\x7F;")
; Any other key raises and inserts nothing.
> (start! "ab" 2)
("ab" ((2 #f)))
