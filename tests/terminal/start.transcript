; A terminal runs a program on a pseudo-terminal and shows its screen in
; a buffer named after the program.
> (define t (terminal:start '("sh" "-c" "echo hello; echo world; read x; echo got $x; read y")))
> (wait-for t "world")
> (screen-lines t)
("hello" "world")
> (list (terminal:terminal? t) (terminal:terminal? (buffers:make "plain" "")) (buffers:name t))
(#t #f "*sh*")
> (modes:major-mode t)
terminal:mode
; Its process is a user process with a terminal of 80 columns and 24
; rows, since no client's input started it, and it is the buffer's.
> (define p (terminal:process t))
> (list (processes:owner p) (eq? (processes:buffer p) t))
(#f #t)
> (terminal:send! t "it\r")
> (wait-for t "got it")
> (screen-lines t)
("hello" "world" "it" "got it")
; The screen holds one line per row; a row holds its cells up to the last
; with text, and the cursor's row up to the cursor.
> (lines (text t))
("hello" "world" "it" "got it" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "")
; When the program ends, its buffer is killed.
> (terminal:send! t "\r")
> (wait-until (lambda () (not (buffers:live? t))))
> (list (buffers:live? t) (processes:status p))
(#f 0)
; A second terminal of a name in use gets <2>; options give the folder
; and environment.
> (define a (terminal:start '("sh" "-c" "pwd; echo $GREETING; sleep 30") (processes:options [directory "/tmp"] [environment '(("GREETING" . "hi"))])))
> (define b (terminal:start '("sh" "-c" "sleep 30")))
> (map buffers:name (list a b))
("*sh*" "*sh*<2>")
> (wait-for a "hi")
> (screen-lines a)
("/tmp" "hi")
> (list (terminal:directory a) (terminal:title a))
("/tmp" "")
; New programs get the plugin's terminal type and its compiled entry.
> (define c (terminal:start '("sh" "-c" "echo $TERM $COLORTERM $TERM_PROGRAM; infocmp -x | grep -c Ms=; sleep 30")))
> (wait-for c "\n1")
> (screen-lines c)
("xterm-ghostty truecolor tuna" "1")
; With kill-buffer-on-exit? off the buffer stays, the exited hook gets the
; status, and a key warns.
> (set-option! terminal:kill-buffer-on-exit? #f)
> (define statuses '())
> (add-hook! terminal:exited (lambda (t status) (set! statuses (cons (list (buffers:name t) status) statuses))))
> (define d (terminal:start '("sh" "-c" "echo bye; exit 3")))
> (wait-until (lambda () (pair? statuses)))
> (list statuses (buffers:live? d) (screen-lines d))
((("*sh*<4>" 3)) #t ("bye"))
> (in-client (lambda () (layout:switch-to-buffer d)))
> (press! "x")
! the program has ended
> (terminal:send! d "x")
! terminal:send!: the program has ended with irritant #<buffer *sh*<4>>
; Killing a terminal's buffer ends its program.
> (define ap (terminal:process a))
> (buffers:kill! a)
#t
> (wait-until (lambda () (processes:status ap)))
> (processes:status ap)
-1
; The plugin's writes leave no unsaved text, so killing an idle shell
; from a command asks nothing.
> (define e (shell!))
> (set-option! ask:y-or-n-reader (lambda (question) (display question) (newline) #f))
> (buffers:modified? e)
#f
> (commands:define-command (kill-shell) "Kills the shell's terminal." (buffers:kill! e))
> (in-client (lambda () (commands:run kill-shell)))
#t
> (buffers:live? e)
#f
