; At exit, a paused task's after-thunk raises inside a guard: the raise is
; reported, the handler does not run, so it starts no work, and the exit
; goes on without asking, since it is already under way.
> (import (commands))
> (commands:define-command (leave) "Exits." (exit))
> (keys:bind! keys:global "C-x C-c" leave)
> (define exiting? #f)
> (define paused
    (spawn-task (lambda (restore) (guard (c [#t (display "handler ran") (newline) (spawn-task (lambda (restore) (display "new work") (newline)))])
          (dynamic-wind
            void
            (lambda () (suspend (lambda (resume) (void))))
            (lambda () (when exiting? (car '()))))))))
> (set! exiting? #t)
> (press! "C-x")
> (press! "C-c")
! car: () is not a pair
configuration unloading
> (display "never runs")
