; With views:point-after-insertion? set locally in a buffer, a view's
; point where text is inserted stays after the text, and the view
; follows it, as after a command that moved point; a point elsewhere
; stays where it was.
> (define out (buffers:make "out" (lines 3)))
> (buffers:with-buffer out (options:set-local! views:point-after-insertion? #t))
> (define v (views:make out))
> (define w (views:make out))
> (define end (- (document:length (buffers:document out)) 1))
> (views:set-point! v end)
> (list (list-head (placement v desktop) 2) (list-head (placement v desktop) 2) (views:point w))
((new follow) (same follow) 1)
> (buffers:insert! out end "line 4\n")
29
> (list (= (views:point v) (+ end 7)) (views:point w) (list-head (placement v desktop) 2))
(#t 1 (same follow))
; A rewritten last line, replaced from its start, keeps the point after it.
> (buffers:replace! out end (+ end 7) "line 4, again\n")
#<edit 2>
> (= (views:point v) (- (document:length (buffers:document out)) 1))
#t
; Without the option the point stays before inserted text, and the view
; does not move.
> (define plain (buffers:make "plain" (lines 3)))
> (define u (views:make plain))
> (views:set-point! u end)
> (list (list-head (placement u desktop) 2) (list-head (placement u desktop) 2))
((new follow) (same follow))
> (buffers:insert! plain end "line 4\n")
29
> (list (= (views:point u) end) (list-head (placement u desktop) 2))
(#t (same follow))
; A view the hand placed follows point again when text goes in at point,
; with the option; without it, it stays where the hand left it.
> (report! desktop v 2 0 #t)
> (report! desktop u 2 0 #t)
> (list (list-head (placement v desktop) 2) (list-head (placement u desktop) 2))
((same position) (same position))
> (buffers:insert! out (views:point v) "line 6\n")
43
> (buffers:insert! plain (views:point u) "line 5\n")
29
> (list (list-head (placement v desktop) 2) (list-head (placement u desktop) 2))
((new follow) (same position))
