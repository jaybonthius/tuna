> (define desktop (web:add-client! 1))
> (define phone (web:add-client! 2))
> (define notes (buffers:make "notes" "one\n"))
> (define v1 (views:make notes))
> (define v2 (views:make notes))
> (define v3 (views:make notes))
> (set-parts! (layout-split:container '((direction . row)) (atom v1) (layout-split:container '((direction . column)) (atom v2) (atom v3))))
> (layout:select! v2)
> (define (text b) (document:text (buffers:document b)))
; C-x w enters the mode too, and the mode is shared: the phone's keys
; move the part the desktop entered with.
> (press! desktop '("x" "control") '("w"))
> (type! phone "i")
> (list (layout:part-mode?) (part))
(#t (4 5))
; A key the mode does not bind leaves it and runs as it would outside
; it, in the selected view, so typing edits the view's buffer and never
; the layout.
> (type! phone "z")
> (list (layout:part-mode?) (text notes))
(#f "zone\n")
> (shape (main))
(3 (4 5))
; A key sequence leaves at the first key the mode does not continue, so
; C-x 3 splits the selected view.
> (press! desktop '("x" "control") '("w") '("x" "control") '("3"))
> (list (layout:part-mode?) (shape (main)))
(#f (3 ((4 6) 5)))
; Window changes have no undo: C-/ leaves the mode and undoes the
; selected view's buffer.
> (press! desktop '("x" "control") '("w"))
> (press! desktop '("/" "control"))
> (list (layout:part-mode?) (shape (main)) (text notes))
(#f (3 ((4 6) 5)) "one\n")
; C-g leaves the mode.
> (press! desktop '("x" "control") '("w") '("g" "control"))
> (layout:part-mode?)
#f
; So does a click, which reaches keys without the layout's key handler.
> (press! desktop '("x" "control") '("w"))
> (layout:call-with-frame (layout:frame desktop)
    (lambda () (keys:press! desktop (list "<mouse-1>" (vector (views:id v1) 0)))))
> (list (layout:part-mode?) (selected))
(#f 3)
; The selected part is outlined on every client while the mode is on.
> (press! desktop '("x" "control") '("w") '("i"))
> (define (outlined client)
    (let* ([html (screen-of client)] [i (search html "part-selected")])
      (and i (substring html (- i 22) (+ i 13)))))
> (list (outlined desktop) (outlined phone))
("<div class=\"split row part-selected" "<div class=\"split row part-selected")
> (type! desktop "k")
> (outlined desktop)
"\"layout-view selected part-selected"
> (type! desktop "Enter")
> (outlined phone)
#f
; While the mode is on, the selected view's level is outlined too, so the
; user sees how far the commands that act in it reach: here the root,
; the whole screen.
> (press! desktop '("x" "control") '("w"))
> (define (level-outlined client)
    (let* ([html (screen-of client)] [i (search html "part-level")])
      (and i (substring html i (+ i 40)))))
> (level-outlined desktop)
"part-level focus-path\"><div class=\"split"
> (set-parts! (layout-split:container '((direction . row)) (atom v1) (layout:level '() (layout-split:container '((direction . column)) (atom v2) (atom v3)))))
> (layout:select! v3)
> (level-outlined desktop)
"part-level focus-path\"><div class=\"split"
> (type! desktop "Enter")
> (level-outlined desktop)
#f
