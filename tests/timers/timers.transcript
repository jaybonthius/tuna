; A timer task that raises is reported, and the next runs.
> (define ticks 0)
> (begin
    (run-with-timer 0.05 (lambda () (error 'timer "failed")))
    (run-with-timer 0.1 (lambda () (set! ticks 1)))
    (sleep-for 0.2))
! timer: failed
