; The prompt is isolating: it keeps the line break the text sent is read
; up to, and behaves the same with widgets around it or none, but for
; the buffer's edges. Each case sets the prompt, puts point in it, and
; gives the text sent and point's place in it.
> (define edges (pi:start (getenv "HOME")))
> (define ef (fake-of edges))
> (testing:wait-until (lambda () (eq? (pi:chat-activity edges) 'idle)))
> (in-client (lambda () (chat:show! edges)))
> (define (node-of chat kind)
    (let* ([doc (buffers:document (chat:buffer chat))] [n (document:length doc)])
      (let loop ([p 0])
        (and (< p n)
             (let ([t (document:token doc p)])
               (if (and (document:node? t) (eq? (document:node-kind t) kind)) t (loop (+ p 1))))))))
> (define (sent) (document:text (buffers:document (chat:buffer edges)) (chat:prompt-start edges) (chat:prompt-end edges)))
> (define (on-prompt offset . keys)
    (in-client (lambda () (chat:set-prompt! edges "hi there") (views:set-point! (view) (+ (chat:prompt-start edges) offset))))
    (apply press! keys)
    (list (sent) (- (views:point (view)) (chat:prompt-start edges))))
