"<span class=\"region\">a <span class=\"node\" data-at=\"4\" data-to=\"5\" data-region><img src=\"a.png\"></span> b</span><span class=\"cursor primary\"></span>"
; The region's span holds the spans of every layer. One of a layer above
; priority 0 that the region reaches is marked as above it, so it keeps
; its background, as a search match shows over Emacs's region.
> (buffers:define-layer matches (priority 1000))
> (buffers:define-layer faces (priority -10))
> (define found (buffers:make "found" "find the needle here\n"))
> (buffers:add-span! (buffers:layer found matches) 10 16 '((face . match)))
> (buffers:add-span! (buffers:layer found faces) 1 5 '((face . keyword)))
> (define fv (views:make found))
> (begin (views:set-mark! fv 3) (views:set-point! fv 20))
> (line-of fv 1)
"<span data-face=\"keyword\">fi</span><span class=\"region\"><span data-face=\"keyword\">nd</span> the <span class=\"above-region\" data-face=\"match\">needle</span> her</span><span class=\"cursor primary\"></span>e"
; Only a span the region reaches is marked.
> (begin (views:set-mark! fv 1) (views:set-point! fv 6))
> (line-of fv 1)
"<span class=\"region\"><span data-face=\"keyword\">find</span> </span><span class=\"cursor primary\"></span>the <span data-face=\"match\">needle</span> here"
; views:region-ranges gives the ranges a cursor's region draws. Advised
; to give each line its piece between point's and mark's columns, the
; region is a rectangle, and holds no line through its newline.
> (define (rectangle region-ranges view cursor)
    (let ([p (views:cursor-point cursor)] [m (views:cursor-mark cursor)]
          [doc (buffers:document (views:buffer view))] [chars (document:unit characters)])
      (define (offset q) (document:offset doc q chars))
      (define (line-offset line) (offset (document:line-start doc line)))
      (define (column q) (- (offset q) (line-offset (document:line doc q))))
      (if m
          (let* ([from (min (column p) (column m))] [to (max (column p) (column m))]
                 [end (- (document:length doc) 1)] [last (document:line doc end)])
            (define (line-end line) (if (< line last) (- (line-offset (+ line 1)) 1) (offset end)))
            (let loop ([line (document:line doc (max p m))] [acc '()])
              (if (< line (document:line doc (min p m)))
                  acc
                  (let ([start (line-offset line)])
                    (loop (- line 1)
                          (cons (cons (document:position doc (min (+ start from) (line-end line)) chars)
                                      (document:position doc (min (+ start to) (line-end line)) chars))
                                acc))))))
          (region-ranges view cursor))))
> (advice-add! views:region-ranges rectangle)
