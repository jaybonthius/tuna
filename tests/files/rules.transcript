> (document:datums (buffers:document latin))
((buffers:text () "caf" #(document:raw-byte ((byte . 233))) "\n" #(document:raw-byte ((byte . 255))) #(document:raw-byte ((byte . 254))) "\n"))
> (buffers:replace! latin 1 1 "Le ")
#<edit 1>
> (files:save-buffer latin)
