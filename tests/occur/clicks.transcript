; A mouse-1 click on a listed line's text follows it: the press moves
; *Occur*'s point to the click, then the source is shown and selected at
; the line's first match.
> (define b (src "one foo\ntwo\nfoo three foo\nfour\n"))
> (occur! (search:make-query "foo" search:regexp) 1 #f)
> (define ov (occur-view))
> (define at (+ 2 (find-text (occur-buffer) "foo three")))
> (click! ov 1 at)
> (list (wins) (views:point ov))
((("src" 13 #t) ("*Occur*" 68 #f)) 68)
; A click at the start of another listed line follows it too.
> (layout:select! ov)
> (click! ov 1 (find-text (occur-buffer) "one foo"))
> (wins)
(("src" 5 #t) ("*Occur*" 50 #f))
; mouse-2 follows and leaves *Occur*'s point where it was.
> (layout:select! ov)
> (views:set-point! ov 2)
> (click! ov 2 at)
> (list (wins) (views:point ov))
((("src" 13 #t) ("*Occur*" 2 #f)) 2)
; mouse-2 with the source's view selected follows in that view, as from
; *Occur*'s, and *Occur* keeps its view.
> (define sv (find (lambda (v) (eq? (views:buffer v) b)) (layout:views)))
> (views:set-point! sv 1)
> (layout:select! sv)
> (click! ov 2 at)
> (list (wins) (eq? (view) sv))
((("src" 13 #t) ("*Occur*" 2 #f)) #t)
; With one view, a click splits a view for the source.
> (layout:select! ov)
> (only!)
> (click! ov 1 at)
> (wins)
(("*Occur*" 68 #f) ("src" 13 #t))
; A click on a context line or the heading only sets point.
> (layout:select! ov)
> (only!)
> (click! ov 1 (find-text (occur-buffer) "two"))
> (list (wins) (views:point ov))
((("*Occur*" 60 #t)) 60)
> (click! ov 1 3)
> (wins)
(("*Occur*" 3 #t))
; A drag over a listed line selects; it follows nothing.
> (mouse! ov 1 "down" at)
> (mouse! ov 1 "drag" (+ at 5))
> (list (wins) (views:mark ov))
((("*Occur*" 73 #t)) 68)
