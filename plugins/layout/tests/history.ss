(import (tuna) (test) (test-user) (layout) (layout-split) (layout-tabs) (views) (buffers) (commands) (options)
        (layout-test parts))

(define atom layout-test/parts:atom)
(define name-of layout-test/parts:name-of)
(define named layout-test/parts:named)
(define outline layout-test/parts:outline)

(define (back!) (test-user:press! "C-c <left>"))
(define (forward!) (test-user:press! "C-c <right>"))

(define (refused thunk) (layout-test/parts:refusals-during thunk))

(define no-back '((layout:history-back "no more back history in this level")))
(define no-forward '((layout:history-forward "no more forward history in this level")))

(define notes #f)
(define pi #f)
(define echo #f)
(define explorer #f)

(define (start!)
  (set! notes (views:make (named "notes.org")))
  (set! pi (views:make (named "*pi*")))
  (layout-test/parts:set-parts! (layout-split:container '((direction . row)) (atom notes) (atom pi)))
  (layout:select! notes)
  (set! echo (layout-test/parts:place-echo! (named " *Echo Area*")))
  (set! explorer ((layout-split:display-at-side (layout:direction left) 50 '(columns 30)) (named "*explorer*"))))

(define (user-level-with part)
  (list 'layout:level (list 'layout-split:container (list 'layout-split:container "*explorer*" (list 'layout:level part)) " *Echo Area*")))

(test "C-c <left> steps back over each command that changed the level, C-c <right> forward, and each says when it has no more"
  (start!)
  (test-user:press! "C-x 2")
  (test-user:press! "C-x 3")
  (check-equal? (user-level-with '(layout-split:container (layout-split:container (layout-split:container "notes.org" "notes.org") "notes.org") "*pi*"))
                (outline))
  (back!)
  (check-equal? (user-level-with '(layout-split:container (layout-split:container "notes.org" "notes.org") "*pi*")) (outline))
  (back!)
  (check-equal? (user-level-with '(layout-split:container "notes.org" "*pi*")) (outline))
  (check-equal? no-back (refused back!))
  (forward!)
  (check-equal? (user-level-with '(layout-split:container (layout-split:container "notes.org" "notes.org") "*pi*")) (outline))
  (forward!)
  (check-equal? (user-level-with '(layout-split:container (layout-split:container (layout-split:container "notes.org" "notes.org") "notes.org") "*pi*"))
                (outline))
  (check-equal? no-forward (refused forward!))
  (check-raises (layout-test/parts:raised-with 'layout:history-forward "no more forward history in this level")
                (layout:history-forward)))

(test "a step restores only the level's interior: parts placed or removed outside it between steps stay as they are"
  (start!)
  (test-user:press! "C-x 2")
  (test-user:press! "C-x 3")
  (back!)
  (layout:delete-part! (layout:view-node explorer))
  (back!)
  (check-equal? '(layout:level (layout-split:container (layout:level (layout-split:container "notes.org" "*pi*")) " *Echo Area*"))
                (outline))
  (let ([side ((layout-split:display-at-side (layout:direction right) 60 '(columns 24)) (named "*outline*"))])
    (forward!)
    (check-equal? '(layout:level
                    (layout-split:container
                      (layout-split:container (layout:level (layout-split:container (layout-split:container "notes.org" "notes.org") "*pi*"))
                        "*outline*")
                      " *Echo Area*"))
                  (outline))
    (layout:select! side)
    (check-equal? no-back (refused back!))))

(test "a command repeated in sequence is one step, and another command between two of the same ends their sequence"
  (start!)
  (test-user:press! "C-x 2")
  (let* ([weights (lambda () (map layout-test/parts:attributes-of (layout:views)))] [before (weights)])
    (commands:run layout-split:enlarge 1)
    (commands:run layout-split:enlarge 1)
    (commands:run layout-split:enlarge 1)
    (check (not (equal? before (weights))))
    (back!)
    (check-equal? before (weights)))
  (let ([b1 (views:make (named "one"))] [b2 (views:make (named "two"))])
    (layout-test/parts:set-parts! (layout-split:container '((direction . row)) (atom b1) (atom b2)))
    (layout:select! b1)
    (test-user:press! "C-x 2")
    (test-user:press! "C-x o")
    (test-user:press! "C-x 2")
    (check-equal? '(layout:level (layout-split:container (layout-split:container "one" "one" "one") "two")) (outline))
    (back!)
    (check-equal? '(layout:level (layout-split:container (layout-split:container "one" "one") "two")) (outline))
    (back!)
    (check-equal? '(layout:level (layout-split:container "one" "two")) (outline))))

(commands:define-command (show-mail) "Shows mail in the selected view." (layout:switch-to-buffer (named "mail")))

(test "a buffer shown in a view is part of the level's interior, and each view gets back its point; moving a point alone is no step"
  (start!)
  (commands:run show-mail)
  (check-equal? '("*explorer*" "mail" "*pi*" " *Echo Area*") (layout-test/parts:names))
  (back!)
  (check-equal? '("*explorer*" "notes.org" "*pi*" " *Echo Area*") (layout-test/parts:names))
  (views:set-point! notes 5)
  (test-user:press! "C-x 3")
  (views:set-point! notes 1)
  (back!)
  (check-equal? 5 (views:point notes)))

(test "a view the restored interior names that has since left the level gets a new view of its buffer"
  (start!)
  (layout:select! pi)
  (test-user:press! "s-' I RET")
  (check-equal? '(layout:level
                  (layout-split:container (layout-split:container "*explorer*" (layout:level "notes.org") "*pi*") " *Echo Area*"))
                (outline))
  (layout:select! notes)
  (back!)
  (check-equal? '(layout:level
                  (layout-split:container
                    (layout-split:container "*explorer*" (layout:level (layout-split:container "notes.org" "*pi*")) "*pi*")
                    " *Echo Area*"))
                (outline))
  (check (layout:view-node pi))
  (check-equal? 2 (length (filter (lambda (v) (eq? (views:buffer v) (views:buffer pi))) (layout:views)))))

(test "nested levels keep histories of their own, and a step in the outer level restores the inner one as it was"
  (let ([w (views:make (named "work"))] [o (views:make (named "*side*"))] [p (views:make (named "*pi*"))])
    (layout-test/parts:set-parts!
      (layout-split:container '((direction . column))
        (layout:level '()
          (layout-tabs:container '()
            (atom w '(title . "work"))
            (layout-split:container '((direction . row) (title . "chat")) (atom o) (layout:level '() (atom p)))))
        (atom (views:make (named " *Echo Area*")) '(depth . 90) '(size . content) '(locked . #t))))
    (layout:select! p)
    (test-user:press! "C-x 3")
    (layout:select! o)
    (test-user:press! "C-x 2")
    (let ([level-with (lambda (chat) (list 'layout:level (list 'layout-split:container (list 'layout:level (list 'layout-tabs:container "work" chat)) " *Echo Area*")))])
      (check-equal? (level-with '(layout-split:container (layout-split:container "*side*" "*side*") (layout:level (layout-split:container "*pi*" "*pi*"))))
                    (outline))
      (layout:select! p)
      (back!)
      (check-equal? (level-with '(layout-split:container (layout-split:container "*side*" "*side*") (layout:level "*pi*"))) (outline))
      (layout:select! o)
      (back!)
      (check-equal? (level-with '(layout-split:container "*side*" (layout:level (layout-split:container "*pi*" "*pi*")))) (outline)))))

(test "the root's history becomes the user's level's when a plugin's part first wraps the user's windows in a level"
  (let ([a1 (views:make (named "one"))])
    (layout-test/parts:set-parts! (atom a1))
    (layout:select! a1)
    (test-user:press! "C-x 3")
    (check-equal? '(layout:level (layout-split:container "one" "one")) (outline))
    ((layout-split:display-at-side (layout:direction down) 90 'content '((locked . #t))) (named "*bottom*"))
    (check-equal? '(layout:level (layout-split:container (layout:level (layout-split:container "one" "one")) "*bottom*")) (outline))
    (layout:select! a1)
    (back!)
    (check-equal? '(layout:level (layout-split:container (layout:level "one") "*bottom*")) (outline))))

(test "history-limit caps the steps back, and 0 keeps none"
  (let ([a1 (views:make (named "one"))])
    (layout-test/parts:set-parts! (atom a1))
    (layout:select! a1)
    (options:set! layout:history-limit 2)
    (test-user:press! "C-x 2")
    (test-user:press! "C-x 3")
    (test-user:press! "C-x 0")
    (back!)
    (back!)
    (check-equal? no-back (refused back!))
    (check-equal? '(layout:level (layout-split:container "one" "one")) (outline))
    (options:set! layout:history-limit 0)
    (test-user:press! "C-x 2")
    (check-equal? no-back (refused back!))
    (check-raises (layout-test/parts:raised-with 'layout:history-back "no more back history in this level") (layout:history-back))
    (options:set! layout:history-limit 50)
    (check-equal? 50 (layout:history-limit))
    (options:unset! layout:history-limit)))

(test "a view whose recorded buffer is no longer live keeps the buffer it shows, at its point"
  (let* ([gone (named "gone")] [g (views:make gone)] [b2 (views:make (named "two"))])
    (layout-test/parts:set-parts! (layout-split:container '((direction . row)) (atom g) (atom b2)))
    (layout:select! g)
    (views:set-point! g 3)
    (test-user:press! "C-x 3")
    (buffers:kill! gone)
    (let ([after (list (name-of g) (views:point g))])
      (layout:select! g)
      (back!)
      (check-equal? (list 'layout:level (list 'layout-split:container (car after) "two")) (outline))
      (check-equal? after (list (name-of g) (views:point g))))))

(test "a step the layout refuses raises the edit's error, changes nothing, and keeps its state to go back to"
  (let ([d1 (views:make (named "one"))] [d2 (views:make (named "two"))])
    (layout-test/parts:set-parts! (layout-split:container '((direction . row)) (atom d1) (atom d2)))
    (layout:select! d1)
    (test-user:press! "C-x t 2")
    (test-user:press! "C-x 2")
    (check-equal? '(layout:level (layout-split:container (layout-tabs:container "one" (layout-split:container "one" "one")) "two"))
                  (outline))
    (layout-test/parts:set-parts! (layout-split:container '((direction . row)) (atom d1) (atom d2)))
    (layout:select! d1)
    (test-user:press! "C-x 3")
    (unload-owner! (module-owner '(layout-tabs)))
    (back!)
    (check-equal? '(layout:level (layout-split:container "one" "two")) (outline))
    (check-equal? '((buffers:replace! "the node refuses the edit")) (refused back!))
    (check-equal? '(layout:level (layout-split:container "one" "two")) (outline))
    (forward!)
    (check-equal? '(layout:level (layout-split:container "one" "one" "two")) (outline))))
