; A strip's size has layout-split's domain: a fraction, columns along a
; row strip or lines along a column strip, or its content's length; a
; length across the strip is the default size.
> (define (strip-sizes html)
    (let loop ([i 0] [acc '()])
      (cond
        [(> (+ i 21) (string-length html)) (reverse acc)]
        [(string=? (substring html i (+ i 21)) "--layout-scroll-size:")
         (let end ([j (+ i 21)])
           (if (char=? (string-ref html j) #\") (loop j (cons (substring html (+ i 21) j) acc)) (end (+ j 1))))]
        [else (loop (+ i 1) acc)])))
> (define vk (views:make a))
> (set-parts! (layout-scroll:container '() (atom va '(size columns 40)) (atom vg '(size lines 5)) (atom vh '(size . content)) (atom vk '(size . 1/4))))
