> (views:set-buffer! (view) notes)
> (click-at! (view) 5)
> (list (views:point (view)) (echo-area:current-message))
; A message of "" clears it at once and logs nothing.
> (echo-area:message! "")
> (list (echo-area:current-message) (echo-area-element))
; Each message is logged; an equal one counts on the last line, and a
; message of several lines takes several lines.
> (echo-area:message! "Saved")
