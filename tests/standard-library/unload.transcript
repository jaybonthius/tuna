; Unloading a module removes the local hook entries of its procedures in
; every scope. The configuration imports these modules, so its re-read
; loads a new instance at once; what other owners set in the module's
; options and tables is kept by name, so the new instance has it.
> (define s1 (scopes:make))
> (define s2 (scopes:make))
> (scopes:current s1)
> (prog:mode)
> (scopes:current s2)
> (prog:mode)
> (files:save! "x")
[indenting]
"x"
> (fill:column)
100
> (define old-prog (module-owner '(prog)))
> (unload-owner! old-prog)
> (files:save! "x")
"x"
> (scopes:current s1)
> (files:save! "x")
"x"
> (list (owner-live? old-prog) (eq? old-prog (module-owner '(prog))))
(#f #f)
> (scopes:current #f)
> (options:set! fill:column 81)
> (define old-fill (module-owner '(fill)))
> (unload-owner! old-fill)
> (list (owner-live? old-fill) (fill:column) (options:settings fill:column))
(#f 81 (((repl) 81) ((init) 80) ((prog) 90)))
> (tables:set! files:modes "rkt" 'racket)
> (define old-files (module-owner '(files)))
> (unload-owner! old-files)
> (list (owner-live? old-files) (eq? old-files (module-owner '(files))) (tables:ref files:modes "rkt" #f))
(#f #f racket)
