; Each key runs its command in the task it is pressed in.
> (define tasks '())
> (commands:define-command (note-task) "Notes its task." (set! tasks (cons (current-task) tasks)))
> (keys:bind! keys:global "C-c t" note-task)
> (define pressing (spawn-task (lambda () (press-all! one "C-c" "t") (current-task))))
> (eq? (join-task pressing) (car tasks))
#t
