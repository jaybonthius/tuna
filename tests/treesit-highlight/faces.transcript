; Each range gets one face: the capture of the later pattern, unless an
; earlier one has a higher priority.
> (queried "x = 1\n" "(identifier) @a\n(identifier) @b\n")
(("x" b))
> (queried "x = 1\n" "((identifier) @a (#set! priority 101))\n(identifier) @b\n")
(("x" a))
; Captures named with _, and spell, nospell, conceal and noconceal,
; colour nothing and win nothing.
> (queried "x = 1\n" "(identifier) @a\n(identifier) @_private\n(identifier) @spell\n(identifier) @nospell\n(identifier) @conceal\n(identifier) @noconceal\n")
(("x" a))
; Faces nest across ranges, the smallest range's first.
> (queried "x = 'a\\nb'\n" "(string) @string\n(escape_sequence) @string.escape\n")
(("'a" string) ("\\n" (string.escape string)) ("b'" string))
; @none takes the faces of larger ranges off its own: here an
; f-string's code, while the number in it keeps its face.
> (queried "f\"v={a + 1}\"\n" "(string) @string\n(interpolation) @none\n(integer) @number\n")
(("f\"v=" string) ("1" number) ("\"" string))
> (faces "x = f\"v={a + 1}\"\n" shipped default-excluded)
(("x" variable.definition) ("\"v=" string) ("{" punctuation.special) ("1" number) ("}" punctuation.special) ("\"" string))
; A range whose winning capture is excluded gets no face of its own; a
; larger range's shows through, and the capture it beat does not.
> (queried "x = 'a'\n" "(string) @string\n(string_content) @x\n(string_content) @y\n" '(y))
(("'a'" string))
> (queried "x = 'a'\n" "(string) @string\n(string_content) @x\n(string_content) @y\n" '(x))
(("'" string) ("a" (y string)) ("'" string))
; Excluded names are exact: variable leaves variable.definition coloured.
> (queried "x = y\n" "(identifier) @variable\n(assignment left: (identifier) @variable.definition)\n" '(variable))
(("x" variable.definition))
; Spans count characters, though tree-sitter counts bytes: two-, three-
; and four-byte characters.
> (faces "s = 'é日😀' # 😀\nn = 1\n" shipped default-excluded)
(("s" variable.definition) ("'é日😀'" string) ("# 😀" comment) ("n" variable.definition) ("1" number))
; An atom is one character, U+FFFC, of three bytes; drawn ranges are
; positions of the document, which a node's opening shifts from the
; text's characters.
> (define doc (document:from-datum '(code () "x = 'a" #(pic ()) "é'\n" "y = 1\n" "z = 2\n")))
> (define h (make-highlight))
> (define (piece drawn) (let-values ([(layers data more) (h doc (list grammar "python" (untimed shipped) default-excluded drawn) '())]) (car layers)))
> (document:text doc)
"x = 'a￼é'\ny = 1\nz = 2\n"
> (define y (+ 1 (offset-of (document:text doc) "y")))
; The first call loads the grammar, compiles the query and parses, and
; answers nothing, so the ranges drawn meanwhile are coloured first.
> (piece '())
(0 0 #())
> (piece (list (cons y (+ y 6))))
(10 16 #((10 11 ((face . variable.definition))) (14 15 ((face . number)))))
> (piece '())
(0 10 #((0 1 ((face . variable.definition))) (4 9 ((face . string)))))
> (piece '())
(16 22 #((16 17 ((face . variable.definition))) (20 21 ((face . number)))))
; The ancestor and parent predicates read one walk of the queried range,
; never tree-sitter's parent of a node, which descends from the root.
> (let ([form (call-with-input-file (string-append library "/treesit/src/treesit/highlight.sls") read)])
    (assoc 'import (cdddr form)))
(import (chezscheme) (document) (except (tree-sitter) node-parent))
