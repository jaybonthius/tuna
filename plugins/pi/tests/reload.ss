(import (tuna) (test) (test-runner) (pi) (test-pi) (pi-test))

(define chat (pi-test:started (getenv "HOME")))

(define f (pi-test:fake chat))

(define process (pi:chat-process chat))

(define old-request #f)

(test "pi keeps what Pi says only once, and a reload follows Pi again from it, the reply being written and Pi's process kept"
  (test-pi:run-turn! f "u1" "a1" "Hi" '("Hello"))
  (test-runner:wait-until (lambda () (equal? '("u1" "a1") (map pi:item-entry-id (pi:chat-transcript chat)))))
  (test-pi:say! f (test-pi:ui-request "d1" "select" '("title" . "Allow?") '("options" . #("Yes" "No")))
                (test-pi:ui-request "d2" "input" '("title" . "Name"))
                (test-pi:ui-request "s1" "setStatus" '("statusKey" . "pool") '("statusText" . "1 pool(s)"))
                (test-pi:ui-request "w1" "setWidget" '("widgetKey" . "plan") '("widgetLines" . #("Step 1")))
                (test-pi:event "queue_update" '("steering" . #("steer me")) '("followUp" . #()))
                (test-pi:ui-request "n1" "notify" '("message" . "Once"))
                (test-pi:ui-request "e1" "set_editor_text" '("text" . "typed by an extension")))
  (test-runner:wait-until (lambda () (= 2 (length (pi:chat-dialogs chat)))))
  (pi:answer! chat (cadr (pi:chat-dialogs chat)) "Harpo")
  (test-pi:say! f (test-pi:event "agent_start") (test-pi:event "message_start" (cons "message" (test-pi:assistant-message "pending")))
                (test-pi:update '(("type" . "text_start") ("contentIndex" . 0)))
                (test-pi:update '(("type" . "text_delta") ("contentIndex" . 0) ("delta" . "Work"))))
  (test-pi:hold! f "get_last_assistant_text")
  (let ([t (pi-test:in-task (lambda () (pi:last-reply chat)))])
    (set! old-request (test-pi:take-held! f "get_last_assistant_text"))
    (test-runner:wait-until (lambda () (= 4 (length (pi:chat-transcript chat)))))
    (check-equal? '(("typed by an extension") 1)
      (list (pi-test:editor-texts) (length (filter pi:notice? (pi:chat-transcript chat)))))
    (reload-modules! '((pi)))
    (check-equal? '(refused "pi was unloaded") (pi-test:outcome t)))
  (let ([chat (car (pi:chats))])
    (check (eq? process (pi:chat-process chat)))
    (test-runner:wait-until (lambda () (= 2 (length (pi-test:saved-items chat)))))
    (check-equal? '((user 0 "u1" "Hi") (reply 1 "a1" stop ((text "Hello"))) (reply 2 #f pending ((text "Work"))))
                  (pi-test:transcript chat))
    (check-equal? '("Allow?") (map pi:dialog-title (pi:chat-dialogs chat)))
    (check-equal? '((("pool" . "1 pool(s)")) (("plan" above ("Step 1"))) (("steer me") ()))
      (list (pi:chat-statuses chat)
            (map (lambda (w) (list (pi:widget-key w) (pi:widget-placement w) (pi:widget-lines w))) (pi:chat-widgets chat))
            (call-with-values (lambda () (pi:chat-queue chat)) list)))))

(test "after a reload a notify and an editor text act no more, an answer to the earlier load's request is ignored, and the reply goes on"
  (let ([chat (car (pi:chats))])
    (test-pi:respond! f old-request '(("text" . "late")))
    (test-pi:say! f (test-pi:update '(("type" . "text_delta") ("contentIndex" . 0) ("delta" . "ing"))))
    (pi-test:barrier f)
    (check-equal? '((user 0 "u1" "Hi") (reply 1 "a1" stop ((text "Hello"))) (reply 2 #f pending ((text "Working"))))
                  (pi-test:transcript chat))
    (check-equal? '() (pi-test:editor-texts))))

(test "Pi goes on while pi is off, and a question it asks then waits for pi"
  (unload-owner! (module-owner '(pi)))
  (test-pi:say! f (test-pi:ui-request "d3" "confirm" '("title" . "Proceed?")))
  (load-module! '(pi))
  (load-module! '(pi-test))
  (let ([chat (car (pi:chats))])
    (test-runner:wait-until (lambda () (= 2 (length (pi:chat-dialogs chat)))))
    (check-equal? '("Allow?" "Proceed?") (map pi:dialog-title (pi:chat-dialogs chat)))
    (check (eq? process (pi:chat-process chat)))))
