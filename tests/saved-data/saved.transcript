#t
; Setting saved data is not a change, and unloading a module leaves it: a
; procedure held from before still reads and sets it, and the module, loaded
; again, keeps its value.
> (module-changes '(hist))
()
> (define held hist:entries)
> (unload-module! '(hist))
> (held)
("first")
> (set-saved! held '("kept"))
> (load-module! '(hist))
> (list (hist:entries) (eq? held hist:entries))
(("first" "kept") #t)
