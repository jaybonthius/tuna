; A silent edit is not history: undo records none, and carries the
; history past it so each group still undoes the text it changed.
> (define b (buffers:make "prompt" "> \n"))
> (define (run command . args) (buffers:with-buffer b (apply commands:run command args)))
> (run checks:insert 3 "one")
#<edit 1>
> (run checks:insert 6 " two")
#<edit 2>
> (buffers:with-silent-edits b (buffers:replace! b 1 1 "Pi says hi.\n"))
#<edit 3>
> (list (text b) (buffers:edit-silent? (car (reverse (buffers:edits-since b 2)))) (tree b))
("Pi says hi.\n> one two\n" #t (2 0 (0 #f) (1 0) (2 1)))
> (run undo:undo 1)
> (text b)
"Pi says hi.\n> one\n"
> (buffers:with-silent-edits b (buffers:replace! b 18 19 "\n...\n"))
#<edit 5>
> (run undo:undo 1)
> (text b)
"Pi says hi.\n> \n...\n"
> (run undo:redo 2)
> (text b)
"Pi says hi.\n> one two\n...\n"
; A silent edit made after the groups moves none of them.
> (buffers:with-silent-edits b (buffers:replace! b 25 26 "!"))
#<edit 9>
> (run undo:undo 2)
> (text b)
"Pi says hi.\n> \n..!\n"
; Text a silent edit removes takes with it the edits made inside it, and
; a group left with none is gone; the groups before it stay.
> (run undo:redo 2)
> (run checks:insert 1 "[")
#<edit 14>
> (run checks:insert 2 "x")
#<edit 15>
> (text b)
"[xPi says hi.\n> one two\n..!\n"
> (buffers:with-silent-edits b (buffers:replace! b 1 4 ""))
#<edit 16>
> (list (text b) (tree b))
("i says hi.\n> one two\n..!\n" (2 0 (0 #f) (1 0) (2 1)))
> (run undo:undo 1)
> (text b)
"i says hi.\n> one\n..!\n"
; One that removes part of what a group changed stops the history
; there: that group's state is the root.
> (run undo:redo 1)
> (buffers:with-silent-edits b (buffers:replace! b 17 19 ""))
#<edit 19>
> (list (text b) (tree b))
("i says hi.\n> onewo\n..!\n" (2 #f (2 #f)))
> (run undo:undo 1)
! undo:undo: no further undo information
; Branches off the path move too, and one whose edit the silent edit
; cuts into is dropped.
> (define r (buffers:make "branches" "abcd\n"))
> (define (in-r command . args) (buffers:with-buffer r (apply commands:run command args)))
> (in-r checks:insert 5 "X")
#<edit 1>
> (in-r undo:undo 1)
> (in-r checks:delete 2 4)
#<edit 3>
> (in-r undo:undo 1)
> (in-r checks:insert 1 "Z")
#<edit 5>
> (tree r)
(3 0 (0 #f) (1 0) (2 0) (3 0))
> (buffers:with-silent-edits r (buffers:replace! r 3 4 "-"))
#<edit 6>
> (list (text r) (tree r))
("Za-cd\n" (3 0 (0 #f) (1 0) (3 0)))
> (buffers:with-buffer r (undo:go-to! r 1))
> (text r)
"a-cdX\n"
; The cursors undo puts back move with the text.
> (define v (views:make r))
> (views:call-with-view v (lambda () (views:set-point! v 6) (commands:run checks:insert 6 "!")))
#<edit 9>
> (buffers:with-silent-edits r (buffers:replace! r 1 1 "<<"))
#<edit 10>
> (views:call-with-view v (lambda () (views:set-point! v 1) (commands:run undo:undo 1)))
> (list (text r) (views:point v))
("<<a-cdX\n" 8)
; A silent edit leaves the buffer's modified flag as it was: an
; unmodified buffer stays so, and undo still finds the saved state.
> (define m (buffers:make "flag" "x\n"))
> (buffers:with-buffer m (commands:run checks:insert 1 "a"))
#<edit 1>
> (buffers:set-modified! m #f)
> (buffers:with-silent-edits m (buffers:replace! m 3 3 "!"))
#<edit 2>
> (buffers:modified? m)
#f
> (buffers:with-buffer m (commands:run checks:insert 1 "b"))
#<edit 3>
> (buffers:with-silent-edits m (buffers:replace! m 5 5 "?"))
#<edit 4>
> (buffers:modified? m)
#t
> (buffers:with-buffer m (commands:run undo:undo 1))
> (list (text m) (buffers:modified? m))
("ax!?\n" #f)
; A silent buffer never gets a history.
> (define s (buffers:make "log" "\n"))
> (buffers:set-silent! s #t)
> (buffers:replace! s 1 1 "entry\n")
#<edit 1>
> (list (buffers:silent? s) (buffers:modified? s) (buffers:edit-silent? (car (buffers:edits-since s 0))))
(#t #f #t)
; Records already taken name old positions, so the next take is whole.
> (define w (buffers:make "written" "\n"))
> (buffers:with-buffer w (commands:run checks:insert 1 "a"))
#<edit 1>
> (map car (undo:take-records! w))
(undo-history group at)
> (buffers:with-buffer w (commands:run checks:insert 2 "b"))
#<edit 2>
> (map car (undo:take-records! w))
(group)
> (buffers:with-silent-edits w (buffers:replace! w 1 1 "_"))
#<edit 3>
> (map car (undo:take-records! w))
(undo-history group group at)
; A plugin that rewrites part of the buffer silently after each edit, as
; a prompt's list follows its input, leaves undo whole: a group of
; several edits undoes and redoes at once, and stays one group.
> (define e (buffers:make "echoing" "\n[0]\n"))
> (define (echo-length b edit)
    (unless (buffers:edit-silent? edit)
      (let* ([t (text b)] [i (let loop ([i 0]) (if (char=? (string-ref t i) #\[) i (loop (+ i 1))))])
        (buffers:with-silent-edits b
          (buffers:replace! b (+ i 1) (- (document:length (buffers:document b)) 2) (format "[~a]" (- i 1)))))))
> (buffers:with-buffer e (hooks:add-local! buffers:after-edit echo-length))
> (undo:with-edit-group e (buffers:replace! e 1 1 "ab") (buffers:replace! e 3 3 "cd") (buffers:replace! e 5 5 "ef"))
#<edit 5>
> (list (text e) (tree e))
("abcdef\n[6]\n" (1 0 (0 #f) (1 0)))
> (buffers:with-buffer e (commands:run undo:undo 1))
> (list (text e) (tree e))
("\n[0]\n" (0 0 (0 #f) (1 0)))
> (buffers:with-buffer e (commands:run undo:redo 1))
> (list (text e) (tree e) (buffers:modified? e))
("abcdef\n[6]\n" (1 0 (0 #f) (1 0)) #t)
; A group whose body raises is taken back whole past those silent edits.
> (define g (buffers:make "cancelled" "\n[0]\n"))
> (buffers:with-buffer g (hooks:add-local! buffers:after-edit echo-length))
> (raised (lambda () (undo:with-edit-group g (buffers:replace! g 1 1 "ab") (buffers:replace! g 3 3 "cd") (error 'body "stops"))))
(body "stops")
> (list (text g) (tree g) (buffers:modified? g))
("\n[0]\n" (0 0 (0 #f)) #f)
; A nested body takes back its own edits when a silent edit took an edit
; made before its hold.
> (define n (buffers:make "nested" "\n"))
> (undo:with-edit-group n
    (buffers:replace! n 1 1 "ab")
    (list (raised (lambda ()
                    (undo:with-edit-group n
                      (buffers:replace! n 3 3 "cd")
                      (buffers:with-silent-edits n (buffers:replace! n 1 3 ""))
                      (error 'body "stops"))))
          (text n)))
((body "stops") "\n")
; A history read back from records is carried past a silent edit as the
; one its edits built: one between its groups moves only the later group.
> (define o (buffers:make "original" "\n"))
> (buffers:with-buffer o (commands:run checks:insert 1 "abc"))
#<edit 1>
> (buffers:with-buffer o (commands:run checks:insert 4 "XYZ"))
#<edit 2>
> (define-values (read-back fits?) (undo:records->history (undo:take-all-records! o)))
> (define c (buffers:make "read back" "abcXYZ\n"))
> (undo:install! c read-back 0)
#t
> (buffers:with-silent-edits c (buffers:replace! c 4 4 "--"))
#<edit 1>
> (buffers:with-buffer c (commands:run undo:undo 1))
> (text c)
"abc--\n"
> (buffers:with-buffer c (commands:run undo:undo 1))
> (text c)
"--\n"
; A cursor at the place of a silent insertion goes after it, as an edit
; that starts there does.
> (define k (buffers:make "cursor" "\n"))
> (define kv (views:make k))
> (views:call-with-view kv (lambda () (views:set-point! kv 1) (commands:run checks:insert 1 "q")))
#<edit 1>
> (buffers:with-silent-edits k (buffers:replace! k 1 1 "Z"))
#<edit 2>
> (views:call-with-view kv (lambda () (views:set-point! kv 3) (commands:run undo:undo 1)))
> (list (text k) (views:point kv))
("Z\n" 2)
; A silent edit that changes no token, as one that sets a travelling
; layer's spans, leaves the history as it is.
> (buffers:define-layer marks (travels))
> (define p (buffers:make "spans" "\n"))
> (buffers:with-buffer p (commands:run checks:insert 1 "one"))
#<edit 1>
> (buffers:with-buffer p (commands:run checks:insert 4 " two"))
#<edit 2>
> (buffers:with-silent-edits p (buffers:add-span! (buffers:layer p marks) 1 8 'seen))
> (buffers:with-silent-edits p (buffers:add-span! (buffers:layer p marks) 2 6 'cut))
> (list (text p) (tree p) (buffers:edit-moves? (car (reverse (buffers:edits-since p 2)))))
("one two\n" (2 0 (0 #f) (1 0) (2 1)) #f)
> (buffers:with-buffer p (commands:run undo:undo 1))
> (text p)
"one\n"
; A group a silent edit makes the root is closed, so the command's later
; edits make a group of their own, and the records taken meanwhile still
; replay.
> (define q (buffers:make "rooted" "\n"))
> (buffers:with-buffer q (commands:run checks:insert 1 "x"))
#<edit 1>
> (map car (undo:take-records! q))
(undo-history group at)
> (define whole #f)
> (undo:with-edit-group q
    (buffers:replace! q 2 2 "ab")
    (buffers:with-silent-edits q (buffers:replace! q 3 4 ""))
    (set! whole (undo:take-records! q))
    (buffers:replace! q 1 1 "c")
    (void))
> (define more (undo:take-records! q))
> (list (text q) (map car more))
("cxa\n" (group))
> (let-values ([(read-back fits?) (undo:records->history (append whole more))]) fits?)
#t
> (buffers:with-buffer q (commands:run undo:undo 1))
> (text q)
"xa\n"
; Undo keeps what the buffer held when it took text away, so spans set
; silently on a travelling layer come back with redo, as a property put
; inside with-silent-modifications comes back in Emacs.
> (define (marks-of b) (buffers:spans (buffers:layer b marks) 0 (document:length (buffers:document b))))
> (define m (buffers:make "redone" "\n"))
> (buffers:with-buffer m (commands:run checks:insert 1 "one"))
#<edit 1>
> (buffers:with-buffer m (commands:run checks:insert 4 " two"))
#<edit 2>
> (buffers:with-silent-edits m (buffers:add-span! (buffers:layer m marks) 1 8 'seen))
> (list (text m) (marks-of m))
("one two\n" ((1 8 seen)))
> (buffers:with-buffer m (commands:run undo:undo 1))
> (list (text m) (marks-of m))
("one\n" ((1 4 seen)))
> (buffers:with-buffer m (commands:run undo:redo 1))
> (list (text m) (marks-of m))
("one two\n" ((1 8 seen)))
> (buffers:with-buffer m (commands:run undo:undo 2))
> (buffers:with-buffer m (commands:run undo:redo 2))
> (list (text m) (marks-of m))
("one two\n" ((1 8 seen)))
