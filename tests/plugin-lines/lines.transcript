; Lines are read before the configuration runs; a second line for one id
; is reported, and the first is the one known.
! use-plugin: a second line for consult
; The index gives compat's source to its line.
> (compat:who)
"upstream compat"
; A line imports its plugin's main module: the next form sees its names.
> (consult:buffer)
"compat buffer"
; A line typed at the REPL is read before it is evaluated, so it installs
; a plugin the index does not name.
> (use-plugin vertico (git "https://github.com/minad/vertico"))
> (vertico:count)
10
; One library name has one provider: a plugin holding another's module is
; refused at install, and nothing of it is installed.
> (use-plugin rival (local "~/src/rival"))
! use-plugin: plugin rival and plugin compat both hold the library (compat)
> (memq 'rival (plugins:installed))
#f
; Names Tuna keeps for itself, chez-lang's among them, are refused too.
> (use-plugin keeper (local "~/src/keeper"))
! use-plugin: plugin keeper holds the library (lang reader), a name Tuna keeps for itself
> (memq 'keeper (plugins:installed))
#f
; Lines go only in the configuration and at the REPL; plugin lines only in
; an index's main module.
> (import (uses))
! attempt to reference unbound identifier use-plugin at line 3, char 2 of $HOME/.config/tuna/lib/uses.sls
> (use-plugin plain (local "~/src/plain"))
! attempt to reference unbound identifier plugin at line 4, char 2 of $HOME/src/plain/src/plain.sls
> (plugin compat (git "https://github.com/bob/compat"))
! plugin: a plugin line outside an index's main module (plugin compat (git "https://github.com/bob/compat"))
> (import (only integration))
! unknown module integration
; The configuration's lines' plugins in order, then the others by id.
> (plugins:installed)
(other sources compat consult greet plain vertico)
; greet and plain have no line; neither was loaded since Tuna started, as
; plain's module never compiled.
> (plugins:remove-unused!)
> (plugins:installed)
(other sources compat consult vertico)
> (file-exists? "~/.local/share/tuna/plugins/greet")
#f
; Tuna writes init.ss only through its commands.
> (display (call-with-input-file "~/.config/tuna/init.ss" get-string-all))
(import (tuna))
(use-plugin other (local "~/src/other"))
(use-plugin sources (git "https://github.com/groucho/tuna-sources"))
(use-plugin compat)
(use-plugin consult)
(use-plugin consult (git "https://example.org/second/consult"))
(import (console))
; Removing a local plugin comments out its line and never deletes its
; folder.
> (plugins:remove! 'other)
! use-plugin: a second line for consult
> (list (memq 'other (plugins:installed)) (file-exists? "~/src/other/src/other.sls"))
(#f #t)
> (other:name)
! other:name: module (other) is unloaded
> (display (call-with-input-file "~/.config/tuna/init.ss" get-string-all))
(import (tuna))
#;(use-plugin other (local "~/src/other"))
(use-plugin sources (git "https://github.com/groucho/tuna-sources"))
(use-plugin compat)
(use-plugin consult)
(use-plugin consult (git "https://example.org/second/consult"))
(import (console))
