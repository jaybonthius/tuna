(("<mouse-1>" . echo-area:show-messages) ("<down-mouse-1>" . keys:ignore))
> (eq? (buffers:kind-keymap (buffers:kind 'echo-area:area)) echo-area:keymap)
#t
; echo-area:message! and current-message work on the main thread only.
> (on-thread (lambda () (echo-area:message! "From a thread")))
(echo-area:message! "not on the main thread")
> (on-thread (lambda () (echo-area:current-message)))
(echo-area:current-message "not on the main thread")
> (raised (lambda () (echo-area:message! 'hello)))
(echo-area:message! "not a string")
