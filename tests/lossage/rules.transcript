; A mouse key is recorded by its key, without its position; mouse
; movements are not recorded, with or without modifiers, though the
; command one runs is.
> (mark!)
> (press! (list "<down-mouse-1>" (vector 1 0)) (list "<mouse-1>" (vector 1 0)))
> (press! (list "<mouse-movement>" (vector 1 2)) (list "S-<mouse-movement>" (vector 1 3)))
> (since-mark)
("<down-mouse-1>" editing:mouse-drag-region "<mouse-1>" harpo:honk harpo:honk harpo:honk)
; Every client's keys go in one record, in the order they came, each
; prefix as it is typed.
> (mark!)
> (press-in! client "C-c")
> (press-in! other-client "<f5>")
> (press-in! client "h")
> (since-mark)
("C-c" "<f5>" harpo:honk "h" harpo:honk-twice)
; A key no keymap binds is recorded, with the command that says so.
> (mark!)
> (press! "C-c" "z")
! C-c z is undefined
> (since-mark)
("C-c" "z" keys:undefined)
; Only the outermost command is recorded: not the commands it runs, nor
; the command M-x runs.
> (mark!)
> (press! "C-c" "h")
> (since-mark)
("C-c" "h" harpo:honk-twice)
> (mark!)
> (define t (start! (lambda () (press! "M-x"))))
> (apply press! (map string (string->list "harpo:honk")))
> (press! "RET")
> (result t)
> (since-mark)
("M-x" command-picker:execute-extended-command "h" editing:self-insert "a" editing:self-insert "r" editing:self-insert "p" editing:self-insert "o" editing:self-insert ":" editing:self-insert "h" editing:self-insert "o" editing:self-insert "n" editing:self-insert "k" editing:self-insert "RET" completion:exit)
; A command run other than by a key is recorded too.
> (mark!)
> (commands:run harpo:honk)
> (since-mark)
(harpo:honk)
