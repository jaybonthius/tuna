> (define chat (pi:start (getenv "HOME")))
> (define f (fake-of chat))
> (wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (define (ui-request id method . fields) (append `(("type" . "extension_ui_request") ("id" . ,id) ("method" . ,method)) fields))
; Each question Pi waits on is a record, oldest first.
> (say! f (ui-request "d1" "select" '("title" . "Allow rm?") '("options" . #("Allow" "Block")))
        (ui-request "d2" "confirm" '("title" . "Clear session?") '("message" . "All messages will be lost."))
        (ui-request "d3" "input" '("title" . "Name") '("placeholder" . "a name"))
        (ui-request "d4" "editor" '("title" . "Edit") '("prefill" . "Line 1\nLine 2")))
> (wait-until (lambda () (= 4 (length (pi:chat-dialogs chat)))))
> (map (lambda (d) (list (pi:dialog? d) (pi:dialog-method d) (pi:dialog-title d) (pi:dialog-message d) (pi:dialog-options d)
                         (pi:dialog-text d) (pi:dialog-deadline d)))
       (pi:chat-dialogs chat))
((#t select "Allow rm?" #f ("Allow" "Block") #f #f) (#t confirm "Clear session?" "All messages will be lost." () #f #f) (#t input "Name" #f () "a name" #f) (#t editor "Edit" #f () "Line 1\nLine 2" #f))
> (map pi:dialog-id (pi:chat-dialogs chat))
("d1" "d2" "d3" "d4")
; An answer is a string, or a boolean for a confirm; each leaves the chat.
> (define ds (pi:chat-dialogs chat))
> (pi:answer! chat (car ds) "Block")
> (pi:answer! chat (cadr ds) #t)
> (pi:answer! chat (caddr ds) "Zeppo")
> (pi:cancel! chat (cadddr ds))
> (pi:chat-dialogs chat)
()
> (wait-until (lambda () (= 4 (length (filter (lambda (r) (equal? (ref r "type") "extension_ui_response")) (fake-requests f))))))
> (map (lambda (r) (list-tail r 2)) (filter (lambda (r) (equal? (ref r "type") "extension_ui_response")) (fake-requests f)))
((("value" . "Block")) (("confirmed" . #t)) (("value" . "Zeppo")) (("cancelled" . #t)))
> (map (lambda (r) (ref r "id")) (filter (lambda (r) (equal? (ref r "type") "extension_ui_response")) (fake-requests f)))
("d1" "d2" "d3" "d4")
> (pi:answer! chat (car ds) "again")
> (pi:answer! chat (cadr ds) "yes")
! pi:answer!: not a boolean with irritant "yes"
> (pi:answer! chat (car ds) #t)
! pi:answer!: not a string with irritant #t
; A question leaves at its deadline, when Pi stops waiting.
> (say! f (ui-request "d5" "confirm" '("title" . "Quick?") '("timeout" . 300)))
> (wait-until (lambda () (= 1 (length (pi:chat-dialogs chat)))))
> (time? (pi:dialog-deadline (car (pi:chat-dialogs chat))))
#t
> (wait-until (lambda () (null? (pi:chat-dialogs chat))))
> (pi:chat-dialogs chat)
()
; Extensions' status texts and widgets, latest per key; an absent text
; or lines clears one.
> (say! f (ui-request "s1" "setStatus" '("statusKey" . "pool") '("statusText" . "1 pool(s)"))
        (ui-request "s2" "setStatus" '("statusKey" . "stash") '("statusText" . "2 stashed"))
        (ui-request "s3" "setStatus" '("statusKey" . "pool") '("statusText" . "3 pool(s)"))
        (ui-request "s4" "setStatus" '("statusKey" . "stash"))
        (ui-request "w1" "setWidget" '("widgetKey" . "plan") '("widgetLines" . #("Step 1" "Step 2")))
        (ui-request "w2" "setWidget" '("widgetKey" . "foot") '("widgetLines" . #("below")) '("widgetPlacement" . "belowEditor"))
        (ui-request "w3" "setWidget" '("widgetKey" . "gone") '("widgetLines" . #("x")))
        (ui-request "w4" "setWidget" '("widgetKey" . "gone"))
        (ui-request "t1" "setTitle" '("title" . "pi - x")))
> (wait-until (lambda () (= 2 (length (pi:chat-widgets chat)))))
> (pi:chat-statuses chat)
(("pool" . "3 pool(s)"))
> (map (lambda (w) (list (pi:widget? w) (pi:widget-key w) (pi:widget-placement w) (pi:widget-lines w))) (pi:chat-widgets chat))
((#t "plan" above ("Step 1" "Step 2")) (#t "foot" below ("below")))
; An extension that sets the editor's text calls a hook.
> (say! f (ui-request "e1" "set_editor_text" '("text" . "/review")))
> (wait-until (lambda () (pair? editor-texts)))
> editor-texts
("/review")
; A question gone at its deadline stays gone when pi loads again and
; replays its request from the log, as does one whose deadline passed
; while pi was off.
> (say! f (ui-request "d6" "confirm" '("title" . "Soon?") '("timeout" . 300)))
> (wait-until (lambda () (= 1 (length (pi:chat-dialogs chat)))))
> (unload-module! '(pi))
> (sleep-for 0.4)
> (load-module! '(pi))
> (define chat (car (pi:chats)))
> (wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (sleep-for 0.3)
> (pi:chat-dialogs chat)
()
