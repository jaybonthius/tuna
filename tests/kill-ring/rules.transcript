((form () (field () "xabcAnswer here.y")) (("Answer here.y" gpt)))
; kill-ring:join makes one kill of strings, pieces and kills: pushed, it
; is one entry and one call of after-push; yanked, its parts go in turn,
; and a part refused takes the others back out.
> (set! pushed '())
> (define cells (kill-ring:join (buffers:piece w 2 5) "|" (buffers:piece w 13 18)))
> (kill-ring:push! (list cells))
