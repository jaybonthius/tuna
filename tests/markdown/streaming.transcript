> (chat:receive! "  (* x 2))\n")
> (datums chat:chat)
((chat:reply () (markdown:paragraph ((key . 0)) "Code:\n") (markdown:code-block ((key . 1) (language . "scheme")) "(define (f x)\n  (* x 2))\n")))
