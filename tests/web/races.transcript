Tuna is at http://127.0.0.1:PORT/
> (http:wait-for-server)
; Four pages each send 300 items from three threads at once, out of
; order; each client's items run in the order it numbered them.
> (define pages (list (http:page) (http:page) (http:page) (http:page)))
> (define runs (make-eq-hashtable))
> (table-set! web:input-handlers "flood"
    (lambda (client item)
      (hashtable-update! runs client (lambda (ns) (cons (cdr (assoc "n" item)) ns)) '())))
> (http:flood! pages 300)
> (let ([expected (map 1+ (iota 300))])
    (map (lambda (c) (equal? (reverse (hashtable-ref runs c '())) expected))
         (vector->list (hashtable-keys runs))))
(#t #t #t #t)
; Screens given as fast as the main thread can while another thread
; confirms each as it arrives: every screen sent is numbered in turn, the
; contents go forward, and the last one given arrives.
> (define p (car pages))
> (http:connect! p)
> (define c (car (web:clients)))
> (define seen (http:auto-confirm! p))
> (do ([i 1 (+ i 1)]) ((> i 2000))
    (web:send-screen! c (string->utf8 (number->string i)) "Tuna")
    (when (zero? (mod i 50)) (sleep-for 0)))
> (testing:wait-until (lambda () (let ([s (seen)]) (and (pair? s) (equal? (cdr (car (last-pair s))) "2000")))))
> (let ([s (seen)])
    (list (equal? (map car s) (map 1+ (iota (length s))))
          (let loop ([s (map (lambda (x) (string->number (cdr x))) s)])
            (or (null? (cdr s)) (and (< (car s) (cadr s)) (loop (cdr s)))))
          (cdr (car (last-pair s)))))
(#t #t "2000")
; Quits requested every millisecond while the main thread gives screens,
; calls pages and lists clients leave no lock held and no client half
; changed.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define quitting #t)
> (define stopped #f)
> (define quits 0)
> (define (quitter)
    (let loop ()
      (if quitting
          (begin
            (request-quit!)
            (chez:sleep (make-time 'time-duration 1000000 0))
            (loop))
          (set! stopped #t))))
> (define forked #f)
; A quit lands up to a thousand calls after its request, and the
; quitter's last request may come after the stress ends. One guard
; holds from before the quitter starts until long after it stops,
; since a quit landing between two guards would end the form. Quits
; land at least a thousand calls apart, so none lands in the handler
; before it enters the guard again.
> (define (stress until)
    (let again ()
      (guard (e [(quit-condition? e) (set! quits (+ quits 1)) (again)])
        (unless forked
          (set! forked #t)
          (fork-thread quitter))
        (let loop ([i 0])
          (when (< (real-time) until)
            (web:send-screen! c (string->utf8 (string-append "q" (number->string i))) "Tuna")
            (when (zero? (mod i 1000)) (web:call-page! c "noop" i))
            (web:clients)
            (loop (+ i 1))))
        (set! quitting #f)
        (let spin () (unless stopped (spin)))
        (let settle ([n 0]) (when (< n 100000) (settle (+ n 1)))))))
> (begin
    (stress (+ (real-time) 1000))
    (> quits 10))
#t
> (web:send-screen! c (haml (:p "after the quits")) "Tuna")
> (testing:wait-until (lambda () (equal? (cdr (car (last-pair (seen)))) "<p>after the quits</p>")))
> (cdr (car (last-pair (seen))))
"<p>after the quits</p>"
