(("elsewhere" #t))
; C-M-v from a prompt scrolls the view the prompt came from; elsewhere
; the view C-x o goes to. C-M-S-l run again goes on through recenter's
; cycle there, as the inner command ends last and is the last command.
> (define here (view))
> (define t (start! (lambda () (press! "C-x" "b"))))
> (eq? (layout:other-view-for-scrolling) here)
#t
> (press! "C-g")
! &quit
> (result t)
> (define below (layout-split:split-view! (view) (layout-split:direction column)))
> (define (place-kind v)
    (let* ([html (html->string (views:draw v client))] [key "data-place-kind=\""]
           [i (let loop ([i 0]) (if (string=? (substring html i (+ i (string-length key))) key) i (loop (+ i 1))))]
           [from (+ i (string-length key))])
      (let loop ([j from]) (if (char=? (string-ref html j) #\") (substring html from j) (loop (+ j 1))))))
> (press! "C-M-L")
> (list (place-kind below) (commands:command-name (commands:last-command)))
("center" views:recenter-top-bottom)
> (press! "C-M-L")
> (place-kind below)
"top"
