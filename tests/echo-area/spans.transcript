; echo-area:spans draws ranges of a message's text in faces, inside the
; message's own face; the log keeps the text alone.
> (parameterize ([echo-area:spans (list (list 6 23 faces:highlight))])
    (echo-area:message! "~a" "total(items: list[Item]) -> Decimal"))
> (echo-area-element)
"<div class=\"echo-area-message\" role=\"status\"><div class=\"line\" id=\"v3-2\" data-line=\"1\" data-slot=\"0\" data-at=\"1\"><span class=\"view-point\"></span>total(<span data-face=\"highlight\">items: list[Item]</span>) -&gt; Decimal</div></div>"
> (echo-area:current-spans)
((6 23 highlight))
> (messages)
"total(items: list[Item]) -> Decimal\n"
; A range past the text's end is cut to it; the next message has its own.
> (parameterize ([echo-area:spans (list (list 2 99 faces:warning))])
    (echo-area:message! "short"))
> (echo-area:current-spans)
((2 5 warning))
> (echo-area:message! "plain")
> (echo-area:current-spans)
()
> (echo-area:message! "")
> (echo-area:current-spans)
()
; Any other value raises.
> (raised (lambda () (parameterize ([echo-area:spans '(oops)]) #t)))
(echo-area:spans "not a list of a start, an end and a face")
