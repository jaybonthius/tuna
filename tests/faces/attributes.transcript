; Every face the plugin defines has a rule of its own in its stylesheet,
; and the stylesheet styles no other name: a plugin's faces are styled
; in the plugin's own stylesheet.
> (length defined-faces)
77
> (unstyled-faces)
()
> (styled-not-defined)
()
; Every face rule, in faces.css and in every plugin's stylesheet, is in
; the sub-layer defaults.faces, under every plugin's own rules.
> (face-rules-outside-sublayer)
()
; Each declares the seven properties, each reading the face's own token
; first, then its family's or the face it follows, ending in a default
; or revert-layer. A diagnostic's wavy line also goes through the ink.
> (malformed-face-rules)
()
> (length (filter (lambda (r) (string=? (car r) "defaults.faces")) (apply append (map (lambda (f) (css-rules (library-file f))) face-stylesheets))))
122
> (rule-chain "faces/faces.css" "keyword.return" "font-weight")
("--faces-keyword-return-font-weight" "--faces-keyword-font-weight" "revert-layer")
> (rule-chain "faces/faces.css" "keyword.return" "color")
("--faces-keyword-return-color" "--faces-keyword-color" "--tuna-violet-11")
> (rule-chain "faces/faces.css" "error" "font-weight")
("--faces-error-font-weight" "--tuna-font-weight-bold")
> (rule-chain "dired/dired.css" "dired.header" "color")
("--dired-header-color" "--tuna-text")
; Faces that follow another face read its tokens after their own.
> (map (lambda (f) (rule-chain "faces/faces.css" f "font-style"))
       '("boolean" "character" "string.special.symbol" "string.documentation" "variable.parameter"
         "function.method.call" "type.builtin" "constructor" "function.builtin"))
(("--faces-boolean-font-style" "--faces-constant-font-style" "revert-layer") ("--faces-character-font-style" "--faces-constant-font-style" "revert-layer") ("--faces-string-special-symbol-font-style" "--faces-constant-font-style" "revert-layer") ("--faces-string-documentation-font-style" "--faces-comment-documentation-font-style" "--faces-comment-font-style" "revert-layer") ("--faces-variable-parameter-font-style" "--faces-variable-definition-font-style" "--faces-variable-font-style" "revert-layer") ("--faces-function-method-call-font-style" "--faces-function-call-font-style" "--faces-function-font-style" "revert-layer") ("--faces-type-builtin-font-style" "--faces-type-font-style" "revert-layer") ("--faces-constructor-font-style" "--faces-type-font-style" "revert-layer") ("--faces-function-builtin-font-style" "--faces-builtin-font-style" "revert-layer"))
; A face's own default stops its family's: a method call is coloured as a
; call, a directive as a directive.
> (map (lambda (f) (rule-chain "faces/faces.css" f "color")) '("function.method.call" "keyword.directive"))
(("--faces-function-method-call-color" "--faces-function-call-color" "--tuna-blue-11") ("--faces-keyword-directive-color" "--tuna-pink-11"))
; The defaults that follow Emacs: errors, warnings and successes are
; bold; raw text and key bindings are in the code font; heading levels
; are bold through their family; a strike-through is struck.
> (map (lambda (f) (rule-chain "faces/faces.css" f "font-weight")) '("error" "warning" "success" "markup.heading.3"))
(("--faces-error-font-weight" "--tuna-font-weight-bold") ("--faces-warning-font-weight" "--tuna-font-weight-bold") ("--faces-success-font-weight" "--tuna-font-weight-bold") ("--faces-markup-heading-3-font-weight" "--faces-markup-heading-font-weight" "--tuna-font-weight-bold"))
> (map (lambda (f) (rule-chain "faces/faces.css" f "font-family")) '("markup.raw" "markup.raw.block" "key-binding"))
(("--faces-markup-raw-font-family" "--tuna-font-code") ("--faces-markup-raw-block-font-family" "--faces-markup-raw-font-family" "--tuna-font-code") ("--faces-key-binding-font-family" "--tuna-font-code"))
> (list (rule-chain "faces/faces.css" "key-binding" "color") (rule-chain "faces/faces.css" "key-binding" "background-color"))
(("--faces-key-binding-color" "--tuna-info") ("--faces-key-binding-background" "revert-layer"))
> (rule-chain "faces/faces.css" "markup.strikethrough" "text-decoration")
("--faces-markup-strikethrough-text-decoration" "line-through")
> (map (lambda (n) (rule-chain "faces/faces.css" (format "markup.heading.~a" n) "color")) '(1 6))
(("--faces-markup-heading-1-color" "--faces-markup-heading-color" "--tuna-blue-11") ("--faces-markup-heading-6-color" "--faces-markup-heading-color" "--tuna-blue-11"))
; A background is background-color, never the shorthand, so views'
; hover overlay survives.
> (filter (lambda (r) (assoc "background" (caddr r))) (apply append (map (lambda (f) (css-rules (library-file f))) face-stylesheets)))
()
; A node a match covers is no face rule: it stays in defaults, reading
; the match faces' background tokens.
> (map (lambda (r) (list (car r) (cadr r) (cdar (caddr r))))
       (filter (lambda (r) (and (search (cadr r) "data-face" 0) (not (face-rule? r)))) (css-rules (library-file "faces/faces.css"))))
(("defaults" ".view .node[data-face=\"match\"] > *" "var(--faces-match-background, var(--tuna-match))") ("defaults" ".view .node[data-face=\"match.other\"] > *" "var(--faces-match-other-background, var(--tuna-match-other))"))
; The region's band gives way to no face's background by a rule of its
; own: views has no rule for a span above the region, which keeps its
; face's background or, with none, shows the region behind it.
> (filter (lambda (r) (search (cadr r) "above-region:not" 0)) (css-rules (library-file "views/views.css")))
()
; Chat's diff lines take their backgrounds from the diff faces alone.
> (filter (lambda (r) (member (cadr r) '(".chat-added" ".chat-removed"))) (css-rules (library-file "chat/chat.css")))
()
