> (import (base-tasks))
! attempt to reference unbound identifier spawn-task at line 2, char 18 of ~/.config/tuna/lib/base-tasks.sls
; Unloading a module resumes its paused tasks with &quit raised; a task
; that has not started never runs.
> (import (waiter))
> (begin
    (as-module '(waiter) (waiter:wait-forever))
    (void))
> (map car (module-changes '(waiter)))
(task define define define)
> (begin
    (as-module '(waiter)
      (post! (lambda ()
               (guard (c [(quit-condition? c) (display "waiter's posted task quit") (newline)])
                 (suspend (lambda (resume) (void)))))))
    (void))
> (begin
    (as-module '(waiter) (waiter:later))
    (unload-module! '(waiter)))
waiter's task quit
waiter's posted task quit
; A thunk posted by a module unloaded before it runs never runs, and a
; task that goes on after its module is unloaded makes no change.
> (load-module! '(waiter))
> (begin (as-module '(waiter) (waiter:stubborn)) (void))
> (begin
    (as-module '(waiter) (post! (lambda () (display "never runs"))))
    (unload-module! '(waiter)))
! on-unload: not a loaded module with irritant (waiter)
> (module-changes '(waiter))
()
; A finished task is no longer a change of its module.
> (module-changes '(repl))
()
; Posted work belongs to the instance that posted it: a thunk posted
; before its module is unloaded and loaded again never runs, while one
; posted before a reload runs.
> (load-module! '(waiter))
> (begin
    (as-module '(waiter) (post! (lambda () (display "stale instance"))))
    (unload-module! '(waiter))
    (load-module! '(waiter)))
> (import (tuna eval))
> (begin
    (as-module '(waiter) (post! (lambda () (display "reloaded instance") (newline))))
    (eval-file "~/.config/tuna/lib/waiter.sls"))
reloaded instance
