; Values from many jobs at once each arrive on the main thread, each
; job's in order.
> (jobs:define-worker (count-up input emit)
    (do ([i 0 (+ i 1)]) ((= i (cdr input))) (emit (cons (car input) i))))
> (define received (make-vector 8 '()))
> (define off-main 0)
> (do ([id 0 (+ id 1)]) ((= id 8))
    (jobs:start count-up (cons id 2000)
      (lambda (v)
        (unless (task? (current-task)) (set! off-main (+ off-main 1)))
        (vector-set! received (car v) (cons (cdr v) (vector-ref received (car v)))))))
> (wait-until (lambda () (for-all (lambda (l) (= (length l) 2000)) (vector->list received))))
> (list off-main (for-all (lambda (l) (equal? (reverse l) (iota 2000))) (vector->list received)))
(0 #t)
; Stops race the starts: stopping a job before its body runs, or while it
; runs, ends it with stopped, and leaves the others running.
> (jobs:define-worker (spin x emit) (let loop () (loop)))
> (define ended '())
> (define (start-spin) (jobs:start spin 0 void (lambda (e) (set! ended (cons e ended)))))
> (define early (map (lambda (i) (start-spin)) (iota 10)))
> (define late (map (lambda (i) (start-spin)) (iota 10)))
> (for-each jobs:stop! early)
> (wait-until (lambda () (= (length ended) 10)))
> (sleep-for 0.05)
> ended
(stopped stopped stopped stopped stopped stopped stopped stopped stopped stopped)
> (for-each jobs:stop! late)
> (wait-until (lambda () (= (length ended) 20)))
> (for-all (lambda (e) (eq? e 'stopped)) ended)
#t
; Vectors frozen on several threads at once, while a job sends values
; holding them back, all arrive.
> (jobs:define-worker (bounce x emit receive) (let loop () (emit (receive)) (loop)))
> (define bounced 0)
> (define bouncing (jobs:start bounce 0 (lambda (v) (set! bounced (+ bounced 1)))))
> (do ([k 0 (+ k 1)]) ((= k 4))
    (fork-thread
      (lambda ()
        (do ([i 0 (+ i 1)]) ((= i 2000))
          (jobs:send! bouncing (list (jobs:freeze (vector k i)) (jobs:freeze (vector (list i)))))))))
> (wait-until (lambda () (= bounced 8000)))
> (jobs:stop! bouncing)
> bounced
8000
; Quits land in the plugin's code on the main thread, sending, and leave
; no mutex held: afterwards the job still answers. The thread asks for a
; quit only while the main thread has armed it inside the guard, so every
; quit lands there, however the threads are scheduled. The echo skips
; what the stress sends, so its answer does not wait behind them.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (jobs:define-worker (echo x emit receive)
    (let loop ()
      (let ([v (receive)])
        (unless (eq? v 'stress) (emit v)))
      (loop)))
> (define answers '())
> (define echoing (jobs:start echo 0 (lambda (v) (set! answers (cons v answers)))))
> (define armed (box #f))
> (define quitting (box #t))
> (define quits 0)
> (define (quitter)
    (let loop ()
      (when (unbox quitting)
        (chez:sleep (make-time 'time-duration 1000000 0))
        (when (box-cas! armed #t #f) (request-quit!))
        (loop))))
> (define (stress n)
    (let retry ()
      (when (< quits n)
        (guard (c [(quit-condition? c) (set! quits (+ quits 1))])
          (set-box! armed #t)
          (let loop ()
            (jobs:send! echoing 'stress)
            (loop)))
        (retry))))
> (begin
    (fork-thread quitter)
    (stress 500)
    (set-box! quitting #f)
    quits)
500
> (jobs:send! echoing 'after)
> (wait-until (lambda () (memq 'after answers)))
> answers
(after)
> (jobs:stop! echoing)
; Quits requested as fast as a thread can, while the main thread delivers
; a job's values, lose no more than those deliveries: afterwards the job
; still sends. The storm starts from an item posted by the form, which runs
; only once the form has paused, so that no quit lands in it. The reports,
; whose number varies, go to a port that only notes that one came, and the
; storm goes on until one has.
> (jobs:define-worker (flood n emit) (let loop () (emit n) (loop)))
> (define delivered 0)
> (define counting (jobs:start flood 0 (lambda (v) (set! delivered (+ delivered 1)))))
> (define stderr (console-error-port))
> (define reported (box #f))
> (define reports
    (make-custom-textual-output-port "reports"
      (lambda (s start n) (set-box! reported #t) n) #f #f #f))
> (define (after-storm thunk)
    (suspend
      (lambda (resume)
        (post!
          (lambda ()
            (fork-thread
              (lambda ()
                (let ([until (+ (real-time) 2000)])
                  (let loop ()
                    (when (or (< (real-time) until) (not (unbox reported)))
                      (request-quit!)
                      (loop))))
                (resume thunk))))))))
> (console-error-port reports)
> (after-storm
    (lambda ()
      (let ([before delivered])
        (wait-until (lambda () (> delivered before)))
        (console-error-port stderr)
        (list (> delivered before) (unbox reported)))))
(#t #t)
> (jobs:stop! counting)
; A quit landing in jobs:start or jobs:stop! leaves no job half started:
; every job started ends.
> (jobs:define-worker (nothing x emit) (void))
> (define started 0)
> (define finished-jobs 0)
> (define landed 0)
> (do ([i 0 (+ i 1)]) ((= i 100))
    (guard (c [(quit-condition? c) (set! landed (+ landed 1))])
      (request-quit!)
      (let loop ()
        (jobs:stop! (jobs:start nothing 0 void (lambda (e) (set! finished-jobs (+ finished-jobs 1)))))
        (set! started (+ started 1))
        (loop))))
> landed
100
> (wait-until (lambda () (>= finished-jobs started)))
> (>= finished-jobs started)
#t
> (jobs:define-worker (echo-once x emit) (emit x))
> (finished echo-once 'still-working)
((still-working) #f)
