; Only the rows a view draws are drawn: a view not yet measured draws
; 200 items each side of point, so a list of 1000 rows with point on
; row 500 calls the drawer for rows 300 to 700 alone.
> (define drawn-rows (make-eqv-hashtable))
> (ui:set-rows! b (lst) 1000 (lambda (i) (hashtable-set! drawn-rows i #t) (number-row i)) choose)
> (ui:select-row! (lst) (view) 500)
> (hashtable-clear! drawn-rows)
> (string? (html (view)))
#t
> (let ([rows (vector->list (hashtable-keys drawn-rows))]) (list (length rows) (apply min rows) (apply max rows)))
(401 300 700)
