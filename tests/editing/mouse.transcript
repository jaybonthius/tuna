> (state)
("one X three" ((6 #f)))
; A second press selects the word at the position, by the mode's word
; characters, a run of whitespace, or a run of one character; dragging it
; extends by words; a third press selects the line with its newline.
> (start! "foo-bar  x---y\nsecond line\nthird" 1)
("foo-bar  x---y\nsecond line\nthird" ((1 #f)))
> (mouse! "down" 2)
> (mouse! "click" 2)
> (apply mouse! "down" 2 (double))
> (state)
("foo-bar  x---y\nsecond line\nthird" ((4 1)))
> (apply mouse! "click" 2 (double))
> (state)
("foo-bar  x---y\nsecond line\nthird" ((4 1)))
> (buffers:with-buffer (views:buffer (view)) (set-option-local! editing:word-characters "-"))
> (apply mouse! "down" 2 (double))
> (state)
("foo-bar  x---y\nsecond line\nthird" ((8 1)))
> (apply mouse! "down" 9 (double))
> (state)
("foo-bar  x---y\nsecond line\nthird" ((10 8)))
> (buffers:with-buffer (views:buffer (view)) (set-option-local! editing:word-characters ""))
> (apply mouse! "down" 12 (double))
> (state)
("foo-bar  x---y\nsecond line\nthird" ((14 11)))
