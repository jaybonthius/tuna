(import (tuna) (test) (test-user) (views) (buffers) (kill-ring) (editing) (scene) (column-region))

(define box "abcdefghij\nab\nabcdefghij\nabcdef")

(define grid "0123456789\n0123456789\n0123456789\n0123456789\n")

(buffers:define-layer locked-lines (read-only))

(define (each-kill) (map (lambda (kill) (kill-ring:text (list kill))) (kill-ring:current)))

(test "advice on views:region-ranges shapes the region: a kill takes each range, one kill per cursor with a line break between ranges, yanked as that text"
  (advice-add! views:region-ranges column-region:ranges)
  (scene:show! box 32)
  (views:set-mark! (scene:view) 3)
  (check-equal? '((3 . 7) (17 . 21) (28 . 32)) (views:region-bounds (scene:view)))
  (test-user:press! "C-w")
  (check-equal? '(("abghij\nab\nabghij\nab" ((3 #f))) ("cdef\ncdef\ncdef")) (list (scene:state) (each-kill)))
  (test-user:press! "C-y")
  (check-equal? '("abcdef\ncdef\ncdefghij\nab\nabghij\nab" ((17 #f))) (scene:state))
  (advice-remove! views:region-ranges column-region:ranges))

(test "with a shaped region, M-w copies each range, case conversion converts each, typing replaces each where the first began, and the primary selection is the shaped kill"
  (advice-add! views:region-ranges column-region:ranges)
  (scene:show! box 32)
  (views:set-mark! (scene:view) 3)
  (test-user:press! "M-w")
  (check-equal? (list (list box '((32 #f))) '("cdef\ncdef\ncdef")) (list (scene:state) (scene:kills 1)))
  (views:set-mark! (scene:view) 3)
  (test-user:press! "C-x C-u")
  (check-equal? '("abCDEFghij\nab\nabCDEFghij\nabCDEF" ((32 #f))) (scene:state))
  (scene:with-setting editing:delete-selection #t
    (lambda ()
      (views:set-mark! (scene:view) 3)
      (test-user:press! "x")
      (check-equal? '("abxghij\nab\nabghij\nab" ((4 #f))) (scene:state))))
  (scene:show! box 32)
  (views:set-mark! (scene:view) 3)
  (test-user:press! "C-b")
  (check-equal? "cde\ncde\ncde" (kill-ring:text (list (editing:primary-selection))))
  (advice-remove! views:region-ranges column-region:ranges))

(test "advice on extract-region gives the kill the procedure that yanks it, whose insertions yank-pop takes back and nothing between"
  (advice-add! views:region-ranges column-region:ranges)
  (advice-add! editing:extract-region column-region:kill)
  (scene:show! grid 14)
  (kill-ring:push! (list "XYZ"))
  (views:set-mark! (scene:view) 39)
  (check-equal? '((14 . 17) (25 . 28) (36 . 39)) (views:region-bounds (scene:view)))
  (test-user:press! "C-w")
  (check-equal? '(("0123456789\n0156789\n0156789\n0156789\n" ((14 #f))) ("234\n234\n234")) (list (scene:state) (scene:kills 1)))
  (views:set-point! (scene:view) 17)
  (test-user:press! "C-y")
  (check-equal? '("0123456789\n0156723489\n0156723489\n0156723489\n" ((42 #f))) (scene:state))
  (test-user:press! "M-y")
  (check-equal? '("0123456789\n01567XYZ89\n0156789\n0156789\n" ((20 #f))) (scene:state))
  (advice-remove! editing:extract-region column-region:kill)
  (advice-remove! views:region-ranges column-region:ranges))

(test "the padding and lines a yank procedure adds are its insertions too, so yank-pop takes them back"
  (advice-add! views:region-ranges column-region:ranges)
  (advice-add! editing:extract-region column-region:kill)
  (scene:show! grid 14)
  (kill-ring:push! (list "XYZ"))
  (views:set-mark! (scene:view) 39)
  (test-user:press! "C-w")
  (scene:show! "abcdefgh\nab\n" 6)
  (test-user:press! "C-y")
  (check-equal? '("abcde234fgh\nab   234\n     234" ((30 #f))) (scene:state))
  (test-user:press! "M-y")
  (check-equal? '("abcdeXYZfgh\nab\n" ((9 #f))) (scene:state))
  (advice-remove! editing:extract-region column-region:kill)
  (advice-remove! views:region-ranges column-region:ranges))

(test "a yank whose procedure is refused part-way takes back what went in and leaves point"
  (advice-add! views:region-ranges column-region:ranges)
  (advice-add! editing:extract-region column-region:kill)
  (scene:show! grid 14)
  (views:set-mark! (scene:view) 39)
  (test-user:press! "C-w")
  (let ([b (scene:show! "abcdefgh\nabcdefgh\nabcdefgh\n" 6)])
    (buffers:add-span! (buffers:layer b locked-lines) 10 18 'locked)
    (check-equal? 'buffers:insert! (caar (scene:press-reports! "C-y")))
    (check-equal? '("abcdefgh\nabcdefgh\nabcdefgh\n" ((6 #f))) (scene:state)))
  (advice-remove! editing:extract-region column-region:kill)
  (advice-remove! views:region-ranges column-region:ranges))

(test "a kill that yanks itself is never joined to another kill, nor to a kill at as many cursors before it"
  (advice-add! views:region-ranges column-region:ranges)
  (advice-add! editing:extract-region column-region:kill)
  (scene:show! grid 14)
  (let ([before (length (kill-ring:entries))])
    (views:set-mark! (scene:view) 27)
    (test-user:press! "C-w")
    (views:set-mark! (scene:view) 26)
    (test-user:press! "C-w")
    (check-equal? '(("0123456789\n01789\n01789\n0123456789\n" ((14 #f))) 2 ("456\n456" "23\n23"))
      (list (scene:state) (- (length (kill-ring:entries)) before) (scene:kills 2))))
  (scene:show! "one\ntwo\nthree\nfour\n" 1 5 9)
  (let ([before (length (kill-ring:entries))])
    (test-user:press! "C-k")
    (for-each (lambda (c) (views:remove-cursor! (scene:view) c)) (cdr (views:cursors (scene:view))))
    (views:set-cursor! (car (views:cursors (scene:view))) 2 7)
    (test-user:press! "C-w")
    (check-equal? '(("\n\n\nr\n" ((4 #f))) 2 ("fou")) (list (scene:state) (- (length (kill-ring:entries)) before) (each-kill))))
  (advice-remove! editing:extract-region column-region:kill)
  (advice-remove! views:region-ranges column-region:ranges))

(test "two cursors each with a shaped region: one kill per cursor, which a yank at the two cursors gives back each in its shape"
  (advice-add! views:region-ranges column-region:ranges)
  (advice-add! editing:extract-region column-region:kill)
  (let ([four "abcdefghij\nabcdefghij\nabcdefghij\nabcdefghij\n"])
    (scene:show! four 18 40)
    (let ([cs (views:cursors (scene:view))])
      (views:set-cursor! (car cs) 18 3)
      (views:set-cursor! (cadr cs) 40 25))
    (check-equal? '(((3 . 7) (14 . 18)) ((25 . 29) (36 . 40)))
      (map (lambda (c) (views:region-bounds (scene:view) c)) (views:cursors (scene:view))))
    (test-user:press! "C-w")
    (check-equal? '(("abghij\nabghij\nabghij\nabghij\n" ((3 #f) (17 #f))) ("cdef\ncdef" "cdef\ncdef")) (list (scene:state) (each-kill)))
    (test-user:press! "C-y")
    (check-equal? four (scene:text)))
  (advice-remove! editing:extract-region column-region:kill)
  (advice-remove! views:region-ranges column-region:ranges))

(test "insert-region! puts lines in with a line break between and returns the position after them; advice gives a shaped region's cursor its shape"
  (scene:show! grid 1)
  (let ([c (car (views:cursors (scene:view)))])
    (check-equal? 8 (editing:insert-region! (scene:view) c 3 '("ab" "cd")))
    (check-equal? "01ab\ncd23456789\n0123456789\n0123456789\n0123456789\n" (scene:text))
    (advice-add! editing:insert-region! column-region:insert-region)
    (views:set-mark! (scene:view) 1)
    (check-equal? 47 (editing:insert-region! (scene:view) c 19 '("xy" "zw" "uv")))
    (check-equal? "01ab\ncd23456789\n01xy23456789\n01zw23456789\n01uv23456789\n" (scene:text))
    (views:set-mark! (scene:view) #f)
    (check-equal? 5 (editing:insert-region! (scene:view) c 2 '("p" "q")))
    (check-equal? "0p\nq1ab\ncd23456789\n01xy23456789\n01zw23456789\n01uv23456789\n" (scene:text))
    (advice-remove! editing:insert-region! column-region:insert-region)))

(test "without advice the region is point to mark"
  (scene:show! "abc" 1)
  (check-equal? '() (views:region-bounds (scene:view)))
  (views:set-mark! (scene:view) 3)
  (check-equal? '((1 . 3)) (views:region-bounds (scene:view))))

(test "extract-region and insert-region! check their arguments"
  (scene:show! "abc" 1)
  (let ([c (car (views:cursors (scene:view)))])
    (check-raises (lambda (e) (equal? "not a non-empty list of ranges in the buffer" (condition-message e)))
      (editing:extract-region (scene:view) c '()))
    (check-raises (lambda (e) (equal? "not a cursor of the view" (condition-message e)))
      (editing:extract-region (scene:view) 'c '((1 . 2))))
    (check-raises (lambda (e) (equal? "not a position in the buffer" (condition-message e)))
      (editing:insert-region! (scene:view) c 99 '("x")))
    (check-raises (lambda (e) (equal? "not a non-empty list of strings" (condition-message e)))
      (editing:insert-region! (scene:view) c 1 '()))))
