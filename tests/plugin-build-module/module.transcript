(import (tuna))
(use-plugin gen (git "https://github.com/bob/gen") (commit "671453743e1f8fe07a7844d3b8f248f5bbaeb7be"))

(define (show path)
  (display (call-with-input-file (string-append (getenv "HOME") "/" path) get-string-all)))

(define (exists? path)
  (file-exists? (string-append (getenv "HOME") "/" path)))
