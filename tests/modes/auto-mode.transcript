; By the program a #! line names: the last part of its path; for env,
; the first argument that neither starts with - nor contains =; as
; written, then without a trailing version.
> (tables:set! auto-mode:interpreters "guile" text:mode)
> (define n 0)
> (define (first-line-mode line)
    (set! n (+ n 1))
    (let ([b (buffers:make (format "script~a" n) line)])
      (auto-mode:by-interpreter b "script")))
> (map first-line-mode
       '("#!/usr/bin/python\nprint(1)\n"
         "#!/usr/bin/env python3\n"
         "#! /usr/bin/env -S VAR=1 python3.12 -u\n"
         "#!/usr/local/bin/guile-3.0 -s\n"
         "#!/usr/bin/env\n"
         "#!/bin/sh\n"
         "# python\n"
         ""
         "#!"))
(python:mode python:mode python:mode text:mode #f #f #f #f #f)
; By file name: the last part, without a trailing ~, whole, then from
; each dot on, longest first; as written, then in lowercase.
