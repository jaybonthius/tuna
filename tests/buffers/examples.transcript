; Buffers as their documented examples use them, in order. The configuration
; keeps *scratch* from being killed.
> (define scratch (buffers:make "*scratch*" ""))
> (buffers:kill! scratch)
#f
> (buffers:live? scratch)
#t
> (define notes (buffers:make "notes" "Buy milk.\n"))
> (buffers:name notes)
"notes"
> (import (fill))
> (buffers:with-buffer notes (set-option-local! fill:column 60))
> (list (buffers:with-buffer notes (fill:column)) (fill:column))
(60 70)
> (buffers:replace! notes 1 1 "Today: ")
#<edit 1>
> (document:text (buffers:document notes))
"Today: Buy milk.\n"
> (buffers:modified? notes)
#t
> (buffers:set-modified! notes #f)
> (buffers:modified? notes)
#f
> (list (buffers:version notes) (buffers:save-stamp notes))
(1 1)
> (import (forms))
> (buffers:kind-draw (buffers:kind 'forms:field))
#<procedure>
> (define form
    (buffers:make "*form*"
      (form:form '()
        (form:row '() (form:label '() "Name: ") (form:field '((name . name)) "") "\n")
        (form:row '() (form:label '() "Notes: ") (form:field '((name . notes)) "") "\n"))))
> (buffers:next-stop form 0)
11
> (buffers:next-stop form 11)
25
> (buffers:define-layer diagnostics (priority 50) (evaporate))
> (buffers:set-spans! (buffers:layer notes diagnostics) 0 18
    (list (list 8 11 '((face . warning) (title . "vague")))) 1)
#t
> (define a (buffers:anchor notes 8))
> (buffers:replace! notes 1 1 "* ")
#<edit 2>
> (buffers:anchor-position a)
10
; The chat example: replies are written with splice!, which asks no
; kind, kept as saved data, and refuse the user's edits; the prompt takes
; them.
> (import (chat))
> (chat:add-reply! "Hello.")
> (chat:add-reply! "How can I help?")
> (document:datums (buffers:document chat:chat))
((chat:transcript () (chat:reply () "Hello.") (chat:reply () "How can I help?") (chat:prompt ())))
> (guard (c [(buffers:refused? c) (condition-message c)])
    (buffers:replace! chat:chat 2 2 "x"))
"the node refuses the edit"
> (buffers:replace! chat:chat 27 27 "Thanks")
#<edit 3>
> (document:text (buffers:document chat:chat))
"Hello.How can I help?Thanks"
; Reloading the chat alone keeps its buffer; reloading buffers closes
; every buffer, and the chat makes its own again from its saved data.
> (import (tuna eval))
> (eval-file "~/.config/tuna/lib/chat.sls")
> (eq? chat:chat (buffers:find "*chat*"))
#t
> (define old-chat chat:chat)
> (eval-file (string-append (getenv "TUNA_LIBRARY") "/buffers.sls"))
> (list (buffers:live? old-chat) (buffers:live? notes) (eq? old-chat chat:chat))
(#f #f #f)
> (document:text (buffers:document chat:chat))
"Hello.How can I help?"
> (map buffers:name (buffers:all))
("*chat*")
