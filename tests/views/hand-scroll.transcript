; A buffer whose point is a list's selected row sets
; views:hand-scroll-moves-point to #f locally: a hand scroll at rest
; places the view and leaves point where it was.
> (define b (buffers:make "rows" (lines 300)))
> (buffers:with-buffer b (set-option-local! views:hand-scroll-moves-point #f))
> (define v (views:make b))
> (report! desktop v 1 0 #f)
> (report! desktop v 151 5 #f)
> (report! desktop v 151 5 #t)
> (list (line-of v (views:top v desktop)) (line-of v (views:point v)))
(151 1)
; Later reports leave point out of view, and the view does not follow it.
> (report! desktop v 151 5 #t (cons "pointVisible" #f))
> (report! desktop v 160 0 #t (cons "pointVisible" #f))
> (list (placement v desktop) (line-of v (views:top v desktop)) (line-of v (views:point v)))
((new position 160) 160 1)
; A report from the leading page that finds point out of view, sent
; without the hand, as when the view's size changes, leaves the view
; where the hand put it.
> (define (connected clients) (list desktop))
> (advice-add! web:clients connected)
> (report! desktop v 160 0 #f (cons "pointVisible" #f) (cons "hand" #f))
> (report! desktop v 160 0 #f (cons "pointVisible" #f) (cons "hand" #f) (cons "fraction" 0.1))
> (advice-remove! web:clients connected)
> (list (list-head (placement v desktop) 2) (line-of v (views:point v)))
((same position) 1)
; C-v, a scroll command, still moves point into what the browser then
; shows.
> (define (answer-page ask client name value)
    `(("report" . (("type" . "scroll") ("view" . ,(views:id v))
                    ("placement" . ,(car (numbers-after (html-of v client) "data-placement=\"")))
                    ("version" . 0) ("slotVersion" . 0) ("top" . (("line" . 178))) ("spacer" . #f) ("fraction" . 0) ("left" . null)
                    ("past" . 0) ("sides" . #()) ("start" . (("line" . 180))) ("end" . (("line" . 195)))
                    ("atStart" . #f) ("atEnd" . #f) ("columns" . 80) ("rows" . 20) ("pointVisible" . #f)
                    ("wanted" . null) ("hand" . #t) ("settled" . #t) ("edge" . "top")
                    ("report" . 500)))))
> (advice-add! web:ask-page answer-page)
> (define (run command) (views:with-view v (as-client desktop (lambda () (commands:run command)))))
> (run views:scroll-up)
> (advice-remove! web:ask-page answer-page)
> (list (line-of v (views:top v desktop)) (line-of v (views:point v)))
(178 180)
; A command that moves point makes the view follow it again.
> (as-client desktop (lambda () (views:set-point! v (line-start v 20))))
> (list-head (placement v desktop) 2)
(new follow)
; At #t, the default, a hand scroll at rest moves point into view.
> (buffers:with-buffer b (set-option-local! views:hand-scroll-moves-point #t))
> (report! desktop v 20 0 #f)
> (report! desktop v 100 0 #f)
> (report! desktop v 100 0 #t)
> (line-of v (views:point v))
102
; Point that leaves the leading page's view by anything but the hand,
; as a resize, is lost: the page says so, and the view follows point, as
; Emacs's redisplay keeps point in view.
> (advice-add! web:clients connected)
> (report! desktop v 100 0 #f (cons "pointVisible" #f) (cons "hand" #f) (cons "lost" #t))
> (advice-remove! web:clients connected)
> (list-head (placement v desktop) 2)
(new follow)
