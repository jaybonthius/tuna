; M-g f reads the buffer's diagnostics grouped by severity, most severe
; first; e SPC narrows to errors. It goes to the one chosen, and M-,
; returns.
> (buffers:with-buffer notes (options:set-local! diagnostics:mode #t))
> (define source (diagnostics:make-source))
> (define (on-line n severity message)
    (diagnostics:make-diagnostic (cons n 0) #f severity message))
> (diagnostics:report! source notes
    (list (on-line 2 (diagnostics:severity warning) "two is vague") (on-line 4 (diagnostics:severity error) "four is wrong")
          (on-line 5 (diagnostics:severity info) "five is fine")))
#t
> (line! 1)
> (define t (start! (lambda () (press! "M-g" "f"))))
> (define s (session))
> (wait-matches s)
> (map (lambda (m) (list (completion:title s m) (completion:text s m))) (match-list s))
(("Errors" "a.txt:4: four is wrong") ("Warnings" "a.txt:2: two is vague") ("Infos" "a.txt:5: five is fine"))
> (type! "e ")
> (wait-matches s)
> (texts s)
("a.txt:4: four is wrong")
> (press! "RET")
> (result t)
> (here)
("a.txt" 4)
> (press! "M-,")
> (here)
("a.txt" 1)
; C-u M-g f reads the project's, from files no buffer visits too.
> (define uses (files:visit (string-append code "/uses.txt")))
> (in-client (lambda () (layout:switch-to-buffer uses)))
> (buffers:with-buffer uses (options:set-local! diagnostics:mode #t))
> (diagnostics:report! source uses (list (diagnostics:make-diagnostic '(2 . 4) #f (diagnostics:severity warning) "average is slow")))
#t
> (diagnostics:report! source (string-append code "/sub/twice.txt") (list (diagnostics:make-diagnostic '(2 . 4) #f (diagnostics:severity error) "total twice")))
#t
> (define t (start! (lambda () (press! "C-u" "M-g" "f"))))
> (define s (session))
> (wait-matches s)
> (texts s)
("twice.txt:2: total twice" "uses.txt:2: average is slow")
> (press! "RET")
> (result t)
> (here)
("twice.txt" 2)
> (press! "M-,")
> (here)
("uses.txt" 1)
> (in-client (lambda () (layout:switch-to-buffer notes)))
; A diagnostic of a buffer another view shows goes there and selects that
; view, recording the place it leaves; the selected view keeps its buffer.
> (define other (in-client (lambda () (layout-split:display-below uses))))
> (in-client (lambda () (layout:switch-to-buffer (files:visit (string-append code "/sub/twice.txt")))))
> (define t (start! (lambda () (press! "C-u" "M-g" "f"))))
> (define s (session))
> (wait-matches s)
> (press! "C-n" "RET")
> (result t)
> (list (eq? (view) other) (here) (buffers:name (views:buffer v)) (car (places)))
(#t ("uses.txt" 2) "twice.txt" ("uses.txt" 1))
; M-s r goes to a line the same way.
> (in-client (lambda () (layout:select! v)))
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "y = average")
> (wait-matches s)
> (press! "RET")
> (result t)
> (list (eq? (view) other) (here) (buffers:name (views:buffer v)))
(#t ("uses.txt" 2) "twice.txt")
> (in-client (lambda () (layout:select! v) (layout:switch-to-buffer notes)))
; M-g f marks the diagnostic's own range, as a diagnostics list's RET does.
> (define four (document:line-start (buffers:document notes) 4))
> (diagnostics:report! source notes (list (diagnostics:make-diagnostic (+ four 1) (+ four 3) (diagnostics:severity error) "ou")))
#t
> (define t (start! (lambda () (press! "M-g" "f"))))
> (wait-matches (session))
> (press! "RET")
> (result t)
> (let ([h (html->string (views:draw (view) #f))])
    (let* ([i (let find ([i 0]) (if (string=? (substring h i (+ i 27)) "data-face=\"pulse.highlight\"") i (find (+ i 1))))]
           [open (let find ([j i]) (if (char=? (string-ref h j) #\>) (+ j 1) (find (+ j 1))))])
      (let loop ([j open] [depth 1] [text '()])
        (cond
          [(= depth 0) (list->string (reverse text))]
          [(and (<= (+ j 7) (string-length h)) (string=? (substring h j (+ j 7)) "</span>")) (loop (+ j 7) (- depth 1) text)]
          [(and (<= (+ j 5) (string-length h)) (string=? (substring h j (+ j 5)) "<span"))
           (loop (let find ([k j]) (if (char=? (string-ref h k) #\>) (+ k 1) (find (+ k 1)))) (+ depth 1) text)]
          [else (loop (+ j 1) depth (cons (string-ref h j) text))]))))
"ou"
> (diagnostics:clear! source)
> (press! "M-g" "f")
! diagnostic-picker:diagnostic: No diagnostics
; M-< in a prompt records nothing: the prompt's buffer is internal, so
; M-, never shows it in an ordinary view.
> (define before (places))
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "abc")
> (press! "M-<")
> (equal? (places) before)
#t
> (press! "C-g")
! &cancelled
> (result t)
(raised #<condition &cancelled>)
