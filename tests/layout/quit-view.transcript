; layout:quit-view undoes what layout:display-buffer did to the selected
; view, while the view still shows the buffer displayed.
> (define (shown)
    (map (lambda (v) (list (views:id v) (buffers:name (views:buffer v)) (eq? v (layout:selected-view))))
         (layout:views)))
> (define notes (buffers:make "notes" "one\ntwo\n"))
> (layout:switch-to-buffer notes)
; A display that made the view's part: quitting deletes the part.
> (define below (layout:display-buffer pager:buffer))
> (layout:select! below)
> (shown)
((1 "notes" #f) (3 "*Pager*" #t))
> (commands:run layout:quit-view)
> (shown)
((1 "notes" #t))
; A display that changed the view's buffer: quitting shows the buffer it
; showed before, at the point it had there. Displaying the same buffer
; again where it is shown keeps that record.
> (views:set-point! (layout:selected-view) 5)
> (define (in-selected b) (let ([v (layout:selected-view)]) (views:set-buffer! v b) v))
> (define mail (buffers:make "mail" "Dear Harpo,\n"))
> (eq? (layout:display-buffer mail in-selected) (layout:selected-view))
#t
> (eq? (layout:display-buffer mail in-selected) (layout:selected-view))
#t
> (commands:run layout:quit-view)
> (list (shown) (views:point (layout:selected-view)))
(((1 "notes" #t)) 5)
; A quit takes its record: a second one finds none.
> (define right (layout:display-buffer (buffers:make "other" "")))
> (shown)
((1 "notes" #t) (4 "other" #f))
> (layout:display-buffer mail in-selected)
#<view 1>
> (commands:run layout:quit-view)
> (shown)
((1 "notes" #t) (4 "other" #f))
> (commands:run layout:quit-view)
> (shown)
((4 "other" #t))
; A record no longer counts once the view shows another buffer.
> (layout:display-buffer mail in-selected)
#<view 4>
> (views:set-buffer! (layout:selected-view) notes)
; With no record and no other view in its level, quitting shows the
; newest buffer that is not internal and that no view shows, else the
; newest that is not internal.
> (commands:run layout:quit-view)
> (shown)
((4 "other" #t))
> (commands:run layout:quit-view)
> (shown)
((4 "mail" #t))
; A buffer killed since the display is not shown again.
> (layout:display-buffer notes in-selected)
#<view 4>
> (buffers:kill! mail)
#t
> (commands:run layout:quit-view)
> (shown)
((4 "other" #t))
> (define (kill-others!)
    (let ([b (views:buffer (layout:selected-view))])
      (for-each (lambda (x) (unless (or (eq? x b) (buffers:internal-name? (buffers:name x))) (buffers:kill! x)))
                (buffers:all))))
> (kill-others!)
> (commands:run layout:quit-view)
! layout:quit-view: no other buffer to show
; A locked part is never deleted.
> (define echo (layout:display-buffer (buffers:make "*Echo*" "")
                 (layout-sides:display-at-side (layout:direction down) 90 'content '((locked . #t)))))
> (layout:select! echo)
> (commands:run layout:quit-view)
! layout:quit-view: a locked part with irritant #<node views:view 5>
> (shown)
((4 "other" #f) (5 "*Echo*" #t))
