; buffers:free-name returns the name while no live buffer has it, else
; the first free NAME<N> from 2.
> (buffers:free-name "*run*")
"*run*"
> (define first (buffers:make "*run*" ""))
> (buffers:free-name "*run*")
"*run*<2>"
> (define second (buffers:make "*run*<2>" ""))
> (buffers:free-name "*run*")
"*run*<3>"
> (buffers:kill! first)
#t
> (buffers:free-name "*run*")
"*run*"
> (buffers:free-name 'run)
! buffers:free-name: not a string with irritant run
