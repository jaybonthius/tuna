; A checker runs when the mode turns on, once the delay has passed since
; the last edit, and after a save; its findings are its source's report.
> (define runs '())
> (define (check-beta b) (set! runs (cons (buffers:name b) runs)) (list (warn b "beta" "checked")))
> (define path (string-append folder "/plain.txt"))
> (with-output-to-file path (lambda () (display "alpha beta\n")) 'replace)
> (define plain (files:visit path))
> (buffers:with-buffer plain (add-local-hook! diagnostics:checkers check-beta))
> (mode! plain #t)
> (wait-until (lambda () (pair? runs)))
> (list runs (all-seen plain) (marks plain))
(("plain.txt") (("beta" warning "checked")) (("beta" (diagnostic.warning) "checked")))
> (set! runs '())
> (buffers:insert! plain 1 "x")
2
> runs
()
> (wait-until (lambda () (pair? runs)))
> (list runs (all-seen plain))
(("plain.txt") (("beta" warning "checked")))
> (set-option! diagnostics:check-delay #f)
> (set! runs '())
> (buffers:insert! plain 1 "y")
2
> (sleep-for 0.2)
> runs
()
> (files:save-buffer plain)
> (wait-until (lambda () (pair? runs)))
> runs
("plain.txt")
; With the mode off its marks are hidden and no checker runs, on an
; edit or a save.
> (set-option! diagnostics:check-delay 0.05)
> (mode! plain #f)
> (set! runs '())
> (buffers:insert! plain 1 "z")
2
> (files:save-buffer plain)
> (sleep-for 0.2)
> (list runs (marks plain) (all-seen plain))
(() () (("beta" warning "checked")))
; A check started while the last of the same checker runs quits the
; last, whose program stops; only the new one reports. checking? holds
; while one runs.
> (define calls 0)
> (define (slow b)
    (set! calls (+ calls 1))
    (let ([n calls])
      (when (= n 1) (processes:run "sleep" '("30")))
      (list (warn b "beta" (format "check ~a" n)))))
> (define q (buffers:make "q" "alpha beta\n"))
> (buffers:with-buffer q (add-local-hook! diagnostics:checkers slow))
> (mode! q #t)
> (wait-until (lambda () (pair? (processes:all))))
> (list (diagnostics:checking? q) (map processes:command-line (processes:all)))
(#t (("sleep" "30")))
> (buffers:with-buffer q (commands:run diagnostics:check))
> (wait-until (lambda () (and (null? (processes:all)) (not (diagnostics:checking? q)))))
> (list (processes:all) (diagnostics:checking? q) (all-seen q) calls)
(() #f (("beta" warning "check 2")) 2)
; Two buffers checked at once each get their own findings, placed by the
; version each check started at.
> (set-option! diagnostics:check-delay #f)
> (define (pausing b)
    (let ([d (warn b "beta" (buffers:name b))])
      (sleep-for 0.2)
      (list d)))
> (define one (buffers:make "one" "alpha beta\n"))
> (define two (buffers:make "two" "beta alpha\n"))
> (for-each (lambda (b) (buffers:with-buffer b (add-local-hook! diagnostics:checkers pausing))) (list one two))
> (mode! one #t)
> (mode! two #t)
> (sleep-for 0.05)
> (list (diagnostics:checking? one) (diagnostics:checking? two))
(#t #t)
> (buffers:insert! one 1 "new ")
5
> (wait-until (lambda () (not (or (diagnostics:checking? one) (diagnostics:checking? two)))))
> (list (all-seen one) (all-seen two))
((("beta" warning "one")) (("beta" warning "two")))
; A checker that raises is reported and not called again in that buffer
; until C-u diagnostics:check; check-failed? says so meanwhile.
> (set-option! diagnostics:check-delay 0.05)
> (define broken-calls 0)
> (define (broken b) (set! broken-calls (+ broken-calls 1)) (error 'broken "no linter installed"))
> (define r (buffers:make "r" "alpha beta\n"))
> (buffers:with-buffer r (add-local-hook! diagnostics:checkers broken))
> (mode! r #t)
> (wait-until (lambda () (diagnostics:check-failed? r)))
! broken: no linter installed
> (buffers:insert! r 1 "x")
2
> (sleep-for 0.2)
> (buffers:with-buffer r (commands:run diagnostics:check))
> (sleep-for 0.1)
> (list broken-calls (diagnostics:check-failed? r))
(1 #t)
> (parameterize ([commands:prefix-argument '(4)]) (buffers:with-buffer r (commands:run diagnostics:check)))
> (wait-until (lambda () (= broken-calls 2)))
! broken: no linter installed
> (list broken-calls (diagnostics:check-failed? r))
(2 #t)
; A checker a mode adds goes with the mode, and its findings with it.
> (define-table sh-keys)
> (define-hook sh-hook)
> (modes:define-major-mode sh-mode (keymap sh-keys) (hook sh-hook))
> (add-hook! sh-hook
    (lambda ()
      (set-option-local! diagnostics:mode #t)
      (add-local-hook! diagnostics:checkers check-beta)))
> (define script (buffers:make "script" "alpha beta\n"))
> (modes:set-major-mode sh-mode script)
> (wait-until (lambda () (pair? (diagnostics:in script))))
> (all-seen script)
(("beta" warning "checked"))
> (modes:set-major-mode modes:fundamental script)
> (all-seen script)
()
; A checker's findings go when its module unloads.
> (define bad (buffers:make "bad" "a bad word\n"))
> (mode! bad #t)
> (import (linter))
> (buffers:with-buffer bad (commands:run diagnostics:check))
> (wait-until (lambda () (pair? (diagnostics:in bad))))
> (all-seen bad)
(("bad" error "bad word"))
> (unload-module! '(linter))
> (all-seen bad)
()
