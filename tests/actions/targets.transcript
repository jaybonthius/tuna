; Each finder's target is offered in depth order; one whose bounds an
; earlier target has is dropped, but the region hides nothing: a region
; over exactly a list keeps the list.
> (define (test-target view) (completion:make-target 'test 'tested "tested" #f #f))
> (define (same-bounds view)
    (let-values ([(start end) (syntax:symbol-bounds (views:buffer view) (views:point view))])
      (and start (completion:make-target 'test 'same "same" start end))))
> (add-hook! completion:target-finders test-target -20)
> (add-hook! completion:target-finders same-bounds 25)
> (define paths (show! (buffers:make "paths" "see src/notes.txt and https://tuna.example/a\n")))
> (at! paths "notes" 0)
> (define (prompts . count)
    (let ([a (act! "C-.")])
      (let loop ([n (car count)] [acc '()])
        (if (= n 0)
            (begin (press! "C-g") (result a) (reverse acc))
            (let ([p (keys:reading-prompt client)])
              (press! "C-.")
              (testing:wait-until (lambda () (keys:reading client)))
              (loop (- n 1) (cons p acc)))))))
> (prompts 4)
! &quit
