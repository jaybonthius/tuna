; A lower cap drops entries at the next push.
> (set-option! kill-ring:max 3)
> (length (kill-ring:entries))
120
> (kill-ring:push! (list "x"))
> (kill-ring:entries)
(("x") ("129") ("128"))
> (kill-ring:rotate! 3)
("x")
; With a cap of 0 the ring keeps nothing, and after-push still gets each
; entry, so a clipboard still copies it.
> (set-option! kill-ring:max 0)
> (set! pushed '())
> (kill-ring:push! (list "gone"))
> (list (kill-ring:entries) (kill-ring:current) (take-pushed!))
(() #f ("gone"))
> (kill-ring:append! (list "also"))
> (list (kill-ring:entries) (take-pushed!))
(() ("also"))
> (remove-option! kill-ring:max)
> (kill-ring:max)
120
; Duplicates are compared by text, so a piece with a string's text is
; one; the option off pushes them again.
> (set-option! kill-ring:skip-duplicates #t)
> (define b (buffers:make "b" "Hello world\n"))
> (kill-ring:push! (list "Hello"))
> (kill-ring:rotate! 1)
("Hello")
> (kill-ring:push! (list (kill-ring:piece b 1 6)))
> (list (kill-ring:current) (length (kill-ring:entries)) (take-pushed!))
(("Hello") 1 ("Hello" "Hello"))
> (kill-ring:push! (list "Hello" "x"))
> (kill-ring:push! (list "Hello\nx"))
> (list (length (kill-ring:entries)) (kill-ring:current))
(2 ("Hello" "x"))
> (set-option! kill-ring:skip-duplicates #f)
> (kill-ring:push! (list "Hello" "x"))
> (list (length (kill-ring:entries)) (kill-ring:current))
(3 ("Hello" "x"))
> (take-pushed!)
("Hello\nx" "Hello\nx" "Hello\nx")
; append! and prepend! join piece by piece onto the newest entry and
; point at it; with another number of pieces they push.
> (kill-ring:push! (list "ab"))
> (kill-ring:push! (list "cd" "12"))
> (kill-ring:rotate! 1)
("ab")
> (kill-ring:append! (list "ef" "34"))
> (list (kill-ring:current) (list-head (kill-ring:entries) 2))
(("cdef" "1234") (("cdef" "1234") ("ab")))
> (kill-ring:prepend! (list "<" ">"))
> (kill-ring:current)
("<cdef" ">1234")
> (kill-ring:append! (list "single"))
> (list-head (kill-ring:entries) 3)
(("single") ("<cdef" ">1234") ("ab"))
> (kill-ring:prepend! (list "one "))
> (list-head (kill-ring:entries) 3)
(("one single") ("<cdef" ">1234") ("ab"))
> (take-pushed!)
("ab" "cd\n12" "cdef\n1234" "<cdef\n>1234" "single" "one single")
> (kill-ring:text (kill-ring:current))
"one single"
