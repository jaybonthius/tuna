<div class="layout-root"><div class="layout-main"><div class="split row"><div class="split-child" style="flex:1.0 1 0"><div class="layout-view selected"><div class="view" data-view="1" data-placement="*" data-place-line="2" data-place-align="center" data-place-offset="0" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end style="white-space:pre-wrap"><div class="view-lines"><div class="line" id="v1-1" data-line="1">one</div><div class="line" id="v1-2" data-line="2"><span class="cursor primary"></span>two</div><div class="line" id="v1-3" data-line="3"><br></div></div></div></div></div><div class="split-child" style="flex:1.0 1 0"><div class="layout-view"><div class="view" data-view="6" data-placement="*" data-place-line="1" data-place-align="top" data-place-offset="0" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end style="white-space:pre-wrap"><div class="view-lines"><div class="line" id="v6-1" data-line="1"><span class="cursor primary"></span><br></div></div></div></div></div></div></div><div class="layout-bar"><div class="layout-view"><div class="view" data-view="5" data-placement="*" data-place-line="1" data-place-align="top" data-place-offset="0" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end style="white-space:pre-wrap"><div class="view-lines"><div class="line" id="v5-1" data-line="1"><span class="cursor primary"></span><br></div></div></div></div></div></div>
; Balancing leaves a locked split and its children as they are.
> (define seventh (views:make notes))
> (set-parts! (layout-split:container '((direction . row)) (atom (views:find 1) '(weight . 2)) (layout-split:container '((direction . column) (weight . 3) (locked . #t)) (atom (views:find 6) '(weight . 2)) (atom seventh))) (atom echo '(pinned . #t) '(locked . #t)))
> (commands:run layout-split:balance)
> (tree)
(layout:root () (layout-split:container ((direction . row)) #(views:view ((view . 1) (buffer . "notes") (weight . 1))) (layout-split:container ((direction . column) (weight . 3) (locked . #t)) #(views:view ((view . 6) (buffer . "newer") (weight . 2))) #(views:view ((view . 7) (buffer . "notes"))))) #(views:view ((view . 5) (buffer . "*Echo*") (pinned . #t) (locked . #t))))
; A split that collapses gives its pinned attribute to the child taking
; its place, so the child stays beside a zoomed view.
> (set-parts! (layout-split:container '((direction . row)) (atom (views:find 1)) (layout-split:container '((direction . column) (pinned . #t)) (atom (views:find 6)) (atom seventh))) (atom echo '(pinned . #t) '(locked . #t)))
> (layout:delete-part! (layout:view-node (views:find 6)))
> (tree)
(layout:root () (layout-split:container ((direction . row)) #(views:view ((view . 1) (buffer . "notes"))) #(views:view ((view . 7) (buffer . "notes") (pinned . #t)))) #(views:view ((view . 5) (buffer . "*Echo*") (pinned . #t) (locked . #t))))
> (layout:select! (views:find 1))
