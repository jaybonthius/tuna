> (buffers:kill! (buffers:find "*Messages*"))
> (define late? #t)
> (advice-add! batch-ended (lambda (ended) (ended) (when late? (set! late? #f) (echo-area:message! "Late"))))
> (list (messages) (buffers:with-buffer (buffers:find "*Messages*") (undo:limit)))
