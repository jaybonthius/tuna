> (remove-hook! minibuffer:prompt-ended count-end)
; A storm of quits while prompts start and end: the buffer stays well
; formed and no prompt is left behind.
> (define stop #f)
> (define askers
    (map (lambda (i)
           (spawn-task
             (lambda ()
               (let loop ([n 0])
                 (unless (or stop (= n 200))
                   (guard (c [#t #f])
                     (in-client (lambda () (minibuffer:read "Storm: "))))
                   (loop (+ n 1)))))))
         (iota 3)))
> (define quitter
    (spawn-task
      (lambda ()
        (let loop ([n 0])
          (unless (= n 300)
            (for-each (lambda (t) (signal-task t (make-message-condition "q"))) askers)
            (sleep-for 0.001)
            (loop (+ n 1)))))))
> (wait-until (lambda () (task-done? quitter)))
> (set! stop #t)
> (for-each (lambda (t) (signal-task t (make-message-condition "q"))) askers)
> (wait-until (lambda () (for-all task-done? askers)))
> (for-all task-done? askers)
#t
