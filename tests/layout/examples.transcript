; The documented examples of layout and layout-split, in order. Tabs is not
; loaded, so its container is a split here and the frame example runs a
; split command instead of tabs:new-tab.
> (list (eq? (layout:display-action) layout-split:display-right) (map cdr (table-entries layout:display-rules)))
(#t (#<procedure>))
> (define client (web:add-client! 1))
> (set-parts!
    '(layout-split:container ((direction . row))
       #(views:view ((view . 1) (buffer . "notes.org")))
       (layout-split:container ((weight . 2) (direction . column))
         #(views:view ((view . 2) (buffer . "*scratch*")))
         #(views:view ((view . 3) (buffer . "init.ss")))))
    '#(views:view ((view . 4) (buffer . "*Echo*") (pinned . #t) (locked . #t))))
> (tree)
(layout:root () (layout-split:container ((direction . row)) #(views:view ((view . 1) (buffer . "notes.org"))) (layout-split:container ((weight . 2) (direction . column)) #(views:view ((view . 2) (buffer . "*scratch*"))) #(views:view ((view . 3) (buffer . "init.ss"))))) #(views:view ((view . 4) (buffer . "*Echo*") (pinned . #t) (locked . #t))))
> (layout:call-with-frame (layout:frame client)
    (lambda () (commands:run layout-split:split-below)))
> (tree)
(layout:root () (layout-split:container ((direction . row)) (layout-split:container ((direction . column)) #(views:view ((view . 1) (buffer . "notes.org"))) #(views:view ((view . 5) (buffer . "*Help*")))) (layout-split:container ((weight . 2) (direction . column)) #(views:view ((view . 2) (buffer . "*scratch*"))) #(views:view ((view . 3) (buffer . "init.ss"))))) #(views:view ((view . 4) (buffer . "*Echo*") (pinned . #t) (locked . #t))))
> (layout:neighbour (layout:selected-view) (layout:direction left))
#f
> (views:id (layout:neighbour (layout:selected-view) (layout:direction right)))
2
> (layout:select! (layout:display-buffer help:buffer))
> (buffers:name (views:buffer (layout:selected-view)))
"*Help*"
> (define (compilation-buffer? buffer)
    (string=? (buffers:name buffer) "*compilation*"))
> (table-set! layout:display-rules compilation-buffer? layout-split:display-below)
> (set-parts!
    '(layout-split:container ((direction . column))
       #(views:view ((view . 1) (buffer . "notes.org") (weight . 2)))
       #(views:view ((view . 2) (buffer . "*scratch*")))))
> (tree)
(layout:root () (layout-split:container ((direction . column)) #(views:view ((view . 1) (buffer . "notes.org") (weight . 2))) #(views:view ((view . 2) (buffer . "*scratch*")))))
> (views:id (layout-split:split-view! (layout:selected-view) (layout-split:direction column)))
6
> (tree)
(layout:root () (layout-split:container ((direction . column)) #(views:view ((view . 1) (buffer . "notes.org") (weight . 1))) #(views:view ((view . 6) (buffer . "*Help*") (weight . 1))) #(views:view ((view . 2) (buffer . "*scratch*")))))
