> (define (library-file name) (string-append (getenv "TUNA_LIBRARY") "/" name))
> (define (ui-request id method . fields) (append `(("type" . "extension_ui_request") ("id" . ,id) ("method" . ,method)) fields))
> (define chat (pi:start (getenv "HOME")))
> (define f (fake-of chat))
> (define process (pi:chat-process chat))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (run-turn! f "u1" "a1" "Hi" '("Hello"))
> (testing:wait-until (lambda () (equal? (map pi:item-entry-id (pi:chat-transcript chat)) '("u1" "a1"))))
; What Pi says only once: questions, statuses, widgets and the queue.
; A question answered before the reload must not come back from the log.
> (say! f (ui-request "d1" "select" '("title" . "Allow?") '("options" . #("Yes" "No")))
        (ui-request "d2" "input" '("title" . "Name"))
        (ui-request "s1" "setStatus" '("statusKey" . "pool") '("statusText" . "1 pool(s)"))
        (ui-request "w1" "setWidget" '("widgetKey" . "plan") '("widgetLines" . #("Step 1")))
        (event "queue_update" '("steering" . #("steer me")) '("followUp" . #()))
        (ui-request "n1" "notify" '("message" . "Once"))
        (ui-request "e1" "set_editor_text" '("text" . "typed by an extension")))
> (testing:wait-until (lambda () (= 2 (length (pi:chat-dialogs chat)))))
> (pi:answer! chat (cadr (pi:chat-dialogs chat)) "Harpo")
; A reply being written, and a request of this load left unanswered.
> (say! f (event "agent_start") (event "message_start" (cons "message" (assistant-message "pending")))
        (update '(("type" . "text_start") ("contentIndex" . 0)))
        (update '(("type" . "text_delta") ("contentIndex" . 0) ("delta" . "Work"))))
> (answer! f "get_last_assistant_text" (lambda (f r) #f))
> (define t (start! (lambda () (pi:last-reply chat))))
> (define old-request (wait-held f "get_last_assistant_text"))
> (testing:wait-until (lambda () (= 4 (length (pi:chat-transcript chat)))))
> (list (length editor-texts) (length (filter pi:notice? (pi:chat-transcript chat))))
(1 1)
; Reloading pi: Pi keeps working, and pi follows it again from what it
; saved, Pi's answers and the output still in the log.
> (reload-modules! '((pi)))
! pi:last-reply: pi was unloaded
> (result t)
(refused "pi was unloaded")
> (define chat (car (pi:chats)))
> (eq? (pi:chat-process chat) process)
#t
> (testing:wait-until (lambda () (= 2 (length (filter pi:item-entry-id (pi:chat-transcript chat))))))
> (transcript chat)
((user 0 "u1" "Hi") (reply 1 "a1" stop ((text "Hello"))) (reply 2 #f pending ((text "Work"))))
> (map pi:dialog-title (pi:chat-dialogs chat))
("Allow?")
> (list (pi:chat-statuses chat) (map pi:widget-key (pi:chat-widgets chat)) (call-with-values (lambda () (pi:chat-queue chat)) list))
((("pool" . "1 pool(s)")) ("plan") (("steer me") ()))
; A notify and an editor text from before the reload act once only; the
; answer to a request of the earlier load is ignored.
> (length editor-texts)
1
> (respond! f old-request '(("text" . "late")))
> (say! f (update '(("type" . "text_delta") ("contentIndex" . 0) ("delta" . "ing"))))
> (testing:wait-until (lambda () (equal? (list-ref (transcript chat) 2) '(reply 2 #f pending ((text "Working"))))))
> (transcript chat)
((user 0 "u1" "Hi") (reply 1 "a1" stop ((text "Hello"))) (reply 2 #f pending ((text "Working"))))
