; Where point is: line and column within a node, the line alone unless
; views:column-number is on, as Emacs's column-number-mode.
> (import (md))
> (define v (views:make (buffers:make "lines" "abc\ndef\n")))
> (views:set-point! v 6)
> (define (root-of v) (document:token (buffers:document (views:buffer v)) 0))
> (views:describe-line (root-of v) v)
"L2"
> (views:with-view v (views:describe-at-point v))
"L2"
> (options:set! views:column-number #t)
> (views:describe-line (root-of v) v)
"2:1"
; Within a node, its own lines and columns count, from the node's start.
> (define page (buffers:make "page" (md:doc '() (md:para '() "one\n") (md:para '() "two\nthree\n"))))
> (define w (views:make page))
> (views:set-point! w 13)
> (views:describe-line (document:enclosing (buffers:document page) 13) w)
"2:1"
> (views:describe-line (root-of w) w)
"3:1"
; The kind at point describes it: the atom right after point, else the
; innermost node holding point whose kind has an entry, else the root's
; line and column.
> (tables:set! views:position-describers md:para (lambda (node view) (format "para at ~a" (document:node-start node))))
> (tables:set! views:position-describers md:image (lambda (node view) "an image"))
> (views:describe-at-point w)
"para at 7"
> (define pictures (buffers:make "pictures" (md:doc '() (md:heading '() "a\n") (md:image '()) (md:image '()) (md:heading '() "b\n"))))
> (define x (views:make pictures))
> (views:set-point! x 4)
> (views:describe-at-point x)
"an image"
> (views:set-point! x 2)
> (views:describe-at-point x)
"1:0"
; A describer's #f shows nothing, and a key that is no kind's constructor
; is left out.
> (tables:set! views:position-describers md:doc (lambda (node view) #f))
> (tables:set! views:position-describers (lambda (attributes) 'md:heading) (lambda (node view) "never"))
> (views:describe-at-point x)
#f
> (tables:remove! views:position-describers md:doc)
; The option is read in the view, so a buffer's local value applies.
> (views:with-view x ((views:position-description) x))
"1:0"
> (buffers:with-buffer pictures (options:set-local! views:position-description (lambda (view) "page 1 of 1")))
> (views:with-view x ((views:position-description) x))
"page 1 of 1"
> (buffers:with-buffer pictures (options:set-local! views:position-description #f))
> (views:with-view x (views:position-description))
#f
; A view with no buffer describes nothing.
> (define holder (buffers:make "holder" (md:doc '() (views:view '((buffer . "nowhere"))))))
> (define empty (views:atom-view (document:token (buffers:document holder) 1)))
> (views:describe-at-point empty)
#f
> (views:describe-line (root-of v) 'v)
! views:describe-line: not a view with irritant v
; A cursor right before an item standing alone is drawn on the item, as
; an outline of its element; a cursor before an atom that draws no
; element stays a bar.
> (views:set-point! x 4)
