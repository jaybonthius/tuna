; The configuration's settings. By default sources try prefix, then
; partial, as Emacs's basic and partial-completion, but buffers and
; commands try prefix, then substring, and locations and lines substring.
; The configuration sets the styles, which puts those defaults aside.
; Files try partial before them.
> (equal? (option-default completion:styles) (list completion:prefix completion:partial))
#t
> (equal? (completion:styles) (list completion:any-order))
#t
> (define (entries t) (map (lambda (e) (cons (car e) (map (lambda (style) (style "a b")) (cdr e)))) (table-entries t)))
> (entries completion:category-default-styles)
((completion:buffer-category ((starts "a b")) ((contains "a b"))) (completion:location-category ((contains "a b"))) (completion:command-category ((starts "a b")) ((contains "a b"))) (line-picker:line-category ((contains "a b"))))
> (entries completion:category-styles)
((completion:file-category ((starts "a" " b"))))
> (completion-list:rows)
15
; completion:read, with a history.
> (define-saved fruit-history '() list?)
> (define t (start! (lambda ()
    (completion:read "Fruit: "
      (list (completion:source (candidates (vector "apple" "banana" (cons "cherry" 'stone)))))
      fruit-history))))
> (texts (session))
("apple" "banana" "cherry")
> (type! "rr")
> (press! "RET")
> (result t)
stone
> (fruit-history)
("cherry")
; A category is its exported name.
> words:word-category
words:word-category
; project.sls: candidates a job streams.
> (jobs:define-worker (project-files root emit)
    (let walk ([dir root])
      (let*-values ([(paths) (map (lambda (name) (string-append dir "/" name))
                                  (remp (lambda (name) (char=? (string-ref name 0) #\.)) (directory-list dir)))]
                    [(dirs files) (partition (lambda (path)
                                               (and (not (file-symbolic-link? path)) (file-directory? path)))
                                             paths)])
        (emit (list->vector files))
        (for-each walk dirs))))
> (define t (start! (lambda ()
    (completion:read "Find file in project: "
      (list (completion:source (job project-files (string-append (getenv "HOME") "/notes")) (category completion:file-category)))))))
> (define s (session))
> (wait-matches s)
> (map (lambda (path) (substring path (string-length (getenv "HOME")) (string-length path))) (list-sort string<? (texts s)))
("/notes/a.txt" "/notes/sub/b.sls")
> (press! "C-g")
! &quit
; The examples of the styles.
> (completion:prefix "fi")
((starts "fi"))
> (completion:flex "fnd")
((contains "f" "n" "d"))
> (completion:any-order "buf ^find !x")
((face completion.match-0 (contains "buf")) (face completion.match-1 (starts "find")) (not (contains "x")))
; completion:start over a field that is no prompt.
> (define tags (buffers:make "*tags*" "lisp"))
> (define tags-view (views:make tags))
> (define tags-source (completion:source (candidates (vector "lisp" "list" "listen" "scheme"))))
> (define saved-tag #f)
> (define (save-tag! tag) (set! saved-tag tag))
> (define (field-start field) 1)
> (define (field-end field) (- (document:length (buffers:document field)) 1))
> (define field tags)
> (define tag-session
    (completion:start tags-view (list tags-source)
      (lambda () (values (field-start field) (field-end field)))
      (lambda (session match) (when match (save-tag! (completion:value session match))))
      'none))
> (texts tag-session)
("lisp")
> (completion:selected tag-session)
#f
> (buffers:replace! tags 4 5 "t")
#<edit 1>
> (completion:input-changed! tag-session)
> (texts tag-session)
("list" "listen")
> (completion:select! tag-session (completion:matches-ref (completion:session-matches tag-session) 1))
> (views:call-with-view tags-view completion:exit)
> saved-tag
"listen"
> (text tags)
"listen"
> (completion:end! tag-session)
> (completion:end! tag-session)
; words.sls: completing at point; completion-annotations' configuration
; annotates words with their length.
> (define notes (buffers:make "notes" "define-record buffers:insert! buffer-words\n"))
> (views:set-buffer! (view) notes)
> (press! "M->")
> (type! "buf")
> (press! "C-M-i")
> (rows (session))
(("buf" "3") ("buffer-words" "12") ("buffers:insert!" "15"))
> (press! "C-n" "C-n")
> (selected-text (session))
"buffer-words"
> (press! "RET")
> (text notes)
"define-record buffers:insert! buffer-words\nbuffer-words"
> (session)
#f
; completion-popup's configuration: Python buffers complete by themselves
; after 0.1 seconds.
> (define code (buffers:make "code.py" "buffer_size = 1\n"))
> (modes:set-major-mode python:mode code)
> (views:set-buffer! (view) code)
> (press! "M->")
> (type! "buf")
> (sleep-for 0.3)
> (texts (session))
("buf" "buffer")
> (popups)
((" *Completion-popup-2*" (columns 15) (lines 2)))
> (press! "C-g")
> (session)
#f
> (popups)
()
