; Reloading during a read quits it; the part and the buffer come back.
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "abc")
> (unload-module! '(minibuffer))
! &quit
> (result t)
(raised #<condition &quit>)
> (buffers:find " *Minibuf*")
#f
> (datums layout:buffer)
((layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 1) (buffer . "*scratch*")))) #(views:view ((view . 3) (buffer . " *Echo Area*") (depth . 90) (size . content) (locked . #t))))))
> (views:buffer (view))
#<buffer *scratch*>
; ask's readers go with the minibuffer and come back with it.
> (ask:line "Name: ")
! ask:line-reader: no reader is loaded
> (use-plugin minibuffer)
> (eq? (ask:line-reader) (option-default ask:line-reader))
#f
> (eq? (ask:number-reader) minibuffer:read-number)
#t
> (datums layout:buffer)
((layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 1) (buffer . "*scratch*")))) #(views:view ((view . 3) (buffer . " *Echo Area*") (depth . 90) (size . content) (locked . #t))) #(views:view ((view . 5) (buffer . " *Minibuf*") (depth . 100) (size . content) (locked . #t))))))
> (define minibuf (buffers:find " *Minibuf*"))
> (datums minibuf)
((minibuffer:%prompts ()))
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "x")
> (press! "RET")
> (result t)
"x"
> (minibuffer:history)
("x")
; Unloading undo leaves the minibuffer, which does not import it.
> (unload-module! '(undo))
> (eq? (buffers:find " *Minibuf*") minibuf)
#t
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (press! "RET")
> (result t)
""
> (use-plugin undo)
