; A module under lib/ goes after the modules outside lib/, unless one of
; them imports it: then it goes before its importer.
> (import (groucho words))
> (spell:language)
"groucho"
> (import (prog2))
> (spell:language)
"prog2"
> (definition-changes spell:language)
((#<owner (prog2) 1> override #f) (#<owner (groucho words) 1> override #f) (#<owner (spell) 1> define #f))
