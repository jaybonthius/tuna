; starts with its plugin's name.
> (set-option! completion:styles (list completion:prefix completion:partial))
> (define t (start! (lambda () (press! "M-x"))))
> (type! "forward-char")
> (texts (session))
("editing:forward-char")
> (press! "C-g")
! &quit
