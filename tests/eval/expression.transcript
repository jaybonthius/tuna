; M-: reads one expression at the prompt Eval: at the bottom, evaluates
; it as (repl), and shows its value in the echo area and the log. Text,
; point, views and the selection stay; the history gains the input.
> (define notes (show! (buffers:make "notes" "alpha\n")))
> (at! notes "alpha" 5)
> (define before (list (layout:views) (view)))
> (define t (start! "M-:"))
> (list (prompt-text) (eq? (views:buffer (view)) notes))
("Eval: \n" #f)
> (type! "(+ 1 2)")
> (press! "RET")
> (finish t)
#t
> (list (prompt) (message) (log-tail 1) (point-text) (equal? before (list (layout:views) (view))) (eval:expression-history))
(#f "3" ("3") "alpha-!-\n" #t ("(+ 1 2)"))
; A string is written with its quotes.
> (eval! "\"hi\"")
#t
> (message)
"\"hi\""
; Lists and vectors are shortened to eval:print-length elements and
; eval:print-level levels, 12 and 4, as Chez prints them; strings never
; are.
> (eval! "(make-list 30 'a)")
#t
> (message)
"(a a a a a a a a a a a a ...)"
> (eval! "'(1 (2 (3 (4 (5)))))")
#t
> (message)
"(1 (2 (3 (4 (...)))))"
> (eval! "'#(1 #(2 #(3 #(4 #(5)))))")
#t
> (message)
"#(1 #(2 #(3 #(4 #(...)))))"
> (eval! "(make-string 300 #\\x)")
#t
> (string-length (message))
302
; With C-u, or any prefix but -, the value is inserted at point, in full,
; as one edit, and point goes after it; the echo area and the log are
; left as they were.
> (define logged (messages))
> (eval! "(+ 1 2)" "C-u")
#t
> (list (point-text) (message) (string=? logged (messages)))
("alpha3-!-\n" #f #t)
> (press! "C-/")
> (point-text)
"alpha-!-\n"
> (eval! "(make-list 30 'a)" "C-u")
#t
> (point-text)
"alpha(a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a)-!-\n"
> (press! "C-/")
> (eval! "(+ 1 2)" "M-5")
#t
> (point-text)
"alpha3-!-\n"
> (press! "C-/")
> (eval! "(+ 1 2)" "M--")
#t
> (list (message) (point-text))
("3" "alpha-!-\n")
; What the expression writes and the messages it shows are logged in the
; order they come; the screen shows the last.
> (eval! "(begin (display \"out\") (echo-area:message! \"msg\") 42)")
#t
> (list (message) (log-tail 3))
("42" ("out" "msg" "42"))
; Writes after the last message join one message, and the value follows
; them with nothing between.
> (eval! "(begin (display \"out\") 7)")
#t
> (list (message) (log-tail 2))
("out7" ("42" "out7"))
; The key that starts the next M-: ends the printed message, so two equal
; prints show and log twice; a later message ends the second, which
; then counts as a repeat.
> (eval! "(begin (display \"a\") (void))")
#t
> (message)
"a"
> (eval! "(begin (display \"a\") (void))")
#t
> (list (message) (log-tail 2))
("a" ("a" "a"))
> (echo-area:message! "m")
> (log-tail 2)
("a [2 times]" "m")
; An error is reported: the echo area shows its message in the error
; face, the log its who too. No window opens, and the history keeps the
; input.
> (define views-before (layout:views))
> (eval! "(car 1)")
! car: 1 is not a pair
#t
> (list (message) (echo-area:current-face) (log-tail 1) (equal? views-before (layout:views)) (car (eval:expression-history)))
("1 is not a pair" error ("car: 1 is not a pair") #t "(car 1)")
; What was written before the error is logged before the report.
> (eval! "(begin (display \"before\") (car 1))")
! car: 1 is not a pair
#t
> (list (message) (log-tail 2))
("1 is not a pair" ("before" "car: 1 is not a pair"))
; A definition shows the name it defines, and defines it as (repl); with
; C-u the name is inserted.
> (eval! "(define x 1)")
#t
> (list (message) x)
("x" 1)
> (eval! "(define x 2)" "C-u")
#t
> (list (point-text) x)
("alphax-!-\n" 2)
> (press! "C-/")
; A quit key stops a running evaluation; nothing is inserted.
> (define t (start! "C-u" "M-:"))
> (type! "(let loop () (loop))")
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (begin (fork-task (lambda (restore) (chez:sleep (make-time 'time-duration 300000000 0)) (testing:request-quit!))) (void))
> (press! "RET")
! &cancelled
> (finish t)
#t
> (press! "C-g")
> (list (message) (point-text))
("Quit" "alpha-!-\n")
; The current input port is empty while it runs, so a read sees the end
; of file at once.
> (eval! "(read)")
#t
> (message)
"#!eof"
; Several values show one per line; void is left out, and with no value
; and no output the echo area says so.
> (eval! "(values 1 \"two\" (void))")
#t
> (message)
"1\n\"two\""
> (eval! "(void)")
#t
> (message)
"No value"
> (eval! "(values)")
#t
> (message)
"No value"
; A cyclic value is written with labels.
> (eval! "(let ([x (list 1 2)]) (set-cdr! (cdr x) x) x)")
#t
> (message)
"#0=(1 2 . #0#)"
; With eval:print-length #f, lists are written whole.
> (options:set! eval:print-length #f)
> (eval! "(make-list 30 'a)")
#t
> (message)
"(a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a)"
; A large value is written whole, as one message and one log line.
> (eval! "(iota 100000)")
#t
> (let ([m (message)]) (list (string-length m) (substring m 0 6) (substring m (- (string-length m) 6) (string-length m))))
(588891 "(0 1 2" "99999)")
> (string-length (car (log-tail 1)))
588891
> (options:set! eval:print-length 12)
; Each result is logged; an equal one counts on the last line.
> (eval! "(+ 1 2)")
#t
> (eval! "(+ 1 2)")
#t
> (press! "C-a")
> (log-tail 1)
("3 [2 times]")
; A form is a definition when its head, after any plugin's prefix, is
; define or starts with define-, and its values are only void; the name
; is the second element or the first symbol inside it.
> (eval! "(define (greeting n) n)")
#t
> (message)
"greeting"
> (eval! "(define-record-type (point make-point point?) (fields x))")
#t
> (message)
"point"
> (eval! "(commands:define-command (say-hello) \"Says hello.\" (echo-area:message! \"Hello\"))")
#t
> (message)
"say-hello"
> (eval! "(begin (define y 1) 5)")
#t
> (message)
"5"
; M-: evaluates as (repl) in a module's file too, where the module's
; names have their prefix.
> (import (greet))
> (define greet-file (files:visit (at ".config/tuna/lib/greet.sls")))
> (begin (show! greet-file) (void))
> (eval! "(text \"a\")")
! variable text is not bound
#t
> (message)
"variable text is not bound"
> (eval! "(greet:text \"a\")")
#t
> (message)
"\"Hello, a!\""
