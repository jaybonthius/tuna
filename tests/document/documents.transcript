; A document written as data, read, sliced and edited.
> (define doc
    (document:from-datum
      '(chat:reply ()
         (md:para () "See " (md:link ((href . "https://scheme.com")) "TSPL") ".\n")
         #(md:image ((src . "plot.png"))))))
> (document:length doc)
17
> (document:datums (document:from-utf8 #vu8(99 97 102 233)))
("caf" #(document:raw-byte ((byte . 233))))
> (document:token doc 0)
#<node chat:reply 0>
> (document:token doc 2)
#\S
> (document:text doc)
"See TSPL.\n￼"
> (document:offset doc 7 (document:unit characters))
4
> (document:for-each-child (document:token doc 1) 0 16
    (lambda (child at) (write (list at child))))
(2 "See ")(6 #<node md:link 6>)(12 ".\n")
> (define s (document:slice doc 9 16))
> (list (document:open-start s) (document:open-end s))
(2 0)
> (document:datums s)
((md:para () (md:link ((href . "https://scheme.com")) "PL") ".\n") #(md:image ((src . "plot.png"))))
> (document:text (document:replace doc 2 2 (document:from-datum "Do ")))
"Do See TSPL.\n￼"
