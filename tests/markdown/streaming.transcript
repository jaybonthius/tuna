(((markdown:paragraph ((key . 0)) "Para\n")) ((markdown:paragraph ((key . 0)) "Para\n")) ((markdown:paragraph ((key . 0)) "Para\n")) ((markdown:paragraph ((key . 0)) "Para\n")) ((markdown:paragraph ((key . 0)) "Para\n")))
> (markdown:unfinished-blocks "- item\n  -")
((markdown:list ((key . 0) (ordered . #f) (tight . #t)) (markdown:item ((key . 0)) (markdown:paragraph ((key . 0)) "item\n"))))
> (markdown:unfinished-blocks "> Para\n> -")
((markdown:quote ((key . 0)) (markdown:paragraph ((key . 0)) "Para\n")))
> (markdown:unfinished-blocks "Para\n---")
((markdown:heading ((key . 0) (level . 2)) "Para\n"))
> (markdown:unfinished-blocks "-")
((markdown:list ((key . 0) (ordered . #f) (tight . #t)) (markdown:item ((key . 0)))))
; Text that ended its paragraph with a blank line, and code, stay as
; written; markers that open nothing stay too.
