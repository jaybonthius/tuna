((markdown:list ((key . 0) (ordered . #f) (tight . #t)) (markdown:item ((key . 0)) (markdown:paragraph ((key . 0)) "a\n") (markdown:code-block ((key . 1) (language . "")) "*x\n"))))
> (markdown:unfinished-blocks "5 * 3 = snake_case_name")
((markdown:paragraph ((key . 0)) "5 * 3 = snake_case_name\n"))
> (markdown:unfinished-blocks "a\\*b *c")
((markdown:paragraph ((key . 0)) "a*b " (markdown:emphasis () "c") "\n"))
