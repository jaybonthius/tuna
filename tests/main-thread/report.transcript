; After a warning, the code that raised it continues.
> (begin (warning 'careful "watch out") 'went-on)
! careful: watch out
went-on
; A condition without a message is reported on one line.
> (raise-continuable (make-warning))
! &warning
> (raise (condition (make-who-condition 'here) (make-irritants-condition '(1 2))))
! here: with irritants (1 2)
; After an error, a posted thunk ends and the main thread goes on.
> (post! (lambda () (display "before ") (car '()) (display "never")))
before 
! car: () is not a pair
> (+ 1 2)
3
; A posted thunk runs on behalf of the module that posted it.
> (import (waiter))
> (define posted-by #f)
> (as-module '(waiter) (post! (lambda () (set! posted-by (current-owner)))))
> posted-by
(waiter)
; report receives a condition no handler takes before the stack unwinds.
> (define where (make-thread-parameter 'outside))
> (define (show-where report c) (display (where)) (newline) (report c))
> (advice-add! report show-where)
> (parameterize ([where 'inside]) (car 1))
inside
! car: 1 is not a pair
> (advice-remove! report show-where)
; A raise on another thread reaches report on the main thread and ends
; that thread; after a warning the thread goes on.
> (define finished? #f)
> (thread-join (fork-thread (lambda () (car 5) (set! finished? #t))))
! car: 5 is not a pair
> finished?
#f
> (thread-join (fork-thread (lambda () (warning 'thread "careful") (set! finished? #t))))
! thread: careful
> finished?
#t
; reset ends the task that calls it.
> (begin (display "before reset") (newline) (reset) (display "never"))
before reset
> (+ 1 2)
3
