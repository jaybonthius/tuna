; A query's filter and every predicate of search:filters must accept a
; match, in a find, a scan and its count.
> (define b (text-buffer "f" "aaaa one two one two\n"))
> (define one (search:make-query "one"))
> (define (not-first? buffer start end) (> start 7))
> (tables:set! search:filters not-first? #t)
> (all-in b one)
((14 17 "one"))
> (define s (scanned b one))
> (list (scan-spans b s) (search:scan-count s))
(((14 17 "one")) 1)
> (all-in b (search:query-with-filter one (lambda (buffer start end) (< start 10))))
()
> (tables:remove! search:filters not-first?)
; Past a refused match a find goes on from its end, so from inside a
; refused match it gives the match a find from there gives, even after
; a scan covers the text.
> (define aa (search:make-query "aa" search:literal (search:case smart) (search:spaces literal) (lambda (buffer start end) (not (= start 1)))))
> (all-in b aa)
((3 5 "aa"))
> (find-in b aa 2 forward)
(2 4 "aa")
> (scan-spans b (scanned b aa))
((3 5 "aa"))
> (find-in b aa 2 forward)
(2 4 "aa")
; Backward, the last match accepted, passing over refused ones nearer.
> (define (not-second-two? buffer start end) (not (= start 18)))
> (find-in b (search:query-with-filter (search:make-query "two") not-second-two?) (end-of b) backward)
(10 13 "two")
; Past a refused empty match a find goes on one character further.
> (define empty (search:make-query "x*" search:regexp (search:case smart) (search:spaces literal) (lambda (buffer start end) (> start 3))))
> (find-in b empty 1 forward)
(4 4 "")
; A filter that raises is reported once per find or scan, then accepts.
> (define reports '())
> (define (note report c) (set! reports (cons (condition-message c) reports)))
> (advice-add! report note)
> (define calls 0)
> (define (broken buffer start end) (set! calls (+ calls 1)) (error 'broken "no answer"))
> (all-in b (search:query-with-filter one broken))
((6 9 "one") (14 17 "one"))
> reports
("no answer" "no answer")
> (set! reports '())
> (scan-spans b (scanned b (search:query-with-filter one broken)))
((6 9 "one") (14 17 "one"))
> reports
("no answer")
> (advice-remove! report note)
