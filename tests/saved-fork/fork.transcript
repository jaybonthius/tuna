; Saved data is kept by the source of its module's plugin: the original
; reads its stored value, a fork starts empty, and the original's data
; stays for its return.
> (list (notes:origin) (notes:hits))
("bob" 7)
> (import (tuna eval))
> (define (use-source! from to)
    (let* ([file "~/.config/tuna/init.ss"]
           [old (call-with-input-file file get-string-all)]
           [at (let loop ([i 0]) (if (string=? (substring old i (+ i (string-length from))) from) i (loop (+ i 1))))])
      (call-with-output-file file
        (lambda (p)
          (put-string p (string-append (substring old 0 at) to
                          (substring old (+ at (string-length from)) (string-length old)))))
        'replace)
      (unload-module! '(notes))
      (eval-file file)))
