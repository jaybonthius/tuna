; On a thread that is not a task, exit asks the main thread to exit and
; returns, so the thread goes on and the exit still unloads every module.
> (import (rename (only (chezscheme) fork-thread) (fork-thread chez-fork-thread)))
> (define returned? #f)
> (on-unload (lambda () (display (if returned? "exit returned" "exit did not return")) (newline)))
> (begin (chez-fork-thread (lambda () (exit) (set! returned? #t))) (timers:sleep 5) (display "never"))
exit returned
configuration unloading
keeper unloading
> (display "never runs")
