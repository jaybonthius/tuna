; docs-at-point loads without the echo area or any other display.
> (list (and (member '(docs-at-point) (loaded-modules)) #t) (and (member '(echo-area) (loaded-modules)) #t))
(#t #f)
; A doc and its options.
> (define d (docs-at-point:make-doc "total(items) -> Decimal"
              (docs-at-point:doc-options [thing "total"] [spans (list (list 6 11 faces:highlight))])))
> (list (docs-at-point:doc-text d) (docs-at-point:doc-thing d) (docs-at-point:doc-echo d) (docs-at-point:doc-spans d) (docs-at-point:doc-markdown? d))
("total(items) -> Decimal" "total" "total(items) -> Decimal" ((6 11 highlight)) #f)
> (docs-at-point:doc-echo (docs-at-point:make-doc "Long text" (docs-at-point:doc-options [markdown] [echo #f])))
#f
> (docs-at-point:doc-echo (docs-at-point:make-doc "Long text" (docs-at-point:doc-options [echo "Short"])))
"Short"
> (raised (lambda () (docs-at-point:make-doc 'text)))
(docs-at-point:make-doc "not a string")
> (raised (lambda () (docs-at-point:doc-options [thing 'total])))
(docs-at-point:doc-options "neither a string nor #f")
