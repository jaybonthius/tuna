; M-s l on a large buffer splits its lines in a job; point follows the
; selection and comes back when the read is quit.
> (define big (buffers:make "big" (apply string-append (map (lambda (i) (format "line ~a\n" i)) (iota 2000)))))
> (views:set-buffer! (view) big)
> (define t (start! (lambda () (press! "M-s" "l"))))
> (define s (session))
> (wait-matches s)
> (completion:matches-count (completion:session-matches s))
2000
> (type! "1999")
> (wait-matches s)
> (texts s)
("line 1999")
> (views:point (view))
21
> (press! "C-g")
! &quit
> (views:point (view))
1
> (define t (start! (lambda () (press! "M-s" "l"))))
> (type! "line 1500")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (document:line (buffers:document big) (views:point (view)))
1501
; M-g g reads a line number, offering the current line; RET alone goes to
; the start of that line.
> (define small (buffers:make "small" "one\ntwo\nthree\n"))
> (views:set-buffer! (view) small)
> (views:set-point! (view) 7)
> (define t (start! (lambda () (press! "M-g" "g"))))
> (datums minibuf)
((minibuffer:%prompts () (minibuffer:prompt ((depth . 1)) (minibuffer:question () "Go to line (default 2): ") (minibuffer:input-field ()) "\n" (minibuffer:content ()))))
> (press! "RET")
> (result t)
> (views:point (view))
5
> (define t (start! (lambda () (press! "M-g" "M-g"))))
> (type! "3")
> (press! "RET")
> (result t)
> (views:point (view))
9
; Input that is not a number is refused and asked again.
> (define t (start! (lambda () (press! "M-g" "g"))))
> (type! "x")
> (press! "RET")
> (result t)
waiting
> (input)
""
> (lines-html (minibuffer:prompt-view (prompt)))
"<div class=\"view-lines\"><div class=\"minibuffer-prompts\"><div class=\"node\" id=\"v4-15\" data-at=\"1\" data-to=\"34\"><div class=\"minibuffer-prompt\"><div class=\"line\" id=\"v4-16\" data-line=\"1\" data-before=\"0\" data-at=\"2\"><span class=\"node\" data-at=\"2\" data-to=\"28\"><span class=\"minibuffer-question\"><span data-at=\"3\">Go to line (default 3): </span></span></span><span class=\"node\" data-at=\"28\" data-to=\"30\"><span class=\"minibuffer-input\"><span data-at=\"29\"><span class=\"cursor primary\"></span></span><span class=\"minibuffer-message\" role=\"status\"> [Please enter a number]</span></span></span><br></div><div class=\"node\" id=\"v4-17\" data-at=\"31\" data-to=\"33\"><div class=\"minibuffer-content\"></div></div></div></div></div></div></div>"
> (minibuffer:set-input! (prompt) "1")
> (press! "RET")
> (result t)
> (views:point (view))
1
> (line-picker:goto-line-history)
("1" "x" "3")
; M-n past the input inserts the default, the current line.
> (views:set-point! (view) 7)
> (define t (start! (lambda () (press! "M-g" "g"))))
> (press! "M-n")
> (input)
"2"
> (press! "M-n")
! minibuffer:next-history: end of defaults
> (press! "M-p")
> (input)
""
> (press! "C-g")
! &quit
> (result t)
; A number that is not whole is read, and goto-line refuses it, as
; Emacs's forward-line does.
> (define t (start! (lambda () (press! "M-g" "g"))))
> (type! "2.5")
> (press! "RET")
! line-picker:goto-line: not an exact integer with irritant 2.5
> (result t)
; A line past the last goes to the end; one before the first to the start.
> (in-client (lambda () (line-picker:goto-line 99)))
> (views:point (view))
15
> (in-client (lambda () (line-picker:goto-line -4)))
> (views:point (view))
1
; A numeric prefix argument is the line, read from no prompt.
> (press! "C-u" "2" "M-g" "g")
> (views:point (view))
5
> (press! "M--" "M-g" "g")
> (views:point (view))
1
> (raised (lambda () (line-picker:goto-line 1.5)))
(line-picker:goto-line "not an exact integer")
; C-u alone is no line number, so the line is read.
> (in-client (lambda () (line-picker:goto-line 1)))
> (define t (start! (lambda () (press! "C-u" "M-g" "g"))))
> (datums minibuf)
((minibuffer:%prompts () (minibuffer:prompt ((depth . 1)) (minibuffer:question () "Go to line (default 1): ") (minibuffer:input-field ()) "\n" (minibuffer:content ()))))
> (type! "3")
> (press! "RET")
> (result t)
> (views:point (view))
9
; With no final newline, a line past the last goes to the end of the last.
> (views:set-buffer! (view) (buffers:make "unended" "one\ntwo\nthree"))
> (in-client (lambda () (line-picker:goto-line 4)))
> (views:point (view))
14
; The lines are those of the buffer's text: an atom gives the lines of
; its kind's text, and a line starting in an atom's text is at the
; position before the atom.
> (import (cards))
> (define rows (buffers:make "rows" (cards:rows '() (cards:para '() "intro " (cards:tag '((label . "TAG"))) "\n") (cards:row '((label . "alpha"))) (cards:row '((label . "beta"))) (cards:para '() "end\n"))))
> (views:set-buffer! (view) rows)
> (define t (start! (lambda () (press! "M-s" "l"))))
> (define s (session))
> (wait-matches s)
> (let ([ms (completion:session-matches s)]) (map (lambda (k) (let ([m (completion:matches-ref ms k)]) (cons (completion:text s m) (completion:value s m)))) (iota (completion:matches-count ms))))
(("intro TAG" . 0) ("alpha" . 11) ("beta" . 12) ("end" . 13))
> (type! "beta")
> (wait-matches s)
> (press! "RET")
> (result t)
> (views:point (view))
12
; On a line holding an atom's text, the read lands at the leftmost
; match before the atom, or at the line's start.
> (define t (start! (lambda () (press! "M-s" "l"))))
> (type! "tro")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (views:point (view))
4
> (define t (start! (lambda () (press! "M-s" "l"))))
> (type! "TAG")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (views:point (view))
2
; A large buffer's lines are split in a job, with the atoms' texts the
; main thread gathered.
> (define many (buffers:make "many" (apply cards:rows '() (cards:para '() (apply string-append (map (lambda (i) (format "line ~a\n" i)) (iota 1100))))
                                     (map (lambda (i) (cards:row `((label . ,(format "row ~a" i))))) (iota 3)))))
> (views:set-buffer! (view) many)
> (define t (start! (lambda () (press! "M-s" "l"))))
> (define s (session))
> (wait-matches s)
> (completion:matches-count (completion:session-matches s))
1103
> (type! "row 2")
> (wait-matches s)
> (texts s)
("row 2")
> (press! "RET")
> (result t)
> (views:point (view))
9895
