; The documented examples, in order. The configuration sets
; scroll-conservatively and wrap-lines as the documented one does.
> (list (views:scroll-conservatively) (views:wrap-lines))
(20 #f)
> (define notes (buffers:make "notes" "* Today: Buy milk.\n"))
> (define left (views:make notes))
> (define right (views:make notes))
> (views:set-point! right 12)
> (list (views:point left) (views:point right))
(1 12)
> (views:scroll-to! left (views:point left) (views:align center))
> (views:set-option! right views:wrap-lines #t)
> (views:with-view right (views:wrap-lines))
#t
> (views:with-view left (views:wrap-lines))
#f
> (views:view '((buffer . "notes")))
#(views:view ((buffer . "notes")))
> (import (magit))
> (define status
    (buffers:make "*status*"
      (magit:section '()
        (magit:section '() (buffers:text '() "Head: main\n"))
        (magit:section '() (buffers:text '() "Untracked\n")))))
> (show (views:make status))
<div class="view" data-view="3" data-placement="1" data-place-line="1" data-place-align="top" data-place-offset="0" style="overflow:auto;white-space:pre"><section class="magit-section"><div class="child"><section class="magit-section"><div class="child"><div class="line" id="v3-1" data-line="1"><span class="cursor primary"></span>Head: main</div></div></section></div><div class="child"><section class="magit-section"><div class="child"><div class="line" id="v3-2" data-line="2">Untracked</div></div></section></div></section></div>
> (table-set! views:span-properties 'tag (lambda (v) (list (cons "data-tag" v))))
> (buffers:define-layer tags)
> (buffers:add-span! (buffers:layer notes tags) 3 8 '((tag . "when") (face . bold)))
> (show right)
<div class="view" data-view="2" data-placement="1" data-place-line="1" data-place-align="top" data-place-offset="0" style="overflow:auto;white-space:pre-wrap"><div class="line" id="v2-1" data-line="1">* <span class="bold" data-tag="when">Today</span>: Bu<span class="cursor primary"></span>y milk.</div><div class="line" id="v2-2" data-line="2"><br></div></div>
