("one two three" ((14 #f)))
; A click in another view selects it; a view that is locked, such as the
; echo area, or that is in no layout, refuses clicks.
> (define first (view))
> (define second (views:make (views:buffer first)))
> (buffers:replace! layout:buffer 1 (- (document:length (buffers:document layout:buffer)) 1)
    (document:from-datum
      (layout-split:container '()
        (views:view `((view . ,(views:id first)) (buffer . ,(buffers:name (views:buffer first)))))
        (views:view `((view . ,(views:id second)) (buffer . ,(buffers:name (views:buffer first))))))))
