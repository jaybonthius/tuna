; Input that is no item, a key pressed or a command run as input from a
; timer, ends idleness, so an idle timer runs again in the next idle
; period; commands run one after another start none between them.
> (define one (layout:current-frame))
> (define idle-runs 0)
> (define idle-timer (timers:run-when-idle 0.1 (lambda () (set! idle-runs (+ idle-runs 1)))))
> (timers:set-idle! #t)
> (testing:wait-until (lambda () (= idle-runs 1)))
> (timers:sleep 0.2)
> idle-runs
1
> (define typed 0)
> (commands:define-command (type-one) "Counts a character typed." (set! typed (+ typed 1)))
> (timers:run-after 0 (lambda () (for-each (lambda (i) (keys:run-as-input one type-one)) (iota 40))))
#<timer>
> (testing:wait-until (lambda () (= idle-runs 2)))
> (timers:sleep 0.2)
> (list typed idle-runs)
(40 2)
> (keys:bind! keys:global "C-c 2" type-one)
> (timers:run-after 0 (lambda () (keys:press! one "C-c") (keys:press! one "2")))
#<timer>
> (testing:wait-until (lambda () (= idle-runs 3)))
> (timers:sleep 0.2)
> (list typed idle-runs)
(41 3)
; Tuna is busy while the command runs and idle while it waits.
> (define seen '())
> (commands:define-command (wait-briefly)
    "Notes idleness before and after a pause."
    (set! seen (cons (timers:idle-seconds) seen))
    (timers:sleep 0.2)
    (set! seen (cons (timers:idle-seconds) seen)))
> (define t (spawn-task (lambda (restore) (keys:run-as-input one wait-briefly))))
> (timers:sleep 0.1)
> (real? (timers:idle-seconds))
#t
> (testing:wait-until (lambda () (eq? (task-state t) 'done)))
> (list seen (real? (timers:idle-seconds)))
((#f #f) #t)
; Input inside an item, where Tuna is busy, leaves idleness alone.
> (timers:set-idle! #f)
> (keys:run-as-input one type-one)
> (keys:press! one "C-c")
> (keys:press! one "2")
> (list typed (timers:idle-seconds))
(43 #f)
