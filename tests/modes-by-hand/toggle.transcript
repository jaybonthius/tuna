; build.py visits ~/src/build.py in modes:fundamental, in the view v; a
; second view w shows it too, and a third view shows another buffer.
> (disk:folder! "~/src")
> (disk:write-text! "~/src/build.py" "import os\nprint(os.name)\n")
> (define b (files:visit "~/src/build.py"))
> (modes:set-major-mode modes:fundamental b)
> (define v (view))
> (views:set-buffer! v b)
> (views:set-point! v 10)
> (views:set-mark! v 4)
> (define w (layout-split:split-view! v (layout-split:direction row)))
> (views:set-buffer! w b)
> (define other (buffers:make "other" "text\n"))
> (define x (layout-split:split-view! w (layout-split:direction row)))
> (views:set-buffer! x other)
> (layout:select! v)
> (define (ask-minor! . prefix)
    (let ([t (apply start! (append prefix (list "M-x")))])
      (type! "modes:toggle-minor-mode")
      (press! "RET")
      (timers:sleep 0.05)
      t))
> (define (answer! text) (type! text) (press! "RET"))
> (define (toggle! name . prefix)
    (let ([t (apply ask-minor! prefix)])
      (answer! name)
      (result t)))
> (define (question) (let ([s (text minibuf)]) (substring s 0 (search s "\n" 0))))
; The command asks for a minor mode; the candidates are the option
; modes for the buffer's major mode, labelled with their names and
; annotated with their state in the selected view, outside what the
; input matches.
> (define t (ask-minor!))
> (list (question) (rows (session)))
("Toggle minor mode: " (("diagnostics:mode" . "off") ("docs-at-point:mode" . "on") ("editing:electric-indent" . "on") ("fill:mode" . "off") ("rainbow-delimiters:mode" . "off") ("syntax-highlighting:mode" . "on")))
> (type! "on")
> (texts (session))
()
> (press! "C-g")
! &cancelled
> (result t)
> (views:set-option! v fill:mode #t)
> (define t (ask-minor!))
> (rows (session))
(("diagnostics:mode" . "off") ("docs-at-point:mode" . "on") ("editing:electric-indent" . "on") ("fill:mode" . "on") ("rainbow-delimiters:mode" . "off") ("syntax-highlighting:mode" . "on"))
> (press! "C-g")
! &cancelled
> (result t)
> (views:remove-option! v fill:mode)
; No state mode is offered, though each is a named minor mode.
> (define state-modes (list terminal:copy-mode? terminal:char-mode? terminal:semi-char-mode? minibuffer:y-or-n-mode lsp:managed? view:mode))
> (map modes:name state-modes)
(terminal:copy-mode? terminal:char-mode? terminal:semi-char-mode? minibuffer:y-or-n-mode lsp:managed? view:mode)
> (define t (ask-minor!))
> (filter (lambda (m) (member (symbol->string (modes:name m)) (texts (session)))) state-modes)
()
> (press! "C-g")
! &cancelled
> (result t)
; In notes.ss, in chez-scheme:mode, rainbow-delimiters:mode is turned
; on with a local value, its on-change colours the brackets by depth, and
; the echo area says so.
> (define notes (buffers:make "notes.ss" "(a [b])\n"))
> (modes:set-major-mode chez-scheme:mode notes)
> (views:set-buffer! v notes)
> (settle notes)
> (spans-of notes syntax:brackets)
()
> (toggle! "rainbow-delimiters:mode")
> (settle notes)
> (list (buffers:with-buffer notes (options:local? rainbow-delimiters:mode)) (local rainbow-delimiters:mode notes) (rainbow-delimiters:mode)
        (spans-of notes syntax:brackets) (echo))
(#t #t #f ((1 2 ((bracket . 1))) (4 5 ((bracket . 2))) (6 7 ((bracket . 2))) (7 8 ((bracket . 1)))) "rainbow-delimiters:mode enabled in current buffer")
; syntax-highlighting:mode, on by default, is offered too: turned off,
; the buffer's faces go and its brackets stay.
> (define commented (buffers:make "commented.ss" "; note\n(a)\n"))
> (modes:set-major-mode chez-scheme:mode commented)
> (views:set-buffer! v commented)
> (buffers:with-buffer commented (options:set-local! rainbow-delimiters:mode #t))
> (settle commented)
> (list (spans-of commented syntax-highlighting:faces) (length (spans-of commented syntax:brackets)))
(((1 7 ((face . comment)))) 2)
> (toggle! "syntax-highlighting:mode")
> (settle commented)
> (list (local syntax-highlighting:mode commented) (spans-of commented syntax-highlighting:faces)
        (length (spans-of commented syntax:brackets)) (echo))
(#f () 2 "syntax-highlighting:mode disabled in current buffer")
> (views:set-buffer! v b)
; A mode on everywhere is turned off in the buffer only; the global
; setting is unchanged.
> (options:set! diagnostics:mode #t)
> (toggle! "diagnostics:mode")
> (list (local diagnostics:mode b) (local diagnostics:mode other) (options:setting diagnostics:mode) (echo))
(#f #t #t "diagnostics:mode disabled in current buffer")
> (options:set! diagnostics:mode #f)
; With a prefix argument whose number is 1 or more the mode is turned
; on, whatever its state; with one below 1, off. C-- is bound to
; nothing, so C-u - gives that argument.
> (press! "C--")
! C-- is undefined
> (define (with-prefix state prefix)
    (buffers:with-buffer b (options:set-local! fill:mode state))
    (apply toggle! "fill:mode" prefix)
    (local fill:mode b))
> (map (lambda (prefix) (list (with-prefix #t prefix) (with-prefix #f prefix)))
       '(("C-u") ("M-5") ("M-1") ("C-u" "-") ("M--") ("M-0")))
((#t #t) (#t #t) (#t #t) (#f #f) (#f #f) (#f #f))
; The value is the buffer's: w shows the mode on too; a view of
; another buffer does not; the global setting is unchanged.
> (buffers:with-buffer b (options:unset-local! fill:mode))
> (toggle! "fill:mode")
> (list (views:with-view w (fill:mode)) (views:with-view x (fill:mode)) (options:setting fill:mode))
(#t #f #f)
; The view v's own value hides the buffer's: the buffer's value is set, w
; shows it, v keeps its own, and the echo area says so.
> (buffers:with-buffer b (options:unset-local! fill:mode))
> (views:set-option! v fill:mode #f)
> (toggle! "fill:mode")
> (list (local fill:mode b) (views:with-view w (fill:mode)) (views:with-view v (fill:mode)) (echo))
(#t #t #f "fill:mode enabled in current buffer; this view keeps its own value")
> (views:remove-option! v fill:mode)
; The option's on-change runs once and options:changed is called once,
; for the value set.
> (import (probe))
> (define reported '())
> (define (option-entry option value) (when (eq? option probe:counted-mode) (set! reported (cons value reported))))
> (hooks:add! options:changed option-entry)
> (toggle! "probe:counted-mode")
> (list (probe:take-changes!) reported)
((#t) (#t))
> (hooks:remove! options:changed option-entry)
; Fill's keymap is searched by its depth, and both views' status
; lines show its lighter.
> (buffers:with-buffer b (options:unset-local! fill:mode))
> (toggle! "fill:mode")
> (list (active-keymaps) (status-line:show-minor-modes v) (status-line:show-minor-modes w))
((fill:keymap modes:fundamental-keymap) "Fill" "Fill")
; Nothing else changes: the major mode, the text, point and region,
; undo history, modified flag, selected view, layout and jump list.
> (define (tree) (car (document:datums (buffers:document layout:buffer))))
> (define (t10-state)
    (list (modes:major-mode b) (text b) (views:point v) (views:mark v) (undo:history b) (buffers:modified? b)
          (view) (tree) (jump-history:places)))
> (define before (t10-state))
> (toggle! "fill:mode")
> (list (local fill:mode b) (equal? before (t10-state)))
(#f #t)
; An input that names no mode leaves the prompt waiting, saying No
; match; C-g then quits, saying Quit; nothing changes.
> (define t (ask-minor!))
> (answer! "zz")
> (list (result-now t) (bracket))
(waiting "<span class=\"minibuffer-message\" role=\"status\"> [No match]</span>")
> (press! "C-g")
! &cancelled
> (result t)
> (list (echo) (equal? before (t10-state)))
("Quit" #t)
; A switch of the major mode takes the toggled value away.
> (toggle! "fill:mode")
> (local fill:mode b)
#t
> (modes:switch-major-mode python:mode b)
> (local fill:mode b)
#f
; In *Help*, a minor mode is turned on as anywhere.
> (in-client (lambda () (help:describe-mode v)))
> (define help-buffer (buffers:find "*Help*"))
> (views:set-buffer! v help-buffer)
> (toggle! "rainbow-delimiters:mode")
> (local rainbow-delimiters:mode help-buffer)
#t
> (views:set-buffer! v b)
; From code, a state mode or an option not defined as a minor mode,
; or a killed buffer, raises and changes nothing.
> (raised (lambda () (modes:toggle-minor-mode terminal:copy-mode? b #t)))
(modes:toggle-minor-mode "not an option mode")
> (raised (lambda () (modes:toggle-minor-mode fill:column b #t)))
(modes:toggle-minor-mode "not an option mode")
> (define gone (buffers:make "gone" ""))
> (buffers:kill! gone)
#t
> (raised (lambda () (modes:toggle-minor-mode fill:mode gone #t)))
(modes:toggle-minor-mode "not a live buffer")
> (list (local fill:column b) (local fill:mode b))
(70 #f)
; No key runs the command.
> (keys:where-is client modes:toggle-minor-mode)
()
; A minor mode goes with its plugin: no longer offered or named.
> (define t (ask-minor!))
> (filter (lambda (s) (string=? (substring s 0 6) "probe:")) (texts (session)))
("probe:counted-mode" "probe:talking-mode")
> (press! "C-g")
! &cancelled
> (result t)
> (define counted probe:counted-mode)
> (unload-owner! (module-owner '(probe)))
> (define t (ask-minor!))
> (filter (lambda (s) (string=? (substring s 0 6) "probe:")) (texts (session)))
()
> (press! "C-g")
! &cancelled
> (result t)
> (modes:name counted)
#f
; A minor mode for some major modes is offered only in their
; buffers: dired:hide-details? in a listing, not in build.py.
> (define t (ask-minor!))
> (member "dired:hide-details?" (texts (session)))
#f
> (press! "C-g")
! &cancelled
> (result t)
> (in-client (lambda () (dired:open (string-append (getenv "HOME") "/src"))))
> (define listing (views:buffer v))
> (modes:major-mode listing)
dired:mode
> (define t (ask-minor!))
> (rows (session))
(("diagnostics:mode" . "off") ("dired:hide-details?" . "off") ("docs-at-point:mode" . "on") ("editing:electric-indent" . "on") ("fill:mode" . "off") ("rainbow-delimiters:mode" . "off") ("syntax-highlighting:mode" . "on"))
> (press! "C-g")
! &cancelled
> (result t)
> (views:set-buffer! v b)
; From code, for a buffer whose major mode it is not for, it raises
; and changes nothing.
> (raised (lambda () (modes:toggle-minor-mode dired:hide-details? b #t)))
(modes:toggle-minor-mode "dired:hide-details? is not for python:mode")
> (local dired:hide-details? b)
#f
; An option mode takes #t and #f only.
> (raised (lambda () (options:set! fill:mode 'always)))
(options:set! "always is not a valid value for fill:mode")
> (fill:mode)
#f
; Called from code inside another command, it sets the value and
; the option's on-change runs, but it says nothing.
> (import (probe))
> (commands:define-command (counted-on) "Turns probe:counted-mode on in build.py." (modes:toggle-minor-mode probe:counted-mode b #t))
> (echo-area:message! "")
> (in-client (lambda () (commands:run counted-on)))
> (list (local probe:counted-mode b) (probe:take-changes!) (echo))
(#t (#t) #f)
; A message the option's on-change writes is left in place of the
; toggle's.
> (toggle! "probe:talking-mode")
> (list (local probe:talking-mode b) (echo))
(#t "talking-mode is on")
