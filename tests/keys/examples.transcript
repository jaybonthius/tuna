; Reading keys: a command binds the next key sequence typed, and while it
; reads, keys:reading gives the keys that ran it.
> (commands:define-command (bind-other-view [keys (keys:read-key-sequence)])
    "Binds the next key sequence typed to layout:other-view."
    (keys:bind! keys:global (if (keys:event? keys) (keys:event-key keys) keys) layout:other-view))
> (keys:bind! keys:global "C-c b" bind-other-view)
