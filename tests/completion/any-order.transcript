; Each component's match is drawn in its own face, by the component's
; place among those not negated.
> (first-spans '("M-x") "find file")
((0 4 completion.match-1) (12 16 completion.match-0))
! &cancelled
> (first-spans '("M-x") "file find")
((0 4 completion.match-0) (12 16 completion.match-1))
! &cancelled
