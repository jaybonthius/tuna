; Unloading jsonrpc stops the programs of its connections, whichever
; module started them, and their waiting requests get jsonrpc:&ended.
> (define c (start-fake! "fake" (jsonrpc:handlers)))
> (jsonrpc:request c "echo" '#(1))
#(1)
> (define process (jsonrpc:connection-process c))
> (define waiting (spawn-task (lambda (restore) (raised (lambda () (jsonrpc:request c "wait" '()))))))
> (timers:sleep 0.1)
> (processes:status process)
#f
> (unload-owner! (module-owner '(jsonrpc)))
> (testing:wait-until (lambda () (processes:status process)))
> (integer? (processes:status process))
#t
> (testing:join waiting)
(ended #f)
> (load-module! '(jsonrpc))
#<owner (jsonrpc) 2>
> (define again (start-fake! "again" (jsonrpc:handlers)))
> (jsonrpc:request again "echo" '#(2))
#(2)
> (jsonrpc:stop! again)
