; A git project lists as git ls-files does: tracked files, hidden ones
; too, and untracked ones that no ignore file names, each relative to the
; root, a name holding a line feed whole; then each submodule's files
; under its path, in place of the submodule itself.
> (listed-in "src/app/lib")
(".gitignore" ".gitmodules" ".hidden" "README" "lib/a.ss" "lib/deep/b.ss" "libs/lib/.gitmodules" "libs/lib/lib.ss" "libs/lib/vendor/inner/inner.ss" "notes.txt" "odd\nname" "pkg/go.mod" "pkg/main.go")
> (set-option! projects:merge-submodules? #f)
> (listed-in "src/app")
(".gitignore" ".gitmodules" ".hidden" "README" "lib/a.ss" "lib/deep/b.ss" "notes.txt" "odd\nname" "pkg/go.mod" "pkg/main.go")
> (listed-in "src/app/libs/lib")
(".gitmodules" "lib.ss")
> (set-option! projects:merge-submodules? #t)
; A root found by an extra marker inside a repository lists its own
; files with git, a submodule under it in place of the submodule.
> (set-option! projects:extra-root-markers (list "go.mod" ".project"))
> (listed-in "src/app/pkg")
("go.mod" "main.go")
> (write-file! "src/app/libs/go.mod" "module libs\n")
> (listed-in "src/app/libs")
("go.mod" "lib/.gitmodules" "lib/lib.ss" "lib/vendor/inner/inner.ss")
; Elsewhere, find lists the regular files and the links to them, follows
; no link to a folder, and leaves out projects:ignores.
> (listed-in "hg-thing")
("a.txt" "link-to-file" "sub/b.txt")
> (listed-in "notes/proj")
(".project" "p.txt")
> (set-option! projects:ignores (list "./sub/" "*.txt"))
> (listed-in "hg-thing")
(".hg/store" "a.o" "link-to-file")
> (set-option! projects:ignores '())
> (listed-in "notes/proj")
(".project" "p.txt")
; A program's complaint is reported, and the paths it listed stay.
> (listed (projects:make-project (string-append home "/notes") projects:list-with-git))
! projects:list-files: fatal: not a git repository (or any of the parent directories): .git
()
; The procedure returned stops the listing: nothing more comes.
> (define calls 0)
> (define stop (projects:list-files (projects:find (string-append home "/src/app")) (lambda (files) (set! calls (+ calls 1)))))
> (stop)
> (stop)
> (sleep-for 0.5)
> calls
0
; What code passes is checked.
> (projects:list-files 'app values)
! projects:list-files: not a project with irritant app
> (projects:list-files (projects:find (string-append home "/src/app")) 'show)
! projects:list-files: not a procedure with irritant show
> (projects:list-files (projects:make-project home (lambda (root on-files) 'stop)) values)
! projects:list-files: a lister returned what is not a procedure with irritant stop
> (projects:list-with-git "app" values)
! projects:list-with-git: not an absolute path with irritant "app"
> (projects:list-with-find home 'show)
! projects:list-with-find: not a procedure with irritant show
