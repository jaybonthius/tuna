> (definition-changes spell:language)
(((prog) override #f) ((groucho words) override #f) ((spell) define #f))
> (module-changes '(prog))
((override spell:language #f))
; Advice wraps the definition in effect, the last outermost; (init) and
; (repl) each added announce.
> (define (bracket save! path) (string-append "[" (save! path) "]"))
> (as-module '(spell) (advice-add! files:save! bracket))
