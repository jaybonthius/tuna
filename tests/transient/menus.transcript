; magit.sls defines the merge menu of the page's examples.
> (define notes (buffers:make "notes" "one\ntwo\n"))
> (views:set-buffer! (view) notes)
> (define user-view (view))
> (import (magit))
; A menu is a table, with its documentation.
> (table? magit:merge-menu)
#t
> (documentation magit:merge-menu)
"Git's merge menu."
; Showing a menu draws it at once in the buffer  *transient*, as a
; palette as tall as the menu, and leaves the view selected.
> (press! "C-c" "m")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (popups)
(layout:popups-root () (layout-float:container () #(views:view ((view . 5) (buffer . " *transient*") (place box 1/2 1/5) (width . 3/5) (height . content) (locked . #t)))))
> (eq? (view) user-view)
#t
> (transient:buffer? (menu-buffer))
#t
> (transient:buffer? notes)
#f
; The menu draws a title, then groups, each a heading and its entries:
; a key, a description and, for an argument, the argument.
> (between (html (popup)) "<div class=\"transient-menu\">" "</h1>")
"<div class=\"transient-menu\"><div class=\"node whole\" id=\"v5-1\" data-at=\"1\" data-to=\"2\" data-line=\"1\" data-before=\"0\"><h1 class=\"transient-title\">Merge</h1>"
> (between (html (popup)) "<section class=\"transient-group\">" "</h2>")
"<section class=\"transient-group\"><div class=\"node whole\" id=\"v5-2\" data-at=\"3\" data-to=\"4\" data-line=\"1\" data-before=\"1\"><h2 class=\"transient-heading\">Arguments</h2>"
> (between (html (popup)) "<button class=\"ui-button transient-entry\"" "</button>")
"<button class=\"ui-button transient-entry\" type=\"button\" tabindex=\"-1\" aria-pressed=\"false\"><kbd class=\"transient-key\" data-face=\"keyword\">- f</kbd> <span class=\"ui-label\">Fast-forward only</span> <span class=\"transient-argument\" data-face=\"shadow\">--ff-only</span></button>"
> (press! "-" "f")
> (between (html (popup)) "<button class=\"ui-button transient-entry\"" "</button>")
"<button class=\"ui-button transient-entry\" type=\"button\" tabindex=\"-1\" aria-pressed=\"true\"><kbd class=\"transient-key\" data-face=\"keyword\">- f</kbd> <span class=\"ui-label\">Fast-forward only</span> <span class=\"transient-argument\">--ff-only</span></button>"
> (between (html (popup)) "<kbd class=\"transient-key\" data-face=\"keyword\">m" "</button>")
"<kbd class=\"transient-key\" data-face=\"keyword\">m</kbd> <span class=\"ui-label\">Merge</span></button>"
; Showing the top menu again does nothing: one C-g closes it, and its
; part goes.
> (in-client (lambda () (commands:run magit:merge)))
> (press! "C-g")
> (list (menu) (popups) (popup))
(() (layout:popups-root ()) #f)
; A title may be a procedure, run at each draw in the menu's view.
> (define branch "main")
> (transient:define-menu status "The status menu."
    (title (lambda () (string-append "On " branch ", in " (buffers:name (buffers:current))))))
> (commands:define-command (show-status) "Shows the status menu." (transient:show! status))
> (in-client (lambda () (commands:run show-status)))
> (menu)
("On main, in notes")
> (set! branch "next")
> (menu)
("On next, in notes")
> (press! "C-g")
; The form checks its shape when it expands, and its values when it runs.
> (transient:define-menu "m" "Doc.")
! transient:define-menu: expected (transient:define-menu id doc-string clause ...) (transient:define-menu "m" "Doc.")
> (transient:define-menu m 'doc)
! transient:define-menu: expected (transient:define-menu id doc-string clause ...) (transient:define-menu m (quote doc))
> (transient:define-menu m "Doc." (colour "red"))
! transient:define-menu: an unknown or repeated clause (colour "red") in (transient:define-menu m "Doc." (colour "red"))
> (transient:define-menu m "Doc." (title "A") (title "B"))
! transient:define-menu: an unknown or repeated clause (title "B") in (transient:define-menu m "Doc." (title "A") (title "B"))
> (transient:define-menu m "Doc." (incompatible "--a"))
! transient:define-menu: expected (incompatible (argument-string ...) ...) (incompatible "--a") in (transient:define-menu m "Doc." (incompatible "--a"))
> (transient:define-menu m "Doc." (title 'a))
! transient:define-menu: neither a string nor a procedure with irritant a
> (transient:define-menu m "Doc." (arguments '()))
! transient:define-menu: not an option with irritant ()
> (transient:define-menu m "Doc." (incompatible ("--a" 2)))
! transient:define-menu: not a list of lists of strings with irritant (("--a" 2))
> (transient:define-menu m "Doc." (title #f))
! transient:define-menu: neither a string nor a procedure with irritant #f
> (transient:define-menu m "Doc." (arguments #f))
! transient:define-menu: not an option with irritant #f
; The procedures check what they are given.
> (raised (lambda () (transient:show! 'menu)))
(transient:show! "not a table")
> (raised (lambda () (transient:buffer? "notes")))
(transient:buffer? "not a buffer")
> (raised (lambda () (transient:arguments 'menu)))
(transient:arguments "not a table")
> (let ([result #f])
    (fork-thread (lambda () (set! result (raised (lambda () (transient:show! magit:merge-menu))))))
    (testing:wait-until (lambda () result))
    result)
(transient:show! "not on the main thread")
; When the module that defined a menu unloads, its menu closes.
> (press! "C-c" "m")
> (unload-module! '(magit))
> (list (menu) (popups))
(() (layout:popups-root ()))
; A keymap no module defined as a menu stays open, empty, when its
; module unloads, until a key closes it.
> (import (plain))
> (in-client (lambda () (transient:show! plain:keymap)))
> (menu)
((("h" "plain:hello")))
> (unload-module! '(plain))
> (menu)
()
> (map documentation (list-head (keys:active-keymaps client) 2))
("Plain keys." "The keys of every open menu, searched after the top menu's keymap.")
> (press! "C-f")
> (list (menu) (popups))
(() (layout:popups-root ()))
; The menus close when the menu's view leaves the layout.
> (load-module! '(magit))
> (press! "C-x" "2")
> (define upper (view))
> (press! "C-c" "m")
> (layout:delete-part! (layout:view-node upper))
> (list (menu) (popups))
(() (layout:popups-root ()))
; A display rule may put the menu elsewhere, such as at the bottom of the
; screen, as in Emacs; closing it removes that part.
> (table-set! layout:display-rules transient:buffer?
    (layout-split:display-at-side (layout:direction down) 95 'content '((locked . #t))))
> (press! "C-c" "m")
> (datums layout:buffer)
((layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 9) (buffer . "notes")))) #(views:view ((view . 3) (buffer . " *Echo Area*") (depth . 90) (size . content) (locked . #t))) #(views:view ((view . 11) (buffer . " *transient*") (depth . 95) (size . content) (locked . #t))) #(views:view ((view . 4) (buffer . " *Minibuf*") (depth . 100) (size . content) (locked . #t))))))
> (eq? (view) (layout:find-view notes))
#t
> (press! "C-g")
> (datums layout:buffer)
((layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 9) (buffer . "notes")))) #(views:view ((view . 3) (buffer . " *Echo Area*") (depth . 90) (size . content) (locked . #t))) #(views:view ((view . 4) (buffer . " *Minibuf*") (depth . 100) (size . content) (locked . #t))))))
> (table-remove! layout:display-rules transient:buffer?)
; When this plugin unloads, the menus close, its buffer goes, and the
; modules that import it unload.
> (press! "C-c" "m")
> (unload-module! '(transient))
> (list (popups) (buffers:find " *transient*") (keys:lookup client "C-c m"))
((layout:popups-root ()) #f #f)
> (load-module! '(magit))
> (press! "C-c" "m")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
