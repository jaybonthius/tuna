# The layout in the walkthrough: containers, views, and remembered focus
vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
  }
}
direction: down

classes: {
  box: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 18
    }
  }
  view: {
    style: {
      fill: "#fff8e1"
      stroke: "#8d6e00"
      font-color: "#3e2f00"
      border-radius: 8
      font-size: 18
    }
  }
}

legend: |md
  **Status:** planned. Blue boxes are containers; yellow boxes are views, each showing one buffer.
|

root: Container: fit, top to bottom\n(the browser tab shows this) {class: box}
main: Container: fit, left to right\nremembers: last focused was the tabs {class: box}
side: View of "*buffers*"\npinned left, 20% wide {class: view}
tabs: Container: tabbed\nremembers: last focused was notes.txt {class: box}
scratch: View of "*scratch*" {class: view}
notes: View of "notes.txt" {class: view}
mini: View of the minibuffer\n(only while a question waits) {class: view}
echo: View of the echo area {class: view}

root -> main
root -> mini
root -> echo
main -> side
main -> tabs
tabs -> scratch
tabs -> notes
