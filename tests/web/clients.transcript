; A client whose stream closes is removed an hour later, unless its stream
; opens again first. Tuna learns that a stream has closed when it next
; writes to it.
> (define (written-until done?)
    (testing:wait-until
      (lambda ()
        (for-each (lambda (client) (web:call-page! client "ping" 0)) (web:clients))
        (done?))))
