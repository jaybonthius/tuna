; Every kind, as datums: markers are gone, a soft break is a space, and
; each line of text ends in a newline; list markers, task boxes and
; table lines are not text.
> (import (page))
> (define sample "# Title\n\nA *b* ~~c~~ `d`\nwrapped, then hard  \nbreak.\n\n```scheme extra\n(define x 1)\n```\n\n> quote\n\n- [ ] one\n- [x] two\n\n3. a\n4. b\n\n| a | b | c |\n|:-|:-:|-:|\n| 1 | 2 |\n\n---\n")
> (markdown:blocks sample)
((markdown:heading ((key . 0) (level . 1)) "Title\n") (markdown:paragraph ((key . 1)) "A " (markdown:emphasis () "b") " " (markdown:strikethrough () "c") " " (markdown:code () "d") " wrapped, then hard\nbreak.\n") (markdown:code-block ((key . 2) (language . "scheme")) "(define x 1)\n") (markdown:quote ((key . 3)) (markdown:paragraph ((key . 0)) "quote\n")) (markdown:list ((key . 4) (ordered . #f) (tight . #t)) (markdown:item ((key . 0) (task . unchecked)) (markdown:paragraph ((key . 0)) "one\n")) (markdown:item ((key . 1) (task . checked)) (markdown:paragraph ((key . 0)) "two\n"))) (markdown:list ((key . 5) (ordered . #t) (start . 3) (tight . #t)) (markdown:item ((key . 0)) (markdown:paragraph ((key . 0)) "a\n")) (markdown:item ((key . 1)) (markdown:paragraph ((key . 0)) "b\n"))) (markdown:table ((key . 6) (columns . 3)) (markdown:table-row ((key . 0) (header . #t)) (markdown:table-cell ((key . 0) (align . left)) "a\n") (markdown:table-cell ((key . 1) (align . center)) "b\n") (markdown:table-cell ((key . 2) (align . right)) "c\n")) (markdown:table-row ((key . 1)) (markdown:table-cell ((key . 0) (align . left)) "1\n") (markdown:table-cell ((key . 1) (align . center)) "2\n") (markdown:table-cell ((key . 2) (align . right)) "\n"))) #(markdown:rule ((key . 7))))
; Images are links labelled by their description; addresses other than
; http, https and mailto, links inside links, raw HTML and entities.
> (markdown:blocks "![](https://i.example/x.png) ![a *b*](https://i.example/y.png) [![badge](https://i.example/b.svg)](https://ci.example) [see https://x.example now](https://z.example) [main](src/main.ss) [js](javascript:alert(1)) <mailto:a@b.example> <script>x</script> &amp; &copy;")
((markdown:paragraph ((key . 0)) (markdown:link ((href . "https://i.example/x.png")) "image") " " (markdown:link ((href . "https://i.example/y.png")) "a b") " " (markdown:link ((href . "https://ci.example")) "badge") " " (markdown:link ((href . "https://z.example")) "see https://x.example now") " main js " (markdown:link ((href . "mailto:a@b.example")) "mailto:a@b.example") " <script>x</script> & ©\n"))
