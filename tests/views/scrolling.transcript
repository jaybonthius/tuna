; C-v asks the commanding client's page to scroll by its height less two
; lines and adopts the report of where it went; a page with too little
; drawn past its edge answers more, and is drawn further and asked again.
> (define asked '())
> (define (page-answers client name value)
    (set! asked (cons (cdr (assoc "again" value)) asked))
    (if (and (equal? name "views-page") (not (cdr (assoc "again" value))) (cdr (assoc "forward" value)))
        '(("more" . #t))
        `(("report" . (("type" . "scroll") ("view" . ,(views:id v))
                        ("placement" . ,(car (numbers-after (html-of v client) "data-placement=\"")))
                        ("version" . 0) ("top" . (("line" . 268))) ("spacer" . #f) ("fraction" . 0) ("left" . null)
                        ("past" . 0) ("sides" . #()) ("start" . (("line" . 270))) ("end" . (("line" . 285)))
                        ("atStart" . #f) ("atEnd" . #f) ("columns" . 80) ("rows" . 20) ("pointVisible" . #f)
                        ("wanted" . (("aboveLines" . 41) ("aboveChars" . 3280) ("belowLines" . 41) ("belowChars" . 3280) ("side" . 160))) ("hand" . #t) ("settled" . #t) ("edge" . "top")
                        ("report" . 500))))))
> (define (answer-for-page ask client name value) (page-answers client name value))
> (advice-add! web:ask-page answer-for-page)
