> (buffers:kill! host)
#t
> (list (views:find 40) (eq? (views:buffer hv) host) (views:find (views:id hv)))
(#f #f #<view 8>)
; Each view of a killed buffer shows its newest previous buffer, else
; the buffer used most recently, never an internal one; nothing has been
; used here, so that is the oldest.
> (define older (buffers:make "older" "o\n"))
> (define inner (buffers:make " inner" "i\n"))
> (define doomed (buffers:make "doomed" "d\n"))
> (define came-from-older (views:make older))
> (views:set-buffer! came-from-older inner)
> (views:set-buffer! came-from-older doomed)
> (define doomed-views (list came-from-older (views:make doomed)))
> (buffers:kill! doomed)
#t
> (map (lambda (v) (buffers:name (views:buffer v))) doomed-views)
("older" "notes")
