; A diagnostic's own keymap answers a key at the cursor and a click
; before diagnostics:mark-keymap; a diagnostic without one leaves the key
; to the mark keymap. With the mode off neither applies.
> (define pressed '())
> (define (take!) (let ([p (reverse pressed)]) (set! pressed '()) p))
> (commands:define-command (on-own) "Records a key in a diagnostic's own keymap." (set! pressed (cons 'own pressed)))
> (commands:define-command (on-mark) "Records a key in the mark keymap." (set! pressed (cons 'mark pressed)))
> (commands:define-command (on-global) "Records a global key." (set! pressed (cons 'global pressed)))
> (define-table own-keys)
> (keys:bind! own-keys "C-c a" on-own)
> (keys:bind! own-keys "<mouse-1>" on-own)
> (keys:bind! diagnostics:mark-keymap "C-c a" on-mark)
> (keys:bind! diagnostics:mark-keymap "<mouse-1>" on-mark)
> (keys:bind! keys:global "C-c a" on-global)
> (keys:bind! keys:global "<mouse-1>" on-global)
> (define source (diagnostics:make-source))
> (define (report!)
    (diagnostics:report! source notes
      (list (diagnostics:make-diagnostic (word notes "beta") (+ (word notes "beta") 4) (diagnostics:severity warning) "vague"
              (diagnostics:details [keymap own-keys]))
            (diagnostics:make-diagnostic (word notes "delta") (+ (word notes "delta") 5) (diagnostics:severity error) "wrong")
            (diagnostics:make-diagnostic (word notes "zeta") (+ (word notes "zeta") 4) (diagnostics:severity info) "short"))))
> (mode! notes #t)
> (report!)
#t
> (views:set-point! (view) (+ (word notes "beta") 1))
> (press! "C-c" "a")
> (views:set-point! (view) (+ (word notes "delta") 1))
> (press! "C-c" "a")
> (views:set-point! (view) 1)
> (press! "C-c" "a")
> (take!)
(own mark global)
> (mouse! (view) '("action" . "click") `("at" . ,(+ (word notes "beta") 1)) '("count" . 0))
> (mouse! (view) '("action" . "click") `("at" . ,(+ (word notes "delta") 1)) '("count" . 0))
> (take!)
(own mark)
> (mode! notes #f)
> (views:set-point! (view) (+ (word notes "beta") 1))
> (press! "C-c" "a")
> (mouse! (view) '("action" . "click") `("at" . ,(+ (word notes "delta") 1)) '("count" . 0))
> (take!)
(global global)
> (mode! notes #t)
; next and previous go to the start of the Nth diagnostic after or
; before point, round the buffer's ends, and tell its text.
> (keys:bind! keys:global "M-n" diagnostics:next)
> (keys:bind! keys:global "M-p" diagnostics:previous)
> (define (at) (car (map seen (diagnostics:in notes (views:point (view))))))
> (views:set-point! (view) 1)
> (press! "M-n")
> (list (at) (take-said!))
(("beta" warning "vague") ("vague"))
> (press! "M-n" "M-n")
> (list (at) (take-said!))
(("zeta" info "short") ("wrong" "short"))
> (press! "M-n")
> (at)
("beta" warning "vague")
> (press! "M-p")
> (at)
("zeta" info "short")
> (views:set-point! (view) 1)
> (press! "M-2" "M-n")
> (at)
("delta" error "wrong")
; A negative count moves backward.
> (press! "M--" "M-n")
> (at)
("beta" warning "vague")
; C-u alone moves by one and skips infos and hints.
> (press! "C-u" "M-n")
> (at)
("delta" error "wrong")
> (press! "C-u" "M-p")
> (at)
("beta" warning "vague")
; Without wrap-around? it stops at the ends.
> (set-option! diagnostics:wrap-around? #f)
> (views:set-point! (view) (word notes "zeta"))
> (press! "M-n")
! diagnostics:next: No more diagnostics
> (press! "M-p" "M-p" "M-p")
! diagnostics:previous: No more diagnostics
> (at)
("beta" warning "vague")
> (set-option! diagnostics:wrap-around? #t)
; Every diagnostic at the place reached is told, one per line.
> (diagnostics:report! source notes
    (list (diagnostics:make-diagnostic (word notes "beta") (+ (word notes "beta") 4) (diagnostics:severity warning) "vague")
          (diagnostics:make-diagnostic (word notes "beta") (+ (word notes "beta") 4) (diagnostics:severity error) "unknown"
            (diagnostics:details [origin "lint"] [code "E2"]))
          (diagnostics:make-diagnostic (word notes "zeta") (+ (word notes "zeta") 4) (diagnostics:severity info) "short")))
#t
> (views:set-point! (view) 1)
> (define ignored (take-said!))
> (press! "M-n")
> (list (views:point (view)) (take-said!))
(7 ("lint [E2]: unknown\nvague"))
; Any prefix that is not a number filters as C-u does and moves one; a
; number counts, unfiltered.
> (views:set-point! (view) 1)
> (press! "C-u" "C-u" "M-n")
> (at)
("beta" error "unknown")
> (press! "C-u" "C-u" "M-n")
> (at)
("beta" error "unknown")
> (views:set-point! (view) 1)
> (press! "C-u" "3" "M-n")
> (at)
("zeta" info "short")
> (set-option! diagnostics:wrap-around? #f)
> (press! "C-u" "M-n")
! diagnostics:next: No more errors or warnings
