Tuna is at http://127.0.0.1:PORT/
; The filter removes control sequences and gives each stretch of text
; with the span value of its style: the style a terminal's pen would
; have, drawn with the default palette.
> (read! "\x1b;[1;31mfailed\x1b;[0m: 2 tests")
(("failed" (face . ansi-colors.red) (ansi-colors ("bold"))) (": 2 tests" . #f))
> (equal? (cdar (read! "\x1b;[1;31mx"))
          (ansi-colors:span-value (ghostty:make-style 1 #f #f #t #f #f #f #f #f #f #f 'none) palette))
#t
; Each reset ends the style; ESC [ m is ESC [ 0 m.
> (read! "\x1b;[1;32ma\x1b;[mb")
(("a" (face . ansi-colors.green) (ansi-colors ("bold"))) ("b" . #f))
; Direct colours with ; and with :, colour 196 through the default
; palette, and backgrounds.
> (read! "\x1b;[38;2;10;20;30ma\x1b;[0;38:2::10:20:30mb\x1b;[0;38;5;196mc\x1b;[0;44;97md")
(("a" (ansi-colors ("fg") ("--ansi-colors-fg" . "#0A141E"))) ("b" (ansi-colors ("fg") ("--ansi-colors-fg" . "#0A141E"))) ("c" (ansi-colors ("fg") ("--ansi-colors-fg" . "#FF0000"))) ("d" (face . ansi-colors.bright-white) (ansi-colors ("bg-4"))))
; Underline styles, their colour, inverse and the other words.
> (read! "\x1b;[4:3;58;5;1ma\x1b;[0;7mb\x1b;[0;2;3;8;9;53mc\x1b;[0;21md")
(("a" (ansi-colors ("underline-curly" "underline-color-1"))) ("b" (ansi-colors ("fg-background" "bg-foreground"))) ("c" (ansi-colors ("italic" "faint" "invisible" "strike" "overline"))) ("d" (ansi-colors ("underline-double"))))
; The style holds from one string to the next until a sequence changes
; it; 22 clears bold and faint.
> (read! "\x1b;[1;2;31ma" "b\x1b;[22mc")
(("a" (face . ansi-colors.red) (ansi-colors ("bold" "faint"))) ("b" (face . ansi-colors.red) (ansi-colors ("bold" "faint"))) ("c" (face . ansi-colors.red)))
; A sequence cut across strings waits for the rest, as does a lone ESC
; at the end; other control sequences go; ESC before anything but [
; stays in the text.
> (read! "a\x1b;[3" "1mb\x1b;" "[0mc")
(("a" . #f) ("b" (face . ansi-colors.red)) ("c" . #f))
> (read! "x\x1b;[2Ky\x1b;[?25lz\x1b;Xw")
(("x" . #f) ("y" . #f) ("z\x1B;Xw" . #f))
> (ansi-colors:filter 'nope)
! ansi-colors:filter: not a procedure with irritant nope
> (filter 5)
! ansi-colors:filter: not a string with irritant 5
> (ansi-colors:span-value 'plain palette)
! ansi-colors:span-value: not a style with irritant plain
