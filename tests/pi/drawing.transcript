> (say! f (event "tool_execution_end" '("toolCallId" . "t1") '("toolName" . "bash") '("isError" . #t) '("durationMs" . 2300)
               '("result" . (("content" . #((("type" . "text") ("text" . "building\nrunning 3 tests\n1 failed\n")))))))
        (update `(("type" . "toolcall_start") ("contentIndex" . 3) ("id" . "t2") ("toolName" . "edit")))
        (update `(("type" . "toolcall_end") ("contentIndex" . 3)
                  ("toolCall" . ,(tool-block "t2" "edit" '(("path" . "a.txt") ("edits" . #((("oldText" . "old\nline") ("newText" . "new")))))))))
        (event "tool_execution_start" '("toolCallId" . "t2") '("toolName" . "edit") '("args" . (("path" . "a.txt"))))
        (event "tool_execution_end" '("toolCallId" . "t2") '("toolName" . "edit") '("isError" . #f) '("durationMs" . 12)
               '("result" . (("content" . #((("type" . "text") ("text" . "Edited a.txt"))))))))
