> (+ 1 2)
3
> (define x 5)
> (void)
> (values x "five")
5
"five"
> (string-append "multi"
    "line")
"multiline"
> (car 1)
! car: 1 is not a pair
> (begin (display "partial") (car '()))
partial
! car: () is not a pair
> (error 'check "bad value" 7)
! check: bad value with irritant 7
> (error 'check "bad values" 7 8)
! check: bad values with irritants (7 8)
> (assertion-violation #f "no who")
! no who
> (raise 'oops)
! non-condition value oops
> (let ((x)) x)
! invalid syntax (let ((x)) x)
> (syntax-violation 'check "bad form" '(check 1) 1)
! check: bad form 1 in (check 1)
> (raise (condition (make-message-condition "bad") (make-irritants-condition 5)))
! bad with irritants 5
> (define-record-type unprintable (fields a))
> (record-writer (record-type-descriptor unprintable)
    (lambda (r p wr) (car 0)))
; A raise while printing an error does not end Tuna.
> (raise (make-unprintable 1))
! condition that cannot be printed
; A warning does not stop the form.
> (begin (warning 'check "careful") x)
! check: careful
5
; After a read error the rest of the line is read as the next forms.
> #<y
! read: invalid sharp-sign prefix #<
! variable y is not bound
> x
5
