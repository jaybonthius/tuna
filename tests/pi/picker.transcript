> (define (write-file! path text) (call-with-output-file path (lambda (p) (display text p)) '(replace)))
> (define (run! command) (in-client (lambda () (commands:run command))))
> (define (session) (in-client completion:current-session))
> (define (wait-matches s) (wait-until (lambda () (and s (not (completion:session-busy? s))))))
> (define (match-list s) (let ([ms (completion:session-matches s)]) (do ([k (- (completion:matches-count ms) 1) (- k 1)] [acc '() (cons (completion:matches-ref ms k) acc)]) ((< k 0) acc))))
> (define (texts s) (map (lambda (m) (completion:text s m)) (match-list s)))
> (define (rows s) (map (lambda (m) (cons (completion:text s m) (completion:annotation s m))) (match-list s)))
> (define (titles s) (map (lambda (m) (completion:title s m)) (match-list s)))
> (define (main-view) (car (layout:views)))
> (define (asking question)
    (lambda ()
      (let ([s (text (buffers:find " *Minibuf*"))] [n (string-length question)])
        (and (>= (string-length s) n) (string=? (substring s 0 n) question)))))
