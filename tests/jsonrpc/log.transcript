; Each connection logs what it sent and received, one line each, in a
; silent buffer in jsonrpc:events-mode.
> (define c (start-fake! "fake" (jsonrpc:handlers)))
> (jsonrpc:request c "echo" '(("a" . 1)))
(("a" . 1))
> (log-lines c)
("--> {\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"echo\",\"params\":{\"a\":1}}" "<-- {\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"a\":1}}")
> (define events (jsonrpc:events-buffer c))
> (list (buffers:name events) (modes:major-mode events) (buffers:silent? events) (eq? events (jsonrpc:events-buffer c)))
("*fake events*" jsonrpc:events-mode #t #t)
; Bytes the program writes outside frames, with or without a line end,
; are logged as stray, and the frames after them are read.
> (jsonrpc:request c "raw" '(("texts" . #("starting up\n" "half a line"))))
"written"
> (jsonrpc:request c "echo" '#(2))
#(2)
; A body that is not JSON is logged, and reading goes on.
> (jsonrpc:request c "raw" '(("texts" . #("Content-Length: 4\r\n\r\nnope"))))
"written"
; The program's standard error is logged line by line as it arrives.
> (jsonrpc:request c "stderr" '(("text" . "warning: one\nwarning: two\n")))
"written"
> (wait-until (lambda () (member "stderr: warning: two" (log-lines c))))
> (filter (lambda (line) (not (or (string=? (substring line 0 4) "--> ") (string=? (substring line 0 4) "<-- ")))) (log-lines c))
("stray: starting up" "stray: half a line" "not JSON: unexpected #\\o at position 1" "stderr: warning: one" "stderr: warning: two")
; A frame error is logged, the first reported, and reading goes on. A
; length the reader will not take is no length, so the answer after its
; header block is read.
> (jsonrpc:request c "raw" '(("texts" . #("Content-Length: 99999999999\r\n\r\n"))))
! jsonrpc: fake broke the framing: frame of 99999999999 bytes is longer than frame-max-length, 268435456; its events log has the rest
"written"
; Output that mentions a header costs the frame it overlaps, here the
; answer, and not the connection.
> (raised (lambda () (jsonrpc:request c "raw" '(("texts" . #("debug: sent Content-Length: 5 bytes\n"))) 0.5)))
(timeout "raw")
> (jsonrpc:request c "echo" '#(3))
#(3)
; The stray output may arrive in one piece or two, so its lines are
; checked by their ends.
> (define (starts? prefix line)
    (and (>= (string-length line) (string-length prefix)) (string=? (substring line 0 (string-length prefix)) prefix)))
> (define (ends? suffix line)
    (let ([n (string-length line)] [k (string-length suffix)])
      (and (>= n k) (string=? (substring line (- n k) n) suffix))))
> (filter (lambda (line) (starts? "frame error: " line)) (log-lines c))
("frame error: frame of 99999999999 bytes is longer than frame-max-length, 268435456" "frame error: Content-Length \" 5 bytes\" is not a byte count")
> (and (member "<-- {\"jsonrpc\":\"2.0\",\"id\":6,\"result\":\"written\"}" (log-lines c)) #t)
#t
> (exists (lambda (line) (and (starts? "stray: " line) (ends? "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":\"written\"}" line)))
          (log-lines c))
#t
> (jsonrpc:running? c)
#t
; An answer no request waits for is logged with its id.
> (jsonrpc:request c "raw" '(("texts" . #("Content-Length: 36\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":99,\"result\":1}"))))
"written"
> (and (member "no request waits for: 99" (log-lines c)) #t)
#t
; q quits the log's view, and g reverts nothing.
> (layout:switch-to-buffer events)
> (shown)
"*fake events*"
> (press! "q")
> (equal? (shown) "*fake events*")
#f
> (guard (e [(error? e) (condition-message e)]) (buffers:with-buffer events (buffers:revert-buffer)))
"nothing reverts this buffer"
; The log keeps at most jsonrpc:events-log-size characters, the oldest
; lines going first; with 0 nothing is logged.
> (set-option! jsonrpc:events-log-size 120)
> (define small (start-fake! "small" (jsonrpc:handlers)))
> (begin (for-each (lambda (n) (jsonrpc:request small "echo" (vector n))) '(1 2 3 4)) (jsonrpc:running? small))
#t
> (log-lines small)
("--> {\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"echo\",\"params\":[4]}" "<-- {\"jsonrpc\":\"2.0\",\"id\":4,\"result\":[4]}")
> (<= (string-length (log-text small)) 120)
#t
> (set-option! jsonrpc:events-log-size 0)
> (define none (start-fake! "none" (jsonrpc:handlers)))
> (jsonrpc:request none "echo" '#(1))
#(1)
> (log-text none)
""
; Turning the log on reaches a running connection's reader, so what it
; receives next is logged.
> (set-option! jsonrpc:events-log-size 2000)
> (jsonrpc:request none "echo" '#(2))
#(2)
> (log-lines none)
("--> {\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"echo\",\"params\":[2]}" "<-- {\"jsonrpc\":\"2.0\",\"id\":2,\"result\":[2]}")
> (jsonrpc:stop! small)
> (jsonrpc:stop! none)
