; Each frame below is the first frame of the stand-in layout.
> (define one (layout:current-frame))
; Mouse items name mouse keys: the action, the press's click count and
; the modifiers, with Option as "alt".
> (keys:item-key '(("type" . "mouse") ("action" . "down") ("button" . 1) ("clicks" . 2) ("modifiers" . #("shift"))))
"S-<double-down-mouse-1>"
> (map (lambda (action clicks)
         (keys:item-key `(("type" . "mouse") ("action" . ,action) ("button" . 1) ("clicks" . ,clicks)
                          ("modifiers" . #("control" "alt" "super")))))
       '("click" "drag" "down" "click" "move")
       '(1 3 1 7 2))
("C-M-s-<mouse-1>" "C-M-s-<triple-drag-mouse-1>" "C-M-s-<down-mouse-1>" "C-M-s-<triple-mouse-1>" "C-M-s-<mouse-movement>")
> (raised (lambda () (keys:item-key '(("type" . "mouse") ("action" . "hover") ("button" . 1) ("clicks" . 1) ("modifiers" . #())))))
(keys:item-key "a mouse item without an action")
> (raised (lambda () (keys:item-key '(("type" . "mouse") ("action" . "down") ("clicks" . 1) ("modifiers" . #())))))
(keys:item-key "a mouse item without a button")
> (raised (lambda () (keys:item-key '(("type" . "mouse") ("action" . "down") ("button" . 1) ("clicks" . 0) ("modifiers" . #())))))
(keys:item-key "a mouse item without a click count")
> (raised (lambda () (keys:item-key '(("type" . "mouse") ("action" . "down") ("button" . 1) ("clicks" . 1) ("modifiers" . #("left-option"))))))
(keys:item-key "not a modifier name")
; An event is a mouse key and its position, or for a drag its start and
; end; keys reads the click count from the key's name.
> (define press '("S-<double-down-mouse-1>" #(3 1205)))
> (define drag '("<drag-mouse-1>" #(3 10) #(3 20)))
> (list (keys:event? press) (keys:event? drag) (keys:event? "<mouse-1>") (keys:event? '("<mouse-1>" #(3 1) #(3 2)))
        (keys:event? '("C-x" #(3 1))) (keys:event? '("<mouse-1>" 4)))
(#t #t #f #f #f #f)
> (list (keys:event-key press) (keys:event-start press) (keys:event-end press) (keys:event-clicks press))
("S-<double-down-mouse-1>" #(3 1205) #(3 1205) 2)
> (list (keys:event-start drag) (keys:event-end drag) (keys:event-clicks drag)
        (keys:event-clicks '("<triple-mouse-1>" #(1 1))) (keys:event-clicks '("<mouse-movement>" #(1 1))))
(#(3 10) #(3 20) 1 3 1)
> (raised (lambda () (keys:event-start "<mouse-1>")))
(keys:event-start "not an event")
> (raised (lambda () (keys:press! one '("<mouse-1>"))))
(keys:press! "neither one valid key nor an event")
; A command reads the event that ran it.
> (define seen '())
> (commands:define-command (record-event [event (keys:command-event)])
    "Records the event that ran it."
    (set! seen (cons (list event (keys:command-keys) (keys:shift-translated?)) seen)))
> (define (take-seen!) (let ([s (reverse seen)]) (set! seen '()) s))
> (keys:bind! keys:global "<mouse-1>" record-event)
> (keys:bind! keys:global "<down-mouse-1>" record-event)
> (keys:press! one '("<mouse-1>" #(3 7)))
> (take-seen!)
((("<mouse-1>" #(3 7)) "<mouse-1>" #f))
> (keys:command-event)
#f
; A key that nothing binds tries fewer clicks, then a drag as the click
; at its start, then the key without shift.
> (keys:press! one '("<triple-mouse-1>" #(3 7)))
> (keys:press! one '("S-<double-down-mouse-1>" #(3 8)))
> (keys:press! one '("<double-drag-mouse-1>" #(3 9) #(3 12)))
> (take-seen!)
((("<triple-mouse-1>" #(3 7)) "<triple-mouse-1>" #f) (("S-<double-down-mouse-1>" #(3 8)) "S-<double-down-mouse-1>" #t) (("<double-mouse-1>" #(3 9)) "<double-drag-mouse-1>" #f))
> (keys:bind! keys:global "<double-mouse-1>" keys:ignore)
> (keys:press! one '("<triple-mouse-1>" #(3 7)))
> (take-seen!)
()
; A press or a move that nothing binds is dropped without a warning and
; keeps the pending keys; an unbound click is undefined.
> (keys:unbind! keys:global "<down-mouse-1>")
> (keys:press! one "C-x")
> (keys:press! one '("<down-mouse-1>" #(3 1)))
> (keys:press! one '("<mouse-movement>" #(3 2)))
> (keys:pending one)
"C-x"
> (keys:press! one '("<mouse-3>" #(3 1)))
! C-x <mouse-3> is undefined
> (keys:pending one)
#f
; Mouse keys bind and look up as other named keys do, and keys:ignore
; stops one from reaching the keymaps searched later.
> (define-table near)
> (keys:bind! near "<mouse-1>" keys:ignore)
> (add-hook! keys:find-keymaps (lambda (client posn) (if posn (list near) '())))
> (keys:press! one '("<mouse-1>" #(3 7)))
> (take-seen!)
()
> (eq? (keys:lookup one "<mouse-1>") record-event)
#t
> (keys:press! one "<mouse-1>")
> (take-seen!)
(("<mouse-1>" "<mouse-1>" #f))
; A sequence is looked up in the keymaps of its first key: a mouse key
; after a typed prefix finds the keymaps a key typed finds.
> (keys:bind! keys:global "C-c <mouse-1>" record-event)
> (keys:press! one "C-c")
> (keys:press! one '("<mouse-1>" #(3 5)))
> (take-seen!)
((("<mouse-1>" #(3 5)) "C-c <mouse-1>" #f))
; Entries of keys:find-keymaps get the event's start position.
> (define posns '())
> (add-hook! keys:find-keymaps (lambda (client posn) (set! posns (cons posn posns)) '()))
> (keys:press! one '("<drag-mouse-1>" #(3 2) #(3 4)))
> (keys:press! one "C-x")
> (keys:press! one "o")
> (reverse posns)
(#(3 2) #f #f)
