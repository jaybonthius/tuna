(import (tuna) (test) (test-user) (views) (editing) (replace) (isearch-test) (replace-test))

(define asked replace-test:asked)

(define text replace-test:text)

(define (at! p) (views:set-point! (isearch-test:view) p))

(define (prompt-for from to) (string-append "Query replacing " from " with " to ": (? for help) "))

(test "M-% reads the text and its replacement, then asks about each match: y and SPC replace, n and DEL skip, ! replaces the rest"
  (isearch-test:show! "r" "foo bar foo Foo FOO foo\n")
  (replace-test:replace! "M-%" "foo")
  (check-equal? #f (isearch-test:prompt))
  (test-user:type! "baz")
  (test-user:press! "RET")
  (check-equal? (list 4 (prompt-for "foo" "baz") "foo") (asked))
  (test-user:press! "y")
  (check-equal? (list 12 (prompt-for "foo" "baz") "foo") (asked))
  (test-user:press! "n")
  (check-equal? (list 16 (prompt-for "foo" "Baz") "Foo") (asked))
  (test-user:press! "SPC DEL")
  (check-equal? (list 24 (prompt-for "foo" "baz") "foo") (asked))
  (isearch-test:take-said!)
  (test-user:press! "!")
  (check-equal? '("baz bar foo Baz FOO baz\n" ("Replaced 3 occurrences") #f)
                (list (text) (isearch-test:take-said!) (replace-test:session))))

(test ". replaces and ends; q and RET end"
  (isearch-test:show! "r2" "a1 a2 a3 a4\n")
  (replace-test:replace! "M-%" "a" "b")
  (isearch-test:take-said!)
  (test-user:press! ".")
  (check-equal? '("b1 a2 a3 a4\n" #f ("Replaced 1 occurrence")) (list (text) (replace-test:session) (isearch-test:take-said!)))
  (at! 1)
  (replace-test:replace! "M-%" "")
  (check-equal? (list 5 (prompt-for "a" "b") "a") (asked))
  (test-user:press! "q")
  (check-equal? '("b1 a2 a3 a4\n" #f) (list (text) (replace-test:session)))
  (at! 1)
  (replace-test:replace! "M-%" "")
  (test-user:press! "RET")
  (check-equal? #f (replace-test:session))
  (isearch-test:take-said!))

(test ", replaces and stays on the replacement; the next answer goes on without replacing it again"
  (isearch-test:show! "r2" "a1 a2 a3 a4\n")
  (replace-test:replace! "M-%" "a" "b")
  (test-user:press! "n ,")
  (check-equal? (list "a1 b2 a3 a4\n" (list 5 (prompt-for "a" "b") "b")) (list (text) (asked)))
  (test-user:press! "y")
  (check-equal? (list "a1 b2 a3 a4\n" (list 8 (prompt-for "a" "b") "a")) (list (text) (asked)))
  (test-user:press! "q")
  (isearch-test:take-said!))

(test "^ goes back to the previous match without undoing it; a replaced one shows its replacement, which the next answer passes"
  (isearch-test:show! "r3" "x1 x2 x3 x4\n")
  (replace-test:replace! "M-%" "x" "y")
  (test-user:press! "n y")
  (check-equal? (list 8 (prompt-for "x" "y") "x") (asked))
  (test-user:press! "^")
  (check-equal? (list 5 (prompt-for "x" "y") "y") (asked))
  (test-user:press! "^")
  (check-equal? (list 2 (prompt-for "x" "y") "x") (asked))
  (test-user:press! "y")
  (check-equal? (list "y1 y2 x3 x4\n" (list 8 (prompt-for "x" "y") "x")) (list (text) (asked)))
  (test-user:press! "y")
  (check-equal? (list "y1 y2 y3 x4\n" (list 11 (prompt-for "x" "y") "x")) (list (text) (asked)))
  (test-user:press! "q")
  (isearch-test:take-said!))

(test "u takes back the last replacement and asks about it again; U takes back all of them"
  (isearch-test:show! "r4" "x1 x2 x3\n")
  (replace-test:replace! "M-%" "x" "y")
  (test-user:press! "y y")
  (check-equal? (list "y1 y2 x3\n" (list 8 (prompt-for "x" "y") "x")) (list (text) (asked)))
  (test-user:press! "u")
  (check-equal? (list "y1 x2 x3\n" (list 5 (prompt-for "x" "y") "x") 1)
                (list (text) (asked) (replace:session-count (replace-test:session))))
  (test-user:press! "y y")
  (check-equal? '("y1 y2 y3\n" #f) (list (text) (replace-test:session)))
  (isearch-test:show! "r5" "x1 x2 x3\n")
  (replace-test:replace! "M-%" "x" "y")
  (test-user:press! "y n U")
  (check-equal? (list "x1 x2 x3\n" (list 2 (prompt-for "x" "y") "x") 0)
                (list (text) (asked) (replace:session-count (replace-test:session))))
  (test-user:press! "q")
  (isearch-test:take-said!))

(test "? shows the answers in the prompt until the next key"
  (isearch-test:show! "r6" "x1 x2\n")
  (replace-test:replace! "M-%" "x" "y")
  (test-user:press! "?")
  (check-equal? "y, Y or SPC replace" (substring (isearch-test:prompt) 0 19))
  (test-user:press! "n")
  (check-equal? (prompt-for "x" "y") (isearch-test:prompt))
  (test-user:press! "q")
  (isearch-test:take-said!))

(test "C-l recentres and the session stays"
  (isearch-test:show! "r6" "x1 x2\n")
  (replace-test:replace! "M-%" "x" "y")
  (test-user:press! "C-l")
  (check-equal? (list 2 (prompt-for "x" "y") "x") (asked))
  (test-user:press! "q")
  (isearch-test:take-said!))

(test "a key the keymap does not bind ends the session and then runs, the count said first"
  (isearch-test:show! "r6" "x1 x2\n")
  (replace-test:replace! "M-%" "x" "y")
  (isearch-test:take-said!)
  (test-user:press! "C-f")
  (check-equal? '(#f 3 "x1 x2\n" ("Replaced 0 occurrences")) (list (replace-test:session) (isearch-test:point) (text) (isearch-test:take-said!))))

(test "C-g ends the session and quits, keeping the replacements made"
  (isearch-test:show! "r6" "x1 x2\n")
  (replace-test:replace! "M-%" "x" "y")
  (test-user:press! "y")
  (isearch-test:cancelling! "C-g")
  (check-equal? '(#f "y1 x2\n") (list (replace-test:session) (text)))
  (isearch-test:take-said!))

(test "Y replaces as y does, and N and <delete> skip as n does"
  (isearch-test:show! "r7" "x1 x2 x3 x4\n")
  (replace-test:replace! "M-%" "x" "y")
  (test-user:press! "Y")
  (check-equal? (list "y1 x2 x3 x4\n" (list 5 (prompt-for "x" "y") "x")) (list (text) (asked)))
  (test-user:press! "N")
  (check-equal? (list 8 (prompt-for "x" "y") "x") (asked))
  (test-user:press! "<delete>")
  (check-equal? (list "y1 x2 x3 x4\n" (list 11 (prompt-for "x" "y") "x")) (list (text) (asked)))
  (test-user:press! "q")
  (isearch-test:take-said!))
