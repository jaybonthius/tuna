1
> (map (lambda (v) (cons (views:id v) (buffers:name (views:buffer v)))) (layout:views))
((1 . "fourth") (4 . "*Pager*") (3 . "notes") (5 . "*Echo*"))
; switch-to-buffer shows the buffer in the selected view; in a locked
; view, it displays it elsewhere and selects that view: the display acts
; in the level of the view the user was in, so it takes that level's
; view selected least recently.
> (layout:switch-to-buffer notes)
> (cons (selected) (buffers:name (views:buffer (layout:selected-view))))
(3 . "notes")
> (layout:select! echo)
> (layout:switch-to-buffer mail)
> (cons (selected) (buffers:name (views:buffer (layout:selected-view))))
(1 . "mail")
> (buffers:name (views:buffer echo))
"*Echo*"
; The documented example of a rule.
> (define (compilation-buffer? buffer)
    (string=? (buffers:name buffer) "*compilation*"))
> (table-set! layout:display-rules compilation-buffer? layout-split:display-below)
> (define compilation (buffers:make "*compilation*" "make\n"))
> (layout:select! (layout:display-buffer compilation))
> (cons (selected) (buffers:name (views:buffer (layout:selected-view))))
(6 . "*compilation*")
; reset-layout deletes the other views of the selected view's level and
; ends the zoom; the parts outside the level stay.
> (commands:run layout:zoom)
> (commands:run layout:reset-layout)
> (tree)
(layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 6) (buffer . "*compilation*")))) #(views:view ((view . 5) (buffer . "*Echo*") (depth . 90) (size . content) (locked . #t)))))
> (selected)
6
> (map views:id (layout:views))
(6 5)
; From the echo area, locked and in the root's level, reset-layout acts
; in the level of the view the user was in, here holding only that view,
; and selects it.
> (layout:select! echo)
> (define before (tree))
> (commands:run layout:reset-layout)
> (equal? (tree) before)
#t
