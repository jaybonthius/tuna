; A face is a name, defined by the faces plugin as a value, so code
; names it by identifier and the compiler checks it.
> (list faces:keyword faces:keyword.return faces:diagnostic.error faces:function.builtin)
(keyword keyword.return diagnostic.error function.builtin)
; A highlighter's spans name faces; views draws each as data-face.
> (buffers:define-layer highlights)
> (define buffer (buffers:make "greet.scm" "(define name \"Tuna\")\n"))
> (buffers:set-spans! (buffers:layer buffer highlights) 0 22
    (list (list 2 8 (list (cons 'face faces:keyword)))
          (list 14 20 (list (cons 'face faces:string)))))
#t
> (define view (views:make buffer))
> (lines view)
"<div class=\"line\" id=\"v1-1\" data-line=\"1\" data-at=\"1\"><span class=\"cursor primary\"></span>(<span data-face=\"keyword\">define</span> name <span data-face=\"string\">\"Tuna\"</span>)</div><div class=\"line\" id=\"v1-2\" data-line=\"2\"><br></div>"
; A list of faces draws as nested elements, the first innermost, so its
; rules win: bold and italic from one highlighter, a misspelling over a
; keyword.
> (buffers:set-spans! (buffers:layer buffer highlights) 0 22
    (list (list 2 8 (list (cons 'face (list 'spell.misspelled faces:keyword))))
          (list 14 20 (list (cons 'face (list faces:markup.strong faces:markup.italic))))))
#t
> (lines view)
"<div class=\"line\" id=\"v1-1\" data-line=\"1\" data-at=\"1\"><span class=\"cursor primary\"></span>(<span data-face=\"keyword\"><span data-face=\"spell.misspelled\">define</span></span> name <span data-face=\"markup.italic\"><span data-face=\"markup.strong\">\"Tuna\"</span></span>)</div><div class=\"line\" id=\"v1-2\" data-line=\"2\"><br></div>"
; A face the face entry draws as nothing adds no element, in a list as
; alone.
> (define face-attributes (table-ref views:span-properties 'face #f))
> (table-set! views:span-properties 'face
    (lambda (face) (if (eq? face 'spell.misspelled) '() (face-attributes face))))
> (buffers:set-spans! (buffers:layer buffer highlights) 0 22
    (list (list 2 8 (list (cons 'face (list 'spell.misspelled faces:keyword))))
          (list 14 20 (list (cons 'face 'spell.misspelled)))))
#t
> (lines view)
"<div class=\"line\" id=\"v1-1\" data-line=\"1\" data-at=\"1\"><span class=\"cursor primary\"></span>(<span data-face=\"keyword\">define</span> name \"Tuna\")</div><div class=\"line\" id=\"v1-2\" data-line=\"2\"><br></div>"
> (table-set! views:span-properties 'face face-attributes)
; Every face is a top-level definition, and the plugin's stylesheet styles
; the families; turning it off takes the stylesheet back.
> (table-ref web:stylesheets 'faces #f)
"faces/faces.css"
> (unload-module! '(faces))
> (table-ref web:stylesheets 'faces #f)
#f
