(((init) override #f) ((spell) define #f))
> (set! spell:dictionary-path (lambda () "/usr/share/dict/words"))
> (advice-add! files:save! announce)
> (module-changes '(repl))
((advice files:save! #<procedure announce>) (override spell:dictionary-path #f))
