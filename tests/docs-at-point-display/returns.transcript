; Docs cleared while the user is away from their place show again on the
; way back, though nothing asks again there.
> (press! "C-f")
> (testing:wait-until (lambda () (echo-area:current-message)))
> (echo-area:current-message)
"alpha: (alpha x)"
> (define plain (buffers:make "plain" "x\n"))
> (views:set-buffer! other-view plain)
> (buffers:with-buffer plain (set-option-local! docs-at-point:mode #f))
> (press! "C-x" "o")
> (sleep-for 0.3)
> (press! "C-f")
> (sleep-for 0.3)
> (list (buffers:name (views:buffer (view))) (echo-area:current-message))
("plain" #f)
> (set! asked '())
> (press! "C-x" "o")
> (sleep-for 0.3)
> (list (buffers:name (views:buffer (view))) asked (echo-area:current-message))
("notes" () "alpha: (alpha x)")
; g in *Docs*, about another view, shows in the echo area: the user asked.
> (press! "C-h" ".")
> (sleep-for 0.3)
> (layout:select! (car (views:showing (buffers:find "*Docs*"))))
> (press! "g")
> (sleep-for 0.3)
> (list (buffers:name (views:buffer (view))) (echo-area:current-message))
("*Docs*" "alpha: (alpha x)")
> (layout:select! notes-view)
; With after-edits-only?, a command that reads at a prompt and then edits
; counts as an edit, as one without a prompt does.
> (commands:define-command (ins) "Inserts text read at a prompt." (let ([s (minibuffer:read "Text: ")]) (editing:insert! (view) s)))
> (keys:bind! keys:global "C-c i" ins)
> (set-option! docs-at-point:after-edits-only? #t)
> (define t (start! (lambda () (press! "C-c" "i"))))
> (type! "q")
> (set! asked '())
> (press! "RET")
> (sleep-for 0.3)
> (list (buffers:name (views:buffer (view))) (document:text (buffers:document notes)) (length asked))
("notes" "aqlpha beta\ngamma\n" 1)
> (commands:define-command (ins2) "Inserts q." (editing:insert! (view) "q"))
> (keys:bind! keys:global "C-c j" ins2)
> (set! asked '())
> (press! "C-c" "j")
> (sleep-for 0.3)
> (list (document:text (buffers:document notes)) (length asked))
("aqqlpha beta\ngamma\n" 1)
