; The configuration makes layout-split:display-right the display action and
; shows pager buffers below.
> (eq? (layout:display-action) layout-split:display-right)
#t
> (define notes (buffers:make "notes" "one\n"))
> (define mail (buffers:make "mail" "Dear Harpo,\n"))
> (define pager pager:buffer)
> (layout:switch-to-buffer (buffers:make "*scratch*" ""))
> (views:id (layout:display-buffer notes))
3
> (tree)
(layout:level () (layout-split:container ((direction . row)) #(views:view ((view . 1) (buffer . "*Pager*"))) #(views:view ((view . 3) (buffer . "notes")))))
> (selected)
1
; A buffer already shown is shown where it is.
> (views:id (layout:display-buffer notes))
3
> (layout:reuse-view mail)
#f
> (views:id (layout:reuse-view notes))
3
; A rule whose predicate accepts the buffer comes first.
> (views:id (layout:display-buffer pager))
4
> (tree)
(layout:level () (layout-split:container ((direction . row)) (layout-split:container ((direction . column)) #(views:view ((view . 1) (buffer . "*Pager*"))) #(views:view ((view . 4) (buffer . "*Pager*")))) #(views:view ((view . 3) (buffer . "notes")))))
; Rules are tried newest first, then the caller's action, then the
; option's, then the selected view.
> (define tried '())
> (define (declining name) (lambda (b) (set! tried (cons name tried)) #f))
> (define (always b) #t)
> (table-set! layout:display-rules always (declining 'older))
> (define (also-always b) #t)
> (table-set! layout:display-rules also-always (declining 'newer))
> (set-option! layout:display-action (declining 'option))
> (layout:display-buffer mail (declining 'caller))
#<view 1>
> (reverse tried)
(newer older caller option)
> (tree)
(layout:level () (layout-split:container ((direction . row)) (layout-split:container ((direction . column)) #(views:view ((view . 1) (buffer . "*Pager*"))) #(views:view ((view . 4) (buffer . "*Pager*")))) #(views:view ((view . 3) (buffer . "notes")))))
> (raised (lambda () (layout:display-buffer mail (lambda (b) 'nonsense))))
(layout:display-buffer "an action returned what is not a view or #f")
> (raised (lambda () (layout:display-buffer 'mail)))
(layout:display-buffer "not a buffer")
> (table-remove! layout:display-rules always)
> (table-remove! layout:display-rules also-always)
; use-other-view reuses a view showing the buffer, else the view selected
; least recently, never the selected one or a locked one.
> (remove-option! layout:display-action)
> (eq? (layout:display-action) layout-split:display-right)
#t
> (set-option! layout:display-action layout:use-other-view)
