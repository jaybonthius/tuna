; After a command, once Tuna has been idle the delay, the sources are
; asked with the selected view, and the displays get the view and the
; docs, the user not having asked.
> (define asked '())
> (define (signature view)
    (set! asked (cons (views:id view) asked))
    (docs-at-point:make-doc (format "at ~a" (views:point view))))
> (hooks:add! docs-at-point:sources signature)
> (press! "C-f")
> (testing:wait-until (lambda () (pair? shown)))
> (list asked (displayed) (views:id (view)))
((1) ((1 ("at 2") #f)) 1)
; A new choice calls the displays again; the same docs do not.
> (press! "C-f")
> (testing:wait-until (lambda () (pair? shown)))
> (displayed)
((1 ("at 3") #f))
; With after-edits-only?, a motion asks nothing and a typed character
; does.
> (options:set! docs-at-point:after-edits-only? #t)
> (set! asked '())
> (press! "C-f")
> (timers:sleep 0.3)
> (list asked (displayed))
(() ())
> (press! "x")
> (testing:wait-until (lambda () (pair? shown)))
> (list asked (displayed))
((1) ((1 ("at 5") #f)))
> (options:set! docs-at-point:after-edits-only? #f)
; With the mode off nothing is asked after a command; ask-sources still
; asks, and says the user asked.
> (options:set! docs-at-point:mode #f)
> (set! asked '())
> (press! "C-b")
> (timers:sleep 0.3)
> (list asked (displayed))
(() ())
> (docs-at-point:ask-sources (view))
> (testing:wait-until (lambda () (pair? shown)))
> (list asked (displayed))
((1) ((1 ("at 4") #t)))
> (options:set! docs-at-point:mode #t)
> (hooks:remove! docs-at-point:sources signature)
; Under first, the docs of the first entry with any show once every
; entry before it has answered; a fast entry after a slow one waits.
> (define slow-answer "slow")
> (define (slow view) (timers:sleep 0.3) (and slow-answer (docs-at-point:make-doc slow-answer)))
> (define (fast view) (docs-at-point:make-doc "fast"))
> (hooks:add! docs-at-point:sources slow -1)
> (hooks:add! docs-at-point:sources fast)
> (docs-at-point:ask-sources (view))
> (timers:sleep 0.1)
> (displayed)
()
> (testing:wait-until (lambda () (pair? shown)))
> (displayed)
((1 ("slow") #t))
> (set! slow-answer #f)
> (docs-at-point:ask-sources (view))
> (timers:sleep 0.1)
> (displayed)
()
> (testing:wait-until (lambda () (pair? shown)))
> (displayed)
((1 ("fast") #t))
; Under all, a slow entry holds back no fast one: each change of the
; choice shows.
> (set! slow-answer "slow")
> (options:set! docs-at-point:strategy docs-at-point:all)
> (docs-at-point:ask-sources (view))
> (timers:sleep 0.1)
> (displayed)
((1 ("fast") #t))
> (testing:wait-until (lambda () (pair? shown)))
> (displayed)
((1 ("slow" "fast") #t))
; An answer that comes after point has moved is ignored.
> (docs-at-point:ask-sources (view))
> (timers:sleep 0.1)
> (displayed)
((1 ("fast") #t))
> (views:set-point! (view) 2)
> (timers:sleep 0.4)
> (displayed)
()
; A source that raises is reported, and the others' docs show.
> (define (broken view) (car '()))
> (hooks:add! docs-at-point:sources broken -2)
> (hooks:remove! docs-at-point:sources slow)
> (docs-at-point:ask-sources (view))
! car: () is not a pair
> (testing:wait-until (lambda () (pair? shown)))
> (displayed)
((1 ("fast") #t))
; The displays get the view the sources were asked for, which need not be
; the selected one.
> (hooks:remove! docs-at-point:sources broken)
> (define v2 (layout-split:split-view! (view) (layout-split:direction row)))
> (docs-at-point:ask-sources v2)
> (testing:wait-until (lambda () (pair? shown)))
> (equal? (displayed) (list (list (views:id v2) '("fast") #t)))
#t
> (eq? (view) v2)
#f
; Within one ask, a choice equal to the last one does not call the
; displays again: under all, a second entry answering none leaves the
; first's docs, which show once.
> (hooks:remove! docs-at-point:sources fast)
> (define steady (docs-at-point:make-doc "steady"))
> (define (first-answer view) steady)
> (define (later-none view) (timers:sleep 0.2) #f)
> (hooks:add! docs-at-point:sources first-answer -1)
> (hooks:add! docs-at-point:sources later-none)
> (docs-at-point:ask-sources (view))
> (timers:sleep 0.4)
> (displayed)
((1 ("steady") #t))
