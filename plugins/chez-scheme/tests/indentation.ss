(import (tuna) (test) (test-user) (options) (ask) (hooks) (tables) (modes) (views) (layout) (buffers) (document) (indentation)
        (editing) (chez-scheme))

;; ask's own writer reports each message, such as the Mark set of
;; C-SPC, as a warning, which would fail the file.
(options:set! ask:message-writer (lambda (text) (void)))

(define (raised? who message)
  (lambda (c)
    (and (who-condition? c) (eq? who (condition-who c))
         (message-condition? c) (string=? message (condition-message c)))))

;; The cursors and the mark are marked with characters no case's text
;; holds.
(define cursor-mark #\x2038)
(define mark-mark #\xA6)

(define (show! marked)
  (test-user:press! "C-g")
  (let loop ([cs (string->list marked)] [i 1] [acc '()] [points '()] [mark #f])
    (cond
      [(null? cs)
       (let* ([b (buffers:make (buffers:free-name "case.ss") (list->string (reverse acc)))]
              [v (layout:selected-view)]
              [points (reverse points)])
         (modes:set-major-mode chez-scheme:mode b)
         (views:set-buffer! v b)
         (views:set-point! v (car points))
         (when mark (views:set-mark! v mark))
         (for-each (lambda (p) (views:add-cursor! v p)) (cdr points))
         b)]
      [(char=? (car cs) cursor-mark) (loop (cdr cs) i acc (cons i points) mark)]
      [(char=? (car cs) mark-mark) (loop (cdr cs) i acc points i)]
      [else (loop (cdr cs) (+ i 1) (cons (car cs) acc) points mark)])))

(define (shown)
  (let* ([v (layout:selected-view)] [doc (buffers:document (views:buffer v))]
         [points (map views:cursor-point (views:cursors v))])
    (let loop ([p 0] [acc '()])
      (if (= p (document:length doc))
          (apply string-append (reverse acc))
          (loop (+ p 1)
                (cons (string-append (if (memv p points) (string cursor-mark) "")
                                     (let ([t (document:token doc p)]) (if (char? t) (string t) "")))
                      acc))))))

(define (after marked keys)
  (show! marked)
  (test-user:press! keys)
  (shown))

(define cases
  '(
    ("eol after (define (f x)" "(define (f x)‸" "RET" "(define (f x)\n  ‸")
    ("eol after (define (f x), twice" "(define (f x)‸" "RET RET" "(define (f x)\n\n  ‸")
    ("M-2 RET" "(define (f x)‸" "M-2 RET" "(define (f x)\n\n  ‸")
    ("mid line before (g x)" "(define (f x) ‸(g x))" "RET" "(define (f x)\n  ‸(g x))")
    ("mid line, blanks on both sides" "(define (f x)  ‸ (g x))" "RET" "(define (f x)\n  ‸(g x))")
    ("inside a string" "(define (f x)\n  (display \"hello‸ world\"))" "RET" "(define (f x)\n  (display \"hello\n‸ world\"))")
    ("inside a string, after a blank" "(display \"hello ‸world\")" "RET" "(display \"hello\n‸world\")")
    ("inside a string, before blanks" "(display \"hello‸   world\")" "RET" "(display \"hello\n‸   world\")")
    ("eol inside an open string" "(define (f x)\n  (display \"hello‸" "RET" "(define (f x)\n  (display \"hello\n‸")
    ("ending a line that starts in a string" "(f \"a\n   b ‸c\")" "RET" "(f \"a\n   b\n‸c\")")
    ("in a trailing comment" "(define (f x) ; a comm‸ent here\n  x)" "RET" "(define (f x) ; a comm\n  ‸ent here\n  x)")
    ("in a trailing comment, after a blank" "(f x) ; one‸ two" "RET" "(f x) ; one\n‸two")
    ("eol after a trailing comment" "(define (f x) ; c‸" "RET" "(define (f x) ; c\n  ‸")
    ("eol of a ;; comment line in a body" "(define (f x)\n  ;; note‸\n  x)" "RET" "(define (f x)\n  ;; note\n  ‸\n  x)")
    ("eol of a ; comment line in a body" "(define (f x)\n  ; note‸\n  x)" "RET" "(define (f x)\n                                        ; note\n  ‸\n  x)")
    ("eol of a ;;; comment line" ";;; Header‸" "RET" ";;; Header\n‸")
    ("eol after (let ((a 1))" "(define (f x)\n  (let ((a 1))‸" "RET" "(define (f x)\n  (let ((a 1))\n    ‸")
    ("eol after (let ((a 1)" "(define (f x)\n  (let ((a 1)‸" "RET" "(define (f x)\n  (let ((a 1)\n        ‸")
    ("eol after (let ([a 1]" "(define (f x)\n  (let ([a 1]‸" "RET" "(define (f x)\n  (let ([a 1]\n        ‸")
    ("eol after (let ((a 1) (b 2))" "(let ((a 1)\n      (b 2))‸" "RET" "(let ((a 1)\n      (b 2))\n  ‸")
    ("eol after (let loop ((i 0))" "(let loop ((i 0))‸" "RET" "(let loop ((i 0))\n  ‸")
    ("eol after a named let's first body form" "(let loop ((i 0))\n  (f i)‸" "RET" "(let loop ((i 0))\n  (f i)\n  ‸")
    ("eol after (let" "(let‸" "RET" "(let\n    ‸")
    ("eol after (let loop" "(let loop‸" "RET" "(let loop\n    ‸")
    ("eol after (let ()" "(let ()‸" "RET" "(let ()\n  ‸")
    ("eol after let's bindings on their own line" "(let\n    ((a 1))‸" "RET" "(let\n    ((a 1))\n  ‸")
    ("eol after [let ([a 1])" "[let ([a 1])‸" "RET" "[let ([a 1])\n  ‸")
    ("eol after (if c" "(if c‸" "RET" "(if c\n    ‸")
    ("(if c RET a RET" "(if c‸" "RET a RET" "(if c\n    a\n    ‸")
    ("eol after (if c a" "(if c a‸" "RET" "(if c a\n    ‸")
    ("eol after (if" "(if‸" "RET" "(if\n ‸")
    ("eol after (lambda (x)" "(lambda (x)‸" "RET" "(lambda (x)\n  ‸")
    ("eol after (lambda" "(lambda‸" "RET" "(lambda\n    ‸")
    ("eol after (when c" "(when c‸" "RET" "(when c\n  ‸")
    ("eol after (when c, then a body form" "(when c\n  a‸" "RET" "(when c\n  a\n  ‸")
    ("eol after (unless c" "(unless c‸" "RET" "(unless c\n  ‸")
    ("eol after (case x" "(case x‸" "RET" "(case x\n  ‸")
    ("eol after (do ((i 0 (+ i 1)))" "(do ((i 0 (+ i 1)))‸" "RET" "(do ((i 0 (+ i 1)))\n    ‸")
    ("eol after do's test" "(do ((i 0 (+ i 1)))\n    ((= i n))‸" "RET" "(do ((i 0 (+ i 1)))\n    ((= i n))\n  ‸")
    ("eol after (syntax-rules ()" "(define-syntax m\n  (syntax-rules ()‸" "RET" "(define-syntax m\n  (syntax-rules ()\n    ‸")
    ("eol after (syntax-case x ()" "(syntax-case x ()‸" "RET" "(syntax-case x ()\n  ‸")
    ("eol after (library (foo)" "(library (foo)‸" "RET" "(library (foo)\n  ‸")
    ("eol after (library (foo) (export f)" "(library (foo)\n  (export f)‸" "RET" "(library (foo)\n  (export f)\n  ‸")
    ("eol after (library" "(library‸" "RET" "(library\n    ‸")
    ("eol after (dynamic-wind" "(dynamic-wind‸" "RET" "(dynamic-wind\n    ‸")
    ("eol after (define-record-type point" "(define-record-type point‸" "RET" "(define-record-type point\n  ‸")
    ("eol after (define-syntax m" "(define-syntax m‸" "RET" "(define-syntax m\n  ‸")
    ("eol after (define-foo x" "(define-foo x‸" "RET" "(define-foo x\n  ‸")
    ("eol after (define x" "(define x‸" "RET" "(define x\n  ‸")
    ("eol after (def a" "(def a‸" "RET" "(def a\n     ‸")
    ("eol after (defin a" "(defin a‸" "RET" "(defin a\n  ‸")
    ("eol after (let-values (((a b) (f)))" "(let-values (((a b) (f)))‸" "RET" "(let-values (((a b) (f)))\n  ‸")
    ("eol after (parameterize ([p 1])" "(parameterize ([p 1])‸" "RET" "(parameterize ([p 1])\n  ‸")
    ("eol after (call-with-values" "(call-with-values‸" "RET" "(call-with-values\n    ‸")
    ("eol after (case-lambda" "(case-lambda‸" "RET" "(case-lambda\n ‸")
    ("eol after (with-x a" "(with-x a‸" "RET" "(with-x a\n        ‸")
    ("eol after (cond" "(cond‸" "RET" "(cond\n ‸")
    ("eol after (cond [a" "(cond [a‸" "RET" "(cond [a\n       ‸")
    ("eol after (foo a" "(foo a‸" "RET" "(foo a\n     ‸")
    ("eol after (foo" "(foo‸" "RET" "(foo\n ‸")
    ("eol after a call's second line" "(foo a\n     b‸" "RET" "(foo a\n     b\n     ‸")
    ("eol after a head alone, then a line of arguments" "(foo\n     bar baz‸" "RET" "(foo\n bar baz\n ‸")
    ("eol after ( foo a, a blank after the bracket" "( foo a‸" "RET" "( foo a\n  ‸")
    ("eol after (f, then a line of arguments" "(f\n  a b‸" "RET" "(f\n a b\n ‸")
    ("eol after (f a, then a line of arguments" "(f a\n b c‸" "RET" "(f a\n   b c\n   ‸")
    ("eol after ((f x)" "((f x)‸" "RET" "((f x)\n ‸")
    ("eol after ((a) b" "((a) b‸" "RET" "((a) b\n ‸")
    ("eol after ((a), then b" "((a)\n b‸" "RET" "((a)\n b\n ‸")
    ("eol after (\"s\" a" "(\"s\" a‸" "RET" "(\"s\" a\n ‸")
    ("eol after (1 2" "(1 2‸" "RET" "(1 2\n   ‸")
    ("eol after (#t a" "(#t a‸" "RET" "(#t a\n    ‸")
    ("eol after '(a b" "'(a b‸" "RET" "'(a b\n    ‸")
    ("eol after #(1 2" "#(1 2‸" "RET" "#(1 2\n    ‸")
    ("eol after #'(f a" "#'(f a‸" "RET" "#'(f a\n     ‸")
    ("eol after `(f ,(g a" "`(f ,(g a‸" "RET" "`(f ,(g a\n        ‸")
    ("eol after (f #;(a b)" "(f #;(a b)‸" "RET" "(f #;(a b)\n ‸")
    ("eol after (f #| c |# a" "(f #| c |# a‸" "RET" "(f #| c |# a\n           ‸")
    ("eol after (f \"x\"" "(f \"x\"‸" "RET" "(f \"x\"\n   ‸")
    ("eol after (f a ; c" "(f a ; c‸" "RET" "(f a ; c\n   ‸")
    ("nested (f (g (h x" "(f (g (h x‸" "RET" "(f (g (h x\n         ‸")
    ("after a closed argument, (f (g x)" "(f (g x)‸" "RET" "(f (g x)\n   ‸")
    ("after a complete top-level form" "(define x 1)‸" "RET" "(define x 1)\n‸")
    ("at the start of the buffer" "‸(f x)" "RET" "\n‸(f x)")
    ("a blank line between forms" "(define x 1)\n‸\n(define y 2)" "RET" "(define x 1)\n\n‸\n(define y 2)")
    ("a blank line in a body" "(define (f x)\n‸\n  x)" "RET" "(define (f x)\n\n  ‸\n  x)")
    ("an indented blank line in a body" "(define (f x)\n    ‸\n  x)" "RET" "(define (f x)\n\n  ‸\n  x)")
    ("at the start of an indented line" "(define (f x)\n‸  (g x))" "RET" "(define (f x)\n\n  ‸(g x))")
    ("inside the indentation" "(define (f x)\n ‸ (g x))" "RET" "(define (f x)\n\n  ‸(g x))")
    ("ending a misindented line" "(define (f x)\n      (g x)‸" "RET" "(define (f x)\n  (g x)\n  ‸")
    ("ending a line with trailing blanks" "(define (f x)   ‸" "RET" "(define (f x)\n  ‸")
    ("before closing brackets" "(define (f x)\n  (g x‸))" "RET" "(define (f x)\n  (g x\n     ‸))")
    ("before the last closing bracket" "(define (f x)\n  (g x)‸)" "RET" "(define (f x)\n  (g x)\n  ‸)")
    ("ending a line that closes the form" "(define (f x)\n      (g x))‸" "RET" "(define (f x)\n  (g x))\n‸")
    ("in a block comment, a line that starts in a comment begun above is left as it is, where Emacs indents it as code" "(f #| a\n      b ‸c |# x)" "RET" "(f #| a\n      b\n‸c |# x)")
    ("with a region, RET leaves it" "(define (f x) ‸(g x))" "C-SPC C-e RET" "(define (f x) (g x))\n‸")
    ("eol after (options:define-option name #f boolean?" "(options:define-option on-type-formatting? #f boolean?‸" "RET" "(options:define-option on-type-formatting? #f boolean?\n  ‸")
    ("eol after (define-condition-type &c &error" "(define-condition-type &c &error‸" "RET" "(define-condition-type &c &error\n  ‸")
    ("eol after (define x 1" "(define x 1‸" "RET" "(define x 1\n  ‸")
    ("eol after (define-foo a b" "(define-foo a b‸" "RET" "(define-foo a b\n  ‸")
    ("eol after (define" "(define‸" "RET" "(define\n  ‸")
    ("eol after a define's first argument on its own line" "(define\n  x‸" "RET" "(define\n  x\n  ‸")
    ("eol after (define (f x) (g x)" "(define (f x) (g x)‸" "RET" "(define (f x) (g x)\n  ‸")
    ("eol after two body forms on the second line" "(define (f x)\n  (g x) (h x)‸" "RET" "(define (f x)\n  (g x) (h x)\n  ‸")
    ("eol after (syntax-rules" "(syntax-rules‸" "RET" "(syntax-rules\n  ‸")
    ("eol after a syntax-rules clause" "(define-syntax m\n  (syntax-rules ()\n    [(_ a) a]‸" "RET" "(define-syntax m\n  (syntax-rules ()\n    [(_ a) a]\n    ‸")
    ("eol after (def a b" "(def a b‸" "RET" "(def a b\n     ‸")
    ("eol after a tab and blanks" "(list\n\t(g a\n\t   b‸" "RET" "(list\n\t(g a\n\t   b\n           ‸")
    ("eol after a let's bindings indented with a tab" "(define (f)\n\t(let ((a 1)\n\t      (b 2))‸" "RET" "(define (f)\n\t(let ((a 1)\n\t      (b 2))\n          ‸")
    ("a line break deleted again after a question joins the two atoms" "(foo‸bar" "RET DEL DEL C-e RET" "(foobar\n ‸")
    ("a line break deleted again after a question joins the two atoms of list-ref" "(list‸-ref xs 1" "RET DEL DEL C-e RET" "(list-ref xs 1\n          ‸")
    ("an undone blank, after a question, joins the two atoms" "(foo‸bar" "SPC TAB C-/ C-e RET" "(foobar\n ‸")
    ("a line starting with an opening bracket in column 0 starts a form even inside a string, where Emacs leaves the next line at 0" "(define x \"a\n(b‸" "RET" "(define x \"a\n(b\n ‸")
    ("TAB in the indentation" "(define (f x)\n  ‸    (g x))" "TAB" "(define (f x)\n  ‸(g x))")
    ("TAB in the text" "(define (f x)\n      (g‸ x))" "TAB" "(define (f x)\n  (g‸ x))")
    ("TAB at the end of the text" "(define (f x)\n(g x)‸)" "TAB" "(define (f x)\n  (g x)‸)")
    ("TAB at top level" "   (d‸efine x 1)" "TAB" "(d‸efine x 1)")
    ("TAB on a line in a string" "(f \"a\n      b‸\")" "TAB" "(f \"a\n      b‸\")")
    ("TAB on a ; line" "(define (f x)\n; n‸ote\n  x)" "TAB" "(define (f x)\n                                        ; n‸ote\n  x)")
    ("TAB on a top-level ; line leaves the cursor at the end of the indentation, where Emacs leaves it after the ;" "‸; foo\n(f x)" "TAB" "                                        ‸; foo\n(f x)")
    ("TAB on a ;;; line" "(define (f x)\n    ;;‸; note\n  x)" "TAB" "(define (f x)\n    ;;‸; note\n  x)")
    ("TAB on a ;; line" "(define (f x)\n    ;;‸ note\n  x)" "TAB" "(define (f x)\n  ;;‸ note\n  x)")
    ("TAB on a #| line" "(define (f x)\n‸#| c |#\n  x)" "TAB" "(define (f x)\n  ‸#| c |#\n  x)")
    ("TAB on a #; line" "(define (f x)\n‸#;(a)\n  x)" "TAB" "(define (f x)\n  ‸#;(a)\n  x)")
    ("TAB on a line already indented" "(define (f x)\n  (g‸ x))" "TAB" "(define (f x)\n  (g‸ x))")
    ("TAB on a line indented with a tab" "(define (f x)\n\t‸(g x))" "TAB" "(define (f x)\n  ‸(g x))")
    ("TAB with a region" "(define (f x)\n‸(g x)\n(h x))" "C-SPC C-n C-e TAB" "(define (f x)\n  (g x)\n  (h x))‸")
    ("TAB with a region ending at a line's start" "(define (f x)\n(g‸ x)\n(h x))" "C-SPC C-n C-a TAB" "(define (f x)\n  (g x)\n‸(h x))")
    ("TAB on options:define-option's doc line" "(options:define-option delete-selection #f boolean?\n‸\"When true.\")" "TAB" "(options:define-option delete-selection #f boolean?\n  ‸\"When true.\")")
    ("TAB under a tab-indented call" "(list\n\t(g a\n‸b)" "TAB" "(list\n\t(g a\n           ‸b)")
    ("TAB on a tab-indented line already at its column" "(list\n\t(g a\n\t   ‸b)" "TAB" "(list\n\t(g a\n\t   ‸b)")
    ("TAB with a region keeps each cursor's place, as Emacs's indent-region does: in the indentation, before the blanks a line gains" "(define (f x)\n‸(g x)\n(h x))¦" "TAB" "(define (f x)\n‸  (g x)\n  (h x))")
    ("TAB with a region whose first line is already right" "(define (f x)\n‸  (g x)\n(h x))¦" "TAB" "(define (f x)\n‸  (g x)\n  (h x))")
    ("TAB with a region, a cursor inside indentation that shrinks" "(define (f x)\n    ‸  (g x)\n(h x))¦" "TAB" "(define (f x)\n  ‸(g x)\n  (h x))")
    ("a line starting with an opening bracket in column 0 starts a form inside a #| comment, where Emacs puts the next line at 2" "(define (f)\n  #|\n(g a\n‸b|#\n  1)" "TAB" "(define (f)\n  #|\n(g a\n   ‸b|#\n  1)")
    ("a line starting with an opening bracket in column 0 starts a form inside a #; comment, where Emacs puts the next line at 2" "(define (f)\n  #;\n(g a\n‸b)\n  1)" "TAB" "(define (f)\n  #;\n(g a\n   ‸b)\n  1)")
    ("one undo takes back the break and the indentation together" "(define (f x)\n      (g x)‸" "RET C-/" "(define (f x)\n      (g x)‸")
    ("each cursor's line is indented" "(define (f x)‸\n  (let ((a 1))‸" "RET" "(define (f x)\n  ‸\n  (let ((a 1))\n    ‸")
    ("TAB acts at each cursor" "(define (f x)\n‸(g x)\n   (h x)‸)" "TAB" "(define (f x)\n  ‸(g x)\n  (h x)‸)")))

(for-each
  (lambda (example)
    (apply
      (lambda (name before keys expected)
        (test (string-append "RET and TAB in a Scheme buffer as Emacs's Scheme mode gives them: " name)
          (check-equal? expected (after before keys))))
      example))
  cases)

(define rule-cases
  '(
    ("a form the table names" "(my-form a‸" "RET" "(my-form a\n  ‸")
    ("a name the table names, after a prefix" "(buffers:with-buffer b‸" "RET" "(buffers:with-buffer b\n  ‸")
    ("a name starting with def, after a prefix" "(commands:define-command (f)‸" "RET" "(commands:define-command (f)\n  ‸")
    ("a prefixed name with no rule" "(foo:with-x a‸" "RET" "(foo:with-x a\n            ‸")
    ("guard, by the table" "(guard (e [#t 0])‸" "RET" "(guard (e [#t 0])\n  ‸")
    ("let, after a prefix" "(x:let loop ((i 0))‸" "RET" "(x:let loop ((i 0))\n  ‸")))

(tables:set! chez-scheme:indent-rules 'my-form 1)

(for-each
  (lambda (example)
    (apply
      (lambda (name before keys expected)
        (test (string-append "the indent rules: " name)
          (check-equal? expected (after before keys))))
      example))
  rule-cases)

(tables:remove! chez-scheme:indent-rules 'my-form)

(test "a rule that returns no count raises, and the indenter takes a buffer"
  (tables:set! chez-scheme:indent-rules 'my-form (lambda (buffer bracket) 'many))
  (let ([b (show! "(my-form a\nb\x2038;")])
    (check-raises (raised? 'chez-scheme:indenter "the rule did not return a count") (chez-scheme:indenter b 12)))
  (tables:remove! chez-scheme:indent-rules 'my-form)
  (check-raises (raised? 'chez-scheme:indenter "not a buffer") (chez-scheme:indenter 'b 1)))

(test "a line that starts in a string is left as it is"
  (let ([b (show! "(f \"a\n      b\")\x2038;")])
    (check-equal? #f (chez-scheme:indenter b 7))))

(tables:define-table derived-keymap)
(hooks:define-hook derived-hook)
(modes:define-major-mode derived (parent chez-scheme:mode) (keymap derived-keymap) (hook derived-hook))

(test "the indenter is chez-scheme:mode's, and a mode derived from it uses it"
  (check (eq? chez-scheme:indenter (indentation:indenter chez-scheme:mode)))
  (check (eq? chez-scheme:indenter (indentation:indenter derived))))

(test "a line whose text already starts at its column is not edited"
  (let* ([b (show! "(define (f x)\n  (g x)\x2038;")] [version (buffers:version b)])
    (test-user:press! "TAB")
    (check-equal? (list version #f) (list (buffers:version b) (buffers:modified? b)))))
