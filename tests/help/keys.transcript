; C-h k reads a whole key sequence and shows in *Help* what it runs in
; the selected view, with the module that bound it and the command's
; description. *Help* goes below, by the configuration's display rule,
; and keeps its point at the start.
> (define notes (buffers:make "notes" "one\ntwo\n"))
> (layout:switch-to-buffer notes)
> (modes:set-major-mode harpo:mode notes)
> (start! "C-h" "k")
> (press! "C-c" "h")
> (settle)
> (help)
# C-c h runs the command harpo:honk, bound by (harpo)
<harpo:honk> is a command in (harpo).
It is on [C-c h].
It is for <harpo:mode>.
Honks once.
> (list (shown) (views:point (help-view)))
((("notes" #t) ("*Help*" #f)) 2)
; Bound by the configuration or the REPL, a binding names them.
> (keys:bind! harpo:keymap "C-c h" harpo:quiet)
> (in-client (lambda () (help:describe-key "C-c h" (view))))
> (title)
"C-c h runs the command harpo:quiet, bound by (repl)"
> (keys:unbind! harpo:keymap "C-c h")
; A sequence found through <printing-char>, shift or Meta names no
; binder. ESC makes the next key Meta only while it is neither a quit
; key nor bound.
> (define (title-of keys) (in-client (lambda () (help:describe-key keys (view)))) (title))
> (set-option! keys:quit-keys '("C-g"))
> (keys:unbind! keys:global "ESC")
> (map title-of '("x" "S-<right>" "ESC x" "M-x" "C-x C-f"))
("x runs the command editing:self-insert" "S-<right> runs the command editing:forward-char" "ESC x runs the command command-picker:execute-extended-command" "M-x runs the command command-picker:execute-extended-command, bound by (command-picker)" "C-x C-f runs the command file-picker:find-file, bound by (file-picker)")
> (set-option! keys:quit-keys '("C-g" "ESC"))
> (keys:bind! keys:global "ESC" keys:keyboard-quit)
; A prefix lists the bindings after it, as C-h b lists them: one section
; per keymap, a sequence an earlier keymap decides left out of a later.
> (keys:bind! harpo:keymap "C-x h" harpo:honk)
> (in-client (lambda () (help:describe-key "C-x" (view))))
> (help)
# Key bindings starting with C-x
## harpo:mode
[C-x h]  <harpo:honk>
## keys:global
[C-x o]    <layout:other-view>
[C-x 0]    <layout:delete-view>
[C-x 1]    <layout:zoom>
[C-x w w]  <layout:part-mode>
[C-x 2]    <layout-split:split-below>
[C-x 3]    <layout-split:split-right>
[C-x }]    <layout-split:enlarge>
[C-x {]    <layout-split:shrink>
[C-x +]    <layout-split:balance>
[C-x w t]  <layout-split:transpose>
[C-x u]    <undo:undo>
[C-x C-x]  <editing:exchange-point-and-mark>
[C-x C-t]  <editing:transpose-lines>
[C-x C-u]  <editing:upcase-region>
[C-x C-l]  <editing:downcase-region>
[C-x C-w]  <files:write-file>
[C-x C-s]  <files:save-buffer>
[C-x s]    <files:save-some-buffers>
[C-x C-c]  <files:save-buffers-kill-tuna>
[C-x C-f]  <file-picker:find-file>
; A click is looked up at its position, here in notes, whose mode binds
; it.
> (keys:bind! harpo:keymap "<mouse-1>" harpo:honk)
> (in-client (lambda () (help:describe-key (list "<mouse-1>" (views:%make-posn (view) 2)) (view))))
> (title)
"<mouse-1> at that spot runs the command harpo:honk, bound by (repl)"
; A keymap marked on the element clicked, as a tab's close button carries
; one, answers first, and C-h k says who bound the key there.
> (define-table close-keys "A close button's keys.")
> (keys:bind! close-keys "<mouse-1>" keys:ignore)
> (in-client (lambda () (help:describe-key (list "<mouse-1>" (views:%make-posn (view) 2 #f (list close-keys) #f #f)) (view))))
> (title)
"<mouse-1> at that spot runs the command keys:ignore, bound by (repl)"
; Reading reads past a press to the click that ends it, and describes
; the click.
> (in-client (lambda () (help:describe-key "C-x" (view))))
> (start! "C-h" "k")
> (press! (list "<down-mouse-1>" (views:%make-posn (view) 2)) (list "<mouse-1>" (views:%make-posn (view) 2)))
> (settle)
> (title)
"<mouse-1> at that spot runs the command harpo:honk, bound by (repl)"
; Keys that run nothing are said to be undefined in the echo area, and
; *Help* stays as it was.
> (start! "C-h" "k")
> (press! "C-c" "z")
> (settle)
> (list (message) (title))
("C-c z is undefined" "<mouse-1> at that spot runs the command harpo:honk, bound by (repl)")
; A quit key cancels C-h k, describing nothing.
> (start! "C-h" "k")
> (press! "C-g")
> (settle)
! &quit
> (title)
"<mouse-1> at that spot runs the command harpo:honk, bound by (repl)"
> (start! "C-h" "k")
> (press! "C-x" "C-g")
> (settle)
! &quit
> (title)
"<mouse-1> at that spot runs the command harpo:honk, bound by (repl)"
> (start! "C-h" "k")
> (press! "ESC")
> (settle)
! &quit
> (title)
"<mouse-1> at that spot runs the command harpo:honk, bound by (repl)"
; C-h k and C-h c ask in the echo area, and the keys read so far show
; after the question.
> (start! "C-h" "k")
> (echo)
"Describe the following key or mouse click: "
> (press! "C-x")
> (echo)
"Describe the following key or mouse click: C-x-"
> (press! "C-g")
> (settle)
! &quit
> (echo)
"Quit"
; C-h c shows the first line in the echo area, without the binder.
> (start! "C-h" "c")
> (keys:reading-prompt client)
"Describe the following key or mouse click: "
> (press! "C-x" "C-f")
> (settle)
> (message)
"C-x C-f runs file-picker:find-file"
> (in-client (lambda () (help:describe-key-briefly "C-c z" (view))))
> (message)
"C-c z is undefined"
> (in-client (lambda () (help:describe-key-briefly "C-x" (view))))
> (message)
"C-x is a prefix"
; C-h w reads a command and shows the keys that run it.
> (start! "C-h" "w")
> (type! "file-picker:find-file")
> (press! "RET")
> (settle)
> (message)
"file-picker:find-file is on C-x C-f"
> (in-client (lambda () (help:where-is harpo:quiet (view))))
> (message)
"harpo:quiet is on no key"
; A prefix then the help key describes the prefix; any key bound to
; help:keymap is the help key.
> (press! "C-x" "C-h")
> (title)
"Key bindings starting with C-x"
> (press! "C-h" "C-h")
> (title)
"Key bindings starting with C-h"
> (keys:bind! keys:global "<f1>" help:keymap)
> (press! "C-x" "<f1>")
> (title)
"Key bindings starting with C-x"
> (press! "C-c" "z")
! C-c z is undefined
> (message)
"C-c z is undefined"
; Arguments are checked.
> (raised (lambda () (help:describe-key 'x (view))))
(help:describe-key "neither a key sequence nor an event")
> (raised (lambda () (help:describe-key "C-x" 'x)))
(help:describe-key "not a view")
> (raised (lambda () (help:describe-key-briefly 'x (view))))
(help:describe-key-briefly "neither a key sequence nor an event")
> (raised (lambda () (help:where-is 'x (view))))
(help:where-is "not a command")
