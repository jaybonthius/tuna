; The user removes the setup, binds a key, and
; turns fill mode on in every buffer that derives from prog:mode.
> (remove-hook! python:mode-hook python:setup)
> (keys:bind! python:keymap "C-c C-u" editing:upcase-region)
> (add-hook! prog:mode-hook (lambda () (set-option-local! fill:mode #t)))
> (modes:set-major-mode python:mode build)
> (list (local fill:mode build) (local fill:column build))
(#t 70)
> (commands:command-name (in-frame (lambda () (keys:lookup client "C-c C-u"))))
editing:upcase-region
; Auto-mode as its documented examples use it.
> (import (archive) (make) (html))
> (define (python-by-content buffer name)
    (let* ([doc (buffers:document buffer)]
           [start (document:text doc 0 (min 7 (document:length doc)))])
      (and (string=? start "import") python:mode)))
> (add-hook! auto-mode:choosers python-by-content 50)
> (disk:write-text! "~/setup-tool" "import os\n")
> (modes:major-mode (files:visit "~/setup-tool"))
python:mode
