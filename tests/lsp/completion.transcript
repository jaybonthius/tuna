> (lsp:define-server alpha (fake-command "alpha"))
> (define (item label . more) (append `(("label" . ,label)) more))
> (define (completion-config result)
    `((capabilities ("textDocumentSync" . 2) ("completionProvider" ("triggerCharacters" . #("."))) ("executeCommandProvider" ("commands" . #("server.cmd"))))
      (responses ("textDocument/completion" . ,result))))
> (define (configure-completion! result) (with-output-to-file (config-of "alpha") (lambda () (write (completion-config result))) 'replace))
> (configure-completion! (vector (item "apple") (item "apricot") (item "banana")))
> (table-set! lsp:language-servers "fakelang" (list alpha))
> (add-hook! fake-mode-hook lsp:ensure)
> (write-file! (string-append project "/a.fk") "\n")
> (define a (visit! (string-append project "/a.fk")))
> (wait-for "alpha" "textDocument/didOpen")
; A complete list is asked once and filtered as typing goes on.
> (type! "ap")
> (press! "C-M-i")
> (wait-matches (session))
> (texts (session))
("apple" "apricot")
> (type! "r")
> (wait-matches (session))
> (list (texts (session)) (length (of-method "alpha" "textDocument/completion")))
(("apricot") 1)
> (press! "M-n" "RET")
> (text a)
"apricot\n"
; An incomplete list is asked again at each change of the input.
> (configure-completion! '(("isIncomplete" . #t) ("items" . #((("label" . "cherry")) (("label" . "chestnut"))))))
> (press! "RET")
> (type! "ch")
> (press! "C-M-i")
> (wait-matches (session))
> (type! "e")
> (wait-matches (session))
> (length (of-method "alpha" "textDocument/completion"))
3
> (press! "C-g")
; A text edit is counted on the text the request saw, so it applies after
; more typing; extra edits, such as an import, and a command follow.
> (define ran '())
> (table-set! lsp:commands "server.cmd" (lambda (c arguments) (set! ran (cons (vector->list arguments) ran))))
> (configure-completion! (vector `(("label" . "datetime")
                                   ("textEdit" ("range" ("start" ("line" . 1) ("character" . 0)) ("end" ("line" . 1) ("character" . 2))) ("newText" . "datetime.now"))
                                   ("additionalTextEdits" . #((("range" ("start" ("line" . 0) ("character" . 0)) ("end" ("line" . 0) ("character" . 0))) ("newText" . "import datetime\n"))))
                                   ("command" ("title" . "x") ("command" . "server.cmd") ("arguments" . #(1 2))))))
> (define (fresh!)
    (buffers:replace! a 1 (- (document:length (buffers:document a)) 1) "x\nda\n")
    (in-client (lambda () (views:set-point! (view) 5))))
> (fresh!)
> (press! "C-M-i")
> (wait-matches (session))
> (type! "t")
> (wait-matches (session))
> (press! "M-n" "RET")
> (wait-until (lambda () (pair? ran)))
> (list (text a) ran)
("import datetime\nx\ndatetime.now\n" ((1 2)))
; Without a local procedure a command goes to the server.
> (table-remove! lsp:commands "server.cmd")
> (fresh!)
> (press! "C-M-i")
> (wait-matches (session))
> (press! "M-n" "RET")
> (wait-for "alpha" "workspace/executeCommand")
> (ref (last-of "alpha" "workspace/executeCommand") "params")
(("command" . "server.cmd") ("arguments" . #(1 2)))
; A server's trigger character starts completion as soon as it is typed,
; with no text before point, where a symbol's first character starts none.
> (set-option! completion-popup:auto-delay 0.01)
> (configure-completion! (vector (item "now") (item "today")))
> (buffers:replace! a 1 (- (document:length (buffers:document a)) 1) "\n")
#<edit 22>
> (in-client (lambda () (views:set-point! (view) 1)))
> (type! "d")
> (sleep-for 0.2)
> (session)
#f
> (type! ".")
> (wait-until (lambda () (session)))
> (wait-matches (session))
> (texts (session))
("now" "today")
> (press! "C-g")
> (set-option! completion-popup:auto-delay #f)
