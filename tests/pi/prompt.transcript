; A chat killed in the batch it moves into a session that keeps a draft
; saves that draft before its own prompt's text.
> (define chat-id (pi:chat-session-id chat))
> (define again-buffer (pi-chat:buffer again))
> (add-hook! pi:chat-changed (lambda (c) (when (and (eq? c again) (equal? (pi:chat-session-id c) chat-id) (buffers:live? again-buffer)) (buffers:kill! again-buffer))))
> (fake-state-set! (fake-of again) (list (cons "sessionId" chat-id)))
> (define moving (start! (lambda () (pi:switch-session! again (string-append "/sessions/" chat-id ".jsonl")))))
> (wait-until (lambda () (not (buffers:live? again-buffer))))
> (sleep-for 0.1)
> (list (cdr (assoc chat-id (pi-chat:drafts))) (assoc "s-after" (pi-chat:drafts)))
