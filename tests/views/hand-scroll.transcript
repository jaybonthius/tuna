; A buffer whose point is a list's selected row sets
; views:hand-scroll-moves-point to #f locally: a hand scroll at rest
; places the view and leaves point where it was.
> (define b (buffers:make "rows" (lines 300)))
> (buffers:with-buffer b (set-option-local! views:hand-scroll-moves-point #f))
> (define v (views:make b))
> (report! desktop v 1 0 #f)
> (placement v desktop)
(new follow 1)
> (report! desktop v 151 5 #f)
> (report! desktop v 151 5 #t)
> (list (line-of v (views:top v)) (line-of v (views:point v)))
(151 1)
; Later reports leave point out of view, and the view does not follow it.
> (report! desktop v 151 5 #t)
> (report! desktop v 160 0 #t)
> (list (placement v desktop) (line-of v (views:top v)) (line-of v (views:point v)))
((same follow 1) 160 1)
; C-v, a scroll command, still moves point into what the browser then
; shows.
> (define (run command) (views:with-view v (as-client desktop (lambda () (commands:run command)))))
> (run views:scroll-up)
> (placement v desktop)
(new position 178)
> (report! desktop v 178 0 #f)
> (line-of v (views:point v))
180
; A command that moves point makes the view follow it again.
> (as-client desktop (lambda () (views:set-point! v (line-start v 20))))
> (placement v desktop)
(new follow 20)
; At #t, the default, a hand scroll at rest moves point into view.
> (buffers:with-buffer b (set-option-local! views:hand-scroll-moves-point #t))
> (report! desktop v 20 0 #f)
> (report! desktop v 100 0 #f)
> (report! desktop v 100 0 #t)
> (line-of v (views:point v))
102
