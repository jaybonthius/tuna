(import (tuna) (test) (test-user) (options) (saved) (tables) (keys) (commands) (buffers) (views) (layout) (editing) (undo) (echo-area) (ask)
        (minibuffer) (minibuffer-test reading))

(define (raised? who message)
  (lambda (c)
    (and (who-condition? c) (eq? who (condition-who c))
         (message-condition? c) (string=? message (condition-message c)))))

(define (ask text)
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: ")))])
    (test-user:type! text)
    (test-user:press! "RET")
    (minibuffer-test/reading:result r)))

(define (prompt-view) (minibuffer:prompt-view (minibuffer-test/reading:prompt)))

(define (point-in-input) (- (views:point (prompt-view)) (minibuffer:input-start (minibuffer-test/reading:prompt))))

(test "the reading procedures check their arguments"
  (check-raises (raised? 'minibuffer:read "not a string") (minibuffer:read 'name))
  (check-raises (raised? 'minibuffer:read "neither saved data nor #f") (minibuffer:read "Name: " '()))
  (check-raises (raised? 'minibuffer:read "neither a string nor #f") (minibuffer:read "Name: " minibuffer:history 3))
  (check-raises (raised? 'minibuffer:buffer? "not a buffer") (minibuffer:buffer? "notes"))
  (check-raises (raised? 'minibuffer:input "not a prompt") (minibuffer:input 'p))
  (check-raises (raised? 'minibuffer:call-with-setup "not a procedure") (minibuffer:call-with-setup 1 void))
  (check-raises (raised? 'minibuffer:prompt-default "not a prompt") (minibuffer:prompt-default 'no))
  (check-raises (raised? 'minibuffer:prompt-selected-view "not a prompt") (minibuffer:prompt-selected-view 'no))
  (check-raises (raised? 'minibuffer:read-number "neither a real number nor #f") (minibuffer:read-number "Count: " minibuffer:history "7")))

(test "a read shows its question with an empty input, selects the prompt's view with point in the input, and clears the echo area"
  (test-user:show! "one\n|two")
  (let ([before (layout:selected-view)])
    (echo-area:message! "Saved")
    (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: ")))])
      (check-equal? '("Name: ") (minibuffer-test/reading:questions))
      (check-equal? "" (minibuffer-test/reading:input))
      (check (eq? (layout:selected-view) (prompt-view)))
      (check (eq? before (minibuffer:prompt-selected-view (minibuffer-test/reading:prompt))))
      (check-equal? 0 (point-in-input))
      (check-equal? #f (echo-area:current-message))
      (test-user:type! "abc")
      (test-user:press! "RET")
      (check-equal? "abc" (minibuffer-test/reading:result r))
      (check-equal? #f (minibuffer-test/reading:prompt))
      (check (eq? before (layout:selected-view))))))

(test "edits cannot cross the input's edges: C-d at its end and DEL or C-b at its start say so and change nothing"
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: ")))])
    (test-user:type! "ab")
    (check-equal? '("end of buffer") (minibuffer-test/reading:report-messages (lambda () (test-user:press! "C-d"))))
    (test-user:press! "C-a")
    (check-equal? 0 (point-in-input))
    (check-equal? '("beginning of buffer" "beginning of buffer")
      (minibuffer-test/reading:report-messages (lambda () (test-user:press! "DEL") (test-user:press! "C-b"))))
    (check-equal? "ab" (minibuffer-test/reading:input))
    (check-equal? 0 (point-in-input))
    (test-user:press! "C-e M-<")
    (check-equal? 0 (point-in-input))
    (minibuffer-test/reading:quit! r)))

(test "undo undoes the input's edits and says so at the prompt's start"
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: ")))])
    (test-user:type! "ab")
    (test-user:press! "C-/")
    (check-equal? "" (minibuffer-test/reading:input))
    (check-equal? '("no further undo information") (minibuffer-test/reading:report-messages (lambda () (test-user:press! "C-/"))))
    (check-equal? "" (minibuffer-test/reading:input))
    (minibuffer-test/reading:quit! r)))

(test "RET answers; the history holds each answer once, newest first, at most minibuffer:history-length; an empty answer adds nothing"
  (saved:set! minibuffer:history '())
  (check-equal? 100 (options:default minibuffer:history-length))
  (for-each (lambda (text) (check-equal? text (ask text))) '("xy" "b" "c" "b" ""))
  (check-equal? '("b" "c" "xy") (minibuffer:history))
  (options:set! minibuffer:history-length 2)
  (check-equal? "d" (ask "d"))
  (check-equal? '("d" "b") (minibuffer:history))
  (options:unset! minibuffer:history-length))

(test "M-p and M-n walk the history keeping what was typed, with point at the input's end; past either end they say so"
  (saved:set! minibuffer:history '("d" "b" "a"))
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: ")))])
    (test-user:type! "typed")
    (test-user:press! "C-a M-p")
    (check-equal? "d" (minibuffer-test/reading:input))
    (check-equal? 1 (point-in-input))
    (test-user:press! "M-p")
    (check-equal? "b" (minibuffer-test/reading:input))
    (test-user:press! "M-n M-n")
    (check-equal? "typed" (minibuffer-test/reading:input))
    (test-user:press! "M-2 M-p")
    (check-equal? "b" (minibuffer-test/reading:input))
    (test-user:press! "M-p")
    (check-equal? '("beginning of history") (minibuffer-test/reading:report-messages (lambda () (test-user:press! "M-p"))))
    (check-equal? "a" (minibuffer-test/reading:input))
    (test-user:press! "M-n M-n M-n")
    (check-equal? '("end of history") (minibuffer-test/reading:report-messages (lambda () (test-user:press! "M-n"))))
    (check-equal? "typed" (minibuffer-test/reading:input))
    (minibuffer-test/reading:quit! r)))

(test "with a default, an empty input answers with it and adds it to the history, and M-n past what was typed inserts it"
  (saved:set! minibuffer:history '("older"))
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: " minibuffer:history "fallback")))])
    (check-equal? "fallback" (minibuffer:prompt-default (minibuffer-test/reading:prompt)))
    (test-user:press! "RET")
    (check-equal? "fallback" (minibuffer-test/reading:result r))
    (check-equal? '("fallback" "older") (minibuffer:history)))
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: " #f "fallback")))])
    (test-user:type! "typed")
    (test-user:press! "M-n")
    (check-equal? "fallback" (minibuffer-test/reading:input))
    (check-equal? '("end of defaults") (minibuffer-test/reading:report-messages (lambda () (test-user:press! "M-n"))))
    (test-user:press! "M-p")
    (check-equal? "typed" (minibuffer-test/reading:input))
    (check-equal? '("beginning of history") (minibuffer-test/reading:report-messages (lambda () (test-user:press! "M-p"))))
    (minibuffer-test/reading:quit! r)))

(test "read-entry's own entries come before the history under M-p and are never saved; one recalled as it was is given by position"
  (saved:set! minibuffer:history '("hi"))
  (let ([r (minibuffer-test/reading:start! (lambda () (call-with-values (lambda () (minibuffer:read-entry "Pick: " minibuffer:history '("one" "two"))) list)))])
    (test-user:press! "M-p M-p")
    (check-equal? "two" (minibuffer-test/reading:input))
    (test-user:press! "M-p")
    (check-equal? "hi" (minibuffer-test/reading:input))
    (test-user:press! "M-n RET")
    (check-equal? '("two" 1) (minibuffer-test/reading:result r))
    (check-equal? '("hi") (minibuffer:history)))
  (let ([r (minibuffer-test/reading:start! (lambda () (call-with-values (lambda () (minibuffer:read-entry "Pick: " minibuffer:history '("one" "two"))) list)))])
    (test-user:type! "two")
    (test-user:press! "RET")
    (check-equal? '("two" #f) (minibuffer-test/reading:result r))
    (check-equal? "two" (car (minibuffer:history))))
  (let ([r (minibuffer-test/reading:start! (lambda () (call-with-values (lambda () (minibuffer:read-entry "Pick: " minibuffer:history '("one" "two"))) list)))])
    (test-user:press! "M-p")
    (test-user:type! "x")
    (test-user:press! "RET")
    (check-equal? '("onex" #f) (minibuffer-test/reading:result r))))

(test "exit! on a prompt that has ended raises"
  (let* ([p #f]
         [r (minibuffer-test/reading:start! (lambda () (minibuffer:call-with-setup (lambda (q) (set! p q)) (lambda () (minibuffer:read "Name: ")))))])
    (test-user:press! "RET")
    (check-equal? "" (minibuffer-test/reading:result r))
    (check-raises (raised? 'minibuffer:exit! "a prompt that has ended") (minibuffer:exit! p 1))))

(test "call-with-setup's setup runs before the prompt waits, as to give initial input with point at its end"
  (test-user:show! "|")
  (let ([r (minibuffer-test/reading:start!
             (lambda ()
               (minibuffer:call-with-setup (lambda (p) (minibuffer:set-input! p "journal"))
                 (lambda () (minibuffer:read "Rename buffer to: ")))))])
    (check-equal? "journal" (minibuffer-test/reading:input))
    (check-equal? 7 (point-in-input))
    (test-user:press! "RET")
    (check-equal? "journal" (minibuffer-test/reading:result r))))

(saved:define-saved rename-history '() list?)

(commands:define-command (rename-buffer [name (minibuffer:read "Rename buffer to: " rename-history)])
  "Renames the current buffer to NAME."
  (buffers:rename! (views:buffer (views:current)) name))

(test "a command reads its argument with a history of its own"
  (keys:bind! keys:global "C-c r" rename-buffer)
  (test-user:show! "text|")
  (let ([b (views:buffer (layout:selected-view))])
    (test-user:press! "C-c r")
    (test-user:type! "journal")
    (test-user:press! "RET")
    (check-equal? "journal" (buffers:name b))
    (check-equal? '("journal") (rename-history)))
  (keys:unbind! keys:global "C-c r"))

(test "a line break pasted into the input is text, which DEL deletes"
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: ")))])
    (views:call-with-view (layout:selected-view) (lambda () (commands:run editing:paste "a\n")))
    (check-equal? "a\n" (minibuffer-test/reading:input))
    (test-user:press! "DEL")
    (check-equal? "a" (minibuffer-test/reading:input))
    (minibuffer-test/reading:quit! r)))

(test "the prompts' buffer cannot be killed"
  (let ([b (buffers:find " *Minibuf*")])
    (check (minibuffer:buffer? b))
    (check-equal? #f (buffers:kill! b))
    (check (buffers:live? b))))

(test "read-number asks again until the input is a number, answers the default on RET, and keeps a history of its own"
  (saved:set! minibuffer:number-history '())
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read-number "Count: ")))])
    (test-user:type! "ten")
    (test-user:press! "RET")
    (check-equal? 'waiting (minibuffer-test/reading:result r))
    (check-equal? "" (minibuffer-test/reading:input))
    (test-user:type! "2.5")
    (test-user:press! "RET")
    (check-equal? 2.5 (minibuffer-test/reading:result r)))
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read-number "Count (default 7): " minibuffer:number-history 7)))])
    (check-equal? "7" (minibuffer:prompt-default (minibuffer-test/reading:prompt)))
    (test-user:press! "RET")
    (check-equal? 7 (minibuffer-test/reading:result r)))
  (let ([r (minibuffer-test/reading:start! (lambda () (ask:number "Columns: ")))])
    (test-user:type! "80")
    (test-user:press! "RET")
    (check-equal? 80 (minibuffer-test/reading:result r)))
  (check-equal? '("80" "7" "2.5" "ten") (minibuffer:number-history))
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read-number "Count: ")))])
    (test-user:press! "M-p")
    (check-equal? "80" (minibuffer-test/reading:input))
    (test-user:press! "RET")
    (check-equal? 80 (minibuffer-test/reading:result r))))

(test "minibuffer fills ask's line reader: a default answers an empty input, M-n inserts it, and the answer goes into the history"
  (let ([r (minibuffer-test/reading:start! (lambda () (ask:line "Rename to (default notes): " "notes")))])
    (test-user:press! "RET")
    (check-equal? "notes" (minibuffer-test/reading:result r)))
  (let ([r (minibuffer-test/reading:start! (lambda () (ask:line "Rename to (default notes): " "notes")))])
    (test-user:press! "M-n")
    (check-equal? "notes" (minibuffer-test/reading:input))
    (test-user:type! "-old")
    (test-user:press! "RET")
    (check-equal? "notes-old" (minibuffer-test/reading:result r))
    (check-equal? "notes-old" (car (minibuffer:history))))
  (let ([r (minibuffer-test/reading:start! (lambda () (ask:line "Rename to: ")))])
    (test-user:press! "RET")
    (check-equal? "" (minibuffer-test/reading:result r))))

(test "selecting a prompt while C-u C-x 1 zooms the screen ends the zoom"
  (test-user:press! "C-x 2 C-u C-x 1")
  (check (layout:zoomed-view))
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: ")))])
    (check-equal? #f (layout:zoomed-view))
    (minibuffer-test/reading:quit! r))
  (test-user:press! "C-x 1"))

(test "a prompt whose start raises leaves nothing behind"
  (tables:set! layout:display-rules minibuffer:buffer? (lambda (b) (error 'no-room "no room")))
  (let ([r (minibuffer-test/reading:start! (lambda () (minibuffer:read "Name: ")))])
    (check-raises (raised? 'no-room "no room") (minibuffer-test/reading:result r))
    (check-equal? #f (minibuffer:current-prompt))
    (check-equal? '() (test-user:elements (test-user:screen) "minibuffer-prompt")))
  (tables:remove! layout:display-rules minibuffer:buffer?))
