; A view draws items: each line of block content, and each node standing
; alone that is whole, an atom or of a kind that says (whole), in a
; div.node.whole. Any other node standing alone opens into its
; children's items. Items and nodes standing alone carry ids from
; anchors at their starts.
> (import (md))
> (define page
    (buffers:make "page"
      (md:doc '() (md:heading '() "Title\n") (md:para '() "one\ntwo\n")
        (md:grid '() (md:para '() "a\n") (md:para '() "b\n")) (md:image '((src . "x.png"))) (md:para '() "three\n"))))
> (define v (views:make page))
> (show v)
<div class="view nowrap" id="view-1" data-view="1" data-version="0" data-showing="0" data-placement="*" data-place-kind="follow" data-place-item="2" data-place-at="2" data-base-item="2" data-base-offset="0.0" data-base-height="0.0" data-base-left="0.0" data-scroll-margin="2" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end><div class="view-lines"><article><div class="node" id="v1-2" data-at="1" data-to="9"><div class="heading"><div class="line" id="v1-1" data-line="1" data-at="2"><span class="cursor primary"></span>Title</div></div></div><div class="node" id="v1-5" data-at="9" data-to="19"><div class="line" id="v1-3" data-line="2" data-at="10">one</div><div class="line" id="v1-4" data-line="3">two</div></div><div class="node whole" id="v1-10" data-at="19" data-to="29"><div class="grid"><div class="node" id="v1-7" data-at="20" data-to="24"><div class="line" id="v1-6" data-line="4" data-at="21">a</div></div><div class="node" id="v1-9" data-at="24" data-to="28"><div class="line" id="v1-8" data-line="5" data-at="25">b</div></div></div></div><div class="node whole" id="v1-11" data-at="29" data-to="30"><img src="x.png"></div><div class="node" id="v1-13" data-at="30" data-to="38"><div class="line" id="v1-12" data-line="6" data-at="31">three</div></div></article></div></div>
; A run's edges fall only between items, so a whole node is drawn all or
; not at all: with half a view height wanted beyond each edge, the run
; reaches into the grid of 30 lines and so draws all of it, and a run
; starting after the grid starts with it.
> (define long
    (buffers:make "long-page"
      (apply md:doc '()
        (append (map (lambda (i) (md:para '() (format "para ~a\n" i))) (iota 50))
                (list (apply md:grid '() (map (lambda (i) (md:para '() (format "cell ~a\n" i))) (iota 30))))
                (map (lambda (i) (md:para '() (format "after ~a\n" i))) (iota 50))))))
> (define w (views:make long))
> (views:set-option! w views:drawn-screens 0.5)
> (report! phone w 1 0 #f)
> (drawn w phone)
(1 18 18 () (2608))
> (report! phone w 40 0 #f)
> (drawn w phone)
(35 80 46 (688) (2608))
> (report! phone w 82 0 #f)
> (drawn w phone)
(51 97 47 (1004) (2608))
