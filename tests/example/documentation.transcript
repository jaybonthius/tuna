; These examples take the plugin greet as used.
> (use-plugin greet)
> (list (definition-documentation greet:text) (hooks:documentation files:after-save)
        (options:documentation fill:column))
("The greeting for a name." "Called with the path of each file saved." "Width of filled lines.")
> (tables:define-table colours "Named colours.")
> (hooks:define-hook after-paint "Called after painting.")
> (options:define-option shade 'light symbol? "How dark to paint.")
> (list (tables:documentation colours) (hooks:documentation after-paint) (options:documentation shade))
("Named colours." "Called after painting." "How dark to paint.")
; Redefining a function gives it the new definition's documentation.
> (eval-in-module '(define (text name) "A shorter greeting." (string-append "Hi, " name)) '(greet))
> (list (greet:text "x") (definition-documentation greet:text))
("Hi, x" "A shorter greeting.")
> (eval-in-module '(define (text name) (string-append "Hey, " name)) '(greet))
> (definition-documentation greet:text)
#f
