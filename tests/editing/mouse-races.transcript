; Mouse items across threads, quits and reloads.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)) (tuna eval))
> (define (mouse! action at . fields)
    (let ([v (view)])
      (parameterize ([web:current-client client])
        ((table-ref web:input-handlers "mouse") client
         (append fields
                 `(("type" . "mouse") ("action" . ,action) ("button" . 1) ("clicks" . 1) ("modifiers" . #())
                   ("view" . ,(views:id v)) ("version" . ,(buffers:version (views:buffer v)))
                   ("showing" . ,(views:shown-count v)) ("report" . 1)
                   ,@(if at `(("at" . ,at) ("count" . 0)) '())))))))
> (define (wait-until done?)
    (let loop ([n 0])
      (unless (or (done?) (= n 1000))
        (sleep-for 0.01)
        (loop (+ n 1)))))
> (define (on-thread thunk)
    (let ([result #f])
      (fork-thread (lambda () (set! result (raised thunk))))
      (wait-until (lambda () result))
      result))
> (start! "alpha beta gamma\ndelta epsilon\n" 1)
("alpha beta gamma\ndelta epsilon\n" ((1 #f)))
> (define posn (vector (views:id (view)) 3))
> (on-thread (lambda () (keys:press! client (list "<mouse-1>" posn))))
(keys:press! "not on the main thread")
; Reloading editing in the middle of a drag ends the drag: the moves
; that follow find no binding and are dropped, and the next press starts
; afresh.
> (define library (getenv "TUNA_LIBRARY"))
> (mouse! "down" 2)
> (mouse! "move" 5)
> (eval-file (string-append library "/editing.sls"))
> (mouse! "move" 9)
> (state)
("alpha beta gamma\ndelta epsilon\n" ((5 2)))
> (mouse! "down" 7)
> (mouse! "move" 11)
> (mouse! "drag" 11)
> (state)
("alpha beta gamma\ndelta epsilon\n" ((11 7)))
; Quits requested every 100 µs land in presses, moves, drags and clicks
; of every kind, in typing between them, and in the bookkeeping after
; each batch. Afterwards one cursor rests on a stop, at most one drag
; keymap is left, a click still moves point, and every report is a quit
; or a stale click. Typing does not replace a region here, so the text
; only grows and every place stays in it.
> (buffers:with-buffer (views:buffer (view))
    (set-option-local! undo:limit (greatest-fixnum))
    (set-option-local! editing:delete-selection #f))
> (define quits 0)
> (define others '())
> (define (count-quits report c)
    (if (quit-condition? c)
        (set! quits (+ quits 1))
        (let ([m (condition-message c)])
          (unless (member m others) (set! others (cons m others))))))
> (advice-add! report count-quits)
> (define armed (box #f))
> (define quitting (box #t))
> (define requests 0)
> (define (quitter)
    (let loop ()
      (when (unbox quitting)
        (chez:sleep (make-time 'time-duration 100000 0))
        (when (box-cas! armed #t #f)
          (request-quit!)
          (set! requests (+ requests 1)))
        (loop))))
> (define steps 0)
> (define gestures
    (list (lambda () (mouse! "down" 3) (mouse! "move" 9) (mouse! "drag" 12))
          (lambda () (mouse! "down" 4 '("clicks" . 2)) (mouse! "click" 4 '("clicks" . 2)))
          (lambda () (mouse! "down" 20 '("clicks" . 3)) (mouse! "move" 2) (mouse! "drag" #f '("clicks" . 3)))
          (lambda () (mouse! "down" 6 '("modifiers" . #("shift"))) (mouse! "click" 6 '("modifiers" . #("shift"))))
          (lambda () (press! "x" "DEL"))
          (lambda () (mouse! "down" 2) (press! "C-g") (mouse! "move" 8) (mouse! "click" 8))))
> (define (stress until)
    (let again ()
      (guard (c [(quit-condition? c) (set! quits (+ quits 1)) (again)])
        (let loop ()
          (when (< (real-time) until)
            (for-each (lambda (g) (set-box! armed #t) (g)) gestures)
            (sleep-for 0)
            (set! steps (+ steps 1))
            (loop)))
        (set-box! armed #f)
        (sleep-for 0.05))))
> (begin
    (fork-thread quitter)
    (stress (+ (real-time) 1500))
    (set-box! quitting #f)
    (list (> steps 10) (> requests 30) (> quits 30)))
(#t #t #t)
> (advice-remove! report count-quits)
> (filter (lambda (m) (not (equal? m "Stale click: what was clicked is gone"))) others)
()
> (let ([cs (views:cursors (view))])
    (list (length cs) (eqv? (buffers:stop (views:buffer (view)) (views:cursor-point (car cs))) (views:cursor-point (car cs)))))
(1 #t)
> (<= (length (keys:active-keymaps client)) 3)
#t
> (undo:go-to! (views:buffer (view)) 0)
> (text)
"alpha beta gamma\ndelta epsilon\n"
> (mouse! "down" 8)
> (mouse! "click" 8)
> (state)
("alpha beta gamma\ndelta epsilon\n" ((8 #f)))
