; A button or link whose disabled attribute is not #f is drawn
; aria-disabled. A click on it, or RET with point in it, runs nothing
; and leaves the selected view and point, since ui:disabled-keys is
; searched before the kind's keymap.
> (define d (buffers:make "*disabled*" (buffers:text '() "Off " (go '((n . 4) (disabled . #t)) "Go") " " (more '((n . 5) (disabled . yes)) "more") "\n")))
> (show! d)
> (element (view) "<button class=\"ui-button\"" "button")
"<button class=\"ui-button\" type=\"button\" tabindex=\"-1\" aria-disabled=\"true\"><span data-at=\"6\">Go</span></button>"
> (element (view) "<button class=\"ui-link\"" "button")
"<button class=\"ui-link\" type=\"button\" tabindex=\"-1\" aria-disabled=\"true\"><span data-at=\"11\">more</span></button>"
