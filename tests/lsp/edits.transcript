; The hint asks as a background request, triggerKind 2; a command asks
; with 1, as invoked.
> (map (lambda (m) (ref m "params" "context" "triggerKind")) (of-method "types" "textDocument/codeAction"))
(1 2)
; With lsp:code-action-hint? off, the hint asks nothing.
> (define asked (length (of-method "types" "textDocument/codeAction")))
> (with-options ([lsp:code-action-hint? #f]) (lsp:code-action-hint (view)))
#f
> (- (length (of-method "types" "textDocument/codeAction")) asked)
0
; A server's showMessageRequest asks with ask:choice and answers the
; action chosen.
> (lsp:notify c "fake/send"
    '(("message" ("jsonrpc" . "2.0") ("id" . "m1") ("method" . "window/showMessageRequest")
       ("params" ("type" . 3) ("message" . "Install stubs?") ("actions" . #((("title" . "Yes")) (("title" . "No"))))))))
> (wait-until (lambda () (minibuffer:current-prompt)))
> (press! "C-n" "RET")
> (wait-until (lambda () (exists (lambda (m) (equal? (ref m "id") "m1")) (received "types"))))
> (ref (find (lambda (m) (equal? (ref m "id") "m1")) (received "types")) "result")
(("title" . "No"))
; A server that answers prepareRename with nothing refuses before any
; name is asked.
> (configure! "types" '(capabilities ("textDocumentSync" . 2) ("renameProvider" ("prepareProvider" . #t)))
                       '(responses ("textDocument/prepareRename" . null))
                       '(name . "types"))
> (define opened (length (of-method "types" "textDocument/didOpen")))
> (lsp:reconnect (car (lsp:connections)))
