> (define (show-lines)
    (call-with-input-file "~/.config/tuna/init.ss"
      (lambda (p)
        (let loop ()
          (let ([form (read p)])
            (unless (eof-object? form)
              (when (and (pair? form) (eq? (car form) 'use-plugin))
                (write form)
                (newline))
              (loop)))))))
; plugins:install! writes its line after the last line, with the full
; commit, keeping the rest of the file, and loads nothing.
> (plugins:install! '(use-plugin vertico (git "https://github.com/minad/vertico")))
> (display (call-with-input-file "~/.config/tuna/init.ss" get-string-all))
(import (hooks) (options))
(import (tuna))
(use-plugin spell (git "https://github.com/bob/spell") (commit "3fd4dae"))
(use-plugin files)
(use-plugin fill)
(use-plugin prog)

(options:set! spell:language "en-GB"
             fill:column 80
             files:autosave-seconds 30)

(define spell:dictionary-path (lambda () "/home/groucho/words"))

(define (announce save! path)
  (display (string-append "saving " path))
  (save! path))
(advice-add! files:save! announce)

(hooks:remove! files:after-save spell:check)

(hooks:add! prog:mode-hook
  (lambda ()
    (options:set-local! fill:column 100)
    (hooks:add-local! files:before-save prog:indent-buffer -10)))

(use-plugin sources (git "https://github.com/groucho/tuna-sources"))
(use-plugin compat)
(use-plugin consult)
(use-plugin embark)
(use-plugin embark-consult)
(use-plugin vertico (git "https://github.com/minad/vertico") (commit "201f0e3a116cab75bedbdf71c0abca65edac1ec0"))
(import (console))
