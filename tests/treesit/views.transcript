; What views has drawn is coloured first: a view placed at line 1000 of
; a buffer of about 2,000 lines is drawn with a margin beyond each edge,
; and the job's first answer holds that range, already in its final
; colours.
> (define text (grown-text 60000))
> (define b (buffers:make "big.py" text))
> (define v (views:make b))
> (define first-faces #f)
> (define (snapshot-first! v)
    (set! first-faces #f)
    (set! on-set (lambda (start end)
                   (unless first-faces
                     (set! first-faces (map (lambda (r) (face-runs (views:buffer v) (car r) (cdr r))) (views:drawn-ranges v)))))))
> (begin
    (watch! b)
    (snapshot-first! v)
    (views:scroll-to! v (line-start b 1000) (views:align top))
    (show! desktop v)
    (modes:set-major-mode python:mode b))
> (settle b)
> (drawn-lines v)
((940 1060))
> (define first-set (car (sets)))
> (list (line-of b (car first-set)) (line-of b (- (cadr first-set) 1)))
(940 1060)
> (equal? first-faces (map (lambda (r) (face-runs b (car r) (cdr r))) (views:drawn-ranges v)))
#t
> (length (car first-faces))
313
; Once the buffer is coloured, a scroll that moves the drawn range runs
; views' hook, which sends the job one new input, and nothing is coloured.
> (define inputs 0)
> (advice-add! jobs:send!
    (lambda (send job message)
      (when (and (pair? message) (eq? (car message) 'input)) (set! inputs (+ inputs 1)))
      (send job message)))
> (report! desktop v 1300)
> (settle b)
> (list (drawn-lines v) inputs (sets))
(((1240 1360)) 1 ())
; Right after an edit that changes the structure, the job's first answer
; colours the whole drawn range, its margins included, so a short scroll
; either way shows current colours. The colours expected are those of a
; buffer opened on the edited text.
> (snapshot-first! v)
> (buffers:insert! b (line-start b 1300) "\"\"\"")
32191
> (settle b)
> (define fresh (python "fresh.py" (text-of b)))
> (settle fresh)
> (equal? first-faces (map (lambda (r) (face-runs fresh (car r) (cdr r))) (views:drawn-ranges v)))
#t
> (equal? (all-runs b) (all-runs fresh))
#t
> (report! desktop v 1290)
> (report! desktop v 1310)
> (settle b)
> (equal? (all-runs b) (all-runs fresh))
#t
; Two views of a buffer, on two devices: each drawn range is coloured
; before anything else, and both show the same colours, which belong to
; the buffer.
> (set! on-set #f)
> (define c (buffers:make "two.py" text))
> (define v2 (views:make c))
> (define w (views:make c))
> (begin
    (watch! c)
    (views:scroll-to! v2 (line-start c 1000) (views:align top))
    (views:scroll-to! w (line-start c 300) (views:align top))
    (show! desktop v2)
    (show! phone w)
    (modes:set-major-mode python:mode c))
> (settle c)
> (define ranges (append (views:drawn-ranges v2) (views:drawn-ranges w)))
> (map (lambda (r) (list (line-of c (car r)) (line-of c (- (cdr r) 1)))) ranges)
((940 1060) (240 360))
> (define (inside? s) (exists (lambda (r) (and (<= (car r) (car s)) (<= (cadr s) (cdr r)))) ranges))
> (map inside? (list-head (sets) 3))
(#t #t #f)
> (map (lambda (html) (and (search html "data-face=\"function\"" 0) #t)) (list (html-of v2 desktop) (html-of w phone)))
(#t #t)
; Back to a buffer in a view's history, its colours show at once: the
; buffer kept them, and its job goes on.
> (define other (python "other.py" "x = 1\n"))
> (settle other)
> (job-events)
(start start start start)
> (views:set-buffer! w other)
> (views:previous-buffer! w)
#<buffer two.py>
> (in-order (eq? (views:buffer w) c) (and (search (html-of w phone) "data-face=\"function\"" 0) #t) (job-events))
(#t #t ())
