> (views:set-buffer! (view) (files:visit "~/src/text.txt"))
; M-s r runs rg in the current buffer's directory, which leaves out
; hidden files, binary files and symbolic links; after #, the input
; filters the lines found.
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "ne")
> (sleep-for 0.5)
> (texts s)
()
> (type! "edle")
> (wait-matches s)
> (texts s)
("text.txt:1:needle one" "text.txt:3:needle two")
> (type! "#two")
> (wait-matches s)
> (texts s)
("text.txt:3:needle two")
> (press! "RET")
> (result t)
> (views:buffer (view))
#<buffer text.txt>
> (document:line (buffers:document (views:buffer (view))) (views:point (view)))
3
; Words match in any order, each a regular expression; words after one
; that starts with - are rg's options.
> (views:set-buffer! (view) (files:visit (string-append (getenv "HOME") "/src/text.txt")))
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "tw.* need")
> (wait-matches s)
> (texts s)
("text.txt:3:needle two")
> (type! " -A1")
> (wait-matches s)
> (texts s)
("text.txt:3:needle two")
; With -F, the words are one fixed string, as typed.
> (press! "C-a" "C-k")
> (type! "needle two -F")
> (wait-matches s)
> (texts s)
("text.txt:3:needle two")
> (press! "C-a" "C-k")
> (type! "two needle -F")
> (wait-matches s)
> (texts s)
()
> (press! "C-a" "C-k")
> (type! "hay -B1")
> (wait-matches s)
> (texts s)
("text.txt-1-needle one" "text.txt:2:hay")
> (press! "C-g")
! &quit
; rg's complaint about the search is shown.
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "needle(")
> (wait-matches s)
! (grep) grep:grep: rg: regex parse error:
> (texts s)
()
> (echo-area:current-message)
"rg: regex parse error:"
> (press! "C-g")
! &quit
; Lines show as rg prints them, before it ends.
> (set-option! grep:command-line (list (string-append (getenv "HOME") "/bin/slow-rg")))
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "first")
> (sleep-for 0.5)
> (texts s)
("a.txt:1:first")
> (completion:session-busy? s)
#t
> (define slow (find (lambda (p) (string=? (car (processes:command-line p)) (car (grep:command-line)))) (processes:all)))
> (processes:status slow)
#f
> (processes:owner slow)
(grep)
; A new search stops the running rg at once, and its lines stay until the
; new search shows its own.
> (type! "s")
> (sleep-for 0.1)
> (processes:status slow)
-1
> (texts s)
("a.txt:1:first")
> (sleep-for 0.5)
> (texts s)
("a.txt:1:first")
> (define slower (find (lambda (p) (and (not (eq? p slow)) (string=? (car (processes:command-line p)) (car (grep:command-line))))) (processes:all)))
> (processes:status slower)
#f
; Quitting the prompt stops it too.
> (press! "C-g")
! &quit
> (sleep-for 0.1)
> (processes:status slower)
-1
; RET with nothing selected, as when a fast typist's key comes before a
; broad search's matches, chooses the line whose text is the input.
> (set-option! grep:command-line (list (string-append (getenv "HOME") "/bin/many-rg")))
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "line")
> (wait-matches s)
> (completion:matches-count (completion:session-matches s))
5000
> (begin (type! "#many.txt:4321:line 4321") (completion:selected s))
#f
> (press! "RET")
> (result t)
> (files:path (views:buffer (view)))
"$HOME/src/many.txt"
> (views:set-buffer! (view) (files:visit "~/src/text.txt"))
; Lines group by file, under the path rg printed, each row the line's
; number and text. A file's lines come together, so the matches of each
; round of lines go at the end of the same matches.
> (set-option! grep:command-line (list (string-append (getenv "HOME") "/bin/grouped-rg")))
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "any")
> (wait-until (lambda () (= (completion:matches-count (completion:session-matches s)) 1)))
> (define first-matches (completion:session-matches s))
> (wait-until (lambda () (= (completion:matches-count (completion:session-matches s)) 3)))
> (eq? first-matches (completion:session-matches s))
#t
> (wait-matches s)
> (map (lambda (m) (list (completion:title s m) (completion:row-text s m))) (match-list s))
(("a.txt" "1:one a") ("a.txt" "2:two a") ("sub/b.txt" "1:one b") ("sub/b.txt" "2:two b"))
; M-w saves a line as rg printed it, without the search, which no line
; continues.
> (selected-text s)
"a.txt:1:one a"
> (press! "M-w")
> (kill-ring:text (kill-ring:current))
"a.txt:1:one a"
> (type! "#two")
> (selected-text s)
"a.txt:2:two a"
> (press! "M-w")
> (kill-ring:text (kill-ring:current))
"a.txt:2:two a"
> (press! "DEL" "DEL" "DEL" "DEL")
> (type! "#b")
> (map (lambda (m) (list (completion:title s m) (completion:row-text s m) (completion:spans s m))) (match-list s))
(("sub/b.txt" "1:one b" ((6 7 completion.match-0))) ("sub/b.txt" "2:two b" ((6 7 completion.match-0))))
> (press! "RET")
> (result t)
> (views:set-buffer! (view) (files:visit "~/src/text.txt"))
; Lines of a file that come after another file's are matched again with
; the earlier ones, so the file's lines stay together.
> (set-option! grep:command-line (list (string-append (getenv "HOME") "/bin/interleaved-rg")))
> (define t (start! (lambda () (press! "M-s" "r"))))
> (define s (session))
> (type! "any")
> (wait-until (lambda () (= (completion:matches-count (completion:session-matches s)) 3)))
> (completion:session-busy? s)
#t
> (texts s)
("a.txt:1:one a" "a.txt:2:two a" "b.txt:1:one b")
> (press! "C-g")
! &quit
