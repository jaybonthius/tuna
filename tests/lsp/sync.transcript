; A server defined by name, listed for a language, and started by
; lsp:ensure in the mode's hook, without pausing.
> (lsp:define-server alpha (fake-command "alpha"))
> alpha
alpha
> (configure! "alpha" '(capabilities ("textDocumentSync" . 2) ("hoverProvider" . #t)))
> (table-set! lsp:language-servers "fakelang" (list alpha))
> (add-hook! fake-mode-hook lsp:ensure)
> (write-file! (string-append project "/a.fk") "one\ntwo\n")
> (define a (visit! (string-append project "/a.fk")))
> (wait-for "alpha" "textDocument/didOpen")
> (methods "alpha")
("initialize" "initialized" "workspace/didChangeConfiguration" "textDocument/didOpen")
> (ref (last-of "alpha" "textDocument/didOpen") "params" "textDocument")
(("uri" . "file://$HOME/project/a.fk") ("languageId" . "fakelang") ("version" . 0) ("text" . "one\ntwo\n"))
; Each edit goes as a range of the content before it and the inserted
; text, after the delay, with the buffer's version as the document's.
> (define (changes name) (map (lambda (m) (list (ref m "params" "textDocument" "version") (ref m "params" "contentChanges"))) (of-method name "textDocument/didChange")))
> (buffers:replace! a 4 4 "X")
#<edit 1>
> (methods "alpha")
("initialize" "initialized" "workspace/didChangeConfiguration" "textDocument/didOpen")
> (wait-for "alpha" "textDocument/didChange")
> (changes "alpha")
((1 #((("range" ("start" ("line" . 0) ("character" . 3)) ("end" ("line" . 0) ("character" . 3))) ("text" . "X")))))
> (buffers:version a)
1
; A deletion across lines counts its end from the removed text.
> (text a)
"oneX\ntwo\n"
> (buffers:replace! a 3 8 "")
#<edit 2>
> (wait-for "alpha" "textDocument/didChange" 2)
> (cadr (changes "alpha"))
(2 #((("range" ("start" ("line" . 0) ("character" . 2)) ("end" ("line" . 1) ("character" . 2))) ("text" . ""))))
; Silent edits are sent too, and the pending edits go before any request.
> (buffers:with-silent-edits a (buffers:replace! a 1 1 "S"))
#<edit 3>
> (define c (car (lsp:buffer-connections a)))
> (define asked (start! (lambda () (lsp:request c "textDocument/hover" '(("position" ("line" . 0) ("character" . 0)))))))
> (result asked)
null
> (list (length (changes "alpha")) (car (list-ref (changes "alpha") 2)) (list-tail (methods "alpha") (- (length (methods "alpha")) 2)))
(3 3 ("textDocument/didChange" "textDocument/hover"))
; Characters are counted in the unit the server chose: a character above
; U+FFFF is two UTF-16 units, four UTF-8 bytes and one UTF-32 character.
> (define (encoding-server! name encoding)
    (configure! name `(capabilities ("textDocumentSync" . 2) ("positionEncoding" . ,encoding))))
> (lsp:define-server sixteen (fake-command "sixteen"))
> (lsp:define-server eight (fake-command "eight"))
> (lsp:define-server thirtytwo (fake-command "thirtytwo"))
> (encoding-server! "sixteen" "utf-16")
> (encoding-server! "eight" "utf-8")
> (encoding-server! "thirtytwo" "utf-32")
> (table-set! lsp:language-servers "fakelang" (list 'sixteen 'eight 'thirtytwo))
> (write-file! (string-append project "/wide.fk") "a\x1F600;b\n")
> (define wide (visit! (string-append project "/wide.fk")))
> (wait-for "thirtytwo" "textDocument/didOpen")
> (wait-until (lambda () (and (pair? (of-method "eight" "textDocument/didOpen")) (pair? (of-method "sixteen" "textDocument/didOpen")))))
> (buffers:replace! wide 3 4 "c")
#<edit 1>
> (for-each (lambda (n) (wait-for n "textDocument/didChange")) '("sixteen" "eight" "thirtytwo"))
> (map (lambda (n) (ref (cadr (car (changes n))) 0 "range")) '("sixteen" "eight" "thirtytwo"))
((("start" ("line" . 0) ("character" . 3)) ("end" ("line" . 0) ("character" . 4))) (("start" ("line" . 0) ("character" . 5)) ("end" ("line" . 0) ("character" . 6))) (("start" ("line" . 0) ("character" . 2)) ("end" ("line" . 0) ("character" . 3))))
> (buffers:replace! wide 2 3 "")
#<edit 2>
> (for-each (lambda (n) (wait-for n "textDocument/didChange" 2)) '("sixteen" "eight" "thirtytwo"))
> (map (lambda (n) (ref (cadr (cadr (changes n))) 0 "range" "end")) '("sixteen" "eight" "thirtytwo"))
((("line" . 0) ("character" . 3)) (("line" . 0) ("character" . 5)) (("line" . 0) ("character" . 2)))
; A byte that is not UTF-8 goes as U+FFFD, and an edit after it counts it
; as that character's three bytes in a UTF-8 server.
> (call-with-port (open-file-output-port (string-append project "/raw.fk") (file-options no-fail))
    (lambda (p) (put-bytevector p (bytevector 97 255 98 10))))
> (define raw (visit! (string-append project "/raw.fk")))
> (wait-until (lambda () (= 2 (length (of-method "eight" "textDocument/didOpen")))))
> (string=? (ref (cadr (of-method "eight" "textDocument/didOpen")) "params" "textDocument" "text") "a\xFFFD;b\n")
#t
> (buffers:replace! raw 3 4 "c")
#<edit 1>
> (wait-until (lambda () (= 3 (length (of-method "eight" "textDocument/didChange")))))
> (ref (cadr (list-ref (changes "eight") 2)) 0 "range")
(("start" ("line" . 0) ("character" . 4)) ("end" ("line" . 0) ("character" . 5)))
> (table-set! lsp:language-servers "fakelang" (list alpha))
; An answer is counted on the content of the version its request saw, as
; buffers:document-at gives it, however many edits came since.
> (define asked-at (buffers:version a))
> (text a)
"Sono\n"
> (for-each (lambda (i) (buffers:replace! a 1 1 "\n")) '(1 2 3))
#<edit 6>
> (call-with-values (lambda () (lsp:range-bounds c a '(("start" ("line" . 0) ("character" . 1)) ("end" ("line" . 0) ("character" . 3))) asked-at)) list)
(2 4)
> (document:text (buffers:document-at a asked-at) 2 4)
"on"
; A report at a version the buffer's log no longer holds is dropped.
> (define (publish! version message)
    (lsp:notify c "fake/send"
      `(("message" ("jsonrpc" . "2.0") ("method" . "textDocument/publishDiagnostics")
         ("params" ("uri" . ,(lsp:path->uri (string-append project "/a.fk"))) ("version" . ,version)
                   ("diagnostics" . #((("range" ("start" ("line" . 0) ("character" . 0)) ("end" ("line" . 0) ("character" . 1)))
                                       ("severity" . 1) ("message" . ,message)))))))))
> (publish! (buffers:version a) "now")
> (wait-until (lambda () (pair? (diagnostics:in a))))
> (map diagnostics:diagnostic-message (diagnostics:in a))
("now")
> (do ([i 0 (+ i 1)]) ((= i 1100)) (buffers:with-silent-edits a (buffers:replace! a 1 1 "x") (buffers:replace! a 1 2 "")))
> (set-idle! #t)
> (sleep-for 1.5)
> (publish! 0 "too old")
> (sleep-for 0.3)
> (map diagnostics:diagnostic-message (diagnostics:in a))
("now")
