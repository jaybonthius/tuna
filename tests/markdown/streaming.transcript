((markdown:paragraph ((key . 0)) "See the spec\n"))
> (markdown:unfinished-blocks "See ![a diagram")
((markdown:paragraph ((key . 0)) "See a diagram\n"))
> (markdown:unfinished-blocks "See [the spec]")
((markdown:paragraph ((key . 0)) "See the spec\n"))
> (markdown:unfinished-blocks "See [the spec](")
((markdown:paragraph ((key . 0)) "See the spec\n"))
> (markdown:unfinished-blocks "x [label](http://exa")
((markdown:paragraph ((key . 0)) "x label\n"))
> (markdown:unfinished-blocks "[label](https://x.y \"ti")
((markdown:paragraph ((key . 0)) "label\n"))
> (markdown:unfinished-blocks "[**bo**ld](https://x")
((markdown:paragraph ((key . 0)) (markdown:strong () "bo") "ld\n"))
