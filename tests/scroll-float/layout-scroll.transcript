#t
> (strip phone)
(4 nearest 4 (3 4 6 7))
; A hand scroll on the phone that comes to rest moves the shared focus to
; the column the phone settled on; the desktop is placed there, and the
; phone, already there, is not.
> (define before (placement-number phone))
> (strip-report! phone (list (views:id vd)) (views:id vd) "start" (views:id vd))
> (list (selected) (= before (placement-number phone)) (strip desktop))
(6 #t (6 start 6 ((3 placeholder) 4 6 (7 placeholder))))
; A report while scrolling only tells what is in view on that client.
> (strip-report! desktop (list (views:id vd) (views:id ve)))
