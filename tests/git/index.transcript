; Each command that changes the index or the working tree is logged.
> (sample-repository! "repo")
> (define repo (git:find-repository (at "repo")))
> (define (short) (utf8->string (git:query repo '("status" "--short"))))
> (short)
" M a.py\nMM b.txt\n D gone.txt\n?? new.txt\n"
> (git:stage repo '("a.py" "new.txt"))
> (short)
"M  a.py\nMM b.txt\n D gone.txt\nA  new.txt\n"
> (git:unstage repo '("a.py"))
> (short)
" M a.py\nMM b.txt\n D gone.txt\nA  new.txt\n"
> (git:unstage repo #f)
> (short)
" M a.py\n M b.txt\n D gone.txt\n?? new.txt\n"
> (git:stage-tracked repo)
> (short)
"M  a.py\nM  b.txt\nD  gone.txt\n?? new.txt\n"
> (git:unstage repo #f)
> (git:stage-all repo)
> (short)
"M  a.py\nM  b.txt\nD  gone.txt\nA  new.txt\n"
> (git:unstage repo #f)
> (git:stage-intent-to-add repo '("new.txt"))
> (short)
" M a.py\n M b.txt\n D gone.txt\n A new.txt\n"
> (git:restore-from-index repo '("a.py" "gone.txt"))
> (short)
" M b.txt\n A new.txt\n"
> (git:stage repo '("b.txt"))
> (git:restore-from-head repo '("b.txt"))
> (short)
" A new.txt\n"
> (map cadr (log-lines repo))
(("add" "--pathspec-from-file=-" "--pathspec-file-nul") ("reset" "-q" "HEAD" "--pathspec-from-file=-" "--pathspec-file-nul") ("reset" "-q" "HEAD" "--") ("add" "-u" ".") ("reset" "-q" "HEAD" "--") ("add" "--all" ".") ("reset" "-q" "HEAD" "--") ("add" "--intent-to-add" "--pathspec-from-file=-" "--pathspec-file-nul") ("checkout" "--pathspec-from-file=-" "--pathspec-file-nul") ("add" "--pathspec-from-file=-" "--pathspec-file-nul") ("checkout" "HEAD" "--pathspec-from-file=-" "--pathspec-file-nul"))
; Paths reach git as bytes, so a path that is not UTF-8 is named exactly.
> (sh "cd repo && printf 'x\\n' > \"$(printf 'caf\\351.txt')\"")
> (define latin (string->utf8 "caf_.txt"))
> (bytevector-u8-set! latin 3 #xe9)
> (git:stage repo (list latin))
> (git:query repo '("diff" "--cached" "--name-only" "-z"))
#vu8(99 97 102 233 46 116 120 116 0)
; Before the first commit, unstaging removes from the index.
> (sh "git init -q -b main empty && cd empty && echo e > e.txt && git add e.txt")
> (define empty (git:find-repository (at "empty")))
> (git:unstage empty '("e.txt"))
> (utf8->string (git:query empty '("status" "--short")))
"?? e.txt\n"
> (git:stage empty '("e.txt"))
> (git:unstage empty #f)
> (utf8->string (git:query empty '("status" "--short")))
"?? e.txt\n"
; git:apply writes the patch's bytes to git's input.
> (define patch (string->utf8 "diff --git a/b.txt b/b.txt\n--- a/b.txt\n+++ b/b.txt\n@@ -1,3 +1,3 @@\n alpha\n-beta\n+BETA\n gamma\n"))
> (git:apply repo patch '("--cached"))
> (utf8->string (git:query repo '("diff" "--cached" "--stat")))
" b.txt    | 2 +-\n caf�.txt | 1 +\n 2 files changed, 2 insertions(+), 1 deletion(-)\n"
> (failure (lambda () (git:apply repo patch '("--cached"))))
"b.txt: patch does not apply"
> (git:apply repo "text" '())
! git:apply: not a bytevector with irritant "text"
