; A key that leaves keys pending starts a timer of which-key:delay
; seconds; the popup shows once it runs out.
> (press! "C-c")
> (shows?)
#f
> (wait-out)
> (car (popup))
"C-c"
; Once shown, the popup follows each further key of the sequence at once.
> (press! "h")
> (popup)
("C-c h" ("h" "harpo:honk") ("s" "harpo:squeak"))
; It goes as soon as the sequence ends, by a command.
> (press! "s")
> (popup)
#f
; A new sequence waits for its own timer.
> (press! "C-c")
> (shows?)
#f
> (wait-out)
> (shows?)
#t
; By an undefined key.
> (press! "x")
! C-c x is undefined
> (popup)
#f
; By a quit.
> (press! "C-c")
> (wait-out)
> (shows?)
#t
> (press! "C-g")
! C-c C-g is undefined
> (popup)
#f
; Each key that leaves keys pending before the popup shows starts the
; timer again, for the keys pending then.
> (press! "C-c")
> (sleep-for 0.3)
> (press! "q")
> (sleep-for 0.3)
> (shows?)
#f
> (sleep-for 0.3)
> (popup)
("C-c q" ("z" "harpo:squeak"))
> (press! "z")
; By a command that pauses at a prompt: keys:press! clears the pending
; keys before it runs the command.
> (press! "C-c")
> (wait-out)
> (press! "f")
> (car (popup))
"C-c f"
> (define t (start! (lambda () (press! "f"))))
> (popup)
#f
> (press! "x" "RET")
> (result t)
; The popup is drawn only for the client whose keys are pending.
> (press! "C-c")
> (wait-out)
> (list (car (popup-of client)) (popup-of other-client))
("C-c" #f)
> (press-in! other-client "C-c")
> (list (car (popup-of client)) (popup-of other-client))
("C-c" #f)
> (wait-out)
> (list (car (popup-of client)) (car (popup-of other-client)))
("C-c" "C-c")
> (press-in! other-client "z")
> (list (car (popup-of client)) (popup-of other-client))
("C-c" #f)
> (press! "z")
; A delay of 0 shows the popup with the screen of the key that leaves
; keys pending.
> (set-option! which-key:delay 0)
> (press! "C-c")
> (car (popup))
"C-c"
> (press! "z")
> (set-option! which-key:delay 0.5)
> (raised (lambda () (set-option! which-key:delay -1)))
(set-option! "-1 is not a valid value for which-key:delay")
> (raised (lambda () (set-option! which-key:delay +inf.0)))
(set-option! "+inf.0 is not a valid value for which-key:delay")
; When no key can follow the pending keys, no popup shows.
> (define-table empty)
> (keys:bind! keys:global "C-c e" empty)
> (set-option! which-key:delay 0)
> (press! "C-c" "e")
> (list (keys:pending client) (popup))
("C-c e" #f)
> (press! "x")
! C-c e x is undefined
> (set-option! which-key:delay 0.5)
; After a lone ESC, which waits to make the next key Meta when ESC is
; neither a quit key nor bound, no popup shows, nor after one that
; follows a shown popup's keys.
> (set-option! keys:quit-keys '("C-g"))
> (keys:unbind! keys:global "ESC")
> (press! "ESC")
> (wait-out)
> (shows?)
#f
> (press! "C-g")
! ESC C-g is undefined
> (press! "C-c")
> (wait-out)
> (shows?)
#t
> (press! "ESC")
> (shows?)
#f
> (press! "C-g")
! C-c ESC C-g is undefined
> (set-option! keys:quit-keys '("C-g" "ESC"))
> (keys:bind! keys:global "ESC" keys:keyboard-quit)
; By default ESC is a quit key and ends the sequence, so the popup goes.
> (press! "C-c")
> (wait-out)
> (shows?)
#t
> (press! "ESC")
! C-c ESC is undefined
> (shows?)
#f
; Nor after a mouse key or a wheel key that starts a sequence.
> (press! (list "<mouse-3>" (views:%make-posn (layout:selected-view) 0)))
> (keys:pending client)
"<mouse-3>"
> (wait-out)
> (shows?)
#f
> (press! "a")
> (press! (list "<wheel-down>" (views:%make-posn (layout:selected-view) 0)))
> (keys:pending client)
"<wheel-down>"
> (wait-out)
> (shows?)
#f
> (press! "a")
; The echo area shows the pending keys after its own pause, and the
; popup shows and follows them as before.
> (set-option! echo-area:echo-keystrokes 0.3)
> (press! "C-c")
> (wait-out)
> (list (car (popup)) (and (search (screen-of client) "<div class=\"echo-area-echo\">C-c-</div>" 0) #t))
("C-c" #t)
> (press! "h")
> (list (car (popup)) (and (search (screen-of client) "<div class=\"echo-area-echo\">C-c h-</div>" 0) #t))
("C-c h" #t)
> (press! "s")
> (popup)
#f
