; git:diff parses git diff's output: the unstaged changes, or with
; --cached the staged ones.
> (sample-repository! "repo")
> (define repo (git:find-repository (at "repo")))
> (map (lambda (f) (list (diff:file-path f) (diff:file-status f) (length (diff:file-hunks f)))) (git:diff repo '()))
(("a.py" modified 1) ("b.txt" modified 1) ("gone.txt" deleted 1))
> (map diff:file-path (git:diff repo '("--cached")))
("b.txt")
; git:diff-arguments are added to every diff.
> (options:set! git:diff-arguments '("-U0"))
> (map (lambda (h) (utf8->string (diff:hunk-heading h))) (diff:file-hunks (car (git:diff repo '()))))
("@@ -2 +2 @@ one" "@@ -9 +9 @@ eight")
> (options:unset! git:diff-arguments)
; A textconv driver does not change the diff: it holds the file's bytes.
> (write-file! "repo/.gitattributes" "*.up diff=upper\n")
> (sh "cd repo && git config diff.upper.textconv 'tr a-z A-Z <' && git add .gitattributes && printf 'one\\n' > t.up && git add t.up && git commit -qm t && printf 'one\\ntwo\\n' > t.up")
> (map (lambda (l) (utf8->string (diff:line-bytes l)))
       (vector->list (diff:hunk-lines (car (diff:file-hunks (car (filter (lambda (f) (equal? (diff:file-path f) "t.up")) (git:diff repo '()))))))))
("one" "two")
; git:commits gives the commits of a range, newest first.
> (map (lambda (c) (list (git:commit-subject c) (git:commit-refs c) (string-length (git:commit-name c))))
       (git:commits repo "HEAD" #f))
(("t" ("main") 40) ("Second commit" () 40) ("First commit" ("origin/main") 40))
> (map git:commit-subject (git:commits repo "@{upstream}.." 10))
("t" "Second commit")
> (map git:commit-subject (git:commits repo "HEAD" 1))
("t")
> (git:commit? (car (git:commits repo "HEAD" 1)))
#t
> (sh "cd repo && git tag v1 HEAD~1")
> (git:commit-refs (cadr (git:commits repo "HEAD" #f)))
("tag: v1")
; git:stashes gives each stash's name and message, newest first.
> (git:stashes repo)
()
> (sh "cd repo && git stash -q && git stash -q -u")
> (git:stashes repo)
(("stash@{0}" . "WIP on main: 300e9b1 t") ("stash@{1}" . "WIP on main: 300e9b1 t"))
> (sh "cd repo && git stash pop -q && git stash pop -q")
