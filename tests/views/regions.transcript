; A line held whole in a view that does not wrap is filled past the
; view's edge however long it is: a line of 20,000 characters, about
; 200,000 px, is marked, and the stylesheet's fill reaches without end.
> (define wide (buffers:make "wide" (string-append (make-string 20000 #\x) "\nnext\n")))
> (define wv (views:make wide))
> (begin (views:set-mark! wv 1) (views:set-point! wv 20003))
> (held-lines wv)
(1)
> (let* ([css (call-with-input-file (string-append (getenv "TUNA_LIBRARY") "/views/views.css") get-string-all)]
         [rule (search css ".view.nowrap .line.region-line {" 0)])
    (substring css (search css "border-image" rule) (+ (search css ";" rule) 1)))
"border-image: linear-gradient(var(--tuna-region, Highlight)) 0 fill / 0 / 0 calc(infinity * 1px) 0 0;"
