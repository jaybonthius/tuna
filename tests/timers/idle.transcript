; An idle timer runs once each time Tuna has been idle for its seconds.
> (define idle-runs 0)
> (define idler (timers:run-when-idle 0.1 (lambda () (set! idle-runs (+ idle-runs 1)))))
> (list (timers:idle-seconds) (equal? (timers:live) (list idler)))
(#f #t)
> (timers:sleep 0.2)
> idle-runs
0
> (timers:set-idle! #t)
> (timers:sleep 0.3)
> (list idle-runs (>= (timers:idle-seconds) 0.3))
(1 #t)
; Telling it again changes nothing; being busy then idle starts a new
; period.
> (timers:set-idle! #t)
> (timers:sleep 0.1)
> idle-runs
1
> (begin (timers:set-idle! #f) (timers:set-idle! #t))
> (timers:sleep 0.2)
> idle-runs
2
; Any thread may say whether Tuna is idle.
> (on-thread (lambda () (timers:set-idle! #f)))
> (list (timers:idle-seconds) (begin (timers:sleep 0.2) idle-runs))
(#f 2)
> (timers:cancel! idler)
> (begin (timers:set-idle! #t) (timers:sleep 0.2) idle-runs)
2
> (timers:set-idle! 'yes)
! timers:set-idle!: not a boolean with irritant yes
