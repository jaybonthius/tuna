> (define repo (fresh! "repo"))
> (define status-view (view))
; $ shows the command log in another view and selects it: a section
; per command run for its effect, its exit status right-aligned, then git
; … and the arguments; a failed command's output shows, others' is
; hidden.
> (go-to-section! '(file . "a.py") '(unstaged . #f))
> (press! "s")
> (settle!)
> (git:run repo '("tag" "v1"))
#vu8()
> (guard (c [#t 'failed]) (git:run repo '("checkout" "nowhere")))
failed
> (settle!)
> (press! "$")
> (settle!)
> (list (shown-buffer) (eq? (view) status-view) (modes:major-mode (views:buffer (view))))
("*git-commands: repo*" #f git-mode:commands-mode)
> (shown (view))
("  0 git … add --pathspec-from-file=- --pathspec-file-nul" "  0 git … tag v1" "  1 git … checkout nowhere" "error: pathspec 'nowhere' did not match any file(s) known to git")
; g is undefined in the log, which follows the commands itself.
> (press! "g")
! g is undefined
> (git:run repo '("tag" "v2"))
#vu8()
> (settle!)
> (car (reverse (shown (view))))
"  0 git … tag v2"
; k on a running command asks, and stops it; its section ends with
; its exit status and the command fails.
> (write-file! "repo/.git/hooks/pre-commit" "#!/bin/sh\nsleep 30\n")
> (sh "chmod +x repo/.git/hooks/pre-commit")
> (define slow (git-mode:start repo '("commit" "-m" "slow") (lambda (c) (void))))
> (testing:wait-until (lambda () (git:running repo)))
> (press! "M->")
> (point-line)
"    git … commit -m slow"
; while it runs, the status line of each view of a Git buffer of the
; repository shows it.
> (git-mode:show-running status-view)
"git commit -m slow…"
> (git-mode:show-running (view))
"git commit -m slow…"
> (answer! #t)
> (press! "k")
> (testing:wait-until (lambda () (git:command-exit slow)))
> (list (take-asked!) (git:command-exit slow) (point-line))
(("Kill process?") -1 " -1 git … commit -m slow")
> (settle!)
> (take-said!)
("Git error: pathspec 'nowhere' did not match any file(s) known to git [Type $ for details]" "Git error: git failed [Type $ for details]")
> (git-mode:show-running status-view)
#f
; k on a command that has ended raises.
> (press! "k")
! git-mode:stop-command: Process isn't running
; the log keeps git:command-log-size commands.
> (options:set! git:command-log-size 3)
> (git:run repo '("tag" "v3"))
#vu8()
> (settle!)
> (length (git:commands repo))
3
> (length (filter (lambda (l) (and (> (string-length l) 3) (string=? (substring l 3 5) " g"))) (shown (view))))
3
> (options:set! git:command-log-size 32)
; q in the log quits its view; the view selected before is selected.
> (press! "q")
> (list (shown-buffer) (eq? (view) status-view))
("*git: repo*" #t)
; a background command says Git finished; staging says nothing.
> (take-said!)
()
