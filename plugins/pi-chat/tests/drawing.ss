(import (tuna) (test) (test-user) (test-runner) (options) (buffers) (document) (views) (pi) (chat) (pi-chat) (test-pi)
        (pi-chat-test))

(define chat (pi-chat-test:shown-chat (getenv "HOME")))

(define f (pi-chat-test:fake chat))

(define (tool-calls)
  (map (lambda (el)
         (list (test-user:element-attribute el "data-state") (and (test-user:element-attribute el "data-open") #t)
               (test-user:element-text (car (test-user:elements el "chat-header")))))
       (pi-chat-test:elements "chat-tool-call")))

(define (opens class)
  (map (lambda (el) (and (test-user:element-attribute el "data-open") #t)) (pi-chat-test:elements class)))

(define (notices)
  (map (lambda (el) (list (test-user:element-attribute el "data-level") (test-user:element-text el)))
       (pi-chat-test:elements "chat-notice")))

(test "your messages and Pi's replies are Markdown as buffer content"
  (test-pi:run-turn! f "u1" "a1" "Show **this**" '("A *reply*:\n\n" "- one\n- two"))
  (test-runner:wait-until (lambda () (= 2 (length (filter pi:item-entry-id (pi:chat-transcript chat))))))
  (pi-chat-test:wait-for-elements "markdown-list" 1)
  (check-equal? '("Show this") (pi-chat-test:texts "chat-user-message"))
  (check-equal? '(("A reply:" "one" "two")) (map pi-chat-test:lines (pi-chat-test:elements "chat-reply")))
  (check-equal? '("stop") (map (lambda (el) (test-user:element-attribute el "data-stop")) (pi-chat-test:elements "chat-reply"))))

(test "a reply still arriving shows what is open as closed, and Pi's thinking unfolded until it is done"
  (test-pi:say! f (test-pi:event "agent_start") (test-pi:event "message_start" (cons "message" (test-pi:assistant-message "pending")))
                (test-pi:update '(("type" . "thinking_start") ("contentIndex" . 0)))
                (test-pi:update '(("type" . "thinking_delta") ("contentIndex" . 0) ("delta" . "Consider *x"))))
  (pi-chat-test:wait-for-elements "chat-thinking" 1)
  (check-equal? '(#t) (opens "chat-thinking"))
  (check-equal? '("Thinking…Consider x") (pi-chat-test:texts "chat-thinking")))

(test "a batch rewrites only the items that changed, here the reply being written"
  (let* ([reconciled '()]
         [note (lambda (reconcile! b node children)
                 (when (eq? b (chat:buffer chat)) (set! reconciled (cons (document:node-kind node) reconciled)))
                 (reconcile! b node children))])
    (advice-add! buffers:reconcile! note)
    (test-pi:say! f (test-pi:update '(("type" . "thinking_delta") ("contentIndex" . 0) ("delta" . " and y"))))
    (test-runner:wait-until (lambda () (pair? reconciled)))
    (advice-remove! buffers:reconcile! note)
    (check-equal? #f (memq 'chat:transcript reconciled))
    (check (memq 'chat:%item reconciled))))

(test "finished thinking folds to its header"
  (test-pi:say! f (test-pi:update '(("type" . "thinking_end") ("contentIndex" . 0) ("content" . "Consider *x*")))
                (test-pi:update '(("type" . "text_start") ("contentIndex" . 1)))
                (test-pi:update '(("type" . "text_delta") ("contentIndex" . 1) ("delta" . "Some **bol"))))
  (test-runner:wait-until (lambda () (equal? '(#f) (opens "chat-thinking"))))
  (check-equal? '("Thinking") (pi-chat-test:texts "chat-thinking")))

(test "a tool call is folded to one line: the tool, its main argument, how long it took and whether it failed; while it runs, its last line of output"
  (test-pi:say! f (test-pi:update '(("type" . "toolcall_start") ("contentIndex" . 2) ("id" . "t1") ("toolName" . "bash")))
                (test-pi:update `(("type" . "toolcall_end") ("contentIndex" . 2) ("toolCall" . ,(test-pi:tool-block "t1" "bash" '(("command" . "make test"))))))
                (test-pi:event "tool_execution_start" '("toolCallId" . "t1") '("toolName" . "bash") '("args" . (("command" . "make test"))))
                (test-pi:event "tool_execution_update" '("toolCallId" . "t1") '("toolName" . "bash")
                  '("partialResult" . (("content" . #((("type" . "text") ("text" . "building\nrunning 3 tests\n"))))))))
  (pi-chat-test:wait-for-elements "chat-tool-call" 1)
  (check-equal? '(("running" #f "bash make test · running")) (tool-calls))
  (check-equal? '("running 3 tests") (pi-chat-test:texts "chat-output"))
  (test-pi:say! f (test-pi:event "tool_execution_end" '("toolCallId" . "t1") '("toolName" . "bash") '("isError" . #t) '("durationMs" . 2300)
                    '("result" . (("content" . #((("type" . "text") ("text" . "building\nrunning 3 tests\n1 failed\n")))))))
                (test-pi:update '(("type" . "toolcall_start") ("contentIndex" . 3) ("id" . "t2") ("toolName" . "edit")))
                (test-pi:update `(("type" . "toolcall_end") ("contentIndex" . 3)
                                  ("toolCall" . ,(test-pi:tool-block "t2" "edit" '(("path" . "a.txt") ("edits" . #((("oldText" . "old\nline") ("newText" . "new")))))))))
                (test-pi:event "tool_execution_start" '("toolCallId" . "t2") '("toolName" . "edit") '("args" . (("path" . "a.txt"))))
                (test-pi:event "tool_execution_end" '("toolCallId" . "t2") '("toolName" . "edit") '("isError" . #f) '("durationMs" . 12)
                  '("result" . (("content" . #((("type" . "text") ("text" . "Edited a.txt"))))))))
  (pi-chat-test:wait-for-elements "chat-tool-call" 2)
  (check-equal? '(("failed" #f "bash make test · 2.3 s · failed") ("done" #f "edit a.txt · 12 ms")) (tool-calls))
  (check-equal? '() (pi-chat-test:texts "chat-output")))

(test "TAB on a block's header unfolds it: a tool call's whole output, an edit's lines removed and added; TAB again folds it"
  (pi-chat-test:at! chat "bash")
  (test-user:press! "TAB")
  (check-equal? '(("building" "running 3 tests" "1 failed")) (map pi-chat-test:lines (pi-chat-test:elements "chat-output")))
  (pi-chat-test:at! chat "edit")
  (test-user:press! "TAB")
  (check-equal? '(("old" "line") ("new")) (list (pi-chat-test:texts "chat-removed") (pi-chat-test:texts "chat-added")))
  (test-user:press! "TAB")
  (check-equal? '(() ()) (list (pi-chat-test:texts "chat-removed") (pi-chat-test:texts "chat-added")))
  (test-user:press! "C-c C-o")
  (check-equal? '((#f) (#f #f)) (list (opens "chat-thinking") (opens "chat-tool-call")))
  (test-user:press! "C-c C-o")
  (check-equal? '((#t) (#t #t)) (list (opens "chat-thinking") (opens "chat-tool-call"))))

(test "a reply that failed or was stopped ends with that and Pi's reason"
  (test-pi:say! f (test-pi:event "message_end" (cons "message" (append (test-pi:assistant-message "aborted" (test-pi:text-block "Some **bold**"))
                                                                       '(("errorMessage" . "Operation aborted")))))
                (test-pi:event "message_start" (cons "message" (test-pi:assistant-message "pending")))
                (test-pi:event "message_end" (cons "message" (append (test-pi:assistant-message "error") '(("errorMessage" . "529 overloaded"))))))
  (pi-chat-test:wait-for-elements "chat-notice" 2)
  (check-equal? '(("error" "Stopped: Operation aborted") ("error" "Failed: 529 overloaded")) (notices)))

(test "with chat:thinking-shown? finished thinking stays unfolded"
  (options:set! chat:thinking-shown? #t)
  (test-pi:append-entry! f (test-pi:entry "a2" "a1" (test-pi:assistant-message "stop" (test-pi:thinking-block "Consider *x*") (test-pi:text-block "Fine"))))
  (test-pi:say! f (test-pi:event "agent_settled" '("aborted" . #t)))
  (test-runner:wait-until (lambda () (= 3 (length (filter pi:item-entry-id (pi:chat-transcript chat))))))
  (test-runner:wait-until (lambda () (equal? '(#t) (opens "chat-thinking"))))
  (options:unset! chat:thinking-shown?))

(test "extensions' messages show under their type, folded past 12 lines; Pi's summaries are folded; notices are lines of their own"
  (test-pi:append-entry! f '(("type" . "custom_message") ("id" . "c1") ("parentId" . "a2") ("customType" . "subagent-notify")
                              ("content" . "Run **done**") ("display" . #t)))
  (test-pi:append-entry! f `(("type" . "custom_message") ("id" . "c2") ("parentId" . "c1") ("customType" . "report")
                              ("content" . ,(apply string-append (map (lambda (n) (format "Line ~a\n\n" n)) (iota 13))))
                              ("display" . #t)))
  (test-pi:append-entry! f '(("type" . "compaction") ("id" . "k1") ("parentId" . "c2") ("summary" . "We read files.")
                              ("tokensBefore" . 150000) ("firstKeptEntryId" . "c2")))
  (test-pi:say! f (test-pi:event "entry_appended" '("entry" . ()))
                (test-pi:ui-request "n1" "notify" '("message" . "Blocked rm") '("notifyType" . "warning")))
  (pi-chat-test:wait-for-elements "pi-chat-summary" 1)
  (check-equal? '(#t #f) (opens "pi-chat-extension-message"))
  (check-equal? '("subagent-notifyRun done" "report") (pi-chat-test:texts "pi-chat-extension-message"))
  (check-equal? '(#f) (opens "pi-chat-summary"))
  (check-equal? '("Pi summarised the conversation · 150000 tokens before") (pi-chat-test:texts "pi-chat-summary"))
  (test-runner:wait-until (lambda () (member '("warning" "Blocked rm") (notices)))))

(test "extensions' widgets go above or below the prompt, with no machine data, and a widget of only machine data is none"
  (test-pi:say! f (test-pi:ui-request "w1" "setWidget" '("widgetKey" . "plan") '("widgetLines" . #("Step 1" "Step 2")))
                (test-pi:ui-request "w2" "setWidget" '("widgetKey" . "foot") '("widgetLines" . #("below")) '("widgetPlacement" . "belowEditor"))
                (test-pi:ui-request "w3" "setWidget" '("widgetKey" . "subagent-async")
                  '("widgetLines" . #("PI_SUBAGENT_ASYNC_JSON:{\"kind\":\"pi-subagents.async-status-snapshot\",\"version\":1,\"runs\":[]}")))
                (test-pi:ui-request "w4" "setWidget" '("widgetKey" . "mixed")
                  '("widgetLines" . #("Running" "RUN_JSON:{\"n\": 1}" "NOTE: {x}" "{\"a\": 1}"))))
  (pi-chat-test:wait-for-elements "pi-chat-widget" 3)
  (check-equal? '(("above" (("Step 1" "Step 2") ("Running" "NOTE: {x}" "{\"a\": 1}"))) ("below" (("below"))))
    (map (lambda (part)
           (list (test-user:element-attribute part "data-placement")
                 (map pi-chat-test:lines (test-user:elements part "pi-chat-widget"))))
         (filter (lambda (part) (pair? (test-user:elements part "pi-chat-widget"))) (pi-chat-test:elements "chat-source-parts")))))

(test "when Pi exits the chat says so, with a button that restarts it"
  (test-pi:exit! f 1 "")
  (test-runner:wait-until (lambda () (eq? (pi:chat-activity chat) 'exited)))
  (test-user:settle)
  (let ([last-two (list-tail (notices) (- (length (notices)) 2))])
    (check-equal? '(("error" "Pi exited with status 1.") ("error" "Restart Pi")) last-two))
  (test-user:click-element! (car (pi-chat-test:elements "ui-button")))
  (test-runner:wait-until (lambda () (not (member '("error" "Restart Pi") (notices)))))
  (check-equal? 'idle (pi:chat-activity chat)))

(test "folds belong to the session: a new session's blocks start folded, though they sit where unfolded ones did"
  (let ([g (pi-chat-test:fake chat)])
    (test-pi:set-state! g '(("sessionId" . "s-new")))
    (test-pi:clear-entries! g)
    (for-each (lambda (e) (test-pi:append-entry! g e))
      (list (test-pi:entry "n1" #f (test-pi:user-message "New"))
            (test-pi:entry "n2" "n1" (test-pi:assistant-message "stop" (test-pi:text-block "Ok")))
            (test-pi:entry "n3" "n2" (test-pi:assistant-message "stop" (test-pi:thinking-block "Hmm")
                                       (test-pi:tool-block "t5" "bash" '(("command" . "ls")))
                                       (test-pi:tool-block "t6" "bash" '(("command" . "pwd")))))))
    (pi:new-session! chat)
    (test-runner:wait-until (lambda () (= 3 (length (filter pi:item-entry-id (pi:chat-transcript chat))))))
    (pi-chat-test:wait-for-elements "chat-tool-call" 2)
    (check-equal? '((#f) (#f #f)) (list (opens "chat-thinking") (opens "chat-tool-call")))))
