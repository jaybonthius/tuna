; pi-picker:resume chooses one of the chat folder's sessions, newest
; first, each by its name or else your first message, with its age and
; length, and goes on in it.
> (define session-folder
    (string-append (getenv "HOME") "/agent/sessions/--"
                   (list->string (map (lambda (c) (if (char=? c #\/) #\- c)) (cdr (string->list project))))
                   "--"))
> (system (string-append "mkdir -p " session-folder))
0
> (define (write-session! id lines date)
    (let ([path (string-append session-folder "/" id ".jsonl")])
      (call-with-output-file path
        (lambda (p) (for-each (lambda (l) (put-string p (json->string l)) (newline p))
                              (cons `(("type" . "session") ("version" . 3) ("id" . ,id) ("cwd" . ,project)) lines)))
        '(replace))
      (system (string-append "touch -d '" date "' " path))
      path))
