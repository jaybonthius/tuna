; Hooks get the buffer, with it current, so local entries run too. An
; entry that raises is reported and the save goes on.
> (define calls '())
> (define (note name) (lambda (b) (set! calls (cons (list name (buffers:name b) (eq? b (buffers:current))) calls))))
> (add-hook! files:after-visit (note 'after-visit))
> (add-hook! files:after-save (note 'after-save))
> (add-hook! files:after-revert (note 'after-revert))
> (define (refuse b) (error 'hooked "refused"))
> (add-hook! files:before-save refuse)
> (disk-checks:write-text! "~/hooks.txt" "h\n")
> (define hooked (files:visit "~/hooks.txt"))
> (eq? hooked (files:visit "~/hooks.txt"))
#t
> (buffers:with-buffer hooked (add-local-hook! files:before-save (note 'local-before-save)))
> (buffers:replace! hooked 1 1 "+")
#<edit 1>
> (files:save-buffer hooked)
! hooked: refused
> (files:save-buffer hooked)
> (remove-hook! files:before-save refuse)
> (files:revert-buffer hooked)
> (reverse calls)
((after-visit "hooks.txt" #t) (local-before-save "hooks.txt" #t) (after-save "hooks.txt" #t) (after-revert "hooks.txt" #t))
; The final line break is an edit, and only for text that lacks one.
> (disk-checks:write-text! "~/final.txt" "no break")
> (define final (files:visit "~/final.txt"))
> (buffers:replace! final 1 1 "a ")
#<edit 1>
> (files:save-buffer final)
> (list (buffers:version final) (text final) (buffers:modified? final))
(2 "a no break\n" #f)
; Reading directly gives the document and the fingerprint.
> (call-with-values (lambda () (files:read-document "~/final.txt"))
    (lambda (doc length hash) (list (document:datums doc) length (= hash (disk-checks:fnv (disk-checks:read-bytes "~/final.txt"))))))
(((buffers:text () "a no break\n")) 11 #t)
; Killing a buffer forgets it.
> (buffers:kill! final)
#t
> (list (files:buffer-visiting "~/final.txt") (memq final (files:buffers)) (buffers:modified? final))
(#f #f #f)
; Reading, saving, writing and reverting pause, so outside a task they
; refuse at once and change nothing.
> (define outside #f)
> (define (call-outside-task batch-ended)
    (unless outside
      (set! outside
        (map (lambda (call) (guard (c [#t (list (condition-who c) (condition-message c))]) (call)))
             (list (lambda () (files:read-document "~/final.txt"))
                   (lambda () (files:save-buffer hooked))
                   (lambda () (files:write-file "~/elsewhere.txt" hooked))
                   (lambda () (files:revert-buffer hooked))))))
    (batch-ended))
> (advice-add! batch-ended call-outside-task)
> (sleep-for 0.05)
> (advice-remove! batch-ended call-outside-task)
> outside
((files:read-document "not in a task") (files:save-buffer "not in a task") (files:write-file "not in a task") (files:revert-buffer "not in a task"))
> (list (buffers:name hooked) (files:buffer-visiting "~/elsewhere.txt"))
("hooks.txt" #f)
