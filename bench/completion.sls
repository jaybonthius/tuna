#!tuna
(import (minibuffer) (completion) (completion-list) (completion-popup) (pickers) (completion matcher) (layout) (views) (buffers)
        (document) (keys) (commands) (jobs) (web) (haml))

(define (now-ns)
  (let ([t (current-time 'time-monotonic)])
    (+ (* (time-second t) 1000000000) (time-nanosecond t))))

;; The main thread's own time, since a job matching on the same CPU
;; would otherwise count.
(define (thread-ns)
  (let ([t (current-time 'time-thread)])
    (+ (* (time-second t) 1000000000) (time-nanosecond t))))

(define (thread-ns-per-op batch thunk)
  (median
    (map (lambda (k)
           (let ([start (thread-ns)])
             (do ([i 0 (fx+ i 1)]) ((fx= i batch)) (thunk))
             (/ (- (thread-ns) start) (exact->inexact batch))))
         (iota 9))))

(define (median xs)
  (list-ref (list-sort < xs) (quotient (length xs) 2)))

(define (ns-per-op batch thunk)
  (median
    (map (lambda (k)
           (collect-rendezvous)
           (let ([start (now-ns)])
             (do ([i 0 (fx+ i 1)]) ((fx= i batch)) (thunk))
             (/ (- (now-ns) start) (exact->inexact batch))))
         (iota 9))))

(define (show name value unit)
  (printf "~a ~,2f ~a\n" name value unit))

(define (names n)
  (list->vector
    (map (lambda (i) (format "~a:~a-~a" (vector-ref '#("files" "buffers" "layout" "editing" "views") (mod i 5))
                             (vector-ref '#("find" "insert" "split" "kill" "scroll" "visit" "save") (mod i 7)) i))
         (iota n))))

(define (paths n)
  (list->vector
    (map (lambda (i) (format "src/~a/plugins/~a/lib/module-~a/part-~a.sls" (mod i 13) (mod i 97) (mod i 1009) i))
         (iota n))))

(define (wait-until done?)
  (let loop ([n 0])
    (unless (or (done?) (= n 2000))
      (sleep-for 0.001)
      (loop (+ n 1)))))

(define-saved %history '() list?)

(jobs:define-worker (%few-at-a-time n emit)
  (do ([i 0 (fx+ i 1)]) ((fx= i n))
    (emit (vector (format "src/a-~a.sls" i) (format "src/b-~a.sls" i) (format "lib/c-~a.sls" i)
                  (format "lib/d-~a.sls" i) (format "lib/e-~a.sls" i)))))

(define (run)
  (let* ([client (web:add-client! 1)] [frame (layout:frame client)]
         [in-frame (lambda (thunk) (parameterize ([web:current-client client]) (layout:call-with-frame frame thunk)))]
         [press (lambda (key) (in-frame (lambda () (keys:press! client key))))])
    ;; One character typed and deleted, so the input stays the same.
    (let ([t (spawn-task (lambda () (in-frame (lambda () (completion:read "M-x " (list (completion:source (candidates (names 900)))) %history)))))])
      (sleep-for 0.05)
      (press "f")
      (show "read-key-900-names" (/ (ns-per-op 200 (lambda () (press "i") (press "DEL"))) 2) "ns")
      (press "C-g")
      (sleep-for 0.05))
    ;; The first read over a job compiles the matcher's worker, so the
    ;; start is measured after one read, as the median of several.
    (let* ([big (paths 100000)]
           [start-read
            (lambda ()
              (let ([start (thread-ns)])
                (spawn-task (lambda () (in-frame (lambda () (completion:read "File: " (list (completion:source (candidates big))) %history)))))
                (sleep-for 0)
                (let ([ns (- (thread-ns) start)] [s (in-frame completion:current-session)])
                  (wait-until (lambda () (not (completion:session-busy? s))))
                  (values s ns))))])
      (let-values ([(s ns) (start-read)])
        (press "C-g")
        (sleep-for 0.05))
      (show "session-start-100000-paths-main-thread"
        (/ (median (map (lambda (k)
                          (let-values ([(s ns) (start-read)])
                            (press "C-g")
                            (sleep-for 0.05)
                            ns))
                        (iota 5)))
           1000.0)
        "µs")
      (let-values ([(s ns) (start-read)])
        (show "read-key-100000-paths-main-thread" (/ (thread-ns-per-op 50 (lambda () (press "x") (press "DEL"))) 2) "ns")
        (wait-until (lambda () (not (completion:session-busy? s))))
        (let ([start (now-ns)])
          (press "9")
          (press "9")
          (wait-until (lambda () (not (completion:session-busy? s))))
          (show "read-key-100000-paths-to-matches" (/ (- (now-ns) start) 1000.0) "µs")))
      (press "C-g")
      (sleep-for 0.05))
    (let ([start (thread-ns)])
      (spawn-task (lambda () (in-frame (lambda () (completion:read "File: " (list (completion:source (job %few-at-a-time 16000))) %history)))))
      (sleep-for 0)
      (let ([s (in-frame completion:current-session)])
        (wait-until (lambda () (not (completion:session-busy? s))))
        (show "job-16000-emissions-main-thread" (/ (- (thread-ns) start) 1000.0) "µs"))
      (press "C-g")
      (sleep-for 0.05))
    (let ([s (make-store (paths 100000) (make-vector 100000 0))] [n (make-store (names 100000) (make-vector 100000 0))])
      (show "match-100000-paths-substring" (/ (ns-per-op 3 (lambda () (store-matches s '((contains "lib/module-1"))))) 1000.0) "µs")
      (show "match-100000-paths-flex" (/ (ns-per-op 3 (lambda () (store-matches s '((contains "p" "m" "9"))))) 1000.0) "µs")
      (show "match-100000-names-substring" (/ (ns-per-op 3 (lambda () (store-matches n '((contains "find"))))) 1000.0) "µs")
      (show "store-100000-paths" (/ (ns-per-op 1 (lambda () (make-store (paths 100000) (make-vector 100000 0)))) 1000.0) "µs"))
    (let ([s (make-store (list->vector (map (lambda (i) (format "~50,,,'-a" i)) (iota 1000))) (make-vector 1000 0))])
      (show "match-inline-limit-flex" (/ (ns-per-op 50 (lambda () (store-matches s '((contains "1" "2" "3"))))) 1000.0) "µs"))
    (let ([t (spawn-task (lambda () (in-frame (lambda () (completion:read "M-x " (list (completion:source (candidates (names 900)))) %history)))))])
      (sleep-for 0.05)
      (let ([v (layout:selected-view)])
        (show "draw-prompt-with-15-rows" (/ (ns-per-op 200 (lambda () (html->bytevector (views:draw v client)))) 1000.0) "µs"))
      (press "C-g")
      (sleep-for 0.05))
    (let ([t (spawn-task (lambda () (in-frame (lambda () (commands:run pickers:execute-extended-command)))))])
      (sleep-for 0.05)
      (let ([v (layout:selected-view)])
        (show "draw-m-x-annotated" (/ (ns-per-op 200 (lambda () (html->bytevector (views:draw v client)))) 1000.0) "µs")
        (show "m-x-key" (/ (ns-per-op 200 (lambda () (press "f") (press "DEL"))) 2000.0) "µs"))
      (press "C-g")
      (sleep-for 0.05))
    (let ([b (buffers:make "big" (apply string-append (map (lambda (i) (format "line ~60,,,'.a\n" i)) (iota 16000))))])
      (layout:switch-to-buffer b)
      (let* ([start (now-ns)] [thread-start (thread-ns)]
             [t (spawn-task (lambda () (in-frame (lambda () (commands:run pickers:line)))))])
        (sleep-for 0)
        (show "line-start-1mb-main-thread" (/ (- (thread-ns) thread-start) 1000.0) "µs")
        (let ([s (in-frame completion:current-session)])
          (wait-until (lambda () (not (completion:session-busy? s))))
          (show "line-matches-1mb" (/ (- (now-ns) start) 1000.0) "µs"))
        (press "C-g")
        (sleep-for 0.05)))
    (let ([b (buffers:make "words" (apply string-append (map (lambda (i) (format "word~a " i)) (iota 300))))])
      (layout:switch-to-buffer b)
      (add-hook! completion:find-region
        (lambda ()
          (let* ([v (views:current)] [p (views:point v)])
            (completion:region (fx- p 2) p
              (list (completion:source (candidates (lambda (prefix) (list->vector (map (lambda (i) (format "word~a" i)) (iota 300)))))))))))
      (views:set-point! (layout:selected-view) (fx- (document:length (buffers:document b)) 1))
      (press "w")
      (press "o")
      (press "C-M-i")
      (show "point-key-popup-open" (/ (ns-per-op 200 (lambda () (press "r") (press "DEL"))) 2000.0) "µs")
      (press "C-g"))))
