> (views:set-option! w views:wrap-lines #t)
> (views:fold! w 2 3)
> (views:set-buffer! w k)
> (list (eq? (views:buffer w) k) (views:point w) (views:folded? w 2) (views:with-view w (views:wrap-lines)))
(#t 5 #f #t)
; Killing a buffer shows another buffer in its views.
> (buffers:kill! k)
#t
