; M-s o during a search lists its query and keeps the search
; running: the next C-s repeats it in the source.
> (define b (src "one foo\ntwo foo-bar\nfoo three foo\n"))
> (press! "C-s" "f" "o" "o" "M-s" "o")
> (wait-listed)
> (list (here) (wins) (listed))
((8 "I-search: foo" "foo") (("src" 8 #t) ("*Occur*" 2 #f)) "4 matches in 3 lines for \"foo\" in buffer: src\none foo\ntwo foo-bar\nfoo three foo\n")
> (press! "C-s")
> (here)
(16 "I-search: foo" "foo")
> (press! "RET")
; A word search is named in the heading and the message.
> (views:set-point! (view) 1)
> (press! "M-s" "w" "f" "o" "o" "M-s" "o")
> (wait-listed)
> (list (listed) (last-message))
("4 matches in 3 lines for word \"foo\" in buffer: src\none foo\ntwo foo-bar\nfoo three foo\n" "Searched 1 buffer; 4 matches for word \"foo\"")
> (press! "RET")
; A count adds context, on a source with lines that do not match.
> (define c (src "a\none foo\nb\nc\nfoo two\nd\n"))
> (press! "C-s" "f" "o" "o" "M-1" "M-s" "o")
> (wait-listed)
> (listed)
"2 matches for \"foo\" in buffer: src\na\none foo\nb\nc\nfoo two\nd\n"
> (press! "RET")
; C-u collects; with groups in a regexp search the template is read with
; the search's keys off, so the characters edit the prompt.
> (views:set-point! (view) 1)
> (press! "C-s" "f" "o" "o" "C-u" "M-s" "o")
> (wait-listed)
> (list (here) (listed))
((10 "I-search: foo" "foo") "2 matches for \"foo\" in buffer: src\nfoo\nfoo\n")
> (press! "RET")
> (views:set-point! (view) 1)
> (press! "C-M-s" "(" "f" ")" "o" "o")
> (start! "C-u" "M-s" "o")
> (question)
"Regexp to collect (default \\1): "
> (type! "x\\1")
> (press! "RET")
> (wait-listed)
> (list (here) (listed))
((10 "Regexp I-search: (f)oo" "foo") "2 matches for \"(f)oo\" in buffer: src\nxf\nxf\n")
> (press! "RET")
