"rainbow-delimiters/rainbow-delimiters.css"
; A known defect: a command runs with its view's own values, and they
; apply to every buffer, not only the view's. Here v's own #f hides b's
; #t, and a Scheme buffer opened by a command in v gets no bracket spans
; and clears b's, until the bracket users change outside such a command.
> (define c (buffers:make "c.ss" "(x (y))\n"))
> (views:set-option! v rainbow-delimiters:mode #f)
> (views:call-with-view v (lambda () (syntax:brackets-used? b)))
#f
> (views:call-with-view v (lambda () (modes:set-major-mode chez-scheme:mode c)))
> (buffers:with-buffer c (rainbow-delimiters:mode))
#t
> (brackets c)
()
> (brackets b)
()
> (views:set-option! v rainbow-delimiters:mode #t)
> (syntax:bracket-users-changed)
> (map caddr (brackets c))
(((bracket . 1)) ((bracket . 2)) ((bracket . 2)) ((bracket . 1)))
