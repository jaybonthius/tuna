[good body]
; A report names the module the raising code ran for, but not (init),
; (repl) or (tuna).
> (car '())
! car: () is not a pair
> (call-as-owner (module-owner '(good)) (lambda () (car '())))
! (good) car: () is not a pair
; Advice on report runs as its own owner.
> (define events '())
> (define (note! . e) (set! events (cons e events)))
> (define (note-report report c) (note! 'report (owner-name (current-owner))) (report c))
> (advice-add! report note-report)
> (call-as-owner (module-owner '(good)) (lambda () (vector-ref (vector) 1)))
! (good) vector-ref: 1 is not a valid index for #()
> (reverse events)
((report (repl)))
; A load that raises is reported; module-loaded hears of each instance
; that loads.
> (set! events '())
> (advice-add! module-loaded (lambda (loaded instance) (note! 'loaded (owner-name instance)) (loaded instance)))
> (import (dict))
! (dict) car: () is not a pair
> (import (usesbad))
! (dict) car: () is not a pair
> (reverse events)
((report (repl)) (report (repl)))
; After a failed reload, the previous version loads again.
> (set! events '())
> (define good (string-append (getenv "HOME") "/.config/tuna/lib/good.sls"))
> (write-module! good "#!tuna\n(define (hello) 1)\n(error 'good \"broken\")\n")
> (reload-modules! '((good)))
[good body]
! good: broken
> (good:hello)
"hello"
> (reverse events)
((loaded (good)) (report (repl)))
; A module that fails to compile has no body that raised.
> (set! events '())
> (write-module! good "#!tuna\n(define (hello) (let ((y)) y))\n")
> (reload-modules! '((good)))
[good body]
! invalid syntax (let ((y)) y) at line 2, char 17 of $HOME/.config/tuna/lib/good.sls
> (reverse events)
((loaded (good)) (report (repl)))
