> (define notes (buffers:make "notes" "one\ntwo\n"))
> (views:set-buffer! (view) notes)
> (define log '())
> (commands:define-command (note [what 'none]) "Notes WHAT." (set! log (cons what log)))
> (transient:define-menu m "A menu.")
> (commands:define-command (show-m) "Shows m." (transient:show! m))
> (define (show!) (in-client (lambda () (commands:run show-m))))
; Entries added under one heading join its group; groups show in the
; order of their first entry, entries in the order added. A heading may
; be #f.
> (transient:add! m "Actions" (transient:command "a" "Apply" note 'apply))
> (transient:add! m #f (transient:command "x" "Extra" note 'extra))
> (transient:add! m "Arguments" (transient:switch "- v" "Verbose" "--verbose"))
> (transient:add! m "Actions" (transient:command "b" "Build" note 'build))
> (show!)
> (menu)
(("Actions" ("a" "Apply") ("b" "Build")) (("x" "Extra")) ("Arguments" ("- v" "Verbose" "--verbose")))
; Each entry is clickable; the menu, whose keymap binds the left button
; to keys:ignore, is inert, marked on the element of the view's lines.
> (let ([s (html (popup))])
    (let loop ([from 0] [acc '()])
      (let ([i (search s "data-click=\"" from)])
        (if i
            (let ([start (+ i 12)]) (loop start (cons (substring s start (search s "\"" start)) acc)))
            (reverse acc)))))
("inert" "clickable" "clickable" "clickable" "clickable")
; Each entry's key is bound in the menu to transient:press.
> (map (lambda (b) (cons (car b) (commands:command-name (cdr b)))) (keys:bindings m))
(("a" . transient:press) ("x" . transient:press) ("- v" . transient:press) ("b" . transient:press))
; An entry for a key the menu has replaces it and moves to the end of
; its heading's group.
> (transient:add! m "Arguments" (transient:command "a" "Again" note 'again))
> (menu)
((("x" "Extra")) ("Arguments" ("- v" "Verbose" "--verbose") ("a" "Again")) ("Actions" ("b" "Build")))
> (press! "a")
> log
(again)
; extra.sls replaces the merge menu's m and adds a group; when it
; unloads, the entry it replaced comes back.
> (import (magit))
> (load-module! '(extra))
> (press! "C-c" "m")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Squash instead")) ("More" ("s" "Squash")))
> (press! "m")
> (list magit:merges extra:squashes)
(() (()))
> (unload-module! '(extra))
> (press! "C-c" "m")
> (menu)
("Merge" ("Arguments" ("- f" "Fast-forward only" "--ff-only") ("- n" "No fast-forward" "--no-ff") ("- s" "Strategy" "--strategy=")) ("Actions" ("m" "Merge")))
> (press! "C-g")
; remove! removes an entry and its key, whichever module added them.
> (show!)
> (transient:remove! magit:merge-menu "- s")
> (transient:remove! m "x")
> (menu)
(("Arguments" ("- v" "Verbose" "--verbose") ("a" "Again")) ("Actions" ("b" "Build")))
> (list (table-ref m "x") (table-ref magit:merge-menu "- s"))
(#f #f)
> (press! "C-g")
; A description and a heading may be procedures, run at each draw in the
; menu's view; one that raises is reported once while the menu shows, and
; its part of the menu is left out.
> (define level 1)
> (transient:add! m (lambda () (string-append "Level " (number->string level)))
    (transient:command "l" (lambda () (string-append "Raise from " (number->string level))) note 'level))
> (transient:add! m "Broken" (transient:command "k" (lambda () (car '())) note 'broken))
> (show!)
! car: () is not a pair
> (menu)
(("Arguments" ("- v" "Verbose" "--verbose") ("a" "Again")) ("Actions" ("b" "Build")) ("Level 1" ("l" "Raise from 1")))
> (set! level 2)
> (menu)
(("Arguments" ("- v" "Verbose" "--verbose") ("a" "Again")) ("Actions" ("b" "Build")) ("Level 2" ("l" "Raise from 2")))
> (press! "C-g")
; A key bound in a menu with keys:bind! wins over its entry: the menu
; draws what the key runs, in a last group, and the key closes the menu
; and runs without the menu's arguments.
> (keys:bind! m "b" note)
> (show!)
! car: () is not a pair
> (menu)
(("Arguments" ("- v" "Verbose" "--verbose") ("a" "Again")) ("Level 2" ("l" "Raise from 2")) (("b" "note")))
> (press! "b")
> (list (menu) (car log))
(() none)
> (keys:unbind! m "b")
> (transient:add! m "Actions" (transient:command "b" "Build" note 'build))
; A computed group's entries come from its procedure at each draw. An
; entry whose key is not one printing character, or is one the menu has,
; is left out, with a warning once while the menu shows.
> (define names '("alpha" "beta"))
> (transient:add-computed! m "Computed"
    (lambda ()
      (append (map (lambda (name) (transient:command (substring name 0 1) name note (string->symbol name))) names)
              (list (transient:command "a" "Clash" note 'clash) (transient:command "zz" "Long" note 'long)
                    (transient:command "c" "Second c" note 'second)))))
> (show!)
! car: () is not a pair
! transient:add-computed!: the computed entry a is left out: the menu has its key
! transient:add-computed!: the computed entry b is left out: the menu has its key
! transient:add-computed!: the computed entry zz is left out: its key is not one printing character
> (menu)
(("Arguments" ("- v" "Verbose" "--verbose") ("a" "Again")) ("Level 2" ("l" "Raise from 2")) ("Actions" ("b" "Build")) ("Computed" ("c" "Second c")))
> (set! names '("gamma" "beta"))
> (menu)
(("Arguments" ("- v" "Verbose" "--verbose") ("a" "Again")) ("Level 2" ("l" "Raise from 2")) ("Actions" ("b" "Build")) ("Computed" ("g" "gamma") ("c" "Second c")))
> (press! "g")
> (car log)
gamma
> (show!)
! car: () is not a pair
! transient:add-computed!: the computed entry b is left out: the menu has its key
! transient:add-computed!: the computed entry a is left out: the menu has its key
! transient:add-computed!: the computed entry zz is left out: its key is not one printing character
> (press! "z")
! z is not in this menu
> (menu)
(("Arguments" ("- v" "Verbose" "--verbose") ("a" "Again")) ("Level 2" ("l" "Raise from 2")) ("Actions" ("b" "Build")) ("Computed" ("g" "gamma") ("c" "Second c")))
> (press! "C-g")
; A second computed group with an equal heading replaces the first, which
; comes back when the replacer's module unloads.
> (import (computed))
> (in-client (lambda () (commands:run computed:show-menu)))
> (menu)
(("Computed" ("p" "Original")))
> (load-module! '(recomputed))
> (menu)
(("Computed" ("q" "Replacement")))
> (press! "q")
> (list (menu) computed:log)
(() (replacement))
> (in-client (lambda () (commands:run computed:show-menu)))
> (unload-module! '(recomputed))
> (menu)
(("Computed" ("p" "Original")))
> (press! "C-g")
; A heading that is not a string is reported, named by the procedure
; given it.
> (transient:define-menu hm "Headings.")
> (transient:add! hm (lambda () 42) (transient:command "a" "A" note 'a))
> (transient:add! hm "Fine" (transient:command "b" "B" note 'b))
> (in-client (lambda () (transient:show! hm)))
! transient:add!: a title, heading or description that is not a string with irritant 42
> (menu)
(("Fine" ("b" "B")))
> (press! "C-g")
; The procedures check what they are given.
> (raised (lambda () (transient:add! 'menu #f)))
(transient:add! "not a table")
> (raised (lambda () (transient:add! m 'heading)))
(transient:add! "neither a string, a procedure nor #f")
> (raised (lambda () (transient:add! m #f 'entry)))
(transient:add! "not an entry")
> (raised (lambda () (transient:add! m #f (transient:command "C-" "Bad" note))))
(keys:bind! "not a valid key sequence")
> (raised (lambda () (transient:add-computed! m #f 'entries)))
(transient:add-computed! "not a procedure")
> (raised (lambda () (transient:remove! m 'x)))
(transient:remove! "not a string")
> (raised (lambda () (transient:command 'k "K" note)))
(transient:command "not a string")
> (raised (lambda () (transient:command "k" 'k note)))
(transient:command "neither a string nor a procedure")
> (raised (lambda () (transient:command "k" "K" 'note)))
(transient:command "not a command")
> (raised (lambda () (transient:staying-command "k" "K" 'note)))
(transient:staying-command "not a command")
> (raised (lambda () (transient:switch "k" "K" 'arg)))
(transient:switch "not a string")
> (raised (lambda () (transient:valued-switch "k" "K" "--k=" "reader")))
(transient:valued-switch "not a procedure")
> (map transient:entry? (list (transient:switch "k" "K" "--k") 'entry))
(#t #f)
