; The layout's part mode reads keys in the layout's own view, so RET
; there still leaves it.
> (define (type! key . modifiers)
    (parameterize ([web:current-client client])
      ((tables:ref web:input-handlers "key") client
       (list (cons "type" "key") (cons "key" key) (cons "code" "") (cons "modifiers" (list->vector modifiers))))))
