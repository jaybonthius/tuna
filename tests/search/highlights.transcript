; A highlight draws a scan's matches in one view for one client, the
; current match in its face with its groups, the others in
; faces:match.other.
> (define other (web:add-client! 2))
> (define b (text-buffer "h" "ab-cd ef-gh ab-cd\n"))
> (define v (views:make b))
> (define q (search:make-query "(\\w+)-(\\w+)" search:regexp))
> (define s (scanned b q))
> (define h (search:highlight! v client s))
> (define (faced html)
    (let loop ([from 0] [acc '()])
      (let ([i (let find ([i from]) (cond [(> (+ i 11) (string-length html)) #f]
                                         [(string=? (substring html i (+ i 11)) "data-face=\"") i]
                                         [else (find (+ i 1))]))])
        (if i
            (let* ([name-end (let find ([j (+ i 11)]) (if (char=? (string-ref html j) #\") j (find (+ j 1))))]
                   [open (let find ([j i]) (if (char=? (string-ref html j) #\>) (+ j 1) (find (+ j 1))))]
                   [close (let find ([j open]) (if (char=? (string-ref html j) #\<) j (find (+ j 1))))])
              (loop close (cons (list (substring html (+ i 11) name-end) (substring html open close)) acc)))
            (reverse acc)))))
> (define (drawn c) (faced (html->string (views:draw v c))))
> (search:highlight? h)
#t
> (drawn client)
> (drawn other)
> (search:set-current! h (search:find b q 7 forward) faces:match)
> (drawn client)
> (search:set-current! h #f faces:match)
> (drawn client)
(("match.other" "ab-cd") ("match.other" "ef-gh") ("match.other" "ab-cd"))
()
(("match.other" "ab-cd") ("match" "") ("search.group-1" "ef") ("search.group-2" "gh") ("match.other" "ab-cd"))
(("match.other" "ab-cd") ("match.other" "ef-gh") ("match.other" "ab-cd"))
; For no client, every client that draws the view sees it.
> (define all (search:highlight! v #f s))
> (drawn other)
> (search:end-highlight! all)
> (search:end-highlight! h)
> (drawn client)
(("match.other" "ab-cd") ("match.other" "ef-gh") ("match.other" "ab-cd"))
()
