    (let ([j (apply start worker input on-result on-end)])
      (jobs:stop! j)
      j))
> (advice-add! jobs:start stop-at-start)
> (guard (c [#t (condition-message c)]) (files:rename-file "~/a.txt" "~/b.txt"))
"the job was stopped"
