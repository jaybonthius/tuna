; Quits requested from another thread land anywhere in drawing, mostly in
; the draws themselves. Layout reports none of them as an error and goes
; on drawing, and once the quits stop every client shows the newest
; screen. A loaded machine draws and quits less often, so the storm goes
; on until more than a hundred draws were quit, giving up twenty seconds
; on, so that a layout that stops drawing shows as a false result rather
; than a timeout.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define desktop (web:connect! 'desktop))
> (define phone (web:connect! 'phone))
> (define n 0)
> (define started 0)
> (define finished 0)
> (define (heavy screen client)
    (set! started (+ started 1))
    (let ([s (haml (:div (map (lambda (i) (haml (:p "line " i))) (iota 200)) (:p "n " n)))])
      (set! finished (+ finished 1))
      s))
> (advice-add! layout:screen heavy)
> (define quits 0)
> (define others 0)
> (define (count-reports report c)
    (if (quit-condition? c) (set! quits (+ quits 1)) (set! others (+ others 1))))
> (advice-add! report count-reports)
> (define quitting #t)
> (define stopped #f)
> (define (quitter)
    (let loop ()
      (if quitting
          (begin
            (request-quit!)
            (chez:sleep (make-time 'time-duration 200000 0))
            (loop))
          (set! stopped #t))))
> (define forked #f)
; A quit lands up to a thousand calls after its request, and the
; quitter's last request may come after the stress ends. One guard
; holds from before the quitter starts until long after it stops,
; since a quit landing between two guards would end the form. Quits
; land at least a thousand calls apart, so none lands in the handler
; before it enters the guard again. The stand-in web keeps every screen
; it is sent, so the storm drops them as it goes, lest a long storm fill
; memory.
> (define (stress until)
    (let again ()
      (guard (c [(quit-condition? c) (set! quits (+ quits 1)) (again)])
        (unless forked
          (set! forked #t)
          (fork-thread quitter))
        (let loop ()
          (when (and (< (real-time) (+ until 20000))
                     (or (< (real-time) until) (<= (- started finished) 100)))
            (set! n (+ n 1))
            (web:given! desktop)
            (web:given! phone)
            (sleep-for 0)
            (loop)))
        (set! quitting #f)
        (let spin () (unless stopped (spin)))
        (let settle ([k 0]) (when (< k 100000) (settle (+ k 1)))))))
> (begin
    (stress (+ (real-time) 1500))
    (list (> (- started finished) 100) others))
(#t 0)
> (advice-remove! report count-reports)
> (sleep-for 0)
> (define (newest client)
    (let ([s (last-shown client)])
      (string=? (substring s (- (string-length s) (string-length (format "<p>n ~a</p></div>" n))) (string-length s))
                (format "<p>n ~a</p></div>" n))))
> (list (newest desktop) (newest phone))
(#t #t)
; A failing draw after the quits is reported once, as before.
> (define (desktop-fails screen client)
    (if (eq? client desktop) (car '()) (screen client)))
> (advice-add! layout:screen desktop-fails)
! car: () is not a pair
> (sleep-for 0)
> (advice-remove! layout:screen desktop-fails)
> (newest desktop)
#t
