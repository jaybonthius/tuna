; Shift-click extends the region from the mark, or from point when
; there is none; shift-drag extends the same way.
> (start! "abcdefghij" 3)
("abcdefghij" ((3 #f)))
> (mouse! "down" 7 shift)
> (mouse! "click" 7 shift)
> (state)
("abcdefghij" ((7 3)))
> (mouse! "down" 9 shift)
> (mouse! "click" 9 shift)
> (state)
("abcdefghij" ((9 3)))
> (mouse! "down" 5 shift)
> (mouse! "move" 1)
> (mouse! "drag" 2 shift)
> (state)
("abcdefghij" ((2 3)))
> (press! "C-f")
> (state)
("abcdefghij" ((3 #f)))
