; e switches to occur:edit-mode and says how to leave; it runs
; occur:mode-hook's entries before occur:edit-mode-hook's.
> (define b (src "one foo\ntwo\nfoo three foo\nfour\n"))
> (define (source) (buffers:text-between (buffers:document b) 0 (document:length (buffers:document b))))
> (define ran '())
> (define (in-mode) (set! ran (cons (list 'occur (modes:major-mode (buffers:current))) ran)))
> (define (in-edit) (set! ran (cons (list 'edit (modes:major-mode (buffers:current))) ran)))
> (add-hook! occur:mode-hook in-mode)
> (add-hook! occur:edit-mode-hook in-edit)
> (occur! (search:make-query "foo" search:regexp) 1 #f)
> (in-occur!)
> (only!)
> (press! "e")
> (list (modes:major-mode (views:buffer (view))) (last-message) (reverse ran))
> (remove-hook! occur:mode-hook in-mode)
> (remove-hook! occur:edit-mode-hook in-edit)
(occur:edit-mode "Editing: Type C-c C-c to return to Occur mode." ((occur occur:mode) (occur occur:edit-mode) (edit occur:edit-mode)))
; An edit to a listed line is made at its place in the source, which
; is shown in another view, not selected, its point at the edit.
> (define placements '())
> (advice-add! views:scroll-to! (lambda (orig v p align) (set! placements (cons (list (buffers:name (views:buffer v)) p align) placements)) (orig v p align)))
> (views:set-point! (view) (+ (find-text (occur-buffer) "foo three") 4))
> (press! "X")
> (list (listed) (source) (wins))
("3 matches in 2 lines for \"foo\" in buffer: src\none foo\ntwo\nfoo Xthree foo\nfour\n" "one foo\ntwo\nfoo Xthree foo\nfour\n" (("*Occur*" 71 #t) ("src" 18 #f)))
; The edit's place is scrolled to the source view's centre.
> placements
(("src" 18 center))
; Undo in *Occur* is an edit too.
> (press! "C-/")
> (source)
"one foo\ntwo\nfoo three foo\nfour\n"
; The heading, a number and a context line refuse edits.
> (views:set-point! (view) 3)
> (press! "Z")
> (views:set-point! (view) (find-text (occur-buffer) "two"))
> (press! "Z")
> (source)
