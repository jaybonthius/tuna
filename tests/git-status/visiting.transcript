> (define repo (fresh! "repo"))
> (define (at-line) (let* ([v (view)] [doc (buffers:document (views:buffer v))] [p (views:point v)]) (list (shown-buffer) (document:line doc p) (document:column doc p))))
> (define (back!) (layout:switch-to-buffer (status-buffer)))
> (ui:show-section! (view) (section '(file . "a.py") '(unstaged . #f)))
> (ui:show-section! (view) (section '(file . "b.txt") '(staged . #f)))
; RET on an unstaged file visits it in the selected view at its first
; changed line.
> (go-to-section! '(file . "a.py") '(unstaged . #f))
> (press! "RET")
> (settle!)
> (at-line)
("a.py" 2 0)
; RET on an added line visits its line, at the column after the
; prefix.
> (back!)
> (go-to-in! "+NINE" '(file . "a.py") '(unstaged . #f))
> (press! "C-f" "C-f")
> (press! "RET")
> (settle!)
> (at-line)
("a.py" 9 1)
; RET on a removed line visits the line that follows the removal.
> (back!)
> (go-to-in! "-two" '(file . "a.py") '(unstaged . #f))
> (press! "RET")
> (settle!)
> (at-line)
("a.py" 2 0)
; RET, C-j and C-RET on a staged line visit the worktree file at
; the corresponding line.
> (back!)
> (go-to-in! "+BETA" '(file . "b.txt") '(staged . #f))
> (press! "RET")
> (settle!)
> (at-line)
("b.txt" 2 0)
> (back!)
> (go-to-in! "+BETA" '(file . "b.txt") '(staged . #f))
> (press! "C-j")
> (settle!)
> (at-line)
("b.txt" 2 0)
> (back!)
> (go-to-in! "+BETA" '(file . "b.txt") '(staged . #f))
> (press! "C-RET")
> (settle!)
> (at-line)
("b.txt" 2 0)
; C-u RET visits in another view and selects it.
> (back!)
> (define status-view (view))
> (go-to-section! '(file . "a.py") '(unstaged . #f))
> (press! "C-u" "RET")
> (settle!)
> (list (at-line) (eq? (view) status-view) (eq? (views:buffer status-view) (status-buffer)))
(("a.py" 2 0) #f #t)
> (press! "C-x" "o")
; RET on a deleted file visits its path, an empty buffer.
> (back!)
> (go-to-section! '(file . "gone.txt") '(unstaged . #f))
> (press! "RET")
> (settle!)
> (list (shown-buffer) (document:text (buffers:document (views:buffer (view)))))
("gone.txt" "")
; RET on an untracked file visits it.
> (back!)
> (ui:show-section! (view) (section '(untracked . #f)))
> (go-to-section! '(file . "new.txt") '(untracked . #f))
> (press! "RET")
> (settle!)
> (shown-buffer)
"new.txt"
; RET on a list heading, a header or a commit raises.
> (back!)
> (go-to-section! '(unstaged . #f))
> (press! "RET")
! git-status:visit: Cannot determine file to visit
> (press! "M-<")
> (press! "RET")
! git-status:visit: Cannot determine file to visit
> (go-to-in! "Second commit" '(unpushed . "@{upstream}"))
> (press! "RET")
! git-status:visit: Cannot determine file to visit
