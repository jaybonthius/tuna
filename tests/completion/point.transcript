; TAB with nothing selected puts in the longest common start of the
; matches' whole texts, each its source's prefix and its text, from the
; region's start, though the region's sources split it differently.
> (define (after-slash input)
    (let loop ([i (string-length input)])
      (cond [(= i 0) 0] [(char=? (string-ref input (- i 1)) #\/) i] [else (loop (- i 1))])))
> (define two (buffers:make "two" ""))
> (define (two-region)
    (let ([v (views:current)])
      (and (eq? (views:buffer v) two)
           (completion:region 1 (views:point v)
             (list (completion:source (candidates (vector "main.sls" "mainly")) (split after-slash))
                   (completion:source (candidates (vector "lib/maint"))))))))
> (add-hook! completion:find-region two-region)
