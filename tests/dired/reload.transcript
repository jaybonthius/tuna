; Reloading the plugin keeps its listings, their marks and their mode,
; and its entry in files:folder-visitors comes back.
> (import (tuna eval))
> (define library (getenv "TUNA_LIBRARY"))
> (define (reload! name) (eval-file (string-append library "/" name ".sls")))
> (touch! "r/a.txt" "a\n")
> (define b (dired:visit (at "r")))
> (layout:switch-to-buffer b)
> (goto "a.txt")
> (press! "m")
> (reload! "dired")
> (settle)
> (list (eq? b (files:visit (at "r"))) (listing-lines b) (modes:major-mode b) (buffers:with-buffer b (files:offer-save?)))
(#t ("  ." "  .." "* a.txt") dired:mode #f)
> (press! "g")
> (settle)
> (listing-lines b)
("  ." "  .." "* a.txt")
> (drawn-has? "dired-entry")
(#t)
