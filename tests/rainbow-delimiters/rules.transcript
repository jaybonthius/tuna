; Loading and unloading the plugin tell the language plugins to look at
; syntax:bracket-users again; so does each change to the mode.
> (define told 0)
> (add-hook! syntax:bracket-users-changed (lambda () (set! told (+ told 1))))
> (unload-module! '(rainbow-delimiters))
> told
1
> (import (rainbow-delimiters))
> told
2
> (set-option! rainbow-delimiters:mode #t)
> (set-option! rainbow-delimiters:mode #f)
> told
4
; The mode is off by default, so nothing is coloured until a
; configuration turns it on: this one does in chez-scheme:mode's hook.
> (rainbow-delimiters:mode)
#f
> (define plain (buffers:make "notes.txt" "(a)"))
> (buffers:with-buffer plain (rainbow-delimiters:mode))
#f
> (syntax:brackets-used? plain)
#f
> (define b (scheme-buffer "a.ss" "(define (f x) [list #(x)])\n"))
> (buffers:with-buffer b (rainbow-delimiters:mode))
#t
> (syntax:brackets-used? b)
#t
; A minor mode with no keymap and no lighter.
> (table-ref modes:minor-modes rainbow-delimiters:mode #f)
0
> (table-ref modes:keymaps rainbow-delimiters:mode #f)
#f
> (modes:lighter rainbow-delimiters:mode)
#f
> (define v (views:make b))
> (equal? (modes:active-minor-modes v) (list rainbow-delimiters:mode))
#t
; The job sends a span per bracket, and each is drawn with the face of
; its depth.
> (brackets b)
((1 2 ((bracket . 1))) (9 10 ((bracket . 2))) (13 14 ((bracket . 2))) (15 16 ((bracket . 2))) (21 23 ((bracket . 3))) (24 25 ((bracket . 3))) (25 26 ((bracket . 2))) (26 27 ((bracket . 1))))
> (lines v)
"<div class=\"line\" id=\"v1-1\" data-line=\"1\" data-at=\"1\"><span class=\"cursor primary\"></span><span data-face=\"rainbow-delimiters.depth-1\">(</span><span data-face=\"keyword\">define</span> <span data-face=\"rainbow-delimiters.depth-2\">(</span><span data-face=\"function\">f</span> x<span data-face=\"rainbow-delimiters.depth-2\">)</span> <span data-face=\"rainbow-delimiters.depth-2\">[</span><span data-face=\"function.builtin\">list</span> <span data-face=\"rainbow-delimiters.depth-3\">#(</span>x<span data-face=\"rainbow-delimiters.depth-3\">)</span><span data-face=\"rainbow-delimiters.depth-2\">]</span><span data-face=\"rainbow-delimiters.depth-1\">)</span></div><div class=\"line\" id=\"v1-2\" data-line=\"2\"><br></div>"
; Depths 1 to 9 have a face each; deeper brackets take depth-1 to
; depth-9 again, in turn. A closing bracket with no opening is
; unmatched, and one of the wrong shape is mismatched.
> (define deep (scheme-buffer "deep.ss" "((((((((((((x))))))))))))\n) (]\n"))
> (define deep-view (views:make deep))
> (bracket-faces deep-view)
(depth-1 depth-2 depth-3 depth-4 depth-5 depth-6 depth-7 depth-8 depth-9 depth-1 depth-2 depth-3 depth-3 depth-2 depth-1 depth-9 depth-8 depth-7 depth-6 depth-5 depth-4 depth-3 depth-2 depth-1 unmatched depth-1 mismatched)
; With one outermost-only face, the faces start again at depth-2, so
; depth-1 marks only the outermost list.
> (set-option! rainbow-delimiters:outermost-only-face-count 1)
> (bracket-faces deep-view)
(depth-1 depth-2 depth-3 depth-4 depth-5 depth-6 depth-7 depth-8 depth-9 depth-2 depth-3 depth-4 depth-4 depth-3 depth-2 depth-9 depth-8 depth-7 depth-6 depth-5 depth-4 depth-3 depth-2 depth-1 unmatched depth-1 mismatched)
> (remove-option! rainbow-delimiters:outermost-only-face-count)
> (map caddr (brackets deep))
(((bracket . 1)) ((bracket . 2)) ((bracket . 3)) ((bracket . 4)) ((bracket . 5)) ((bracket . 6)) ((bracket . 7)) ((bracket . 8)) ((bracket . 9)) ((bracket . 10)) ((bracket . 11)) ((bracket . 12)) ((bracket . 12)) ((bracket . 11)) ((bracket . 10)) ((bracket . 9)) ((bracket . 8)) ((bracket . 7)) ((bracket . 6)) ((bracket . 5)) ((bracket . 4)) ((bracket . 3)) ((bracket . 2)) ((bracket . 1)) ((bracket . unmatched)) ((bracket . 1)) ((bracket . mismatched)))
