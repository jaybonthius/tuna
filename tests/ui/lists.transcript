(1 1)
; Once the maker of a list unloads, its rows draw as nothing: the first
; draw reports the error, later draws and RET call nothing.
> (with-output-to-file (string-append (getenv "HOME") "/.config/tuna/lib/maker.sls")
    (lambda ()
      (display "#!tuna\n")
      (write '(import (ui) (buffers) (document)))
      (write '(define made (buffers:make "*made*" (ui:list '()))))
      (write '(define names (vector "p" "q")))
      (write '(define (shout i) (ui:label (string-append (vector-ref names i) "!"))))
      (write '(ui:set-rows! made (document:token (buffers:document made) 0) 2 shout shout))))
> (load-module! '(maker))
> (show! (buffers:find "*made*"))
