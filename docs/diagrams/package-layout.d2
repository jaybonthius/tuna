# Which package may depend on which?
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: up

classes: {
  core: {
    style: {
      fill: "#e8f5e9"
      stroke: "#2e7d32"
      font-color: "#1b3d1f"
      border-radius: 8
      font-size: 18
    }
  }
  pkg: {
    style: {
      fill: "#f7f9fc"
      stroke: "#6b7a90"
      stroke-dash: 3
      font-color: "#2b3445"
      font-size: 18
    }
  }
  contract: {
    style: {
      fill: "#fff8e1"
      stroke: "#8d6e00"
      font-color: "#3e2f00"
      border-radius: 8
      font-size: 17
    }
  }
  plugin: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 17
    }
  }
  user: {
    style: {
      fill: "#fce4ec"
      stroke: "#ad1457"
      font-color: "#4a0d24"
      border-radius: 8
      font-size: 17
    }
  }
}

legend: |md
  **Status:** proposed. Arrows mean "imports". Dashed boxes are packages.
  Green: Tuna itself. Yellow: a concept's contract. Blue: a plugin. Pink: your own files.
  Nothing points from Tuna to a package, and no plugin imports another plugin.
|

tuna: "tuna/\nkernel, libraries, start-up program,\nthe init.ss language\n(knows no plugin and no editor concept)" {class: core}

buffers: "plugins/buffers/  (the buffers concept)" {
  class: pkg
  contract: "contract.ss\nwhat any buffers plugin promises" {class: contract}
  plugin: "plugin.ss\nthe default buffers plugin" {class: plugin}
}

completion: "plugins/completion/  (the completion concept)" {
  class: pkg
  contract: "contract.ss\ncandidates, matching styles, the list UI slot" {class: contract}
  plugin: "plugin.ss\nthe default completion engine" {class: plugin}
}

orderless: "plugins/orderless/" {
  class: pkg
  plugin: "plugin.ss\na matching style" {class: plugin}
}

mine: "your package" {
  class: pkg
  plugin: "my-buffers.ss\nyour own buffers plugin" {class: user}
}

init: "your init.ss" {class: user}

buffers.contract -> tuna
buffers.plugin -> buffers.contract
completion.contract -> buffers.contract
completion.plugin -> completion.contract
orderless.plugin -> completion.contract
mine.plugin -> buffers.contract
init -> mine.plugin: "use-plugin"
init -> orderless.plugin: "use-plugin"
init -> tuna: "#lang :tuna/config"
