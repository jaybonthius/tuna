; echo-area:face
> (parameterize ([echo-area:face faces:warning])
    (echo-area:message! "~a is larger than 10 MB" "server.log"))
> (echo-area:current-message)
"server.log is larger than 10 MB"
> (echo-area-element)
"<div class=\"echo-area-message\" role=\"status\" data-face=\"warning\"><div class=\"line\" id=\"v3-4\" data-line=\"1\" data-at=\"1\">server.log is larger than 10 MB</div></div>"
; echo-area:current-face
> (parameterize ([echo-area:face faces:error]) (echo-area:message! "Disk full"))
