; M-x runs the command chosen, passing the prefix argument on; it becomes
; the last command.
> (define notes (buffers:make "notes" "one\ntwo\nthree\n"))
> (views:set-buffer! (view) notes)
> (define t (start! (lambda () (press! "C-u" "3" "M-x"))))
> (type! "editing:forward-char")
> (press! "RET")
> (result t)
> (views:point (view))
4
> (commands:command-name (commands:last-command))
editing:forward-char
> (pickers:command-history)
("editing:forward-char")
; Private commands are not offered.
> (define t (start! (lambda () (press! "M-x"))))
> (type! "%answer")
> (texts (session))
()
> (press! "C-g")
! &quit
; C-x b previews the selected buffer in the selected view and puts back
; the view's buffer and point when the read is quit.
> (define other (buffers:make "other" "x\n"))
> (views:set-point! (view) 5)
> (define t (start! (lambda () (press! "C-x" "b"))))
> (wait-matches (session))
> (texts (session))
("*scratch*" "*Messages*" "other" "notes" "sub" "a.txt")
> (views:buffer (car (layout:views)))
#<buffer *scratch*>
> (type! "oth")
> (wait-matches (session))
> (views:buffer (car (layout:views)))
#<buffer other>
> (press! "C-g")
! &quit
> (result t)
> (views:buffer (view))
#<buffer notes>
> (views:point (view))
5
; A name that no candidate names makes a buffer of that name.
> (define t (start! (lambda () (press! "C-x" "b"))))
> (type! "fresh")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (views:buffer (view))
#<buffer fresh>
> (text (views:buffer (view)))
""
; C-x k offers the current buffer by default.
> (define t (start! (lambda () (press! "C-x" "k"))))
> (press! "RET")
> (result t)
> (buffers:find "fresh")
#f
; pickers:read-buffer returns the buffer chosen.
> (define t (start! (lambda () (pickers:read-buffer "Buffer: " pickers:buffer-history other))))
> (press! "RET")
> (result t)
#<buffer other>
; M-s l on a large buffer splits its lines in a job; point follows the
; selection and comes back when the read is quit.
> (define big (buffers:make "big" (apply string-append (map (lambda (i) (format "line ~a\n" i)) (iota 2000)))))
> (views:set-buffer! (view) big)
> (define t (start! (lambda () (press! "M-s" "l"))))
> (define s (session))
> (wait-matches s)
> (vector-length (completion:session-matches s))
2000
> (type! "1999")
> (wait-matches s)
> (texts s)
("line 1999")
> (views:point (view))
21
> (press! "C-g")
! &quit
> (views:point (view))
1
> (define t (start! (lambda () (press! "M-s" "l"))))
> (type! "line 1500")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (document:line (buffers:document big) (views:point (view)))
1501
; C-x C-f reads a file name from the current buffer's directory, else
; the home folder, with ~ for it; directories end in /.
> (views:set-buffer! (view) notes)
> (define t (start! (lambda () (press! "C-x" "C-f"))))
> (input)
"~/"
> (type! "src/")
> (sleep-for 0.3)
> (texts (session))
(".hidden" "blob.bin" "link.txt" "text.txt")
> (type! "te")
> (sleep-for 0.3)
> (press! "RET")
> (result t)
> (files:path (views:buffer (view)))
"~/src/text.txt"
; A path that does not exist is taken too, with ~ expanded.
> (define t (start! (lambda () (pickers:read-file-name "File: "))))
> (minibuffer:input (prompt))
"~/src/"
> (type! "new.txt")
> (sleep-for 0.3)
> (press! "RET")
> (let ([p (result t)]) (string=? p (string-append (getenv "HOME") "/src/new.txt")))
#t
> (pickers:file-name-history)
("~/src/new.txt" "~/src/text.txt")
; M-s g searches the files under the current buffer's directory, leaving
; out hidden files, symbolic links and binary files; after #, the input
; filters the lines found.
> (define t (start! (lambda () (press! "M-s" "g"))))
> (define s (session))
> (type! "ne")
> (sleep-for 0.5)
> (texts s)
()
> (type! "edle")
> (sleep-for 0.5)
> (texts s)
("text.txt:1:needle one" "text.txt:3:needle two")
> (type! "#two")
> (sleep-for 0.3)
> (texts s)
("text.txt:3:needle two")
> (press! "RET")
> (result t)
> (views:buffer (view))
#<buffer text.txt>
> (document:line (buffers:document (views:buffer (view))) (views:point (view)))
3
; Files over the size limit are left out.
> (set-option! pickers:grep-max-file-size 10)
> (define t (start! (lambda () (press! "M-s" "g"))))
> (define s (session))
> (type! "needle")
> (sleep-for 0.5)
> (texts s)
()
> (press! "C-g")
! &quit
> (set-option! pickers:grep-max-file-size 1000000)
