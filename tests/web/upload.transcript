> (http:wait-for-server)
Tuna is at http://127.0.0.1:PORT/
> (define p (http:page))
> (define (upload name client body)
    (http:status (http:post (string-append "/upload/" name) (if client (list (cons "tuna-client" client)) '()) body)))
; An upload's handler gets the client named by its Tuna-Client header and
; the body, on a thread other than the main thread, and the upload gets
; 204 once it returns.
> (define main (get-thread-id))
> (define counted (box '()))
> (table-set! web:upload-handlers "count"
    (lambda (client bytes)
      (set-box! counted (cons (list client (bytevector-length bytes) (eqv? (get-thread-id) main)) (unbox counted)))))
> (list (upload "count" (http:id p) (make-bytevector 6400 1)) (upload "count" (http:id p) #vu8()))
(204 204)
> (reverse (unbox counted))
((#<client 1> 6400 #f) (#<client 1> 0 #f))
; A name with no handler gets 404; a client that is unknown, or no
; header, gets 204 and the body is dropped.
> (set-box! counted '())
> (map (lambda (name) (upload name (http:id p) "x")) '("nothing" "count/more" ""))
(404 404 404)
> (list (upload "count" "nobody" "x") (upload "count" #f "x") (unbox counted))
(204 204 ())
; A handler runs as the module whose entry is in effect, and one that
; raises is reported as that module's; the upload gets 500.
> (import (handlers))
> (upload "module-owner" (http:id p) "x")
204
> handlers:upload-owner
(handlers)
> (upload "module-fail" (http:id p) "x")
! (handlers) car: () is not a pair
500
; An entry whose module has unloaded is no handler, also while the batch
; that unloads it lasts and the server still holds the entry: 404, and
; nothing is reported.
> (begin
    (unload-module! '(handlers))
    (http:status (http:post-in-batch "/upload/module-owner" (list (cons "tuna-client" (http:id p))) "x")))
404
> (upload "module-owner" (http:id p) "x")
404
; A removed client's uploads are dropped.
> (http:goodbye! p)
204
> (list (upload "count" (http:id p) "x") (unbox counted))
(204 ())
; A name that is not 1 to 64 letters, digits and hyphens, or a value that
; is not a procedure, is reported once and serves nothing.
> (table-set! web:upload-handlers "bad name" (lambda (client bytes) (void)))
! web:upload-handlers: not 1 to 64 letters, digits and hyphens with irritant "bad name"
> (table-set! web:upload-handlers "not-one" 'symbol)
! web:upload-handlers: not a procedure with irritant symbol
> (upload "not-one" (http:id (http:page)) "x")
404
