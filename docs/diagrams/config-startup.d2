# What happens when Tuna starts with your configuration?
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: right

classes: {
  yours: {
    style: {
      fill: "#fff8e1"
      stroke: "#8d6e00"
      font-color: "#3e2c00"
      border-radius: 8
      font-size: 18
    }
  }
  tuna: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 18
    }
  }
  out: {
    style: {
      fill: "#f3f3f3"
      stroke: "#555555"
      font-color: "#222222"
      border-radius: 8
      font-size: 18
    }
  }
}

legend: |md
  **Status:** built 2026-10-12 (configuration stage 1). Yellow boxes are yours.
|

files: "Your init.ss\nwhich plugins (with what options:\nplanned, stage 3), plus your own code" {class: yours}
boot: "Start-up step\nruns init.ss in a trial run\nand collects what it declares" {class: tuna}
kernel: "Kernel\nturns each plugin on, or undoes it" {class: tuna}
plugins: "Your plugins\neach one on its own" {class: yours}
init: "Your own code\napplied last" {class: yours}
terminal: "Terminal and log file\nwhat worked, what failed, and why" {class: out}

files -> boot: "1. read"
boot -> kernel: "2. turn on each plugin"
kernel -> plugins: "3. a failure is undone and skipped;\nplugins that need it are skipped too"
kernel -> init: "4. then your code"
boot -> terminal: "5. report"
