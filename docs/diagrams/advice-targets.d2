# What can be advised, and who keeps the advice?
vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
  }
}
direction: right

classes: {
  yes: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 18
    }
  }
  no: {
    style: {
      fill: "#f4f4f4"
      stroke: "#777777"
      font-color: "#333333"
      border-radius: 8
      stroke-dash: 4
      font-size: 18
    }
  }
}

plugin: "Your plugin\nadds advice; turning it off removes it" {class: yes}

can: "Built: can be advised" {
  cmd: "A command\nlayers kept by the commands plugin" {class: yes}
  svc: "A service operation\nlayers live with its service slot" {class: yes}
  decl: "An open package function, private too\nshared by module and name; also supports redefine" {class: yes}
}

cannot: "Cannot be advised" {
  plain: "Ordinary Gerbil modules\nand functions marked def/closed" {class: no}
  kernel: "Tuna's kernel\nchange it through hooks and services" {class: no}
}

plugin -> can.cmd: "advise"
plugin -> can.svc: "advise"
plugin -> can.decl: "advise"
