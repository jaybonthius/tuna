; A mouse item names a place at the version its screen drew; views turns
; it into a position now and presses the mouse key in the view.
> (import (md))
> (define (raised thunk)
    (guard (c [#t (list (if (who-condition? c) (condition-who c) 'none)
                        (if (message-condition? c) (condition-message c) c))])
      (thunk)))
> (define c1 (web:make-client 1))
> (define b (buffers:make "plain" "one two\nthree\n"))
> (define v (views:make b))
> (define seen '())
> (commands:define-command (record [event (keys:command-event)])
    "Records the event that ran it and the current view."
    (set! seen (cons (list event (eq? (views:current) (views:posn-view (keys:event-start event)))) seen)))
> (define (take!) (let ([s (reverse seen)]) (set! seen '()) s))
> (for-each (lambda (k) (keys:bind! keys:global k record))
    '("<down-mouse-1>" "<mouse-1>" "<drag-mouse-1>" "<mouse-movement>"))
> (define (item view . fields)
    (append fields
            `(("type" . "mouse") ("button" . 1) ("clicks" . 1) ("modifiers" . #())
              ("view" . ,(views:id view)) ("version" . ,(buffers:version (views:buffer view)))
              ("showing" . ,(views:shown-count view)))))
> (define (mouse! view . fields)
    (as-client c1 (lambda () ((table-ref web:input-handlers "mouse") c1 (apply item view fields)))))
; The view's element names its buffer's version and how many buffers it
; has shown; a line that starts after its line's start names where.
> (show v)
<div class="view nowrap" id="view-1" data-view="1" data-version="0" data-showing="0" data-placement="*" data-place-kind="follow" data-place-item="1" data-place-at="1" data-base-item="1" data-base-offset="0.0" data-base-height="0.0" data-base-left="0.0" data-scroll-margin="2" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end><div class="view-lines"><div class="line" id="v1-1" data-line="1" data-at="1"><span class="cursor primary"></span>one two</div><div class="line" id="v1-2" data-line="2">three</div><div class="line" id="v1-3" data-line="3"><br></div></div></div>
