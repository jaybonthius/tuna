; Unloading a module unloads its importers first, running their unload
; actions.
> (put-version! "speller-plain.sls" ".config/tuna/lib/speller.sls")
> (import (speller))
> (map car (owner-changes (module-owner '(speller))))
(unload-action define)
> (define held spell:check)
> (unload-owner! (module-owner '(spell)))
speller unloading
; A call to its changeable definitions raises, by name or through a
; procedure the name gave, and so does any other use of its names.
> (spell:check "a")
! spell:check: module (spell) is unloaded
> (held "a")
! spell:check: module (spell) is unloaded
> (spell:checked)
! spell:checked: module (spell) is unloaded
> (speller:go)
! speller:go: module (speller) is unloaded
> (define spell:language (lambda () "fr"))
; Both are gone; other owners' layers stay on its names.
> (map module-owner '((spell) (speller)))
(#f #f)
> (owner-changes (plugins:configuration-owner))
((advice #<procedure> #<procedure announce>) (override #<procedure> #f))
> (map car (definition-changes files:save!))
(#<owner (init) 1> #<owner (files) 1>)
> (files:save! "a")
saving a 
"a"
; It is not loaded any more.
> (call-as-owner (module-owner '(spell)) (lambda () 1))
! call-as-owner: not an owner with irritant #f
> (eval-in-module '(language) '(spell))
! eval-in-module: not a loaded module with irritant (spell)
> (unload-owner! (module-owner '(spell)))
! unload-owner!: not an owner with irritant #f
; Loaded again, it is a new instance: its body runs, the configuration's
; override still stands on its name, and a held procedure calls it.
> (define loads '())
> (advice-add! module-loaded (lambda (loaded name) (set! loads (cons name loads)) (loaded name)))
> (load-module! '(spell))
#<owner (spell) 2>
> loads
(#<owner (spell) 2>)
> (spell:dictionary-path)
"/home/groucho/words"
> (held "b")
checking b against /home/groucho/words
> (map car (owner-changes (module-owner '(spell))))
(advice define define define define define)
; Loading a loaded module does nothing.
> (load-module! '(spell))
#<owner (spell) 2>
> loads
(#<owner (spell) 2>)
; The importer stays unloaded until it is loaded again.
> (speller:go)
! speller:go: module (speller) is unloaded
> (load-module! '(speller))
#<owner (speller) 2>
> (speller:go)
checking z against /home/groucho/words
; An internal module: its importers are unloaded, and every one of its
; names is shadowed, a record constructor's included; a procedure taken
; from a name that is not a changeable definition still runs.
> (import (magit))
> (define make magit/git:make-thing)
> (unload-owner! (module-owner '(magit git)))
> (magit/git:run)
! magit/git:run: module (magit git) is unloaded
> magit/git:make-thing
! magit/git:make-thing: module (magit git) is unloaded
> magit/git:version
! magit/git:version: module (magit git) is unloaded
> (magit:status)
! magit:status: module (magit) is unloaded
> (record? (make 5))
#t
; Loading the importer loads its unloaded import too, and rebinds the
; names of both.
> (load-module! '(magit))
#<owner (magit) 2>
> (list magit/git:version (magit/git:run) (magit:status))
(1 git-default git-default)
; A changeable definition called within the form that unloads it raises.
> (begin (unload-owner! (module-owner '(magit git))) (magit:status))
! magit:status: module (magit) is unloaded
; Unloading a module that others import unloads them; the configuration,
; which imports files, loads a new files at once, and its own advice comes
; back with it.
> (unload-owner! (module-owner '(files)))
speller unloading
> (files:save! "x")
saving x [spell] 
"x"
> (spell:check "x")
checking x against /home/groucho/words
> (owner-changes (plugins:configuration-owner))
((advice #<procedure> #<procedure announce>) (override #<procedure> #f))
> (load-module! '(spell))
#<owner (spell) 3>
> (files:save! "y")
saving y [spell] 
"y"
> (load-module! '(nothere))
! load-module!: not a module with irritant (nothere)
> (load-module! '(tuna))
! load-module!: not a module with irritant (tuna)
> (load-module! '(chezscheme))
! load-module!: not a module with irritant (chezscheme)
> (load-module! '(init))
! load-module!: not a module with irritant (init)
> (unload-owner! (module-owner 'spell))
! module-owner: not a module name with irritant spell
; Unload actions run newest first; one that raises goes to report, and
; the rest run.
> (put-version! "actions.sls" ".config/tuna/lib/actor.sls")
> (import (actor))
> (unload-owner! (module-owner '(actor)))
third 
! (actor) second: failed
first 
; Unloading a module that removed another's advice restores the advice.
> (put-version! "remover.sls" ".config/tuna/lib/remover.sls")
> (import (remover))
> (files:save! "z")
saving z 
"z"
> (unload-owner! (module-owner '(remover)))
> (files:save! "z")
saving z [spell] 
"z"
