(config w ok)
[dict config]
; plugins:update! writes only the commit into the line: it replaces the
; commit string, or adds a commit clause after the last source clause, and
; the rest of the file, the line's comments and config forms included,
; stays as written. The reload reads the configuration again, which runs
; the config forms again.
> (plugins:update! 'spell)
(config w checked)
[dict config]
> (plugins:update! 'dict)
(config w checked)
[dict config]
> (list (spell:check "w") (spell:language))
("w checked" "en-GB")
> (display (call-with-input-file "~/.config/tuna/init.ss" get-string-all))
(import (options) (plugins))
(import (tuna)) ; spelling below
(use-plugin spell (git "https://github.com/bob/spell") ; bob's fork
  (commit "7aef47d91aac4e80e99afe4724b175c2929d9003")   ; pinned
  (config
    ;; British
    (options:set! spell:language "en-GB")
    (display (list 'config (spell:check "w")))
    (newline)))
(use-plugin dict (git "https://github.com/bob/dict") (commit "970b0a43ee40c28577c410f6df9d800b8872405e") ; newest
  (config (display "[dict config]\n")))
(import (console))
; plugins:remove! comments out the line, config forms and all.
> (plugins:remove! 'spell)
[dict config]
> (display (call-with-input-file "~/.config/tuna/init.ss" get-string-all))
(import (options) (plugins))
(import (tuna)) ; spelling below
#;(use-plugin spell (git "https://github.com/bob/spell") ; bob's fork
  (commit "7aef47d91aac4e80e99afe4724b175c2929d9003")   ; pinned
  (config
    ;; British
    (options:set! spell:language "en-GB")
    (display (list 'config (spell:check "w")))
    (newline)))
(use-plugin dict (git "https://github.com/bob/dict") (commit "970b0a43ee40c28577c410f6df9d800b8872405e") ; newest
  (config (display "[dict config]\n")))
(import (console))
> (plugins:installed)
(dict)
; Evaluating the configuration again runs neither the line nor its forms;
; plugins:remove! unloaded the plugin.
> (plugins:load-configuration!)
[dict config]
> (spell:check "w")
! spell:check: module (spell) is unloaded
