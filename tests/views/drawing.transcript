; The region is drawn around every layer's spans, one span per line,
; and those of a layer above priority 0 that it reaches are marked as
; above it; it is cut only where a node's element begins or ends.
> (define code (buffers:make "code" "(define x 1)\n"))
> (define cview (views:make code))
> (buffers:add-span! (buffers:layer code hints) 2 8 '((face . keyword)))
> (buffers:add-span! (buffers:layer code marks) 9 10 '((face . (spell.misspelled variable))))
> (views:set-point! cview 5)
> (views:set-mark! cview 12)
> (let ([html (html->string (views:draw cview #f))]) (let ([from (search html "<div class=\"line\"" 0)]) (substring html from (search html "</div>" from))))
"<div class=\"line\" id=\"v78-1\" data-line=\"1\" data-slot=\"0\" data-at=\"1\">(<span data-face=\"keyword\">def</span><span class=\"region\"><span data-face=\"keyword\"><span class=\"cursor-on primary\">i</span>ne</span> <span class=\"above-region\" data-face=\"variable\"><span class=\"above-region\" data-face=\"spell.misspelled\">x</span></span> 1</span>)"
; A byte that is not UTF-8 draws as a backslash and three octal digits,
; in the face escape-glyph, and holds one position.
> (define raw (buffers:make "raw" (list 'buffers:text '() "caf" (vector 'document:raw-byte '((byte . 233))) " " (vector 'document:raw-byte '((byte . 7))) "\n")))
> (define rv (views:make raw))
> (views:set-point! rv 6)
> (let ([html (html->string (views:draw rv #f))]) (let ([from (search html "<div class=\"line\"" 0)]) (substring html from (search html "</div>" from))))
"<div class=\"line\" id=\"v79-1\" data-line=\"1\" data-slot=\"0\" data-at=\"1\">caf<span class=\"node\" data-at=\"4\" data-to=\"5\"><span data-face=\"escape-glyph\">\\351</span></span> <span class=\"cursor primary\"></span><span class=\"node\" data-at=\"6\" data-to=\"7\"><span data-face=\"escape-glyph\">\\007</span></span>"
; A control character other than a tab or a line break draws as ^ and a
; character in the face escape-glyph, marked as one position, so a CR
; does not break the line and a NUL is not dropped. Lines with and
; without a cursor or a span draw them alike.
> (define ctl (buffers:make "ctl" "a\rb\x0;\x7f;\x1b;\tc\nx\x7;y\nz\x1f;w\n"))
> (define ctlv (views:make ctl))
> (buffers:add-span! (buffers:layer ctl hints) 14 17 '((face . keyword)))
> (views:set-point! ctlv 3)
> (let ([html (html->string (views:draw ctlv #f))])
    (let loop ([from (search html "<div class=\"line\"" 0)] [acc '()])
      (if (not from)
          (reverse acc)
          (let ([end (search html "</div>" from)])
            (loop (search html "<div class=\"line\"" end) (cons (substring html from end) acc))))))
