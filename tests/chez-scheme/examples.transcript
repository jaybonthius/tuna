; The examples of the prog, syntax and chez-scheme pages, in order. The
; configuration is the pages' init.ss examples.
; prog
> (modes:ancestry chez-scheme:mode)
(chez-scheme:mode prog:mode)
> (define program (scheme-buffer "program.ss" "(display 1)\n"))
> (buffers:with-buffer program (modes:derived? (modes:major-mode (buffers:current)) prog:mode))
#t
> (list (modes:lighter prog:mode) (table-ref modes:parents prog:mode #f) (eq? (table-ref modes:keymaps prog:mode) prog:keymap))
("Prog" #f #t)
> (keys:bind! prog:keymap "C-c C-u" editing:upcase-region)
> (local files:require-final-newline program)
#t
; syntax
> (define b (buffers:make "lexed.ss" "(car '(a b)) ; c\n"))
> (modes:set-major-mode chez-scheme:mode b)
> (eq? (syntax:lexer chez-scheme:mode) chez-scheme:lexer)
#t
> (syntax:make-lexeme (syntax:class open) 1 2 1 (syntax:lexeme-marks))
#<lexeme open 1 2 1>
> (syntax:lexemes b 6 9)
(#<lexeme prefix 6 7 1> #<lexeme open 7 8 2> #<lexeme atom 8 9 2>)
> (syntax:lexeme-at b 15)
#<lexeme comment 14 17 0>
> (syntax:lexeme-at b 17)
#<lexeme comment 14 17 0>
> (syntax:lexeme-at b 6)
#f
> (syntax:openings b 9)
(#<lexeme open 1 2 1> #<lexeme open 7 8 2>)
> (syntax:sexp-before b 12)
6
> (syntax:sexp-before b 13)
1
> (define e (buffers:make "commented.ss" ";; (greet:text \"x\")\n"))
> (modes:set-major-mode chez-scheme:mode e)
> (syntax:sexp-before e 20)
4
> (syntax:sexp-after b 5)
12
> (syntax:top-level-form b 9)
1
13
> (syntax:top-level-form b 15)
1
13
> (table-set! syntax:bracket-users 'test (lambda (buffer) #t))
> (syntax-highlighting:update!)
> (brackets b)
((1 2 ((bracket . 1))) (7 8 ((bracket . 2))) (11 12 ((bracket . 2))) (12 13 ((bracket . 1))))
> (table-remove! syntax:bracket-users 'test)
> (syntax-highlighting:update!)
; chez-scheme
> (disk:write-text! "~/.config/tuna/lib/greet.sls" "#!tuna\n(define (text name) (string-append \"Hello, \" name \"!\"))\n")
> (modes:major-mode (files:visit "~/.config/tuna/lib/greet.sls"))
chez-scheme:mode
> (define c (buffers:make "lexed-c.ss" "(car '(a b))\n"))
> (vector-ref (chez-scheme:lexer (buffers:document c)) 2)
#<lexeme prefix 6 7 1>
> (modes:major-mode (files:visit "~/notes.ms"))
! ask:message: (New file)
chez-scheme:mode
> (map (lambda (binding) (list (car binding) (commands:command-name (cdr binding)))) (keys:bindings chez-scheme:keymap))
(("C-c C-u" editing:upcase-region))
