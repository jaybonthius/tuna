; Each value a worker emits reaches on-result as a task, in order, on
; behalf of the module that started the job.
> (define-worker (match-names query)
    (emit (string-append "matches for " query))
    (emit (list 1 2 (vector 3))))
> (list (worker? match-names) match-names)
(#t #<worker match-names>)
> (job-results match-names "spe" 2)
("matches for spe" (1 2 #(3)))
> (define-worker (count-up n) (do ([i 0 (+ i 1)]) ((= i n)) (emit i)))
> (equal? (job-results count-up 1000 1000) (iota 1000))
#t
> (define job #f)
> (begin
    (set! job (start-job match-names "x" (lambda (v) (note! (list (current-owner) (task? (current-task)))))))
    (list (job? job) job (module-changes '(repl))))
(#t #<job> ((job #<job> #f)))
> (wait-for-end job)
> (list log (module-changes '(repl)))
((((repl) #t) ((repl) #t)) ())
; A worker imports plain R6RS libraries.
> (define-worker (count-words text) (import (wordlib)) (emit (word-count text)))
> (job-results count-words "one two  three" 1)
(3)
; Only the main thread loads a module, so a worker cannot import one.
> (define-worker (greets x) (import (greeter)) (emit (greeter:greeting)))
> (wait-for-end (start-job greets 1 note!))
! import: only the main thread makes changes
; A worker's body sees only Chez's names, emit and its imports, not the
; REPL's.
> (define secret 42)
> (define-worker (sees-repl x) (emit secret))
> (wait-for-end (start-job sees-repl 1 note!))
! attempt to reference unbound identifier secret
; A raise in a worker is reported on the main thread and ends the job;
; after a warning it goes on.
> (define-worker (fails x) (car x))
> (wait-for-end (start-job fails 1 note!))
! car: 1 is not a pair
> (define-worker (warns x) (warning 'worker "careful") (emit 'went-on))
> (set! log '())
> (wait-for-end (start-job warns 1 note!))
! worker: careful
> log
(went-on)
> (define-worker (leaks x) (emit car))
> (wait-for-end (start-job leaks 1 note!))
! emit: not plain data with irritant #<procedure car>
; Chez's exit, reset and abort, which a worker sees, end the job.
> (define-worker (exits x) (emit 1) (exit) (emit 2))
> (define-worker (resets x) (emit 1) (reset) (emit 2))
> (define-worker (aborts x) (emit 1) (abort) (emit 2))
> (set! log '())
> (wait-for-end (start-job exits 0 note!))
> (wait-for-end (start-job resets 0 note!))
> (wait-for-end (start-job aborts 0 note!))
> log
(1 1 1)
; stop-job! makes a runaway worker raise &quit, which ends it unreported.
> (define-worker (spin x)
    (dynamic-wind void (lambda () (let loop () (loop))) (lambda () (emit 'stopped))))
> (set! log '())
> (define spinning (start-job spin 0 note!))
> (sleep-for 0.1)
> (stop-job! spinning)
> (wait-for-end spinning)
> log
(stopped)
> (stop-job! spinning)
; Unloading a module stops its jobs, and their results no longer reach
; on-result.
> (import (searcher))
> (set! log '())
> (as-module '(searcher) (start-job searcher:count-slowly "searcher-stopped" note!))
#<job>
> (sleep-for 0.1)
> (list (module-changes '(searcher)) (file-exists? "searcher-stopped"))
(((job #<job> #f)) #f)
> (define seen #f)
> (begin (unload-module! '(searcher)) (set! seen (length log)) (> seen 0))
#t
> (wait-for-file "searcher-stopped")
> (sleep-for 0.05)
> (= seen (length log))
#t
; Unloading a module quits its paused job-result tasks.
> (load-module! '(searcher))
> (define-worker (echo x) (emit x))
> (begin
    (as-module '(searcher)
      (start-job echo 1
        (lambda (v)
          (guard (c [(quit-condition? c) (display "searcher's result quit") (newline)])
            (sleep-for 3600)))))
    (void))
> (sleep-for 0.1)
> (unload-module! '(searcher))
searcher's result quit
; Arguments are checked, and a job is a change, which only the main
; thread makes.
> (start-job match-names car note!)
! start-job: not plain data with irritant #<procedure car>
> (start-job note! "x" note!)
! start-job: not a worker with irritant #<procedure note!>
> (start-job match-names "x" 'note!)
! start-job: not a procedure with irritant note!
> (stop-job! match-names)
! stop-job!: not a job with irritant #<worker match-names>
> (emit 1)
! emit: not in a worker
> (let ([message #f])
    (thread-join
      (fork-thread
        (lambda ()
          (set! message (guard (c [#t (condition-message c)]) (start-job match-names "x" note!))))))
    message)
"only the main thread makes changes"
