; files:rename-file renames on a job; each buffer visiting the file, or
; a file under a renamed folder, follows, renamed after its file and
; still modified; then files:after-rename runs with the two paths.
> (import (files attributes))
> (define (base path) (path-last path))
> (define (raised thunk)
    (guard (c [#t (list (if (who-condition? c) (condition-who c) 'none)
                        (if (message-condition? c) (condition-message c) c))])
      (thunk)))
> (define renames '())
> (hooks:add! files:after-rename (lambda (from to) (set! renames (cons (list from to) renames))))
> (disk-checks:folder! "~/d")
> (disk-checks:write-text! "~/d/one.txt" "one\n")
> (disk-checks:write-text! "~/d/two.txt" "two\n")
> (define one (files:visit "~/d/one.txt"))
> (buffers:replace! one 1 1 "1 ")
#<edit 1>
> (files:rename-file "~/d/one.txt" "~/d/uno.txt")
> (list (buffers:name one) (files:path one) (buffers:modified? one) (disk-checks:folder-files "~/d") renames)
("uno.txt" "$HOME/d/uno.txt" #t ("two.txt" "uno.txt") (("$HOME/d/one.txt" "$HOME/d/uno.txt")))
> (files:rename-file "~/d" "~/e")
> (list (files:path one) (disk-checks:exists? "~/d") (car renames))
("$HOME/e/uno.txt" #f ("$HOME/d" "$HOME/e"))
; A target that exists is replaced only with no-fail; a folder never goes
; inside itself; failures name the path and the system's reason.
> (raised (lambda () (files:rename-file "~/e/uno.txt" "~/e/two.txt")))
(files:rename-file "file exists")
> (files:rename-file "~/e/uno.txt" "~/e/two.txt" (file-options no-fail))
> (list (disk-checks:folder-files "~/e") (disk-checks:read-text "~/e/two.txt"))
(("two.txt") "one\n")
> (raised (lambda () (files:rename-file "~/e" "~/e/inner")))
(files:rename-file "cannot put a folder inside itself")
; A failure's message names a path under the home folder with ~, as the
; questions do; its filename stays whole, for code.
> (guard (c [(i/o-filename-error? c) (list (i/o-error-filename c) (condition-message c))])
    (files:rename-file "~/none" "~/other"))
("$HOME/none" "failed for ~/none: no such file or directory")
; A rename refuses a target, or a file under it, that a buffer it does
; not move visits, as write-file does, before it touches the disk; and a
; file renamed or copied to itself is refused as the same file.
> (disk-checks:folder! "~/r")
> (disk-checks:write-text! "~/r/a.txt" "a\n")
> (disk-checks:write-text! "~/r/b.txt" "b\n")
> (define a (files:visit "~/r/a.txt"))
> (define b (files:visit "~/r/b.txt"))
> (raised (lambda () (files:rename-file "~/r/a.txt" "~/r/b.txt" (file-options no-fail))))
(files:rename-file "another buffer visits the file")
> (guard (c [#t (condition-irritants c)])
    (files:rename-file "~/r/a.txt" "~/r/b.txt" (file-options no-fail)))
("~/r/b.txt")
> (list (map buffers:name (list a b)) (map files:path (list a b)) (disk-checks:folder-files "~/r") (car renames))
(("a.txt" "b.txt") ("$HOME/r/a.txt" "$HOME/r/b.txt") ("a.txt" "b.txt") ("$HOME/e/uno.txt" "$HOME/e/two.txt"))
> (disk-checks:folder! "~/s")
> (define new (files:visit "~/s/new.txt"))
> (raised (lambda () (files:rename-file "~/r" "~/s" (file-options no-fail))))
(files:rename-file "another buffer visits the file")
> (buffers:kill! new)
#t
> (files:rename-file "~/r" "~/s" (file-options no-fail))
> (list (map files:path (list a b)) (disk-checks:exists? "~/r"))
(("$HOME/s/a.txt" "$HOME/s/b.txt") #f)
> (list (raised (lambda () (files:rename-file "~/s/a.txt" "~/s/a.txt")))
        (raised (lambda () (files:copy-file "~/s" "~/s"))))
((files:rename-file "the same file") (files:copy-file "the same file"))
; A rename replaces only a file or an empty folder, also across file
; systems, where it copies: a folder that holds files is refused as
; rename(2) refuses it, and nothing moves.
> (define other (format "/dev/shm/tuna-files-~a" (get-process-id)))
> (define (in-other name) (string-append other "/" name))
> (files:make-folder (in-other "full"))
> (files:make-folder (in-other "empty"))
> (disk-checks:write-text! (in-other "full/keep.txt") "keep\n")
> (disk-checks:folder! "~/full")
> (disk-checks:write-text! "~/full/keep.txt" "keep\n")
> (list (raised (lambda () (files:rename-file "~/s" "~/full" (file-options no-fail))))
        (raised (lambda () (files:rename-file "~/s" (in-other "full") (file-options no-fail))))
        (raised (lambda () (files:rename-file "~/s/a.txt" (in-other "empty") (file-options no-fail))))
        (raised (lambda () (files:rename-file "~/s" (in-other "full/keep.txt") (file-options no-fail)))))
((files:rename-file "failed for ~/s: directory not empty") (files:rename-file "failed for ~/s: directory not empty") (files:rename-file "failed for ~/s/a.txt: is a directory") (files:rename-file "failed for ~/s: not a directory"))
> (list (disk-checks:folder-files "~/s") (disk-checks:folder-files (in-other "full")) (disk-checks:folder-files "~/full"))
(("a.txt" "b.txt") ("keep.txt") ("keep.txt"))
> (files:rename-file "~/s" (in-other "empty") (file-options no-fail))
> (list (equal? (map files:path (list a b)) (map in-other '("empty/a.txt" "empty/b.txt")))
        (disk-checks:folder-files (in-other "empty")) (disk-checks:exists? "~/s"))
(#t ("a.txt" "b.txt") #f)
> (buffers:kill! a)
#t
> (buffers:kill! b)
#t
> (files:delete-file other)
; files:copy-file copies a file keeping its mode and time, a folder with
; everything in it, and a symbolic link as a link.
> (disk-checks:set-mode! "~/e/two.txt" #o640)
> (disk-checks:symlink! "two.txt" "~/e/link")
0
> (files:copy-file "~/e" "~/f")
> (list (disk-checks:folder-files "~/f") (disk-checks:symlink? "~/f/link") (number->string (disk-checks:mode "~/f/two.txt") 8)
        (= (file-attributes-modified (read-file-attributes (disk-checks:expand "~/e/two.txt")))
           (file-attributes-modified (read-file-attributes (disk-checks:expand "~/f/two.txt")))))
(("link" "two.txt") #t "640" #t)
> (raised (lambda () (files:copy-file "~/e/two.txt" "~/f/two.txt")))
(files:copy-file "failed for ~/f/two.txt: file exists")
> (disk-checks:write-text! "~/e/three.txt" "3\n")
> (files:copy-file "~/e" "~/f" (file-options no-fail))
> (disk-checks:folder-files "~/f")
("link" "three.txt" "two.txt")
; With no-fail a link replaces a file or a link, as unlink(2) then
; symlink(2) do, and never a folder: a folder is refused with its files
; kept, whether the link is copied alone or inside a folder.
> (files:copy-file "~/e/link" "~/f/three.txt" (file-options no-fail))
> (files:copy-file "~/e/link" "~/f/link" (file-options no-fail))
> (list (disk-checks:symlink? "~/f/three.txt") (disk-checks:symlink? "~/f/link"))
(#t #t)
> (disk-checks:folder! "~/src")
> (disk-checks:symlink! "elsewhere" "~/src/l")
0
> (disk-checks:folder! "~/dst")
> (disk-checks:folder! "~/dst/l")
> (disk-checks:write-text! "~/dst/l/precious.txt" "keep\n")
> (list (raised (lambda () (files:copy-file "~/src" "~/dst" (file-options no-fail))))
        (raised (lambda () (files:copy-file "~/src/l" "~/dst/l" (file-options no-fail)))))
((files:copy-file "failed for ~/dst/l: is a directory") (files:copy-file "failed for ~/dst/l: is a directory"))
> (list (disk-checks:symlink? "~/dst/l") (disk-checks:read-text "~/dst/l/precious.txt"))
(#f "keep\n")
; files:delete-file deletes a link, not its target, and a folder with
; everything in it.
> (files:delete-file "~/f/link")
> (list (disk-checks:folder-files "~/f") (disk-checks:exists? "~/e/two.txt"))
(("three.txt" "two.txt") #t)
> (files:delete-file "~/f")
> (disk-checks:exists? "~/f")
#f
; files:make-folder makes missing folders above too, and raises when the
; folder exists.
> (files:make-folder "~/g/h/i")
> (disk-checks:exists? "~/g/h/i")
#t
> (raised (lambda () (files:make-folder "~/g/h")))
(files:make-folder "file exists")
; files:move-to-trash moves to the freedesktop.org trash with a
; .trashinfo naming the path; a second file of the same name gets
; another name.
> (files:move-to-trash "~/g/h")
> (files:make-folder "~/g/h")
> (files:move-to-trash "~/g/h")
