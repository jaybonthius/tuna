; Quits requested every millisecond land in mode switches, the hooks
; they run, key lookups through the modes' entry and minor-mode changes.
; Afterwards every buffer has a defined mode, setting it gives each the
; local values its mode sets, a reload of a mode's plugin gives them
; back, and keys find the modes' keymaps as before.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)) (tuna eval))
> (define library (getenv "TUNA_LIBRARY"))
> (define buffers
    (map (lambda (i) (buffers:make (format "b~a" i) "f(x)\n")) (iota 6)))
> (show! (car buffers))
#<buffer b0>
> (define reported 0)
> (define (count-reports report c) (set! reported (+ reported 1)))
> (advice-add! report count-reports)
> (define quits-caught 0)
> (define rounds 0)
> (define quitting #t)
> (define stopped #f)
> (define (quitter)
    (let loop ()
      (if quitting
          (begin
            (request-quit!)
            (chez:sleep (make-time 'time-duration 1000000 0))
            (loop))
          (set! stopped #t))))
> (define modes (list python:mode text:mode modes:fundamental prog:mode))
> (define (stress until)
    (let again ()
      (guard (c [(quit-condition? c) (set! quits-caught (+ quits-caught 1)) (again)])
        (with-exception-handler
          (lambda (c) (if (warning? c) (set! reported (+ reported 1)) (raise-continuable c)))
          (lambda ()
            (let loop ([k 0])
              (when (< (real-time) until)
                (let ([b (list-ref buffers (mod k 6))])
                  (case (mod k 8)
                    [(0 1 2) (modes:set-major-mode (list-ref modes (mod k 4)) b)]
                    [(3) (modes:run-mode-hooks b)]
                    [(4) (in-frame (lambda () (keys:active-keymaps client)))]
                    [(5) (buffers:with-buffer b (set-option-local! fill:mode (even? k)))]
                    [(6) (modes:active-minor-modes (view))]
                    [else (press! "C-f")]))
                (set! rounds (+ rounds 1))
                (loop (+ k 1)))))))))
> (begin
    (fork-thread quitter)
    (stress (+ (real-time) 2000))
    (set! quitting #f)
    (let wait ()
      (guard (c [(quit-condition? c) (set! quits-caught (+ quits-caught 1)) (wait)])
        (let spin () (unless stopped (spin)))
        (let settle ([n 0]) (when (< n 100000) (settle (+ n 1))))))
    (list (> (+ reported quits-caught) 100) (> rounds 1000)))
(#t #t)
> (advice-remove! report count-reports)
> (for-all (lambda (b) (and (table-ref modes:hooks (modes:major-mode b)) #t)) buffers)
#t
> (for-each (lambda (b) (modes:set-major-mode python:mode b)) buffers)
> (map (lambda (b) (list (modes:major-mode b) (local editing:word-characters b) (local fill:mode b))) buffers)
((python:mode "_" #t) (python:mode "_" #t) (python:mode "_" #t) (python:mode "_" #t) (python:mode "_" #t) (python:mode "_" #t))
> (for-each (lambda (b) (modes:set-major-mode text:mode b)) buffers)
> (map (lambda (b) (list (modes:major-mode b) (local editing:word-characters b) (local fill:mode b))) buffers)
((text:mode "$%" #f) (text:mode "$%" #f) (text:mode "$%" #f) (text:mode "$%" #f) (text:mode "$%" #f) (text:mode "$%" #f))
> (buffers:with-buffer (car buffers) (set-option-local! fill:column 20))
> (modes:set-major-mode python:mode (car buffers))
> (eval-file (string-append library "/python.sls"))
> (list (local editing:word-characters (car buffers)) (local fill:column (car buffers)))
("_" 70)
> (know! python:keymap 'python:keymap)
> (active-keymaps)
(fill:keymap python:keymap prog:keymap layout:keymap keys:global)
