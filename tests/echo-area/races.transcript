; Reports raised on four threads at once, while the main thread shows
; messages, all reach the log once each, in the order each thread raised
; them. Chez's console-error-port is one value for every thread, so the
; core's writer is silenced beneath the plugin's advice rather than four
; threads writing standard error.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (quiet:silence! #t)
> (options:set! echo-area:log-max 16384)
> (define done 0)
> (define done-mutex (make-mutex))
> (define (raiser i)
    (lambda ()
      (do ([k 0 (+ k 1)]) ((= k 250))
        (report (condition (make-error) (make-message-condition (format "t~a-~a" i k)))))
      (with-mutex done-mutex (set! done (+ done 1)))))
> (begin
    (for-each (lambda (i) (fork-task (lambda (restore) ((raiser i))))) '(0 1 2 3))
    (let loop ()
      (unless (= done 4)
        (echo-area:message! "Working")
        (loop)))
    (echo-area:message! "end")
    (void))
> (define lines
    (let loop ([chars (string->list (messages))] [line '()] [acc '()])
      (cond
        [(null? chars) (reverse acc)]
        [(char=? (car chars) #\newline) (loop (cdr chars) '() (cons (list->string (reverse line)) acc))]
        [else (loop (cdr chars) (cons (car chars) line) acc)])))
> (map (lambda (i)
         (let ([prefix (format "t~a-" i)])
           (equal? (filter (lambda (l) (and (>= (string-length l) 3) (string=? (substring l 0 3) prefix))) lines)
                   (map (lambda (k) (format "t~a-~a" i k)) (iota 250)))))
       '(0 1 2 3))
(#t #t #t #t)
> (list (car (last-pair lines)) (echo-area:current-message))
("end" "end")
; Quits requested every millisecond land in messages, the flush of
; reports, clearing by keys and the log's trimming. Afterwards both
; buffers are well formed, and a message shows and is logged as before.
> (options:set! echo-area:log-max 50)
> (define quitting #t)
> (define stopped #f)
> (define (quitter)
    (let loop ()
      (if quitting
          (begin
            (testing:request-quit!)
            (chez:sleep (make-time 'time-duration 1000000 0))
            (loop))
          (set! stopped #t))))
> (define rounds 0)
> (define quits-caught 0)
> (define forked #f)
; A quit lands up to a thousand calls after its request, and the
; quitter's last request may come after the stress ends. One guard
; holds from before the quitter starts until long after it stops,
; since a quit landing between two guards would end the form. Quits
; land at least a thousand calls apart, so none lands in the handler
; before it enters the guard again.
> (define (stress until)
    (let again ()
      (guard (c [(cancelled? c) (set! quits-caught (+ quits-caught 1)) (again)])
        (unless forked
          (set! forked #t)
          (fork-task (lambda (restore) (quitter))))
        (let loop ([k 0])
          (when (< (real-time) until)
            (case (mod k 5)
              [(0) (echo-area:message! "line ~a~%of two" (mod k 7))]
              [(1) (report (condition (make-warning) (make-message-condition "w")))]
              [(2) (press! "C-a")]
              [(3) (echo-area:current-message)]
              [else (echo-area:message! "same")])
            (set! rounds (+ rounds 1))
            (loop (+ k 1))))
        (set! quitting #f)
        (let spin () (unless stopped (spin)))
        (let settle ([n 0]) (when (< n 100000) (settle (+ n 1)))))))
> (begin
    (stress (+ (real-time) 2000))
    (list (> quits-caught 100) (> rounds 1000)))
(#t #t)
> (unload-owner! (module-owner '(quiet)))
> (define (shape b)
    (let ([d (car (document:datums (buffers:document b)))])
      (list (car d) (length (cddr d)))))
> (list (shape echo-buffer) (shape (buffers:find "*Messages*")))
((echo-area:area 1) (echo-area:%log 1))
> (let ([log (messages)]) (char=? (string-ref log (- (string-length log) 1)) #\newline))
#t
> (echo-area:message! "Last")
> (echo-area:message! "Last")
> (length (filter (lambda (c) (char=? c #\newline)) (string->list (messages))))
50
> (list (echo-area:current-message) (let* ([log (messages)] [n (string-length log)]) (substring log (- n 16) n)))
("Last" "\nLast [2 times]\n")
> (press! "C-a")
> (echo-area:current-message)
#f
