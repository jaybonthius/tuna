(import (tuna) (test) (test-runner) (hooks) (pi) (test-pi) (pi-test))

(define chat (pi-test:started (getenv "HOME")))

(define f (pi-test:fake chat))

(define (ref object key) (let ([pair (assoc key object)]) (and pair (cdr pair))))

(define (wait-for-items n) (test-runner:wait-until (lambda () (= n (length (pi:chat-transcript chat))))))

(define (wait-for-saved n) (test-runner:wait-until (lambda () (= n (length (pi-test:saved-items chat))))))

(define (settle!) (test-pi:say! f (test-pi:event "agent_settled" '("aborted" . #f))))

(test "a reply shows while Pi writes it, keyed by its place on the branch, with no entry id yet"
  (pi-test:activities!)
  (test-pi:say! f (test-pi:event "agent_start")
                (test-pi:event "message_start" (cons "message" (test-pi:user-message "Hi")))
                (test-pi:event "message_end" (cons "message" (test-pi:user-message "Hi")))
                (test-pi:event "message_start" (cons "message" (test-pi:assistant-message "pending")))
                (test-pi:update '(("type" . "text_start") ("contentIndex" . 0)))
                (test-pi:update '(("type" . "text_delta") ("contentIndex" . 0) ("delta" . "Hel"))))
  (wait-for-items 2)
  (check-equal? '((user 0 #f "Hi") (reply 1 #f pending ((text "Hel")))) (pi-test:transcript chat))
  (check-equal? '(thinking replying) (pi-test:activities!)))

(test "Pi's output is split into records on LF only, so U+2028 may stand inside a string"
  (test-pi:say! f (test-pi:update '(("type" . "text_delta") ("contentIndex" . 0) ("delta" . "lo\x2028;**there**"))))
  (pi-test:barrier f)
  (check-equal? '(reply 1 #f pending ((text "Hello\x2028;**there**"))) (cadr (pi-test:transcript chat)))
  (test-pi:say! f (test-pi:update '(("type" . "text_end") ("contentIndex" . 0) ("content" . "Hello **there**"))))
  (pi-test:barrier f)
  (check-equal? '(reply 1 #f pending ((text "Hello **there**"))) (cadr (pi-test:transcript chat))))

(test "a reply ending is not idle; once Pi settles pi reads the entries, and each item keeps its key and gains its entry id"
  (test-pi:append-entry! f (test-pi:entry "s1" #f '(("role" . "system") ("content" . "") ("timestamp" . 0))))
  (test-pi:append-entry! f (test-pi:entry "u1" "s1" (test-pi:user-message "Hi")))
  (test-pi:append-entry! f '(("type" . "model_change") ("id" . "m1") ("parentId" . "u1") ("provider" . "fake") ("modelId" . "x")))
  (test-pi:append-entry! f (test-pi:entry "a1" "m1" (test-pi:assistant-message "stop" (test-pi:text-block "Hello **there**"))))
  (test-pi:say! f (test-pi:event "message_end" (cons "message" (test-pi:assistant-message "stop" (test-pi:text-block "Hello **there**"))))
                (test-pi:event "agent_end"))
  (pi-test:barrier f)
  (check-equal? 'replying (pi:chat-activity chat))
  (settle!)
  (wait-for-saved 2)
  (check-equal? '((user 0 "u1" "Hi") (reply 1 "a1" stop ((text "Hello **there**")))) (pi-test:transcript chat))
  (let ([reply (cadr (pi:chat-transcript chat))])
    (check-equal? '(idle "fake-model" #f) (list (pi:chat-activity chat) (pi:reply-model reply) (pi:reply-error reply)))))

(test "a message of yours counts the images it carries"
  (let ([with-image '(("role" . "user") ("timestamp" . 1)
                      ("content" . #((("type" . "text") ("text" . "Look")) (("type" . "image") ("data" . "") ("mimeType" . "image/png")))))])
    (test-pi:say! f (test-pi:event "message_start" (cons "message" with-image)) (test-pi:event "message_end" (cons "message" with-image)))
    (wait-for-items 3)
    (let ([m (list-ref (pi:chat-transcript chat) 2)])
      (check-equal? '("Look" 1) (list (pi:user-message-text m) (pi:user-message-images m))))))

(test "after a settle pi reads only the entries since the last it saw"
  (pi-test:activities!)
  (test-pi:run-turn! f "u2" "a2" "Again" '("Once " "more"))
  (wait-for-saved 4)
  (check-equal? '(#f #f "a1")
    (map (lambda (r) (ref r "since"))
         (filter (lambda (r) (equal? (ref r "type") "get_entries")) (test-pi:requests f))))
  (check-equal? '((user 2 "u2" "Again") (reply 3 "a2" stop ((text "Once more")))) (list-tail (pi-test:transcript chat) 2))
  (check-equal? '(thinking replying idle) (pi-test:activities!)))

(define (call-of n) (cadr (pi:reply-parts (list-ref (pi:chat-transcript chat) n))))

(test "a tool call is called, then running with its output so far, then done with how long it took; its arguments are kept from the start of its run"
  (test-pi:say! f (test-pi:event "agent_start")
                (test-pi:event "message_start" (cons "message" (test-pi:assistant-message "pending")))
                (test-pi:update '(("type" . "thinking_start") ("contentIndex" . 0)))
                (test-pi:update '(("type" . "thinking_delta") ("contentIndex" . 0) ("delta" . "Let me look")))
                (test-pi:update '(("type" . "toolcall_start") ("contentIndex" . 1) ("id" . "t1") ("toolName" . "bash"))))
  (wait-for-items 5)
  (check-equal? '(reply 4 #f pending ((thinking "Let me look") (tool "bash" called ""))) (list-ref (pi-test:transcript chat) 4))
  (check-equal? '(thinking replying) (pi-test:activities!))
  (let ([call (test-pi:tool-block "t1" "bash" '(("command" . "ls")))])
    (test-pi:append-entry! f (test-pi:entry "a3" "a2" (test-pi:assistant-message "toolUse" (test-pi:thinking-block "Let me look") call)))
    (test-pi:say! f (test-pi:update `(("type" . "toolcall_end") ("contentIndex" . 1) ("toolCall" . ,call)))
                  (test-pi:event "message_end"
                    (cons "message" (test-pi:assistant-message "toolUse" (test-pi:thinking-block "Let me look") call)))
                  (test-pi:event "tool_execution_start" '("toolCallId" . "t1") '("toolName" . "bash") '("args" . (("command" . "ls"))))
                  (test-pi:event "tool_execution_update" '("toolCallId" . "t1") '("toolName" . "bash")
                    '("partialResult" . (("content" . #((("type" . "text") ("text" . "a.txt\n")))))))))
  (test-runner:wait-until (lambda () (eq? (pi:chat-activity chat) 'running)))
  (check-equal? '(reply 4 #f tool-use ((thinking "Let me look") (tool "bash" running "a.txt\n"))) (list-ref (pi-test:transcript chat) 4))
  (check-equal? '("t1" (("command" . "ls")) #f)
    (list (pi:tool-call-id (call-of 4)) (pi:tool-call-arguments (call-of 4)) (pi:tool-call-duration (call-of 4))))
  (test-pi:say! f (test-pi:event "tool_execution_end" '("toolCallId" . "t1") '("toolName" . "bash") '("isError" . #f) '("durationMs" . 1500)
                    '("result" . (("content" . #((("type" . "text") ("text" . "a.txt\nb.txt\n"))
                                                 (("type" . "image") ("data" . "") ("mimeType" . "image/png"))))))))
  (test-runner:wait-until (lambda () (eq? (pi:chat-activity chat) 'thinking)))
  (check-equal? '(done "a.txt\nb.txt\n" 1 3/2)
    (list (pi:tool-call-state (call-of 4)) (pi:tool-call-output (call-of 4)) (pi:tool-call-images (call-of 4))
          (pi:tool-call-duration (call-of 4)))))

(test "a reply that failed keeps its stop reason and Pi's message"
  (let ([failed (append (test-pi:assistant-message "error" (test-pi:text-block "Partial")) '(("errorMessage" . "529 overloaded")))])
    (test-pi:append-entry! f (test-pi:entry "r1" "a3" (test-pi:tool-result "t1" "bash" "a.txt\nb.txt\n" #f)))
    (test-pi:append-entry! f (test-pi:entry "a4" "r1" failed))
    (test-pi:say! f (test-pi:event "message_start" (cons "message" (test-pi:assistant-message "pending")))
                  (test-pi:event "message_end" (cons "message" failed))))
  (wait-for-items 6)
  (let ([r (list-ref (pi:chat-transcript chat) 5)])
    (check-equal? '(error "529 overloaded") (list (pi:reply-stop r) (pi:reply-error r)))))

(test "Pi's failures that are not replies become notices: a failed compaction or retry, an extension's failure or notify"
  (pi-test:activities!)
  (test-pi:say! f (test-pi:event "compaction_start" '("reason" . "threshold")))
  (test-runner:wait-until (lambda () (eq? (pi:chat-activity chat) 'compacting)))
  (test-pi:say! f (test-pi:event "compaction_end" '("reason" . "threshold") '("aborted" . #f) '("willRetry" . #f) '("errorMessage" . "too long"))
                (test-pi:event "auto_retry_start" '("attempt" . 1) '("maxAttempts" . 3) '("delayMs" . 10) '("errorMessage" . "overloaded")))
  (test-runner:wait-until (lambda () (eq? (pi:chat-activity chat) 'retrying)))
  (test-pi:say! f (test-pi:event "auto_retry_end" '("success" . #f) '("attempt" . 3) '("finalError" . "still overloaded"))
                (test-pi:event "extension_error" '("extensionPath" . "/x/guard.ts") '("event" . "tool_call") '("error" . "boom"))
                (test-pi:ui-request "n1" "notify" '("message" . "Blocked rm") '("notifyType" . "warning")))
  (test-runner:wait-until (lambda () (= 4 (length (filter pi:notice? (pi:chat-transcript chat))))))
  (let ([notices (filter pi:notice? (pi:chat-transcript chat))])
    (check-equal? '((notice error "Compaction failed: too long") (notice error "Retrying failed: still overloaded")
                    (notice error "Extension /x/guard.ts: boom") (notice warning "Blocked rm"))
                  (map pi-test:describe notices))
    (check-equal? '((6 . 0) (6 . 1) (6 . 2) (6 . 3)) (map pi:item-key notices))
    (check-equal? '(#f #f #f #f) (map pi:item-entry-id notices)))
  (check-equal? '(compacting thinking retrying thinking) (pi-test:activities!)))

(test "once the run settles, the entries hold its messages, tool results complete their calls, and notices stay after what they followed"
  (settle!)
  (wait-for-saved 6)
  (check-equal? '((reply 4 "a3" tool-use ((thinking "Let me look") (tool "bash" done "a.txt\nb.txt\n")))
                  (reply 5 "a4" error ((text "Partial")))
                  (notice error "Compaction failed: too long") (notice error "Retrying failed: still overloaded")
                  (notice error "Extension /x/guard.ts: boom") (notice warning "Blocked rm"))
                (list-tail (pi-test:transcript chat) 4))
  (check-equal? 3/2 (pi:tool-call-duration (call-of 4))))

(test "an extension's message shows when it says so, as do Pi's summaries and a command run with !; an appended entry is read at once"
  (test-pi:append-entry! f '(("type" . "custom_message") ("id" . "c1") ("parentId" . "a4") ("customType" . "subagent-notify")
                              ("content" . "Run **done**") ("display" . #t)))
  (test-pi:append-entry! f '(("type" . "custom_message") ("id" . "c2") ("parentId" . "c1") ("customType" . "hidden")
                              ("content" . "x") ("display" . #f)))
  (test-pi:append-entry! f '(("type" . "compaction") ("id" . "k1") ("parentId" . "c2") ("summary" . "We read files.")
                              ("tokensBefore" . 150000) ("firstKeptEntryId" . "a4")))
  (test-pi:append-entry! f '(("type" . "branch_summary") ("id" . "b1") ("parentId" . "k1") ("fromId" . "a2") ("summary" . "Tried A.")))
  (test-pi:append-entry! f (test-pi:entry "x1" "b1" '(("role" . "bashExecution") ("command" . "make") ("output" . "ok\n") ("exitCode" . 2)
                                                       ("cancelled" . #f) ("truncated" . #f) ("timestamp" . 5))))
  (test-pi:say! f (test-pi:event "entry_appended" '("entry" . ())))
  (wait-for-saved 10)
  (let ([items (pi-test:saved-items chat)])
    (check-equal? '((extension "subagent-notify" "Run **done**") (summary compaction "We read files.") (summary branch "Tried A.")
                    (shell "make"))
                  (map pi-test:describe (list-tail items 6)))
    (check-equal? '(150000 #f "ok\n" 2)
      (list (pi:summary-tokens-before (list-ref items 7)) (pi:summary-tokens-before (list-ref items 8))
            (pi:shell-command-output (list-ref items 9)) (pi:shell-command-exit (list-ref items 9))))))

(test "the session's name and thinking level are as Pi announces them, and each change calls pi:chat-changed"
  (let* ([changes 0] [count (lambda (c) (when (eq? c chat) (set! changes (+ changes 1))))])
    (hooks:add! pi:chat-changed count)
    (test-pi:say! f (test-pi:event "session_info_changed" '("name" . "Refactor"))
                  (test-pi:event "thinking_level_changed" '("level" . "high")))
    (test-runner:wait-until (lambda () (equal? "high" (pi:chat-thinking-level chat))))
    (hooks:remove! pi:chat-changed count)
    (check-equal? '("Refactor" "high") (list (pi:chat-session-name chat) (pi:chat-thinking-level chat)))
    (check (>= changes 2))))

(test "when an extension moves Pi to another session, Pi refuses the old cursor, and pi reads the whole session and takes its id from Pi's state"
  (test-pi:clear-entries! f)
  (test-pi:set-state! f '(("sessionId" . "other-session")))
  (test-pi:append-entry! f (test-pi:entry "n1" #f (test-pi:user-message "Elsewhere")))
  (settle!)
  (test-runner:wait-until (lambda () (equal? (pi-test:transcript chat) '((user 0 "n1" "Elsewhere")))))
  (check-equal? "other-session" (pi:chat-session-id chat)))
