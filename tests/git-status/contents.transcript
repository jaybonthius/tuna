; with a push-remote whose branch differs from the upstream, both
; sides' commits not pushed and not pulled show, in Magit's order.
> (sample-repository! "repo")
> (sh "git init -q --bare -b main fork.git && cd repo && git remote add fork ../fork.git && git push -q fork main~1:refs/heads/main && git config branch.main.pushRemote fork")
> (sh "git clone -q origin-repo.git o && cd o && echo o > o.txt && git add o.txt && git commit -qm 'Origin commit' && git push -q")
> (sh "git clone -q fork.git f && cd f && echo f > f.txt && git add f.txt && git commit -qm 'Fork commit' && git push -q")
> (sh "cd repo && git fetch -q origin && git fetch -q fork")
> (layout:switch-to-buffer (files:visit (at "repo/a.py")))
> (press! "C-x" "g")
> (settle!)
> (status)
("Head:     main Second commit" "Merge:    origin/main Origin commit" "Push:     fork/main Fork commit" "Untracked files (1)…" "Unstaged changes (3)" "modified   a.py…" "modified   b.txt…" "deleted    gone.txt…" "Staged changes (1)" "modified   b.txt…" "Unpushed to fork/main (1)…" "Unmerged into origin/main (1)" "be72b3c main Second commit" "Unpulled from fork/main (1)…" "Unpulled from origin/main (1)…")
; the Merge line also shows commits to push and to pull, drawn after
; the summary, not text.
> (contains? (html (view)) "↑1")
#t
> (contains? (html (view)) "↓1")
#t
> (contains? (document:text (buffers:document (status-buffer))) "↑")
#f
; the commit sections not pushed to the push branch and not pulled
; start hidden; Unmerged into shows.
> (press! "M-1")
> (status)
("Head:     main Second commit…" "Untracked files (1)…" "Unstaged changes (3)…" "Staged changes (1)…" "Unpushed to fork/main (1)…" "Unmerged into origin/main (1)…" "Unpulled from fork/main (1)…" "Unpulled from origin/main (1)…")
; a file row is its status word padded to 11 characters, then the
; path: modified, new file, deleted, renamed and unmerged.
> (sample-repository! "rows")
> (sh "cd rows && git mv b.txt c.txt && git add new.txt && rm a.py")
> (git-status:show (git:find-repository (at "rows")))
> (status)
("Head:     main Second commit" "Merge:    origin/main First commit" "Unstaged changes (3)" "deleted    a.py…" "modified   c.txt…" "deleted    gone.txt…" "Staged changes (2)" "renamed    b.txt -> c.txt…" "new file   new.txt…" "Unmerged into origin/main (1)" "be72b3c main Second commit")
; a tracked file replaced by a symbolic link shows as a deletion and
; an addition, and s on either stages the type change.
> (sh "cd rows && git reset -q && git checkout -q -- . && rm -f new.txt && ln -sf gone.txt.target swap && echo x > swap.txt && git add swap.txt && git commit -qm swap && rm swap.txt && ln -s a.py swap.txt")
> (git-mode:refresh-repository (git:find-repository (at "rows")))
> (status)
("Head:     main swap" "Merge:    origin/main First commit" "Untracked files (2)…" "Unstaged changes (2)" "deleted    swap.txt…" "new file   swap.txt…" "Unmerged into origin/main (2)" "e37267c main swap" "be72b3c Second commit")
> (go-to! "new file   swap.txt")
> (press! "s")
> (settle!)
> (git-out "rows" "status" "--short" "swap.txt")
"T  swap.txt\n"
; while the last command of the repository failed, the first line
; is the error header, until a command succeeds.
> (sh "cd rows && git remote remove origin")
> (answer! "nowhere")
> (press! "f" "e")
> (settle!)
> (take-said!)
("Git error: Could not read from remote repository. [Type $ for details]")
> (status)
("GitError! Could not read from remote repository.  [Type $ for details]" "Head:     main swap" "Untracked files (2)…" "Staged changes (2)" "deleted    swap.txt…" "new file   swap.txt…" "Recent commits…")
> (sh "cd rows && git tag v1")
> (answer! #t)
> (press! "S")
> (settle!)
> (status)
("Head:     main swap" "Tag:      v1" "Untracked files (2)…" "Staged changes (2)" "deleted    swap.txt…" "new file   swap.txt…" "Recent commits…")
; the Tag line names the nearest tag and the commits since it.
> (sh "cd rows && git commit -qm after")
> (git-mode:refresh-repository (git:find-repository (at "rows")))
> (car (status))
"Head:     main after"
> (cadr (status))
"Tag:      v1 (1)"
