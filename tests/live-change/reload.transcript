; loaded again, its changes with it.
> (set! loads '())
> (put-version! "spell-raises.sls" ".local/share/tuna/plugins/spell/spell.sls")
> (eval-file "~/.local/share/tuna/plugins/spell/spell.sls")
speller unloading
