; Forward, the first match at or after the place; backward, the last
; that ends at or before it, reading as if the text ended there.
> (define b (text-buffer "f" "one two three two one\n"))
> (define two (search:make-query "two"))
> (list (find-in b two 0 forward) (find-in b two 6 forward) (find-in b two 9 forward))
((5 8 "two") (15 18 "two") (15 18 "two"))
> (list (find-in b two 23 backward) (find-in b two 17 backward) (find-in b two 4 backward))
((15 18 "two") (5 8 "two") #f)
> (define aaa (text-buffer "aaa" "aaa\n"))
> (find-in aaa (search:make-query "aa") 4 backward)
(2 4 "aa")
; From inside one of a forward chain's matches a find gives the match
; that starts there, which overlaps it.
> (define aaaa (text-buffer "aaaa" "aaaa\n"))
> (define aa (search:make-query "aa"))
> (find-in aaaa aa 2 forward)
(2 4 "aa")
> (define s (scanned aaaa aa))
> (scan-spans aaaa s)
((1 3 "aa") (3 5 "aa"))
> (find-in aaaa aa 2 forward)
(2 4 "aa")
; Backward, a lookahead at the place reads the text after it.
> (find-in b (search:make-query "o(?= t)" search:regexp) 23 backward)
(7 8 "o")
> (find-in b (search:make-query "e\\b" search:regexp) 13 backward)
(3 4 "e")
; A match runs across a node's edge as the text reads, and one touching
; an atom's text covers the atom.
> (buffers:define-kind page (content nodes))
> (buffers:define-kind para)
> (define (tag-text node) "TAG")
> (buffers:define-kind tag (content atom) (text tag-text))
> (define nodes (buffers:make "nodes" '(page () (para () "first line\n") (para () "second " #(tag ()) " end\n"))))
> (buffers:text-between (buffers:document nodes) 0 (end-of nodes))
"first line\nsecond TAG end\n"
> (map (lambda (m) (list (search:match-start m) (search:match-end m)))
       (list (search:find nodes (search:make-query "line\\nsecond" search:regexp) 0 forward)
             (search:find nodes (search:make-query "TAG") 0 forward)
             (search:find nodes (search:make-query "AG end") 0 forward)
             (search:find nodes (search:make-query "nd T") 0 forward)))
((8 21) (22 23) (22 27) (19 23))
; A narrowing is seen text: ^ matches at its start mid-line, in a find
; and a scan alike. A range seen from before its start is not.
> (define n (text-buffer "n" "xfoo foo\nfoo\n"))
> (define caret (search:make-query "^foo" search:regexp))
> (find-in n caret 2 forward 2 9)
(2 5 "foo")
> (scan-spans n (scanned n caret 2 9))
((2 5 "foo"))
> (find-in n caret 2 forward 2 9 1 14)
#f
> (scan-spans n (scanned n caret 2 9 1 14))
()
> (find-in n (search:make-query "(?<=x)foo" search:regexp) 2 forward 2 9)
#f
> (find-in n (search:make-query "(?<=x)foo" search:regexp) 2 forward 2 9 1 14)
(2 5 "foo")
; A match never runs past the range's end: a greedy one is cut there, an
; assertion at the end reads the text after it, up to the seen text's
; end.
> (find-in aaaa (search:make-query "a+" search:regexp) 1 forward 1 3 1 6)
(1 3 "aa")
> (define fb (text-buffer "fb" "foobar foo\nfoo bar\n"))
> (define (cut text end) (find-in fb (search:make-query text search:regexp) 1 forward 1 end 1 (end-of fb)))
> (list (cut "\\bfoo\\b" 4) (cut "foo$" 4) (cut "foo\\z" 4) (cut "foo\\Z" 4) (cut "foo(?=bar)" 4))
(#f #f #f #f (1 4 "foo"))
> (list (cut "foo$" 11) (cut "\\bfoo\\b" 15) (cut "foo(?= )" 15) (cut "foo\\b" 15))
((8 11 "foo") (8 11 "foo") (12 15 "foo") (8 11 "foo"))
> (find-in fb (search:make-query "foo" search:word) 1 forward 1 4 1 (end-of fb))
#f
; The one difference from Emacs, each way: a greedy match that crosses
; the end and asserts there is judged on the text cut at the end.
> (cut "\\w+\\b" 4)
(1 4 "foo")
> (define fz (text-buffer "fz" "fooz\n"))
> (find-in fz (search:make-query "fo+\\B" search:regexp) 1 forward 1 3 1 (end-of fz))
#f
; Backward, an assertion at the place reads the text after it.
> (find-in fb (search:make-query "foo\\b" search:regexp) 4 backward)
#f
> (find-in fb (search:make-query "foo\\z" search:regexp) 4 backward)
#f
> (find-in fb (search:make-query "foo\\b" search:regexp) 11 backward)
(8 11 "foo")
; A match that reaches a piece's edge is read again with the next piece,
; and ^, \b and a lookbehind at a piece's start see the text before it:
; finds and a scan agree on a text of many pieces.
> (define big (text-buffer "big" (apply string-append (map (lambda (k) (format "w~a x-y z ~a\n" k (if (= 0 (mod k 997)) "needle" ""))) (iota 9000)))))
> (> (end-of big) 70000)
#t
> (define (same-as-scan text)
    (let* ([q (search:make-query text search:regexp)] [found (all-in big q)])
      (list (length found) (equal? found (scan-spans big (scanned big q))))))
> (map same-as-scan '("needle" "^w\\d+3 " "\\bx-y\\b" "(?<=-)y" "z needle\\n"))
((10 #t) (899 #t) (9000 #t) (9000 #t) (10 #t))
; A quit between pieces stops a long find.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define slow (text-buffer "slow" (make-string 20000000 #\x)))
> (import (testing))
> (define (quit-soon) (fork-task (lambda (restore) (chez:sleep (make-time 'time-duration 20000000 0)) (testing:request-quit!))))
> (guard (c [(cancelled? c) 'quit])
    (quit-soon)
    (search:find slow (search:make-query "\\b\\w+-\\w+\\b" search:regexp) 0 forward))
quit
