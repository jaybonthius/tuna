(import (tuna) (test) (test-user) (commands) (views) (editing) (scene))

(test "C-t swaps the characters around point and moves past both; at a line's end, the two before it; at the start it raises"
  (test-user:show! "ab|cd")
  (test-user:press! "C-t")
  (check-equal? "acb|d" (test-user:text))
  (scene:show! "ab\ncd" 3)
  (test-user:press! "C-t")
  (check-equal? '("ba\ncd" ((3 #f))) (scene:state))
  (test-user:press! "C-f C-t")
  (check-equal? '("bac\nd" ((5 #f))) (scene:state))
  (test-user:show! "ab|")
  (test-user:press! "C-t")
  (check-equal? "ba|" (test-user:text))
  (check-equal? '((editing:transpose-chars "beginning of buffer")) (scene:press-reports! "M-< C-t")))

(test "M-t swaps the word around or before point with the next; with no next word it raises and leaves point"
  (scene:show! "one, two three" 4)
  (test-user:press! "M-t")
  (check-equal? '("two, one three" ((9 #f))) (scene:state))
  (test-user:press! "M-t")
  (check-equal? '("two, three one" ((15 #f))) (scene:state))
  (check-equal? '((editing:transpose-words "no two words to transpose")) (scene:press-reports! "M-t"))
  (check-equal? '("two, three one" ((15 #f))) (scene:state)))

(test "C-x C-t swaps the line with the one before and moves to the next; on the first line, with the second; it adds no final line break"
  (scene:show! "one\ntwo\nthree" 6)
  (test-user:press! "C-x C-t")
  (check-equal? '("two\none\nthree" ((9 #f))) (scene:state))
  (test-user:press! "C-x C-t")
  (check-equal? '("two\nthree\none" ((14 #f))) (scene:state))
  (test-user:press! "M-< C-x C-t")
  (check-equal? '("three\ntwo\none" ((11 #f))) (scene:state))
  (test-user:show! "o|ne\ntwo")
  (test-user:press! "C-x C-t")
  (check-equal? "two\none|" (test-user:text))
  (scene:show! "one" 2)
  (check-equal? '((editing:transpose-lines "no two lines to transpose")) (scene:press-reports! "C-x C-t")))

(test "M-u, M-c and M-l change a word's case with full Unicode mappings and move past it; a negative count leaves point"
  (scene:show! "hello wORLD, élan" 1)
  (test-user:press! "M-u")
  (check-equal? '("HELLO wORLD, élan" ((6 #f))) (scene:state))
  (test-user:press! "M-c")
  (check-equal? '("HELLO World, élan" ((12 #f))) (scene:state))
  (test-user:press! "M-c")
  (check-equal? '("HELLO World, Élan" ((18 #f))) (scene:state))
  (test-user:press! "C-a M-l")
  (check-equal? '("hello World, Élan" ((6 #f))) (scene:state))
  (views:set-point! (scene:view) 3)
  (test-user:press! "M-c")
  (check-equal? '("heLlo World, Élan" ((6 #f))) (scene:state))
  (test-user:press! "M-- M-u")
  (check-equal? '("HELLO World, Élan" ((6 #f))) (scene:state))
  (scene:show! "straße weiß" 1)
  (test-user:press! "M-2 M-u")
  (check-equal? '("STRASSE WEISS" ((14 #f))) (scene:state)))

(test "C-x C-u and C-x C-l convert the region, and raise without one"
  (scene:show! "Hello Straße" 7)
  (test-user:press! "C-SPC C-e C-x C-u")
  (check-equal? '("Hello STRASSE" ((14 #f))) (scene:state))
  (test-user:press! "C-SPC C-a C-x C-l")
  (check-equal? '("hello strasse" ((1 #f))) (scene:state))
  (check-equal? '((editing:upcase-region "the mark is not set, so there is no region")) (scene:press-reports! "C-x C-u"))
  (scene:take-said!))

(test "capitalize-region gives each word of the region a capital first letter"
  (scene:show! "hello wORLD élan" 1)
  (views:set-mark! (scene:view) 17)
  (scene:run editing:capitalize-region)
  (check-equal? '("Hello World Élan" ((1 #f))) (scene:state)))

(test "case and transposing commands act at each cursor, and cursors they bring together merge"
  (scene:show! "ab cd" 1 3)
  (test-user:press! "M-u")
  (check-equal? '("AB CD" ((3 #f))) (scene:state))
  (scene:show! "abcd" 2 3)
  (test-user:press! "C-t")
  (check-equal? '("bcad" ((2 #f))) (scene:state))
  (scene:show! "a\nb\nc\nd" 3 5)
  (test-user:press! "C-x C-t")
  (check-equal? '("b\nc\na\nd" ((5 #f))) (scene:state))
  (scene:show! "abcd" 2 3)
  (views:set-cursor! (car (views:cursors (scene:view))) 2 1)
  (views:set-cursor! (cadr (views:cursors (scene:view))) 3 2)
  (test-user:press! "C-x C-u")
  (check-equal? '("ABcd" ((2 #f) (3 #f))) (scene:state)))
