; A source's exit procedure runs once, when a session at point ends with
; one of its candidates, after the text is in place: with the candidate's
; value and finished, for RET and when the input becomes the one match
; left.
; A region of two sources runs the exit of the source that made the
; candidate.
> (define b (buffers:make "exit" ""))
> (views:set-buffer! (view) b)
> (define exits '())
> (define (exit-noting name)
    (lambda (value status)
      (set! exits (cons (list name value status (text b)) exits))))
> (define (word-start)
    (let* ([v (views:current)] [buffer (views:buffer v)] [p (views:point v)]
           [s (editing:forward-word-position buffer p -1)])
      (and (< s p) (= (editing:forward-word-position buffer s 1) p) s)))
> (define (fruit)
    (let ([s (word-start)])
      (and s (completion:region s (views:point (views:current))
               (list (completion:source (candidates (vector (cons "apple" 'apple) (cons "applet" 'applet) (cons "apricot" 'apricot)))
                                        (exit (exit-noting 'fruit)))
                     (completion:source (candidates (vector (cons "avocado" 'avocado)))
                                        (exit (exit-noting 'vegetable))))))))
> (add-hook! completion:find-region fruit -1)
> (type! "a")
> (press! "C-M-i")
> (texts (session))
("apple" "applet" "apricot" "avocado")
> (press! "M-n" "M-n" "M-n" "M-n" "RET")
> exits
((vegetable avocado finished "avocado"))
> (set! exits '())
; Typing until one match is left, and its text is the input, ends the
; session with finished.
> (press! "SPC")
> (type! "apr")
> (press! "C-M-i")
> (texts (session))
("apricot")
> (type! "icot")
> (session)
#f
> exits
((fruit apricot finished "avocado apricot"))
> (set! exits '())
; A session calls one exit, as it ends. TAB that leaves the session going
; calls none, so RET on another match then gives only that one's.
> (press! "SPC")
> (type! "appl")
> (press! "C-M-i")
> (press! "M-n" "TAB")
> exits
()
> (texts (session))
("apple" "applet")
> (press! "M-n" "M-n" "RET")
> (session)
#f
> exits
((fruit applet finished "avocado apricot applet"))
> (set! exits '())
; A session that ends any other way, while the region still holds the
; match TAB put in, gives exact: by SPC, or by C-g.
> (press! "SPC")
> (type! "appl")
> (press! "C-M-i")
> (press! "M-n" "TAB" "SPC")
> (session)
#f
> exits
((fruit apple exact "avocado apricot applet apple "))
> (set! exits '())
> (type! "appl")
> (press! "C-M-i")
> (press! "M-n" "TAB" "C-g")
> (session)
#f
> exits
((fruit apple exact "avocado apricot applet apple apple"))
> (set! exits '())
; Typing on after TAB changes the match's text, so no exit is called.
> (press! "SPC")
> (type! "appl")
> (press! "C-M-i")
> (press! "M-n" "TAB")
> (type! "x")
> (press! "C-g")
> (session)
#f
> exits
()
; TAB on the one match left ends the session with finished.
> (press! "SPC")
> (type! "appl")
> (press! "C-M-i")
> (press! "M-n" "M-n" "TAB")
> (session)
#f
> exits
((fruit applet finished "avocado apricot applet apple apple applex applet"))
> (set! exits '())
; A session that ends with no candidate runs no exit; nor does a read.
> (press! "SPC")
> (type! "ap")
> (press! "C-M-i")
> (press! "C-g")
> exits
()
> (define t (start! (lambda () (completion:read "Fruit: " (list (completion:source (candidates (vector "apple")) (exit (exit-noting 'read))))))))
> (press! "RET")
> (result t)
"apple"
> exits
()
> (raised (lambda () (completion:source (candidates (vector "apple")) (exit 'done))))
(completion:source "not a procedure")
