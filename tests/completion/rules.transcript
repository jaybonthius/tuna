1
; RET with nothing selected chooses the candidate whose text is the
; input, among more than are matched on the main thread.
> (define (many emit)
    (lambda (prefix)
      (unless (eof-object? prefix)
        (emit (list->vector (map (lambda (i) (cons (format "item ~a" i) i)) (iota 5000))))
        (emit 'done))))
> (define t (start! (lambda () (completion:read "? " (list (completion:source (stream many))) h))))
> (begin (type! "item 4321") (press! "RET"))
> (result t)
4321
; RET with nothing selected is answered when the stream says done before
; its match job looks: the session then matches on the main thread, and
; the job, stopped, answers nothing. The job here waits after taking each
; message, so it is always too late.
> (jobs:define-worker (slow-match input emit receive)
    (import (completion matcher))
    (serve emit (case-lambda [() (let ([m (receive)]) (sleep (make-time 'time-duration 200000000 0)) m)] [(s) (receive s)])))
