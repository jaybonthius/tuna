; A copy of a plugin that Tuna's own library holds goes when the
; configuration's line for it has no source and no index names it.
! use-plugin: removed $HOME/.local/share/tuna/plugins/files: its line finds the plugin among Tuna's own plugins
> (files:who)
"bundled"
> (plugins:installed)
(other sources compat consult)
; File times are coarse: a file written in the tick its object was
; compiled in would not look newer, so each write waits a little first.
> (define (write-mine! text)
    (timers:sleep 0.02)
    (call-with-output-file "~/.config/tuna/lib/mine.sls"
      (lambda (p) (put-string p text))
      'replace))
> (import (plugins))
; Chez keeps the library of a removed plugin, and reloading another module
; looks up the source of every library Chez has; that does not raise.
> (plugins:remove! 'other)
> (write-mine! "#!tuna\n(define (text) \"two\")\n")
> (reload-modules! '((mine)))
> (mine:text)
"two"
> (plugins:remove! 'consult)
> (plugins:installed)
(sources compat)
> (write-mine! "#!tuna\n(define (text) \"three\")\n")
> (reload-modules! '((mine)))
> (list (mine:text) (plugins:installed))
("three" (sources compat))
; A line typed at the REPL installs a removed plugin again.
> (use-plugin other (local "~/src/other"))
> (other:name)
"other"
; A module that comes to import another plugin needs that plugin's line,
; whose source an index may give.
> (use-plugin embark)
> (write-mine! "#!tuna\n(import (embark))\n(define (text) (embark:act))\n")
> (reload-modules! '((mine)))
> (list (mine:text) (plugins:installed))
("embark act" (sources compat embark other))
; A line evaluated as part of the configuration is a configuration line.
> (call-as-owner (plugins:configuration-owner)
    (lambda () (plugins:eval-form '(use-plugin vertico (git "https://github.com/minad/vertico")))))
> (vertico:count)
10
> (plugins:installed)
(sources compat vertico embark other)
; An id names a folder, so a path is not an id.
> (plugins:remove! '|.|)
! remove-plugin!: not a plugin id with irritant \x2E;
> (plugins:remove! '..)
! remove-plugin!: not a plugin id with irritant \x2E;.
> (plugins:update! '..)
! update-plugin!: not a plugin id with irritant \x2E;.
> (plugins:commit '|a/b|)
! plugin-commit: not a plugin id with irritant a/b
> (plugins:install! '(use-plugin |.| (local "~/src/other")))
! install-plugin!: not a use-plugin line with irritant (use-plugin \x2E; (local "~/src/other"))
> (sort string<? (directory-list "~/.local/share/tuna"))
("plugins")
