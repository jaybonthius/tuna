; wrap-lines decides how the view lays out long lines, by the class
; nowrap when they do not wrap; a view's own value wins.
> (define w (views:make b))
> (and (search (html->string (views:draw w #f)) "class=\"view nowrap\"" 0) #t)
#t
> (views:set-option! w views:wrap-lines #t)
> (and (search (html->string (views:draw w #f)) "class=\"view\"" 0) #t)
#t
