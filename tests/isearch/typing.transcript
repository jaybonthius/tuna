; Each character searches again from the current match's start; C-s
; goes to the next match; DEL goes back one state.
> (define b (show "t" "one two three two one\n"))
> (press! "C-s")
> (here)
(1 "I-search: " #f)
> (type! "tw")
> (here)
(7 "I-search: tw" "tw")
> (type! "o")
> (here)
(8 "I-search: two" "two")
> (press! "C-s")
> (here)
(18 "I-search: two" "two")
; Past the last match the search fails, and the next C-s wraps, as
; isearch:wrap's pause does; a match past the origin again is
; overwrapped.
> (press! "C-s")
> (here)
(18 "Failing I-search: two" "two")
> (press! "C-s")
> (here)
(8 "Overwrapped I-search: two" "two")
> (press! "DEL")
> (here)
(18 "Failing I-search: two" "two")
> (press! "DEL" "DEL")
> (here)
(8 "I-search: two" "two")
> (press! "RET")
> (here)
(8 #f #f)
; A count repeats a search key, and a negative count turns it back.
> (views:set-point! (view) 1)
> (press! "C-s" "o" "n" "e")
> (here)
(4 "I-search: one" "one")
> (press! "C-u" "2" "C-s")
> (here)
(22 "Failing I-search: one" "one")
> (press! "M-3" "C-s")
> (here)
(22 "Failing overwrapped I-search: one" "one")
> (press! "M--" "C-s")
> (here)
(19 "Overwrapped I-search backward: one" "one")
> (press! "RET")
; C-u 3 before a character adds it three times.
> (define as (show "as" "a aa aaa aaaa\n"))
> (press! "C-s" "C-u" "3" "a")
> (here)
(9 "I-search: aaa" "aaa")
> (press! "RET")
; C-s with no text searches for the newest text of the history.
> (views:set-point! (view) 1)
> (press! "C-s" "C-s")
> (here)
(9 "I-search: aaa" "aaa")
> (press! "RET")
; C-r searches backward; turning around puts point at the other end of
; the match.
> (show "r" "one two three two one\n")
#<buffer r>
> (views:set-point! (view) 22)
> (press! "C-r" "t" "w")
> (here)
(15 "I-search backward: tw" "tw")
> (press! "C-r")
> (here)
(5 "I-search backward: tw" "tw")
> (press! "C-s")
> (here)
(7 "I-search: tw" "tw")
> (press! "RET")
; The prompt's strings are the program's words, and its pairs the text
; as typed: the part that matched with no face, the rest in isearch.fail.
; The count and an error are words.
> (views:set-point! (view) 1)
> (press! "C-s")
> (keys:prompt client)
("I-search: ")
> (type! "tw")
> (keys:prompt client)
("I-search: " (#f . "tw"))
> (type! "x")
> (keys:prompt client)
("Failing I-search: " (#f . "tw") (isearch.fail . "x"))
> (press! "RET")
> (set-option! isearch:lazy-count #t)
> (press! "C-s" "t" "w")
> (wait-scan)
> (keys:prompt client)
("2/2 I-search: " (#f . "tw"))
> (press! "RET")
> (set-option! isearch:lazy-count #f)
> (press! "C-M-s" "(" "t")
> (keys:prompt client)
("Failing regexp I-search: " (isearch.fail . "(t") " [incomplete input]")
> (press! "RET")
> (press! "C-s")
> (start! "C-q")
> (press! "C-j")
> (keys:prompt client)
("I-search: " (#f . "\n"))
> (press! "RET")
