> (define (show-lines)
    (call-with-input-file "~/.config/tuna/init.ss"
      (lambda (p)
        (let loop ()
          (let ([form (read p)])
            (unless (eof-object? form)
              (when (and (pair? form) (eq? (car form) 'use-plugin))
                (write form)
                (newline))
              (loop)))))))
; install-plugin! writes its line after the last line, with the full
; commit, keeping the rest of the file, and loads nothing.
> (install-plugin! '(use-plugin vertico (git "https://github.com/minad/vertico")))
> (display (call-with-input-file "~/.config/tuna/init.ss" get-string-all))
(import (tuna) (tuna plugins))
(use-plugin spell (git "https://github.com/bob/spell") (commit "8f4a734"))
(use-plugin files)
(use-plugin fill)
(use-plugin prog)

(set-option! spell:language "en-GB"
             fill:column 80
             files:autosave-seconds 30)

(set! spell:dictionary-path (lambda () "/home/groucho/words"))

(define (announce save! path)
  (display (string-append "saving " path))
  (save! path))
(advice-add! files:save! announce)

(remove-hook! files:after-save spell:check)

(add-hook! prog:mode-hook
  (lambda ()
    (set-option-local! fill:column 100)
    (add-local-hook! files:before-save prog:indent-buffer -10)))

(when-installed (vertico)
  (set-option! vertico:count 15))
(use-plugin sources (git "https://github.com/groucho/tuna-sources"))
(use-plugin compat)
(use-plugin consult)
(use-plugin embark)
(use-plugin embark-consult)
(use-plugin vertico (git "https://github.com/minad/vertico") (commit "5f76a5364d614d437df7fff40ce52ac7db52ae83"))
(import (console))
