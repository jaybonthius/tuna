; The matcher's library: patterns, order, spans, and the store a job keeps.
> (import (completion matcher))
; A store keeps its texts as UTF-8.
> (define (utf8s . texts) (list->vector (map string->utf8 texts)))
> (map pattern? '(((contains "a")) ((contains)) ((ends "a" "b")) ((not (starts "x"))) ((regexp "a")) x
                  ((face m (contains "a"))) ((face "m" (contains "a"))) ((face m))))
(#t #f #f #t #f #f #t #f #f)
> (define s (make-store (utf8s "find-file" "files:find-file" "fundamental" "Find" "f") (vector 0 0 0 0 0)))
> (store-matches s '((contains "f" "n" "d")))
#(3 0 2 1)
> (store-matches s '((contains "Fi")))
#(3)
> (store-matches (make-store (utf8s "ÉTÉ" "Été" "ete") (vector 0 0 0)) '((contains "été")))
#(0 1)
> (store-matches s '((ends "file") (not (starts "files"))))
#(0)
> (store-matches s '())
#(4 3 0 2 1)
> (pattern-spans '((contains "f" "n" "d") (contains "file")) "files:find-file")
((0 4 #f) (8 10 #f))
; A span carries its term's face. A later term's match is drawn over an
; earlier one's; matches of one face that touch join.
> (pattern-spans '((face a (contains "find")) (not (contains "x")) (face b (ends "file"))) "files:find-file")
((6 10 a) (11 15 b))
> (pattern-spans '((face a (contains "file")) (face b (contains "les:f"))) "files:find-file")
((0 2 a) (2 7 b))
> (pattern-spans '((face a (contains "fi")) (face a (contains "les"))) "files")
((0 5 a))
> ((pattern-matcher '((face a (contains "define")) (not (contains "x")))) "define-record")
#t
> ((pattern-matcher '((contains "define") (not (contains "x")))) "define-record")
#t
; Characters past ASCII: folded, matched at either end, and spans in
; characters.
> (define u (make-store (utf8s "naïve" "École" "ÉCOLE" "ecole") (vector 0 0 0 0)))
> (store-matches u '((starts "éc")))
#(2 1)
> (store-matches u '((starts "Éc")))
#(1)
> (store-matches u '((ends "ïve")))
#(0)
> (store-matches u '((contains "a" "v")))
#(0)
> (pattern-spans '((contains "ï") (ends "e")) "naïve")
((2 3 #f) (4 5 #f))
; Ranks sort first, then gaps, then length, then text; gaps and length
; count characters, so é counts one, as e does.
> (store-matches (make-store (utf8s "éa" "eaa" "eb") (vector 0 0 0)) '())
#(2 0 1)
> (store-matches (make-store (utf8s "axxxb" "aééb") (vector 0 0)) '((contains "a" "b")))
#(1 0)
> (store-matches (make-store (utf8s "bbb" "aaa" "cc" "b") (vector 1 1 0 1)) '())
#(2 3 1 0)
; A store sorted keeps new candidates in order; one in arrival order
; sorts when told. A cleared store holds nothing and numbers what comes
; after on from what it held, in arrival order until told to sort. A
; match from a number takes only the candidates numbered from it on.
> (define j (make-store))
> (store-add! j (utf8s "zeta" "alpha") #f)
> (store-matches j '())
#(0 1)
> (store-sort! j)
> (store-add! j (utf8s "beta") #f)
> (store-matches j '())
#(2 0 1)
> (store-clear! j)
> (store-matches j '())
#()
> (store-add! j (utf8s "be") #f)
> (store-add! j (utf8s "omega" "b") #f)
> (store-matches j '())
#(3 4 5)
> (store-matches j '((contains "b")) 4)
#(5)
> (store-sort! j)
> (store-matches j '())
#(5 3 4)
> (store-matches j '() 4)
#(5 4)
; Styles; dispatch characters; a backslash keeps a space.
> (completion:substring "fi")
((contains "fi"))
> (completion:any-order "a\\ b ~xyz =!x y$ !")
((face completion.match-0 (contains "a b")) (face completion.match-1 (contains "x" "y" "z")) (face completion.match-2 (contains "!x")) (face completion.match-3 (ends "y")))
; Components take the faces in turn, starting again after the last; a
; negated one takes none.
> (completion:any-order "a !b\\ c d e f g")
((face completion.match-0 (contains "a")) (not (contains "b c")) (face completion.match-1 (contains "d")) (face completion.match-2 (contains "e")) (face completion.match-3 (contains "f")) (face completion.match-0 (contains "g")))
> (with-options ([completion:any-order-faces (list completion:match-2)]) (completion:any-order "a b"))
((face completion.match-2 (contains "a")) (face completion.match-2 (contains "b")))
> (with-options ([completion:any-order-faces '()]) (completion:any-order "a b"))
((contains "a") (contains "b"))
> (completion:any-order "")
()
> (table-set! completion:any-order-dispatch #\, (lambda (rest) (list 'starts rest)))
> (completion:any-order ",ab")
((face completion.match-0 (starts "ab")))
> (table-remove! completion:any-order-dispatch #\,)
; Smart case per term: a capital in a term makes it exact.
> (define-saved h '() list?)
> (define (choose-from cands keys)
    (let ([t (start! (lambda () (completion:read "? " (list (completion:source (candidates cands))) h)))])
      (apply press! keys)
      (let ([r (texts (session))]) (press! "C-g") r)))
