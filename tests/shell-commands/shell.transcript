; M-! reads a line and runs it through runs:shell in files:directory:
; one line of output goes to the echo area and into *Shell Command
; Output*, more shows that buffer, none tells how the program ended.
> (start! "M-!")
> (type! "echo hi")
> (press! "RET")
> (settle)
> (list (message) (text (buffers:find "*Shell Command Output*")) (buffers:modified? (buffers:find "*Shell Command Output*")))
("hi" "hi\n" #f)
> (run! shell-commands:shell-command "seq 3" #f)
> (list (shown) (text (buffers:find "*Shell Command Output*")))
(("*scratch*" "*Shell Command Output*") "1\n2\n3\n")
> (run! shell-commands:shell-command "false" #f)
> (list (message) (text (buffers:find "*Shell Command Output*")))
("(Shell command failed with code 1 and no output)" "")
> (run! shell-commands:shell-command "echo out; echo err >&2" #f)
> (text (buffers:find "*Shell Command Output*"))
"out\nerr\n"
; runs:shell names the shell and its switches.
> (set-option! runs:shell '("bash" "-c"))
> (run! shell-commands:shell-command "echo $0" #f)
> (message)
"bash"
> (set-option! runs:shell '("sh" "-c"))
> (run! shell-commands:shell-command "echo $0" #f)
> (message)
"sh"
; With a prefix argument the output goes in at each cursor, from one
; run, with point before it and no mark.
> (define notes (buffers:make "notes" "a\nb\nc\n"))
> (layout:switch-to-buffer notes)
> (views:set-point! (view) 1)
> (in-client (lambda () (views:add-cursor! (view) 3) (views:add-cursor! (view) 5) (void)))
> (run! shell-commands:shell-command "printf x" '(4))
> (list (text notes) (map views:cursor-point (views:cursors (view))) (map views:cursor-mark (views:cursors (view))))
("xa\nxb\nxc\n" (1 4 7) (#f #f #f))
; With a prefix argument the buffer is asked first whether it takes text
; at every cursor, so in one that refuses the program never runs.
> (define ended-run (runs:start-for-user "*ended*" "true"))
> (ended? ended-run)
0
> (layout:switch-to-buffer ended-run)
> (run! shell-commands:shell-command "touch $HOME/ran; echo out" '(4))
! shell-commands:shell-command: the buffer refuses the output with irritant "*ended*"
> (file-exists? (at "ran"))
#f
> (layout:switch-to-buffer notes)
; A line ending in & runs as M-&.
> (run! shell-commands:shell-command "echo later &" #f)
> (define async (buffers:find "*Async Shell Command*"))
> (ended? async)
0
> (output async)
"later"
; C-g stops a program M-! waits for.
> (start! "M-!")
> (type! "sleep 30; echo never")
> (press! "RET")
> (settle)
> (press! "C-g")
! &quit
> (settle)
> (message)
"Quit"
> (filter (lambda (p) (member "sleep 30; echo never" (processes:command-line p))) (processes:all))
()
