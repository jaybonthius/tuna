; A click on a span looks the key up in the span's own keymap before its
; layer type's; on a span without one, in the layer type's.
> (define-table own-keys)
> (define-table marked-keys)
> (commands:define-command (on-own [event (keys:command-event)])
    "Records a click on a span with its own keymap."
    (set! seen (cons (list 'own (views:posn-point (keys:event-start event))) seen)))
> (commands:define-command (on-marked [event (keys:command-event)])
    "Records a click on a span of the marked layer."
    (set! seen (cons (list 'marked (views:posn-point (keys:event-start event))) seen)))
> (keys:bind! own-keys "<mouse-1>" on-own)
> (keys:bind! marked-keys "<mouse-1>" on-marked)
