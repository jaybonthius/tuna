; A user's removal of a segment stays in effect when status-line reloads
; and places it again.
> (import (tuna eval))
> (define notes (buffers:make "notes" "one\n"))
> (views:set-buffer! (view) notes)
> (table-remove! status-line:segments status-line:minor-modes)
> (map car (status (view)))
("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size" "status-line:major-mode")
> (eval-file (string-append (getenv "TUNA_LIBRARY") "/status-line.sls"))
> (map car (status (view)))
("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size" "status-line:major-mode")
> (screen-status-lines client)
((("status-line:modified" . "") ("status-line:buffer-name" . "notes") ("status-line:position" . "L1") ("status-line:percent-position" . "Top") ("status-line:region-size" . "") ("status-line:major-mode" . "Fundamental")))
; Unloading takes back every change to its table, so the segments are
; placed as by default when it loads again; while it is unloaded, no
; status line is drawn.
> (unload-module! '(status-line))
> (screen-status-lines client)
()
> (load-module! '(status-line))
> (map car (status (view)))
("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size" "status-line:major-mode" "status-line:minor-modes")
; Unloading the module that defines and places a segment hides it;
; loading it again shows it.
> (import (cursors))
> (views:add-cursor! (view) 2)
#<cursor>
> (assoc "cursors:cursor-count" (status (view)))
("cursors:cursor-count" . "2 cursors")
> (unload-module! '(cursors))
> (map car (status (view)))
("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size" "status-line:major-mode" "status-line:minor-modes")
> (load-module! '(cursors))
> (assoc "cursors:cursor-count" (status (view)))
("cursors:cursor-count" . "2 cursors")
