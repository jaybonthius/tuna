; Sources local to a buffer are not asked about a prompt's text, so
; typing at a prompt leaves *Docs* about the code and g still asks there.
> (hooks:remove! docs-at-point:sources signature)
> (buffers:with-buffer notes (hooks:add-local! docs-at-point:sources signature))
> (press! "C-f")
> (press! "C-h" ".")
> (testing:wait-until (lambda () (buffers:find "*Docs*")))
> (timers:sleep 0.2)
> (document:text (buffers:document (buffers:find "*Docs*")))
"alpha\n(alpha x)\n"
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "a")
> (list (input) (echo-area:current-message) (bracket))
("a" #f #f)
> (type! "b")
> (timers:sleep 0.3)
> (list (document:text (buffers:document (buffers:find "*Docs*"))) (echo-area:current-message) (bracket))
("alpha\n(alpha x)\n" #f #f)
> (press! "C-g")
! &cancelled
> (timers:sleep 0.1)
> (set! asked '())
> (docs-at-point-display:refresh)
> (timers:sleep 0.2)
> (equal? asked (list (views:id notes-view)))
#t
; A source for every buffer is still not asked about the prompt's text.
> (buffers:with-buffer notes (hooks:remove-local! docs-at-point:sources signature))
> (hooks:add! docs-at-point:sources signature)
> (set! asked '())
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (type! "ab")
> (timers:sleep 0.3)
> (list (input) asked (bracket))
("ab" () #f)
> (press! "C-g")
! &cancelled
