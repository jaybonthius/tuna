; The region's commands act on the ranges views:region-ranges gives each
; cursor, so advice that makes the region a rectangle makes them kill,
; copy, convert and replace the rectangle.
> (import (rectangle))
> (advice-add! views:region-ranges rectangle:ranges)
; Columns 2 to 5 of four lines, the second too short to reach them and
; the last with no line break after it.
> (define box "abcdefghij\nab\nabcdefghij\nabcdef")
> (start! box 32)
("abcdefghij\nab\nabcdefghij\nabcdef" ((32 #f)))
> (views:set-mark! (view) 3)
> (views:region-bounds (view))
((3 . 7) (17 . 21) (28 . 32))
; A cursor's several ranges make one kill, their pieces with a line break
; between, so the entry keeps one kill per cursor. Yanked with nothing
; else to say how, the kill goes in as that text.
> (press! "C-w")
> (list (state) (map kill-ring:text (map list (kill-ring:current))))
(("abghij\nab\nabghij\nab" ((3 #f))) ("cdef\ncdef\ncdef"))
> (press! "C-y")
> (state)
("abcdef\ncdef\ncdefghij\nab\nabghij\nab" ((17 #f)))
; Copying puts the same entry on the ring and leaves the text.
> (start! box 32)
("abcdefghij\nab\nabcdefghij\nabcdef" ((32 #f)))
> (views:set-mark! (view) 3)
> (press! "M-w")
> (list (state) (kills 1))
(("abcdefghij\nab\nabcdefghij\nabcdef" ((32 #f))) ("cdef\ncdef\ncdef"))
; Case conversion converts each range.
> (start! box 32)
("abcdefghij\nab\nabcdefghij\nabcdef" ((32 #f)))
> (views:set-mark! (view) 3)
> (press! "C-x" "C-u")
> (state)
("abCDEFghij\nab\nabCDEFghij\nabCDEF" ((32 #f)))
; Typing over the region deletes each range and types where the first
; began.
> (views:set-mark! (view) 3)
> (press! "x")
> (state)
("abxghij\nab\nabghij\nab" ((4 #f)))
; The primary selection is the kill editing:extract-region makes.
> (start! box 32)
("abcdefghij\nab\nabcdefghij\nabcdef" ((32 #f)))
> (views:set-mark! (view) 3)
> (press! "C-b")
> (kill-ring:text (list (editing:primary-selection)))
"cde\ncde\ncde"
; The plugin that shapes the region says how its kill is yanked, as
; Emacs's rectangle puts a yank-handler on the text it kills: advice on
; editing:extract-region gives the kill a procedure that inserts each
; line at the same column of the next lines.
> (advice-add! editing:extract-region rectangle:kill)
; A rectangle yank: columns 2 to 4 killed from three lines, yanked as a
; rectangle at column 5. The yank is the ranges the buffer's edits
; inserted, so yank-pop takes back only those and not the text between
; them, as Emacs's rectangle sets yank-undo-function.
> (define grid "0123456789\n0123456789\n0123456789\n0123456789\n")
> (start! grid 14)
("0123456789\n0123456789\n0123456789\n0123456789\n" ((14 #f)))
> (kill-ring:push! (list "XYZ"))
> (views:set-mark! (view) 39)
> (views:region-bounds (view))
((14 . 17) (25 . 28) (36 . 39))
> (press! "C-w")
> (list (state) (kills 1))
(("0123456789\n0156789\n0156789\n0156789\n" ((14 #f))) ("234\n234\n234"))
> (views:set-point! (view) 17)
> (press! "C-y")
> (state)
("0123456789\n0156723489\n0156723489\n0156723489\n" ((42 #f)))
> (press! "M-y")
> (state)
("0123456789\n01567XYZ89\n0156789\n0156789\n" ((20 #f)))
; The rectangle pads a short line and adds a line past the end, as
; Emacs's insert-rectangle; those are edits the yank made too, so
; yank-pop takes them back, as Emacs's yank-pop does.
> (start! grid 14)
("0123456789\n0123456789\n0123456789\n0123456789\n" ((14 #f)))
> (kill-ring:push! (list "XYZ"))
> (views:set-mark! (view) 39)
> (press! "C-w")
> (start! "abcdefgh\nab\n" 6)
("abcdefgh\nab\n" ((6 #f)))
> (press! "C-y")
> (state)
("abcde234fgh\nab   234\n     234" ((30 #f)))
> (press! "M-y")
> (state)
("abcdeXYZfgh\nab\n" ((9 #f)))
; A yank whose procedure is refused part-way takes back what went in,
; as a kill of several parts does, and leaves point where it was.
> (start! grid 14)
("0123456789\n0123456789\n0123456789\n0123456789\n" ((14 #f)))
> (views:set-mark! (view) 39)
> (press! "C-w")
> (buffers:define-layer locked-lines (read-only))
> (start! "abcdefgh\nabcdefgh\nabcdefgh\n" 6)
("abcdefgh\nabcdefgh\nabcdefgh\n" ((6 #f)))
> (buffers:add-span! (buffers:layer (views:buffer (view)) locked-lines) 10 18 'locked)
> (press! "C-y")
! buffers:insert!: a read-only span refuses the edit with irritant locked-lines
> (state)
("abcdefgh\nabcdefgh\nabcdefgh\n" ((6 #f)))
; Two rectangle kills in a row, columns 2 to 3 then 4 to 6, make two
; entries: a kill that yanks itself is never joined to another, as
; Emacs's rectangle kill sets kill-region-dont-append.
> (start! grid 14)
("0123456789\n0123456789\n0123456789\n0123456789\n" ((14 #f)))
> (define entries-before (length (kill-ring:entries)))
> (views:set-mark! (view) 27)
> (press! "C-w")
> (views:set-mark! (view) 26)
> (press! "C-w")
> (list (state) (- (length (kill-ring:entries)) entries-before) (kills 2))
(("0123456789\n01789\n01789\n0123456789\n" ((14 #f))) 2 ("456\n456" "23\n23"))
; Nor is one joined to a kill-line of as many cursors right before it.
> (start! "one\ntwo\nthree\nfour\n" 1 5 9)
("one\ntwo\nthree\nfour\n" ((1 #f) (5 #f) (9 #f)))
> (define entries-before (length (kill-ring:entries)))
> (press! "C-k")
> (for-each (lambda (c) (views:remove-cursor! (view) c)) (cdr (views:cursors (view))))
> (views:set-cursor! (car (views:cursors (view))) 2 7)
> (press! "C-w")
> (list (state) (- (length (kill-ring:entries)) entries-before) (map kill-ring:text (map list (kill-ring:current))))
(("\n\n\nr\n" ((4 #f))) 2 ("fou"))
; Two cursors, each with a rectangle: the entry has one kill per cursor,
; and a yank at the two cursors gives each its own back as a rectangle.
> (define four "abcdefghij\nabcdefghij\nabcdefghij\nabcdefghij\n")
> (start! four 18 40)
("abcdefghij\nabcdefghij\nabcdefghij\nabcdefghij\n" ((18 #f) (40 #f)))
> (let ([cs (views:cursors (view))]) (views:set-cursor! (car cs) 18 3) (views:set-cursor! (cadr cs) 40 25))
> (map (lambda (c) (views:region-bounds (view) c)) (views:cursors (view)))
(((3 . 7) (14 . 18)) ((25 . 29) (36 . 40)))
> (press! "C-w")
> (list (state) (map kill-ring:text (map list (kill-ring:current))))
(("abghij\nabghij\nabghij\nabghij\n" ((3 #f) (17 #f))) ("cdef\ncdef" "cdef\ncdef"))
> (press! "C-y")
> (car (state))
"abcdefghij\nabcdefghij\nabcdefghij\nabcdefghij\n"
> (advice-remove! editing:extract-region rectangle:kill)
> (advice-remove! views:region-ranges rectangle:ranges)
; editing:insert-region! puts lines into a buffer, by default with a line
; break between, and returns the position after them; a rectangle
; advises it to put each line at the same column of the next lines.
; It takes the view and the cursor, as views:region-ranges and
; editing:extract-region do, so the shaper decides from them whether
; that cursor's region has its shape: here, while the cursor has a mark.
> (start! grid 1)
("0123456789\n0123456789\n0123456789\n0123456789\n" ((1 #f)))
> (editing:insert-region! (view) (car (views:cursors (view))) 3 '("ab" "cd"))
8
> (text)
"01ab\ncd23456789\n0123456789\n0123456789\n0123456789\n"
> (advice-add! editing:insert-region! rectangle:insert-region)
> (views:set-mark! (view) 1)
> (editing:insert-region! (view) (car (views:cursors (view))) 19 '("xy" "zw" "uv"))
47
> (text)
"01ab\ncd23456789\n01xy23456789\n01zw23456789\n01uv23456789\n"
> (views:set-mark! (view) #f)
> (editing:insert-region! (view) (car (views:cursors (view))) 2 '("p" "q"))
5
> (text)
"0p\nq1ab\ncd23456789\n01xy23456789\n01zw23456789\n01uv23456789\n"
> (advice-remove! editing:insert-region! rectangle:insert-region)
; Without the advice, the region is point to mark.
> (views:region-bounds (view))
()
