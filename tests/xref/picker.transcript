; xref-picker reads several items with completion, grouped by file under
; the path from the project's root, each row the line and summary.
> (import (xref-picker))
> (define uses (files:visit (string-append code "/uses.txt")))
> (in-client (lambda () (layout:switch-to-buffer uses)))
> (views:set-point! (view) 6)
> (define start (view))
> (define (shown) (let ([b (views:buffer start)]) (list (buffers:name b) (document:line (buffers:document b) (views:point start)))))
> (define (open?) (map (lambda (name) (and (buffers:find name) #t)) '("defs.txt" "twice.txt")))
> (define t (start! (lambda () (press! "M-."))))
> (define s (session))
> (wait-matches s)
> (map (lambda (m) (list (completion:title s m) (completion:row-text s m))) (match-list s))
(("defs.txt" "1: def total") ("sub/twice.txt" "2: def total"))
; The selected item's place is shown in the view the search started
; from; a quit puts it back and kills the buffers the preview opened.
> (testing:wait-until (lambda () (equal? (shown) '("defs.txt" 1))))
> (shown)
("defs.txt" 1)
> (press! "C-n")
> (testing:wait-until (lambda () (equal? (shown) '("twice.txt" 2))))
> (list (shown) (open?))
(("twice.txt" 2) (#t #t))
> (press! "C-g")
! &cancelled
> (result t)
> (list (shown) (open?) (places))
(("uses.txt" 1) (#f #f) ())
; Choosing keeps the chosen file's buffer, and M-, returns.
> (define t (start! (lambda () (press! "M-."))))
> (define s (session))
> (wait-matches s)
> (press! "C-n" "RET")
> (result t)
> (list (here) (open?) (places))
(("twice.txt" 2) (#f #t) (("uses.txt" 1)))
> (press! "M-,")
> (here)
("uses.txt" 1)
; C-M-. searches the backend's identifiers as the input is typed, once it
; holds completion:async-min-input characters and has rested
; completion:async-delay seconds; a new input quits the search under way.
> (options:set! completion:async-min-input 2 completion:async-delay 0.1)
> (define t (start! (lambda () (press! "C-M-."))))
> (define s (session))
> (type! "t")
> (timers:sleep 0.2)
> (list asked (texts s))
(() ())
> (type! "o")
> (timers:sleep 0.05)
> asked
()
> (timers:sleep 0.08)
> (press! "DEL" "DEL")
> (type! "av")
> (testing:wait-until (lambda () (equal? (texts s) '("def average"))))
> (list (reverse asked) answered (texts s))
(("to" "av") ("av") ("def average"))
> (press! "RET")
> (result t)
> (list (here) (car (places)))
(("defs.txt" 2) ("uses.txt" 1))
