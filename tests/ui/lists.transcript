; A heading procedure gives each row's heading, a string or #f. A
; heading is drawn above each row whose heading differs from the row
; before's, and above the first row a view draws, outside the rows.
> (define h (buffers:make "*headed*" (ui:list '())))
> (define (hl) (document:token (buffers:document h) 0))
> (define (band n) (cond [(< n 3) "low"] [(< n 9) "mid"] [else "high"]))
> (define (headings v)
    (let ([s (html v)] [open "<li class=\"ui-list-heading\"><span>"])
      (let loop ([i 0] [acc '()])
        (cond
          [(> (+ i (string-length open)) (string-length s)) (reverse acc)]
          [(string=? (substring s i (+ i (string-length open))) open)
           (let* ([from (+ i (string-length open))]
                  [to (let find ([j from]) (if (char=? (string-ref s j) #\<) j (find (+ j 1))))])
             (loop to (cons (substring s from to) acc)))]
          [else (loop (+ i 1) acc)]))))
> (show! h)
> (ui:set-rows! h (hl) 12 number-row choose band)
> (headings (view))
("low" "mid" "high")
; A heading is drawn beside its row's element, which carries the row's
