; At exit, a paused task is left before any module unloads, as exit leaves
; the task it is called in: its after-thunks run and can still use a
; module's definitions, and its handlers do not run, so none can start
; new work while Tuna exits.
> (import (user))
> (define exiting? #f)
> (define paused
    (spawn-task (lambda (restore) (guard (c [#t (display "handler ran") (newline) (spawn-task (lambda (restore) (display "new work") (newline)))])
          (dynamic-wind
            void
            (lambda () (suspend (lambda (resume) (void))))
            (lambda () (when exiting? (user:say-leaving))))))))
> (set! exiting? #t)
leaving the task
configuration unloading
user unloading
keeper unloading
