; buffers:revert-buffer runs the current buffer's buffers:revert-function,
; whose global value files sets to files:revert-from-file: a file buffer
; reads its file again.
> (import (commands))
> (define (in-task thunk)
    (let ([result #f])
      (testing:wait-until (let ([t (spawn-task (lambda () (set! result (guard (c [#t (list (condition-who c) (condition-message c))]) (thunk) 'done))))])
                    (lambda () result)))
      result))
> (define (revert-in b) (in-task (lambda () (buffers:with-buffer b (commands:run buffers:revert-buffer)))))
> (eq? (buffers:revert-function) files:revert-from-file)
#t
> (disk-checks:write-text! "~/r.txt" "one\n")
> (define r (files:visit "~/r.txt"))
> (disk-checks:write-text! "~/r.txt" "two\n")
> (list (revert-in r) (text r))
(done "two\n")
; A buffer that visits no file and sets no value of its own gets files'
; refusal, which the command run reports.
> (define plain (buffers:make "plain" "text\n"))
> (revert-in plain)
! files:revert-from-file: the buffer visits no file with irritant #<buffer plain>
done
; A command set locally runs with the prefix argument still bound.
> (define seen #f)
> (commands:define-command (note-prefix [p (commands:prefix-argument)]) "Notes its prefix argument." (set! seen p))
> (buffers:with-buffer plain (set-option-local! buffers:revert-function note-prefix))
> (in-task (lambda () (parameterize ([commands:prefix-argument '(4)]) (buffers:with-buffer plain (commands:run buffers:revert-buffer)))))
done
> seen
(4)
; M-x does not offer files' reverter, so a user meets one revert command.
> (table-ref commands:command-modes files:revert-from-file #f)
()
; With files unloaded nothing reverts a file buffer; loading files sets
; its value again.
> (unload-module! '(files))
> (buffers:revert-function)
#f
> (in-task (lambda () (commands:run buffers:revert-buffer)))
! buffers:revert-buffer: nothing reverts this buffer
done
> (load-module! '(files))
> (eq? (buffers:revert-function) files:revert-from-file)
#t
