; Examples of using web, against a browser stand-in that fetches the page,
; reads its screen stream and posts items.
> (http:wait-for-server)
Tuna is at http://127.0.0.1:PORT/
> (set-option! web:port (http:free-port)
               web:hosts '("tuna.example.ts.net"))
Tuna is at http://127.0.0.1:PORT/
> (http:status (http:get "/" '(("host" . "tuna.example.ts.net"))))
200
> (define p (http:page))
> (http:connect! p)
> (web:clients)
(#<client 2>)
> (table-set! web:input-handlers "ping"
    (lambda (client item) (display (cdr (assoc "seq" item)))))
> (http:send! p '(("type" . "ping")))
1
204
> (web:send-screen! (car (web:clients)) (haml (:p "Hello")) "Tuna")
> (http:show (http:next p))
(screen 1 1 "<p>Hello</p>")
; A plugin's stylesheet, and a theme that replaces it.
> (import (buffers))
> (http:head-files)
("/files/1/buffers.css?v=1")
> (table-set! web:stylesheets 'buffers "themes/buffers-dark.css")
> (http:head-files)
("/files/1/buffers-dark.css?v=1")
> (http:body (http:get "/files/1/buffers-dark.css"))
".buffer { background: black; }\n"
> (http:take p 2)
((datastar-patch-elements ("selector" "head") ("mode" "append") ("elements" "<link id=\"tuna-stylesheet-1\" rel=\"stylesheet\" href=\"/files/1/buffers.css?v=1\">")) (datastar-patch-elements ("elements" "<link id=\"tuna-stylesheet-1\" rel=\"stylesheet\" href=\"/files/1/buffers-dark.css?v=1\">")))
; The clipboard plugin, with stand-ins for the plugins it imports. Its
; script makes connected pages reload.
> (import (clipboard))
> (http:take p 2)
((script "location.reload()") closed)
> (define q (http:page))
> (http:head-files)
("/files/1/buffers-dark.css?v=1" "/files/2/clipboard.js?v=1")
> (http:connect! q)
> (http:send! q '(("type" . "paste") ("text" . "from the browser")))
204
> editing:pastes
(("from the browser" selected-view))
> (kill-ring:push! "from the browser")
> (http:next q 0.2)
timeout
> (kill-ring:push! "killed")
> (http:show (http:next q))
(script "tuna.call(\"copy\", \"killed\")")
; web's internals are not among its names.
> web:give-screen!
! variable web:give-screen! is not bound
