; Each level keeps a history of its interior, recorded once per command
; that changed it; C-c <left> and C-c <right> go back and forward in the
; selected view's level and never move the parts outside it.
> (define c1 (web:add-client! 1))
> (define (named name) (or (buffers:find name) (buffers:make name (string-append name "\n"))))
> (define (shape d)
    (if (vector? d)
        (cdr (assq 'buffer (vector-ref d 1)))
        (cons (car d) (map shape (cddr d)))))
> (define (outline) (shape (tree)))
> (define notes (views:make (named "notes.org")))
> (define pi (views:make (named "*pi*")))
> (set-parts! (layout-split:container '((direction . row)) (atom notes) (atom pi)))
> (layout:select! notes)
> (define echo (place-echo (named " *Echo Area*")))
> (define explorer ((layout-split:display-at-side (layout:direction left) 50 '(columns 30)) (named "*explorer*")))
> (outline)
(layout:level (layout-split:container (layout-split:container "*explorer*" (layout:level (layout-split:container "notes.org" "*pi*"))) " *Echo Area*"))
> (define (back!) (press! c1 '("c" "control") '("ArrowLeft")))
> (define (forward!) (press! c1 '("c" "control") '("ArrowRight")))
; C-x 2, then C-x 3 in the new view: each is one step back.
> (press! c1 '("x" "control") '("2"))
> (press! c1 '("x" "control") '("3"))
> (outline)
(layout:level (layout-split:container (layout-split:container "*explorer*" (layout:level (layout-split:container (layout-split:container (layout-split:container "notes.org" "notes.org") "notes.org") "*pi*"))) " *Echo Area*"))
> (back!)
> (outline)
(layout:level (layout-split:container (layout-split:container "*explorer*" (layout:level (layout-split:container (layout-split:container "notes.org" "notes.org") "*pi*"))) " *Echo Area*"))
> (back!)
> (outline)
(layout:level (layout-split:container (layout-split:container "*explorer*" (layout:level (layout-split:container "notes.org" "*pi*"))) " *Echo Area*"))
> (back!)
! layout:history-back: no more back history in this level
> (forward!)
> (outline)
(layout:level (layout-split:container (layout-split:container "*explorer*" (layout:level (layout-split:container (layout-split:container "notes.org" "notes.org") "*pi*"))) " *Echo Area*"))
> (forward!)
> (outline)
(layout:level (layout-split:container (layout-split:container "*explorer*" (layout:level (layout-split:container (layout-split:container (layout-split:container "notes.org" "notes.org") "notes.org") "*pi*"))) " *Echo Area*"))
> (forward!)
! layout:history-forward: no more forward history in this level
; Placed parts stay: the explorer's plugin removes its part between two
; steps, and going back restores only the user's windows.
> (back!)
> (layout:delete-part! (layout:view-node explorer))
> (outline)
(layout:level (layout-split:container (layout:level (layout-split:container (layout-split:container "notes.org" "notes.org") "*pi*")) " *Echo Area*"))
> (back!)
> (outline)
(layout:level (layout-split:container (layout:level (layout-split:container "notes.org" "*pi*")) " *Echo Area*"))
; A part placed between steps stays too.
> (define outline-view ((layout-split:display-at-side (layout:direction right) 60 '(columns 24)) (named "*outline*")))
> (forward!)
> (outline)
(layout:level (layout-split:container (layout-split:container (layout:level (layout-split:container (layout-split:container "notes.org" "notes.org") "*pi*")) "*outline*") " *Echo Area*"))
; A level holding a placed part keeps no history: in the echo area's
; level, the root, there is none.
> (layout:select! outline-view)
> (back!)
! layout:history-back: no more back history in this level
> (layout:select! notes)
; A command repeated in sequence records once, as a resize key held
; down.
> (define (user) (shape (caddr (caddr (tree)))))
> (define (user-datum) (caddr (caddr (tree))))
> (define before-resize (user-datum))
> (commands:run layout-split:enlarge 1)
> (commands:run layout-split:enlarge 1)
> (commands:run layout-split:enlarge 1)
> (back!)
> (equal? (user-datum) before-resize)
#t
; A buffer shown in a view is part of the level's interior.
> (commands:define-command (show-mail) "Shows mail in the selected view." (layout:switch-to-buffer (named "mail")))
> (commands:run show-mail)
> (map (lambda (v) (buffers:name (views:buffer v))) (layout:views))
("mail" "notes.org" "*pi*" "*outline*" " *Echo Area*")
> (back!)
> (map (lambda (v) (buffers:name (views:buffer v))) (layout:views))
("notes.org" "notes.org" "*pi*" "*outline*" " *Echo Area*")
; Each view gets back its point as it was; moving the point alone is no
; step.
> (views:set-point! notes 5)
> (press! c1 '("x" "control") '("3"))
> (views:set-point! notes 1)
> (back!)
> (views:point notes)
5
