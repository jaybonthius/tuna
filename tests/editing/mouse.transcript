; Dragging after a third press extends by whole lines, backwards too.
> (mouse! "down" 20 '("clicks" . 3))
> (mouse! "move" 3)
> (state)
("foo-bar  x---y\nsecond line\nthird" ((1 28)))
> (mouse! "move" 30)
> (mouse! "drag" 30 '("clicks" . 3))
> (state)
("foo-bar  x---y\nsecond line\nthird" ((33 16)))
; A single press after a line selection places point.
> (mouse! "down" 20)
> (mouse! "click" 20)
> (state)
("foo-bar  x---y\nsecond line\nthird" ((20 #f)))
; The fourth press of a run is a first press, as Emacs cycles a run's
; selection every three presses, and the fifth selects a word again.
> (mouse! "down" 20 '("clicks" . 3))
> (mouse! "click" 20 '("clicks" . 3))
> (mouse! "down" 20 '("clicks" . 4))
> (mouse! "click" 20 '("clicks" . 4))
> (state)
("foo-bar  x---y\nsecond line\nthird" ((20 #f)))
> (mouse! "down" 20 '("clicks" . 5))
> (state)
("foo-bar  x---y\nsecond line\nthird" ((22 16)))
; Whitespace runs across newlines.
