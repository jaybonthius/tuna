(import (tuna) (test) (test-user) (test-runner) (options) (hooks) (commands) (buffers) (views) (undo) (undo-test edits))

(test "an edit after an undo starts a branch; redo follows the child undo last left, else the newest; go-to! moves across branches"
  (let ([r (buffers:make "tree" "\n")])
    (undo-test/edits:run-in r undo-test/edits:insert 1 "a")
    (undo-test/edits:run-in r undo-test/edits:insert 2 "b")
    (undo-test/edits:run-in r undo:undo 1)
    (undo-test/edits:run-in r undo-test/edits:insert 2 "c")
    (undo-test/edits:run-in r undo:undo 1)
    (undo-test/edits:run-in r undo:redo 1)
    (check-equal? "ac\n" (undo-test/edits:text r))
    (undo-test/edits:run-in r undo:undo 1)
    (undo:go-to! r 2)
    (check-equal? "ab\n" (undo-test/edits:text r))
    (undo-test/edits:run-in r undo:undo 1)
    (undo-test/edits:run-in r undo:redo 1)
    (check-equal? "ab\n" (undo-test/edits:text r))
    (check-equal? '(2 0 (0 #f) (1 0) (2 1) (3 1)) (undo-test/edits:tree r))
    (undo:go-to! r 0)
    (check-equal? "\n" (undo-test/edits:text r))
    (undo:go-to! r 3)
    (check-equal? "ac\n" (undo-test/edits:text r))
    (check-raises (undo-test/edits:raised? 'undo:go-to! "not a state of the buffer's history") (undo:go-to! r 9))
    (check-raises (undo-test/edits:raised? 'undo:go-to! "not a state of the buffer's history") (undo:go-to! r -1)))
  (undo-test/edits:take-said!))

(test "history gives the current state, the saved state, then each state with its parent and the time its group ended"
  (let ([notes (buffers:make "history" "Buy milk.\n")])
    (undo-test/edits:run-in notes undo-test/edits:insert 1 "a")
    (let ([h (undo:history notes)])
      (check-equal? '(1 0 ((0 #f #t) (1 0 #t)))
        (list (car h) (cadr h)
              (map (lambda (s) (list (car s) (cadr s) (and (integer? (caddr s)) (> (caddr s) 1700000000)))) (cddr h)))))))

(test "another after-edit entry that edits the buffer as undo splices ends the move there, as a state of its own, and the move raises"
  (let* ([k (buffers:make "sneak" "0123456789\n")] [sneak #f]
         [sneak-in (lambda (buffer edit)
                     (when (and sneak (eq? buffer k))
                       (set! sneak #f)
                       (buffers:replace! k 1 1 "!")))])
    (undo:with-edit-group k (buffers:replace! k 3 3 "a") (buffers:replace! k 9 9 "b"))
    (hooks:add! buffers:after-edit sneak-in)
    (set! sneak #t)
    (check-equal? '((undo:undo "the buffer does not hold the text its history expects"))
      (undo-test/edits:reports-during (lambda () (undo-test/edits:run-in k undo:undo 1))))
    (check-equal? '("!01a23456789\n" (3 0 (0 #f) (1 2) (2 0) (3 2))) (list (undo-test/edits:text k) (undo-test/edits:tree k)))
    (undo-test/edits:run-in k undo:undo 2)
    (check-equal? "0123456789\n" (undo-test/edits:text k))
    (undo:go-to! k 1)
    (check-equal? "01a23456b789\n" (undo-test/edits:text k))
    (set! sneak #t)
    (undo-test/edits:run-in k undo:undo 1)
    (check-equal? '("!01a23456789\n" (4 0 (0 #f) (1 2) (2 0) (3 2) (4 2))) (list (undo-test/edits:text k) (undo-test/edits:tree k)))
    (hooks:remove! buffers:after-edit sneak-in))
  (undo-test/edits:take-said!))

(test "undo puts the view's cursors where they were before the group; redo puts them where they were after it"
  (let* ([w (buffers:make "cursors" "one two\n")] [v (views:make w)])
    (views:set-point! v 4)
    (views:add-cursor! v 8)
    (views:with-view v (commands:run undo-test/edits:insert 1 ">"))
    (views:with-view v (commands:run undo-test/edits:delete 5 9))
    (check-equal? '(">one\n" (5)) (list (undo-test/edits:text w) (map views:cursor-point (views:cursors v))))
    (views:set-point! v 1)
    (views:with-view v (commands:run undo:undo 1))
    (check-equal? '(">one two\n" (5 9)) (list (undo-test/edits:text w) (map views:cursor-point (views:cursors v))))
    (views:with-view v (commands:run undo:redo 1))
    (check-equal? '(">one\n" (5)) (list (undo-test/edits:text w) (map views:cursor-point (views:cursors v))))
    (views:drop! v))
  (undo-test/edits:take-said!))

(test "a group made with no view showing its buffer puts the cursors at its first edit's start on undo and at its last edit's end on redo"
  (let ([w (buffers:make "unseen" "one two three\n")])
    (undo:with-edit-group w (buffers:replace! w 5 8 "2") (buffers:replace! w 1 1 ">"))
    (let ([v (views:make w)])
      (views:set-point! v 12)
      (views:add-cursor! v 3)
      (views:with-view v (commands:run undo:undo 1))
      (check-equal? '("one two three\n" (5)) (list (undo-test/edits:text w) (map views:cursor-point (views:cursors v))))
      (views:set-point! v 12)
      (views:add-cursor! v 3)
      (views:with-view v (commands:run undo:redo 1))
      (check-equal? '(">one 2 three\n" (2)) (list (undo-test/edits:text w) (map views:cursor-point (views:cursors v))))
      (views:drop! v)))
  (undo-test/edits:take-said!))

(test "edits the buffer no longer keeps when a history is installed start a new history, with a warning naming the buffer"
  (let ([f (buffers:make "trimmed" "\n")])
    (check-equal? #t (undo:attach! f))
    (do ([i 0 (+ i 1)]) ((= i 1100)) (buffers:replace! f 1 1 "x"))
    ;; A buffer drops its oldest edits once the user has been idle a
    ;; second, and only a key starts an idle period.
    (test-user:press! "C-g")
    (test-runner:wait-until (lambda () (not (buffers:edits-since f 0))))
    (check-equal? '((undo "edits were made that undo could not record, so the history of trimmed starts again"))
      (undo-test/edits:reports-during (lambda () (check-equal? #f (undo:install! f #f 0)))))
    (check-equal? '(0 #f (0 #f)) (undo-test/edits:tree f))))

(test "a history is trimmed to the limit, the oldest groups first, a branch off the root before the path to the current state"
  (let ([s (buffers:make "small" "\n")])
    (buffers:with-buffer s (options:set-local! undo:limit 100))
    (for-each (lambda (x) (undo-test/edits:run-in s undo-test/edits:insert 1 x)) '("a" "b" "c" "d"))
    (test-user:settle)
    (check-equal? '(4 #f (1 #f) (2 1) (3 2) (4 3)) (undo-test/edits:tree s))
    (check-equal? '((undo:undo "no further undo information")) (undo-test/edits:reports-during (lambda () (undo-test/edits:run-in s undo:undo 9))))
    (check-equal? "a\n" (undo-test/edits:text s)))
  (let ([s2 (buffers:make "branches" "\n")])
    (buffers:with-buffer s2 (options:set-local! undo:limit 100))
    (undo-test/edits:run-in s2 undo-test/edits:insert 1 "a")
    (undo-test/edits:run-in s2 undo:undo 1)
    (for-each (lambda (x) (undo-test/edits:run-in s2 undo-test/edits:insert 1 x)) '("b" "c" "d"))
    (test-user:settle)
    (check-equal? '(4 0 (0 #f) (2 0) (3 2) (4 3)) (undo-test/edits:tree s2)))
  (undo-test/edits:take-said!))

(test "one group larger than the limit empties the history, with a warning"
  (let ([s (buffers:make "large" "\n")])
    (buffers:with-buffer s (options:set-local! undo:limit 100))
    (undo-test/edits:run-in s undo-test/edits:insert 1 "a")
    (check-equal? '((undo:limit "an edit group is larger than the limit, so the history of large starts again"))
      (undo-test/edits:reports-during
        (lambda ()
          (undo-test/edits:run-in s undo-test/edits:insert 1 (make-string 80 #\x))
          (test-user:settle))))
    (check-equal? '(2 #f (2 #f)) (undo-test/edits:tree s))
    (let ([h (undo:history s)])
      (check (<= (abs (- (caddr (caddr h)) (time-second (current-time 'time-utc)))) 5)))
    (check-equal? '((undo:undo "no further undo information")) (undo-test/edits:reports-during (lambda () (undo-test/edits:run-in s undo:undo 1))))))

(test "the limit is 4,000,000 by default, and a buffer sets it locally; with 0 it keeps no history, though its edits mark it modified"
  (check-equal? 4000000 (undo:limit))
  (let ([z (buffers:make "none" "\n")])
    (buffers:with-buffer z (options:set-local! undo:limit 0))
    (check-equal? 0 (buffers:with-buffer z (undo:limit)))
    (check-equal? 4000000 (undo:limit))
    (undo-test/edits:run-in z undo-test/edits:insert 1 "a")
    (check-equal? '((undo:undo "no further undo information")) (undo-test/edits:reports-during (lambda () (undo-test/edits:run-in z undo:undo 1))))
    (check-equal? '("a\n" #t) (list (undo-test/edits:text z) (buffers:modified? z))))
  (check-raises assertion-violation? (options:set! undo:limit -1)))

(test "undo says Undo and redo says Redo, a refused redo nothing; in an internal buffer, such as a prompt's, both say nothing"
  (undo-test/edits:take-said!)
  (let ([b (buffers:make "said" "abc\n")])
    (undo-test/edits:run-in b undo-test/edits:insert 1 "1")
    (undo-test/edits:run-in b undo:undo 1)
    (undo-test/edits:run-in b undo:redo 1)
    (undo-test/edits:reports-during (lambda () (undo-test/edits:run-in b undo:redo 1)))
    (check-equal? '("Undo" "Redo") (undo-test/edits:take-said!)))
  (let ([prompt (buffers:make " *prompt*" "abc\n")])
    (buffers:set-silent! prompt #f)
    (undo-test/edits:run-in prompt undo-test/edits:insert 1 "1")
    (undo-test/edits:run-in prompt undo:undo 1)
    (undo-test/edits:run-in prompt undo:redo 1)
    (check-equal? '() (undo-test/edits:take-said!))))

(test "forget! drops the history, so the present text is the root of a new one"
  (let ([b (buffers:make "unkept" "\n")])
    (undo-test/edits:run-in b undo-test/edits:insert 1 "a")
    (undo:forget! b)
    (check-equal? '((undo:undo "no further undo information")) (undo-test/edits:reports-during (lambda () (undo-test/edits:run-in b undo:undo 1))))
    (check-equal? "a\n" (undo-test/edits:text b))))
