; lib/'s shadowed replaces the installed plugin's, which is reported at
; start.
! import: (shadowed) in lib/ replaces $HOME/.local/share/tuna/plugins/shadowed/shadowed.sls
; Each module exports <prefix>:%scope, which eval-in-module uses.
> (import (scoped))
> (and (memq 'scoped:%scope (library-exports '(scoped))) #t)
#t
; eval-in-module sees a name a body import brings from a Chez module form,
; but not a variable that such a form assigns.
> (eval-in-module '(twice 4) '(scoped))
8
> (scoped:count)
1
> (eval-in-module 'n '(scoped))
! (scoped) attempt to reference assigned hence unexported library variable n
; A define of the module's own procedure redefines it, on its behalf, and
; is no change; a set! of it, or a define of a value, raises.
> (eval-in-module '(define (text) "assigned") '(scoped))
> (scoped:text)
"assigned"
> (eval-in-module '(set! text (lambda () "set")) '(scoped))
! (scoped) attempt to assign immutable variable text
> (scoped:text)
"assigned"
> (map car (definition-changes scoped:text))
(#<owner (scoped) 1>)
> (eval-in-module '(define fresh 1) '(scoped))
! eval-in-module: (scoped) has no procedure fresh to redefine; values and new names change by reloading
> (eval-in-module '(define text 5) '(scoped))
! eval-in-module: the new value of scoped:text is not a procedure; values change by reloading (scoped)
> (eval-in-module '(this-module) '(scoped))
(scoped)
> (eval-in-module '(text) '(greet))
! eval-in-module: not a loaded module with irritant (greet)
; A module cannot define %scope.
> (guard (c [(syntax-violation? c) (condition-message c)])
    (eval '(import (rescope))))
"multiple definitions for %scope in body"
