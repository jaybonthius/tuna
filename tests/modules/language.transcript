; lib/'s shadowed replaces the installed plugin's, which is reported at
; start.
! import: (shadowed) in lib/ replaces $HOME/.local/share/tuna/plugins/shadowed/shadowed.sls
; A module may define a name #!tuna provides; its own code means its own
; definition, and other code sees the prefixed name.
> (import (lists))
> (lists:twice '(1))
(mine)
> (list (lists:map car '(1)) (map - '(1)))
((mine) (-1))
> (lists:both '(1 2))
((mine) (-1 -2))
; A module cannot define a keyword its own code uses.
> (import (redefine))
! attempt to reference unbound identifier g at line 3, char 10 of $HOME/.config/tuna/lib/redefine.sls
; define-public and macros built on it export their names; Chez's
; definition forms export theirs when written at the top level, and a name
; a macro defines with them stays inside the module.
> (import (macros))
> (macros:greeting)
"hi"
> (set! macros:hello (lambda () "hi"))
> (list (macros:hello) (map car (definition-changes macros:hello)))
("hi" ((repl) (macros)))
> (macros:entry-key (macros:make-entry 'k))
k
> (list macros:low macros:high)
(1 9)
> (macros:origin)
(0 10)
> (macros:verbose)
#f
> macros:make-pt
! variable macros:make-pt is not bound
> macros:limit
! variable macros:limit is not bound
; Only define makes a changeable definition.
> (set! macros:low 2)
! attempt to assign immutable variable macros:low
> (set! macros:verbose 2)
! attempt to assign immutable variable macros:verbose
> (advice-add! macros:make-entry (lambda (make . arguments) (apply make arguments)))
! advice-add!: not a changeable definition macros:make-entry in (advice-add! macros:make-entry (lambda (make . arguments) (apply make arguments)))
> (import (nodefiner))
! no visible binding for define-property key definer at line 3, char 20 of $HOME/.config/tuna/lib/nodefiner.sls
; Definitions come before expressions; Chez reports the first definition
; after an expression as Tuna expands it, with no position, so the report
; names the file.
> (import (late))
! $HOME/.config/tuna/lib/late.sls: invalid context for definition (define-syntax f changeable-keyword)
; Compiled for an importer, the error still names the file that holds it.
> (import (useslate))
! $HOME/.config/tuna/lib/late.sls: invalid context for definition (define-syntax f changeable-keyword)
; Both languages withhold sleep, and #!tuna/base is a module language too.
> (import (sleeper))
! sleep: withheld because it would block the main thread (sleep (make-time (quote time-duration) 0 0)) at line 2, char 15 of $HOME/.config/tuna/lib/sleeper.sls
> (import (base-sleeper))
! sleep: withheld because it would block the main thread (sleep (make-time (quote time-duration) 0 0)) at line 2, char 15 of $HOME/.config/tuna/lib/base-sleeper.sls
; A module may define sleep and exit too.
> (import (shadows))
> (shadows:both)
((slept 1) stayed)
> (import (base))
> (base:name)
(base)
; #!tuna/base is #!tuna without the standard library.
> (import (base-option))
! attempt to reference unbound identifier define-option at line 2, char 2 of $HOME/.config/tuna/lib/base-option.sls
; A module's own set! assigns its definition, from any thread.
> (import (assign))
> (list (assign:bump!) (assign:bump!) assign:count)
(1 2 2)
> (let ([t (fork-thread assign:bump!)]) (thread-join t) assign:count)
3
> (module-changes '(repl))
((override macros:hello #f))
