; Every Tuna stylesheet declares the three layers first, so their order
; holds whichever file loads first; none uses !important, which would
; reverse it.
> (without-layer-order)
()
> (with-important)
()
; A design token a stylesheet reads is declared; any other custom
; property it reads has a fallback.
> (dangling-references)
()
; Without the token file the cursor, the region and the selected view's
; edge still show in system colours, since nothing else in their rules
; reads a token without a fallback. Only other cursors need the tokens.
> (map (lambda (r) (apply bare-tokens r))
       '(("views/views.css" ".cursor") ("views/views.css" ".cursor.primary")
         ("views/views.css" ".region :not(.cursor, .view-anchor, .view-place, .above-region, .above-region *)")
         ("views/views.css" ".view .line.region-line") ("views/views.css" ".view.nowrap .line.region-line")
         ("layout/layout.css" ".layout-view:not(.locked) > .view") ("layout/layout.css" ".layout-view.selected:not(.locked)")))
(("--tuna-text-muted") () () () () () ())
; So do the focus outline and a list's selected row, which ui draws; the
; row loses only its weight.
> (map (lambda (r) (apply bare-tokens r))
       '(("ui/ui.css" ":where(:focus-visible)") ("ui/ui.css" ".ui-list-row[aria-current=\"true\"]")))
(() ("--tuna-font-weight-semibold"))
