> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
; testing:request-quit! from another thread ends runaway REPL input, and the REPL
; goes on.
> (begin
    (fork-task (lambda (restore) (chez:sleep (make-time 'time-duration 200000000 0))
        (testing:request-quit!)))
    (void))
> (let loop () (loop))
! &cancelled
> (+ 1 2)
3
; So does a runaway macro.
> (begin
    (fork-task (lambda (restore) (chez:sleep (make-time 'time-duration 200000000 0))
        (testing:request-quit!)))
    (void))
> (let-syntax ([m (lambda (x) (let loop () (loop)))]) (m))
! &cancelled
> 'after
after
; &cancelled is serious, and a guard that catches every condition catches it.
> (guard (c [(cancelled? c) (list (serious-condition? c) (error? c))])
    (testing:request-quit!)
    (let loop () (loop)))
(#t #f)
> (guard (c [#t 'caught]) (testing:request-quit!) (let loop () (loop)))
caught
> (cancelled? (make-error))
#f
; The first request can be handled and continued.
> (define quits 0)
> (with-exception-handler
    (lambda (c) (if (cancelled? c) (set! quits (+ quits 1)) (raise c)))
    (lambda ()
      (testing:request-quit!)
      (let loop () (if (= quits 0) (loop) 'continued))))
continued
; A second request before the first is handled cannot be continued.
> (with-exception-handler
    (lambda (c)
      (if (cancelled? c)
          (begin (testing:request-quit!) (let loop () (loop)))
          (raise c)))
    (lambda () (testing:request-quit!) (let loop () (loop))))
! &cancelled
; A quit ends a posted thunk too, and a module body, which is then unloaded.
> (spawn-task (lambda (restore) (testing:request-quit!) (let loop () (loop))))
#<task>
! &cancelled
> (import (runaway))
! (runaway) &cancelled
> (module-owner '(runaway))
#f
