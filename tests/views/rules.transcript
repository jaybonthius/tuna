; Only the main thread uses views.
> (define from-thread #f)
> (begin
    (fork-thread
      (lambda ()
        (guard (c [#t (set! from-thread (list (condition-who c) (condition-message c)))])
          (views:set-point! v 1))))
    (let loop () (unless from-thread (sleep-for 0.01) (loop)))
    from-thread)
(views:set-point! "not on the main thread")
