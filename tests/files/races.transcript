; files:after-rename and files:after-save are called as the job reports
; its work, in a task other than the caller's, so an entry that pauses
; finishes after the call that renamed or saved has returned.
> (disk-checks:write-text! "~/order-a.txt" "a\n")
> (disk-checks:write-text! "~/order-other.txt" "o\n")
> (define order '())
> (define (pausing from to)
    (set! order (cons 'entry-starts order))
    (files:visit "~/order-other.txt")
    (set! order (cons 'entry-ends order)))
> (add-hook! files:after-rename pausing)
> (begin (files:rename-file "~/order-a.txt" "~/order-c.txt") (set! order (cons 'rename-returned order)))
> (wait-until (lambda () (memq 'entry-ends order)))
> (reverse order)
(entry-starts rename-returned entry-ends)
> (remove-hook! files:after-rename pausing)
