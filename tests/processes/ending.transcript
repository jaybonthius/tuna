; processes:stop! sends SIGHUP to the program's group; afterwards
; on-output is not called again, and on-exit runs when the program ends.
> (define ticker (processes:start "sh" '("-c" "while :; do echo tick; sleep 0.05; done")
                   noting-output noting-exit))
> (testing:wait-until (lambda () (pair? log)))
> (processes:stop! ticker)
> (testing:wait-until exited?)
> (let ([l (taken!)]) (list (for-all (lambda (x) (string? (car x))) (list-head l (- (length l) 1))) (car (reverse l))))
(#t (exit -1))
> (processes:stop! ticker)
; A program that ignores SIGHUP gets SIGKILL a second later.
> (define stubborn (processes:start "sh" '("-c" "trap '' HUP; echo ready; sleep 5") noting-output noting-exit))
> (testing:wait-until (lambda () (pair? log)))
> (define stopped-at (current-time))
> (processes:stop! stubborn)
> (testing:wait-until exited?)
> (car (reverse (taken!)))
(exit -9)
> (>= (time-second (time-difference (current-time) stopped-at)) 1)
#t
; On a terminal, stopping closes the terminal, so the kernel hangs up the
; job in the foreground, which a signal to the shell's group misses.
> (define job-shell (processes:start "sh" '("-c" "set -m; sleep 30") noting-output noting-exit
                      (processes:options [terminal '(24 . 80)])))
> (testing:wait-until (lambda () (let ([group (processes:foreground-group job-shell)])
                           (and group (not (= group (processes:pid job-shell)))))))
> (define job (processes:foreground-group job-shell))
> (processes:stop! job-shell)
> (testing:wait-until exited?)
> (taken!)
((exit -1))
> (testing:wait-until (lambda () (not (file-exists? (format "/proc/~a" job)))))
> (file-exists? (format "/proc/~a" job))
#f
; processes:signal! sends a signal by its name to the program's group.
> (define sleeper (processes:start "sleep" '("5") noting-output noting-exit))
> (processes:signal! sleeper (processes:signal int))
> (testing:wait-until exited?)
> (taken!)
((eof 0) (exit -2))
> (processes:signal! sleeper (processes:signal term))
> (processes:signal! sleeper 'bogus)
! processes:signal!: not a processes:signal name with irritant bogus
> (processes:signal! sleeper "term")
! processes:signal!: not a processes:signal name with irritant "term"
> (processes:signal bogus)
! universe of signal does not include specified symbol bogus
> (processes:signal hup)
hup
; A process still starting gets the signal once started.
> (let ([p (processes:start "sleep" '("5") noting-output noting-exit)])
    (processes:signal! p (processes:signal term)))
> (testing:wait-until exited?)
> (taken!)
((eof 0) (exit -15))
; Killing a process's buffer stops it, without asking.
> (define shell-buffer (buffers:make "*shell*" ""))
> (define linked (processes:start-for-user "sleep" '("5")))
> (processes:attach! linked 0 noting-output noting-exit)
0
> (processes:set-buffer! linked shell-buffer)
> (eq? (processes:buffer linked) shell-buffer)
#t
> (buffers:kill! shell-buffer)
#t
> (testing:wait-until exited?)
> (taken!)
((exit -1))
> (processes:buffer linked)
#f
> (define unlinked (processes:start "sleep" '("0.1") noting-output noting-exit))
> (define other-buffer (buffers:make "*other*" ""))
> (processes:set-buffer! unlinked other-buffer)
> (processes:set-buffer! unlinked #f)
> (buffers:kill! other-buffer)
#t
> (testing:wait-until exited?)
> (taken!)
((eof 0) (exit 0))
> (processes:set-buffer! unlinked "*other*")
! processes:set-buffer!: not a buffer or #f with irritant "*other*"
; While processes is off, killing a process's buffer does not stop the
; process. When processes loads again, the process runs on, its buffer
; no longer live.
> (define orphan-buffer (buffers:make "*orphan*" ""))
> (define orphan (processes:start-for-user "sleep" '("30")))
> (processes:set-buffer! orphan orphan-buffer)
> (unload-module! '(processes))
> (buffers:kill! orphan-buffer)
#t
> (load-module! '(processes))
> (sleep-for 0.2)
> (list (processes:status orphan) (processes:buffer orphan) (and (memq orphan (processes:all)) #t))
(#f #f #t)
> (processes:stop! orphan)
