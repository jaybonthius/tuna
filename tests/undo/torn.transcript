; A crash can cut the log at any byte, or leave zeros after it. Reading
; keeps exactly the records written whole.
> (import (undo log) (tuna eval))
> (define (reload! name) (eval-file (string-append (getenv "TUNA_LIBRARY") "/" name ".sls")))
> (define (logged path n)
    (wait-until (lambda () (= (length (checks:log-records path)) n)))
    (length (checks:log-records path)))
> (checks:write-text! "~/t.txt" "start\n")
> (define t (files:visit "~/t.txt"))
> (define (in-t command . args) (buffers:with-buffer t (apply commands:run command args)))
> (for-each (lambda (s) (in-t checks:type s)) '("q\"uo" "te\\" "λ ü"))
#<edit 3>
> (in-t checks:type "!")
#<edit 4>
> (in-t checks:insert 1 "a\nb\x0;")
#<edit 5>
> (in-t undo:undo 1)
> (in-t checks:delete 1 3)
#<edit 7>
> (files:save-buffer t)
> (in-t checks:insert 2 "\t")
#<edit 8>
> (in-t undo:undo 2)
> (in-t undo:redo 1)
> (logged "~/t.txt" 12)
12
> (map car (checks:log-records "~/t.txt"))
(undo-history group saved at more group at group saved group at at)
> (define log-file (checks:log-of "~/t.txt"))
> (define all (call-with-port (open-file-input-port log-file) get-bytevector-all))
> (define ends
    (let loop ([i 0] [acc '()])
      (cond
        [(= i (bytevector-length all)) (reverse acc)]
        [(= (bytevector-u8-ref all i) 10) (loop (+ i 1) (cons i acc))]
        [else (loop (+ i 1) acc)])))
> (define cut (string-append log-file ".cut"))
> (define (records-at n tail)
    (call-with-port (open-file-output-port cut (file-options no-fail))
      (lambda (p) (put-bytevector p all 0 n) (put-bytevector p tail)))
    (let-values ([(records torn?) (read-log cut)]) (length records)))
> (define (whole n) (length (filter (lambda (e) (<= e n)) ends)))
> (define zeros (make-bytevector 4096 0))
> (let loop ([n 0] [bad '()])
    (if (> n (bytevector-length all))
        (list (bytevector-length all) (reverse bad))
        (loop (+ n 1)
              (if (and (= (records-at n #vu8()) (whole n)) (= (records-at n zeros) (whole n)))
                  bad
                  (cons n bad)))))
(340 ())
> (let-values ([(records torn?) (read-log log-file)]) (list (length records) torn?))
(12 #f)
> (let-values ([(records torn?) (read-log cut)]) torn?)
#t
; The buffer goes with an unsaved edit whose record a crash cut short;
; the next visit attaches what the whole records hold and writes the log
; again whole.
> (define before (list (text t) (tree t)))
> (in-t checks:insert 1 "lost")
#<edit 12>
> (logged "~/t.txt" 13)
13
> (define size (bytevector-length (call-with-port (open-file-input-port log-file) get-bytevector-all)))
> (call-with-port (open-file-output-port log-file (file-options no-fail no-truncate))
    (lambda (p) (truncate-port p (- size 3))))
> (reload! "buffers")
> (wait-until (lambda () (= (length (files:buffers)) 1)))
> (define t (files:visit "~/t.txt"))
> (list (text t) (files:modified? t) (equal? (list (text t) (tree t)) before))
