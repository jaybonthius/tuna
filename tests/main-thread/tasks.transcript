> (list (task? configuration-task) (eq? (task-state configuration-task) 'done) answer)
(#t #t 42)
> (define (yes-or-no? question)
    (suspend (lambda (resume) (prompts:ask question resume))))
; A paused task lets the REPL go on, and another thread may resume it.
> (define asking (spawn-task (lambda (restore) (yes-or-no? "Quit?"))))
> (eq? (task-state asking) 'done)
#f
> (define helper (fork-task (lambda (restore) (prompts:answer! 'yes))))
> (let ([v (testing:join asking)]) (list (eq? (task-state asking) 'done) v))
(#t yes)
; REPL input runs as a task.
> (task? (current-task))
#t
> (list (task? 'asking) (eq? (current-task) asking))
(#f #f)
; A task that raises is reported, and join-task raises the same condition.
> (define failing (spawn-task (lambda (restore) (error 'nap "woke badly"))))
! nap: woke badly
> (testing:join failing)
! nap: woke badly
> (testing:join (current-task))
! join-task: a task cannot wait for itself with irritant #<task>
; cancel-task raises in a paused task at once, in a running one where it
; next lands, and ends a queued one at its start.
> (define waiting (spawn-task (lambda (restore) (suspend (lambda (resume) (void))))))
> (cancel-task waiting 'stop)
! &cancelled
> (guard (c [#t c]) (testing:join waiting))
#<condition &cancelled>
> (let ([t (spawn-task (lambda (restore) (guard (c [#t (list 'caught c)])
                 (suspend (lambda (resume) (resume void))))))])
    (cancel-task t 'early)
    (testing:join t))
! &cancelled
; A task starts after the code already waiting on the main thread.
> (begin
    (spawn-task (lambda (restore) (display "posted ")))
    (spawn-task (lambda (restore) (display "spawned") (newline)))
    (void))
posted spawned
; A task is resumed once, from any thread; suspend returns the value of
; the thunk it is resumed with, computed in the task.
> (define p (make-thread-parameter 'outside))
> (define log '())
> (define saved #f)
> (define kept
    (spawn-task (lambda (restore) (parameterize ([p 'inside])
          (dynamic-wind
            (lambda () (set! log (cons 'in log)))
            (lambda () (suspend (lambda (resume) (set! saved resume))))
            (lambda () (set! log (cons 'out log))))))))
> log
(out in)
> (join-task (fork-task (lambda (restore) (saved p))))
returned
(#<void>)
> (testing:join kept)
inside
> log
(out in out in)
> (saved (lambda () 2))
! resume: the task was resumed already
; A thread's task pauses too; a module's body cannot.
> (define (on-thread thunk)
    (let ([result #f])
      (join-task (fork-task (lambda (restore) (set! result (guard (c [#t (condition-message c)]) (thunk))))))
      result))
> (on-thread (lambda () (suspend (lambda (resume) (resume void)))))
> (import (pauser))
! (pauser) suspend: the body of module (pauser) is running
; A thread's task may spawn a task, which runs on the main thread.
> (on-thread (lambda () (spawn-task (lambda (restore) (void)))))
#<task>
; Another thread's cancel is delivered on the main thread.
> (define signalled (spawn-task (lambda (restore) (suspend (lambda (resume) (void))))))
> (join-task (fork-task (lambda (restore) (cancel-task signalled 'from-thread))))
! &cancelled
returned
(#<void>)
> (guard (c [#t c]) (testing:join signalled))
#<condition &cancelled>
; Unloading a module stops its paused tasks, past their handlers; a task
; it spawned before the unload was asked for runs before it begins.
> (import (waiter))
> (begin
    (call-as-owner (module-owner '(waiter)) (lambda () (waiter:wait-forever)))
    (void))
> (map car (owner-changes (module-owner '(waiter))))
(define define define)
> (begin
    (call-as-owner (module-owner '(waiter)) (lambda () (spawn-task (lambda (restore) (guard (c [(cancelled? c) (display "waiter's posted task quit") (newline)])
                 (suspend (lambda (resume) (void))))))))
    (void))
> (begin
    (call-as-owner (module-owner '(waiter)) (lambda () (waiter:later)))
    (unload-owner! (module-owner '(waiter))))
never runs
