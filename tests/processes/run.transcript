"cannot run pwd: No such file or directory"
> (processes:run "true" '() #f (processes:options [terminal '(24 . 80)]))
! processes:run: a program run to its end has no terminal with irritant #<processes:options>
; A program that cannot start raises in the task.
> (guard (c [#t (condition-message c)]) (processes:run "no-such-program" '()))
"cannot run no-such-program: No such file or directory"
; It is the caller's own process while it runs, and a quit or raise that
; ends the task stops it.
> (define running (spawn-task (lambda () (processes:run "sleep" '("10")))))
> (wait-until (lambda () (pair? (processes:all))))
> (define sleeper (car (processes:all)))
> (list (processes:owner sleeper) (processes:command-line sleeper))
((repl) ("sleep" "10"))
> (signal-task running 'stop)
! non-condition value stop
> (wait-until (lambda () (processes:status sleeper)))
> (processes:status sleeper)
-1
> (wait-until (lambda () (null? (processes:all))))
> (processes:all)
()
; Arguments are checked.
> (processes:run "cat" '() 'input)
! processes:run: not a string or bytevector with irritant input
> (processes:run 'cat '())
! processes:run: not a string free of NUL characters with irritant cat
