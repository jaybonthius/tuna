> (layout:switch-to-buffer b)
> (set-option! ask:yes-or-no-reader (answer #t))
> (goto "a.txt")
> (press! "D")
> (settle)
> (list (questions) (message) (exists? "ops/a.txt") (listing-lines b))
(("Delete a.txt? ") "Deleted 1 file" #f ("  ." "  .." "  b.txt" "  c.txt" "  empty" "  full"))
; Several marked entries are named in  *Deletions* while it asks, which
; goes when answered; a folder that holds files is asked about, as
; folder-listing:recursive-deletes is top.
> (define shown-while-asking #f)
> (set-option! folder-listing:deletion-confirmer
    (lambda (q)
      (set! shown-while-asking
        (let ([d (buffers:find " *Deletions*")])
          (and d (document:text (buffers:document d)) (pair? (views:showing d)))))
      ((answer #t) q)))
> (goto "b.txt")
> (press! "m" "m" "m" "m")
> (press! "D")
> (settle)
> (list (questions) shown-while-asking (buffers:find " *Deletions*") (message) (listing-lines b))
(("Delete * [4 files]? " "Recursively delete full? ") #t #f "Deleted 4 files" ("  ." "  .."))
