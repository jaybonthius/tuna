; After Pi's edit or write tool ends, an unmodified buffer visiting the
; file is reverted; a modified one is left as it is, with a notice.
> (define (writing? chat)
    (let ([last (car (last-pair (drawn chat)))])
      (and (eq? (car last) 'reply)
           (exists (lambda (p) (and (pair? p) (eq? (car p) 'tool-call) (member '(state . called) (cdr p)))) (cdr last)))))
> (define (pi-writes! id path)
    (let ([call (tool-block id "write" `(("path" . ,path) ("content" . "x")))])
      (say! f (event "message_start" (cons "message" (assistant-message "pending")))
              (update `(("type" . "toolcall_start") ("contentIndex" . 0) ("id" . ,id) ("toolName" . "write"))))
      (wait-until (lambda () (writing? chat)))
      (say! f (update `(("type" . "toolcall_end") ("contentIndex" . 0) ("toolCall" . ,call)))
              (event "message_end" (cons "message" (assistant-message "toolUse" call)))
              (event "tool_execution_start" (cons "toolCallId" id) '("toolName" . "write") (cons "args" `(("path" . ,path))))
              (event "tool_execution_end" (cons "toolCallId" id) '("toolName" . "write") '("isError" . #f)
                     '("result" . (("content" . #((("type" . "text") ("text" . "Wrote"))))))))))
