; C-g in a failing search goes back to the last state that matched; in
; a successful one it cancels, putting point back where it started.
> (define b (show "k" "foo bar foo baz\n"))
> (press! "C-s" "f" "o" "o" "x" "y")
> (here)
> (press! "C-g")
> (here)
> (press! "C-g")
> (here)
(4 "Failing I-search: foo{xy}" "foo")
(4 "I-search: foo" "foo")
! &quit
(1 #f #f)
; ESC cancels at once.
> (press! "C-s" "b" "a")
> (here)
> (press! "ESC")
> (here)
(7 "I-search: ba" "ba")
! &quit
(1 #f #f)
; A key isearch:keymap does not bind ends the search at the match and
; then runs; a key the user binds there keeps the search.
> (press! "C-s" "b" "a" "z" "C-f")
> (here)
> (views:set-point! (view) 1)
> (keys:bind! isearch:keymap "C-v" editing:forward-char)
> (press! "C-s" "f" "o" "C-v")
> (here)
> (press! "o")
> (here)
> (press! "RET")
(17 #f #f)
(4 "I-search: fo" "fo")
(4 "I-search: foo" "foo")
; A key that ends the search, typed in the same batch as a search key,
; runs at the new match.
> (views:set-point! (view) 1)
> (press! "C-s" "b" "a" "r" "C-f")
> (list (point) (keys:prompt client))
(9 #f)
; Adding to a failing literal search reads no text: the added part shows
; in isearch.fail and DEL takes it back.
> (views:set-point! (view) 1)
> (define finds 0)
> (define (count-find find . args) (set! finds (+ finds 1)) (apply find args))
> (advice-add! search:find count-find)
> (press! "C-s" "q")
> (here)
> (set! finds 0)
> (press! "x" "y")
> (list finds (here))
> (press! "DEL" "DEL")
> (here)
> (press! "C-g" "C-g")
(1 "Failing I-search: {q}" #f)
(0 (1 "Failing I-search: {qxy}" #f))
(1 "Failing I-search: {q}" #f)
! &quit
; A failing word search the same.
> (press! "M-s" "w" "q" "x")
> (list finds (here))
> (press! "C-g" "C-g")
(1 (1 "Failing word I-search: {qx}" #f))
! &quit
; A regexp searches again at each key: (foo is unfinished until ) closes it.
> (set! finds 0)
> (press! "C-M-s" "(" "f" "o")
> (here)
> (press! ")")
> (list finds (here))
> (press! "RET")
> (advice-remove! search:find count-find)
(1 "Failing regexp I-search: {(fo} [incomplete input]" #f)
(4 (3 "Regexp I-search: (fo)" "fo"))
; M-p and M-n step through past searches without searching; the next key
; searches.
> (define r (show "r" "foo bar baz\n"))
> (press! "C-s" "b" "a" "r" "RET" "C-s" "b" "a" "z" "RET")
> (views:set-point! (view) 1)
> (press! "C-s" "M-p")
> (here)
> (press! "M-p")
> (here)
> (press! "C-s")
> (here)
> (press! "M-n")
> (here)
> (press! "M-n")
> (here)
> (press! "RET")
(1 "I-search: baz" #f)
(1 "I-search: bar" #f)
(8 "I-search: bar" "bar")
(8 "I-search: baz" "bar")
(8 "I-search: foo" "bar")
; C-q adds the next key's character; a paste adds its text.
> (define q (show "q" "a\tb c\n"))
> (press! "C-s")
> (start! "C-q")
> (press! "TAB")
> (here)
> (keys:run-as-input client editing:paste "b c")
> (here)
> (press! "RET")
(3 "I-search: \t" "\t")
(6 "I-search: \tb c" "\tb c")
