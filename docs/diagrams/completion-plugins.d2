# Which plugin does what when you complete something?
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: down

classes: {
  user: {
    style: {
      fill: "#fff8e1"
      stroke: "#8d6e00"
      font-color: "#3e2f00"
      border-radius: 8
      font-size: 18
    }
  }
  part: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 18
    }
  }
  core: {
    style: {
      fill: "#e8f5e9"
      stroke: "#2e7d32"
      font-color: "#1b3d1f"
      border-radius: 8
      font-size: 18
    }
  }
}

legend: |md
  **Status:** built; the file picker and buffer switching are planned.

  Yellow: features that ask a question.

  Green: the completion plugin.

  Blue: other plugins it works with.
|

picker: "Project file picker,\nbuffer switching (planned)" {class: user}
completion: "Completion plugin" {
  class: core
  engine: "Engine\ncandidates, categories, history,\nthe running session" {class: core}
  mx: "M-x" {class: user}
  matcher: "Matching styles\nsubstring, any order\n(like Orderless)" {class: core}
  notes: "Command annotations\n(like Marginalia)" {class: core}
}
ui: "Completion list\n(like Vertico)" {class: part}
minibuffer: "Minibuffer\n(where you type)" {class: part}
commands: "Commands\n(every command, its\ndoc and its keys)" {class: part}

completion.mx -> completion.engine: "choose a command"
picker -> completion.engine: "choose a file"
completion.engine -> completion.matcher: "which candidates match?"
completion.engine -> completion.notes: "what to show beside each?"
completion.engine -> ui: "show the session"
completion.engine -> minibuffer: "ask in a prompt"
completion.mx -> commands: "list and run commands"
completion.notes -> commands: "doc and key binding"
