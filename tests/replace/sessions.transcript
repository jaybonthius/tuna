; A match the buffer refuses to edit ends the session with the refusal's
; message, or with replace:skip-read-only on is passed over and counted.
> (define b (show "ro" "x1 x2 x3\n"))
> (buffers:define-layer locked (read-only) (sticky before))
> (buffers:add-span! (buffers:layer b locked) 4 6 'locked)
> (replace! "M-%" "x" "y")
> (press! "y" "y")
> (list (session) (text) (last-message))
(#f "y1 x2 x3\n" "a read-only span refuses the edit")
> (views:set-point! (view) 1)
> (set-option! replace:skip-read-only #t)
> (replace! "M-%" "x" "y")
> (press! "!")
> (list (session) (text) (last-message))
(#f "y1 x2 y3\n" "Replaced 1 occurrence (skipped 1)")
> (set-option! replace:skip-read-only #f)
; A match touching an atom's text is passed over and counted.
> (buffers:define-kind chip (content atom) (text (lambda (n) "foo")))
> (define a (buffers:make "atoms" '(buffers:text () "foo " #(chip ()) " foo\n")))
> (layout:switch-to-buffer a)
> (views:set-point! (view) 1)
> (replace! "M-%" "foo" "bar")
> (press! "!")
> (list (text) (last-message))
("bar foo bar\n" "Replaced 2 occurrences (skipped 1)")
; C-r pauses the session so keys edit as usual; C-M-c goes on from the
; current match. C-w deletes the match first.
> (define p (show "p" "x1 x2 x3\n"))
> (replace! "M-%" "x" "y")
> (press! "C-r")
> (keys:prompt client)
"Editing; C-M-c goes on with the replace"
> (press! "C-e" "Z")
> (text)
"x1 x2 x3Z\n"
> (press! "C-M-c")
> (asked)
(2 "Query replacing x with y: (? for help) " "x")
> (press! "C-w")
> (text)
"1 x2 x3Z\n"
> (press! "Q" "C-M-c")
> (asked)
(5 "Query replacing x with y: (? for help) " "x")
> (press! "!")
> (list (text) (session))
("Q1 y2 y3Z\n" #f)
; A session is a record with hooks; advice on replace:prompt shows a
; count.
> (define events '())
> (add-hook! replace:started (lambda (s) (set! events (cons (list 'started (replace:session-count s)) events))))
> (add-hook! replace:ended (lambda (s n) (set! events (cons (list 'ended n (keys:prompt client)) events))))
> (define (with-count prompt s)
    (let* ([scan (replace:session-scan s)] [m (replace:session-match s)]
           [index (and m (search:scan-index scan (search:match-start m)))])
      (if (and index (search:scan-done? scan))
          (cons (format "[~a/~a] " (+ index 1) (search:scan-count scan)) (prompt s))
          (prompt s))))
> (advice-add! replace:prompt with-count)
> (define r (show "rec" "o1 o2 o3\n"))
> (replace! "M-%" "o" "0")
> (sleep-for 0.2)
> (press! "n")
> (prompt)
"[2/3] Query replacing o with 0: (? for help) "
> (let ([s (session)]) (list (eq? (replace:session-view s) (view)) (eq? (replace:session-client s) client) (replace:session-replacement s) (search:query-text (replace:session-query s))))
(#t #t "0" "o")
> (press! "y" "q")
> (reverse events)
((started 0) (ended 1 #f))
> (advice-remove! replace:prompt with-count)
; replace:query-replace! answers from the given client's keys, pauses the
; calling task until the session ends, and returns the count. A
; procedure replacement gets each match and the count so far.
> (define q (show "code" "k k k\n"))
> (define result #f)
> (spawn-task (lambda () (set! result (replace:query-replace! (view) other (search:make-query "k") (lambda (m n) (number->string n)) 1 6 'forward))))
#<task>
> (sleep-for 0.05)
> (list (replace:current client) (replace:session? (replace:current other)))
(#f #t)
> (press-in! other "y" "y" "q")
> (sleep-for 0.05)
> (list result (text))
(2 "0 1 k\n")
> (spawn-task (lambda () (replace:query-replace! (view) other (search:make-query "k") "z" 1 6 'forward)))
#<task>
> (sleep-for 0.05)
> (replace:query-replace! (view) other (search:make-query "k") "z" 1 6 'forward)
! replace:query-replace!: a replace session is already running for this client
> (spawn-task (lambda () (guard (c [#t (set! result (condition-message c))]) (replace:query-replace! (view) other (search:make-query "k") "z" 1 6 'forward))))
#<task>
> (sleep-for 0.05)
> result
"a replace session is already running for this client"
> (press-in! other "q")
; ! is one command, so its replacements are one undo group.
> (define g (show "g" "a a a a\n"))
> (replace! "M-%" "a" "b")
> (press! "y" "!")
> (text)
"b b b b\n"
> (press! "C-/")
> (text)
"b a a a\n"
> (press! "C-/")
> (text)
"a a a a\n"
; A session that ends away from where it started records that place, and
; M-, returns there. A quit leaves point at the current match, as in
; Emacs, so it records the start too; a session with no match records
; nothing.
> (define j (show "j" "w1 w2 w3\n"))
> (define before (length (jump-history:places)))
> (replace! "M-%" "q" "v")
> (= before (length (jump-history:places)))
#t
> (replace! "M-%" "w" "v")
> (press! "C-g")
! &quit
> (list (point) (= (+ before 1) (length (jump-history:places))))
(2 #t)
> (views:set-point! (view) 1)
> (replace! "M-%" "w" "v")
> (press! "n" "y" "q")
> (list (point) (car (jump-history:places)))
(8 (#<buffer j> . 1))
> (press! "M-,")
> (point)
1
; M-% during a search replaces with the search's query from the start of
; its current match; C-M-% takes its text as a regexp.
> (define is (show "is" "Ab ab AB a.b\n"))
> (press! "C-s" "a" "b" "C-s")
> (start! "M-%")
> (type! "X")
> (press! "RET")
> (sleep-for 0.05)
> (list (isearch:current client) (asked))
(#f (6 "Query replacing ab with X: (? for help) " "ab"))
> (press! "!")
> (text)
"Ab X X a.b\n"
> (define is2 (show "is2" "a.b axb\n"))
> (press! "C-s" "a" "." "b")
> (start! "C-M-%")
> (type! "Y")
> (press! "RET")
> (sleep-for 0.05)
> (press! "!")
> (text)
"Y Y\n"
; replace:replace-string replaces without asking.
> (define rs (show "rs" "one one\n"))
> (views:call-with-view (view) (lambda () (replace:replace-string "one" "two")))
> (list (text) (last-message))
("two two\n" "Replaced 2 occurrences")
; The prompt holds the query and the replacement as typed; the echo area
; draws their control characters as ^X.
> (define tabbed (show "tabbed" "a\tb\n"))
> (spawn-task (lambda () (replace:query-replace! (view) client (search:make-query "a\tb") "c\td" 1 5 'forward)))
#<task>
> (sleep-for 0.05)
> (keys:prompt client)
("Query replacing a\tb with c\td: (? for help) ")
> (prompt)
"Query replacing a^Ib with c^Id: (? for help) "
> (press! "q")
