(depth-1 depth-2 depth-2 depth-2 depth-3 depth-3 depth-2 depth-1)
; Turning the mode off in a buffer stops its bracket spans, so a view's
; own value cannot turn the colours on there.
> (buffers:with-buffer b (set-option-local! rainbow-delimiters:mode #f))
> (syntax:brackets-used? b)
#f
> (brackets b)
()
> (bracket-faces v)
()
> (buffers:with-buffer b (set-option-local! rainbow-delimiters:mode #t))
> (bracket-faces v)
(depth-1 depth-2 depth-2 depth-2 depth-3 depth-3 depth-2 depth-1)
; A mode with a lexer and no highlighting job gets no bracket spans, so
; no colours.
> (define-table data-keymap "Keys.")
> (define-hook data-hook "Setup.")
> (modes:define-major-mode data-mode (keymap data-keymap) (hook data-hook))
> (table-set! syntax:lexers data-mode chez-scheme:lexer)
> (define data (buffers:make "data" "(a (b))"))
> (modes:set-major-mode data-mode data)
> (buffers:with-buffer data (set-option-local! rainbow-delimiters:mode #t))
> (syntax:brackets-used? data)
#t
> (brackets data)
()
