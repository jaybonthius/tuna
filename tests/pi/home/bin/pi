#!/bin/sh
case " $* " in
  *" --version "*) echo "${PI_FAKE_VERSION:-1.5.0}"; exit 0 ;;
esac
dir=$PI_FAKE/$$
mkdir -p "$dir"
for argument in "$@"; do printf '%s\n' "$argument"; done > "$dir/args"
pwd > "$dir/cwd"
: > "$dir/out"
: > "$dir/in"
# An asynchronous list reads /dev/null unless given standard input.
exec 3<&0
(while IFS= read -r line <&3; do printf '%s\n' "$line" >> "$dir/in"; done; : > "$dir/eof") &
tail -n +1 -f "$dir/out" &
tailer=$!
# The test's folder goes when its run ends, which ends a fake that Tuna
# left running.
until [ -e "$dir/eof" ] || [ -e "$dir/exit" ] || [ ! -d "$dir" ]; do sleep 0.02; done
sleep 0.2
kill $tailer 2>/dev/null
if [ -e "$dir/exit" ]; then
  [ -e "$dir/stderr" ] && cat "$dir/stderr" >&2
  exit "$(cat "$dir/exit")"
fi
