> (define asked '())
> (set-option! ask:y-or-n-reader (lambda (question) (set! asked (cons question asked)) #f))
> (commands:define-command (kill-chat) "Kills the chat's buffer." (buffers:kill! b))
> (commands:run kill-chat)
#t
> (list asked (buffers:live? b))
(() #f)
; The draft is the session's, so it outlives the chat: another chat's
; prompt edits leave it.
> (define other (pi:start (getenv "HOME")))
> (wait-until (lambda () (eq? (pi:chat-activity other) 'idle)))
> (in-client (lambda () (pi-chat:show! other)))
> (type! "x")
> (sleep-for 0.1)
> (map cdr (pi-chat:drafts))
("x" "unsent")
; The prompt keeps its text when its chat moves to another session, so
; the draft moves with it, and the session left keeps no copy to show
; once the text is sent or deleted.
> (define other-id (pi:chat-session-id other))
> (fake-state-set! (fake-of other) '(("sessionId" . "s-new")))
> (result (start! (lambda () (pi:new-session! other))))
> (wait-until (lambda () (equal? (pi:chat-session-id other) "s-new")))
> (sleep-for 0.1)
> (list (shown other) (assoc other-id (pi-chat:drafts)) (assoc "s-new" (pi-chat:drafts)))
("x\n" #f ("s-new" . "x"))
> (in-client (lambda () (pi-chat:set-prompt! other "")))
> (sleep-for 0.1)
> (map cdr (pi-chat:drafts))
("unsent")
