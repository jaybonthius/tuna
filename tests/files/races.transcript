; Visits of one file at once make one buffer; files of one name visited
; at once get names of their own.
> (disk-checks:write-text! "~/one.txt" "one\n")
> (define visitors (map (lambda (i) (spawn-task (lambda () (files:visit "~/one.txt")))) (iota 5)))
> (define visited (map join-task visitors))
> (list (for-all (lambda (b) (eq? b (car visited))) visited) (length (files:buffers)))
(#t 1)
> (for-each disk-checks:folder! '("~/p" "~/q"))
