; A browser is a device, told apart by a cookie the page sets when its
; request has none; a page whose request carries it, as a reload's does,
; gives its client that device.
> (define devices '())
> (add-hook! web:client-added (lambda (client) (set! devices (cons (web:client-device client) devices))))
