; A program that floods output: the plugin applies it in slices of at
; most 8 KB and copies the rows that leave the screen into the
; scrollback after each slice, so none is lost, and the scrollback keeps
; terminal:scrollback-lines lines.
> (define t (shell!))
> (terminal:send! t "seq 1 300000; echo done\r")
> (wait-for t "\n300000\ndone\n$ ")
> (define all (lines (text t)))
> (length all)
10024
> (define numbers (map string->number (list-head all 10021)))
> (list (car numbers) (list-ref numbers 10020))
(289979 299999)
> (let loop ([ns numbers]) (or (null? (cdr ns)) (and (= (+ (car ns) 1) (cadr ns)) (loop (cdr ns)))))
#t
; While a program floods, keys still reach it: C-c stops yes.
> (in-client (lambda () (layout:switch-to-buffer t)))
> (terminal:send! t "yes flood\r")
> (wait-for t "flood\nflood\nflood\n")
> (press! "C-c" "C-c")
> (testing:wait-until (lambda () (equal? (car (reverse (screen-lines t))) "$ ")))
> (length (lines (text t)))
10024
; Rows the program wrapped join into one line in the scrollback.
> (terminal:send! t "printf 'w%.0s' $(seq 1 200); echo; seq 1 30\r")
> (wait-for t "\n30\n$ ")
> (map string-length (filter (lambda (l) (and (> (string-length l) 0) (char=? (string-ref l 0) #\w))) (lines (text t))))
(200)
