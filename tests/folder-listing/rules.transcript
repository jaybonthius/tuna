; A listing is named after its folder's path, with ~ for the home folder
; and a final /, lists . and .. first, then the names by name with case
; folded, and is in folder-listing:mode, lighter Folder.
> (touch! "src/b.txt" "bee\n")
> (touch! "src/A.txt" "a\n")
> (touch! "src/.hidden" "")
> (folder! "src/sub")
> (touch! "src/sub/inner.txt" "in\n")
> (define b (folder-listing:visit (at "src")))
> (list (buffers:name b) (folder-listing:folder b) (modes:major-mode b) (modes:lighter folder-listing:mode))
("~/src/" "$HOME/src/" folder-listing:mode "Folder")
> (listing-lines b)
("  ." "  .." "  .hidden" "  A.txt" "  b.txt" "  sub")
; Visiting again returns the same listing, through files:visit too, so
; C-x C-f on a folder opens its listing; two names for one folder find
; one listing.
> (eq? b (folder-listing:visit (string-append (at "src") "/sub/..")))
#t
> (eq? b (files:visit (at "src")))
#t
; Point starts on the first entry after . and ..; n and p move by
; entries, and so does every key bound to next-line.
> (layout:switch-to-buffer b)
> (folder-listing:open (at "src"))
> (point-name)
".hidden"
> (press! "n" "n")
> (point-name)
"b.txt"
> (press! "C-n" "p" "p" "p")
> (point-name)
".hidden"
> (press! "p" "p" "p")
! folder-listing:previous-line: beginning of buffer
> (point-name)
"."
; Marks are edits: m marks and moves on, undo takes a mark back, and the
; listing is then modified. . and .. are never marked.
> (press! "m" "m" "m")
> (listing-lines b)
("  ." "  .." "* .hidden" "  A.txt" "  b.txt" "  sub")
> (point-name)
"A.txt"
> (buffers:modified? b)
#t
> (press! "C-/")
> (listing-lines b)
("  ." "  .." "  .hidden" "  A.txt" "  b.txt" "  sub")
; d flags D, u unmarks, DEL moves up and unmarks, U removes every mark, t
; toggles * and unmarked, leaving other marks.
> (goto "A.txt")
> (press! "d" "m" "m")
> (listing-lines b)
("  ." "  .." "  .hidden" "D A.txt" "* b.txt" "* sub")
> (press! "DEL")
> (list (point-name) (map folder-listing:entry-mark (entries b)))
("b.txt" (#f #f #f #\D #f #\*))
> (press! "t")
> (listing-lines b)
("  ." "  .." "* .hidden" "D A.txt" "* b.txt" "  sub")
> (press! "U")
> (listing-lines b)
("  ." "  .." "  .hidden" "  A.txt" "  b.txt" "  sub")
; A prefix repeats; a negative one marks the entries above.
> (goto "b.txt")
> (press! "2" "m")
> (list (point-name) (listing-lines b))
("sub" ("  ." "  .." "  .hidden" "  A.txt" "* b.txt" "* sub"))
> (press! "U")
> (goto "sub")
> (press! "-" "2" "m")
> (list (point-name) (listing-lines b))
("A.txt" ("  ." "  .." "  .hidden" "* A.txt" "* b.txt" "  sub"))
> (press! "U")
; With the region active, m marks every entry whose name the region
; touches.
> (goto "A.txt")
> (press! "C-SPC" "n" "n" "m")
> (listing-lines b)
("  ." "  .." "  .hidden" "* A.txt" "* b.txt" "  sub")
> (press! "U")
; * / marks folders, * @ links and * * executable files; a prefix
; unmarks.
> (system (string-append "ln -s A.txt " (at "src/link") " && chmod +x " (at "src/b.txt")))
0
> (press! "g")
> (settle)
> (press! "*" "/")
> (listing-lines b)
("  ." "  .." "  .hidden" "  A.txt" "  b.txt" "  link" "* sub")
> (press! "*" "@" "*" "*")
> (listing-lines b)
("  ." "  .." "  .hidden" "  A.txt" "* b.txt" "* link" "* sub")
> (press! "C-u" "*" "/")
> (listing-lines b)
("  ." "  .." "  .hidden" "  A.txt" "* b.txt" "* link" "  sub")
> (press! "U")
; Killing a marked listing asks nothing, and C-x C-s in it asks for no
; file and writes nothing, since files:offer-save? is #f there.
> (goto "A.txt")
> (press! "m")
> (list (buffers:modified? b) (buffers:with-buffer b (files:offer-save?)) (files:offer-save?))
(#t #f #t)
> (set-option! ask:file-name-reader (answer "~/saved.txt"))
> (set-option! ask:y-or-n-reader (answer #t))
> (press! "C-x" "C-s")
> (settle)
> (list (questions) (exists? "saved.txt") (files:path b) (buffers:name b))
(() #f #f "~/src/")
; g reads the folder again, keeping marks by name and each view's point
; on its entry, with the history of entries that did not change.
> (touch! "src/0new.txt" "")
> (goto "b.txt")
> (press! "g")
> (settle)
> (list (point-name) (listing-lines b))
("b.txt" ("  ." "  .." "  .hidden" "  0new.txt" "* A.txt" "  b.txt" "  link" "  sub"))
> (press! "C-/")
> (listing-lines b)
("  ." "  .." "  .hidden" "  0new.txt" "  A.txt" "  b.txt" "  link" "  sub")
