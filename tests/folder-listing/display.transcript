; s toggles the sort between name and time, newest first, in this
; listing only; C-u s reads a sort; the header shows it.
> (touch! "d/old.txt" "old\n")
> (touch! "d/new.txt" "new, and longer\n")
> (touch! "d/mid.c" "m\n")
> (system (string-append "touch -d '2020-01-02 03:04' " (at "d/old.txt") " && touch -d '2021-01-01' " (at "d/mid.c")))
0
> (define b (folder-listing:visit (at "d")))
> (layout:switch-to-buffer b)
> (folder-listing:open (at "d"))
> (listing-lines b)
("  ." "  .." "  mid.c" "  new.txt" "  old.txt")
> (goto "old.txt")
> (press! "s")
> (settle)
> (list (listing-lines b) (point-name) (buffers:with-buffer b (folder-listing:sort)) (folder-listing:sort))
(("  ." "  .." "  new.txt" "  mid.c" "  old.txt") "old.txt" time name)
> (drawn-has? "by time")
(#t)
> (set-option! ask:line-reader (answer "size"))
> (press! "C-u" "s")
> (settle)
> (list (questions) (listing-lines b))
(("Sort by (name, time, size or extension): ") ("  ." "  .." "  new.txt" "  old.txt" "  mid.c"))
> (folder-listing:sort-by b (folder-listing:sorting extension))
> (listing-lines b)
("  ." "  .." "  mid.c" "  new.txt" "  old.txt")
> (buffers:with-buffer b (set-option-local! folder-listing:reverse-sort? #t))
> (press! "g")
> (settle)
> (list (listing-lines b) (drawn-has? "by extension, reversed"))
(("  ." "  .." "  old.txt" "  new.txt" "  mid.c") (#t))
> (raised (lambda () (folder-listing:sort-by b 'colour)))
(folder-listing:sort-by "not a folder-listing:sorting name")
; Each entry draws its mark, mode, links, owner, group, size and time,
; then its name, which a click opens; ( hides every column but the mark
; and the name, and the line of space used.
> (drawn-has? "folder-listing-mode\">-rw" "folder-listing-size\">16<" "folder-listing-time\">Jan  2  2020<" "total used in directory" "data-keymap")
(#t #t #t #t #t)
> (press! "(")
> (list (buffers:with-buffer b (folder-listing:hide-details?)) (drawn-has? "folder-listing-mode" "total used" "by extension"))
(#t (#f #f #t))
> (memq folder-listing:hide-details? (modes:active-minor-modes (view)))
(#<procedure>)
> (press! "(")
; folder-listing:columns chooses the columns, in order, from a closed
; set.
> (set-option! folder-listing:columns (list (folder-listing:column size) (folder-listing:column time)))
> (drawn-has? "folder-listing-mode" "folder-listing-owner" "folder-listing-size" "--folder-listing-columns:1ch 4ch 12ch auto 1fr")
(#f #f #t #t)
> (raised (lambda () (set-option! folder-listing:columns '(size colour))))
(set-option! "(size colour) is not a valid value for folder-listing:columns")
> (remove-option! folder-listing:columns)
; Sizes and times are drawn by changeable definitions.
> (advice-add! folder-listing:size-text (lambda (original size) (string-append (original size) "B")))
> (press! "g")
> (settle)
> (drawn-has? "folder-listing-size\">16B<")
(#t)
; A time within six months gives the hour, an older one the year, as
; ls -l does.
> (list (folder-listing:time-text 1600000000) (string-length (folder-listing:time-text (time-second (current-time 'time-utc)))))
("Sep 13  2020" 12)
