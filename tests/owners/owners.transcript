; batch-ended runs after each batch, as (tuna): a change or post! in its
; advice raises and goes to report, and the loop goes on.
> (define owners '())
> (define (note-owner ended) (set! owners (cons (current-owner) owners)) (ended))
> (advice-add! batch-ended note-owner)
> (list (pair? owners) (for-all (lambda (o) (equal? o '(tuna))) owners))
(#t #t)
> (advice-remove! batch-ended note-owner)
> (define once? #f)
> (define (once thunk) (unless once? (set! once? #t) (thunk)))
> (define (stray ended) (ended) (once (lambda () (run-with-timer 60 void))))
> (advice-add! batch-ended stray)
