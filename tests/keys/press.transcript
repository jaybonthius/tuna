; A frame that is gone takes its session with it, even when its
; temporary keymap's procedures hold it.
> (define gone
    (let ([frame (string #\f)])
      (keys:push-keymap! frame first (lambda (found command) (eq? found frame)))
      (weak-cons frame '())))
> (collect (collect-maximum-generation))
> (bwp-object? (car gone))
#t
; keys:keyboard-quit clears the pending keys and prefix argument; with
; none pending, it ends the temporary keymaps and quits the newest
; paused command that a key of the frame started.
> (define end-k (keys:push-keymap! one first (lambda (f c) #t) (exit-of 'k)))
