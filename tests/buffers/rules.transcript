    (lambda (k)
      (let* ([text (random-text (random 30))]
             [atom (vector 'document:raw-byte '((byte . 200)))]
             [bare (fresh (list 'buffers:text '() text atom text))]
             [other (fresh (list 'buffers:text '() text atom text '(md:link ())))]
             [n (max 0 (- (document:length (buffers:document bare)) 3))])
        (equal? (stop-answers bare n) (stop-answers other n))))
    (iota 50))
#t
; An edit that replaces nothing by nothing is an edit, and moves nothing.
> (define e (fresh "abc\n"))
> (define e-anchor (buffers:anchor-after e 2))
> (buffers:replace! e 2 2 "")
#<edit 1>
> (list (buffers:version e) (buffers:anchor-position e-anchor))
(1 2)
; Spans that content brings for a layer type the buffer has no layer of
; make that layer, travelling.
> (buffers:replace! e 1 1 "xy" '((brought (0 2 tag))))
#<edit 2>
> (map (lambda (l) (buffers:spans l 0 7)) (buffers:layers e))
(((1 3 tag)))
> (buffers:replace! e 1 1 "z" '((brought (0 2 tag))))
! buffers:replace!: not a list of layer types and their spans with irritant ((brought (0 2 tag)))
