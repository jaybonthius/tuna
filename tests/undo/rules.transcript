; Groups: one per command, and one per batch for edits made outside a
; command.
> (define b (buffers:make "notes" "abc\n"))
> (define (run command . args) (buffers:with-buffer b (apply commands:run command args)))
> (define (parents b) (map cadr (cddr (undo:history b))))
> (run checks:insert 1 "1")
#<edit 1>
> (run checks:insert 1 "2")
#<edit 2>
> (begin (buffers:replace! b 1 1 "3") (buffers:replace! b 1 1 "4"))
#<edit 4>
> (begin (buffers:replace! b 1 1 "5") (sleep-for 0.01) (buffers:replace! b 1 1 "6"))
#<edit 6>
> (list (text b) (parents b))
("654321abc\n" (#f 0 1 2 3 4))
> (run undo:undo 1)
> (text b)
"54321abc\n"
> (run undo:undo 2)
> (text b)
"21abc\n"
> (run undo:redo 1)
> (text b)
"4321abc\n"
> (run undo:undo 3)
> (text b)
"abc\n"
; Undo raises at the root, redo at a state with no children; each does
; what it can first.
> (run undo:undo 1)
! undo:undo: no further undo information
> (run undo:redo 9)
! undo:redo: no further redo information
> (text b)
"654321abc\n"
> (map (lambda (n) (raised (lambda () (undo:undo n)))) '(0 -1 1.5 x))
((undo:undo "not a positive count") (undo:undo "not a positive count") (undo:undo "not a positive count") (undo:undo "not a positive count"))
> (raised (lambda () (undo:redo 0)))
(undo:redo "not a positive count")
> (raised (lambda () (undo:undo 1)))
(undo:undo "no buffer is current")
> (raised (lambda () (undo:history "notes")))
(undo:history "not a buffer")
; A command paused at a prompt keeps the edits it made before the pause
; as a group of their own.
> (define p (buffers:make "paused" "\n"))
> (buffers:with-buffer p (commands:run checks:insert-pausing "x"))
#<edit 2>
> (list (text p) (map cadr (cddr (undo:history p))))
("xx\n" (#f 0 1))
> (buffers:with-buffer p (commands:run undo:undo 1))
> (text p)
"x\n"
; Typing joins the previous group while the same command runs again,
; up to 20 commands; another command ends the run.
> (define t (buffers:make "typing" "\n"))
> (define (type s) (buffers:with-buffer t (commands:run checks:type s)))
> (for-each type (map string (string->list "abcdefghijklmnopqrstuvwxy")))
#<edit 25>
> (list (text t) (parents t))
("\nabcdefghijklmnopqrstuvwxy" (#f 0 1))
> (buffers:with-buffer t (commands:run undo:undo 1))
> (text t)
"\nabcdefghijklmnopqrst"
> (buffers:with-buffer t (commands:run undo:undo 1))
> (text t)
"\n"
> (buffers:with-buffer t (commands:run undo:redo 1))
> (for-each type '("1" "2"))
#<edit 72>
> (buffers:with-buffer t (commands:run checks:insert 1 "#"))
#<edit 73>
> (for-each type '("3" "4"))
#<edit 75>
> (list (text t) (parents t))
("#\nabcdefghijklmnopqrst1234" (#f 0 1 1 3 4))
> (buffers:with-buffer t (commands:run undo:undo 1))
> (text t)
"#\nabcdefghijklmnopqrst12"
; Typing into another buffer between two runs ends the group.
> (type "5")
#<edit 78>
> (buffers:with-buffer b (commands:run checks:type "z"))
#<edit 23>
> (type "6")
#<edit 79>
> (buffers:with-buffer t (commands:run undo:undo 1))
> (text t)
"#\nabcdefghijklmnopqrst125"
; An edit group holds every edit its body makes, across commands and
; pauses, and returns the body's values.
> (define g (buffers:make "group" "\n"))
> (undo:with-edit-group g
    (buffers:with-buffer g (commands:run checks:insert 1 "a"))
    (sleep-for 0.01)
    (buffers:with-buffer g (commands:run checks:insert 1 "b"))
    (values 1 2))
1
2
> (list (text g) (map cadr (cddr (undo:history g))))
("ba\n" (#f 0))
; A body that raises has its edits undone, unrecorded, and the
; condition raised again.
> (raised (lambda ()
    (undo:with-edit-group g
      (buffers:replace! g 1 1 "x")
      (sleep-for 0.01)
      (buffers:replace! g 1 1 "y")
      (error 'body "failed"))))
(body "failed")
> (list (text g) (map cadr (cddr (undo:history g))))
("ba\n" (#f 0))
; A nested group joins the outer one; when it raises, only its own edits
; are undone.
> (undo:call-with-edit-group g
    (lambda ()
      (buffers:replace! g 1 1 "1")
      (guard (c [#t 'caught])
        (undo:with-edit-group g
          (buffers:replace! g 1 1 "2")
          (raise 'inner)))
      (buffers:replace! g 1 1 "3")))
#<edit 10>
> (list (text g) (map cadr (cddr (undo:history g))))
("31ba\n" (#f 0 1))
> (buffers:with-buffer g (commands:run undo:undo 1))
> (text g)
"ba\n"
; A body left by a continuation ends its group once its task goes on
; or ends; only a pause comes back into the body.
> (define e (buffers:make "escape" "0123456789\n"))
> (call/cc (lambda (out) (undo:with-edit-group e (buffers:replace! e 1 1 "a") (out 'escaped))))
escaped
> (buffers:with-buffer e (commands:run checks:insert 1 "b"))
#<edit 2>
> (buffers:with-buffer e (commands:run checks:insert 1 "c"))
#<edit 3>
> (begin
    (call/cc (lambda (out) (undo:with-edit-group e (buffers:replace! e 1 1 "d") (out 'escaped))))
    (buffers:with-buffer e (commands:run checks:insert 1 "f")))
#<edit 5>
> (list (text e) (parents e))
("fdcba0123456789\n" (#f 0 1 2 3 4))
> (raised (lambda () (undo:call-with-edit-group g 'thunk)))
(undo:call-with-edit-group "not a procedure")
> (raised (lambda () (undo:call-with-edit-group "group" void)))
(undo:call-with-edit-group "not a buffer")
; The tree: an edit after an undo starts a branch; redo follows the child
; that undo last left, else the newest, and go-to! moves across branches.
> (define r (buffers:make "tree" "\n"))
> (define (in-r command . args) (buffers:with-buffer r (apply commands:run command args)))
> (in-r checks:insert 1 "a")
#<edit 1>
> (in-r checks:insert 2 "b")
#<edit 2>
> (in-r undo:undo 1)
> (in-r checks:insert 2 "c")
#<edit 4>
> (in-r undo:undo 1)
> (in-r undo:redo 1)
> (text r)
"ac\n"
> (in-r undo:undo 1)
> (undo:go-to! r 2)
> (text r)
"ab\n"
> (in-r undo:undo 1)
> (in-r undo:redo 1)
> (text r)
"ab\n"
> (tree r)
(2 0 (0 #f) (1 0) (2 1) (3 1))
> (undo:go-to! r 0)
> (text r)
"\n"
> (undo:go-to! r 3)
> (text r)
"ac\n"
> (raised (lambda () (undo:go-to! r 9)))
(undo:go-to! "not a state of the buffer's history")
> (raised (lambda () (undo:go-to! r -1)))
(undo:go-to! "not a state of the buffer's history")
; Another after-edit entry that edits the buffer as undo splices a step
; ends the move there: the steps spliced become a state of their own and
; the entry's edit a group after it, so the history still matches the
; buffer. A move cut short raises.
> (define k (buffers:make "sneak" "0123456789\n"))
> (define (in-k command . args) (buffers:with-buffer k (apply commands:run command args)))
> (undo:with-edit-group k (buffers:replace! k 3 3 "a") (buffers:replace! k 9 9 "b"))
#<edit 2>
> (define sneak #f)
> (define (sneak-in buffer edit)
    (when (and sneak (eq? buffer k))
      (set! sneak #f)
      (buffers:replace! k 1 1 "!")))
> (add-hook! buffers:after-edit sneak-in)
> (set! sneak #t)
> (in-k undo:undo 1)
! undo:undo: the buffer does not hold the text its history expects
> (list (text k) (tree k))
("!01a23456789\n" (3 0 (0 #f) (1 2) (2 0) (3 2)))
> (in-k undo:undo 2)
> (text k)
"0123456789\n"
> (undo:go-to! k 1)
> (text k)
"01a23456b789\n"
; An edit made as the last step is spliced follows the move, which then
; ends normally.
> (set! sneak #t)
> (in-k undo:undo 1)
> (list (text k) (tree k))
("!01a23456789\n" (4 0 (0 #f) (1 2) (2 0) (3 2) (4 2)))
> (remove-hook! buffers:after-edit sneak-in)
; Undo puts the view's cursors where they were before the group; redo
; puts them at the end of the group's last edit.
> (define w (buffers:make "cursors" "one two\n"))
> (define v (views:make w))
> (views:set-point! v 4)
> (views:add-cursor! v 8)
#<cursor>
> (views:with-view v (commands:run checks:insert 1 ">"))
#<edit 1>
> (views:with-view v (commands:run checks:delete 5 9))
#<edit 2>
> (list (text w) (map views:cursor-point (views:cursors v)))
(">one\n" (5))
> (views:set-point! v 1)
> (views:with-view v (commands:run undo:undo 1))
> (list (text w) (map views:cursor-point (views:cursors v)))
(">one two\n" (5 9))
> (views:with-view v (commands:run undo:redo 1))
> (list (text w) (map views:cursor-point (views:cursors v)))
(">one\n" (5))
; A history is trimmed to the limit: the oldest groups go first, a
; branch off the root before the path to the current state.
> (define s (buffers:make "small" "\n"))
> (buffers:with-buffer s (set-option-local! undo:limit 100))
> (define (in-s command . args) (buffers:with-buffer s (apply commands:run command args)))
> (for-each (lambda (x) (in-s checks:insert 1 x)) '("a" "b" "c" "d"))
#<edit 4>
> (tree s)
(4 #f (1 #f) (2 1) (3 2) (4 3))
> (in-s undo:undo 9)
! undo:undo: no further undo information
> (text s)
"a\n"
> (define s2 (buffers:make "branches" "\n"))
> (buffers:with-buffer s2 (set-option-local! undo:limit 100))
> (define (in-s2 command . args) (buffers:with-buffer s2 (apply commands:run command args)))
> (in-s2 checks:insert 1 "a")
#<edit 1>
> (in-s2 undo:undo 1)
> (for-each (lambda (x) (in-s2 checks:insert 1 x)) '("b" "c" "d"))
#<edit 5>
> (tree s2)
(4 0 (0 #f) (2 0) (3 2) (4 3))
; One group larger than the limit empties the history, with a warning.
> (in-s checks:insert 1 (make-string 80 #\x))
#<edit 8>
! (undo) undo:limit: an edit group is larger than the limit, so the buffer's history starts again with irritant "small"
> (tree s)
(5 #f (5 #f))
> (let ([h (undo:history s)]) (<= (abs (- (caddr (caddr h)) (time-second (current-time 'time-utc)))) 5))
#t
> (in-s undo:undo 1)
! undo:undo: no further undo information
; With a limit of 0 a buffer keeps no history.
> (define z (buffers:make "rebuilt" "\n"))
> (buffers:with-buffer z (set-option-local! undo:limit 0))
> (buffers:with-buffer z (commands:run checks:insert 1 "a"))
#<edit 1>
> (buffers:with-buffer z (commands:run undo:undo 1))
! undo:undo: no further undo information
> (text z)
"a\n"
> (raised (lambda () (set-option! undo:limit -1)))
(set-option! "-1 is not a valid value for undo:limit")
; Undo says Undo and redo says Redo, as Emacs's undo and undo-redo; a
; refused redo says nothing. In a prompt's buffer, an internal one, both
; say nothing, as the mark commands do there.
> (begin (take-said!) (void))
> (define said-buffer (buffers:make "said" "abc\n"))
> (buffers:with-buffer said-buffer (commands:run checks:insert 1 "1"))
#<edit 1>
> (buffers:with-buffer said-buffer (commands:run undo:undo 1))
> (buffers:with-buffer said-buffer (commands:run undo:redo 1))
> (buffers:with-buffer said-buffer (commands:run undo:redo 1))
! undo:redo: no further redo information
> (take-said!)
("Undo" "Redo")
> (define prompt-like (buffers:make " *prompt*" "abc\n"))
> (buffers:set-silent! prompt-like #f)
> (buffers:with-buffer prompt-like (commands:run checks:insert 1 "1"))
#<edit 1>
> (buffers:with-buffer prompt-like (commands:run undo:undo 1))
> (buffers:with-buffer prompt-like (commands:run undo:redo 1))
> (take-said!)
()
