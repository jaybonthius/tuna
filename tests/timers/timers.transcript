(ring (init) #t)
; A repeating timer runs every repeat seconds until it is cancelled.
> (define runs 0)
> (define repeating #f)
> (begin
    (set! repeating (run-with-timer 0.2 (lambda () (set! runs (+ runs 1))) 0.2))
    (sleep-for 0.5)
    runs)
2
> (cancel-timer! repeating)
> (sleep-for 0.3)
> (list runs (timers) (module-changes '(repl)))
(2 () ())
; A repeat that falls behind runs once, then keeps its rhythm.
> (define behind-runs 0)
> (define behind #f)
> (begin
    (set! behind (run-with-timer 0.3 (lambda () (set! behind-runs (+ behind-runs 1))) 0.3))
    (chez:sleep (make-time 'time-duration 0 1)))
> behind-runs
1
> (sleep-for 0.3)
> behind-runs
2
> (cancel-timer! behind)
