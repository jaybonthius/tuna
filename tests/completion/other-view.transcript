; C-x 4 4 hands the next command a wrapper: its buffer shows in another
; view, which it selects. The read's own prompt shows at the bottom as
; always, since a prompt's buffer is internal.
> (define (shown)
    (map (lambda (v) (list (buffers:name (views:buffer v)) (eq? v (view))))
         (remp (lambda (v) (buffers:internal-name? (buffers:name (views:buffer v)))) (layout:views))))
> (define notes (buffers:make "notes" "one\ntwo\n"))
> (define elsewhere (buffers:make "elsewhere" "x\n"))
> (layout:switch-to-buffer notes)
> (press! "C-x" "4" "4")
> (keys:prefix-description client)
"C-x 4 4"
> (define t (start! (lambda () (press! "C-x" "b"))))
> (eq? (layout:selected-view) (layout:find-view minibuf))
#t
> (type! "elsewhere")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (shown)
(("notes" #f) ("elsewhere" #t))
> (keys:prefix-description client)
#f
; C-x 4 b on the buffer the selected view shows opens a second view of
; it: the selected view is never the target.
> (press! "C-x" "0")
> (define t (start! (lambda () (press! "C-x" "4" "b"))))
> (type! "notes")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (shown)
(("notes" #f) ("notes" #t))
> (press! "C-x" "0")
