; A kill across paragraphs yanks back as it was killed, and the
; position after it is where its text ends.
> (import (md))
> (define m (buffers:make "m" (md:doc '() (md:para '() "Alpha " (md:link '() "beta") " gamma.\n") (md:para '() "Two three.\n"))))
> (define across (kill-ring:piece m 4 26))
> (kill-ring:text (list across))
"pha beta gamma.\nTw"
> (define before (root m))
> (buffers:replace! m 4 26 "")
#<edit 1>
> (root m)
(md:doc () (md:para () "Alo three.\n"))
> (kill-ring:insert! m 4 across)
26
> (equal? (root m) before)
#t
> (kill-ring:insert! m 8 across)
30
> (root m)
(md:doc () (md:para () "Alpha pha " (md:link () "beta") " gamma.\n") (md:para () "Tw" (md:link () "beta") " gamma.\n") (md:para () "Two three.\n"))
> (document:text (buffers:document m) 8 30)
"pha beta gamma.\nTw"
; A whole paragraph put inside another splits it; the position after is
; at the start of the text it split off.
> (define para (let ([l (document:length (buffers:document m))]) (kill-ring:piece m (- l 14) (- l 1))))
> (kill-ring:text (list para))
"Two three.\n"
> (define n (buffers:make "n" (md:doc '() (md:para '() "abcd\n"))))
> (define after (kill-ring:insert! n 4 para))
> (list (root n) (document:text (buffers:document n) 0 after))
((md:doc () (md:para () "ab") (md:para () "Two three.\n") (md:para () "cd\n")) "abTwo three.\n")
; A response's travelling span survives a kill and a yank elsewhere;
; another layer's spans stay behind. A string yanked into the span's end
; joins it, as typed text would.
> (buffers:define-layer responses (travels) (sticky after))
> (buffers:define-layer marks)
> (define t (buffers:make "t" "Ask. Answer here. End.\n"))
> (buffers:add-span! (buffers:layer t responses) 6 18 'gpt)
> (buffers:add-span! (buffers:layer t marks) 6 18 'mark)
> (define answer (kill-ring:piece t 6 18))
> (buffers:replace! t 6 18 "")
#<edit 2>
> (list (contents t) (spans-of t responses) (spans-of t marks))
("Ask.  End.\n" () (("" mark)))
> (kill-ring:insert! t 11 answer)
23
> (list (contents t) (spans-of t responses) (spans-of t marks))
("Ask.  End.Answer here.\n" (("Answer here." gpt)) (("" mark)))
> (kill-ring:insert! t 23 "!")
24
> (spans-of t responses)
(("Answer here.!" gpt))
; A kill appended to a kill keeps both parts: the text is theirs joined,
; and a yank puts each back in turn with its spans.
> (define w (buffers:make "w" (md:doc '() (md:para '() "One two.\n") (md:para '() "Three four.\n"))))
> (set! pushed '())
> (kill-ring:push! (list (kill-ring:piece w 6 17)))
> (kill-ring:append! (list "+"))
> (kill-ring:append! (list (kill-ring:piece t 11 23)))
> (kill-ring:prepend! (list "<"))
> (take-pushed!)
("two.\nThre" "two.\nThre+" "two.\nThre+Answer here." "<two.\nThre+Answer here.")
> (define joined (car (kill-ring:current)))
> (define u (buffers:make "u" (md:doc '() (md:para '() "xy\n"))))
> (kill-ring:insert! u 3 joined)
28
> (list (root u) (spans-of u responses))
((md:doc () (md:para () "x<two.\n") (md:para () "Thre+Answer here.y\n")) (("Answer here." gpt)))
> (kill-ring:append! (list "!"))
> (kill-ring:text (kill-ring:current))
"<two.\nThre+Answer here.!"
; A part refused after others went in takes them back out: the buffer
; and its spans are as they were.
> (define (one-line? node edit) (not (memv #\newline (string->list (document:text (buffers:edit-inserted edit))))))
> (buffers:define-kind field (consent one-line?))
> (buffers:define-kind form (content nodes))
> (define f (buffers:make "f" '(form () (field () "xy"))))
> (buffers:add-span! (buffers:layer f responses) 3 4 'gpt)
> (define three-parts (car (begin (kill-ring:push! (list "abc")) (kill-ring:append! (list (kill-ring:piece t 11 23))) (kill-ring:append! (list (kill-ring:piece w 6 17))) (kill-ring:current))))
> (list (raised (lambda () (kill-ring:insert! f 3 three-parts))) (root f) (spans-of f responses) (buffers:version f))
((buffers:replace! "the node refuses the edit") (form () (field () "xy")) (("y" gpt)) 5)
> (kill-ring:insert! f 3 (car (begin (kill-ring:push! (list "abc")) (kill-ring:append! (list (kill-ring:piece t 11 23))) (kill-ring:current))))
18
> (list (root f) (spans-of f responses))
((form () (field () "xabcAnswer here.y")) (("Answer here.y" gpt)))
; Yankers: a piece whose top node, or atom, has a kind in the table goes
; to its procedure; otherwise, or once the entry goes, to replace!.
> (define calls '())
> (define (note-yank buffer position piece)
    (set! calls (cons (list (buffers:name buffer) position (kill-ring:text (list piece))) calls))
    42)
> (table-set! kill-ring:yankers 'md:image note-yank)
> (table-set! kill-ring:yankers 'md:para note-yank)
> (define v (buffers:make "v" (md:doc '() (md:para '() "Pic " (md:image '((src . "a.png"))) ".\n") (md:para '() "Last.\n"))))
> (define (yank-range! start end) (kill-ring:insert! u 2 (kill-ring:piece v start end)))
> (let* ([a (yank-range! 6 7)] [b (yank-range! 1 10)] [c (yank-range! 1 5)] [d (yank-range! 10 18)])
    (list a b c d (reverse calls) (root u)))
(42 42 42 42 (("u" 2 "") ("u" 2 "Pic .\n") ("u" 2 "Pic") ("u" 2 "Last.\n")) (md:doc () (md:para () "x<two.\n") (md:para () "Thre+Answer here.y\n")))
> (let* ([a (yank-range! 2 13)] [b (root u)] [c (yank-range! 11 17)]) (list a b c (root u)))
(13 (md:doc () (md:para () "Pic " #(md:image ((src . "a.png"))) ".\n") (md:para () "Lax<two.\n") (md:para () "Thre+Answer here.y\n")) 8 (md:doc () (md:para () "Last.\nPic " #(md:image ((src . "a.png"))) ".\n") (md:para () "Lax<two.\n") (md:para () "Thre+Answer here.y\n")))
> (table-remove! kill-ring:yankers 'md:para)
> (yank-range! 10 18)
10
> (raised (lambda () (kill-ring:insert! u 999 (kill-ring:piece v 1 10))))
(kill-ring:insert! "not a position in the buffer")
> (list (root u) (length calls))
((md:doc () (md:para () "Last.\n") (md:para () "Last.\nPic " #(md:image ((src . "a.png"))) ".\n") (md:para () "Lax<two.\n") (md:para () "Thre+Answer here.y\n")) 4)
; The options, hook and table are documented, and the configuration's
; setting is in effect beneath the REPL's.
> (map documentation (list kill-ring:max kill-ring:skip-duplicates kill-ring:after-push kill-ring:yankers))
("How many entries the ring keeps; pushing one more drops the oldest." "When true, pushing an entry whose text equals the newest entry's only moves the yank pointer to the newest." "Called with the newest entry after each push!, append! and prepend!." "Maps a node kind's name to a procedure of a buffer, a position and a piece that yanks a piece whose top node has that kind, returning the position after what it inserted.")
> (option-settings kill-ring:skip-duplicates)
(((repl) #f) ((init) #t))
