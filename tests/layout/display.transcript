((1 . "mail") (4 . "*Pager*") (3 . "notes"))
> (layout:select! (views:find 4))
> (layout:select! (views:find 3))
> (define other (buffers:make "other" ""))
> (views:id (layout:use-other-view other))
1
> (map (lambda (v) (cons (views:id v) (buffers:name (views:buffer v)))) (layout:views))
((1 . "other") (4 . "*Pager*") (3 . "notes"))
> (views:id (layout:use-other-view other))
1
> (define echo (place-echo (buffers:make "*Echo*" "")))
