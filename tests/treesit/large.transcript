; A 1 MB file opened at line 20,000: the range views has drawn, the rows
; in view and a margin beyond each edge, is coloured first, in its final
; colours; the rest follows in pieces, outward from it, while the
; editor goes on running other work.
> (define text (grown-text 1000000))
> (define b (buffers:make "large.py" text))
> (define v (views:make b))
> (define first-runs #f)
> (begin
    (watch! b)
    (set! on-set (lambda (start end)
                   (unless first-runs
                     (set! first-runs (map (lambda (r) (face-runs b (car r) (cdr r))) (views:drawn-ranges v))))))
    (views:scroll-to! v (line-start b 20000) (views:align top))
    (show! desktop v)
    (modes:set-major-mode python:mode b))
> (let loop () (unless first-runs (sleep-for 0.01) (loop)))
> (drawn-lines v)
((19900 20100))
> (map (lambda (s) (list (line-of b (car s)) (line-of b (- (cadr s) 1)))) (list-head (sets) 1))
((19900 20098))
> (null? (faces-now b 0 (line-start b 100)))
#t
> (settle b)
> (equal? first-runs (map (lambda (r) (face-runs b (car r) (cdr r))) (views:drawn-ranges v)))
#t
> (faces b 0 (line-start b 3))
(("#!/usr/bin/env python3" comment) ("\"\"\"A sample of Python for Tuna's highlighting tests.\"\"\"" string.documentation))
> (> (length (sets)) 20)
#t
