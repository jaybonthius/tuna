(library chez-haml
  (git "https://github.com/jaybonthius/chez-haml.git")
  (commit "9fa69ebbf4aea9f7dd078e846f52d8cfa9172c3b")
  (library-directories ("src" . "build/obj/src"))
  (build))
;; Chez looks for the build/config.ss that (ghostty ffi) includes in the
;; library's own folder, src/ghostty, and the library's make writes it at
;; the root, so the build copies it there.
(library chez-libghostty
  (git "https://github.com/jaybonthius/chez-libghostty.git")
  (commit "0a3d7b524573774e12ab47df46fc7733538724da")
  (library-directories ("src" . "build/obj/src"))
  (build "sh" "-c" "make ghostty build/config.ss && mkdir -p src/ghostty/build && cp build/config.ss src/ghostty/build/config.ss"))
