(import (tuna) (test) (hooks) (commands) (buffers) (document) (views) (undo) (edits))

(define (silently b start end text) (buffers:with-silent-edits b (buffers:replace! b start end text)))

(buffers:define-layer marks (travels))

(define (marks-of b) (buffers:spans (buffers:layer b marks) 0 (document:length (buffers:document b))))

(define (echo-length b edit)
  (unless (buffers:edit-silent? edit)
    (let* ([t (edits:text b)] [i (let loop ([i 0]) (if (char=? (string-ref t i) #\[) i (loop (+ i 1))))])
      (silently b (+ i 1) (- (document:length (buffers:document b)) 2) (format "[~a]" (- i 1))))))

(test "a silent edit is not history: undo records none, and carries the history past it, so each group still undoes the text it changed"
  (let ([b (buffers:make "prompt" "> \n")])
    (edits:run-in b edits:insert 3 "one")
    (edits:run-in b edits:insert 6 " two")
    (silently b 1 1 "Pi says hi.\n")
    (check-equal? '("Pi says hi.\n> one two\n" #t (2 0 (0 #f) (1 0) (2 1)))
      (list (edits:text b) (buffers:edit-silent? (car (reverse (buffers:edits-since b 2)))) (edits:tree b)))
    (edits:run-in b undo:undo 1)
    (check-equal? "Pi says hi.\n> one\n" (edits:text b))
    (silently b 18 19 "\n...\n")
    (edits:run-in b undo:undo 1)
    (check-equal? "Pi says hi.\n> \n...\n" (edits:text b))
    (edits:run-in b undo:redo 2)
    (check-equal? "Pi says hi.\n> one two\n...\n" (edits:text b))
    (silently b 25 26 "!")
    (edits:run-in b undo:undo 2)
    (check-equal? "Pi says hi.\n> \n..!\n" (edits:text b))
    (edits:run-in b undo:redo 2)
    (edits:run-in b edits:insert 1 "[")
    (edits:run-in b edits:insert 2 "x")
    (check-equal? "[xPi says hi.\n> one two\n..!\n" (edits:text b))
    (silently b 1 4 "")
    (check-equal? '("i says hi.\n> one two\n..!\n" (2 0 (0 #f) (1 0) (2 1))) (list (edits:text b) (edits:tree b)))
    (edits:run-in b undo:undo 1)
    (check-equal? "i says hi.\n> one\n..!\n" (edits:text b))
    (edits:run-in b undo:redo 1)
    (silently b 17 19 "")
    (check-equal? '("i says hi.\n> onewo\n..!\n" (2 #f (2 #f))) (list (edits:text b) (edits:tree b)))
    (check-equal? '((undo:undo "no further undo information")) (edits:reports-during (lambda () (edits:run-in b undo:undo 1)))))
  (edits:take-said!))

(test "branches off the path move too, and one whose edit the silent edit cuts into is dropped"
  (let ([r (buffers:make "branches" "abcd\n")])
    (edits:run-in r edits:insert 5 "X")
    (edits:run-in r undo:undo 1)
    (edits:run-in r edits:delete 2 4)
    (edits:run-in r undo:undo 1)
    (edits:run-in r edits:insert 1 "Z")
    (check-equal? '(3 0 (0 #f) (1 0) (2 0) (3 0)) (edits:tree r))
    (silently r 3 4 "-")
    (check-equal? '("Za-cd\n" (3 0 (0 #f) (1 0) (3 0))) (list (edits:text r) (edits:tree r)))
    (undo:go-to! r 1)
    (check-equal? "a-cdX\n" (edits:text r))
    (let ([v (views:make r)])
      (views:call-with-view v (lambda () (views:set-point! v 6) (commands:run edits:insert 6 "!")))
      (silently r 1 1 "<<")
      (views:call-with-view v (lambda () (views:set-point! v 1) (commands:run undo:undo 1)))
      (check-equal? '("<<a-cdX\n" 8) (list (edits:text r) (views:point v)))
      (views:drop! v)))
  (edits:take-said!))

(test "a silent edit leaves the modified flag as it was, and undo still finds the saved state"
  (let ([m (buffers:make "flag" "x\n")])
    (edits:run-in m edits:insert 1 "a")
    (buffers:set-modified! m #f)
    (silently m 3 3 "!")
    (check-equal? #f (buffers:modified? m))
    (edits:run-in m edits:insert 1 "b")
    (silently m 5 5 "?")
    (check-equal? #t (buffers:modified? m))
    (edits:run-in m undo:undo 1)
    (check-equal? '("ax!?\n" #f) (list (edits:text m) (buffers:modified? m))))
  (edits:take-said!))

(test "a silent buffer never gets a history"
  (let ([s (buffers:make "log" "\n")])
    (buffers:set-silent! s #t)
    (buffers:replace! s 1 1 "entry\n")
    (check-equal? '(#t #f #t (0 0 (0 #f)))
      (list (buffers:silent? s) (buffers:modified? s) (buffers:edit-silent? (car (buffers:edits-since s 0))) (edits:tree s)))))

(test "records already taken name old positions, so the next take after a silent edit is whole"
  (let ([w (buffers:make "written" "\n")])
    (edits:run-in w edits:insert 1 "a")
    (check-equal? '(undo-history group at) (map car (undo:take-records! w)))
    (edits:run-in w edits:insert 2 "b")
    (check-equal? '(group) (map car (undo:take-records! w)))
    (silently w 1 1 "_")
    (check-equal? '(undo-history group group at) (map car (undo:take-records! w)))))

(test "a plugin that rewrites part of the buffer silently after each edit leaves undo whole: a group of several edits undoes and redoes at once"
  (let ([e (buffers:make "echoing" "\n[0]\n")])
    (buffers:with-buffer e (hooks:add-local! buffers:after-edit echo-length))
    (undo:with-edit-group e (buffers:replace! e 1 1 "ab") (buffers:replace! e 3 3 "cd") (buffers:replace! e 5 5 "ef"))
    (check-equal? '("abcdef\n[6]\n" (1 0 (0 #f) (1 0))) (list (edits:text e) (edits:tree e)))
    (edits:run-in e undo:undo 1)
    (check-equal? '("\n[0]\n" (0 0 (0 #f) (1 0))) (list (edits:text e) (edits:tree e)))
    (edits:run-in e undo:redo 1)
    (check-equal? '("abcdef\n[6]\n" (1 0 (0 #f) (1 0)) #t) (list (edits:text e) (edits:tree e) (buffers:modified? e))))
  (edits:take-said!))

(test "a group whose body raises is taken back whole past such silent edits"
  (let ([g (buffers:make "cancelled" "\n[0]\n")])
    (buffers:with-buffer g (hooks:add-local! buffers:after-edit echo-length))
    (check-raises (edits:raised? 'body "stops")
      (undo:with-edit-group g (buffers:replace! g 1 1 "ab") (buffers:replace! g 3 3 "cd") (error 'body "stops")))
    (check-equal? '("\n[0]\n" (0 0 (0 #f)) #f) (list (edits:text g) (edits:tree g) (buffers:modified? g)))))

(test "a nested body takes back its own edits when a silent edit took an edit made before its hold"
  (let ([n (buffers:make "nested" "\n")])
    (check-equal? "\n"
      (undo:with-edit-group n
        (buffers:replace! n 1 1 "ab")
        (guard (c [(and (message-condition? c) (equal? "stops" (condition-message c))) (void)])
          (undo:with-edit-group n
            (buffers:replace! n 3 3 "cd")
            (silently n 1 3 "")
            (error 'body "stops")))
        (edits:text n)))))

(test "a history read back from records is carried past a silent edit as the one its edits built"
  (let ([o (buffers:make "original" "\n")])
    (edits:run-in o edits:insert 1 "abc")
    (edits:run-in o edits:insert 4 "XYZ")
    (let-values ([(read-back fits?) (undo:records->history (undo:take-all-records! o))])
      (let ([c (buffers:make "read back" "abcXYZ\n")])
        (check-equal? #t (undo:install! c read-back 0))
        (silently c 4 4 "--")
        (edits:run-in c undo:undo 1)
        (check-equal? "abc--\n" (edits:text c))
        (edits:run-in c undo:undo 1)
        (check-equal? "--\n" (edits:text c)))))
  (edits:take-said!))

(test "a cursor at the place of a silent insertion goes after it, as an edit that starts there does"
  (let* ([k (buffers:make "cursor" "\n")] [kv (views:make k)])
    (views:call-with-view kv (lambda () (views:set-point! kv 1) (commands:run edits:insert 1 "q")))
    (silently k 1 1 "Z")
    (views:call-with-view kv (lambda () (views:set-point! kv 3) (commands:run undo:undo 1)))
    (check-equal? '("Z\n" 2) (list (edits:text k) (views:point kv)))
    (views:drop! kv))
  (edits:take-said!))

(test "a silent edit that changes no token, as one that sets a travelling layer's spans, leaves the history as it is"
  (let ([p (buffers:make "spans" "\n")])
    (edits:run-in p edits:insert 1 "one")
    (edits:run-in p edits:insert 4 " two")
    (buffers:with-silent-edits p (buffers:add-span! (buffers:layer p marks) 1 8 'seen))
    (buffers:with-silent-edits p (buffers:add-span! (buffers:layer p marks) 2 6 'cut))
    (check-equal? '("one two\n" (2 0 (0 #f) (1 0) (2 1)) #f)
      (list (edits:text p) (edits:tree p) (buffers:edit-moves? (car (reverse (buffers:edits-since p 2))))))
    (edits:run-in p undo:undo 1)
    (check-equal? "one\n" (edits:text p)))
  (edits:take-said!))

(test "a group a silent edit makes the root is closed, so the command's later edits make a group of their own, and the records taken meanwhile still replay"
  (let ([q (buffers:make "rooted" "\n")])
    (edits:run-in q edits:insert 1 "x")
    (check-equal? '(undo-history group at) (map car (undo:take-records! q)))
    (let ([whole (undo:with-edit-group q
                   (buffers:replace! q 2 2 "ab")
                   (silently q 3 4 "")
                   (let ([taken (undo:take-records! q)])
                     (buffers:replace! q 1 1 "c")
                     taken))])
      (let ([more (undo:take-records! q)])
        (check-equal? '("cxa\n" (group)) (list (edits:text q) (map car more)))
        (let-values ([(read-back fits?) (undo:records->history (append whole more))])
          (check fits?))))
    (edits:run-in q undo:undo 1)
    (check-equal? "xa\n" (edits:text q)))
  (edits:take-said!))

(test "undo keeps what the buffer held where it took text away, so spans set silently on a travelling layer come back with redo"
  (let ([m (buffers:make "redone" "\n")])
    (edits:run-in m edits:insert 1 "one")
    (edits:run-in m edits:insert 4 " two")
    (buffers:with-silent-edits m (buffers:add-span! (buffers:layer m marks) 1 8 'seen))
    (check-equal? '("one two\n" ((1 8 seen))) (list (edits:text m) (marks-of m)))
    (edits:run-in m undo:undo 1)
    (check-equal? '("one\n" ((1 4 seen))) (list (edits:text m) (marks-of m)))
    (edits:run-in m undo:redo 1)
    (check-equal? '("one two\n" ((1 8 seen))) (list (edits:text m) (marks-of m)))
    (edits:run-in m undo:undo 2)
    (edits:run-in m undo:redo 2)
    (check-equal? '("one two\n" ((1 8 seen))) (list (edits:text m) (marks-of m))))
  (edits:take-said!))
