; Layout-split's resize keymap repeats: after C-x }, each } or { goes on
; resizing, and any other key ends it and runs as usual.
> (define c1 (web:add-client! 1))
> (press! c1 "C-x" "3")
> (weights)
(1 1)
> (press! c1 "C-x" "}" "}" "}" "{")
> (weights)
(7/5 3/5)
> (keymap-names c1)
(layout-split:resize-keymap layout:keymap keys:global)
; Each repetition shows the keys that go on in the echo area, without
; logging them in *Messages*.
> (import (echo-area))
> (echo-area:current-message)
"Repeat with }, {"
> (document:text (buffers:document (buffers:find "*Messages*")))
""
; A key that ends the repetition clears the hint.
> (press! c1 "C-x" "o")
> (keymap-names c1)
(layout:keymap keys:global)
> (echo-area:current-message)
#f
> (layout:selected-view)
#<view 4>
; A key bound in the keymap works only while it repeats.
> (keys:bind! layout-split:resize-keymap "v" layout-split:shrink)
> (press! c1 "C-x" "{" "v")
> (weights)
(9/5 1/5)
> (echo-area:current-message)
"Repeat with }, {, v"
> (press! c1 "C-g" "v")
! v is undefined
> (weights)
(9/5 1/5)
; Taken out of the table, the keymap no longer repeats.
> (table-remove! keys:repeat-keymaps layout-split:resize-keymap)
> (press! c1 "C-x" "}" "}")
! } is undefined
> (weights)
(8/5 2/5)
> (keymap-names c1)
(layout:keymap keys:global)
; Overridden to do nothing, the hint shows nothing, and the keymap still
; repeats.
> (table-set! keys:repeat-keymaps layout-split:resize-keymap)
> (set! repeat:show-hint (lambda (keymap) (void)))
> (press! c1 "C-x" "}" "}")
> (list (weights) (keymap-names c1) (echo-area:current-message))
((6/5 4/5) (layout-split:resize-keymap layout:keymap keys:global) #f)
> (remove-override! repeat:show-hint)
> (raised (lambda () (repeat:show-hint 'resize)))
(repeat:show-hint "neither a keymap nor #f")
; A key sequence found in the repeating keymap goes on repeating, and
; shows the hint.
> (commands:define-command (stay) "Does nothing." (void))
> (keys:bind! layout-split:resize-keymap "C-c m" stay)
> (press! c1 "C-x" "}" "C-c" "m")
> (list (keymap-names c1) (echo-area:current-message))
((layout-split:resize-keymap layout:keymap keys:global) "Repeat with }, {, v, C-c m")
; A click ends the repetition without clearing the echo area, so the
; hint goes when the repetition ends.
> (keys:bind! keys:global "<mouse-1>" stay)
> (define (click) (press! c1 (list "<mouse-1>" (views:%make-posn (layout:selected-view) 0))))
> (click)
> (list (keymap-names c1) (echo-area:current-message))
((layout:keymap keys:global) #f)
; A click bound in the keymap replaces the hint rather than adding to
; it.
> (keys:bind! layout-split:resize-keymap "<mouse-1>" layout-split:enlarge)
> (press! c1 "C-x" "}")
> (click)
> (click)
> (list (weights) (keymap-names c1) (echo-area:current-message))
((2/5 8/5) (layout-split:resize-keymap layout:keymap keys:global) "Repeat with }, {, v, C-c m, <mouse-1>")
; Unloading the plugin ends the repetition and takes the hint back.
> (unload-module! '(repeat))
> (list (keymap-names c1) (echo-area:current-message))
((layout:keymap keys:global) #f)
