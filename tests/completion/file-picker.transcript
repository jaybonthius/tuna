; C-x C-f reads a file name from the current buffer's directory, else
; the home folder, with ~ for it; directories end in /.
> (define notes (buffers:make "notes" "one\ntwo\nthree\n"))
> (views:set-buffer! (view) notes)
> (define t (start! (lambda () (press! "C-x" "C-f"))))
> (input)
"~/"
> (type! "src/")
> (timers:sleep 0.3)
> (texts (session))
(".hidden" "blob.bin" "link.txt" "text.txt")
> (type! "te")
> (timers:sleep 0.3)
> (press! "RET")
> (result t)
> (files:path (views:buffer (view)))
"$HOME/src/text.txt"
; A path that does not exist is taken too, with ~ expanded.
> (define t (start! (lambda () (file-picker:read-file-name "File: "))))
> (minibuffer:input (prompt))
"~/src/"
> (type! "new.txt")
> (timers:sleep 0.3)
> (press! "RET")
> (let ([p (result t)]) (string=? p (string-append (getenv "HOME") "/src/new.txt")))
#t
> (file-picker:file-name-history)
("~/src/new.txt" "~/src/text.txt")
; C-x C-f asks for a name through ask:file-name, as files does, whose
; reader file-picker fills when it loads and takes back when it unloads;
; a reader set in its place answers C-x C-f too.
> (eq? (ask:file-name-reader) file-picker:read-file-name)
#t
> (define asked '())
> (options:set! ask:file-name-reader (lambda (question) (set! asked (cons question asked)) "~/src/other.txt"))
> (views:set-buffer! (view) notes)
> (define t (start! (lambda () (press! "C-x" "C-f"))))
> (result t)
> (list asked (files:path (views:buffer (view))))
(("Find file: ") "$HOME/src/other.txt")
> (options:unset! ask:file-name-reader)
; The configuration imports file-picker, so its re-read loads a new
; instance at once, which fills the reader and binds C-x C-f again.
> (define old (module-owner '(file-picker)))
> (unload-owner! old)
> (list (owner-live? old) (eq? (module-owner '(file-picker)) old))
(#f #f)
> (eq? (ask:file-name-reader) file-picker:read-file-name)
#t
> (eq? (keys:lookup client "C-x C-f") file-picker:find-file)
#t
; The file reader expands a directory part that does not exist, component
; by component, and its candidates follow the part that does: choosing
; one replaces the rest.
> (define t (start! (lambda () (file-picker:read-file-name "File: " "~/"))))
> (type! "c/t/m")
> (timers:sleep 0.3)
> (texts (session))
("code/tuna/main.sls")
> (press! "RET")
> (let ([p (result t)]) (substring p (string-length (getenv "HOME")) (string-length p)))
"/code/tuna/main.sls"
> (define t (start! (lambda () (file-picker:read-file-name "File: " "~/"))))
> (type! "n/s")
> (timers:sleep 0.3)
> (texts (session))
("notes/sub/")
> (press! "TAB")
> (input)
"~/notes/sub/"
> (timers:sleep 0.3)
> (texts (session))
("b.sls")
> (press! "C-g")
! &cancelled
; At the name of a folder, ending in /, no match is selected, so RET
; answers with the folder; C-n selects its first entry, and a name that
; is not a folder's selects the first match again. Each listing is done,
; so the read is not busy, and the file read before sorts first.
> (define t (start! (lambda () (file-picker:read-file-name "File: " "~/src/"))))
> (timers:sleep 0.3)
> (list (input) (selected-text (session)) (completion:session-busy? (session)))
("~/src/" #f #f)
> (texts (session))
("text.txt" ".hidden" "blob.bin" "link.txt")
> (press! "C-n")
> (selected-text (session))
"text.txt"
> (type! "te")
> (timers:sleep 0.3)
> (selected-text (session))
"text.txt"
> (press! "C-g")
! &cancelled
> (define t (start! (lambda () (file-picker:read-file-name "File: " "~/src/"))))
> (timers:sleep 0.3)
> (press! "RET")
> (let ([p (result t)]) (substring p (string-length (getenv "HOME")) (string-length p)))
"/src/"
; A ~/ or // typed after a folder starts the name again, as Emacs's
; substitute-in-file-name: the listing and the answer come from the
; restarted name, and the part before it is drawn in its own face,
; file-picker:discarded, inside the shadow face, as Emacs's
; file-name-shadow-mode dims it.
> (define (shadowed)
    (let* ([p (prompt)] [b (views:buffer (minibuffer:prompt-view p))] [s (minibuffer:input-start p)])
      (map (lambda (span) (list (- (car span) s) (- (cadr span) s) (caddr span)))
           (apply append (map (lambda (l) (buffers:spans l s (minibuffer:input-end p))) (buffers:layers b))))))
> (define (drawn-shadow)
    (let ([html (lines-html (minibuffer:prompt-view (prompt)))] [face "<span data-face=\"shadow\"><span data-face=\"file-picker.discarded\">"])
      (let loop ([i 0])
        (cond
          [(> (+ i (string-length face)) (string-length html)) #f]
          [(string=? (substring html i (+ i (string-length face))) face)
           (substring html (+ i (string-length face)) (+ i (string-length face) 8))]
          [else (loop (+ i 1))]))))
> (define t (start! (lambda () (file-picker:read-file-name "File: " "~/notes/"))))
> (shadowed)
()
> (type! "~/src/")
> (timers:sleep 0.3)
> (list (input) (shadowed) (texts (session)))
("~/notes/~/src/" ((0 8 ((face file-picker.discarded shadow)))) (".hidden" "blob.bin" "link.txt" "text.txt"))
> (drawn-shadow)
"~/notes/"
> (type! "te")
> (timers:sleep 0.3)
> (press! "RET")
> (let ([p (result t)]) (substring p (string-length (getenv "HOME")) (string-length p)))
"/src/text.txt"
; The history keeps the name as the read answered it.
> (car (file-picker:file-name-history))
"~/src/text.txt"
> (define t (start! (lambda () (file-picker:read-file-name "File: " "~/notes/"))))
> (type! "/")
> (timers:sleep 0.3)
> (list (input) (shadowed) (and (member "tmp/" (texts (session))) #t))
("~/notes//" ((0 8 ((face file-picker.discarded shadow)))) #t)
> (press! "DEL")
> (shadowed)
()
> (press! "C-g")
! &cancelled
; The rule and the prompts it applies to are offered, so a plugin can act
; on the discarded part, as Vertico's vertico-directory-tidy deletes it.
> (map file-picker:substitute-file-name '("~/a/~/b" "/a//b//c" "/a/~x/c" "~/notes/"))
("~/b" "/c" "/a/~x/c" "~/notes/")
; It runs after the command, as Vertico's runs after it, since the
; command that typed still places its cursor.
> (define (tidy command)
    (let ([p (minibuffer:current-prompt)])
      (when (and p (file-picker:file-name-prompt? p))
        (let* ([input (minibuffer:input p)]
               [n (- (string-length input) (string-length (file-picker:substitute-file-name input)))])
          (when (> n 0)
            (minibuffer:set-input! p (substring input n (string-length input))))))))
> (hooks:add! commands:after-command tidy)
> (define t (start! (lambda () (file-picker:read-file-name "File: " "~/notes/"))))
> (type! "~/")
> (list (input) (shadowed))
("~/" ())
> (press! "C-g")
! &cancelled
> (hooks:remove! commands:after-command tidy)
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (list (file-picker:file-name-prompt? (prompt)) (begin (type! "a//b") (shadowed)))
(#f ())
> (press! "C-g")
! &cancelled
> (file-picker:file-name-prompt? 'p)
! file-picker:file-name-prompt?: not a prompt with irritant p
> (file-picker:substitute-file-name 'p)
! file-picker:substitute-file-name: not a string with irritant p
