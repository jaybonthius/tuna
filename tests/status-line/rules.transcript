; The plugin's seven segments, in their places: the modified mark, the
; buffer's name, the position, the percent position and the region size
; on the left, the major and minor modes' lighters on the right. A
; status line is a footer marked with status-line:keymap; a segment is a
; span, or a button marked with its keymap when it has one; the right
; side's are in their own element.
> (define (marks-of keymap) (format "data-keymap=\"~a\"" (views:keymap-mark keymap)))
> (define drawn (html->string (status-line:draw (view) client)))
> (string=? (substring drawn 0 (search drawn ">" 0)) (string-append "<footer class=\"status-line\" " (marks-of status-line:keymap)))
#t
> (let ([i (search drawn "<div class=\"status-line-right\">" 0)])
    (list (map car (segments-in (substring drawn 0 i))) (map car (segments-in (substring drawn i (string-length drawn))))))
(("status-line:modified" "status-line:buffer-name" "status-line:position" "status-line:percent-position" "status-line:region-size") ("status-line:major-mode" "status-line:minor-modes"))
