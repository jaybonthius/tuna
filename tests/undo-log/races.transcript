; Races between the main thread, the log's writer and quits.
> (import (plugins) (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define (reload! name) (reload-modules! (list (list (string->symbol name)))))
> (define (states b) (map (lambda (s) (list (car s) (cadr s))) (cddr (undo:history b))))
; An edit made while a reload of undo, and so of this plugin, reads a
; buffer's log forms a group of its own on top of the log's history,
; whichever finishes first.
> (checks:write-text! "~/big.txt" "big\n")
> (define big (files:visit "~/big.txt"))
> (define chunk (make-string 1000 #\k))
> (do ([i 0 (+ i 1)]) ((= i 1500)) (buffers:replace! big 1 1 chunk) (timers:sleep 0))
> (define before (states big))
> (testing:wait-until (lambda () (> (checks:log-size "~/big.txt") 1500000)))
> (reload! "undo")
> (buffers:replace! big 1 1 "during")
#<edit 1501>
; Asking for the history while the log is read waits for it.
> (length (states big))
1502
> (let ([after (states big)])
    (list (equal? (list-head after 1501) before) (cadr (list-ref after 1501)) (car (undo:history big))))
(#t 1500 1501)
> (buffers:with-buffer big (commands:run undo:undo 1))
> (list (substring (text big) 0 6) (string-length (text big)))
("kkkkkk" 1500004)
; Unloading this plugin while it reads a log ends the attach: the buffer
; keeps its edits and gets a history that starts where the attach began,
; or the log's when the read was first, and a task waiting for the
; history goes on.
> (reload! "undo")
> (define waiter (spawn-task (lambda (restore) (length (states big)))))
> (unload-owner! (module-owner '(undo-log)))
> (buffers:replace! big 1 1 "after")
#<edit 1503>
> (number? (testing:join waiter))
#t
> (buffers:with-buffer big (commands:run undo:undo 1))
> (list (substring (text big) 0 6) (string-length (text big)))
("kkkkkk" 1500004)
> (load-module! '(undo-log))
#<owner (undo-log) 4>
> (load-module! '(checks))
#<owner (checks) 4>
; Unloading undo, and so this plugin, during a burst of batches waits
; for the writer, so the log holds every group.
> (checks:write-text! "~/burst.txt" "burst\n")
> (define burst (files:visit "~/burst.txt"))
> (do ([i 0 (+ i 1)]) ((= i 300)) (buffers:replace! burst 1 1 "b") (timers:sleep 0))
> (begin (unload-owner! (module-owner '(undo))) (load-module! '(undo)) (load-module! '(undo-log)) (load-module! '(checks)))
#<owner (checks) 5>
> (testing:wait-until (lambda () (guard (c [#t #f]) (= (length (states burst)) 301))))
> (length (states burst))
301
> (buffers:with-buffer burst (commands:run undo:undo 300))
> (text burst)
"burst\n"
; Two visits of one file at once attach one history.
> (checks:write-text! "~/twice.txt" "twice\n")
> (define twice (files:visit "~/twice.txt"))
> (buffers:with-buffer twice (commands:run checks:insert 1 "2"))
#<edit 1>
> (buffers:kill! twice)
#t
> (define visits (map testing:join (map (lambda (i) (spawn-task (lambda (restore) (files:visit "~/twice.txt")))) (iota 2))))
> (list (eq? (car visits) (cadr visits)) (text (car visits)) (states (car visits)))
(#t "twice\n" ((0 #f) (1 0)))
> (buffers:with-buffer (car visits) (commands:run undo:redo 1))
> (text (car visits))
"2twice\n"
; Quits land in typing, undo and redo, in the hooks that record them and
; in the bookkeeping after each batch. A quit that lands in undo leaves
; redo nothing to do, so the storm reports are counted, not shown.
; Afterwards the tree still matches the text, and the log replays to the
; same tree and text.
> (checks:write-text! "~/storm.txt" "storm\n")
> (define storm (files:visit "~/storm.txt"))
> (define quits 0)
> (define reports 0)
> (define (count-quits report c)
    (if (cancelled? c) (set! quits (+ quits 1)) (set! reports (+ reports 1))))
> (advice-add! report count-quits)
> (define armed (box #f))
> (define quitting (box #t))
> (define requests 0)
> (define (quitter)
    (let loop ()
      (when (unbox quitting)
        (chez:sleep (make-time 'time-duration 100000 0))
        (when (box-cas! armed #t #f)
          (testing:request-quit!)
          (set! requests (+ requests 1)))
        (loop))))
> (define steps 0)
> (define (in-storm command . args) (buffers:with-buffer storm (apply commands:run command args)))
> (define (stress until)
    (let again ()
      (guard (c [(cancelled? c) (set! quits (+ quits 1)) (again)])
        (let loop ()
          (when (< (real-time) until)
            (set-box! armed #t)
            (in-storm checks:type "s")
            (in-storm checks:insert 1 "i")
            (in-storm undo:undo 1)
            (in-storm undo:redo 1)
            (timers:sleep 0)
            (set! steps (+ steps 1))
            (loop)))
        (set-box! armed #f)
        (timers:sleep 0.05))))
> (begin
    (fork-task (lambda (restore) (quitter)))
    (stress (+ (real-time) 1500))
    (set-box! quitting #f)
    (list (> steps 30) (> requests 30)))
(#t #t)
> (advice-remove! report count-quits)
> (define final (list (text storm) (states storm) (car (undo:history storm))))
> (undo:go-to! storm 0)
> (text storm)
"storm\n"
> (undo:go-to! storm (caddr final))
> (equal? (list (text storm) (states storm) (car (undo:history storm))) final)
#t
> (reload! "buffers")
> (testing:wait-until (lambda () (= (length (files:buffers)) 4)))
> (define storm (files:visit "~/storm.txt"))
> (equal? (list (text storm) (states storm) (car (undo:history storm))) final)
#t
