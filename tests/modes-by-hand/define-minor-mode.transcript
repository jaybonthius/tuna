; Bad uses are syntax errors naming the form.
> (modes:define-minor-mode bad-mode (lighter "Bad"))
! modes:define-minor-mode: expected (modes:define-minor-mode id doc-string clause ...) (modes:define-minor-mode bad-mode (lighter "Bad"))
> (modes:define-minor-mode bad-mode "Bad." (colour "red"))
! modes:define-minor-mode: invalid clause (colour "red") in (modes:define-minor-mode bad-mode "Bad." (colour "red"))
> (modes:define-minor-mode bad-mode "Bad." (lighter "Bad") (lighter "Worse"))
! modes:define-minor-mode: clause given twice (lighter "Worse") in (modes:define-minor-mode bad-mode "Bad." (lighter "Bad") (lighter "Worse"))
> (modes:define-minor-mode bad-mode "Bad." (state () #t) (default #t))
! modes:define-minor-mode: a state mode has no default or on-change clause (default #t) in (modes:define-minor-mode bad-mode "Bad." (state () #t) (default #t))
> (modes:define-minor-mode bad-mode "Bad." (state () #t) (on-change values))
! modes:define-minor-mode: a state mode has no default or on-change clause (on-change values) in (modes:define-minor-mode bad-mode "Bad." (state () #t) (on-change values))
> (modes:define-minor-mode bad-mode "Bad." (state (b) #t))
! modes:define-minor-mode: a state mode's formals must allow no arguments (state (b) #t) in (modes:define-minor-mode bad-mode "Bad." (state (b) #t))
> (modes:define-minor-mode bad-mode "Bad." (state x))
! modes:define-minor-mode: invalid clause (state x) in (modes:define-minor-mode bad-mode "Bad." (state x))
> (modes:define-minor-mode bad-mode "Bad." (lighter))
! modes:define-minor-mode: invalid clause (lighter) in (modes:define-minor-mode bad-mode "Bad." (lighter))
> (modes:define-minor-mode "bad-mode" "Bad.")
! modes:define-minor-mode: expected (modes:define-minor-mode id doc-string clause ...) (modes:define-minor-mode "bad-mode" "Bad.")
; A keymap clause whose expression is a variable named keymap works.
> (tables:define-table keymap "Keys of a mode defined at the REPL.")
> (modes:define-minor-mode keyed-mode "Whether keyed is on." (keymap keymap))
> (eq? (tables:ref modes:keymaps keyed-mode #f) keymap)
#t
; Clause values are checked as the mode is defined.
> (modes:define-minor-mode bad-mode "Bad." (lighter 'bad))
! modes:define-minor-mode: not a string with irritant bad
> (modes:define-minor-mode bad-mode "Bad." (keymap 5))
! modes:define-minor-mode: not a keymap with irritant 5
> (modes:define-minor-mode bad-mode "Bad." (depth 'high))
! modes:define-minor-mode: not a real number with irritant high
> (modes:define-minor-mode bad-mode "Bad." (majors "python"))
! modes:define-minor-mode: not a mode with irritant "python"
; A majors clause names at least one mode.
> (modes:define-minor-mode bad-mode "Bad." (majors))
! modes:define-minor-mode: invalid clause (majors) in (modes:define-minor-mode bad-mode "Bad." (majors))
> (modes:define-minor-mode bad-mode "Bad." (majors . python:mode))
! modes:define-minor-mode: invalid clause (majors . python:mode) in (modes:define-minor-mode bad-mode "Bad." (majors . python:mode))
; Defined again without a lighter, keymap or majors clause, a mode keeps
; none of the ones it had.
> (tables:define-table again-keymap "Keys of a mode defined twice.")
> (modes:define-minor-mode again-mode "Whether again is on." (lighter "Again") (keymap again-keymap) (majors python:mode))
> (list (modes:lighter again-mode) (eq? (tables:ref modes:keymaps again-mode #f) again-keymap) (tables:ref modes:minor-mode-majors again-mode #f))
("Again" #t (python:mode))
> (modes:define-minor-mode again-mode "Whether again is on.")
