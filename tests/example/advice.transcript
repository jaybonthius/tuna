; These examples take the plugin greet as used.
> (use-plugin greet)
> (define (shout text name) (string-upcase (text name)))
> (advice-add! greet:text shout)
> (greet:text "Zeppo")
"HELLO, ZEPPO!"
; The configuration's advice runs, and stays when the target is redefined.
> (files:save! "a.txt")
saving a.txt
"a.txt"
> (eval-in-module '(define (save! path) (display "[saved]") path) '(files))
> (files:save! "a.txt")
saving a.txt[saved]
"a.txt"
; The last advice is outermost; adding it twice from one module does
; nothing.
> (define (exclaim save! path) (display "!") (save! path))
> (advice-add! files:save! exclaim)
> (advice-add! files:save! exclaim)
> (files:save! "a.txt")
!saving a.txt[saved]
"a.txt"
; Removing (init)'s advice from the REPL is (repl)'s change.
> (advice-remove! files:save! announce)
> (definition-changes files:save!)
((#<owner (repl) 1> removal #<procedure announce>) (#<owner (repl) 1> advice #<procedure exclaim>) (#<owner (init) 1> advice #<procedure announce>) (#<owner (files) 1> define #f))
> (files:save! "b")
![saved]
"b"
; Removing one's own advice puts a removal in its place, which also hides
; the advice of owners ranked below.
> (advice-remove! files:save! exclaim)
> (map car (owner-changes (plugins:repl-owner)))
(removal removal advice)
> (advice-add! files:save! (lambda (save! . arguments) (apply save! arguments)))
> (files:save! "c")
[saved]
"c"
; The target must be a changeable definition.
> (advice-add! files:make-entry exclaim)
! advice-add!: not a changeable procedure with irritant #<procedure make-entry>
> (advice-add! car exclaim)
! advice-add!: not a changeable procedure with irritant #<procedure car>
> (advice-add! files:save! 'exclaim)
! advice-add!: not a procedure with irritant exclaim
