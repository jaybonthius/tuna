()
; An address, bare or in angle brackets, is read whole, as md4c reads
; it, less the punctuation that ends a sentence.
> (markdown:unfinished-blocks "See https://x.example/_private and *more")
((markdown:paragraph ((key . 0)) "See " (markdown:link ((href . "https://x.example/_private")) "https://x.example/_private") " and " (markdown:emphasis () "more") "\n"))
> (markdown:unfinished-blocks "See <https://x.example/a_b> and www.example.com/~user")
((markdown:paragraph ((key . 0)) "See " (markdown:link ((href . "https://x.example/a_b")) "https://x.example/a_b") " and " (markdown:link ((href . "http://www.example.com/~user")) "www.example.com/~user") "\n"))
> (markdown:unfinished-blocks "**https://x.example/a_b** and _see https://x.example/c_d_")
((markdown:paragraph ((key . 0)) (markdown:strong () (markdown:link ((href . "https://x.example/a_b")) "https://x.example/a_b")) " and " (markdown:emphasis () "see " (markdown:link ((href . "https://x.example/c_d")) "https://x.example/c_d")) "\n"))
> (markdown:unfinished-blocks "**https://x.example/a_b")
((markdown:paragraph ((key . 0)) (markdown:strong () (markdown:link ((href . "https://x.example/a_b")) "https://x.example/a_b")) "\n"))
; A setext heading's underline and a quote's line of markers alone end
; the text before them, so what it left open stays.
> (markdown:unfinished-blocks "**bold\n---")
((markdown:heading ((key . 0) (level . 2)) "**bold\n"))
> (map markdown:unfinished-blocks '("> **bold\n>" "> **bold\n> \n"))
(((markdown:quote ((key . 0)) (markdown:paragraph ((key . 0)) "**bold\n"))) ((markdown:quote ((key . 0)) (markdown:paragraph ((key . 0)) "**bold\n"))))
; A link's tail is read as md4c reads it: an address in angle brackets
; holds no <, and a title in parentheses holds no (.
> (map markdown:unfinished-blocks '("[a](<b <c> *d" "[a](b (c (d) *e"))
(((markdown:paragraph ((key . 0)) "[a](<b <c> " (markdown:emphasis () "d") "\n")) ((markdown:paragraph ((key . 0)) "[a](b (c (d) " (markdown:emphasis () "e") "\n")))
; A link cut to its label is not cut again, since the text after the
; label has arrived.
> (markdown:unfinished-blocks "[[a]](")
((markdown:paragraph ((key . 0)) "[a]\n"))
; Hostile text takes time in proportion to its length.
> (define (rep s n) (let ([p (open-output-string)]) (do ([i 0 (+ i 1)]) ((= i n)) (put-string p s)) (get-output-string p)))
> (define (milliseconds thunk) (let ([t0 (current-time 'time-monotonic)]) (thunk) (let ([d (time-difference (current-time 'time-monotonic) t0)]) (+ (* 1000 (time-second d)) (quotient (time-nanosecond d) 1000000)))))
> (filter (lambda (text) (> (milliseconds (lambda () (markdown:unfinished-blocks text))) 1000))
    (list (rep "[" 100000) (string-append (rep "_a " 20000) (rep "a* " 20000)) (string-append (rep "[" 20000) "a" (rep "]" 20000) "(")
          (string-append (rep "[a " 10000) (rep "](c " 10000) "](d") (string-append (rep "[a](<" 20000) ">")))
