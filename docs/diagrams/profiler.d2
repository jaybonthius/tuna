# Where does the profiler get its measurements, without being built into anything?
vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
  }
}
direction: right

classes: {
  part: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 18
    }
  }
  prof: {
    style: {
      fill: "#fff8e1"
      stroke: "#8d6e00"
      font-color: "#3e2f00"
      border-radius: 8
      stroke-width: 3
      font-size: 18
    }
  }
  file: {
    shape: page
    style: {
      fill: "#f4f4f4"
      stroke: "#555555"
      font-color: "#222222"
      font-size: 16
    }
  }
}

legend: |md
  **Status:** built 2026-10-27, stages 1 to 3 of the plan.
  Nothing on the left knows the profiler exists: each offers
  general hooks that any plugin can use. Not built: advice on
  service operations (an open question for the owner).
|

page: Browser page\nmeasures on its own clock:\nkey to send, morph, paint {class: part}
web: Browser connection plugin\ninput arrived, screen ready,\nsent, applied (with the page's times) {class: part}
keys: Key handling plugin\ninput item taken {class: part}
loop: Editor thread (kernel)\ntask started and finished {class: part}
commands: Commands\npre-command and post-command {class: part}
jobs: Jobs library\njob started and finished {class: part}
renderer: Renderer\nredraw started and finished,\npieces rebuilt and reused {class: part}
tick: Clock tick\ncall stacks while sampling {class: part}

profiler: Profiler plugin (optional)\nM-x profiler-mode,\nprofiler-start / profiler-stop {class: prof}
files: "Profile folder\nspans-*.jsonl: one tree per input item\nsamples-*.folded: stack;of;frames count" {class: file}

page -> web: "/applied"
web -> profiler: hooks
keys -> profiler: hook
loop -> profiler: hooks
commands -> profiler: hooks
jobs -> profiler: hooks
renderer -> profiler: hooks
tick -> profiler: samples
profiler -> files: writes
