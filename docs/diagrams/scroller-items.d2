# What does a scroller hold? (built: native scroll bar, 2026-10-21)
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: right

scroller: "A view showing a 50,000-item buffer (the browser scrolls it natively)" {
  grid-columns: 1
  grid-gap: 0
  spacer_above: "Spacer for items 1 to 24,940\n24,940 × 25 px (the measured average) = 623,500 px, empty" {
    style.stroke-dash: 3
    style.fill: "#f4f4f4"
    width: 560
  }
  above: "Drawn: items 24,941 to 24,999\nabout two view heights, as the browser measured" {width: 560}
  visible: "On screen: items 25,000 to 25,027\nscroll state = item 25,000, 8 px above the top edge" {
    style.fill: "#d8e8ff"
    style.bold: true
    width: 560
  }
  below: "Drawn: items 25,028 to 25,083\nabout two view heights, as the browser measured" {width: 560}
  spacer_below: "Spacer for items 25,084 to 50,000\nat the same 25 px each, empty" {
    style.stroke-dash: 3
    style.fill: "#f4f4f4"
    width: 560
  }
}

bar: "The browser's own scroll bar:\nthe spacers make its range the whole buffer,\nso its thumb sits about halfway" {
  shape: rectangle
  style.fill: "#eeeeee"
}

jump: "The page reports how far the top edge is\nfrom the nearest drawn item; Tuna counts items\nfrom there by the same average, makes the item\nthere the scroll state, and draws around it" {
  shape: rectangle
  style.fill: "#ffffff"
}

scroller -> bar: "sizes only, never positions" {style.stroke-dash: 3}
scroller -> jump: "a drag or fling lands in a spacer" {style.stroke-dash: 3}
