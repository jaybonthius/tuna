; A ( and a """ typed at the start of twelve lines of 60 KB of Python,
; the lines around the edit drawn: the drawn range is coloured first and
; whole, the rest in pieces, and the faces end as a highlight from
; nothing gives them.
> (define text (grown-text 60000))
> (define s (open text shipped default-excluded))
> (length (settle! s))
4
> (edit-cases s (spaced-lines text 12) "(")
("(" 7 12 ())
> (edit-cases s (spaced-lines text 12) "\"\"\"")
("\"\"\"" 0 12 ())
; A newer edit is taken between pieces: its drawn lines come next, with
; its colours, before the rest of the older edit's range.
> (define line (find (lambda (line) (car (edit-case s line "("))) (spaced-lines text 12)))
> (define lines (line-count text))
> (define (drawn-around line) (cons (line-start (text-of s) (- line 20)) (line-start (text-of s) (+ line 40))))
> (replace! s (line-start (text-of s) line) (line-start (text-of s) line) "(")
> (session-drawn-set! s (list (drawn-around line)))
> (define-values (first more) (step! s))
> (list (equal? first (list (car (drawn-around line)) (cdr (drawn-around line)))) more)
(#t #t)
> (define-values (second more) (step! s))
> (list (overlap? second first) more)
(#f #t)
> (define far (if (< line (quotient lines 2)) (- lines 400) 400))
> (replace! s (line-start (text-of s) far) (line-start (text-of s) far) "\"\"\"")
> (define d2 (drawn-around far))
> (session-drawn-set! s (list d2))
> (define-values (third more) (step! s))
> (list (equal? third (list (car d2) (cdr d2))) more)
(#t #t)
> (define fresh (highlighted (text-of s) shipped default-excluded))
> (equal? (vector-slice (session-faces s) (car d2) (cdr d2)) (vector-slice (session-faces fresh) (car d2) (cdr d2)))
#t
; A scroll changes the drawn range; what is pending in it comes next.
> (define d3 (drawn-around (if (< line (quotient lines 2)) (- lines 150) 150)))
> (session-drawn-set! s (list d3))
> (define-values (fourth more) (step! s))
> (list (equal? fourth (list (car d3) (cdr d3))) more)
(#t #t)
> (begin (settle! s) (first-difference s fresh))
#f
