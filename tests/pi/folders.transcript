; A chat's buffer gives files:directory the chat's folder, so C-x C-f,
; M-!, M-s r and compile started from it start there.
> (import (file-picker) (shell-commands) (grep) (projects))
> (define (at path) (string-append (getenv "HOME") "/" path))
> (for-each (lambda (f) (mkdir (at f))) '("proj" "proj/src" "other"))
> (with-output-to-file (at "proj/src/notes.txt") (lambda () (display "a needle in proj\n")))
> (with-output-to-file (at "other/notes.txt") (lambda () (display "a needle elsewhere\n")))
> (set-option! projects:extra-root-markers '(".project"))
> (with-output-to-file (at "proj/.project") void)
> (define chat (pi:start (at "proj")))
> (pi-chat:show! chat)
> (define b (pi-chat:buffer chat))
> (in-client (lambda () (layout:switch-to-buffer b)))
> (list (files:directory b) (pi-chat:folder-for b))
("$HOME/proj/" "$HOME/proj")
> (define t (start! (lambda () (press! "C-x" "C-f"))))
> (minibuffer:input (minibuffer:current-prompt))
"~/proj/"
> (press! "C-g")
! &quit
> (result t)
> (define t (start! (lambda () (commands:run shell-commands:shell-command "pwd" #f))))
> (result t)
> (echo)
"$HOME/proj"
> (define t (start! (lambda () (press! "M-s" "r"))))
> (type! "needle")
> (define (texts s)
    (let ([ms (completion:session-matches s)])
      (map (lambda (k) (completion:text s (completion:matches-ref ms k))) (iota (completion:matches-count ms)))))
> (define s (in-client completion:current-session))
> (wait-until (lambda () (and (not (completion:session-busy? s)) (pair? (texts s)))))
> (texts s)
("src/notes.txt:1:a needle in proj")
> (press! "C-g")
! &quit
> (result t)
> (define t (start! (lambda () (commands:run shell-commands:compile "pwd"))))
> (result t)
#<buffer *compilation*>
> (define built (buffers:find "*compilation*"))
> (wait-until (lambda () (runs:status built)))
> (list (runs:status built) (files:directory built))
(0 "$HOME/proj/")
; A chat started in a folder written with .. gives its buffer the folder
; without it, so its project is the one that holds the folder.
> (mkdir (at "proj/sub"))
> (with-output-to-file (at "proj/sub/.project") void)
> (define up (pi:start (at "proj/sub/..")))
> (pi-chat:show! up)
> (define ub (pi-chat:buffer up))
> (list (pi:chat-directory up) (files:directory ub) (pi-chat:folder-for ub) (projects:root (projects:find (files:directory ub))) (buffers:name ub))
("$HOME/proj/sub/.." "$HOME/proj/" "$HOME/proj" "$HOME/proj/" "*pi: proj*<2>")
