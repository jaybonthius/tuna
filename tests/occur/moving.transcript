; M-n goes to the end of the next match, match by match; from inside a
; match, to its end. Past the last: No more matches, point unmoved.
> (define b (src "one foo\ntwo\nfoo three foo\nfour\nfive foo\n"))
> (occur! (search:make-query "foo" search:regexp) 0 #f)
> (in-occur!)
> (press! "M-n")
> (where)
> (press! "M-n")
> (where)
> (press! "M-n")
> (where)
> (views:set-point! (view) (- (views:point (view)) 2))
> (press! "M-n")
> (where)
(1 "one foo")
(3 "foo")
(3 "foo three foo")
(3 "foo three foo")
; M-p goes to the end of the previous match.
> (press! "M-p")
> (where)
(3 "foo")
; Digits count; a negative count turns M-n backward.
> (press! "2" "M-n")
> (where)
> (press! "M-n")
> (where)
> (press! "-" "M-n")
> (where)
> (press! "-" "M-p")
> (where)
> (views:set-point! (view) 2)
> (press! "M-p")
> (where)
(5 "five foo")
! occur:next: No more matches
(5 "five foo")
(3 "foo three foo")
(5 "five foo")
! occur:previous: No earlier matches
(heading "")
; n moves from the line's end to the next match, shows its line's
; first match in another view, highlighted, *Occur* selected, and says
; so.
> (views:set-point! (view) (find-text (occur-buffer) "one foo"))
> (press! "n")
> (list (where) (wins) (last-message))
> (define (lit) (filter (lambda (f) (string=? (car f) "occur.visited"))
                        (faced (html->string (views:draw (find (lambda (v) (eq? (views:buffer v) (buffers:find "src"))) (layout:views)) client)))))
> (list (lit) (marked))
> (views:set-point! (view) (find-text (occur-buffer) "one foo"))
> (press! "2" "n")
> (list (where) (wins))
((3 "foo") (("src" 13 #f) ("*Occur*" 63 #t)) "Next locus from *Occur*")
((("occur.visited" "foo") ("occur.visited" "foo")) 3)
((3 "foo three foo") (("src" 13 #f) ("*Occur*" 73 #t)))
; p from the line's start goes to the previous match, the last on a
; line with two.
> (views:set-point! (view) (find-text (occur-buffer) "five foo"))
> (press! "p")
> (list (where) (wins) (last-message))
> (list (lit) (marked))
> (views:set-point! (view) (find-text (occur-buffer) "one foo"))
> (press! "p")
> (views:set-point! (view) (find-text (occur-buffer) "five foo"))
> (press! "n")
> (where)
((3 "foo three foo") (("src" 13 #f) ("*Occur*" 73 #t)) "Previous locus from *Occur*")
((("occur.visited" "foo") ("occur.visited" "foo")) 3)
! occur:show-previous: No more matches
! occur:show-next: No more matches
(5 "")
; n and p act in the current *Occur*, even when another was listed
; later.
> (press! "r")
> (define first-listing (views:buffer (view)))
> (define c (buffers:make "src2" "x foo\ny foo\n"))
> (layout:switch-to-buffer c)
> (occur! (search:make-query "foo" search:regexp) 0 #f)
> (define first-view (find (lambda (v) (eq? (views:buffer v) first-listing)) (layout:views)))
> (layout:select! (or first-view (begin (views:set-buffer! (view) first-listing) (view))))
> (views:set-point! (view) (find-text first-listing "one foo"))
> (press! "n")
> (list (buffers:name (views:buffer (view))) (last-message))
("*Occur: src*" "Next locus from *Occur: src*")
