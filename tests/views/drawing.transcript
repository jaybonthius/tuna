> (show across)
<div class="view" data-view="75" data-version="0" data-showing="0" data-placement="*" data-place-line="2" data-place-align="center" data-place-offset="0" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end style="white-space:pre"><div class="view-lines"><article><div class="node" data-at="1" data-to="11"><div class="line" id="v75-1" data-line="1" data-at="2">one</div><div class="line" id="v75-2" data-line="2"><span class="cursor primary"></span><br></div></div><span class="fold" data-at="6" data-to="21">…</span><div class="node" data-at="19" data-to="31"><div class="line" id="v75-4" data-line="4" data-at="21">our</div><div class="line" id="v75-5" data-line="5">five</div></div></article></div></div>
; A span-properties entry that returns no list of attribute names and
; values goes to report once a draw, and its span draws without it.
> (table-set! views:span-properties 'odd (lambda (v) (list 5 (cons "ok" "y"))))
> (buffers:add-span! (buffers:layer notes marks) 17 18 '((odd . 1)))
> (buffers:add-span! (buffers:layer notes marks) 19 20 '((odd . 2)))
> (html? (views:draw n #f))
! views:span-properties: not a list of attribute names and values with irritants (odd (5 ("ok" . "y")))
! car: 1 is not a pair
#t
; Atoms naming one view at one position in two buffers draw the view and
; a copy.
> (define chat2 (buffers:make "chat2" (md:doc '() (views:view `((view . ,(views:id first)) (buffer . "buy"))))))
> (define cv (views:make chat2))
> (begin (views:draw cv #f) (numbers-after (html->string (views:draw lv #f)) "data-view=\""))
(9 10 77 70 71)
; The region is drawn inside every layer's spans, as Emacs draws it above
; faces, so a face's background cannot hide it; it is cut where they
; begin and end.
> (define code (buffers:make "code" "(define x 1)\n"))
> (define cview (views:make code))
> (buffers:add-span! (buffers:layer code hints) 2 8 '((face . keyword)))
> (buffers:add-span! (buffers:layer code marks) 9 10 '((face . (spell.misspelled variable))))
> (views:set-point! cview 5)
> (views:set-mark! cview 12)
> (let ([html (html->string (views:draw cview #f))]) (substring html (search html "<div class=\"line\"" 0) (search html "</div>" 0)))
"<div class=\"line\" id=\"v78-1\" data-line=\"1\" data-at=\"1\">(<span data-face=\"keyword\">def<span class=\"cursor primary\"></span><span class=\"region\">ine</span></span><span class=\"region\"> </span><span data-face=\"variable\"><span data-face=\"spell.misspelled\"><span class=\"region\">x</span></span></span><span class=\"region\"> 1</span>)"
