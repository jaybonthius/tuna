; With no backend for the buffer, the commands say so.
> (press! "M-.")
! xref:find-definitions: No xref backend
; A backend from a local entry of the buffers under ~/code. One
; definition goes there, a jump into another file recording one place,
; so M-, returns.
> (define uses (files:visit (string-append code "/uses.txt")))
> (in-client (lambda () (layout:switch-to-buffer uses)))
> (define (to-word! word line)
    (let* ([doc (buffers:document uses)] [start (document:line-start doc line)]
           [text (document:text doc start (document:length doc))])
      (let loop ([i 0])
        (if (string=? (substring text i (+ i (string-length word))) word)
            (views:set-point! (view) (+ start i 1))
            (loop (+ i 1))))))
> (to-word! "average" 2)
> (press! "M-.")
> (list (here) (places))
(("defs.txt" 2) (("uses.txt" 2)))
> (press! "M-,")
> (here)
("uses.txt" 2)
; Several ask through xref:choose-and-go, each labelled by its path, line
; and summary.
> (to-word! "total" 1)
> (define t (start! (lambda () (press! "M-."))))
> (define s (session))
> (wait-matches s)
> (texts s)
("~/code/defs.txt:1: def total" "~/code/sub/twice.txt:2: def total")
> (press! "C-n" "RET")
> (result t)
> (list (here) (places))
(("twice.txt" 2) (("uses.txt" 1)))
> (press! "M-,")
; A quit while choosing records nothing.
> (define t (start! (lambda () (press! "M-."))))
> (press! "C-g")
! &quit
> (result t)
> (list (here) (places))
(("uses.txt" 1) ())
; A display that returns at once, as a list would, leaves the command
; ended, and the place it started from recorded.
> (define shown '())
> (set-option! xref:definitions-display (lambda (items title) (set! shown (list title (length items)))))
> (define t (start! (lambda () (press! "M-."))))
> (list (task-done? t) shown (here) (places))
(#t ("Definitions of total" 2) ("uses.txt" 1) (("uses.txt" 1)))
> (remove-option! xref:definitions-display)
; C-u M-. asks, completing over the backend's identifiers with the one at
; point as the default, and takes a name that is not one.
> (define t (start! (lambda () (press! "C-u" "M-."))))
> (define s (session))
> (type! "ta")
> (wait-matches s)
> (texts s)
("total" "tally")
> (press! "C-a" "C-k")
> (type! "zzz")
> (press! "RET")
! xref:find-definitions: No definitions found for: zzz
> (result t)
; M-? asks by default, as xref:prompt-for-identifier lists it; RET on
; the empty input takes the one at point.
> (define t (start! (lambda () (press! "M-?"))))
> (minibuffer:prompt? (minibuffer:current-prompt))
#t
> (press! "RET")
> (define s (session))
> (wait-matches s)
> (texts s)
("~/code/uses.txt:1: x = total" "~/code/uses.txt:2: y = average + total")
> (press! "C-g")
! &quit
> (result t)
> (set-option! xref:prompt-for-identifier #f xref:auto-jump-to-first-reference? #t)
> (to-word! "total" 2)
> (press! "M-?")
> (here)
("uses.txt" 1)
> (set-option! xref:prompt-for-identifier #t)
> (define t (start! (lambda () (press! "M-."))))
> (minibuffer:prompt? (minibuffer:current-prompt))
#t
> (press! "C-g")
! &quit
> (result t)
> (remove-option! xref:prompt-for-identifier xref:auto-jump-to-first-reference?)
; A jump to an item runs jump-history:after-jump, whose entry recentres.
> (define jumped '())
> (add-hook! jump-history:after-jump (lambda (v) (set! jumped (cons (buffers:name (views:buffer v)) jumped))))
> (to-word! "average" 2)
> (press! "M-.")
> jumped
("defs.txt")
; xref:show-items shows a command's own items and records the place.
> (press! "M-,")
> (define items (list (xref:make-item "a" (string-append code "/defs.txt") 3 4 "Function") (xref:make-item "b" (string-append code "/uses.txt") 1 0)))
> (map (lambda (i) (list (xref:item-summary i) (xref:item-line i) (xref:item-column i) (xref:item-kind i))) items)
(("a" 3 4 "Function") ("b" 1 0 #f))
> (commands:define-command (show-two) "Shows two items." (xref:show-items items "Found"))
> (keys:bind! keys:global "C-c x" show-two)
> (define t (start! (lambda () (press! "C-c" "x"))))
> (define s (session))
> (wait-matches s)
> (texts s)
("~/code/defs.txt:3: a" "~/code/uses.txt:1: b")
> (press! "RET")
> (result t)
> (list (here) (car (places)))
(("defs.txt" 3) ("uses.txt" 2))
