; g refreshes through buffers:revert-function, with the hooks
; around it; point stays on its section.
> (ui:show-section! (view) (section '(untracked . #f)))
> (go-to-section! '(file . "b.txt") '(unstaged . #f))
> (press! "g")
> (settle!)
> (list (reverse events) (point-line) (and (member "outside.txt" (status)) #t))
(((before "repo") (after "repo")) "modified   b.txt" #t)
> (eq? (buffers:with-buffer (status-buffer) (buffers:revert-function)) git-mode:refresh)
#t
; a command of the repository refreshes every Git buffer of it,
; and git:command-ended names the command.
> (set! events '())
> (press! "$")
> (settle!)
> (define log (views:buffer (view)))
> (press! "C-x" "o")
> (go-to-section! '(file . "outside.txt") '(untracked . #f))
> (press! "s")
> (settle!)
> (list (reverse events) (short))
(((before "repo") (after "repo")) " M a.py\nMM b.txt\n D gone.txt\n M long.txt\nA  outside.txt\n?? new.txt\n")
> (buffers:name log)
"*git-commands: repo*"
> (let ([d (document:text (buffers:document log))]) (substring d 0 (min 60 (string-length d))))
"  0 git … add --pathspec-from-file=- --pathspec-file-nul\n"
; G refreshes every Git buffer of the repository.
> (set! events '())
> (press! "G")
> (settle!)
> (reverse events)
((before "repo") (after "repo"))
; commands typed while git runs act in order, each on the buffer the
; one before left: s s s stages three files in turn.
> (go-to-section! '(file . "a.py") '(unstaged . #f))
> (press! "s" "s" "s")
> (settle!)
> (short)
"M  a.py\nM  b.txt\nD  gone.txt\n M long.txt\nA  outside.txt\n?? new.txt\n"
> (point-line)
"modified   long.txt"
; saving a file changes nothing, unless git-status:refresh-after-save
; is in files:after-save.
> (write-file! "repo/r4.txt" "r4\n")
> (sh "cd repo && git add r4.txt && git commit -qm r4 -- r4.txt")
> (git-mode:refresh-repository repo)
> (define c (files:visit (at "repo/r4.txt")))
> (buffers:insert! c 1 "top\n")
5
> (files:save-buffer c)
> (settle!)
> (and (section '(file . "r4.txt") '(unstaged . #f)) #t)
#f
> (hooks:add! files:after-save git-status:refresh-after-save)
> (buffers:insert! c 1 "top\n")
5
> (sh "cd repo && git add r4.txt")
> (files:save-buffer c)
> (testing:wait-until (lambda () (and (section '(file . "r4.txt") '(unstaged . #f)) #t)))
> (and (section '(file . "r4.txt") '(unstaged . #f)) #t)
#t
> (hooks:remove! files:after-save git-status:refresh-after-save)
; git-mode:save-repository-buffers save saves without asking, never
; leaves the buffer.
> (buffers:insert! c 1 "again\n")
7
> (options:set! git-mode:save-repository-buffers (git-mode:saving save))
> (press! "g")
> (settle!)
> (list (take-asked!) (buffers:modified? c))
(() #f)
> (buffers:insert! c 1 "never\n")
7
> (options:set! git-mode:save-repository-buffers (git-mode:saving never))
> (press! "g")
> (settle!)
> (list (take-asked!) (buffers:modified? c))
(() #t)
> (files:save-buffer c)
> (options:set! git-mode:save-repository-buffers (git-mode:saving ask))
; a command that changes files reverts the unmodified buffers
; visiting them, unless git-mode:revert-buffers? is #f.
> (define a (files:visit (at "repo/a.py")))
> (sh "cd repo && git reset -q && git checkout -q -- a.py")
> (options:set! git-mode:revert-buffers? #f)
> (sh "cd repo && echo more >> a.py")
> (press! "g")
> (settle!)
> (substring (document:text (buffers:document a)) 0 4)
"one\n"
> (options:set! git-mode:revert-buffers? #t)
> (press! "g")
> (settle!)
> (let ([t (document:text (buffers:document a))]) (substring t (- (string-length t) 5) (string-length t)))
"more\n"
; while a refresh runs, the buffer keeps its contents and its keys
; work, until the new contents come in one rewrite.
> (define edits 0)
> (hooks:add! buffers:after-edit (lambda (b e) (when (eq? b (status-buffer)) (set! edits (+ edits 1)))))
> (sh "cd repo && echo r8 > r8.txt")
> (define before (status))
> (define refreshing (spawn-task (lambda (restore) (git-mode:refresh-repository repo))))
> (list (equal? (status) before) edits)
(#t 0)
> (press! "n")
> (testing:join refreshing)
