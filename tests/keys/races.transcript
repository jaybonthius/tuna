; Keys across threads, quits and reloads: only the main thread presses,
; looks up and pushes; any thread turns items into keys and reads
; bindings; quits leave each frame's session whole.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define one (layout:current-frame))
> (define-table km)
> (keys:bind! km "a" layout:other-view)
> (map on-thread
    (list (lambda () (keys:press! one "a"))
          (lambda () (keys:lookup one "a"))
          (lambda () (keys:active-keymaps one))
          (lambda () (keys:where-is one layout:other-view))
          (lambda () (keys:pending one))
          (lambda () (keys:push-keymap! one km (lambda (f c) #t)))
          (lambda () (keys:bind! km "b" layout:other-view))
          (lambda () (keys:remap! km layout:other-view files:find-file))
          (lambda () (keys:unbind! km "a"))
          (lambda () (length (keys:bindings km)))
          (lambda () (list (keys:command-keys) (keys:typed-char) (keys:shift-translated?)))
          (lambda () (keys:item-key '(("key" . "x") ("code" . "KeyX") ("modifiers" . #("control")))))))
((keys:press! "not on the main thread") (keys:lookup "not on the main thread") (keys:active-keymaps "not on the main thread") (keys:where-is "not on the main thread") (keys:pending "not on the main thread") (keys:push-keymap! "not on the main thread") (keys:bind! "not on the main thread") (keys:remap! "not on the main thread") (table-remove! "only the main thread makes changes") 1 (#f #f #f) "C-x")
> (define end (keys:push-keymap! one km (lambda (f c) #t)))
> (on-thread end)
(keys:push-keymap! "not on the main thread")
> (end)
; Threads turning items into keys while the main thread changes the
; options see one setting or the other, never a mix.
> (define option-item '(("key" . "≈") ("code" . "KeyX") ("modifiers" . #("left-option"))))
> (define plain-item '(("key" . "X") ("code" . "KeyX") ("modifiers" . #("control" "shift"))))
> (define converting #t)
> (define bad '())
> (define converted 0)
> (define (converter)
    (let loop ()
      (when converting
        (let ([a (keys:item-key option-item)] [b (keys:item-key plain-item)])
          (unless (and (member a '("M-x" "≈")) (equal? b "C-X"))
            (set! bad (cons (list a b) bad))))
        (set! converted (+ converted 1))
        (loop))))
> (begin
    (for-each (lambda (i) (fork-thread converter)) '(1 2 3 4))
    (do ([i 0 (+ i 1)]) ((= i 20000)) (set-option! keys:left-option-meta? (even? i)))
    (set! converting #f)
    (remove-option! keys:left-option-meta?)
    (list (> converted 1000) bad))
(#t ())
; Threads reading a keymap's bindings while the main thread binds and
; unbinds see whole lists.
> (define reading #t)
> (define reads 0)
> (define (reader)
    (let loop ()
      (when reading
        (let ([bs (keys:bindings km)])
          (unless (and (list? bs) (for-all (lambda (b) (and (string? (car b)) (procedure? (cdr b)))) bs))
            (set! bad (cons bs bad))))
        (set! reads (+ reads 1))
        (loop))))
> (begin
    (for-each (lambda (i) (fork-thread reader)) '(1 2 3 4))
    (do ([i 0 (+ i 1)]) ((= i 5000))
      (let ([k (format "C-c ~a ~a" (mod i 7) (mod i 9))])
        (if (even? i) (keys:bind! km k layout:other-view) (keys:unbind! km k))))
    (set! reading #f)
    (list (> reads 100) bad))
(#t ())
; Quits requested every millisecond land in presses, lookups, prefix
; arguments, commands and temporary keymaps. Afterwards each frame's
; session is whole: two C-g clear it, and keys work as before.
> (import (repeat))
> (keys:bind! keys:global "C-c o" repeat:other-view-repeat)
> (keys:bind! keys:global "C-x C-f" files:find-file)
> (keys:bind! keys:global "M-x" editing:next-line)
> (define quits-reported 0)
> (define (count-quits report c)
    (if (quit-condition? c) (set! quits-reported (+ quits-reported 1)) (report c)))
> (advice-add! report count-quits)
> (define quits-caught 0)
> (define presses 0)
> (define quitting #t)
> (define stopped #f)
> (define (quitter)
    (let loop ()
      (if quitting
          (begin
            (request-quit!)
            (chez:sleep (make-time 'time-duration 1000000 0))
            (loop))
          (set! stopped #t))))
> (define keys-pressed
    '("C-u" "C-x" "C-f" "C-c" "o" "o" "C-n" "ESC" "x" "M-5" "1" "C-x" "o" "C-g" "a" "C-x" "ESC" "C-g"))
> (define warnings 0)
> (define (stress until)
    (let again ()
      (guard (c [(quit-condition? c) (set! quits-caught (+ quits-caught 1)) (again)])
        (with-exception-handler
          (lambda (c) (if (warning? c) (set! warnings (+ warnings 1)) (raise-continuable c)))
          (lambda ()
            (let loop ()
              (when (< (real-time) until)
                (for-each (lambda (k) (keys:press! one k) (set! presses (+ presses 1))) keys-pressed)
                (loop))))))))
> (begin
    (fork-thread quitter)
    (stress (+ (real-time) 1500))
    (set! quitting #f)
    (let wait ()
      (guard (c [(quit-condition? c) (set! quits-caught (+ quits-caught 1)) (wait)])
        (let spin () (unless stopped (spin)))
        (let settle ([n 0]) (when (< n 100000) (settle (+ n 1))))))
    (list (> (+ quits-reported quits-caught) 100) (> presses 1000)))
(#t #t)
> (advice-remove! report count-quits)
> (let ([p (keys:pending one)]) (or (not p) (and (keys:lookup one p) #t)))
#t
> (press-all! one "C-g" "C-g")
> (list (keys:pending one) (map name-of (keys:active-keymaps one)))
(#f (keys:global))
> (define dropped (list (files:take!) (editing:take!)))
> (press-all! one "C-u" "C-x" "C-f" "x" "ESC" "x")
> (list (files:take!) (editing:take!))
((("notes.txt" (4))) ((self-insert #\x 1) (next-line 1)))
; Reloading the plugin ends every temporary keymap, starts each frame's
; session afresh, reloads the modules that import it, and keeps the
; configuration's and the REPL's bindings.
> (import (tuna eval))
> (define exits 0)
> (define-table t)
> (define end-t (keys:push-keymap! one t (lambda (f c) #t) (lambda () (set! exits (+ exits 1)))))
> (keys:press! one "C-x")
> (eval-file (string-append (getenv "TUNA_LIBRARY") "/keys.sls"))
> (list exits (keys:pending one) (map name-of (keys:active-keymaps one)))
(1 #f (keys:global))
> (map (lambda (k) (name-of (keys:lookup one k))) '("C-c g o" "C-c o" "C-x o" "C-g" "M-5" "C-n"))
(groucho:browse-remote repeat:other-view-repeat layout:other-view keys:keyboard-quit keys:digit-argument editing:next-line)
> (press-all! one "C-u" "C-x" "C-f")
> (files:take!)
(("notes.txt" (4)))
> (end-t)
> exits
1
