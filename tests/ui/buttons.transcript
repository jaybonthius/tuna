; A button or link kind binds a click and RET to its command, and a press
; or a drag to keys:ignore, so a click on one selects no view and moves
; no point.
> (define pushed '())
> (commands:define-command (note [button (ui:pushed-button)])
    "Notes the button pushed."
    (set! pushed (cons (document:node-attribute button 'n) pushed)))
> (ui:define-button go note)
> (ui:define-link more note)
> (map (lambda (b) (cons (car b) (commands:command-name (cdr b)))) (keys:bindings go-keys))
(("<mouse-1>" . note) ("RET" . note) ("<down-mouse-1>" . keys:ignore) ("<drag-mouse-1>" . keys:ignore))
> (define b (buffers:make "*buttons*" (buffers:text '() "Run " (go '((n . 1)) "Go") " or " (more '((n . 2)) "more") "\n")))
> (show! b)
> (element (view) "<button class=\"ui-button\"" "button")
"<button class=\"ui-button\" type=\"button\" tabindex=\"-1\"><span data-at=\"6\">Go</span></button>"
> (element (view) "<button class=\"ui-link\"" "button")
"<button class=\"ui-link\" type=\"button\" tabindex=\"-1\"><span data-at=\"14\">more</span></button>"
> (views:set-point! (view) 3)
> (click-at! (view) 7)
> (click-token! (view) 13)
> (list pushed (views:point (view)))
((2 1) 3)
; A click on a button runs its command for the view clicked: a view of
; the buffer that is not selected, and keeps it unselected.
> (define other (views:make b))
> (eq? other (view))
#f
> (click-at! other 15)
> (list pushed (views:id (view)))
((2 2 1) 1)
; RET with point in a button pushes it; outside every button, RET is
; whatever else binds it, and the command's parameter raises.
> (views:set-point! (view) 7)
> (press! "RET")
> pushed
(1 2 2 1)
> (views:set-point! (view) 2)
> (raised (lambda () (in-client (lambda () (commands:run note (ui:pushed-button))))))
(ui:pushed-button "no button is at the click or at point")
; The node a click names is the button's even when its label holds
; other nodes.
> (buffers:define-kind em (inline))
> (buffers:replace! b 1 1 (go '((n . 3)) (em '() "Bold")))
#<edit 1>
> (click-at! (view) 4)
> (car pushed)
3
; A click on the label of a button whose module is gone finds no
; button.
> (define c (buffers:make "*gone*" "\n"))
> (with-output-to-file (string-append (getenv "HOME") "/.config/tuna/lib/gone.sls")
    (lambda ()
      (display "#!tuna\n")
      (write '(import (ui) (commands)))
      (write '(commands:define-command (hi) "Hi." (display "hi\n")))
      (write '(ui:define-button bye hi))))
> (load-module! '(gone))
> (buffers:replace! c 1 1 (list 'gone:bye '() "Bye"))
#<edit 1>
> (show! c)
> (click-at! (view) 3)
hi
> (unload-module! '(gone))
> (buffers:kind 'gone:bye)
#f
> (views:set-point! (view) 3)
> (raised (lambda () (in-client (lambda () (ui:pushed-button)))))
(ui:pushed-button "no button is at the click or at point")
