; A thread forked by a module acts for that module, even when it first
; calls Tuna while the main thread runs other code.
> (import (forker))
> (begin
    (set-box! forker:go #t)
    (let loop () (unless (unbox forker:posted) (loop))))
> (map car (owner-changes (module-owner '(forker))))
(unload-action)
> (map car (owner-changes (plugins:repl-owner)))
()
> (unload-owner! (module-owner '(forker)))
forker's unload action
; So does a thread forked at the top level.
> (let ([go #f] [seen #f])
    (let ([t (call-as-owner (plugins:configuration-owner) (lambda () (fork-task (lambda (restore) (let loop () (unless go (loop)))
                   (set! seen (current-owner))))))])
      (set! go #t)
      (join-task t)
      seen))
#<owner (init) 1>
; A thread forked by a module is its instance's: the instance's unload
; stops it, so what it would have posted never runs.
> (import (poster))
> (define old-go poster:go)
> (define old-posted poster:posted)
> (begin
    (unload-owner! (module-owner '(poster)))
    (load-module! '(poster))
    (set-box! old-go #t)
    (void))
> (unbox old-posted)
#f
> (begin
    (set-box! poster:go #t)
    (let loop () (unless (unbox poster:posted) (loop))))
poster's thread posted
