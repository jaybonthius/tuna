; A module is looked for in lib/, then in the installed plugins, then in
; Tuna's own library; a module in lib/ that replaces an installed plugin's
; is reported at start.
! import: (shadowed) in lib/ replaces ~/.local/share/tuna/plugins/shadowed/shadowed.sls
> (import (shadowed))
> (shadowed:where)
"lib/"
> (import (shadowed part))
> (shadowed/part:where)
"Tuna's own library"
> (import (files))
> (files:where)
"Tuna's own library"
> (import (other))
> (other:name)
other
> (import (compat))
> (compat:who)
"the plugin compat"
; Tuna's own names resolve only to Tuna's libraries.
> (import (tuna extra))
! library (tuna extra) not found
> (import (only (tuna core) where))
! library (tuna core) not found
; The owners' names, and names that would replace Chez's own prefixed
; REPL names, are not module names.
> (import (init))
! import: a module cannot be named (init)
> (import (repl))
! import: a module cannot be named (repl)
> (import (csv7 tools))
! import: a module cannot be named (csv7 tools)
> (import (r6rs))
! import: a module cannot be named (r6rs)
