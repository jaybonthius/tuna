; Unloading the plugin removes its part; loading it again places it
; again and keeps both buffers, so the log and the message stay.
> (echo-area:message! "Kept")
> (unload-module! '(echo-area))
> (tree)
(layout:level () #(views:view ((view . 1) (buffer . "*scratch*"))))
> (map buffers:name (filter (lambda (b) (member (buffers:name b) '(" *Echo Area*" "*Messages*"))) (buffers:all)))
(" *Echo Area*" "*Messages*")
> (load-module! '(echo-area))
> (tree)
(layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 1) (buffer . "*scratch*")))) #(views:view ((view . 4) (buffer . " *Echo Area*") (depth . 90) (size . content) (locked . #t)))))
> (list (echo-area:current-message) (messages))
("Kept" "Kept\n")
> (eq? echo-buffer (buffers:find " *Echo Area*"))
#t
; Reloading it does the same.
> (import (tuna eval))
> (eval-file (string-append (getenv "TUNA_LIBRARY") "/echo-area.sls"))
> (list (tree) (echo-area:current-message) (messages))
((layout:level () (layout-split:container ((direction . column)) (layout:level () #(views:view ((view . 1) (buffer . "*scratch*")))) #(views:view ((view . 5) (buffer . " *Echo Area*") (depth . 90) (size . content) (locked . #t))))) "Kept" "Kept\n")
; The count of an equal message is read from the log, so it goes on
; after the reload.
> (echo-area:message! "Kept")
> (messages)
"Kept [2 times]\n"
; Its advice and bindings came back with it.
> (car '())
! car: () is not a pair
> (echo-area:current-message)
"car: () is not a pair"
> (press! "C-f")
! editing:forward-char: end of buffer
> (echo-area:current-message)
"editing:forward-char: end of buffer"
> (commands:command-name (keys:lookup client "C-h e"))
echo-area:show-messages
