; Visiting, saving, the key bindings and the autosave example.
> (disk-checks:write-text! "~/notes.txt" "Buy milk.  \nCall Bob.")
> (files:visit "~/notes.txt")
#<buffer notes.txt>
> (define notes (files:visit "~/notes.txt"))
> (files:path notes)
"$HOME/notes.txt"
> (files:buffer-visiting "~/notes.txt")
#<buffer notes.txt>
> (files:buffers)
(#<buffer notes.txt>)
; A before-save entry may edit the buffer; the save writes the result,
; with the final line break the configuration's option asks for.
> (define (delete-trailing-whitespace buffer)
    (let* ([doc (buffers:document buffer)] [s (document:text doc)])
      (let loop ([i (- (string-length s) 1)] [line-end #f])
        (when (>= i 0)
          (let ([c (string-ref s i)])
            (cond
              [(char=? c #\newline) (loop (- i 1) i)]
              [(and line-end (char=? c #\space))
               (let scan ([j i])
                 (if (and (> j 0) (char=? (string-ref s (- j 1)) #\space))
                     (scan (- j 1))
                     (begin
                       (buffers:replace! buffer (+ j 1) (+ i 2) "")
                       (loop (- j 1) #f))))]
              [else (loop (- i 1) #f)]))))))
> (hooks:add! files:before-save delete-trailing-whitespace)
> (buffers:replace! notes 1 1 "Today: ")
#<edit 1>
> (buffers:modified? notes)
#t
> (files:save-buffer notes)
> (disk-checks:read-text "~/notes.txt")
"Today: Buy milk.\nCall Bob.\n"
> (buffers:modified? notes)
#f
> (text notes)
"Today: Buy milk.\nCall Bob.\n"
; Run by a key, a command's buffer is the current buffer.
> (buffers:replace! notes 1 1 "* ")
#<edit 4>
> (buffers:with-buffer notes (commands:run files:save-buffer))
> (disk-checks:read-text "~/notes.txt")
"* Today: Buy milk.\nCall Bob.\n"
> (map (lambda (k) (commands:command-name (tables:ref keys:global k))) '("C-x C-s" "M-~" "C-x C-c"))
(files:save-buffer files:not-modified files:save-buffers-kill-tuna)
; The autosave example saves modified buffers after five seconds of
; idle, and leaves alone a file another program changed, and one the
; user would not save over its write protection.
> (import (autosave))
> (define other (files:visit "~/other.txt"))
> (disk-checks:write-text! "~/locked.txt" "locked\n")
> (disk-checks:set-mode! "~/locked.txt" #o444)
> (define locked (files:visit "~/locked.txt"))
> (define later (files:visit "~/later.txt"))
> (buffers:replace! notes 1 1 "+ ")
#<edit 5>
> (buffers:replace! other 1 1 "draft")
#<edit 1>
> (buffers:replace! locked 1 1 "un")
#<edit 1>
> (buffers:replace! later 1 1 "later")
#<edit 1>
> (disk-checks:write-text! "~/other.txt" "changed elsewhere\n")
> (options:set! ask:yes-or-no-reader (lambda (question) #f))
> (timers:set-idle! #t)
> (testing:wait-until (lambda () (not (or (buffers:modified? notes) (buffers:modified? later)))))
> (map buffers:modified? (list notes other locked later))
(#f #t #t #f)
> (files:not-modified locked)
> (list (disk-checks:read-text "~/notes.txt") (disk-checks:read-text "~/other.txt"))
("+ * Today: Buy milk.\nCall Bob.\n" "changed elsewhere\n")
> (guard (c [(files:changed-on-disk-condition? c) (condition-message c)])
    (files:save-buffer other))
"another program changed the file"
; C-x C-c asks before it exits with a modified file buffer whose edits
; no entry of files:unsaved-kept keeps.
> (define asked '())
> (options:set! ask:yes-or-no-reader (lambda (question) (set! asked (cons question asked)) #f))
> (commands:run files:save-buffers-kill-tuna)
> asked
("Modified buffers exist; exit anyway? ")
> (hooks:add! files:unsaved-kept (lambda (buffer) (eq? buffer other)))
; With no edits to lose, it asks whether to exit only when
; files:confirm-exit? is on.
> (files:confirm-exit?)
#f
> (options:set! files:confirm-exit? #t)
> (options:set! ask:y-or-n-reader (lambda (question) (set! asked (cons question asked)) #f))
> (commands:run files:save-buffers-kill-tuna)
> asked
("Really exit Tuna? " "Modified buffers exist; exit anyway? ")
