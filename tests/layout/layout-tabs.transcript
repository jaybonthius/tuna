(layout-tabs:recent-tab "no more recent tabs")
; The press on a tab selects; its release does nothing.
> (define r1 (views:make notes))
> (define r2 (views:make other))
> (set-parts! (layout-tabs:container '() (atom r1) (atom r2)))
> (layout:select! r2)
> (parameterize ([web:current-client c1])
    ((table-ref web:input-handlers "mouse") c1
     `(("type" . "mouse") ("action" . "click") ("button" . 1) ("clicks" . 1) ("modifiers" . #())
       ("token" . ,(label-at r1)) ("keymaps" . ,(vector (mark-number layout-tabs:keymap)))
       ("view" . ,(views:id layout:screen-view)) ("version" . ,(buffers:version layout:buffer))
       ("showing" . ,(views:shown-count layout:screen-view)))))
> (eq? (layout:selected-view) r2)
#t
; The close button carries layout-tabs:close-keymap, so its click closes
; the tab clicked, with every part in it, without selecting it first; the
; middle button on a tab closes it too, and on the close button, which
; leaves it to the tab's keymap. Each names the tab by its child, not by
; the selected view.
> (define r3 (views:make notes))
> (set-parts! (layout-tabs:container '() (atom r1) (layout-split:container '((direction . row)) (atom r2) (atom r3))))
> (layout:select! r1)
> (mouse! close-keymaps 1 (tab-at (cadr (tabs-children))))
> (list (eq? (layout:selected-view) r1) (length (tabs-children)))
(#t 1)
> (define r4 (layout-tabs:add-tab! r1 other))
> (mouse! (list layout-tabs:keymap) 2 (tab-at (car (tabs-children))))
> (list (eq? (layout:selected-view) r4) (length (tabs-children)))
(#t 1)
> (layout:select! (layout-tabs:add-tab! r4 other))
> (mouse! close-keymaps 2 (tab-at (car (tabs-children))))
> (length (tabs-children))
1
; A tab holding a locked part stays, as close-other-tabs keeps one.
> (define r5 (views:make notes))
> (define r6 (views:make notes))
> (set-parts! (layout-tabs:container '() (atom r5) (atom r6 '(locked . #t))))
> (layout:select! r5)
> (mouse! close-keymaps 1 (tab-at (cadr (tabs-children))))
> (length (tabs-children))
2
; The close button's press does nothing, so pressing it selects no tab.
> (map (lambda (b) (cons (car b) (commands:command-name (cdr b)))) (keys:bindings layout-tabs:close-keymap))
(("<down-mouse-1>" . keys:ignore) ("<mouse-1>" . layout-tabs:mouse-close-tab))
; A tab's child names the tab even when it is a tabs container, whose
; first tab's child starts where the outer tab's child is entered.
> (define r7 (views:make notes))
> (define r8 (views:make notes))
> (define r9 (views:make other))
> (set-parts! (layout-tabs:container '() (atom r7) (layout-tabs:container '() (atom r8) (atom r9))))
> (layout:select! r7)
> (define (inner-first) (document:token (buffers:document layout:buffer) (+ (document:node-start (cadr (tabs-children))) 1)))
> (= (document:node-start (inner-first)) (+ (document:node-start (cadr (tabs-children))) 1))
#t
> (mouse! close-keymaps 1 (tab-at (inner-first)))
