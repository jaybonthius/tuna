; *Shell Command Output*'s root holds the line and the folder it ran in:
; files:directory there is that folder, and buffers:revert-buffer runs
; the line again there, through shell-commands:shell-command-again.
> (folder! "listed")
> (with-output-to-file (at "listed/a.txt") (lambda () (display "a\n")))
> (define listing (dired:visit (at "listed")))
> (layout:switch-to-buffer listing)
> (run! shell-commands:shell-command "pwd" #f)
> (message)
"$HOME/listed"
> (run! shell-commands:shell-command "ls" #f)
> (define out (buffers:find "*Shell Command Output*"))
> (list (text out) (files:directory out))
("a.txt\n" "$HOME/listed/")
> (layout:switch-to-buffer out)
> (run! shell-commands:shell-command "pwd" #f)
> (message)
"$HOME/listed"
> (buffers:rename! out "kept output")
> (layout:switch-to-buffer out)
> (run! shell-commands:shell-command "pwd" #f)
> (message)
"$HOME/listed"
> (define out (buffers:find "kept output"))
> (reload! "shell-commands")
> (list (files:directory out) (eq? (buffers:with-buffer out (buffers:revert-function)) shell-commands:shell-command-again))
("$HOME/listed/" #t)
> (define out (buffers:find "*Shell Command Output*"))
> (layout:switch-to-buffer out)
> (run! shell-commands:shell-command "ls" #f)
> (with-output-to-file (at "listed/b.txt") (lambda () (display "b\n")))
> (run! buffers:revert-buffer)
> (text out)
"a.txt\nb.txt\n"
; It is a text buffer the user may edit, so g types there, and M-x does
; not offer the command.
> (press! "g")
> (list (text out) (buffers:modified? out) (table-ref commands:command-modes shell-commands:shell-command-again #f))
("ga.txt\nb.txt\n" #t ())
; The entry shell-commands adds to files:directory-finders answers only
; for a buffer whose root holds a line, so a file buffer's folder is its
; file's.
> (define file (files:visit "~/listed/a.txt"))
> (map (lambda (entry) (entry file)) (hook-entries files:directory-finders))
("$HOME/listed/" #f #f #f)
