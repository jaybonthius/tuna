; The configuration makes split:display-right the display action and
; shows help buffers below.
> (eq? (layout:display-action) split:display-right)
#t
> (define notes (buffers:make "notes" "one\n"))
> (define mail (buffers:make "mail" "Dear Harpo,\n"))
> (define help help:buffer)
> (layout:switch-to-buffer (buffers:make "*scratch*" ""))
> (views:id (layout:display-buffer notes))
2
> (tree)
(layout:root () (split:container ((direction . row)) #(views:view ((view . 1) (buffer . "*Help*"))) #(views:view ((view . 2) (buffer . "*scratch*")))))
> (selected)
1
; A buffer already shown is shown where it is.
> (views:id (layout:display-buffer notes))
2
> (layout:reuse-view mail)
#f
> (views:id (layout:reuse-view notes))
2
; A rule whose predicate accepts the buffer comes first.
> (views:id (layout:display-buffer help))
3
> (tree)
(layout:root () (split:container ((direction . row)) (split:container ((direction . column)) #(views:view ((view . 1) (buffer . "*Help*"))) #(views:view ((view . 3) (buffer . "*scratch*")))) #(views:view ((view . 2) (buffer . "*scratch*")))))
; Rules are tried newest first, then the caller's action, then the
; option's, then the selected view.
> (define tried '())
> (define (declining name) (lambda (b) (set! tried (cons name tried)) #f))
> (define (always b) #t)
> (table-set! layout:display-rules always (declining 'older))
> (define (also-always b) #t)
> (table-set! layout:display-rules also-always (declining 'newer))
> (set-option! layout:display-action (declining 'option))
> (layout:display-buffer mail (declining 'caller))
#<view 1>
> (reverse tried)
(newer older caller option)
> (tree)
(layout:root () (split:container ((direction . row)) (split:container ((direction . column)) #(views:view ((view . 1) (buffer . "*Help*"))) #(views:view ((view . 3) (buffer . "*scratch*")))) #(views:view ((view . 2) (buffer . "*scratch*")))))
> (raised (lambda () (layout:display-buffer mail (lambda (b) 'nonsense))))
(layout:display-buffer "an action returned what is not a view or #f")
> (raised (lambda () (layout:display-buffer 'mail)))
(layout:display-buffer "not a buffer")
> (table-remove! layout:display-rules always)
> (table-remove! layout:display-rules also-always)
; use-other-view reuses a view showing the buffer, else the view selected
; least recently, never the selected one or a locked one.
> (remove-option! layout:display-action)
> (eq? (layout:display-action) split:display-right)
#t
> (set-option! layout:display-action layout:use-other-view)
> (map (lambda (v) (cons (views:id v) (buffers:name (views:buffer v)))) (layout:views))
((1 . "mail") (3 . "*Help*") (2 . "notes"))
> (layout:select! (views:find 3))
> (layout:select! (views:find 2))
> (define other (buffers:make "other" ""))
> (views:id (layout:use-other-view other))
1
> (map (lambda (v) (cons (views:id v) (buffers:name (views:buffer v)))) (layout:views))
((1 . "other") (3 . "*Help*") (2 . "notes"))
> (views:id (layout:use-other-view other))
1
> (define echo (layout:add-bar! (buffers:make "*Echo*" "")))
> (views:id (layout:display-buffer (buffers:make "fourth" "")))
1
> (map (lambda (v) (cons (views:id v) (buffers:name (views:buffer v)))) (layout:views))
((1 . "fourth") (3 . "*Help*") (2 . "notes") (4 . "*Echo*"))
; switch-to-buffer shows the buffer in the selected view; in a locked
; view, it displays it elsewhere and selects that view.
> (layout:switch-to-buffer notes)
> (cons (selected) (buffers:name (views:buffer (layout:selected-view))))
(2 . "notes")
> (layout:select! echo)
> (layout:switch-to-buffer mail)
> (cons (selected) (buffers:name (views:buffer (layout:selected-view))))
(1 . "mail")
> (buffers:name (views:buffer echo))
"*Echo*"
; The documented example of a rule.
> (define (compilation-buffer? buffer)
    (string=? (buffers:name buffer) "*compilation*"))
> (table-set! layout:display-rules compilation-buffer? split:display-below)
> (define compilation (buffers:make "*compilation*" "make\n"))
> (layout:select! (layout:display-buffer compilation))
> (cons (selected) (buffers:name (views:buffer (layout:selected-view))))
(5 . "*compilation*")
; reset-layout keeps the selected view, or the last selected that is not
; locked, and the bars.
> (layout:select! echo)
> (commands:run layout:zoom)
> (commands:run layout:reset-layout)
> (tree)
(layout:root () #(views:view ((view . 5) (buffer . "*compilation*"))) #(views:view ((view . 4) (buffer . "*Echo*") (pinned . #t) (locked . #t))))
> (selected)
5
> (map views:id (layout:views))
(5 4)
> (raised (lambda () (layout:use-other-view "mail")))
(layout:use-other-view "not a buffer")
> (raised (lambda () (layout:reuse-view "mail")))
(layout:reuse-view "not a buffer")
> (raised (lambda () (layout:switch-to-buffer "mail")))
(layout:switch-to-buffer "not a buffer")
> (raised (lambda () (layout:add-bar! "mail")))
(layout:add-bar! "not a buffer")
; reset-layout chooses a view in the root's first part, never a locked
; one, and refuses to change a locked part.
> (define first (views:make notes))
> (define second (views:make mail))
> (set-parts! (split:container '((direction . row)) (atom first) (atom second)) (atom echo '(pinned . #t) '(locked . #t)))
> (layout:select! first)
> (layout:select! echo)
> (layout:delete-part! (layout:view-node first))
> (commands:run layout:reset-layout)
> (tree)
(layout:root () #(views:view ((view . 7) (buffer . "mail"))) #(views:view ((view . 4) (buffer . "*Echo*") (pinned . #t) (locked . #t))))
> (selected)
7
> (map views:id (layout:views))
(7 4)
> (define third (views:make notes))
> (define fourth (views:make notes))
> (set-parts! (split:container '((direction . row) (locked . #t)) (atom second) (atom third)) (atom echo '(pinned . #t) '(locked . #t)) (atom fourth))
> (raised (lambda () (layout:reset-layout)))
(layout:reset-layout "a locked part")
; An action's view must be in the layout.
> (raised (lambda () (layout:display-buffer mail (lambda (b) (views:make b)))))
(layout:display-buffer "an action returned a view not in the layout")
