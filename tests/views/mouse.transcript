; Each drawn node's element names its range; a token place on a node's
; opening names the position inside it, so the node encloses it, and on
; an atom the position before it.
> (define-table link-keys)
> (define-table image-keys)
> (commands:define-command (on-link [event (keys:command-event)])
    "Records a click on a link."
    (set! seen (cons (list 'link (views:posn-point (keys:event-start event))) seen)))
> (commands:define-command (on-image [event (keys:command-event)])
    "Records a click on an image."
    (set! seen (cons (list 'image (views:posn-point (keys:event-start event))) seen)))
> (keys:bind! link-keys "<mouse-1>" on-link)
> (keys:bind! image-keys "<mouse-1>" on-image)
> (buffers:define-kind clicky-link (inline) (keymap link-keys))
> (buffers:define-kind clicky-image (content atom) (inline) (keymap image-keys))
> (define d (buffers:make "doc" (md:doc '() (md:para '() "See " (clicky-link '() "here") " and " (clicky-image '()) ".\n"))))
> (define w (views:make d))
