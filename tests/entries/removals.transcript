; Each removal is its own change: an entry, advice or a table value stays
; hidden while any removal of it stands.
> (import (target) (helper) (adder))
> (begin (target:greeted "Harpo") (list (target:text "Harpo") (tables:ref target:names 'harpo)))
hello Harpo
("[Harpo]" "Harpo")
> (import (quiet1) (quiet2))
> (begin (target:greeted "Chico") (list (target:text "Chico") (tables:ref target:names 'harpo)))
("Chico" #f)
> (map car (owner-changes (module-owner '(quiet2))))
(removal)
> (unload-owner! (module-owner '(quiet1)))
> (begin (target:greeted "Chico") (list (target:text "Chico") (tables:ref target:names 'harpo)))
("Chico" #f)
> (unload-owner! (module-owner '(quiet2)))
> (begin (target:greeted "Zeppo") (list (target:text "Zeppo") (tables:ref target:names 'harpo)))
hello Zeppo
("[Zeppo]" "Harpo")
; Removing again what a module has removed already records nothing more.
> (load-module! '(quiet1))
#<owner (quiet1) 2>
> (call-as-owner (module-owner '(quiet1)) (lambda () (hooks:remove! target:greeted helper:shout) (advice-remove! target:text helper:wrap) (tables:remove! target:names 'harpo)))
> (map car (owner-changes (module-owner '(quiet1))))
(removal)
