; layout:other-views gives the views C-x o visits from the selected
; view, in its order: the level's views after it, then the parts and
; popups that set other-view, then the level's views before it, as
; Emacs's other-window enters an active minibuffer after the frame's
; last window.
> (define c1 (web:add-client! 1))
> (define (named name) (buffers:make name (string-append name "\n")))
> (define (names vs) (map (lambda (v) (buffers:name (views:buffer v))) vs))
> (define (selected-name) (buffers:name (views:buffer (layout:selected-view))))
> (define one (views:make (named "one")))
> (define two (views:make (named "two")))
> (define three (views:make (named "three")))
> (set-parts! (layout-split:container '((direction . row)) (atom one) (atom two) (atom three)))
> (layout:select! one)
> (names (layout:other-views))
("two" "three")
> (define prompt (layout:display-buffer (named "*prompt*") (layout-split:display-at-side (layout:direction down) 100 'content '((locked . #t) (other-view . #t)))))
> (layout:select! two)
> (names (layout:other-views))
("three" "*prompt*" "one")
; C-x o takes a count, back for a negative one; C-x O goes back.
> (press! c1 '("u" "control") '("2") '("x" "control") '("o"))
> (selected-name)
"*prompt*"
> (press! c1 '("x" "control") '("O"))
> (selected-name)
"three"
> (press! c1 '("u" "control") '("-") '("x" "control") '("o"))
> (selected-name)
"two"
; From the waiting prompt, the level's views from the first; a level
; inside the level counts as its view selected last.
> (layout:select! prompt)
> (names (layout:other-views))
("one" "two" "three")
> (define inner-a (views:make (named "inner-a")))
> (define inner-b (views:make (named "inner-b")))
> (define prompt (views:make (named "*prompt-2*")))
> (set-parts! (layout-split:container '((direction . column))
                (layout:level '()
                  (layout-split:container '((direction . row))
                    (atom one)
                    (layout:level '() (layout-split:container '((direction . column)) (atom inner-a) (atom inner-b)))))
                (atom prompt '(depth . 100) '(locked . #t) '(other-view . #t))))
> (layout:select! inner-b)
> (layout:select! one)
> (names (layout:other-views))
("inner-b" "*prompt-2*")
> (layout:select! prompt)
> (names (layout:other-views))
("one" "inner-b")
; The view C-M-v scrolls: from a prompt, the view selected last outside
; it; else the first of layout:other-views that shows a buffer that is
; not internal, so never a waiting prompt.
> (eq? (layout:other-view-for-scrolling) one)
#t
; A part that sets other-view and shows a buffer that is not internal,
; as an explorer would, counts.
> (layout:select! inner-b)
> (buffers:name (views:buffer (layout:other-view-for-scrolling)))
"*prompt-2*"
> (define prompt (views:make (buffers:make " *Minibuf-test*" "")))
> (set-parts! (layout-split:container '((direction . column))
                (layout:level '() (atom one))
                (atom prompt '(depth . 100) '(locked . #t) '(other-view . #t))))
> (layout:select! one)
> (names (layout:other-views))
(" *Minibuf-test*")
> (raised (lambda () (layout:other-view-for-scrolling)))
(layout:other-view-for-scrolling "no other view")
; C-x 4 0 kills the buffer and deletes the view; in the last view of
; its level the kill happens, and deleting the view raises.
> (define four (views:make (named "four")))
> (set-parts! (layout-split:container '((direction . row)) (atom one) (atom four)))
> (raised (lambda () (buffers:kill! (buffers:find " *Minibuf-test*"))))
#t
> (layout:select! four)
> (press! c1 '("x" "control") '("4") '("0"))
> (list (names (layout:views)) (buffers:find "four"))
(("one") #f)
> (commands:run layout:kill-buffer-and-view)
! layout:delete-part!: the last view of its level with irritant #<node views:view 1>
> (list (names (layout:views)) (buffers:find "one"))
(("inner-b") #f)
