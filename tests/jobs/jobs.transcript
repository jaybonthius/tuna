; A raise ends the job: it is reported, then on-end receives it. A
; warning is reported and the body goes on.
> (jobs:define-worker (fails x emit) (emit 'before) (car x))
> (let ([ended (finished fails 1)])
    (list (car ended) (condition? (cadr ended)) (condition-message (cadr ended))))
! car: 1 is not a pair
((before) #t "~s is not a pair")
> (jobs:define-worker (warns x emit) (warning 'warns "careful") (emit 'went-on))
> (finished warns 1)
! warns: careful
((went-on) #f)
; A raised value that looks like an ending is still a raise. A warning
; raised with raise cannot go on, so the job ends with the error that
; follows.
> (jobs:define-worker (raises x emit) (raise x))
> (map (lambda (x) (finished raises x)) '(#f stopped))
! non-condition value #f
! non-condition value stopped
((() #f) (() stopped))
> (jobs:define-worker (warns-raising x emit) (raise (make-warning)) (emit 'went-on))
> (let ([ended (finished warns-raising 1)])
    (list (car ended) (non-continuable-violation? (cadr ended))))
! &warning
! &non-continuable
(() #t)
