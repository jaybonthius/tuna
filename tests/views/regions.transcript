; Each line's piece of the region is its own span. A line the region goes
; on past is eol, so its newline shows.
> (define (regions html)
    (let loop ([from 0] [acc '()])
      (let ([i (search html "<span class=\"region" from)])
        (if i
            (let* ([open (+ (search html "\">" i) 2)] [close (search html "</span>" open)])
              (loop close (cons (list (substring html (+ i 19) (- open 2)) (substring html open close)) acc)))
            (reverse acc)))))
> (define (at doc line col)
    (let ([chars (document:unit characters)])
      (document:position doc (+ (document:offset doc (document:line-start doc line) chars) col) chars)))
> (define (region-of b from-line from-col to-line to-col)
    (let* ([v (views:make b)] [doc (buffers:document b)])
      (views:set-point! v (at doc to-line to-col))
      (views:set-mark! v (at doc from-line from-col))
      (for-each (lambda (r) (write r) (newline)) (regions (html-of v #f)))))
; Lines of 10, 4, 0, 8, 12 and 4 characters, the region from the first's
; sixth column to the last's third. An empty line inside the region shows
; its newline.
> (region-of (buffers:make "a" "0123456789\n0123\n\n01234567\n0123456789ab\n0123\n") 1 5 6 2)
(" eol" "56789")
(" eol" "0123")
(" eol" "")
(" eol" "01234567")
(" eol" "0123456789ab")
("" "01")
; A region that ends where a line starts holds nothing of that line; one
; that starts at a line's end shows only that line's newline there.
> (region-of (buffers:make "c" "ab\ncd\n") 1 0 2 0)
(" eol" "ab")
> (region-of (buffers:make "d" "ab\ncd\n") 1 2 2 1)
(" eol" "")
("" "c")
> (region-of (buffers:make "e" "abcdef\n") 1 1 1 4)
("" "bcd")
; A link's own element cuts a line's piece of the region where the
; region starts or ends inside it; only the fragment that ends with the
; line shows the newline. A region that covers the link is opened once,
; around it.
> (import (md))
> (define (line-of v n)
    (let* ([html (html-of v #f)] [i (search html (string-append "data-line=\"" (number->string n) "\"") 0)])
      (substring html (+ (search html ">" i) 1) (search html "</div>" i))))
> (define m
    (buffers:make "m"
      (md:doc '()
        (md:para '() "Alpha beta gamma.\n")
        (md:para '() "Al " (md:link '((href . "https://x")) "beta") " gamma.\n")
        (md:para '() "Last line.\n"))))
> (define (region-in-link from to)
    (let ([v (views:make m)])
      (views:set-mark! v from)
      (views:set-point! v to)
      (display (line-of v 2))
      (newline)))
> (region-in-link 3 40)
<span class="region eol">Al <span class="node" data-at="25" data-to="31"><a href="https://x"><span data-at="26">beta</span></a></span> gamma.</span>
> (region-in-link 3 27)
<span class="region">Al </span><span class="node" data-at="25" data-to="31"><a href="https://x"><span data-at="26"><span class="region">b</span><span class="cursor primary"></span>eta</span></a></span> gamma.
> (region-in-link 27 40)
Al <span class="node" data-at="25" data-to="31"><a href="https://x"><span data-at="26">b<span class="region">eta</span></span></a></span><span class="region eol"> gamma.</span>
> (region-in-link 26 28)
Al <span class="node" data-at="25" data-to="31"><a href="https://x"><span data-at="26"><span class="region">be</span><span class="cursor primary"></span>ta</span></a></span> gamma.
; A line the region holds from its start through its newline is marked
; region-line, so the stylesheet fills it to its edges; the first line,
; held from its middle, and the last, held only in part, are not.
> (define (held-lines v)
    (let ([html (html-of v #f)])
      (let loop ([from 0] [acc '()])
        (let ([i (search html "region-line\"" from)])
          (if i
              (let ([n (search html "data-line=\"" i)])
                (loop (+ i 1) (cons (string->number (substring html (+ n 11) (search html "\"" (+ n 11)))) acc)))
              (reverse acc))))))
> (define lines (buffers:make "lines" "one\ntwo\nthree\nfour\nfive\n"))
> (define lv (views:make lines))
> (let ([doc (buffers:document lines)]) (views:set-mark! lv (at doc 1 1)) (views:set-point! lv (at doc 4 2)))
> (held-lines lv)
(2 3)
; Regions of two cursors that meet are one: the line between them is
; held, though neither holds it alone.
> (let ([doc (buffers:document lines)])
    (views:set-cursor! (car (views:cursors lv)) (at doc 2 2) (at doc 1 0))
    (views:set-cursor! (views:add-cursor! lv (at doc 3 0)) (at doc 3 0) (at doc 2 2)))
> (held-lines lv)
(1 2)
; An atom has no characters, so one the region holds whole is marked.
> (define pic (buffers:make "pic" (md:doc '() (md:para '() "a " (md:image '((src . "a.png"))) " b\n"))))
> (define pv (views:make pic))
> (begin (views:set-mark! pv 2) (views:set-point! pv 7))
