> (define chat (pi:start (getenv "HOME")))
> (define f (fake-of chat))
> (wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (in-client (lambda () (pi-chat:show! chat)))
> (define b (pi-chat:buffer chat))
; The chat is a buffer of its own mode, named after its folder, and
; linked to Pi's process. Its prompt's edits are history; the
; conversation's rewrites are silent.
> (list (buffers:name b) (modes:major-mode b) (eq? (pi-chat:chat-of b) chat) (eq? (processes:buffer (pi:chat-process chat)) b))
("*pi: home*" pi-chat:mode #t #t)
> (buffers:silent? b)
#f
; Point is in the prompt; RET sends it with pi:send!, the text moving at
; once into the prompt history. A key that waits for Pi pauses the task
; it runs in, so the test presses it in a task of its own.
> (type! "Fix it")
> (shown chat)
"Fix it\n"
; Typing marks the chat modified, as it does any buffer.
> (buffers:modified? b)
#t
> (answer! f "prompt" (lambda (f r) #f))
> (define t (start! (lambda () (press! "RET"))))
> (define r (wait-held f "prompt"))
> (list (ref r "message") (ref r "streamingBehavior") (shown chat) (pi-chat:prompt-history))
("Fix it" "steer" "\n" ("Fix it"))
> (respond! f r '(("disposition" . "started")))
