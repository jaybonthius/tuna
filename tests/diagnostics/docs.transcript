; diagnostics:at-point is a docs source only in buffers where the mode is
; on: added when it turns on there, removed when it turns off.
> (define plain (buffers:make "plain" "just some text\nmore\n"))
> (define (sources b) (length (buffers:with-buffer b (hook-entries docs-at-point:sources))))
> (list (sources notes) (sources plain))
(0 0)
> (mode! notes #t)
> (list (sources notes) (sources plain))
(1 0)
> (mode! notes #f)
> (sources notes)
0
; So docs at point in a buffer without a source leave *Docs* as it was.
> (define (signature view) (docs-at-point:make-doc "signature of alpha" (docs-at-point:doc-options [thing "alpha"])))
> (buffers:with-buffer notes (add-local-hook! docs-at-point:sources signature))
> (press! "C-h" ".")
> (wait-until (lambda () (let ([d (buffers:find "*Docs*")]) (and d (> (string-length (text d)) 0)))))
> (define docs-text (text (buffers:find "*Docs*")))
> (commands:define-command (to-plain) "Shows plain." (layout:switch-to-buffer plain))
> (keys:bind! keys:global "C-c p" to-plain)
> (layout:select! (car (views:showing notes)))
> (press! "C-c" "p" "C-f")
> (sleep-for 0.3)
> (list (buffers:name (views:buffer (view))) (string=? (text (buffers:find "*Docs*")) docs-text))
("plain" #t)
; The echo area shows a diagnostic's text at point in error, warning or
; success.
> (layout:switch-to-buffer notes)
> (buffers:with-buffer notes (remove-local-hook! docs-at-point:sources signature))
> (mode! notes #t)
> (define source (diagnostics:make-source))
> (diagnostics:report! source notes (list (err notes "beta" "bad beta")))
#t
> (views:set-point! (view) 1)
> (press! "M-f" "C-f")
> (wait-until (lambda () (equal? (echo-area:current-message) "bad beta")))
> (list (views:point (view)) (echo-area:current-message) (echo-area:current-spans))
(7 "bad beta" ((0 8 error)))
