> (define doc
    (document:from-datum
      '(chat:reply ()
         (md:para () "See " (md:link ((href . "https://scheme.com")) "TSPL") ".\n")
         #(md:image ((src . "plot.png"))))))
; Strings and attribute values are copied in, and attribute values out,
; so changing them changes nothing.
> (define name (string #\a #\b))
> (define tags (list "x" (vector 1)))
> (define d (document:from-datum (list 'p (list (cons 'tags tags)) name)))
> (string-set! name 0 #\z)
> (set-car! tags "changed")
> (set-car! (document:node-attribute (document:token d 0) 'tags) "changed")
> (document:datums d)
((p ((tags "x" #(1))) "ab"))
> (document:length (document:from-datum))
0
; Malformed datums and attribute values that are not plain data raise.
> (document:from-datum 42)
! document:from-datum: not a datum with irritant 42
> (document:from-datum '#(img))
! document:from-datum: not a datum with irritant #(img)
> (document:from-datum '(p "no attributes"))
! document:from-datum: not an association list from symbols with irritant "no attributes"
> (document:from-datum (list 'p (list (cons 'f car))))
! document:from-datum: not plain data with irritant #<procedure car>
> (define holds-itself (list 'p '()))
> (set-cdr! (cdr holds-itself) (list holds-itself))
> (document:from-datum holds-itself)
! document:from-datum: a datum holds itself
> (define value (list 1))
> (set-cdr! value value)
> (document:from-datum (list 'p (list (cons 'v value))))
! document:from-datum: not plain data: a value holds itself
; A value that holds itself is left out of the error, and one that does
; not is named.
> (document:from-datum (cons* 'p '() value))
! document:from-datum: not a datum
> (document:from-datum (list 'p value))
! document:from-datum: not an association list from symbols
> (define cell (box #f))
> (set-box! cell cell)
> (document:from-datum (list 'p (list (cons 'v cell))))
! document:from-datum: not plain data
> (document:from-datum '(p () . "x"))
! document:from-datum: not a datum with irritant (p () . "x")
> (document:from-datum '#(document:raw-byte ((byte . 300))))
! document:from-datum: a raw byte needs a byte from 0 to 255 with irritant ((byte . 300))
; Each byte that is not part of valid UTF-8 is a raw byte, written back as
; itself: overlong forms, lone continuations, surrogates, a truncated end.
> (define (utf8 doc start end)
    (let-values ([(port extract) (open-bytevector-output-port)])
      (document:for-each-utf8-chunk doc start end
        (lambda (bv from to) (put-bytevector port bv from (- to from))))
      (extract)))
> (define bytes #vu8(104 #xC0 #xAF 105 #xE2 #x82 #xAC #xED #xA0 #x80 #xF0 #x9F #x99))
> (define raw (document:from-utf8 bytes))
> (document:datums raw)
("h" #(document:raw-byte ((byte . 192))) #(document:raw-byte ((byte . 175))) "i€" #(document:raw-byte ((byte . 237))) #(document:raw-byte ((byte . 160))) #(document:raw-byte ((byte . 128))) #(document:raw-byte ((byte . 240))) #(document:raw-byte ((byte . 159))) #(document:raw-byte ((byte . 153))))
> (equal? (utf8 raw 0 (document:length raw)) bytes)
#t
> (list (document:length raw) (document:offset raw 11 (document:unit bytes)) (document:text raw 0 4))
(11 13 "h￼￼i")
; Atoms other than raw bytes are U+FFFC; openings and closings give
; nothing; a range cuts runs.
> (define small (document:from-datum '(p () "aé" #(document:raw-byte ((byte . 255))) #(img ()))))
> (utf8 small 0 (document:length small))
#vu8(97 195 169 255 239 191 188)
> (utf8 small 2 4)
#vu8(195 169 255)
> (list (document? doc) (document? (vector 1)) (document? "x"))
(#t #f #f)
> (list (document:token doc 15) (document:token doc 16) (document:token doc 17))
(#<node md:image 15> close #!eof)
> (list (document:text doc 3 9) (document:text doc 7))
("ee TS" "TSPL.\n￼")
; Units: characters, UTF-8 bytes, UTF-16 code units.
> (define units (document:from-datum "a🙂é"))
> (map (lambda (unit) (document:offset units 3 unit))
       (list (document:unit characters) (document:unit bytes) (document:unit utf-16)))
(3 7 4)
> (list (document:position units 5 (document:unit bytes)) (document:position units 3 (document:unit utf-16)))
(2 2)
> (document:position units 2 (document:unit bytes))
! document:position: offset inside a character with irritant 2
> (document:position units 2 (document:unit utf-16))
! document:position: offset inside a character with irritant 2
> (document:position units 8 (document:unit bytes))
! document:position: offset past the end with irritant 8
> (document:offset units 0 'lines)
! document:offset: not a unit with irritant lines
; The first position before which the offset comes: before an opening,
; not after it.
> (list (document:position doc 0 (document:unit characters)) (document:position doc 4 (document:unit characters)))
(0 6)
> (define lines (document:from-datum "one\ntwo\n\nfour"))
> (map (lambda (p) (document:line lines p)) (list 0 3 4 8 9 13))
(1 1 2 3 4 4)
> (map (lambda (line) (document:line-start lines line)) (list 1 2 3 4))
(0 4 8 9)
> (document:line-start lines 5)
! document:line-start: the document has fewer lines with irritant 5
; Nodes.
> (map (lambda (p) (document:enclosing doc p)) (list 0 1 6 8 16 17))
(#f #<node chat:reply 0> #<node md:para 1> #<node md:link 6> #<node chat:reply 0> #f)
> (define link (document:token doc 6))
> (list (document:node? link) (document:node? doc) (document:atom? link) (document:atom? (document:token doc 15)))
(#t #f #f #t)
> (list (document:node-kind link) (document:node-start link) (document:node-end link))
(md:link 6 12)
> (list (document:node-attribute link 'href) (document:node-attribute link 'title) (document:node-attribute link 'title 'none))
("https://scheme.com" #f none)
> (document:node-attribute link "href")
! document:node-attribute: not a symbol with irritant "href"
> (map (lambda (p) (document:node-end (document:token doc p))) (list 0 1 15))
(17 15 16)
> (define (children node start end)
    (let ([out '()])
      (document:for-each-child node start end (lambda (child at) (set! out (cons (list at child) out))))
      (reverse out)))
> (children (document:token doc 1) 3 8)
((3 "ee ") (6 #<node md:link 6>))
> (children (document:token doc 1) 8 14)
((6 #<node md:link 6>) (12 ".\n"))
> (children (document:token doc 0) 0 17)
((1 #<node md:para 1>) (15 #<node md:image 15>))
> (children (document:token doc 15) 0 17)
()
; A slice of a slice keeps the openings its range cuts.
> (define s (document:slice doc 9 16))
> (document:datums (document:slice s 1 4))
((md:link ((href . "https://scheme.com")) "L") ".")
> (document:datums (document:slice doc 0 0))
()
; Replace is exact, and raises when an opening would lose its closing.
> (document:datums (document:replace doc 6 12 (document:from-datum '(em () "x"))))
((chat:reply () (md:para () "See " (em () "x") ".\n") #(md:image ((src . "plot.png")))))
> (document:replace doc 6 7 (document:from-datum))
! document:replace: openings and closings would not match with irritants (6 7)
> (document:replace doc 2 2 s)
! document:replace: openings and closings would not match with irritants (2 2)
; Arguments.
> (document:length 5)
! document:length: not a document with irritant 5
> (document:token doc 18)
! document:token: not a position in the document with irritant 18
> (document:text doc 5 3)
! document:text: start is after end with irritants (5 3)
