> (define (ui-request id method . fields) (append `(("type" . "extension_ui_request") ("id" . ,id) ("method" . ,method)) fields))
> (define (responses) (map (lambda (r) (list-tail r 1)) (filter (lambda (r) (equal? (ref r "type") "extension_ui_response")) (fake-requests f))))
> (define chat (pi:start (getenv "HOME")))
> (define f (fake-of chat))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (in-client (lambda () (chat:show! chat)))
> (type! "draft")
; Pi's questions are drawn in the chat above the prompt; point stays in
; the prompt, and the status line of every window says Pi waits.
> (say! f (ui-request "d1" "select" '("title" . "Allow rm?") '("options" . #("Allow" "Block"))))
> (testing:wait-until (lambda () (pair? (drawn-dialogs chat))))
> (sleep-for 0.1)
> (drawn-dialogs chat)
((question (method . select) (header "Allow rm?\n") (answers (ui:list (ui:%list-row) (ui:%list-row))) (actions (cancel-button "Cancel") "\n")))
> (list (shown chat) (eq? (chat:conversation-of (views:buffer (view))) chat))
("Allow rm?\n￼￼Cancel\ndraft\n" #t)
> (html->string (chat:show-waiting (view)))
"<span class=\"chat-waiting\" title=\"Pi waits for an answer; click to go to the question\">Pi asks</span>"
; C-c a d goes to the question that waited longest, point on its first
; option; RET on an option answers with it.
> (in-client (lambda () (layout:switch-to-buffer (buffers:make "other" ""))))
> (in-client (lambda () (commands:run chat:next-question)))
> (eq? (views:buffer (view)) (chat:buffer chat))
#t
> (press! "C-n" "RET")
> (testing:wait-until (lambda () (pair? (responses))))
> (responses)
((("id" . "d1") ("value" . "Block")))
> (list (drawn-dialogs chat) (chat:show-waiting (view)))
(() #f)
; A confirm is Yes and No buttons.
> (say! f (ui-request "d2" "confirm" '("title" . "Clear?") '("message" . "All will be lost.")))
> (testing:wait-until (lambda () (pair? (drawn-dialogs chat))))
> (sleep-for 0.1)
> (drawn-dialogs chat)
((question (method . confirm) (header "Clear?\n") (message "All will be lost.\n") (actions (answer-button "Yes") " " (answer-button "No") "\n")))
> (point-at! chat "No")
> (press! "RET")
> (testing:wait-until (lambda () (= 2 (length (responses)))))
> (cadr (responses))
(("id" . "d2") ("confirmed" . #f))
; An input is a one-line field and an editor a field of many lines,
; where S-RET adds a line; RET answers with what is typed, and a rewrite
; of the chat keeps it.
> (say! f (ui-request "d3" "input" '("title" . "Name") '("placeholder" . "a name"))
        (ui-request "d4" "editor" '("title" . "Edit") '("prefill" . "One")))
> (testing:wait-until (lambda () (= 2 (length (drawn-dialogs chat)))))
> (sleep-for 0.1)
> (drawn-dialogs chat)
((question (method . input) (header "Name" (detail " · a name") "\n") (field "\n") (actions (answer-button "Answer") " " (cancel-button "Cancel") "\n")) (question (method . editor) (header "Edit\n") (field "One\n") (actions (answer-button "Answer") " " (cancel-button "Cancel") "\n")))
> (point-in! chat 'chat:field)
> (type! "Zep")
> (say! f (event "queue_update" '("steering" . #("x")) '("followUp" . #())))
> (sleep-for 0.2)
> (type! "po")
> (press! "S-RET")
! buffers:replace!: the node refuses the edit with irritant chat:field
> (press! "RET")
> (testing:wait-until (lambda () (= 3 (length (responses)))))
> (caddr (responses))
(("id" . "d3") ("value" . "Zeppo"))
> (point-at! chat "One")
> (press! "C-e" "S-RET")
> (type! "Two")
> (press! "RET")
> (testing:wait-until (lambda () (= 4 (length (responses)))))
> (cadddr (responses))
(("id" . "d4") ("value" . "One\nTwo"))
; C-c C-k in a question cancels it; outside one it stops Pi.
> (say! f (ui-request "d5" "select" '("title" . "Pick") '("options" . #("a"))))
> (testing:wait-until (lambda () (= 1 (length (drawn-dialogs chat)))))
> (point-at! chat "Pick")
> (press! "C-c" "C-k")
> (testing:wait-until (lambda () (= 5 (length (responses)))))
> (list-ref (responses) 4)
(("id" . "d5") ("cancelled" . #t))
> (shown chat)
"Steer x\ndraft\n"
; On a confirm, C-c a d puts point on its first button, so RET answers
; Yes.
> (say! f (ui-request "d7" "confirm" '("title" . "Again?")))
> (testing:wait-until (lambda () (= 1 (length (drawn-dialogs chat)))))
> (sleep-for 0.1)
> (in-client (lambda () (commands:run chat:next-question)))
> (press! "RET")
> (testing:wait-until (lambda () (= 6 (length (responses)))))
> (list-ref (responses) 5)
(("id" . "d7") ("confirmed" . #t))
; In a field that holds text, C-c a d puts point after the text, so
; typing adds to it.
> (say! f (ui-request "d8" "editor" '("title" . "More") '("prefill" . "One")))
> (testing:wait-until (lambda () (= 1 (length (drawn-dialogs chat)))))
> (sleep-for 0.1)
> (in-client (lambda () (commands:run chat:next-question)))
> (type! "!")
> (drawn-dialogs chat)
((question (method . editor) (header "More\n") (field "One!\n") (actions (answer-button "Answer") " " (cancel-button "Cancel") "\n")))
> (press! "RET")
> (testing:wait-until (lambda () (= 7 (length (responses)))))
> (list-ref (responses) 6)
(("id" . "d8") ("value" . "One!"))
; C-c a d puts point in a question's field, so typing goes there; what
; is typed in it stays when pi reloads.
> (define (library-file name) (string-append (getenv "TUNA_LIBRARY") "/" name))
> (say! f (ui-request "d6" "input" '("title" . "Why")))
> (testing:wait-until (lambda () (= 1 (length (drawn-dialogs chat)))))
> (in-client (lambda () (commands:run chat:next-question)))
> (type! "Because")
> (eval-file (library-file "pi.sls"))
> (define chat (car (pi:chats)))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (sleep-for 0.3)
> (drawn-dialogs chat)
((question (method . input) (header "Why\n") (field "Because\n") (actions (answer-button "Answer") " " (cancel-button "Cancel") "\n")))
