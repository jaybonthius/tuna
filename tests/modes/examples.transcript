> (table-set! auto-mode:file-names "pyi" python:mode)
> (table-set! auto-mode:file-names "Makefile" make:mode)
> (define (template-host buffer name)
    (auto-mode:by-file-name buffer (substring name 0 (- (string-length name) 3))))
> (table-set! auto-mode:file-names "j2" template-host)
> (table-set! auto-mode:file-names "html" html:mode)
