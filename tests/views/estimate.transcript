; Text outside ASCII is estimated as ASCII text of the same shape is:
; box-drawing and braille characters are characters, not atoms. Each
; buffer is 1,000 lines of 30 characters, reported from its top.
> (define (sizer name c)
    (let* ([b (buffers:make name (apply string-append (map (lambda (i) (string-append (make-string 30 c) "\n")) (iota 1000))))]
           [v (views:make b)])
      (drawn v desktop)
      (report! desktop v 1 0 #t)
      (list-ref (drawn v desktop) 4)))
> (list (sizer "ascii" #\x) (sizer "box" #\x2502) (sizer "braille" #\x28FF))
((20015) (20015) (20015))
; A raw byte is an atom drawn in its line, so a file that is not UTF-8
; is estimated as text too: 1,000 lines of Latin-1 with two such bytes
; each, and 1,000 lines of nothing but such bytes.
> (define (raw-sizer name line)
    (let ([b (buffers:make name "")])
      (buffers:splice! b 1 1 (document:from-utf8 (apply bytevector (apply append (make-list 1000 line)))))
      (let ([v (views:make b)])
        (drawn v desktop)
        (report! desktop v 1 0 #t)
        (list-ref (drawn v desktop) 4))))
> (list (raw-sizer "latin1" (append (make-list 3 120) '(233) (make-list 5 120) '(233) (make-list 20 120) '(10)))
        (raw-sizer "binary" (append (map (lambda (i) (+ 128 i)) (iota 30)) '(10))))
((20015) (20015))
; Three raw bytes between text are one item with it: point on the middle
; one places its line.
> (define bytes (buffers:make "bytes" ""))
> (buffers:splice! bytes 1 1 (document:from-utf8 (bytevector 97 233 234 235 98 10)))
#<edit 1>
> (define w (views:make bytes))
> (views:set-point! w 3)
> (numbers-after (html-of w desktop) "data-place-item=\"")
(1)
> (raw-sizer "between" '(97 233 234 235 98 10))
(20011)
; A list's rows are atoms standing alone, each a whole item, so the rows
; not measured are estimated at the mean of the 20 that were.
> (import (ui))
> (define rows (buffers:make "*rows*" (ui:list '())))
> (ui:set-rows! rows (document:token (buffers:document rows) 0) (list->vector (iota 300)) (lambda (n) (ui:label (number->string n))) (lambda (r) r) 300)
> (define r (views:make rows))
> (define (row-mark k) (list (cons "at" (+ k 1))))
> (let ([html (html-of r desktop)])
    ((table-ref web:input-handlers "scroll") desktop
     `(("type" . "scroll") ("view" . ,(views:id r)) ("placement" . ,(car (numbers-after html "data-placement=\"")))
       ("report" . 1000) ("version" . ,(car (numbers-after html "data-version=\""))) ("top" . ,(row-mark 0)) ("offset" . 0)
       ("itemHeight" . 20) ("left" . 0) ("start" . (("at" . 1) ("count" . 0))) ("end" . (("at" . 20) ("count" . 0)))
       ("spacer" . null) ("spacerDistance" . 0) ("below" . 0)
       ("items" . ,(list->vector (map (lambda (k) (vector (row-mark k) 20)) (iota 20))))
       ("lineHeight" . 20) ("charWidth" . 10) ("width" . 800) ("height" . 400)
       ("settled" . #t) ("hand" . #t) ("runAtEnd" . #f))))
> (decimal-after (html-of r desktop) "--views-scroll-sizer-block-size:")
5981.46
; An edit in an estimate counts only what it inserted, so the map drifts
; from a fresh estimate until the text is measured. Ten characters typed
; one at a time into line 500 of wrapped text, then five newlines deleted
; there; each pair is the view's sizer, then a fresh view's.
> (define typed (buffers:make "typed" (apply string-append (map (lambda (i) (string-append (make-string 30 #\x) "\n")) (iota 1000)))))
> (define (sizer-of b)
    (let ([v (views:make b)])
      (views:set-option! v views:wrap-lines #t)
      (drawn v desktop)
      (report! desktop v 1 0 #t)
      (cons v (list-ref (drawn v desktop) 4))))
> (define t1 (car (sizer-of typed)))
> (define (sizers)
    (report! desktop t1 1 0 #t)
    (list (list-ref (drawn t1 desktop) 4) (cdr (sizer-of typed))))
> (sizers)
((20015) (20015))
> (do ([i 0 (+ i 1)]) ((= i 10)) (buffers:splice! typed (+ 1 (* 31 500) 10 i) (+ 1 (* 31 500) 10 i) (document:from-datum "y")))
> (sizers)
((20017) (20016))
> (do ([k 504 (- k 1)]) ((< k 500)) (let ([at (+ 1 (* 31 k) 40)]) (buffers:splice! typed at (+ at 1) (document:from-datum ""))))
> (let ([d (buffers:document typed)]) (document:line d (- (document:length d) 1)))
996
> (sizers)
((20014) (19936))
