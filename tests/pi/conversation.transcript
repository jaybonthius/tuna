> (define chat (pi:start (getenv "HOME")))
> (define f (fake-of chat))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'idle)))
> (activities!)
(idle)
; A reply shows while Pi writes it, keyed by its place on the branch,
; with no entry id yet.
> (say! f (event "agent_start")
        (event "message_start" (cons "message" (user-message "Hi")))
        (event "message_end" (cons "message" (user-message "Hi")))
        (event "message_start" (cons "message" (assistant-message "pending")))
        (update '(("type" . "text_start") ("contentIndex" . 0)))
        (update '(("type" . "text_delta") ("contentIndex" . 0) ("delta" . "Hel"))))
> (testing:wait-until (lambda () (= 2 (length (pi:chat-transcript chat)))))
> (transcript chat)
((user 0 #f "Hi") (reply 1 #f pending ((text "Hel"))))
> (activities!)
(thinking replying)
; Pi's output is split into records on LF only: U+2028 may stand inside
; a string.
> (say! f (update '(("type" . "text_delta") ("contentIndex" . 0) ("delta" . "lo\x2028;**there**"))))
> (testing:wait-until (lambda () (equal? (cadr (transcript chat)) '(reply 1 #f pending ((text "Hello\x2028;**there**"))))))
> (cadr (transcript chat))
(reply 1 #f pending ((text "Hello\x2028;**there**")))
> (say! f (update '(("type" . "text_end") ("contentIndex" . 0) ("content" . "Hello **there**"))))
> (testing:wait-until (lambda () (equal? (cadr (transcript chat)) '(reply 1 #f pending ((text "Hello **there**"))))))
> (cadr (transcript chat))
(reply 1 #f pending ((text "Hello **there**")))
; A reply ending is not idle: retries, compaction and queued messages
; may follow. Pi is idle once it settles; then pi reads the entries, and
; each item keeps its key and gains its entry id. Pi's system prompt and
; model changes are entries but not items.
> (append-entry! f (entry "s1" #f '(("role" . "system") ("content" . "") ("timestamp" . 0))))
> (append-entry! f (entry "u1" "s1" (user-message "Hi")))
> (append-entry! f '(("type" . "model_change") ("id" . "m1") ("parentId" . "u1") ("provider" . "fake") ("modelId" . "x")))
> (append-entry! f (entry "a1" "m1" (assistant-message "stop" (text-block "Hello **there**"))))
> (say! f (event "message_end" (cons "message" (assistant-message "stop" (text-block "Hello **there**"))))
        (event "agent_end"))
> (timers:sleep 0.2)
> (pi:chat-activity chat)
replying
> (say! f (event "agent_settled" '("aborted" . #f)))
> (testing:wait-until (lambda () (equal? (transcript chat) '((user 0 "u1" "Hi") (reply 1 "a1" stop ((text "Hello **there**")))))))
> (transcript chat)
((user 0 "u1" "Hi") (reply 1 "a1" stop ((text "Hello **there**"))))
> (list (pi:chat-activity chat) (pi:reply-model (cadr (pi:chat-transcript chat))) (pi:reply-error (cadr (pi:chat-transcript chat))))
(idle "fake-model" #f)
; After a settle pi reads only the entries since the last it saw.
> (run-turn! f "u2" "a2" "Again" '("Once " "more"))
> (testing:wait-until (lambda () (= 4 (length (filter pi:item-entry-id (pi:chat-transcript chat))))))
> (map (lambda (r) (ref r "since")) (filter (lambda (r) (equal? (ref r "type") "get_entries")) (fake-requests f)))
(#f #f "a1")
> (list-tail (transcript chat) 2)
((user 2 "u2" "Again") (reply 3 "a2" stop ((text "Once more"))))
> (activities!)
(idle thinking replying idle)
; Thinking and tool calls: a tool call is called, then running with its
; output so far, then done or failed, with how long it took. Its
; arguments are kept from the start of its run.
> (say! f (event "agent_start")
        (event "message_start" (cons "message" (assistant-message "pending")))
        (update '(("type" . "thinking_start") ("contentIndex" . 0)))
        (update '(("type" . "thinking_delta") ("contentIndex" . 0) ("delta" . "Let me look")))
        (update '(("type" . "toolcall_start") ("contentIndex" . 1) ("id" . "t1") ("toolName" . "bash"))))
> (testing:wait-until (lambda () (= 5 (length (pi:chat-transcript chat)))))
> (list-ref (transcript chat) 4)
(reply 4 #f pending ((thinking "Let me look") (tool "bash" called "")))
> (activities!)
(thinking replying)
> (append-entry! f (entry "a3" "a2" (assistant-message "toolUse" (thinking-block "Let me look") (tool-block "t1" "bash" '(("command" . "ls"))))))
> (say! f (update `(("type" . "toolcall_end") ("contentIndex" . 1) ("toolCall" . ,(tool-block "t1" "bash" '(("command" . "ls"))))))
        (event "message_end" (cons "message" (assistant-message "toolUse" (thinking-block "Let me look") (tool-block "t1" "bash" '(("command" . "ls"))))))
        (event "tool_execution_start" '("toolCallId" . "t1") '("toolName" . "bash") '("args" . (("command" . "ls"))))
        (event "tool_execution_update" '("toolCallId" . "t1") '("toolName" . "bash")
               '("partialResult" . (("content" . #((("type" . "text") ("text" . "a.txt\n"))))))))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'running)))
> (list-ref (transcript chat) 4)
(reply 4 #f tool-use ((thinking "Let me look") (tool "bash" running "a.txt\n")))
> (let ([call (cadr (pi:reply-parts (list-ref (pi:chat-transcript chat) 4)))])
    (list (pi:tool-call-id call) (pi:tool-call-arguments call) (pi:tool-call-duration call)))
("t1" (("command" . "ls")) #f)
> (say! f (event "tool_execution_end" '("toolCallId" . "t1") '("toolName" . "bash") '("isError" . #f) '("durationMs" . 1500)
               '("result" . (("content" . #((("type" . "text") ("text" . "a.txt\nb.txt\n")) (("type" . "image") ("data" . "") ("mimeType" . "image/png"))))))))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'thinking)))
> (let ([call (cadr (pi:reply-parts (list-ref (pi:chat-transcript chat) 4)))])
    (list (pi:tool-call-state call) (pi:tool-call-output call) (pi:tool-call-images call) (pi:tool-call-duration call)))
(done "a.txt\nb.txt\n" 1 3/2)
; A reply that failed keeps why: its stop reason and Pi's message.
> (append-entry! f (entry "r1" "a3" (tool-result "t1" "bash" "a.txt\nb.txt\n" #f)))
> (append-entry! f (entry "a4" "r1" (append (assistant-message "error" (text-block "Partial")) '(("errorMessage" . "529 overloaded")))))
> (say! f (event "message_start" (cons "message" (assistant-message "pending")))
        (event "message_end" (cons "message" (append (assistant-message "error" (text-block "Partial")) '(("errorMessage" . "529 overloaded"))))))
> (testing:wait-until (lambda () (= 6 (length (pi:chat-transcript chat)))))
> (let ([r (list-ref (pi:chat-transcript chat) 5)]) (list (pi:reply-stop r) (pi:reply-error r)))
(error "529 overloaded")
; Pi's failures that are not replies become notices of Tuna's: an
; extension's notify or failure, a compaction or a retry that failed.
> (say! f (event "compaction_start" '("reason" . "threshold")))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'compacting)))
> (say! f (event "compaction_end" '("reason" . "threshold") '("aborted" . #f) '("willRetry" . #f) '("errorMessage" . "too long"))
        (event "auto_retry_start" '("attempt" . 1) '("maxAttempts" . 3) '("delayMs" . 10) '("errorMessage" . "overloaded")))
> (testing:wait-until (lambda () (eq? (pi:chat-activity chat) 'retrying)))
> (say! f (event "auto_retry_end" '("success" . #f) '("attempt" . 3) '("finalError" . "still overloaded"))
        (event "extension_error" '("extensionPath" . "/x/guard.ts") '("event" . "tool_call") '("error" . "boom"))
        '(("type" . "extension_ui_request") ("id" . "n1") ("method" . "notify") ("message" . "Blocked rm") ("notifyType" . "warning")))
> (testing:wait-until (lambda () (= 4 (length (filter pi:notice? (pi:chat-transcript chat))))))
> (map describe (filter pi:notice? (pi:chat-transcript chat)))
((notice error "Compaction failed: too long") (notice error "Retrying failed: still overloaded") (notice error "Extension /x/guard.ts: boom") (notice warning "Blocked rm"))
> (map pi:item-key (filter pi:notice? (pi:chat-transcript chat)))
((6 . 0) (6 . 1) (6 . 2) (6 . 3))
> (activities!)
(running thinking compacting thinking retrying thinking)
; The run settles; the entries hold its messages, and tool results
; complete their calls.
> (say! f (event "agent_settled" '("aborted" . #f)))
> (testing:wait-until (lambda () (= 6 (length (filter pi:item-entry-id (pi:chat-transcript chat))))))
