; The server starts once the configuration has run, on the port it set.
> (http:wait-for-server)
Tuna is at http://127.0.0.1:PORT/
> (define (status . headers) (http:status (http:get "/web/tuna.js" headers)))
> (define (at text) (format "~a:~a" text (web:port)))
; A request whose Host is not one Tuna answers to, or whose Origin is
; another site's, gets 403.
> (list (status) (status (cons "host" (at "localhost"))) (status (cons "host" (at "LOCALHOST")))
        (status '("host" . "evil.example")) (status (cons "host" (format "127.0.0.1:~a" (+ (web:port) 1))))
        (status '("host" . "127.0.0.1")))
(200 200 200 403 403 403)
> (list (status (cons "origin" (at "http://127.0.0.1"))) (status (cons "origin" (at "https://localhost")))
        (status '("origin" . "http://evil.example")) (status '("origin" . "null"))
        (status (cons "origin" (string-append (at "http://127.0.0.1") ".evil.example"))))
(200 200 403 403 403)
> (http:status (http:post "/input" '(("origin" . "http://evil.example")) "{}"))
403
; web:hosts names more hosts, such as one tailscale serve forwards.
> (set-option! web:hosts '("tuna.example.ts.net"))
> (list (status '("host" . "tuna.example.ts.net")) (status '("host" . "Tuna.Example.ts.net"))
        (status '("host" . "tuna.example.ts.net") '("origin" . "https://tuna.example.ts.net"))
        (status '("host" . "other.ts.net")))
(200 200 200 403)
> (set-option! web:hosts '(tuna))
! set-option!: (tuna) is not a valid value for web:hosts
> (set-option! web:port 0)
! set-option!: 0 is not a valid value for web:port
; The page, Tuna's page module and Datastar are served; nothing else is.
> (define (fetch path) (let ([r (http:get path)]) (list (http:status r) (http:header r "content-type"))))
> (map fetch '("/web/tuna.js" "/web/datastar.js" "/" "/nothing" "/web/nothing.js" "/web/../web.sls" "/web/%2e%2e/web.sls" "/files/1/x.css"))
((200 "text/javascript; charset=utf-8") (200 "text/javascript; charset=utf-8") (200 "text/html; charset=utf-8") (404 "text/plain") (404 "text/plain") (404 "text/plain") (404 "text/plain") (404 "text/plain"))
> (http:header (http:get "/") "cache-control")
"no-store"
; Setting the port moves the server.
> (define first-port (web:port))
> (set-option! web:port (http:free-port))
Tuna is at http://127.0.0.1:PORT/
> (status)
200
> (guard (e [(error? e) (condition-message e)]) (http:on-port first-port (lambda () (status))))
"cannot connect"
; A port in use is reported, and the server starts when the port is set
; again.
> (define second-port (web:port))
> (define taken-port (http:free-port))
> (define taken (http:occupy! taken-port))
> (set-option! web:port taken-port)
! (web) start-server: cannot listen on 127.0.0.1 port PORT: Address already in use
> (guard (e [(error? e) (condition-message e)]) (http:on-port second-port (lambda () (status))))
"cannot connect"
> (set-option! web:port (http:free-port))
Tuna is at http://127.0.0.1:PORT/
> (status)
200
