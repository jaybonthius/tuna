;; (h2o ffi) includes build/h2o/layout.ss from its own folder, so H2O's
;; build goes there.
(library chez-h2o
  (git "https://github.com/jaybonthius/chez-h2o.git")
  (commit "5acd9edd773ef02834e1803b5d013c50167038a6")
  (library-directories ("src" . "build/obj/src"))
  (build "make" "-s" "h2o" "H2O_BUILD=src/h2o/build/h2o"))
(library chez-json
  (git "https://github.com/jaybonthius/chez-json.git")
  (commit "542c745ae1dcbe914b033df7cb8483ec4d9c26f3")
  (library-directories ("src" . "build/obj/src"))
  (build))
(library chez-haml
  (git "https://github.com/jaybonthius/chez-haml.git")
  (commit "9fa69ebbf4aea9f7dd078e846f52d8cfa9172c3b")
  (library-directories ("src" . "build/obj/src"))
  (build))
(library chez-json-rpc
  (git "https://github.com/jaybonthius/chez-json-rpc.git")
  (commit "1de54bf0797373f801e4e4d96151651191d4d53d")
  (library-directories ("src" . "build/obj/src"))
  (build))
(library chez-datastar
  (git "https://github.com/jaybonthius/chez-datastar.git")
  (commit "bf69167c6afbe43f1dd5bb6fa3779081dbca9369")
  (library-directories ("src" . "build/obj/src"))
  (build))
(library chez-process
  (git "https://github.com/jaybonthius/chez-process.git")
  (commit "1d3356c0f82248125ae4771d116f94597046f2df")
  (library-directories ("src" . "build/obj/src"))
  (build "make" "build/obj/src/process/libchez-process.so"))
(library chez-md4c
  (git "https://github.com/jaybonthius/chez-md4c")
  (commit "e9d08ede95e180b415a397abf1bcaf76f0c010b2")
  (library-directories ("src" . "build/obj/src"))
  (build "make" "build/obj/src/md4c/libchez-md4c.so"))
;; Chez looks for the build/config.ss that (ghostty ffi) includes in the
;; library's own folder, src/ghostty, and the library's make writes it at
;; the root, so the build copies it there.
(library chez-libghostty
  (git "https://github.com/jaybonthius/chez-libghostty.git")
  (commit "0a3d7b524573774e12ab47df46fc7733538724da")
  (library-directories ("src" . "build/obj/src"))
  (build "sh" "-c" "make ghostty build/config.ss && mkdir -p src/ghostty/build && cp build/config.ss src/ghostty/build/config.ss"))
