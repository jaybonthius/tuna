4
> (modes:set-major-mode modes:fundamental k)
> (brackets k)
()
> (tables:remove! syntax:bracket-users 'test)
> (syntax-highlighting:update!)
; After an edit the job lexes the newest text, and the faces follow;
; text typed right after a lexeme takes its face until then.
> (define w (scheme-buffer "w.ss" "(car x)\n"))
> (faces w)
(("car" function.builtin))
> (begin (buffers:replace! w 5 5 "-or-cdr") (buffers:spans (buffers:layer w syntax-highlighting:faces) 0 15))
((2 12 ((face . function.builtin))))
> (faces w)
()
> (buffers:replace! w 1 1 "'")
#<edit 2>
> (faces w)
(("'" punctuation.special) ("car-or-cdr" string.special.symbol) ("x" string.special.symbol))
; The spans do not travel, so a kill carries no highlights.
> (let ([copy (buffers:make "copy" "\n")]) (buffers:insert! copy 1 (buffers:piece w 2 12)) (buffers:layers copy))
()
; The job is told where each edit was, so a space typed after a lexeme,
; among other spaces, loses the lexeme's face at the next lex.
> (define sp (scheme-buffer "sp.ss" "(car   x)\n"))
> (faces sp)
(("car" function.builtin))
> (buffers:replace! sp 5 5 " ")
#<edit 1>
> (faces sp)
(("car" function.builtin))
; Names: the scope comes from the text. #!tuna gives (chezscheme) and
; (tuna), #!tuna (chezscheme) and (tuna base); import forms give
; their specs, with only, except, prefix, rename, library and for;
; use-plugin lines give the plugin's main module, and a configuration,
; which loads into the REPL's environment, also has the REPL's scope.
> (define (word-faces content . words)
    (let ([b (scheme-buffer "names.ss" content)])
      (settle b)
      (let ([result (map (lambda (word) (face-of b word)) words)])
        (buffers:kill! b)
        result)))
