; RET in a list with no rows says there is nothing at point.
> (mode! notes #t)
> (define nv (view))
> (press! "C-c" "l" "b")
> (define lv (car (views:showing (buffers:find "*Diagnostics notes.txt*"))))
> (layout:select! lv)
> (press! "RET")
! diagnostics-list:go-to-diagnostic: Nothing at point
> (define source (diagnostics:make-source))
> (diagnostics:report! source notes
    (list (mark notes "beta" (diagnostics:severity warning) "vague")
          (mark notes "delta" (diagnostics:severity error) "wrong")
          (mark notes "zeta" (diagnostics:severity info) "short")))
#t
; RET goes and highlights the diagnostic for a moment; the next command
; ends the highlight.
> (press! "RET")
> (list (eq? (view) nv) (views:point nv) (pulsed? nv) (pulsed? lv))
(#t 7 #t #f)
> (press! "C-f")
> (pulsed? nv)
#f
; SPC shows the next row's diagnostic highlighted and records no jump.
> (layout:select! lv)
> (define before (jump-history:places))
> (press! "C-n" "SPC")
> (list (eq? (view) lv) (views:point nv) (pulsed? nv) (equal? before (jump-history:places)))
(#t 18 #t #t)
; The highlight also ends by itself, after pulse:duration.
> (options:with ([pulse:duration 0.05]) (press! "SPC"))
> (timers:sleep 0.2)
> (pulsed? nv)
#f
; n and p name the list they move in, as next-error does.
> (press! "n")
> (list (selected lv) (views:point nv) (pulsed? nv) (echo-area:current-message))
(2 32 #t "Next locus from *Diagnostics notes.txt*")
; On the last row, n shows the last diagnostic again.
> (views:set-point! nv 1)
> (press! "n")
> (list (selected lv) (views:point nv) (pulsed? nv) (echo-area:current-message))
(2 32 #t "Next locus from *Diagnostics notes.txt*")
> (press! "p")
> (list (selected lv) (echo-area:current-message))
(1 "Previous locus from *Diagnostics notes.txt*")
; A digit is a count, as in every special buffer.
> (press! "M-<" "2" "n")
> (selected lv)
2
> (views:call-with-view lv (lambda () (map (lambda (k) (commands:command-name (keys:lookup-in (keys:active-keymaps client #f) k))) '("S-SPC" "DEL"))))
(views:scroll-down views:scroll-down)
; With the list alone in its level, RET splits a view for the source and
; selects it, keeping the list.
> (layout:select! nv)
> (define (names) (map (lambda (v) (buffers:name (views:buffer v))) (filter (lambda (v) (memq (views:buffer v) (list notes (views:buffer lv)))) (layout:views))))
> (press! "C-x" "0")
> (list (eq? (view) lv) (names))
(#t ("*Diagnostics notes.txt*"))
> (press! "RET")
> (list (eq? (views:buffer (view)) notes) (views:point (view)) (names))
(#t 32 ("*Diagnostics notes.txt*" "notes.txt"))
; RET on a project list's row of a file no buffer visits visits it and
; goes there; making a list calls the mode's hook in it.
> (define made '())
> (hooks:add! diagnostics-list:mode-hook (lambda () (set! made (cons (buffers:name (buffers:current)) made))))
> (define other (write-file! "other.txt" "one\ntwo\n"))
> (diagnostics:report! source other (list (diagnostics:make-diagnostic '(2 . 1) '(2 . 3) (diagnostics:severity hint) "late")))
#t
> (layout:select! (car (filter (lambda (v) (eq? (views:buffer v) notes)) (layout:views))))
> (press! "C-c" "l" "e")
> (define pb (buffers:find (string-append "*Diagnostics " root "/*")))
> (define pv (car (views:showing pb)))
> (list made (map car (rows pv)))
(("*Diagnostics $HOME/project/*") ("notes.txt" "notes.txt" "notes.txt" "other.txt"))
> (layout:select! pv)
> (press! "M->" "RET")
> (list (buffers:name (views:buffer (view))) (views:point (view)) (pulsed? (view)))
("other.txt" 6 #t)
; A killed buffer's diagnostics leave the project's list.
> (define ob (files:buffer-visiting other))
> (buffers:kill! ob)
#t
> (map car (rows pv))
("notes.txt" "notes.txt" "notes.txt")
; A click on a project list's file name goes there too, after selecting
; the list and the row, visiting a file no buffer visits.
> (define third (write-file! "third.txt" "a\nb\nc\n"))
> (diagnostics:report! source third (list (diagnostics:make-diagnostic '(3 . 0) '(3 . 1) (diagnostics:severity hint) "last")))
#t
> (layout:select! (car (filter (lambda (v) (eq? (views:buffer v) notes)) (layout:views))))
> (click-in! pv (row-token pv 3) (list (mark-number diagnostics-list:link-keymap)) 1)
> (list (buffers:name (views:buffer (view))) (views:point (view)) (selected pv) (pulsed? (view)))
("third.txt" 5 3 #t)
; SPC, C-o, n and p show a diagnostic without jumping: they mark it but
; do not recentre the source's view; RET, a jump, recentres it.
> (define centred '())
> (advice-add! views:scroll-to! (lambda (orig v p align) (when (eq? align (views:align center)) (set! centred (cons (buffers:name (views:buffer v)) centred))) (orig v p align)))
> (layout:switch-to-buffer notes)
> (define nv (view))
> (press! "C-c" "l" "b")
> (define lv (car (views:showing (buffers:find "*Diagnostics notes.txt*"))))
> (layout:select! lv)
> (press! "M-<" "SPC")
> (list centred (pulsed? nv))
(() #t)
> (press! "C-o" "n" "p")
> centred
()
> (press! "RET")
> centred
("notes.txt")
