; A thread forked in a command runs no command.
> (define forked #f)
> (commands:define-command (forker)
    "Forks a thread that reads the keys."
    (fork-thread
      (lambda ()
        (set! forked (list (keys:command-keys) (keys:typed-char) (keys:shift-translated?))))))
