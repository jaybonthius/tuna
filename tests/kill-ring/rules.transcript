; The options, hook and table are documented, and the configuration's
; setting is in effect beneath the REPL's.
> (map documentation (list kill-ring:max kill-ring:skip-duplicates kill-ring:after-push kill-ring:yankers))
("How many entries the ring keeps; pushing one more drops the oldest." "When true, pushing an entry whose text equals the newest entry's only moves the yank pointer to the newest." "Called with the newest entry after each push!, append! and prepend!." "Maps a node kind's name to a procedure of a buffer, a position and a buffers:piece that yanks a piece whose top node has that kind, returning the position after what it inserted.")
> (option-settings kill-ring:skip-duplicates)
(((repl) #f) ((init) #t))
; insert! returns what the buffer's edits inserted, read from its edit
; log. make-kill joins items into one kill that insert! yanks by calling
; its procedure with the buffer and the position, so a procedure that
; inserts in several places reports nothing itself; the ring never joins
; such a kill to another, nor another to it.
> (define w (buffers:make "plain-text" "one two\n"))
> (define joined (kill-ring:join (buffers:piece w 1 4) "\n" "two"))
> (list (kill-ring:text (list joined)) (kill-ring:insert! w 1 joined) (document:text (buffers:document w)))
("one\ntwo" ((1 . 8)) "one\ntwoone two\n")
> (define handled
    (kill-ring:make-kill (list "ab" "cd")
      (lambda (buffer position)
        (let ([middle (buffers:insert! buffer position "[ab|")])
          (buffers:insert! buffer (+ middle 3) "cd]")))))
> (list (kill-ring:insert! w 1 handled) (document:text (buffers:document w)))
(((1 . 5) (8 . 11)) "[ab|onecd]\ntwoone two\n")
; The edit log is read in one pass, insertions in any order: ones made
; before, inside or next to earlier ones move or join them.
> (define d (buffers:make "digits" "0123456789\n"))
> (define scattered
    (kill-ring:make-kill (list "x")
      (lambda (buffer position)
        (buffers:insert! buffer 8 "B") (buffers:insert! buffer 3 "A")
        (buffers:insert! buffer 4 "xy") (buffers:insert! buffer 5 "z"))))
> (list (kill-ring:insert! d 1 scattered) (document:text (buffers:document d)))
(((3 . 7) (12 . 13)) "01Axzy23456B789\n")
; A procedure's insertions go in whole or not at all, as a kill of
; several parts does: one refused after others went in takes them back.
> (buffers:define-layer guarded (read-only))
> (define g (buffers:make "guarded" "aaa\nbbb\nccc\n"))
> (buffers:add-span! (buffers:layer g guarded) 5 8 'locked)
> (define two-places
    (kill-ring:make-kill (list "x")
      (lambda (buffer position) (buffers:insert! buffer position "x") (buffers:insert! buffer 7 "x"))))
> (list (raised (lambda () (kill-ring:insert! g 2 two-places))) (document:text (buffers:document g)))
((buffers:insert! "a read-only span refuses the edit") "aaa\nbbb\nccc\n")
