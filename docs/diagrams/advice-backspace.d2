# What happens when you press Backspace with the hungry-delete plugin on?
vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
  }
}
shape: sequence_diagram

you: "You"
keys: "Key handling plugin"
commands: "Commands plugin"
hungry: "Hungry delete advice"
original: "Original Backspace command"

you -> keys: "1. Backspace"
keys -> commands: "2. run the Backspace command"
commands -> hungry: "3. call the combined command"
hungry -> hungry: "4a. spaces before point: delete that run"
hungry -> original: "4b. otherwise: call the original"
commands -> you: "5. the command finishes; the screen redraws"
