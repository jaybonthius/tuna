> (remove-hook! files:after-rename note-rename)
; With real quits: a task started as the job starts signals the renaming
; task, as a C-g typed during the rename does. Whether or not the file
; moved, its buffer visits it where it is.
> (define (signal-at-start start worker input on-result . on-end)
    (let ([j (apply start worker input on-result on-end)])
      (when renamer
        (let ([t renamer]) (spawn-task (lambda () (signal-task t 'quit)))))
      j))
> (advice-add! jobs:start signal-at-start)
> (define (rename-quitting n)
    (let ([from (format "~~/f~a.txt" n)] [to (format "~~/g~a.txt" n)])
      (disk-checks:write-text! from "x\n")
      (let ([b (files:visit from)])
        (guard (c [(symbol? c) c])
          (set! renamer (current-task))
          (files:rename-file from to)
          (sleep-for 0.05))
        (set! renamer #f)
        (sleep-for 0.02)
        (list n (disk-checks:exists? to)
              (equal? (files:path b) (disk-checks:expand (if (disk-checks:exists? to) to from)))))))
> (filter (lambda (r) (not (caddr r))) (map rename-quitting (iota 100)))
()
> (advice-remove! jobs:start signal-at-start)
