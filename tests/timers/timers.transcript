; Arguments are checked, and a timer is a change, which only the main
; thread makes.
> (run-with-timer -1 ring)
! run-with-timer: not a number of seconds with irritant -1
> (run-with-timer 1 ring 0)
! run-with-timer: not a number of seconds to repeat after with irritant 0
> (run-with-timer 1 'ring)
! run-with-timer: not a procedure with irritant ring
> (cancel-timer! ring)
! cancel-timer!: not a timer with irritant #<procedure ring>
> (on-thread (lambda () (run-with-timer 1 ring)))
"only the main thread makes changes"
