> (> changes 20)
#t
; When an extension moves Pi to another session, the old cursor names no
; entry and Pi refuses it; pi reads the whole session instead, and takes
; the new session's id from Pi's state.
> (fake-entries-set! f '())
> (fake-leaf-set! f 'null)
> (fake-state-set! f '(("sessionId" . "other-session")))
> (append-entry! f (entry "n1" #f (user-message "Elsewhere")))
> (say! f (event "agent_settled" '("aborted" . #f)))
> (testing:wait-until (lambda () (equal? (transcript chat) '((user 0 "n1" "Elsewhere")))))
> (list (transcript chat) (pi:chat-session-id chat))
(((user 0 "n1" "Elsewhere")) "other-session")
