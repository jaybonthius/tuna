; A buffer killed while its save waits is written, and gets no after-save.
> (define saved-after '())
> (define (note-save b) (set! saved-after (cons (buffers:name b) saved-after)))
> (add-hook! files:after-save note-save)
> (define (kill-meanwhile b) (spawn-task (lambda () (buffers:kill! b))))
> (add-hook! files:before-save kill-meanwhile)
> (buffers:replace! one 1 1 "e")
#<edit 8>
> (files:save-buffer one)
> (remove-hook! files:before-save kill-meanwhile)
> (list (buffers:live? one) (files:buffer-visiting "~/one.txt") saved-after (disk-checks:read-text "~/one.txt"))
(#f #f () "etsdtyped cbaone\n")
; An edit made while a revert reads the file is reverted too: the revert
; reads again.
> (define two (files:visit "~/one.txt"))
> (disk-checks:write-text! "~/one.txt" "from disk\n")
> (begin
    (spawn-task (lambda () (buffers:replace! two 1 1 "typed ")))
    (files:revert-buffer two))
> (list (text two) (buffers:modified? two))
("from disk\n" #f)
