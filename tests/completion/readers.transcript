; Partial completion: each word starts the candidate's matching word.
> (completion:partial "u/l/b")
((starts "u" "/l" "/b"))
> (completion:partial "f*n")
((starts "f" "n"))
> (completion:partial "f-r-n")
((starts "f" "-r" "-n"))
> (completion:partial "")
()
; M-r and M-s read an entry of the prompt's history with a nested read
; that keeps no history, starting from the input.
> (define-saved h '("gamma" "beta" "alpha") list?)
> (define t (start! (lambda () (minibuffer:read "Word: " h))))
> (type! "et")
> (define nested (start! (lambda () (press! "M-r"))))
> (texts (session))
("beta")
> (press! "RET")
> (result nested)
> (input)
"beta"
> (press! "RET")
> (result t)
"beta"
> (h)
("beta" "gamma" "alpha")
> (define t (start! (lambda () (completion:read "Word: " (list (completion:source (candidates (vector "one" "two")))) h))))
> (define nested (start! (lambda () (press! "M-s"))))
> (texts (session))
("beta" "gamma" "alpha")
> (press! "C-g")
! &quit
> (result nested)
> (press! "C-g")
! &quit
> (define t (start! (lambda () (minibuffer:read "Word: " #f))))
> (press! "M-r")
! completion:search-history: History is empty
> (echo-area:current-message)
"completion:search-history: History is empty"
> (press! "C-g")
! &quit
