; C-x C-c runs a command whose after-thunk raises as exit leaves the
; command's task: the raise is reported, the plugin asks, and y exits.
> (import (commands))
> (commands:define-command (leave) "Exits." (dynamic-wind void (lambda () (exit)) (lambda () (car '()))))
> (keys:bind! keys:global "C-x C-c" leave)
> (press! "C-x")
> (press! "C-c")
! car: () is not a pair
> (prompts)
((minibuffer:%prompts () (minibuffer:prompt ((depth . 1)) (minibuffer:question () "Exception in car: () is not a pair; exit anyway? (y or n) ") (minibuffer:input-field ()) "\n" (minibuffer:content ()))))
> (press! "y")
configuration unloading
> (display "never runs")
