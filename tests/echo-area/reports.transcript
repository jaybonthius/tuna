> (messages)
"car: () is not a pair\nspell:check: no dictionary\nspell:check: no word with irritant 42\ntwo irritants with irritants (1 \"b\")\nf: bad 3 and \"x\"\nspell:check: slow\ng: &error with irritants (1 2)\nnon-condition value 42\nspell:check: aspell is slow\nnotes:consent: not today\nBefore\nnotes:draw: cannot draw [12 times]\nfirst\nsecond\n"
; A quit shows Quit once: keyboard-quit's advice says it, and the advice
; on report skips quits, as when C-g quits a paused command.
> (commands:define-command (wait) "Waits until quit." (suspend (lambda (resume) #f)))
> (keys:bind! keys:global "C-c w" wait)
> (define waiting (spawn-task (lambda (restore) (press! "C-c" "w"))))
> (timers:sleep 0.1)
> (press! "C-g")
! &cancelled
> (testing:wait-until (lambda () (eq? (task-state waiting) 'done)))
> (eq? (task-state waiting) 'done)
#t
