; A buffer's list needs the mode on there; it shows a row per diagnostic,
; its line and column, its severity, origin and code, and message, with
; the row of the diagnostic at point selected.
> (define source (diagnostics:make-source))
> (define (report! . ds) (diagnostics:report! source notes ds))
> (report! (mark notes "beta" (diagnostics:severity warning) "vague")
           (diagnostics:make-diagnostic (word notes "delta") (+ (word notes "delta") 5) (diagnostics:severity error) "wrong"
             (diagnostics:details [origin "lint"] [code "E1"]))
           (mark notes "zeta" (diagnostics:severity info) "short"))
#t
> (press! "C-c" "l" "b")
! diagnostics-list:show-buffer-diagnostics: Diagnostics are off in this buffer
> (mode! notes #t)
> (views:set-point! (view) (+ (word notes "delta") 2))
> (press! "C-c" "l" "b")
> (define lv (car (views:showing (buffers:find "*Diagnostics notes.txt*"))))
> (list (rows lv) (selected lv) (eq? (view) lv))
((("1:6" "warning" "vague") ("2:0" "error" "lint" "E1" "wrong") ("3:0" "info" "short")) 1 #f)
; The list follows changes, keeping each view's selected diagnostic.
> (define delta (cadr (diagnostics:in notes)))
> (report! (mark notes "alpha" (diagnostics:severity error) "first")
           (mark notes "beta" (diagnostics:severity warning) "vague") delta (mark notes "zeta" (diagnostics:severity info) "short"))
#t
> (list (map car (rows lv)) (selected lv))
(("1:0" "1:6" "2:0" "3:0") 2)
> (buffers:replace! notes (word notes "alpha") (+ (word notes "alpha") 5) "")
#<edit 1>
> (list (map car (rows lv)) (selected lv))
(("1:1" "2:0" "3:0") 1)
; The list's keys run public commands, which a user can bind elsewhere.
> (map (lambda (b) (cons (car b) (commands:command-name (cdr b)))) (keys:bindings diagnostics-list:keymap))
(("RET" . diagnostics-list:go-to-diagnostic) ("SPC" . diagnostics-list:show-diagnostic) ("C-o" . diagnostics-list:show-diagnostic) ("n" . diagnostics-list:next-diagnostic) ("p" . diagnostics-list:previous-diagnostic) ("<mouse-2>" . editing:mouse-set-point))
; RET goes to the selected row's diagnostic in another view, recording
; the place that view leaves.
> (define nv (view))
> (views:set-point! nv 1)
> (layout:select! lv)
> (press! "RET")
> (list (eq? (view) nv) (views:point nv) (word notes "delta") (map (lambda (p) (cons (buffers:name (car p)) (cdr p))) (jump-history:places)))
(#t 13 13 (("notes.txt" . 1)))
; SPC and C-o show the row's diagnostic there and stay in the list; n
; and p move to the next and previous row and show it.
> (layout:select! lv)
> (press! "p")
> (list (eq? (view) lv) (selected lv) (views:point nv))
(#t 0 2)
> (press! "n" "n")
> (list (eq? (view) lv) (selected lv) (views:point nv))
(#t 2 27)
> (views:set-point! nv 1)
> (press! "C-p" "SPC")
> (list (eq? (view) lv) (views:point nv))
(#t 13)
> (views:set-point! nv 1)
> (press! "C-o")
> (views:point nv)
13
; g builds the list again, keeping the selection; q quits its view.
> (press! "g")
> (list (map car (rows lv)) (selected lv))
(("1:1" "2:0" "3:0") 1)
> (press! "q")
> (memq lv (layout:views))
#f
; A project's list holds the diagnostics of its buffers and of its files
; no buffer visits, ordered by file.
> (define other (write-file! "other.txt" "one\ntwo\n"))
> (diagnostics:report! source other (list (diagnostics:make-diagnostic '(2 . 1) '(2 . 3) (diagnostics:severity hint) "late")))
#t
> (press! "C-c" "l" "e")
> (define pv (car (views:showing (buffers:find (string-append "*Diagnostics " root "/*")))))
> (rows pv)
(("notes.txt" "1:1" "warning" "vague") ("notes.txt" "2:0" "error" "lint" "E1" "wrong") ("notes.txt" "3:0" "info" "short") ("other.txt" "2:1" "hint" "late"))
> (diagnostics:clear! source other)
> (map car (rows pv))
("notes.txt" "notes.txt" "notes.txt")
; The counts segment: errors, warnings, and infos with hints, each with
; its number in data-count, Wait while a check runs, ! after a checker
; raised; nothing where the mode is off. A click shows the buffer's list.
> (layout:select! nv)
> (status nv)
("1" "1" "1")
> (let ([html (html->string (status-line:draw nv client))])
    (map (lambda (face) (and (search html (format "data-face=\"~a\" data-count=\"1\"" face) 0) #t)) '(error warning success)))
(#t #t #t)
> (define go? #f)
> (define (waiting b) (let loop () (unless go? (sleep-for 0.02) (loop))) '())
> (buffers:with-buffer notes (add-local-hook! diagnostics:checkers waiting))
> (buffers:with-buffer notes (commands:run diagnostics:check))
> (sleep-for 0.05)
> (status nv)
("1" "1" "1" "Wait")
> (set! go? #t)
> (sleep-for 0.1)
> (status nv)
("1" "1" "1")
> (buffers:with-buffer notes (remove-local-hook! diagnostics:checkers waiting))
> (define (broken b) (error 'broken "no linter"))
> (buffers:with-buffer notes (add-local-hook! diagnostics:checkers broken))
> (buffers:with-buffer notes (commands:run diagnostics:check))
! broken: no linter
> (sleep-for 0.05)
> (status nv)
("1" "1" "1" "!")
> (mode! notes #f)
> (status nv)
()
> (mode! notes #t)
> (buffers:kill! (buffers:find "*Diagnostics notes.txt*"))
#t
> (click-counts! nv)
> (and (buffers:find "*Diagnostics notes.txt*") (pair? (views:showing (buffers:find "*Diagnostics notes.txt*"))))
#t
