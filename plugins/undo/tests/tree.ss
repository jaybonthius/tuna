(import (tuna) (test) (test-user) (options) (hooks) (commands) (buffers) (views) (undo) (edits))

(test "an edit after an undo starts a branch; redo follows the child undo last left, else the newest; go-to! moves across branches"
  (let ([r (buffers:make "tree" "\n")])
    (edits:run-in r edits:insert 1 "a")
    (edits:run-in r edits:insert 2 "b")
    (edits:run-in r undo:undo 1)
    (edits:run-in r edits:insert 2 "c")
    (edits:run-in r undo:undo 1)
    (edits:run-in r undo:redo 1)
    (check-equal? "ac\n" (edits:text r))
    (edits:run-in r undo:undo 1)
    (undo:go-to! r 2)
    (check-equal? "ab\n" (edits:text r))
    (edits:run-in r undo:undo 1)
    (edits:run-in r undo:redo 1)
    (check-equal? "ab\n" (edits:text r))
    (check-equal? '(2 0 (0 #f) (1 0) (2 1) (3 1)) (edits:tree r))
    (undo:go-to! r 0)
    (check-equal? "\n" (edits:text r))
    (undo:go-to! r 3)
    (check-equal? "ac\n" (edits:text r))
    (check-raises (edits:raised? 'undo:go-to! "not a state of the buffer's history") (undo:go-to! r 9))
    (check-raises (edits:raised? 'undo:go-to! "not a state of the buffer's history") (undo:go-to! r -1)))
  (edits:take-said!))

(test "history gives the current state, the saved state, then each state with its parent and the time its group ended"
  (let ([notes (buffers:make "history" "Buy milk.\n")])
    (edits:run-in notes edits:insert 1 "a")
    (let ([h (undo:history notes)])
      (check-equal? '(1 0 ((0 #f #t) (1 0 #t)))
        (list (car h) (cadr h)
              (map (lambda (s) (list (car s) (cadr s) (and (integer? (caddr s)) (> (caddr s) 1700000000)))) (cddr h)))))))

(test "another after-edit entry that edits the buffer as undo splices ends the move there, as a state of its own, and the move raises"
  (let* ([k (buffers:make "sneak" "0123456789\n")] [sneak #f]
         [sneak-in (lambda (buffer edit)
                     (when (and sneak (eq? buffer k))
                       (set! sneak #f)
                       (buffers:replace! k 1 1 "!")))])
    (undo:with-edit-group k (buffers:replace! k 3 3 "a") (buffers:replace! k 9 9 "b"))
    (hooks:add! buffers:after-edit sneak-in)
    (set! sneak #t)
    (check-equal? '((undo:undo "the buffer does not hold the text its history expects"))
      (edits:reports-during (lambda () (edits:run-in k undo:undo 1))))
    (check-equal? '("!01a23456789\n" (3 0 (0 #f) (1 2) (2 0) (3 2))) (list (edits:text k) (edits:tree k)))
    (edits:run-in k undo:undo 2)
    (check-equal? "0123456789\n" (edits:text k))
    (undo:go-to! k 1)
    (check-equal? "01a23456b789\n" (edits:text k))
    (set! sneak #t)
    (edits:run-in k undo:undo 1)
    (check-equal? '("!01a23456789\n" (4 0 (0 #f) (1 2) (2 0) (3 2) (4 2))) (list (edits:text k) (edits:tree k)))
    (hooks:remove! buffers:after-edit sneak-in))
  (edits:take-said!))

(test "undo puts the view's cursors where they were before the group; redo puts them at the end of the group's last edit"
  (let* ([w (buffers:make "cursors" "one two\n")] [v (views:make w)])
    (views:set-point! v 4)
    (views:add-cursor! v 8)
    (views:with-view v (commands:run edits:insert 1 ">"))
    (views:with-view v (commands:run edits:delete 5 9))
    (check-equal? '(">one\n" (5)) (list (edits:text w) (map views:cursor-point (views:cursors v))))
    (views:set-point! v 1)
    (views:with-view v (commands:run undo:undo 1))
    (check-equal? '(">one two\n" (5 9)) (list (edits:text w) (map views:cursor-point (views:cursors v))))
    (views:with-view v (commands:run undo:redo 1))
    (check-equal? '(">one\n" (5)) (list (edits:text w) (map views:cursor-point (views:cursors v))))
    (views:drop! v))
  (edits:take-said!))

(test "a history is trimmed to the limit, the oldest groups first, a branch off the root before the path to the current state"
  (let ([s (buffers:make "small" "\n")])
    (buffers:with-buffer s (options:set-local! undo:limit 100))
    (for-each (lambda (x) (edits:run-in s edits:insert 1 x)) '("a" "b" "c" "d"))
    (test-user:settle)
    (check-equal? '(4 #f (1 #f) (2 1) (3 2) (4 3)) (edits:tree s))
    (check-equal? '((undo:undo "no further undo information")) (edits:reports-during (lambda () (edits:run-in s undo:undo 9))))
    (check-equal? "a\n" (edits:text s)))
  (let ([s2 (buffers:make "branches" "\n")])
    (buffers:with-buffer s2 (options:set-local! undo:limit 100))
    (edits:run-in s2 edits:insert 1 "a")
    (edits:run-in s2 undo:undo 1)
    (for-each (lambda (x) (edits:run-in s2 edits:insert 1 x)) '("b" "c" "d"))
    (test-user:settle)
    (check-equal? '(4 0 (0 #f) (2 0) (3 2) (4 3)) (edits:tree s2)))
  (edits:take-said!))

(test "one group larger than the limit empties the history, with a warning"
  (let ([s (buffers:make "large" "\n")])
    (buffers:with-buffer s (options:set-local! undo:limit 100))
    (edits:run-in s edits:insert 1 "a")
    (check-equal? '((undo:limit "an edit group is larger than the limit, so the buffer's history starts again"))
      (edits:reports-during
        (lambda ()
          (edits:run-in s edits:insert 1 (make-string 80 #\x))
          (test-user:settle))))
    (check-equal? '(2 #f (2 #f)) (edits:tree s))
    (let ([h (undo:history s)])
      (check (<= (abs (- (caddr (caddr h)) (time-second (current-time 'time-utc)))) 5)))
    (check-equal? '((undo:undo "no further undo information")) (edits:reports-during (lambda () (edits:run-in s undo:undo 1))))))

(test "the limit is 4,000,000 by default, and a buffer sets it locally; with 0 it keeps no history, though its edits mark it modified"
  (check-equal? 4000000 (undo:limit))
  (let ([z (buffers:make "none" "\n")])
    (buffers:with-buffer z (options:set-local! undo:limit 0))
    (check-equal? 0 (buffers:with-buffer z (undo:limit)))
    (check-equal? 4000000 (undo:limit))
    (edits:run-in z edits:insert 1 "a")
    (check-equal? '((undo:undo "no further undo information")) (edits:reports-during (lambda () (edits:run-in z undo:undo 1))))
    (check-equal? '("a\n" #t) (list (edits:text z) (buffers:modified? z))))
  (check-raises assertion-violation? (options:set! undo:limit -1)))

(test "undo says Undo and redo says Redo, a refused redo nothing; in an internal buffer, such as a prompt's, both say nothing"
  (edits:take-said!)
  (let ([b (buffers:make "said" "abc\n")])
    (edits:run-in b edits:insert 1 "1")
    (edits:run-in b undo:undo 1)
    (edits:run-in b undo:redo 1)
    (edits:reports-during (lambda () (edits:run-in b undo:redo 1)))
    (check-equal? '("Undo" "Redo") (edits:take-said!)))
  (let ([prompt (buffers:make " *prompt*" "abc\n")])
    (buffers:set-silent! prompt #f)
    (edits:run-in prompt edits:insert 1 "1")
    (edits:run-in prompt undo:undo 1)
    (edits:run-in prompt undo:redo 1)
    (check-equal? '() (edits:take-said!))))

(test "forget! drops the history, so the present text is the root of a new one"
  (let ([b (buffers:make "forgotten" "\n")])
    (edits:run-in b edits:insert 1 "a")
    (undo:forget! b)
    (check-equal? '((undo:undo "no further undo information")) (edits:reports-during (lambda () (edits:run-in b undo:undo 1))))
    (check-equal? "a\n" (edits:text b))))
