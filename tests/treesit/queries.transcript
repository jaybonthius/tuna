; Python's own query file sits in the python plugin's folder, and treesit
; reads it because python:mode declares the language: an assignment's
; target is a definition only in that file.
> (define text "x = len(y)\n")
> (faces (python "a.py" text))
(("x" variable.definition) ("len" function.builtin))
; A plugin whose mode declares a language adds the queries folder beside
; its module, for the buffers of every mode of that language.
> (write-file (string-append home "/.config/tuna/lib/pyish/queries/python/highlights.scm")
    "; extends\n((identifier) @constant (#eq? @constant \"y\"))\n")
> (define (pyish name) (let ([b (buffers:make name text)]) (modes:set-major-mode pyish:mode b) b))
> (list (faces (python "b.py" text)) (faces (pyish "c")))
((("x" variable.definition) ("len" function.builtin) ("y" constant)) (("x" variable.definition) ("len" function.builtin) ("y" constant)))
; Of two such plugins, the first to declare the language wins where their
; files capture the same text, as the first of the query folders does.
> (write-file (string-append home "/.config/tuna/lib/pyish/queries/python/highlights.scm")
    "; extends\n((identifier) @constant (#any-of? @constant \"x\" \"y\"))\n")
> (faces (pyish "d"))
(("x" variable.definition) ("len" function.builtin) ("y" constant))
; A mode declared outside a plugin, at the REPL or in init.ss, has no
; folder, and its buffers take the files of the plugins that declare its
; language.
> (tables:define-table repl-keymap "Keys.")
> (hooks:define-hook repl-hook "Setup.")
> (modes:define-major-mode replish (keymap repl-keymap) (hook repl-hook) (language "python"))
> (define e (buffers:make "e" text))
> (modes:set-major-mode replish e)
> (faces e)
(("x" variable.definition) ("len" function.builtin) ("y" constant))
> (define g (buffers:make "g" text))
> (modes:set-major-mode initish g)
> (faces g)
(("x" variable.definition) ("len" function.builtin) ("y" constant))
; With python off, its file is no longer read.
> (unload-owner! (module-owner '(python)))
> (define f (pyish "f"))
> (faces f)
(("x" constant) ("len" function.builtin) ("y" constant))
; Turning python on again gives its file to the open buffers of the
; language.
> (load-module! '(python))
#<owner (python) 2>
> (faces f)
(("x" variable.definition) ("len" function.builtin) ("y" constant))
; Reloading python after its file changed gives its open buffers the new
; file.
> (define p (python "p.py" text))
> (faces p)
(("x" variable.definition) ("len" function.builtin) ("y" constant))
> (define library (getenv "TUNA_LIBRARY"))
> (write-file (string-append library "/python/queries/python/highlights.scm")
    "; extends\n((identifier) @keyword (#eq? @keyword \"len\"))\n")
> (reload-modules! '((python)))
> (faces p)
(("x" constant) ("len" keyword) ("y" constant))
