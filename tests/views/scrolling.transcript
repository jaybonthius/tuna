; A press on the bar off its thumb is a mouse key in the bar's keymap, at
; the place at the press's share of the bar, counted in characters, and
; with its part as the page drew it, above or below the thumb, as
; Emacs's scroll bar events carry theirs; by default it scrolls a page
; toward its part, as Emacs's toolkit bar does. A press with no part
; does nothing.
> (set! steps '())
> (define (press-bar! part)
    (for-each
      (lambda (action)
        (as-client desktop
          (lambda ()
            ((table-ref web:input-handlers "mouse") desktop
             `(("type" . "mouse") ("action" . ,action) ("button" . 1) ("clicks" . 1) ("modifiers" . #())
               ("view" . ,(views:id v)) ("version" . 0) ("showing" . ,(views:shown-count v))
               ("line" . 100) ("chars" . 3) ("keymaps" . ,(vector (read (open-input-string (views:keymap-mark views:scroll-bar-keymap)))))
               ,@(if part `(("part" . ,part)) '()))))))
      '("down" "click")))
