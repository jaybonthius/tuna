; In semi-char mode, keys go to the program, encoded as a terminal
; encodes them, except those that start Tuna's sequences.
> (bytes-read '("a" "A" "C-a" "M-a" "<up>" "S-<up>" "RET" "TAB" "DEL" "ESC" "C-g" "é") 21)
"61 41 01 1b 61 1b 5b 41 1b 5b 31 3b 32 41 0d 09 7f 1b 07 c3 a9"
> (bytes-read '("<f5>" "C-<left>" "C-M-x") 13)
"1b 5b 31 35 7e 1b 5b 31 3b 35 44 1b 18"
; C-c C-c and its kin send the keys Tuna keeps, and C-q sends the next
; key whatever its bindings. C-q reads the key, which pauses the task it
; was pressed in, so it is pressed in a task of its own.
> (define (in-task key) (lambda () (spawn-task (lambda () (press! key))) (sleep-for 0.02)))
> (bytes-read (list "C-c" "C-c" "C-c" "C-z" "C-c" "C-\\" "C-c" "C-d" (in-task "C-q") "C-x" "C-c" (in-task "C-q") "C-c") 6)
"03 1a 1c 04 18 03"
; It reads with no prompt, as Emacs's terminals read the next event, so
; the echo area shows C-q- after a pause; a quit key is read too.
> (define seen #f)
> (bytes-read (list (in-task "C-q") (lambda () (set! seen (list (keys:reading client) (keys:reading-prompt client)))) "C-g") 1)
"07"
> seen
("C-q" #f)
; The encoder follows the modes the program sets: application cursor
; keys, and the Kitty keyboard protocol, in which S-RET is its own key.
> (bytes-read '("<up>") 3 "printf '\\033[?1h'; ")
"1b 4f 41"
> (bytes-read '("S-RET" "ESC") 12 "printf '\\033[>1u'; ")
"1b 5b 31 33 3b 32 75 1b 5b 32 37 75"
; Keys Tuna keeps in semi-char mode: C-x, C-h, C-u, M-x and M-: start
; Tuna's sequences, and Super keys are Tuna's in every mode.
> (define t (terminal:start '("sh" "-c" "sleep 30")))
> (in-client (lambda () (layout:switch-to-buffer t)))
> (map (lambda (k) (eq? (in-client (lambda () (keys:lookup client k))) terminal:send-key)) '("C-x" "C-h" "C-u" "M-x" "M-:" "s-a" "C-M-x" "C-t" "q"))
(#f #f #f #f #f #f #t #t #t)
; S-<prior> and S-<next> scroll the view.
> (list (eq? (in-client (lambda () (keys:lookup client "S-<prior>"))) views:scroll-down) (eq? (in-client (lambda () (keys:lookup client "S-<next>"))) views:scroll-up))
(#t #t)
; Char mode sends every key but Super keys and M-RET, which goes back to
; semi-char mode.
> (press! "C-c" "M-d")
> (list (in-client terminal:char-mode?) (in-client terminal:semi-char-mode?))
(#t #f)
> (map (lambda (k) (eq? (in-client (lambda () (keys:lookup client k))) terminal:send-key)) '("C-x" "C-c" "M-x" "s-a" "M-RET"))
(#t #t #t #f #f)
> (press! "M-RET")
> (in-client terminal:semi-char-mode?)
#t
; A command that leaves a region puts the terminal in copy mode, where
; keys are Tuna's; q leaves it, clearing the region.
> (press! "C-SPC")
> (list (in-client terminal:copy-mode?) (and (views:mark (view)) #t))
(#t #t)
> (eq? (in-client (lambda () (keys:lookup client "C-a"))) editing:move-beginning-of-line)
#t
> (press! "q")
> (list (in-client terminal:copy-mode?) (views:mark (view)))
(#f #f)
; A typed key leaves copy mode and goes to the program encoded, SPC as
; any other printing key.
> (bytes-read (list "C-c" "C-t" "a" "C-c" "C-t" "SPC") 10 "printf '\\033[>8u'; ")
"1b 5b 39 37 75 1b 5b 33 32 75"
> (press! "C-c" "C-t")
> (in-client terminal:copy-mode?)
#t
> (press! "C-c" "C-t")
> (in-client terminal:semi-char-mode?)
#t
; Outside a terminal the commands raise.
> (in-client (lambda () (layout:switch-to-buffer (buffers:make "notes" "hi\n"))))
> (press! "C-c" "C-t")
! C-c C-t is undefined
> (in-client (lambda () (commands:run terminal:copy-mode)))
! terminal:copy-mode: not a terminal with irritant #<buffer notes>
; Input that is no key, such as dictated text, runs editing:self-insert
; with its character; the terminal remaps it to send the character to
; the program as an input method's text, unencoded, also under the Kitty
; keyboard protocol, and leaves copy mode first.
> (define (insert-as-input char n) (lambda () (in-client (lambda () (keys:run-as-input client editing:self-insert n char)))))
> (bytes-read (list (insert-as-input #\a 1) (insert-as-input #\é 2) (insert-as-input #\A 1)) 6)
"61 c3 a9 c3 a9 41"
> (bytes-read (list (insert-as-input #\a 1)) 1 "printf '\\033[>31u'; ")
"61"
> (define t (shell!))
> (in-client (lambda () (layout:switch-to-buffer t)))
> (eq? (in-client (lambda () (keys:command-remapping client editing:self-insert))) terminal:self-insert)
#t
> (press! "C-c" "C-t")
> ((insert-as-input #\z 1))
> (list (in-client terminal:copy-mode?) (in-client terminal:semi-char-mode?))
(#f #t)
> (wait-for t "$ z")
> (screen-lines t)
("$ z")
> (in-client (lambda () (commands:run terminal:self-insert 1 #f)))
! terminal:self-insert: no character was typed
