(files:delete-file "not a string")
; files:visit of a folder asks files:folder-visitors by depth and takes
; the first buffer; with none answering it raises is a folder.
> (raised (lambda () (files:visit "~/e")))
(files:read-document "is a folder")
> (define listing (buffers:make "listing of e" ""))
> (define asked '())
> (define (decline folder) (set! asked (cons (base folder) asked)) #f)
> (define (answer-listing folder) (set! asked (cons 'answered asked)) listing)
> (hooks:add! files:folder-visitors answer-listing)
> (hooks:add! files:folder-visitors decline -10)
> (list (eq? listing (files:visit "~/e")) asked)
(#t (answered "e"))
; In a buffer whose files:offer-save? is #f, killing it asks nothing and
; C-x C-s leaves it alone; files:write-file still writes it.
> (define marks (buffers:make "*marks*" "x"))
> (buffers:replace! marks 1 1 "y")
#<edit 1>
> (buffers:with-buffer marks (options:set-local! files:offer-save? #f))
> (options:set! ask:file-name-reader (lambda (q) (error 'ask "asked" q)))
> (buffers:with-buffer marks (commands:run files:save-buffer))
> (list (files:path marks) (buffers:modified? marks))
(#f #t)
> (options:set! ask:y-or-n-reader (lambda (q) (error 'ask "asked" q)))
> (commands:define-command (kill [buffer (buffers:current)]) "Kills BUFFER." (buffers:kill! buffer))
> (commands:run kill marks)
#t
> (define written (buffers:make "*written*" "w"))
> (buffers:with-buffer written (options:set-local! files:offer-save? #f))
> (files:write-file "~/written.txt" written)
> (disk-checks:read-text "~/written.txt")
"w\n"
; (files attributes) reads a path without following a link, as plain
; data a job can send, through accessors that check it.
> (define a (read-file-attributes (disk-checks:expand "~/e/link")))
> (list (file-attributes? a) (file-attributes-type a) (file-attributes-target a) (file-attributes-links a)
        (eq? (file-attributes-type (read-file-attributes (disk-checks:expand "~/e"))) (file-type folder))
        (plain-data:plain-data? a))
(#t link "two.txt" 1 #t #t)
