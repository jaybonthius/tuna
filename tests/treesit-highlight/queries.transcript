; With no file of the user's, Python's highlights are nvim-treesitter's
; file, then the python plugin's own, which extends it.
> (map shown-path shipped)
("library/treesit/src/treesit/nvim-treesitter/runtime/queries/python/highlights.scm" "library/python/src/python/queries/python/highlights.scm")
> (define user (string-append home "/.config/tuna/queries"))
> (define (files) (map shown-path (query-files (cons user shipped-folders) "python" "highlights")))
; A user's file starting ; extends comes after both, so its patterns win.
> (write-file (string-append user "/python/highlights.scm") "; extends\n((identifier) @keyword.debug (#eq? @keyword.debug \"breakpoint\"))\n")
> (files)
("library/treesit/src/treesit/nvim-treesitter/runtime/queries/python/highlights.scm" "library/python/src/python/queries/python/highlights.scm" "~/.config/tuna/queries/python/highlights.scm")
> (faces "breakpoint()\nprint()\n" (query-files (cons user shipped-folders) "python" "highlights") default-excluded)
(("breakpoint" keyword.debug) ("print" function.builtin))
; Without ; extends it replaces nvim-treesitter's file; the python
; plugin's own still extends it.
> (write-file (string-append user "/python/highlights.scm") "((identifier) @keyword.debug (#eq? @keyword.debug \"breakpoint\"))\n")
> (files)
("~/.config/tuna/queries/python/highlights.scm" "library/python/src/python/queries/python/highlights.scm")
> (faces "breakpoint\n1\n" (query-files (cons user shipped-folders) "python" "highlights") default-excluded)
(("breakpoint" keyword.debug))
; Leading comment lines are read for ; inherits: and ; extends, as in
; Neovim; a language inherits the files of each it names, whole, from the
; same folders, before its own; one in parentheses only when the file is
; not itself inherited; naming itself is extending.
> (define (folder name) (string-append home "/" name))
> (write-file (folder "a/base/highlights.scm") "; inherits: core\n(base)\n")
> (write-file (folder "a/core/highlights.scm") "(core)\n")
> (write-file (folder "b/core/highlights.scm") ";; extends\n(core extended)\n")
> (write-file (folder "a/top/highlights.scm") ";; a comment\n;; inherits: base,(optional)\n(top)\n")
> (write-file (folder "b/top/highlights.scm") ";inherits:top\n(top extended)\n")
> (write-file (folder "a/optional/highlights.scm") ";; inherits: (base)\n(optional)\n")
> (define (resolved language) (map shown-path (query-files (list (folder "a") (folder "b")) language "highlights")))
> (resolved "core")
("~/a/core/highlights.scm" "~/b/core/highlights.scm")
> (resolved "base")
("~/a/core/highlights.scm" "~/b/core/highlights.scm" "~/a/base/highlights.scm")
> (resolved "optional")
("~/a/core/highlights.scm" "~/b/core/highlights.scm" "~/a/base/highlights.scm" "~/a/optional/highlights.scm")
> (resolved "top")
("~/a/core/highlights.scm" "~/b/core/highlights.scm" "~/a/base/highlights.scm" "~/a/optional/highlights.scm" "~/a/top/highlights.scm" "~/b/top/highlights.scm")
> (resolved "none")
()
; Extending files come in the reverse of the folders' order, so the
; first folder's comes last.
> (write-file (folder "a/ext/highlights.scm") "; extends\n(a)\n")
> (write-file (folder "b/ext/highlights.scm") "; extends\n(b)\n")
> (write-file (folder "c/ext/highlights.scm") "(c)\n")
> (map shown-path (query-files (list (folder "a") (folder "b") (folder "c")) "ext" "highlights"))
("~/c/ext/highlights.scm" "~/b/ext/highlights.scm" "~/a/ext/highlights.scm")
; With every file compiled there is nothing to tell.
> (let ([s (open "x = 1\n" shipped default-excluded)]) (settle! s) (session-data s))
#f
; A file that does not compile is left out and told; the others,
; shipped files included, still colour.
> (write-file (string-append user "/python/highlights.scm") "; extends\n((identifier) @keyword\n  (#eq? @keyword \"breakpoint\"))\n\n  (no_such_node) @error\n")
> (define s (open "breakpoint()\n'a'\n" (query-files (cons user shipped-folders) "python" "highlights") default-excluded))
> (settle! s)
((0 17))
> (reports s)
((query-error "~/.config/tuna/queries/python/highlights.scm" 5 3 "invalid node type"))
> (runs s)
(("breakpoint" function.builtin) ("'a'" string))
> (write-file (string-append user "/python/highlights.scm") "; extends\n(identifier) @keyword (#eq? @keyword)\n")
> (define s (open "breakpoint()\n'a'\n" (query-files (cons user shipped-folders) "python" "highlights") default-excluded))
> (settle! s)
((0 17))
> (reports s)
((query-error "~/.config/tuna/queries/python/highlights.scm" 2 23 "wrong arguments to #eq?"))
> (runs s)
(("breakpoint" function.builtin) ("'a'" string))
