; new view of its buffer: here *pi* lifted out of the user's windows.
> (layout:select! pi)
> (press! c1 '("'" "super") '("I") '("Enter"))
> (outline)
(layout:level (layout-split:container (layout-split:container (layout:level (layout-split:container "notes.org" "notes.org")) "*pi*" "*outline*") " *Echo Area*"))
> (layout:select! notes)
> (back!)
> (outline)
(layout:level (layout-split:container (layout-split:container (layout:level (layout-split:container (layout-split:container "notes.org" "notes.org") "*pi*")) "*pi*" "*outline*") " *Echo Area*"))
> (list (and (layout:view-node pi) #t) (length (filter (lambda (v) (eq? (views:buffer v) (named "*pi*"))) (layout:views))))
(#t 2)
; Nested levels keep their own histories: in L inside the chat tab, a
; split goes back without touching *side* or the tabs. M, around them,
; keeps its own, and going back there restores its whole interior as it
; was, L's included.
> (define w (views:make (named "work")))
> (define o (views:make (named "*side*")))
> (define p2 (views:make (named "*pi*")))
> (set-parts! (layout-split:container '((direction . column))
                (layout:level '()
                  (layout-tabs:container '()
                    (atom w '(title . "work"))
                    (layout-split:container '((direction . row) (title . "chat"))
                      (atom o)
                      (layout:level '() (atom p2)))))
                (atom (views:make (named " *Echo Area*")) '(depth . 90) '(size . content) '(locked . #t))))
> (layout:select! p2)
> (press! c1 '("x" "control") '("3"))
> (outline)
(layout:level (layout-split:container (layout:level (layout-tabs:container "work" (layout-split:container "*side*" (layout:level (layout-split:container "*pi*" "*pi*"))))) " *Echo Area*"))
> (layout:select! o)
> (press! c1 '("x" "control") '("2"))
> (outline)
(layout:level (layout-split:container (layout:level (layout-tabs:container "work" (layout-split:container (layout-split:container "*side*" "*side*") (layout:level (layout-split:container "*pi*" "*pi*"))))) " *Echo Area*"))
> (layout:select! p2)
> (back!)
> (outline)
(layout:level (layout-split:container (layout:level (layout-tabs:container "work" (layout-split:container (layout-split:container "*side*" "*side*") (layout:level "*pi*")))) " *Echo Area*"))
> (layout:select! o)
> (back!)
> (outline)
(layout:level (layout-split:container (layout:level (layout-tabs:container "work" (layout-split:container "*side*" (layout:level (layout-split:container "*pi*" "*pi*"))))) " *Echo Area*"))
