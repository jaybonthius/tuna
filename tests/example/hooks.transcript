; Each form's basic use.
> (hooks:define-hook after-save "Called with the path of each file saved.")
> (after-save "notes.txt")
> (define (make-backup path) path)
> (hooks:add! files:after-save make-backup)
> (import (text))
> (eq? (exists (lambda (entry) (entry "notes.txt")) (hooks:entries files:find-handlers))
       text:mode)
#t
; Entries run by depth, then in the order added; the configuration removed
; spell:check; an entry that raises is reported and the rest run.
> (define (b path) (display "[b]") #f)
> (define (a path) (display "[a]") #f)
> (define (boom path) (error 'entry "boom"))
> (hooks:add! files:after-save b 10)
> (hooks:add! files:after-save a -10)
> (hooks:add! files:after-save boom)
> (files:after-save "x")
[a]
! entry: boom
[b]
> (hooks:add! files:after-save b 10)
> (length (hooks:entries files:after-save))
4
; hooks:entries gives them in order, and an entry that raises raises to the
; caller; the procedures stay the same while the entries do.
> (exists (lambda (entry) (entry "x")) (hooks:entries files:after-save))
[a]
"x"
> ((caddr (hooks:entries files:after-save)) "x")
! entry: boom
> (equal? (hooks:entries files:after-save) (hooks:entries files:after-save))
#t
; Each entry runs on behalf of the module that added it.
> (define owners '())
> (hooks:add! files:after-save (lambda (path) (set! owners (cons (current-owner) owners))))
> (call-as-owner (module-owner '(spell)) (lambda () (hooks:add! files:after-save (lambda (path) (set! owners (cons (current-owner) owners))) 20)))
> (hooks:remove! files:after-save a)
> (hooks:remove! files:after-save b)
> (hooks:remove! files:after-save boom)
> (call-as-owner (module-owner '(prog)) (lambda () (files:after-save "y")))
> (map owner-name owners)
((spell) (repl))
; Local entries run only in their scope, by depth with the others.
> (define s1 (scopes:make))
> (define s2 (scopes:make))
> (scopes:current s1)
> (prog:mode)
> (files:save! "x")
saving x[indenting]
"x"
> (scopes:current s2)
> (files:save! "x")
saving x
"x"
> (scopes:current #f)
> (hooks:add-local! files:before-save a)
! hooks:add-local!: the current scope is #f
> (hooks:remove-local! files:before-save a)
! hooks:remove-local!: the current scope is #f
; Removing another module's local entry is the remover's change, and
; taking it back restores the entry.
> (scopes:current s1)
> (hooks:remove-local! files:before-save prog:indent-buffer)
> (files:save! "x")
saving x
"x"
> (call-as-owner (plugins:repl-owner) (lambda () (hooks:remove-local! files:before-save prog:indent-buffer)))
> (scopes:current #f)
; Adding a procedure that the same module already added does nothing.
> (define (c path) (display "[c]"))
> (hooks:add! files:before-save c)
> (hooks:add! files:before-save c 5)
> (files:before-save "x")
[c]
> (call-as-owner (module-owner '(spell)) (lambda () (hooks:add! files:before-save c)))
> (files:before-save "x")
[c][c]
; hooks:remove! removes the entry whichever module added it.
> (hooks:remove! files:before-save c)
> (files:before-save "x")
; Hooks check their arguments.
> (hooks:add! c c)
! hooks:add!: not a hook with irritant #<procedure c>
> (hooks:add! files:before-save 'c)
! hooks:add!: not a procedure with irritant c
> (hooks:add! files:before-save c 'deep)
! hooks:add!: not a real number with irritant deep
> (hooks:define-hook)
! invalid syntax (hooks:define-hook)
> (list (hooks:hook? files:after-save) (hooks:hook? files:save!) (hooks:hook? 1))
(#t #f #f)
; Evaluating hooks:define-hook again keeps the entries.
> (hooks:add! after-save c)
> (hooks:define-hook after-save "Called after saving.")
> (after-save "z")
[c]
; Either the configuration or the REPL evaluating the other's hooks:define-hook
; keeps the entries.
> (import (plugins))
> (call-as-owner (plugins:configuration-owner) (lambda () (plugins:eval-form '(hooks:define-hook shared))))
> (hooks:add! shared c)
> (hooks:define-hook shared)
> (shared "x")
[c]
> (call-as-owner (plugins:configuration-owner) (lambda () (plugins:eval-form '(hooks:define-hook shared))))
> (shared "x")
[c]
; An entry that raises is reported on the thread that ran the hook.
> (define main-thread-id (get-thread-id))
> (define reported-on-main '())
> (define (note-thread report c)
    (set! reported-on-main (cons (= (get-thread-id) main-thread-id) reported-on-main))
    (report c))
> (advice-add! report note-thread)
> (hooks:define-hook raising)
> (hooks:add! raising (lambda () (error 'entry "boom")))
> (raising)
! entry: boom
> (begin (join-task (fork-task (lambda (restore) (raising)))) (void))
! entry: boom
> reported-on-main
(#f #t)
> (advice-remove! report note-thread)
; A module whose body raises on its first load is unloaded, and the hook
; entry it added goes with its other changes.
> (call-with-output-file "~/.config/tuna/lib/bad.sls"
    (lambda (p)
      (put-string p "#!tuna\n(import (files) (hooks))\n(define x (begin (hooks:add! files:after-save (lambda (path) (display \"bad entry\"))) (car '())))\n")))
> (import (bad))
! (bad) car: () is not a pair
> (list (module-owner '(bad)) (files:after-save "p"))
(#f #<void>)
