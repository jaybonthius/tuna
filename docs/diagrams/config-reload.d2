# What happens when you reload your configuration?
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: down

classes: {
  step: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 18
    }
  }
  safe: {
    style: {
      fill: "#e8f5e9"
      stroke: "#2e7d32"
      font-color: "#1b3d1f"
      border-radius: 8
      font-size: 18
    }
  }
}

legend: |md
  **Status:** built 2026-10-13 (configuration stage 2). Green boxes are where a mistake stops, leaving what is running untouched.
|

edit: "1. You edit init.ss\nand run reload (a command, or tuna reload in a terminal)" {class: step}
check: "2. Trial run, changing nothing:\nrun init.ss, check every option" {class: step}
stop: "Mistake found: nothing changes;\nyou see the error and the line" {class: safe}
compare: "3. Compare with what is running now" {class: step}
apply: "4. For each changed plugin or block:\nturn the old one off, the new one on" {class: step}
keep: "New one fails: it is undone and\nthe old one is turned back on" {class: safe}
report: "5. Report what changed and what did not" {class: step}

edit -> check
check -> stop: "error"
check -> compare: "all good"
compare -> apply
apply -> keep: "failure"
apply -> report
keep -> report
