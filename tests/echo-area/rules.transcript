> (set-option! echo-area:log-max 3)
> (echo-area:message! "Next")
> (messages)
> (echo-area:message! "Next")
> (messages)
> (set-option! echo-area:log-max 16384)
; *Messages* refuses the user's edits; a killed *Messages* is made again
; by the next message; the echo area cannot be killed.
> (define log (buffers:find "*Messages*"))
> (raised (lambda () (buffers:replace! log 1 1 "x")))
> (buffers:kill! echo-buffer)
