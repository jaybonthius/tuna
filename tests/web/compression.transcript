> (http:wait-for-server)
Tuna is at http://127.0.0.1:PORT/
; The stream is compressed with the first of zstd, brotli and gzip that
; the browser accepts.
> (define (encoding accept)
    (http:header (http:get (string-append "/screen?datastar=" (http:encode "{\"client\":\"nobody\"}")) accept)
                 "content-encoding"))
> (list (encoding '(("accept-encoding" . "gzip, deflate, br, zstd"))) (encoding '(("accept-encoding" . "gzip, deflate, br")))
        (encoding '(("accept-encoding" . "gzip, deflate"))) (encoding '()))
("zstd" "br" "gzip" #f)
; A browser that accepts only brotli gets it, and a screen that differs a
; little from the one before costs a few dozen bytes, since brotli finds
; the rest in the screens it has sent.
> (define p (http:page))
> (define s (http:open-raw! p '(("accept-encoding" . "br"))))
> (http:raw-encoding s)
"br"
> (define c (car (web:clients)))
> (define (typed-screen n)
    (haml (:pre (map (lambda (i)
                       (format "~a (define (name-~a x) (+ x ~a))~a\n"
                               i (mod (* i 7919) 997) (mod (* i 104729) 89) (if (= i 200) (make-string n #\x) "")))
                     (iota 400)))))
> (web:send-screen! c (typed-screen 0) "Tuna")
> (define first-bytes (http:raw-next s))
> (> first-bytes 2000)
#t
> (define (typed! n)
    (http:confirm! p n)
    (web:send-screen! c (typed-screen n) "Tuna")
    (http:raw-next s))
> (let* ([a (typed! 1)] [b (typed! 2)] [d (typed! 3)] [e (typed! 4)])
    (for-all (lambda (bytes) (< 0 bytes 200)) (list a b d e)))
#t
> (http:close-raw! s)
