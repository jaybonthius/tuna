; The cap.
> (kill-ring:max)
120
> (do ([i 0 (+ i 1)]) ((= i 130)) (kill-ring:push! (list (number->string i))))
> (let ([e (kill-ring:entries)]) (list (length e) (car e) (list-ref e 119)))
(120 ("129") ("10"))
