; Running commands: the hooks around outermost runs, this-command and
; last-command, raises and quits, and the prefix argument.
> (define events '())
> (define (event! . e) (set! events (cons e events)))
> (define (take-events!) (let ([e (reverse events)]) (set! events '()) e))
> (define (name-of c) (and c (commands:command-name c)))
> (add-hook! commands:before-command (lambda (c) (event! 'before (name-of c) (name-of (commands:this-command)) (name-of (commands:last-command)))))
> (add-hook! commands:after-command (lambda (c) (event! 'after (name-of c) (name-of (commands:this-command)) (name-of (commands:last-command)))))
> (commands:define-command (inner [x (begin (event! 'reading-inner) 1)])
    "Notes what it sees."
    (event! 'inner (name-of (commands:this-command)) (name-of (commands:last-command)))
    x)
> (commands:define-command (outer [x (begin (event! 'reading-outer (name-of (commands:this-command))) 2)])
    "Runs inner, then notes what it sees."
    (let ([v (commands:run inner)])
      (event! 'outer (name-of (commands:this-command)) (name-of (commands:last-command)))
      (+ x v)))
; before-command comes before the interactive expressions; in both hooks
; the run's command is running and the last command is the one before
; it. A run inside another calls neither hook, sees the same last
; command, and ends last, so it becomes the last command.
> (commands:run outer)
3
> (take-events!)
((before outer outer #f) (reading-outer outer) (reading-inner) (inner inner #f) (outer outer #f) (after inner inner #f))
> (list (commands:this-command) (name-of (commands:last-command)))
(#f inner)
> (commands:run outer 10)
11
> (take-events!)
((before outer outer inner) (reading-inner) (inner inner inner) (outer outer inner) (after inner inner inner))
> (commands:run inner 5)
5
> (take-events!)
((before inner inner inner) (inner inner inner) (after inner inner inner))
; The run inside that ended last is the last command, as M-x makes the
; command it runs the last one.
> (commands:define-command (execute [name 'inner])
    "Runs the command named NAME."
    (commands:run (commands:command-named name)))
> (commands:define-command (twice)
    "Runs inner, then outer."
    (commands:run inner 1)
    (commands:run outer 1))
> (commands:run execute 'outer)
3
> (take-events!)
((before execute execute inner) (reading-outer outer) (reading-inner) (inner inner inner) (outer outer inner) (after outer outer inner))
> (commands:run twice)
2
> (take-events!)
((before twice twice outer) (inner inner outer) (reading-inner) (inner inner outer) (outer outer outer) (after outer outer outer))
; A raise in an outermost run, in its body or its interactive
; expressions, goes to report; after-command runs, and run returns no
; values.
> (commands:define-command (broken) "Raises." (event! 'broken) (car '()))
> (commands:define-command (broken-reading [x (car '())]) "Raises reading X." x)
> (call-with-values (lambda () (commands:run broken)) list)
! car: () is not a pair
()
> (take-events!)
((before broken broken outer) (broken) (after broken broken outer))
> (call-with-values (lambda () (commands:run broken-reading)) list)
! car: () is not a pair
()
> (take-events!)
((before broken-reading broken-reading broken) (after broken-reading broken-reading broken))
> (commands:run (commands:command-named 'broken))
! car: () is not a pair
> (take-events!)
((before broken broken broken-reading) (broken) (after broken broken broken-reading))
> (commands:define-command (odd) "Raises a symbol." (raise 'oops))
> (commands:run odd)
! non-condition value oops
> (take-events!)
((before odd odd broken) (after odd odd broken))
; A raise in an inner run reaches the outer command, and the inner run
; ended when it left.
> (commands:define-command (catching)
    "Catches what broken raises."
    (guard (c [(assertion-violation? c) (condition-message c)])
      (commands:run broken)))
> (commands:run catching)
"~s is not a pair"
> (take-events!)
((before catching catching odd) (broken) (after broken broken odd))
> (commands:run execute 'broken)
! car: () is not a pair
> (take-events!)
((before execute execute broken) (broken) (after broken broken broken))
; A quit is reported too, and after-command runs.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (commands:define-command (spin) "Runs until quit." (let loop () (loop)))
> (begin
    (fork-thread
      (lambda ()
        (chez:sleep (make-time 'time-duration 100000000 0))
        (request-quit!)))
    (commands:run spin))
! &quit
> (take-events!)
((before spin spin broken) (after spin spin broken))
; A warning is reported and the command goes on.
> (commands:define-command (careful) "Warns, then returns." (warning 'careful "watch out") 'done)
> (commands:run careful)
! careful: watch out
done
> (take-events!)
((before careful careful spin) (after careful careful spin))
; The hooks are part of their run: a command a hook entry runs is an
; inner run, so it calls no hooks and does not become the last command.
> (commands:define-command (noted) "Notes what it sees."
    (event! 'noted (name-of (commands:this-command)) (name-of (commands:last-command))))
> (define (run-noted c) (commands:run noted))
> (add-hook! commands:before-command run-noted)
> (add-hook! commands:after-command run-noted)
> (commands:run inner 4)
4
> (remove-hook! commands:before-command run-noted)
> (remove-hook! commands:after-command run-noted)
> (list (take-events!) (name-of (commands:last-command)))
(((before inner inner careful) (noted noted careful) (inner inner careful) (after inner inner careful) (noted noted careful)) inner)
; A raise from report itself is reported once more; a report that
; always raises is not repeated. Either way the run returns no values and
; calls after-command once.
> (define (failing-report report c) (if (eq? c 'oops) (raise 'report-failed) (report c)))
> (advice-add! report failing-report)
> (call-with-values (lambda () (commands:run odd)) list)
! non-condition value report-failed
()
> (advice-remove! report failing-report)
> (define (broken-report report c) (raise 'report-failed))
> (advice-add! report broken-report)
> (define escaped (guard (c [#t (list 'escaped c)]) (call-with-values (lambda () (commands:run odd)) list)))
> (advice-remove! report broken-report)
> (list escaped (take-events!))
(() ((before odd odd inner) (after odd odd inner) (before odd odd odd) (after odd odd odd)))
; A command's values are run's values.
> (commands:define-command (two) "Returns two values." (values 1 2))
> (call-with-values (lambda () (commands:run two)) list)
(1 2)
; The command and its interactive expressions run as the user, (repl).
> (commands:define-command (owner [o (current-owner)]) "Returns the owners it sees." (list o (current-owner)))
> (as-module '(console) (commands:run owner))
((repl) (repl))
; run checks its command.
> (commands:run 'inner)
! commands:run: not a command with irritant inner
> (commands:run (lambda () 1))
! commands:run: not a command with irritant #<procedure>
> (take-events!)
((before two two odd) (after two two odd) (before owner owner two) (after owner owner two))
; The prefix argument is a thread parameter; prefix-number reads it as a
; number.
> (commands:prefix-argument)
#f
> (map (lambda (p) (parameterize ([commands:prefix-argument p]) (commands:prefix-number)))
       '(#f 7 -3 (4) (16) -))
(1 7 -3 4 16 -1)
> (parameterize ([commands:prefix-argument "4"]) 'never)
! commands:prefix-argument: not a prefix argument with irritant "4"
> (parameterize ([commands:prefix-argument '(4 4)]) 'never)
! commands:prefix-argument: not a prefix argument with irritant (4 4)
> (parameterize ([commands:prefix-argument 1.5]) 'never)
! commands:prefix-argument: not a prefix argument with irritant 1.5
> (commands:define-command (prefixed [n (commands:prefix-number)]) "Returns N and the raw prefix." (list n (commands:prefix-argument)))
> (parameterize ([commands:prefix-argument '(4)]) (commands:run prefixed))
(4 (4))
> (parameterize ([commands:prefix-argument '-]) (commands:run execute 'prefixed))
(-1 -)
; A run that keeps the last command leaves it as it was, as a prefix
; command does; the hooks still see the command that ended.
> (commands:define-command (prefix) "Keeps the last command." (commands:keep-last-command!))
> (commands:define-command (run-prefix) "Runs prefix." (commands:run prefix))
> (take-events!)
((before prefixed prefixed owner) (after prefixed prefixed owner) (before execute execute prefixed) (after prefixed prefixed prefixed))
> (commands:run inner 1)
1
> (take-events!)
((before inner inner prefixed) (inner inner prefixed) (after inner inner prefixed))
> (commands:run prefix)
> (commands:run run-prefix)
> (list (take-events!) (name-of (commands:last-command)))
(((before prefix prefix inner) (after prefix prefix inner) (before run-prefix run-prefix inner) (after prefix prefix inner)) inner)
> (commands:run inner 1)
1
> (take-events!)
((before inner inner inner) (inner inner inner) (after inner inner inner))
; A raise after the keep still keeps it.
> (commands:define-command (prefix-broken) "Keeps the last command, then raises." (commands:keep-last-command!) (car '()))
> (commands:run outer 1)
2
> (commands:run prefix-broken)
! car: () is not a pair
> (name-of (commands:last-command))
inner
> (take-events!)
((before outer outer inner) (reading-inner) (inner inner inner) (outer outer inner) (after inner inner inner) (before prefix-broken prefix-broken inner) (after prefix-broken prefix-broken inner))
; Outside a command there is no run to keep.
> (commands:keep-last-command!)
! commands:keep-last-command!: no command is running
> (let ([result #f])
    (fork-thread (lambda () (set! result (guard (c [#t (condition-message c)]) (commands:keep-last-command!)))))
    (wait-until (lambda () result))
    result)
"not on the main thread"
