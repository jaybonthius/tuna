; A file buffer's history is kept in a log, written after each batch.
> (import (tuna eval))
> (define library (getenv "TUNA_LIBRARY"))
> (define (reload! name) (eval-file (string-append library "/" name ".sls")))
> (define (kinds path) (map car (checks:log-records path)))
; The log is written by a thread of its own, so a check waits for the
; records it expects.
> (define (logged path n)
    (wait-until (lambda () (= (length (checks:log-records path)) n)))
    (kinds path))
> (checks:write-text! "~/a.txt" "alpha\n")
> (define a (files:visit "~/a.txt"))
> (define (in-a command . args) (buffers:with-buffer a (apply commands:run command args)))
> (list (tree a) (buffers:modified? a) (checks:exists? (checks:log-of "~/a.txt")))
((0 0 (0 #f)) #f #f)
> (in-a checks:insert 1 "1 ")
#<edit 1>
> (in-a checks:insert 1 "2 ")
#<edit 2>
> (logged "~/a.txt" 5)
(undo-history group saved at group)
> (map (lambda (r) (if (eq? (car r) 'group) (list-tail r 5) r)) (list-tail (checks:log-records "~/a.txt") 1))
((#(1 () ("1 "))) (saved 0 6 3816658035) (at 1) (#(1 () ("2 "))))
> (checks:file-mode (checks:log-of "~/a.txt"))
"600"
; Undo that reaches the saved state leaves the buffer unmodified.
> (in-a undo:undo 1)
> (buffers:modified? a)
#t
> (in-a undo:undo 1)
> (list (text a) (buffers:modified? a))
("alpha\n" #f)
> (in-a undo:redo 1)
> (list (text a) (buffers:modified? a))
("1 alpha\n" #t)
> (logged "~/a.txt" 8)
(undo-history group saved at group at at at)
; Saving marks the saved state.
> (files:save-buffer a)
> (list (tree a) (buffers:modified? a) (checks:read-text "~/a.txt"))
((1 1 (0 #f) (1 0) (2 1)) #f "1 alpha\n")
> (in-a undo:undo 1)
> (buffers:modified? a)
#t
> (in-a undo:redo 1)
> (buffers:modified? a)
#f
> (in-a checks:insert 1 "3 ")
#<edit 8>
; Reloading buffers closes every buffer, so files visits each file again;
; undo applies the unsaved edits before the buffer is made.
> (reload! "buffers")
> (wait-until (lambda () (= (length (files:buffers)) 1)))
> (define a (files:visit "~/a.txt"))
> (list (text a) (buffers:modified? a) (tree a))
("3 1 alpha\n" #t (3 1 (0 #f) (1 0) (2 1) (3 1)))
> (in-a undo:undo 1)
> (list (text a) (buffers:modified? a))
("1 alpha\n" #f)
> (in-a undo:undo 1)
> (list (text a) (buffers:modified? a))
("alpha\n" #t)
> (in-a undo:redo 2)
> (list (text a) (buffers:modified? a))
("3 1 alpha\n" #t)
; Killing a file buffer moves its log to the saved state: the next visit
; opens at the file's text, with the discarded edits a redo away.
> (buffers:kill! a)
#t
> (define a (files:visit "~/a.txt"))
> (list (text a) (buffers:modified? a) (car (tree a)))
("1 alpha\n" #f 1)
> (in-a undo:redo 1)
> (list (text a) (buffers:modified? a))
("3 1 alpha\n" #t)
; When the file changed outside Tuna a new history starts, and a log that
; held unsaved edits is kept beside it.
> (reload! "buffers")
> (wait-until (lambda () (= (length (files:buffers)) 1)))
> (checks:write-text! "~/a.txt" "changed\n")
> (reload! "buffers")
> (wait-until (lambda () (= (length (files:buffers)) 1)))
! (files) undo-log: the file changed outside Tuna, so the log of its unsaved edits is set aside as with irritant "~/undo-logs~/a.txt.ss.stale"
> (define a (files:visit "~/a.txt"))
> (list (text a) (buffers:modified? a) (tree a))
("changed\n" #f (0 0 (0 #f)))
> (checks:exists? (string-append (checks:log-of "~/a.txt") ".stale"))
#t
> (in-a checks:insert 1 "new ")
#<edit 1>
> (logged "~/a.txt" 4)
(undo-history group saved at)
; A file changed outside whose log held no unsaved edits starts again
; quietly.
> (files:save-buffer a)
> (checks:write-text! "~/a.txt" "again\n")
> (buffers:kill! a)
#t
> (define a (files:visit "~/a.txt"))
> (list (text a) (tree a))
("again\n" (0 0 (0 #f)))
; Reloading undo, and so this plugin, attaches every open file buffer: a
; modified one at its log's current state.
> (in-a checks:insert 1 "x ")
#<edit 1>
> (in-a checks:insert 1 "y ")
#<edit 2>
> (reload! "undo")
> (wait-until (lambda () (guard (c [#t #f]) (= (length (tree a)) 5))))
> (list (text a) (buffers:modified? a) (tree a))
("y x again\n" #t (2 0 (0 #f) (1 0) (2 1)))
> (in-a undo:undo 2)
> (list (text a) (buffers:modified? a))
("again\n" #f)
> (in-a undo:redo 1)
; An unmodified one that its log holds unsaved edits for gets them back.
> (unload-module! '(undo))
> (files:revert-buffer a)
> (list (text a) (buffers:modified? a))
("again\n" #f)
; Unloading undo unloads this plugin and the test module, which import
; it, taking back their settings, so the same form loads them again.
> (begin (load-module! '(undo)) (load-module! '(undo-log)) (load-module! '(checks)))
> (wait-until (lambda () (buffers:modified? a)))
> (list (text a) (buffers:modified? a) (tree a))
("x again\n" #t (1 0 (0 #f) (1 0) (2 1)))
; Reverting is one group.
> (checks:write-text! "~/a.txt" "reverted\n")
> (files:revert-buffer a)
> (list (text a) (buffers:modified? a) (tree a))
("reverted\n" #f (3 3 (0 #f) (1 0) (2 1) (3 1)))
> (in-a undo:undo 1)
> (list (text a) (buffers:modified? a))
("x again\n" #t)
> (in-a undo:redo 1)
; Writing to another file starts a log there, with the whole history.
> (files:write-file "~/b.txt" a)
> (list (files:path a) (tree a))
("~/b.txt" (3 3 (0 #f) (1 0) (2 1) (3 1)))
> (logged "~/b.txt" 7)
(undo-history group group group saved saved at)
> (in-a undo:undo 1)
> (buffers:modified? a)
#t
; A buffer with a limit of 0 keeps no log; nor does a file that
; undo-log:keep-log? refuses.
> (buffers:with-buffer a (set-option-local! undo:limit 0))
> (in-a checks:insert 1 "z ")
#<edit 12>
> (wait-until (lambda () (not (checks:exists? (checks:log-of "~/b.txt")))))
> (checks:exists? (checks:log-of "~/b.txt"))
#f
> (set-option! undo-log:keep-log? (lambda (path) (not (string=? (path-extension path) "gpg"))))
> (checks:write-text! "~/secret.gpg" "s\n")
> (define g (files:visit "~/secret.gpg"))
> (buffers:with-buffer g (commands:run checks:insert 1 "t"))
#<edit 1>
> (sleep-for 0.1)
> (list (tree g) (checks:exists? (checks:log-of "~/secret.gpg")))
((1 0 (0 #f) (1 0)) #f)
> (set-option! undo-log:keep-log? (lambda (path) #t))
; A log that cannot be read is left as it is, and the buffer keeps no log
; until a visit can read it.
> (checks:write-text! "~/c.txt" "gamma\n")
> (define c (files:visit "~/c.txt"))
> (buffers:with-buffer c (commands:run checks:insert 1 "1 "))
#<edit 1>
> (logged "~/c.txt" 4)
(undo-history group saved at)
> (define unsaved (checks:log-records "~/c.txt"))
> (chmod (checks:log-of "~/c.txt") 0)
> (define open (length (files:buffers)))
> (begin
    (reload! "buffers")
    (wait-until (lambda () (= (length (files:buffers)) open))))
! (undo-log) open-file-input-port: failed for ~/undo-logs~/c.txt.ss: permission denied
> (define c (files:visit "~/c.txt"))
> (list (text c) (tree c))
("gamma\n" (0 0 (0 #f)))
> (buffers:with-buffer c (commands:run checks:insert 1 "x "))
#<edit 1>
; Neither a save nor this plugin's reload starts a log in its place.
> (files:save-buffer c)
> (buffers:with-buffer c (commands:run checks:insert 1 "y "))
#<edit 2>
> (reload! "undo-log")
> (sleep-for 0.2)
! (undo-log) open-file-input-port: failed for ~/undo-logs~/c.txt.ss: permission denied
> (buffers:with-buffer c (commands:run checks:insert 1 "z "))
#<edit 3>
> (sleep-for 0.2)
> (checks:write-text! "~/c.txt" "gamma\n")
> (chmod (checks:log-of "~/c.txt") #o600)
> (equal? (checks:log-records "~/c.txt") unsaved)
#t
> (begin
    (reload! "buffers")
    (wait-until (lambda () (= (length (files:buffers)) open))))
> (define c (files:visit "~/c.txt"))
> (list (text c) (buffers:modified? c))
("1 gamma\n" #t)
; Setting the limit to 0 in the batch that made an edit deletes the log
; after that edit's record is written.
> (buffers:with-buffer c (commands:run checks:insert 1 "2 "))
#<edit 1>
> (logged "~/c.txt" 5)
(undo-history group saved at group)
> (begin (buffers:replace! c 1 1 "3 ") (buffers:with-buffer c (set-option-local! undo:limit 0)))
> (sleep-for 0.2)
> (checks:exists? (checks:log-of "~/c.txt"))
