; A stop cannot skip the out of a critical wind, and a guard does not
; catch it. A value emitted after the stop ends the job at once.
> (import (progress))
> (jobs:define-worker (cleans x emit)
    (import (progress))
    (dynamic-wind #t
      void
      (lambda () (guard (c [#t (count!)]) (emit 'running) (let loop () (loop))))
      (lambda () (count!) (emit 'cleaned) (count!))))
> (define cleaning (jobs:start cleans 0 note! (lambda (ended) (note! (list 'ended ended)))))
> (sleep-for 0.05)
> (jobs:stop! cleaning)
> (wait-until (lambda () (= (length log) 2)))
> (list (taken!) (counted))
((running (ended stopped)) 1)
; Values are checked where they cross: in jobs:start, jobs:send! and
; emit. Arguments are checked.
