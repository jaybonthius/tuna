> (define (tabs-children)
    (let* ([doc (buffers:document layout:buffer)] [tabs (document:token doc 1)] [acc '()])
      (document:for-each-child tabs (+ (document:node-start tabs) 1) (- (document:node-end tabs) 1)
        (lambda (c at) (when (document:node? c) (set! acc (cons c acc)))))
      (reverse acc)))
; C-x t 2 wraps a view in no tabs in a tabs container, as its first tab,
; and selects a new view of its buffer at its point in a tab after it.
> (press! c1 '("x" "control") '("t") '("2"))
> (tree)
(layout:level () (layout-tabs:container () #(views:view ((view . 1) (buffer . "*Help*"))) #(views:view ((view . 3) (buffer . "notes")))))
