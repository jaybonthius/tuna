; A rename by any caller moves each listing of the renamed folder, or of
; a folder under it, to the new path, with its marks and points.
> (touch! "proj/src/main.c" "int main;\n")
> (touch! "proj/notes.txt" "notes\n")
> (define top (dired:visit (at "proj")))
> (define src (dired:visit (at "proj/src")))
> (layout:switch-to-buffer src)
> (goto "main.c")
> (press! "m")
> (define renamed '())
> (hooks:add! files:after-rename (lambda (from to) (set! renamed (cons (list from to) renamed))))
> (files:rename-file (at "proj") (at "work"))
> (list renamed (buffers:name top) (dired:folder top) (buffers:name src) (dired:folder src))
((("$HOME/proj" "$HOME/work")) "~/work/" "$HOME/work/" "~/work/src/" "$HOME/work/src/")
> (list (listing-lines src) (point-name) (map dired:entry-path (entries src)))
(("  ." "  .." "* main.c") "main.c" ("$HOME/work/src/." "$HOME/work/src/.." "$HOME/work/src/main.c"))
> (press! "g")
> (settle)
> (listing-lines src)
("  ." "  .." "* main.c")
; A listing already naming the new path is killed; the moved listing
; stays, is read again and shows in the killed listing's views.
> (folder! "fresh")
> (define fresh (dired:visit (at "fresh")))
> (layout:switch-to-buffer fresh)
> (files:rename-file (at "work/src") (at "fresh") (file-options no-fail))
> (settle)
> (list (buffers:live? fresh) (buffers:name src) (buffers:name (views:buffer (view))) (listing-lines src))
(#f "~/fresh/" "~/fresh/" ("  ." "  .." "* main.c"))
; R on a folder renames it, and its listing follows.
> (layout:switch-to-buffer top)
> (folder! "work/docs")
> (define docs (dired:visit (at "work/docs")))
> (press! "g")
> (settle)
> (goto "docs")
> (options:set! ask:file-name-reader (answer "~/work/papers"))
> (press! "R")
> (settle)
> (list (questions) (buffers:name docs) (listing-lines top))
(("Rename docs to: ") "~/work/papers/" ("  ." "  .." "  notes.txt" "  papers"))
