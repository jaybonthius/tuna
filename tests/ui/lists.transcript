> (with-output-to-file (string-append (getenv "HOME") "/.config/tuna/lib/maker2.sls")
    (lambda ()
      (display "#!tuna\n")
      (write '(import (ui) (buffers) (document) (commands)))
      (write '(define made (buffers:make "*made2*" (ui:list '()))))
      (write '(define names (vector "p" "q")))
      (write '(define (shout i) (ui:label (string-append (vector-ref names i) "!"))))
      (write '(commands:define-command (fill-made) "Fills the list."
                (ui:set-rows! made (document:token (buffers:document made) 0) 2 shout shout)))))
