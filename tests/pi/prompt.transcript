; Undo in the prompt keeps its history while Pi writes above it.
> (define (shows? text)
    (let ([s (shown chat)] [n (string-length text)])
      (let loop ([i 0])
        (and (<= (+ i n) (string-length s))
             (or (string=? (substring s i (+ i n)) text) (loop (+ i 1)))))))
> (type! " now")
