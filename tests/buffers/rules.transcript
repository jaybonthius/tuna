; At idle each log keeps its last thousand edits; anchors moved first
; still follow.
> (define t (fresh "abc\n"))
> (define early (buffers:anchor t 3))
> (do ([i 0 (+ i 1)]) ((= i 1500)) (buffers:replace! t 1 1 "x"))
> (length (buffers:edits-since t 0))
1500
> (set-idle! #t)
> (sleep-for 1.5)
> (set-idle! #f)
> (list (buffers:edits-since t 0) (buffers:edits-since t 499) (length (buffers:edits-since t 500)))
(#f #f 1000)
> (list (buffers:map-position t 3 0) (buffers:map-position t 3 500) (buffers:anchor-position early))
(#f 1003 1503)
> (buffers:set-spans! (buffers:layer t hl) 0 3 '((1 2 a)) 10)
#f
; Reconciling keeps children whose key matches, so anchors inside them
; stay, and replaces only what lies between.
> (define s (fresh '(md:doc () (md:para ((key . a)) "alpha\n") (md:para ((key . b)) "beta\n"))))
> (define in-b (buffers:anchor s 10))
> (define (reconcile! children) (buffers:reconcile! s (document:token (buffers:document s) 0) children))
> (reconcile! '((md:heading ((key . top)) "Top\n") (md:para ((key . a)) "alpha!\n") (md:para ((key . b)) "beta\n")))
> (root s)
(md:doc () (md:heading ((key . top)) "Top\n") (md:para ((key . a)) "alpha!\n") (md:para ((key . b)) "beta\n"))
> (map (lambda (e) (list (buffers:edit-start e) (document:datums (buffers:piece-document (buffers:edit-removed e))) (document:datums (buffers:piece-document (buffers:edit-inserted e)))))
       (buffers:edits-since s 0))
((1 () ((md:heading ((key . top)) "Top\n"))) (13 () ("!")))
> (document:text (buffers:document s) (buffers:anchor-position in-b) (+ (buffers:anchor-position in-b) 2))
"be"
; Of what differs, only the part between the content old and new share at
; their start and end is replaced, so a node that grows inside gets an
; insertion, and an anchor before it stays.
> (define g (fresh '(md:doc () (md:para ((key . a)) "Some " (md:link () "bo") "\n"))))
> (define in-link (buffers:anchor g 9))
> (define version-g (buffers:version g))
> (buffers:reconcile! g (document:token (buffers:document g) 0) '((md:para ((key . a)) "Some " (md:link () "bold") " text\n")))
> (map (lambda (e) (list (buffers:edit-start e) (document:datums (buffers:piece-document (buffers:edit-removed e))) (document:datums (buffers:piece-document (buffers:edit-inserted e)))))
       (buffers:edits-since g version-g))
((10 ((md:link ())) ((md:link () "ld") " text")))
> (list (root g) (buffers:anchor-position in-link))
((md:doc () (md:para ((key . a)) "Some " (md:link () "bold") " text\n")) 9)
> (buffers:reconcile! g (document:token (buffers:document g) 0) '((md:para ((key . a)) "Some text\n")))
> (root g)
(md:doc () (md:para ((key . a)) "Some text\n"))
> (reconcile! '((md:para ((key . b)) "beta\n") (md:para ((key . a) (x . 1)) "alpha!\n")))
> (list (root s) (buffers:version s))
((md:doc () (md:para ((key . b)) "beta\n") (md:para ((key . a) (x . 1)) "alpha!\n")) 4)
> (reconcile! '((md:para ((key . b)) "beta\n") (md:para ((key . a) (x . 1)) "alpha!\n")))
