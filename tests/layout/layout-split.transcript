> (define c1 (web:add-client! 1))
> (define notes (buffers:make "notes" "one\ntwo\n"))
> (layout:switch-to-buffer notes)
> (views:set-point! (layout:selected-view) 5)
; C-x 2 and C-x 3 split the selected view with a view of its buffer at its
; point; the selected view stays selected.
> (press! c1 '("x" "control") '("2"))
> (tree)
(layout:root () (layout-split:container ((direction . column)) #(views:view ((view . 1) (buffer . "*Help*"))) #(views:view ((view . 2) (buffer . "notes")))))
> (selected)
1
> (views:point (views:find 2))
5
> (press! c1 '("x" "control") '("3"))
> (tree)
(layout:root () (layout-split:container ((direction . column)) (layout-split:container ((direction . row)) #(views:view ((view . 1) (buffer . "*Help*"))) #(views:view ((view . 3) (buffer . "notes")))) #(views:view ((view . 2) (buffer . "notes")))))
; A view whose parent is a split of the direction joins it, halving the
; view's weight between the two.
> (layout-split:split-view! (views:find 1) (layout-split:direction row))
#<view 4>
> (tree)
(layout:root () (layout-split:container ((direction . column)) (layout-split:container ((direction . row)) #(views:view ((view . 1) (buffer . "*Help*") (weight . 1/2))) #(views:view ((view . 4) (buffer . "notes") (weight . 1/2))) #(views:view ((view . 3) (buffer . "notes")))) #(views:view ((view . 2) (buffer . "notes")))))
> (raised (lambda () (layout-split:split-view! (views:find 1) 'diagonal)))
(layout-split:split-view! "not a split direction")
> (raised (lambda () (layout-split:split-view! 'view (layout-split:direction row))))
(layout-split:split-view! "not a view")
> (enum-set->list (layout-split:directions column row))
(row column)
; Moving left and right in a row, up and down in a column.
> (map (lambda (d) (let ([v (layout:neighbour (views:find 1) d)]) (and v (views:id v)))) '(left right up down))
(#f 4 #f 2)
> (map (lambda (d) (let ([v (layout:neighbour (views:find 2) d)]) (and v (views:id v)))) '(left right up down))
(#f #f 1 #f)
> (map (lambda (d) (let ([v (layout:neighbour (views:find 4) d)]) (and v (views:id v)))) '(left right up down))
(1 3 #f 2)
; Enlarging adds tenths of the split's total weight, taken evenly from
; the siblings; shrinking takes them.
> (press! c1 '("x" "control") '("}"))
> (tree)
(layout:root () (layout-split:container ((direction . column)) (layout-split:container ((direction . row)) #(views:view ((view . 1) (buffer . "*Help*") (weight . 7/10))) #(views:view ((view . 4) (buffer . "notes") (weight . 2/5))) #(views:view ((view . 3) (buffer . "notes") (weight . 9/10)))) #(views:view ((view . 2) (buffer . "notes")))))
