; A fold that ends at a node's closing ends its line there, so a buffer
; of many hidden nodes draws as many lines as the page wants, not every
; node joined into one line.
> (import (md))
> (define (paragraph i) (md:para '() (format "head ~a\nbody\nbody\n" i)))
> (define many (buffers:make "many" (apply md:doc '() (map paragraph (iota 2000)))))
> (define v (views:make many))
> (define (fold-starts v)
    (let ([doc (buffers:document (views:buffer v))] [acc '()])
      (document:for-each-child (document:token doc 0) 1 (- (document:length doc) 1)
        (lambda (child at)
          (let* ([s (document:node-start child)] [text (document:text doc (+ s 1) (document:node-end child))])
            (set! acc (cons (cons (+ s 1 (let loop ([i 0]) (if (char=? (string-ref text i) #\newline) i (loop (+ i 1)))))
                                  (- (document:node-end child) 1))
                            acc)))))
      (reverse acc)))
> (define folds (fold-starts v))
> (for-each (lambda (f) (views:fold! v (car f) (cdr f))) folds)
> (length folds)
2000
> (drawn v desktop)
(1 304 102 () (5694))
; Each hidden node is one line: the second line drawn is the second node.
> (let ([html (html-of v desktop)]) (list (and (search html "head 1<" 0) #t) (and (search html "head 1999<" 0) #t)))
(#t #f)
; A fold that ends inside a node's text still joins the lines around it.
> (define t (views:make (buffers:make "t" "one\ntwo\nthree\n")))
> (views:fold! t 3 9)
> (show t)
<div class="view nowrap" id="view-2" data-view="2" data-version="0" data-showing="0" data-placement="*" data-place-kind="position" data-lead data-place-item="1" data-place-fraction="0.0" data-place-column="0" data-scroll-margin="2" data-reported="0" data-drawn-screens="2.0" data-run-at-start data-run-at-end data-lines="3" data-chars="14"><div class="view-bars" data-preserve-attr="data-shown" aria-hidden="true"><div class="view-scroll-bar" data-scroll-bar="vertical" data-keymap="1" data-preserve-attr="style data-fits data-held"><div class="view-thumb"></div></div></div><div class="view-lines"><div class="line" id="v2-1" data-line="1" data-before="0" data-at="1"><span class="cursor-on primary">o</span>n<span class="fold" data-at="3" data-to="9">…</span>three</div><div class="line" id="v2-2" data-line="4" data-before="14"><br></div></div></div>
; folds-at gives every fold holding a position, ends included, nested or
; touching; folded? whether any does.
> (define nest (views:make (buffers:make "nest" "abcdefghijklmnopqrstuvwxyz\n")))
> (views:fold! nest 2 20)
> (views:fold! nest 5 10)
> (views:fold! nest 20 24)
> (map (lambda (p) (list-sort (lambda (a b) (< (car a) (car b))) (views:folds-at nest p))) '(1 2 7 10 15 20 24 25))
(() ((2 . 20)) ((2 . 20) (5 . 10)) ((2 . 20) (5 . 10)) ((2 . 20)) ((2 . 20) (20 . 24)) ((20 . 24)) ())
> (map (lambda (p) (views:folded? nest p)) '(1 2 22 25))
(#f #t #t #f)
; views:fold-opened is told when a draw opens the folds holding a cursor,
; inner ones first, with the buffer current, after the draw.
> (define opened '())
> (hooks:add! views:fold-opened (lambda (view start end) (set! opened (cons (list (views:id view) start end (buffers:name (buffers:current))) opened))))
> (views:set-point! nest 7)
> (string? (html-of nest desktop))
#t
> (map (lambda (p) (views:folds-at nest p)) '(7 22))
(() ((20 . 24)))
> (let loop ([n 0]) (when (and (null? opened) (< n 100)) (timers:sleep 0.01) (loop (+ n 1))))
> (map (lambda (o) (cdr o)) (reverse opened))
((5 10 "nest") (2 20 "nest"))
; views:reveal! opens the folds hiding any of a range and tells at once;
; at a single position, only those holding it strictly, as for a cursor.
> (set! opened '())
> (views:reveal! nest 20 20)
> (list opened (views:folds-at nest 20))
(() ((20 . 24)))
> (views:reveal! nest 19 21)
> (list (map cdr opened) (views:folds-at nest 22))
(((20 24 "nest")) ())
; A fold its maker opens with views:unfold! tells nothing.
> (set! opened '())
> (views:set-point! nest 1)
> (views:fold! nest 3 8)
> (views:unfold! nest 4)
> opened
()
