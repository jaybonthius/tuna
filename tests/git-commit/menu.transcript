> (define repo (fresh! "repo"))
> (sh "cd repo && git config user.name Tuna && git config user.email tuna@example.org")
> (define (log) (git-out "repo" "log" "--format=%s"))
> (define (first-line s) (let loop ([i 0]) (if (or (= i (string-length s)) (char=? (string-ref s i) #\newline)) (substring s 0 i) (loop (+ i 1)))))
> (define (editing?) (equal? (shown-buffer) "COMMIT_EDITMSG"))
> (define (message!) (testing:wait-until editing?) (views:buffer (view)))
; c shows the commit menu, with Magit's groups and keys.
> (press! "c")
> (menu)
("Commit" ("Arguments" ("- a" "Stage all modified and deleted files" "--all") ("- e" "Allow empty commit" "--allow-empty") ("- v" "Show diff of changes to be committed" "*--verbose") ("- n" "Disable hooks" "--no-verify") ("- R" "Claim authorship and reset author date" "--reset-author") ("- A" "Override the author" "--author=")) ("Create" ("c" "Commit")) ("Edit HEAD" ("e" "Extend") ("a" "Amend") ("w" "Reword")))
; a switch toggles its argument.
> (press! "-" "a")
> (cadr (menu))
("Arguments" ("- a" "Stage all modified and deleted files" "*--all") ("- e" "Allow empty commit" "--allow-empty") ("- v" "Show diff of changes to be committed" "*--verbose") ("- n" "Disable hooks" "--no-verify") ("- R" "Claim authorship and reset author date" "--reset-author") ("- A" "Override the author" "--author="))
> (press! "-" "a")
; -A reads an author among the repository's and sets --author=.
> (answer! "Ada <ada@example.org>")
> (press! "-" "A")
> (list (take-asked!) (cadr (menu)))
(("Author: ") ("Arguments" ("- a" "Stage all modified and deleted files" "--all") ("- e" "Allow empty commit" "--allow-empty") ("- v" "Show diff of changes to be committed" "*--verbose") ("- n" "Disable hooks" "--no-verify") ("- R" "Claim authorship and reset author date" "--reset-author") ("- A" "Override the author" "*--author=Ada <ada@example.org>")))
> (press! "-" "A")
> (press! "C-g")
; C-g closes it.
> (menu-open?)
#f
; c c with something staged runs git commit --verbose; git's
; message file opens in the selected view, in git-commit:mode.
> (press! "c" "c")
> (define m (message!))
> (list (buffers:with-buffer m (with-editor:mode)) (buffers:with-buffer m (git-commit:mode)) (modes:major-mode m))
(#t #t modes:fundamental)
> (take-said!)
("Type C-c C-c to finish, C-c C-k to cancel" "Type C-c C-c to finish, C-c C-k to cancel, and M-p and M-n to recover older messages")
> (git:command-arguments (git:running repo))
("commit" "--verbose")
; the diff below the scissors line is folded in the view.
> (let ([doc (buffers:document m)]) (pair? (views:folds-at (view) (- (document:length doc) 2))))
#t
; C-c C-c commits and says Git finished; the view shows the
; status buffer again, the message on the history.
> (buffers:replace! m 1 1 "Commit b\n")
#<edit 1>
> (press! "C-c" "C-c")
> (settle!)
> (list (log) (shown-buffer) (take-said!) (car (git-commit:messages)))
("Commit b\nlong\nSecond commit\nFirst commit\n" "*git: repo*" ("Wrote ~/repo/.git/COMMIT_EDITMSG" "Git finished") "Commit b")
> (cadr (member "Unmerged into origin/main (3)" (status)))
"c664b6e main Commit b"
