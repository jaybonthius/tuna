; Items run in the order their client numbered them, whatever order they
; arrive in, and a number seen before is ignored.
> (http:send-numbered-all! p
    (map (lambda (seq) (list seq (cons "type" "note") (cons "n" seq))) '(3 1 2 2 5 4 1)))
(204 204 204 204 204 204 204)
