; An ask is about the selected view after the command: C-x o asks about
; the view it selects.
> (press! "C-f")
> (wait-until (lambda () (echo-area:current-message)))
> (set! asked '())
> (press! "C-x" "o")
> (sleep-for 0.3)
> (equal? asked (list (views:id other-view)))
#t
> (press! "C-x" "o")
> (sleep-for 0.3)
; Commands that change nothing of the place ask nothing again.
> (define count 0)
> (define (counting view) (set! count (+ count 1)) #f)
> (add-hook! docs-at-point:sources counting)
> (commands:define-command (noop) "Does nothing." (void))
> (keys:bind! keys:global "C-c z" noop)
> (press! "C-f")
> (sleep-for 0.3)
> (set! count 0)
> (press! "C-c" "z")
> (sleep-for 0.3)
> (press! "C-c" "z")
> (sleep-for 0.3)
> count
0
> (remove-hook! docs-at-point:sources counting)
; The delay is read in the selected view's buffer: a local delay in
; another buffer leaves this one's alone.
> (set-option! docs-at-point:delay 0.5)
> (define other (buffers:make "other" "plain\n"))
> (buffers:with-buffer other (set-option-local! docs-at-point:delay 0.05))
> (set! asked '())
> (press! "C-f")
> (sleep-for 0.2)
> asked
()
> (sleep-for 0.5)
> (length asked)
1
> (set-option! docs-at-point:delay 0.05)
; With after-edits-only?, a switch to another buffer is no edit.
> (define third (buffers:make "third" "gamma delta\n"))
> (commands:define-command (to-third) "Shows third." (layout:switch-to-buffer third))
> (keys:bind! keys:global "C-c t" to-third)
> (set-option! docs-at-point:after-edits-only? #t)
> (set! asked '())
> (press! "C-c" "t")
> (sleep-for 0.3)
> (list (buffers:name (views:buffer (view))) asked)
("third" ())
> (set-option! docs-at-point:after-edits-only? #f)
> (layout:switch-to-buffer notes)
; Docs show again after a command only in the view they are about: in a
; view whose buffer has the mode off they do not follow.
> (press! "C-a")
> (wait-until (lambda () (echo-area:current-message)))
> (echo-area:current-message)
"alpha: (alpha x)"
> (views:set-buffer! other-view other)
> (buffers:with-buffer other (set-option-local! docs-at-point:mode #f))
> (layout:select! other-view)
> (press! "C-f")
> (sleep-for 0.3)
> (press! "C-e")
> (sleep-for 0.3)
> (list (buffers:name (views:buffer (view))) (echo-area:current-message))
("other" #f)
> (layout:select! notes-view)
; C-h . keeps its answer though the source is slower than the delay: the
; idle after its command finds the place it asked about.
> (remove-hook! docs-at-point:sources signature)
> (define (slower view) (sleep-for 0.8) (docs-at-point:make-doc "slower doc" (docs-at-point:doc-options [thing "s2"])))
> (add-hook! docs-at-point:sources slower)
> (set-option! docs-at-point:delay 0.5)
> (press! "C-h" ".")
> (sleep-for 1.5)
> (list (and (buffers:find "*Docs*") (document:text (buffers:document (buffers:find "*Docs*")))) (echo-area:current-message))
("s2\nslower doc\n" "s2: slower doc")
