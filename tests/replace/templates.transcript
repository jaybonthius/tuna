; A regexp replacement expands \&, \N and \#, the count so far.
> (define b (show "t" "ab-cd ef-gh\n"))
> (replace! "C-M-%" "(\\w+)-(\\w+)" "\\2-\\1 [\\&] \\#")
> (asked)
> (press! "!")
> (text)
(6 "Query replacing regexp (\\w+)-(\\w+) with cd-ab [ab-cd] 0: (? for help) " "ab-cd")
"cd-ab [ab-cd] 0 gh-ef [ef-gh] 1\n"
; The replacement takes the case of a match in capitals or capitalized,
; when neither the text nor the replacement has a capital.
> (define c (show "c" "foo Foo FOO fOO\n"))
> (replace! "M-%" "foo" "bar baz")
> (press! "!")
> (text)
> (define c2 (show "c2" "foo Foo FOO\n"))
> (replace! "M-%" "foo" "Bar")
> (press! "!")
> (text)
> (list (replace:match-case "bar baz" "FOO") (replace:match-case "bar baz" "Foo Qux") (replace:match-case "bar" "F"))
"bar baz Bar Baz BAR BAZ bar baz\n"
"Bar Bar Bar\n"
("BAR BAZ" "Bar Baz" "Bar")
; e reads a new replacement, with the session's keys off so y, n and !
; edit it; it replaces the current match and is used from then on. E
; turns case conversion off for the rest of the session.
> (define e (show "e" "foo Foo FOO foo\n"))
> (replace! "M-%" "foo" "x")
> (start! "e")
> (press! "DEL" "y" "n" "!" "RET")
> (sleep-for 0.05)
> (list (text) (asked))
> (start! "E")
> (press! "DEL" "DEL" "DEL" "z" "RET")
> (sleep-for 0.05)
> (list (text) (asked))
> (press! "!")
> (text)
("yn! Foo FOO foo\n" (8 "Query replacing foo with Yn!: (? for help) " "Foo"))
("yn! z FOO foo\n" (10 "Query replacing foo with z: (? for help) " "FOO"))
"yn! z z z\n"
; A quit in that prompt ends the session.
> (define e2 (show "e2" "foo foo\n"))
> (replace! "M-%" "foo" "x")
> (start! "e")
> (press! "C-g")
> (list (session) (text))
! &quit
(#f "foo foo\n")
; With C-u only whole words match; with -, the session runs backward.
> (define w (show "w" "foo foobar foo\n"))
> (start! "C-u" "M-%")
> (type! "foo")
> (press! "RET")
> (sleep-for 0.05)
> (type! "x")
> (press! "RET")
> (sleep-for 0.05)
> (press! "!")
> (text)
> (define w2 (show "w2" "foo foo foo\n"))
> (views:set-point! (view) 9)
> (start! "M--" "M-%")
> (type! "foo")
> (press! "RET")
> (sleep-for 0.05)
> (type! "y")
> (press! "RET")
> (sleep-for 0.05)
> (asked)
> (press! "y")
> (list (text) (asked))
> (press! "q")
"x foobar x\n"
(5 "Query replacing foo with y: (? for help) " "foo")
("foo y foo\n" (1 "Query replacing foo with y: (? for help) " "foo"))
; The default is the last pair; M-p in the first prompt gives each past
; pair written from → to, and one chosen gives both; an arrow typed is
; text to replace, as in Emacs.
> (define h (show "h" "aa foo x → y\n"))
> (replace:history)
> (start! "M-%")
> (text)
> (press! "C-g")
> (start! "M-%")
> (press! "M-p")
> (minibuffer:input (minibuffer:current-prompt))
> (press! "M-p")
> (minibuffer:input (minibuffer:current-prompt))
> (press! "C-g")
> (replace:prompt-history)
> (replace! "M-%" "x → y" "z")
> (asked)
> (press! "!")
> (list (text) (car (replace:history)))
> (views:set-point! (view) 1)
> (start! "M-%")
> (press! "M-p" "M-p" "RET")
> (sleep-for 0.05)
> (asked)
> (press! "q")
(("foo" . "y") ("foo" . "x") ("foo" . "Bar") ("foo" . "bar baz") ("(\\w+)-(\\w+)" . "\\2-\\1 [\\&] \\#"))
"Query replace (default foo → y): \n"
! &quit
"foo → y"
"foo → x"
! &quit
("y" "foo" "x" "Bar" "bar baz" "\\2-\\1 [\\&] \\#" "(\\w+)-(\\w+)")
(13 "Query replacing x → y with z: (? for help) " "x → y")
("aa foo z\n" ("x → y" . "z"))
(7 "Query replacing foo with y: (? for help) " "foo")
; While the text is typed, its matches are highlighted in the view.
> (define l (show "l" "ab ab ab\n"))
> (define v (view))
> (start! "M-%")
> (type! "ab")
> (sleep-for 0.2)
> (faced (html->string (views:draw v client)))
> (press! "C-g")
> (faced (html->string (views:draw v client)))
(("match.other" "ab") ("match.other" "ab") ("match.other" "ab"))
! &quit
()
; The pairs are never saved in replace:prompt-history, which keeps what
; was typed; replace:history keeps as many pairs as
; minibuffer:history-length.
> (set-saved! replace:history (map (lambda (k) (cons (format "f~a" k) (format "t~a" k))) (iota 100)))
> (set-saved! replace:prompt-history '("typed-a" "typed-b"))
> (define pb (show "pb" "foo foo\n"))
> (replace! "M-%" "foo" "baz")
> (press! "q")
> (list (replace:prompt-history) (length (replace:history)) (car (replace:history)))
(("baz" "foo" "typed-a" "typed-b") 100 ("foo" . "baz"))
; Text typed equal to a past pair is text to replace.
> (define eq (show "eq" "foo → baz\n"))
> (replace! "M-%" "foo → baz" "Z")
> (asked)
> (press! "!")
> (text)
(10 "Query replacing foo → baz with Z: (? for help) " "foo → baz")
"Z\n"
; M-r in the first prompt lists the pairs too, and a pair chosen there
; gives both strings.
> (set-saved! replace:history '(("bb" . "BB")))
> (define mr (show "mr" "aa bb cc\n"))
> (start! "M-%")
> (start! "M-r")
> (type! "bb →")
> (press! "RET")
> (sleep-for 0.05)
> (press! "RET")
> (sleep-for 0.05)
> (asked)
> (press! "!")
> (text)
(6 "Query replacing bb with BB: (? for help) " "bb")
"aa BB cc\n"
