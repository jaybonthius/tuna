; Unloading a module leaves its saved data: loaded again, the module
; reads the value, and a procedure held from before is the same one.
> (define held hist:entries)
> (unload-owner! (module-owner '(hist)))
> (load-module! '(hist))
#<owner (hist) 2>
> (saved:set! hist:entries (cons "kept" (hist:entries)))
> (list (hist:entries) (eq? held hist:entries))
(("kept" "first" "first") #t)
