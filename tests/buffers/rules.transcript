; A buffer is made from a string, held in a buffers:text root, a datum of
; one node, or a document of one node.
> (root (buffers:make "plain" "Buy milk.\n"))
(buffers:text () "Buy milk.\n")
> (root (buffers:make "datum" '(md:para () "a")))
(md:para () "a")
> (root (buffers:make "document" (document:from-datum '(md:para () "a"))))
(md:para () "a")
> (buffers:make "plain" "again")
! buffers:make: a live buffer has the name with irritant "plain"
> (buffers:make "atom" '#(md:image ()))
! buffers:make: not one node with irritant #(md:image ())
> (buffers:make "two" (document:from-datum '(md:para ()) '(md:para ())))
! buffers:make: not one node with irritant ((md:para ()) (md:para ()))
> (buffers:make 'name "a")
! buffers:make: not a string with irritant name
> (list (buffers:find "nothing") (buffers:find "datum"))
(#f #<buffer datum>)
> (map buffers:name (buffers:all))
("plain" "datum" "document")
> (define plain (buffers:find "plain"))
> (buffers:rename! plain "datum")
! buffers:rename!: a live buffer has the name with irritant "datum"
> (buffers:rename! plain "renamed")
> (list (buffers:name plain) (buffers:find "plain") (buffers:find "renamed"))
("renamed" #f #<buffer renamed>)
> (list (buffers:buffer? plain) (buffers:buffer? "renamed") (buffers:current))
(#t #f #f)
; Killing calls the queries, then killed with the buffer current and
; still live, then drops its scope.
> (define-option width 70 fixnum?)
> (buffers:with-buffer plain (set-option-local! width 3))
> (add-hook! buffers:killed
    (lambda (b) (write (list 'killed (buffers:name b) (eq? (buffers:current) b) (buffers:live? b) (width)))))
> (buffers:kill! plain)
(killed "renamed" #t #t 3)
#t
> (list (buffers:live? plain) (buffers:with-buffer plain (width)) (map buffers:name (buffers:all)))
(#f 70 ("datum" "document"))
> (buffers:replace! plain 1 1 "a")
! buffers:replace!: not a live buffer with irritant #<buffer renamed>
> (buffers:kill! plain)
! buffers:kill!: not a live buffer with irritant #<buffer renamed>
; The buffer is current, with its scope's local entries, while
; after-edit runs; content is a string, a datum or a document.
> (define t (fresh "abc\n"))
> (define (note b e)
    (write (list 'edit (buffers:edit-version e) (buffers:edit-start e)
                 (document:datums (buffers:edit-removed e)) (document:datums (buffers:edit-inserted e))
                 (eq? b (buffers:current)) (width))))
> (buffers:with-buffer t (set-option-local! width 4) (add-local-hook! buffers:after-edit note))
> (buffers:replace! t 2 3 "XY")
(edit 1 2 ("b") ("XY") #t 4)
#<edit 1>
> (buffers:replace! t 1 1 '(md:link () "L"))
(edit 2 1 () ((md:link () "L")) #t 4)
#<edit 2>
> (buffers:replace! t 1 1 (document:from-datum "doc"))
(edit 3 1 () ("doc") #t 4)
#<edit 3>
> (buffers:with-buffer t (remove-local-hook! buffers:after-edit note))
; with-buffer binds the buffer's scope even when the buffer is current.
> (buffers:with-buffer t (parameterize ([current-scope (make-scope)]) (buffers:with-buffer t (width))))
4
> (list (buffers:version t) (document:text (buffers:document t)) (eq? (buffers:document t) (buffers:document t)))
(3 "docLaXYc\n" #t)
