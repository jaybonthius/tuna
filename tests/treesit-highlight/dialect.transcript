; Query files are read as Neovim reads them. Each predicate tests every
; node of its capture, or with any- some node; not- negates the whole
; test. Here the names of a list are one capture of two nodes.
> (define (lists test) (queried "[a, a]\n[a, b]\n[b, c]\n" (string-append "((list (identifier) @n (identifier) @n) @string " test ")")))
> (define (matched test) (map car (filter (lambda (run) (equal? (cadr run) '(n string))) (lists test))))
> (map matched '("(#eq? @n \"a\")" "(#any-eq? @n \"a\")" "(#not-eq? @n \"a\")" "(#not-any-eq? @n \"a\")"))
(("a" "a") ("a" "a" "a" "b") ("a" "b" "b" "c") ("b" "c"))
> (map matched '("(#match? @n \"^a$\")" "(#any-match? @n \"^a$\")" "(#not-match? @n \"^a$\")" "(#not-any-match? @n \"^a$\")"))
(("a" "a") ("a" "a" "a" "b") ("a" "b" "b" "c") ("b" "c"))
> (map matched '("(#vim-match? @n \"^a$\")" "(#any-vim-match? @n \"^a$\")" "(#not-vim-match? @n \"^a$\")" "(#not-any-vim-match? @n \"^a$\")"))
(("a" "a") ("a" "a" "a" "b") ("a" "b" "b" "c") ("b" "c"))
> (map matched '("(#lua-match? @n \"^a$\")" "(#any-lua-match? @n \"^a$\")" "(#not-lua-match? @n \"^a$\")" "(#not-any-lua-match? @n \"^a$\")"))
(("a" "a") ("a" "a" "a" "b") ("a" "b" "b" "c") ("b" "c"))
> (map matched '("(#contains? @n \"a\")" "(#any-contains? @n \"a\")" "(#not-contains? @n \"a\")" "(#not-any-contains? @n \"a\")"))
(("a" "a") ("a" "a" "a" "b") ("a" "b" "b" "c") ("b" "c"))
; any-of? passes when some node is one of the strings.
> (map matched '("(#any-of? @n \"a\" \"x\")" "(#not-any-of? @n \"a\" \"x\")"))
(("a" "a" "a" "b") ("b" "c"))
> (map matched '("(#kind-eq? @n \"identifier\")" "(#any-kind-eq? @n \"string\")" "(#not-kind-eq? @n \"string\")"))
(("a" "a" "a" "b" "b" "c") () ("a" "a" "a" "b" "b" "c"))
; A test of a capture with no node passes, so its not- form fails.
> (define (calls test) (queried "f()\ng(x)\nh(y)\n" (string-append "((call function: (identifier) @function arguments: (argument_list (identifier)? @a)) " test ")")))
> (calls "(#eq? @a \"x\")")
(("f" function) ("g" function) ("x" a))
> (calls "(#not-eq? @a \"x\")")
(("h" function) ("y" a))
> (calls "(#any-of? @a \"x\")")
(("f" function) ("g" function) ("x" a))
> (calls "(#not-any-of? @a \"x\")")
(("h" function) ("y" a))
> (calls "(#has-ancestor? @a call)")
(("f" function) ("g" function) ("x" a) ("h" function) ("y" a))
> (calls "(#not-has-parent? @a argument_list)")
()
; eq? compares with a string or with another capture's text.
> (queried "self.a = b\n" "((identifier) @keyword (#eq? @keyword \"self\"))")
(("self" keyword))
> (queried "a = a\nb = c\n" "((assignment left: (identifier) @x right: (identifier) @y) (#eq? @x @y))")
(("a" x) ("a" y))
; contains? needs every string; any-contains? one.
> (queried "abc\nab\nb\n" "((identifier) @x (#contains? @x \"a\" \"b\"))")
(("abc" x) ("ab" x))
> (queried "abc\nab\nb\nc\n" "((identifier) @x (#any-contains? @x \"a\" \"b\"))")
(("abc" x) ("ab" x) ("b" x))
; The tree predicates name node types: of any ancestor, of the parent, of
; the node itself.
> (queried "x: int = 1\ny = int\n" "((identifier) @type (#has-ancestor? @type type))")
(("int" type))
; A query may name more ancestor types than a fixnum has bits.
> (define many (apply string-append (map (lambda (k) (format " kind~a" k)) (iota 80))))
> (queried "x: int = 1\ny = int\n" (string-append "((identifier) @type (#has-ancestor? @type" many " type))"))
(("int" type))
> (queried "x: int = 1\ny = int\n" "((identifier) @type (#not-has-ancestor? @type type assignment))")
()
> (queried "f(a)\nb.c\n" "((identifier) @x (#has-parent? @x argument_list attribute))")
(("a" x) ("b" x) ("c" x))
> (queried "f(a)\nb.c\n" "((identifier) @x (#not-has-parent? @x argument_list))")
(("f" x) ("b" x) ("c" x))
> (queried "f(a)\n" "((_) @x (#kind-eq? @x \"argument_list\" \"identifier\"))")
(("f(" x) ("a" (x x)) (")" x))
; match? is Vim's very magic regular expression: \c ignores case, \d
; and {n,m} count, %( groups, = is ?, . is not a newline, < starts a
; word.
> (queried "LIST list Lisp\n" "((identifier) @x (#match? @x \"\\\\c^list$\"))")
(("LIST" x) ("list" x))
> (queried "ab1 a12 a123\n" "((identifier) @x (#match? @x \"^a\\\\d{2,3}$\"))")
(("a12" x) ("a123" x))
> (queried "ab ac ad\n" "((identifier) @x (#match? @x \"^a%(b|c)$\"))")
(("ab" x) ("ac" x))
> (queried "a ab abb\n" "((identifier) @x (#match? @x \"^ab=$\"))")
(("a" x) ("ab" x))
> (queried "x = '''a\nb'''\ny = 'axb'\n" "((string) @x (#match? @x \"a.b\"))")
(("'axb'" x))
> (queried "foo_bar bar\n" "((identifier) @x (#match? @x \"<bar\"))")
(("bar" x))
; lua-match? is a Lua pattern: %u and %l classes, sets, - as a lazy *,
; % quoting, and characters such as | that are themselves in Lua.
> (queried "Abc abc ABC\n" "((identifier) @x (#lua-match? @x \"^%u%l+$\"))")
(("Abc" x))
> (queried "x = r'a'\ny = 'a'\n" "((string_start) @x (#lua-match? @x \"^%a+['\\\"]$\"))")
(("r'" x))
> (queried "a1 a_ a.b\n" "((identifier) @x (#lua-match? @x \"^a[%d_]$\"))")
(("a1" x) ("a_" x))
> (queried "a aa aab b\n" "((identifier) @x (#lua-match? @x \"^a-b$\"))")
(("aab" x) ("b" x))
> (queried "x = 'a.b'\ny = 'axb'\n" "((string_content) @x (#lua-match? @x \"^a%.b$\"))")
(("a.b" x))
> (queried "x = 'a|b'\ny = 'a'\n" "((string_content) @x (#lua-match? @x \"a|b\"))")
(("a|b" x))
; #offset! moves a capture's edges by rows and columns; #trim! trims
; blank lines, by default those at the end, or with four flags blank
; lines and spaces at either end; #gsub! rewrites text no colour uses.
> (queried "x = r'a'\n" "((string) @string (#offset! @string 0 1 0 -1))")
(("'a" string))
> (queried "x = 1\ny = 2\n" "((expression_statement) @x (#offset! @x 1 0 1 0))")
(("y = 2" x))
> (queried "x = '''\n\n  a  \n\n'''\n" "((string_content) @x (#trim! @x))")
(("\n\n  a  " x))
> (queried "x = '''\n\n  a  \n\n'''\n" "((string_content) @x (#trim! @x 1 1 1 1))")
(("a" x))
> (queried "x = 'a'\n" "((string) @x (#gsub! @x \"a\" \"b\"))")
(("'a'" x))
; #set! gives a pattern, or one of its captures, a priority.
> (queried "x = 1\n" "((identifier) @x (#set! priority 99)) ((identifier) @y)")
(("x" y))
> (queried "x = 1\n" "((identifier) @x (#set! \"priority\" \"101\")) ((identifier) @y)")
(("x" x))
> (queried "x = 1\n" "((identifier) @x (#set! @x priority 101)) ((identifier) @y)")
(("x" x))
; A #set! whose value is a capture, as a link's url, colours nothing.
> (queried "x = 'a'\n" "((string (string_content) @y) @x (#set! @x url @y))")
(("'" x) ("a" (y x)) ("'" x))
; Anything else is a query error, told with the file, the row counted
; from 1 and the column from 0; the file is left out.
> (define (problems q)
    (let* ([file (query q)] [s (open "x = 1\n" (list file) '())])
      (settle! s)
      (list (map (lambda (r) (if (equal? (cadr r) file) (cons* (car r) 'that-file (cddr r)) r)) (session-problems s)) (runs s))))
> (problems "((identifier) @x (#is? @x local))")
(((query-error that-file 1 18 "unknown predicate #is?")) ())
> (problems "((identifier) @x\n  (#foo? @x))")
(((query-error that-file 2 3 "unknown predicate #foo?")) ())
> (problems "((identifier) @x (#strip! @x))")
(((query-error that-file 1 18 "unknown directive #strip!")) ())
> (problems "((identifier) @x (#any-not-eq? @x \"a\"))")
(((query-error that-file 1 18 "unknown predicate #any-not-eq?")) ())
> (problems "((identifier) @x (#eq? @x))")
(((query-error that-file 1 18 "wrong arguments to #eq?")) ())
> (problems "((identifier) @x (#offset! @x a))")
(((query-error that-file 1 18 "#offset! takes a capture and up to four integers")) ())
> (problems "((identifier) @x (#trim! @x 1 2))")
(((query-error that-file 1 18 "#trim! takes a capture and none or four of 0 and 1")) ())
; A pattern construct POSIX lacks is an error, not a different match.
> (problems "((identifier) @x (#match? @x \"a\\\\zsb\"))")
(((query-error that-file 1 18 "Vim's \\z has no POSIX translation")) ())
> (problems "((identifier) @x (#match? @x \"a@<=b\"))")
(((query-error that-file 1 18 "Vim's @ has no POSIX translation")) ())
> (problems "((identifier) @x (#match? @x \"\\\\Va\"))")
(((query-error that-file 1 18 "Vim's \\V mode has no POSIX translation")) ())
> (problems "((identifier) @x (#lua-match? @x \"%b()\"))")
(((query-error that-file 1 18 "Lua's %b has no POSIX translation")) ())
> (problems "((identifier) @x (#lua-match? @x \"%f[%w]\"))")
(((query-error that-file 1 18 "Lua's %f has no POSIX translation")) ())
; tree-sitter's own errors point into the file too.
> (problems "((identifier) @x (#eq? @x \"x\"))\n  (no_such_node) @y")
(((query-error that-file 2 3 "invalid node type")) ())
