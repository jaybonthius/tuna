; When a client is removed, its temporary keymaps end, each running its
; on-exit, and the commands its keys paused are quit, as C-g quits them;
; another client's keymaps stay.
> (define c1 (web:make-client 1))
> (define c2 (web:make-client 2))
> (define-table jump-keymap)
> (define exits '())
> (define (exit-of name) (lambda () (set! exits (cons name exits))))
> (procedure? (keys:push-keymap! c1 jump-keymap (lambda (found command) #t) (exit-of 'one) "Jump: "))
#t
> (procedure? (keys:push-keymap! c2 jump-keymap (lambda (found command) #t) (exit-of 'two) "Jump: "))
#t
> (define outcome #f)
> (commands:define-command (waiting) "Pauses until resumed."
    (guard (c [(quit-condition? c) (set! outcome 'quit)])
      (suspend (lambda (resume) (void)))))
> (keys:bind! keys:global "C-c w" waiting)
> (spawn-task (lambda () (keys:press! c1 "C-c") (keys:press! c1 "w")))
#<task>
> (sleep-for 0.05)
> (list (keys:prompt c1) (keys:prompt c2))
("Jump: " "Jump: ")
> (web:client-removed c1)
> (sleep-for 0.05)
> (list exits outcome (keys:prompt c1) (keys:prompt c2))
((one) quit #f "Jump: ")
