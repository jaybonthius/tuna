> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
; A timer runs its procedure once, as a task, on behalf of the module
; that started it; until then it is running and its owner's change.
> (define (ring) (note! (list 'ring (current-owner) (task? (current-task)))))
> (define once #f)
> (begin
    (set! once (timers:run-after 0.05 ring))
    (list (timers:timer? once) (equal? (timers:live) (list once)) (eq? (timers:procedure once) ring)
          (owner-changes (plugins:repl-owner))))
(#t #t #t ())
