; faces: the summary, past git-commit:summary-max-length the
; overlong face, a non-empty second line, trailer keys and comments.
> (set-option! git-commit:summary-max-length 4)
> (buffers:replace! m 1 1 "X")
#<edit 9>
> (define (faces) (map (lambda (s) (cdr (assq 'face (caddr s)))) (buffers:spans (buffers:layer m git-commit:%faces) 0 (document:length (buffers:document m)))))
> (list-head (faces) 5)
("git-commit.summary" "git-commit.overlong-summary" "git-commit.trailer-key" "git-commit.trailer-key" "git-commit.trailer-key")
> (set-option! git-commit:summary-max-length 68)
; an edit above the scissors line repaints only the message, as the diff
; below it can be large; an edit below it repaints the diff too.
> (define (diff-faces)
    (let* ([doc (buffers:document m)] [at (git-commit:%scissors-start doc)])
      (map (lambda (s) (cdr (assq 'face (caddr s)))) (buffers:spans (buffers:layer m git-commit:%faces) at (document:length doc)))))
> (list-head (diff-faces) 3)
(comment comment diff.minus)
