; These examples take the plugin greet as used.
> (use-plugin greet)
> (eval-in-module '(text "Chico") '(greet))
"Hello, Chico!"
; The configuration's set! reaches the module's own code.
> (spell:check "a.txt")
checking a.txt against /home/groucho/words
; eval-in-module of a definition assigns it, and a procedure held earlier
; calls the new one.
> (define held spell:check)
> (eval-in-module '(define (check path) (display (string-append "new check of " path))) '(spell))
> (held "b.txt")
new check of b.txt
; Assigning from the module's scope is not a change, and the
; configuration's override stays in effect.
> (owner-changes (plugins:repl-owner))
()
> (definition-changes spell:dictionary-path)
((#<owner (init) 1> override #f) (#<owner (spell) 1> define #f))
; A tool that advises a name chosen at run time takes a procedure from the
; module's scope and calls it on its own behalf.
> (define advise-text (eval-in-module '(lambda (p) (advice-add! text p)) '(greet)))
> (call-as-owner (module-owner '(spell)) (lambda () (advise-text (lambda (text name) (string-append (text name) "?")))))
> (greet:text "Gummo")
"Hello, Gummo!?"
> (map car (definition-changes greet:text))
(#<owner (spell) 1> #<owner (greet) 1>)
