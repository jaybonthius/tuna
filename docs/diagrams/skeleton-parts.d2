# What the architecture skeleton contains
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: right

classes: {
  kernel: {
    style: {
      fill: "#e8eaf6"
      stroke: "#283593"
      font-color: "#1a237e"
      border-radius: 8
      stroke-width: 3
      font-size: 18
    }
  }
  plugin: {
    style: {
      fill: "#eef3fb"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
      font-size: 18
    }
  }
  toy: {
    style: {
      fill: "#fff8e1"
      stroke: "#8d6e00"
      font-color: "#3e2f00"
      border-radius: 8
      stroke-dash: 4
      font-size: 18
    }
  }
}

legend: |md
  **Status:** all planned; this is what the skeleton builds.
  Each slot holds one plugin at a time; the (toy) plugin can be swapped in while Tuna runs.
|

plugins: Other standard plugins\nweb client connection, key handling,\nbuffers and views, basic editing,\nminibuffer, autosave and session,\ndemo commands {class: plugin}

kernel: Kernel (fixed)\nloads and undoes plugins,\nconnects services,\nruns commands, tasks and jobs {class: kernel}

store: Text store slot {
  rope: Rope (default) {class: plugin}
  simple: Plain string (toy) {class: toy}
}
render: Renderer slot {
  html: HTML (default) {class: plugin}
  plain: Plain text (toy) {class: toy}
}
wm: Window manager slot {
  one: One window (default) {class: plugin}
  two: Two windows, one file (toy) {class: toy}
}

plugins -> kernel: run on
store -> kernel: plugged into
render -> kernel: plugged into
wm -> kernel: plugged into
