; The token file declares 555 custom properties: 500 primitives, 194 of
; them colours (16 scales of 12 steps, white and black), and 55 semantic
; tokens, each reading primitives only.
> (list (length tokens) (length primitives) (length colour-names) (length semantic-names))
(555 500 194 55)
> (unresolved-semantic)
()
> (map (lambda (n) (token n)) '("surface" "chrome" "region" "cursor" "focus" "text-faint" "shadow-raised" "ease" "duration"))
("var(--tuna-gray-1)" "var(--tuna-gray-4)" "var(--tuna-blue-5)" "var(--tuna-gray-12)" "var(--tuna-blue-10)" "var(--tuna-gray-10)" "var(--tuna-shadow-3)" "var(--tuna-ease-out-5)" "var(--tuna-duration-3)")
; Hover and pressed are overlays, which work over any background.
> (map token '("hover" "pressed"))
("color-mix(in oklch, var(--tuna-gray-12) 8%, transparent)" "color-mix(in oklch, var(--tuna-gray-12) 14%, transparent)")
; Bars and controls are fluid between a 320 px and a 1440 px window, with
; no breakpoint: 28 and 30 px at 320 px, 32 px from 1440 px.
> (map token '("bar-size" "control-size"))
("clamp(1.75rem, 1.678571rem + 0.357143vw, 2rem)" "clamp(1.875rem, 1.839286rem + 0.178571vw, 2rem)")
; Text around buffers is Fira Sans and buffer text Fira Code, each
; served with the stylesheet and falling back to a stack.
> (map token '("font-ui" "font-code" "font-fira-sans" "font-fira-code"))
("var(--tuna-font-fira-sans)" "var(--tuna-font-fira-code)" "\"Fira Sans\", var(--tuna-font-humanist)" "\"Fira Code\", var(--tuna-font-monospace-code)")
> (font-faces)
(("Fira Sans" "400" "fonts/FiraSans-Regular.woff2") ("Fira Sans" "600" "fonts/FiraSans-SemiBold.woff2") ("Fira Sans" "700" "fonts/FiraSans-Bold.woff2") ("Fira Code" "300 700" "fonts/FiraCode-VF.woff2"))
> (missing-font-files)
()
; Each step is one light-dark() pair; translucency is mixed where used.
> (map token '("blue-9" "gray-1" "white"))
("light-dark(oklch(55% 0.18 255), oklch(55% 0.18 255))" "light-dark(oklch(99% 0.002 260), oklch(17% 0.004 260))" "oklch(100% 0 0)")
> (token "shadow-2")
"0 1px 2px -1px color-mix(in oklch, var(--tuna-shadow-color) 50%, transparent),\n      0 4px 8px -3px color-mix(in oklch, var(--tuna-shadow-color) 70%, transparent)"
; Fluid sizes and conditional radii follow the view, not the window.
> (map token '("font-size-fluid-3" "radius-conditional-6"))
("clamp(1.5rem, 6cqi, 2.5rem)" "clamp(0px, calc(100cqi - 100%) * 1e5, var(--tuna-radius-6))")
; Every colour is inside sRGB, so no browser clips it and changes its
; contrast.
> (outside-srgb)
()
; Every text-and-background pair the tokens are meant for meets its
; contrast in light and dark: text 7:1 on its backgrounds and the chrome,
; muted text, links and every face's colour 4.5:1 on the page, the
; current line and the region, faint text 4.5:1 on the page, and focus 3:1
; on the page and on every bar, as the cursor is on the page.
> (length pairs)
129
> (low-contrast)
()
; The chrome stands off the islands on it.
> (islands-unseen)
()
; 21 animations, each naming a keyframe rule of the same name shipped
; beside it; reduced motion makes every duration zero and every
; animation none.
> (list (length keyframes) (length (filter (lambda (d) (prefix? "--tuna-animation-" (car d))) tokens)))
(21 21)
