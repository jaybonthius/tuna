> (define desktop (web:add-client! 1))
> (define (view name) (views:make (or (buffers:find name) (buffers:make name ""))))
> (define files (view "files"))
> (define main.ss (view "main.ss"))
> (define shell (view "*shell*"))
> (define notes (view "notes.org"))
> (define magit (view "*magit*"))
> (define help (view "*help*"))
> (define echo (view "*Echo*"))
> (map views:id (list files main.ss shell notes magit help echo))
(3 4 5 6 7 8 9)
> (define (example! selected)
    (layout:part-mode-leave)
    (set-parts!
      (layout-split:container '((direction . row))
        (atom files '(weight . 1))
        (layout-scroll:container '((direction . row) (weight . 3))
          (layout-split:container '((direction . column) (size . 1/2))
            (atom main.ss)
            (atom shell))
          (atom notes '(size . 1/2))
          (layout-float:container '((size . 1/2))
            (atom magit '(place box 1/4 1/4))
            (atom help '(place box 3/4 3/4)))))
      (atom echo '(pinned . #t) '(locked . #t)))
    (layout:select! selected))
> (define (strip) (cadddr (main)))
; Moving a whole column: with main.ss selected, s-' i L L RET. i selects
; the column split; each L moves it one place along the strip, keeping
; its size and its views.
> (example! main.ss)
> (press! desktop '("'" "super") '("i") '("L"))
> (shape (strip))
(6 (4 5) (7 8))
> (type! desktop "L")
> (strip)
(layout-scroll:container ((direction . row) (weight . 3)) #(views:view ((view . 6) (buffer . "notes.org") (size . 1/2))) (layout-float:container ((size . 1/2)) #(views:view ((view . 7) (buffer . "*magit*") (place box 1/4 1/4))) #(views:view ((view . 8) (buffer . "*help*") (place box 3/4 3/4)))) (layout-split:container ((direction . column) (size . 1/2)) #(views:view ((view . 4) (buffer . "main.ss"))) #(views:view ((view . 5) (buffer . "*shell*")))))
> (type! desktop "Enter")
> (list (layout:part-mode?) (selected))
(#f 4)
; s-' C-/ C-/ instead of RET puts both moves back.
> (press! desktop '("'" "super") '("/" "control") '("/" "control"))
> (shape (strip))
((4 5) 6 (7 8))
; Moving notes.org into the first column, below *shell*: s-' J K L L.
; Its size goes, since a split does not name it.
> (example! notes)
> (press! desktop '("'" "super") '("J") '("K") '("L") '("L"))
> (caddr (strip))
(layout-split:container ((direction . column) (size . 1/2)) #(views:view ((view . 4) (buffer . "main.ss"))) #(views:view ((view . 5) (buffer . "*shell*"))) #(views:view ((view . 6) (buffer . "notes.org"))))
; Wrapping main.ss in tabs: s-' w t. No part was removed, so the column
; split stays, holding the tabs.
> (example! main.ss)
> (press! desktop '("'" "super") '("w") '("t"))
> (caddr (strip))
(layout-split:container ((direction . column) (size . 1/2)) (layout-tabs:container () #(views:view ((view . 4) (buffer . "main.ss")))) #(views:view ((view . 5) (buffer . "*shell*"))))
; Dissolving a split: with main.ss selected, s-' i -. Its two views
; become columns sharing its size.
> (example! main.ss)
> (press! desktop '("'" "super") '("i") '("-"))
> (strip)
(layout-scroll:container ((direction . row) (weight . 3)) #(views:view ((view . 4) (buffer . "main.ss") (size . 1/4))) #(views:view ((view . 5) (buffer . "*shell*") (size . 1/4))) #(views:view ((view . 6) (buffer . "notes.org") (size . 1/2))) (layout-float:container ((size . 1/2)) #(views:view ((view . 7) (buffer . "*magit*") (place box 1/4 1/4))) #(views:view ((view . 8) (buffer . "*help*") (place box 3/4 3/4)))))
; Into a float desktop: with notes.org selected, s-' l selects the
; desktop and focuses *magit*, its first float, so the strip scrolls the
; desktop into view. k selects *magit*, l *help*, which rises above
; *magit*, since floats stack by their last selection.
> (example! notes)
> (press! desktop '("'" "super") '("l"))
> (list (part) (selected))
((7 8) 7)
> (type! desktop "k" "l")
> (list (part) (selected) (map views:id (list-head (layout:selection-order) 2)))
(8 8 (8 7))
; Moving a view onto the desktop: with files selected, s-' K L L K. K
; moves files into the strip, as its first column at the default size,
; and the row split, left with the strip alone, collapses; L L move it
; past the column split and notes.org; K moves it into the desktop,
; where it floats in the middle.
> (example! files)
> (press! desktop '("'" "super") '("K"))
> (list (car (main)) (caddr (main)))
(layout-scroll:container #(views:view ((view . 3) (buffer . "files") (size . 1/2))))
> (type! desktop "L" "L" "K")
> (main)
(layout-scroll:container ((direction . row)) (layout-split:container ((direction . column) (size . 1/2)) #(views:view ((view . 4) (buffer . "main.ss"))) #(views:view ((view . 5) (buffer . "*shell*")))) #(views:view ((view . 6) (buffer . "notes.org") (size . 1/2))) (layout-float:container ((size . 1/2)) #(views:view ((view . 3) (buffer . "files") (place box 1/2 1/2))) #(views:view ((view . 7) (buffer . "*magit*") (place box 1/4 1/4))) #(views:view ((view . 8) (buffer . "*help*") (place box 3/4 3/4)))))
