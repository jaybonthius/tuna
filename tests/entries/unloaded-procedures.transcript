; A hook entry whose procedure is a changeable definition of an unloaded
; module is skipped while that module is unloaded, whoever added it, and
; runs again once the module loads. Advice whose procedure is one raises,
; as any call of it does.
> (import (target) (helper))
> (hooks:add! target:greeted helper:shout)
> (advice-add! target:text helper:wrap)
> (begin (target:greeted "Harpo") (target:text "Harpo"))
hello Harpo
"[Harpo]"
> (unload-owner! (module-owner '(helper)))
> (begin (target:greeted "Chico") (target:text "Chico"))
! helper:wrap: module (helper) is unloaded
; hooks:entries still gives the entry; owner-changes and
; definition-changes list the advice.
> (length (hooks:entries target:greeted))
1
> (map car (owner-changes (plugins:repl-owner)))
(advice)
> (map cadr (definition-changes target:text))
(advice define)
> (load-module! '(helper))
#<owner (helper) 2>
> (begin (target:greeted "Zeppo") (target:text "Zeppo"))
hello Zeppo
"[Zeppo]"
> (length (hooks:entries target:greeted))
1
; So is an entry of options:changed, a hook hooks:define-hook did not make.
> (options:define-option level 1 fixnum? #f)
> (hooks:add! options:changed helper:noted)
> (options:set! level 2)
(noted 2)
> (unload-owner! (module-owner '(helper)))
> (options:set! level 3)
> (length (hooks:entries options:changed))
1
> (load-module! '(helper))
#<owner (helper) 3>
> (options:set! level 4)
(noted 4)
> (hooks:remove! options:changed helper:noted)
; A definition its loaded module no longer defines is not skipped: a call
; raises, naming it.
> (put-version! "helper-without-shout.sls" ".config/tuna/lib/helper.sls")
> (reload-modules! '((helper)))
> (target:greeted "Gummo")
! helper:shout: module (helper) no longer defines it
