> (define (prefix-of . keys)
    (let ([t (start! (lambda () (press! "C-x" "b")))])
      (type! "prefixed")
      (wait-matches (session))
      (let ([a (act! "C-.")])
        (for-each (lambda (key) (press! key) (testing:wait-until (lambda () (or (eq? (task-state a) 'done) (keys:reading client))))) keys)
        (result a)
        (result t)
        (echo-area:current-message))))
