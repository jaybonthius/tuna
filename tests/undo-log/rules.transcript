; Rules of the log beside those of visiting.
> (import (tuna eval))
> (define (reload! name) (eval-file (string-append (getenv "TUNA_LIBRARY") "/" name ".sls")))
> (define (kinds path) (map car (checks:log-records path)))
> (define (logged path n)
    (wait-until (lambda () (= (length (checks:log-records path)) n)))
    (kinds path))
> (checks:write-text! "~/r.txt" "rules\n")
> (define r (files:visit "~/r.txt"))
> (define (in-r command . args) (buffers:with-buffer r (apply commands:run command args)))
> (in-r checks:insert 1 "1 ")
#<edit 1>
> (files:save-buffer r)
> (in-r checks:insert 1 "2 ")
#<edit 2>
> (logged "~/r.txt" 6)
(undo-history group saved at saved group)
; Reloading this plugin alone keeps undo's history, and writes the log
; again whole, with the saves it held, once it has read them.
> (reload! "undo-log")
> (wait-until (lambda () (equal? (kinds "~/r.txt") '(undo-history group group saved saved at))))
> (kinds "~/r.txt")
(undo-history group group saved saved at)
> (in-r checks:insert 1 "3 ")
#<edit 3>
> (logged "~/r.txt" 7)
(undo-history group group saved saved at group)
> (tree r)
(3 1 (0 #f) (1 0) (2 1) (3 2))
; A modified buffer that a log holds lets C-x C-c exit without asking
; about it; one that keeps no log makes it ask.
> (define asked '())
> (set-option! ask:yes-or-no-reader (lambda (question) (set! asked (cons question asked)) #f))
> (list (buffers:modified? r) (exists (lambda (entry) (entry r)) (hook-entries files:unsaved-kept)))
(#t #t)
> (checks:write-text! "~/n.txt" "no log\n")
> (define n (files:visit "~/n.txt"))
> (buffers:with-buffer n (set-option-local! undo:limit 0))
> (buffers:replace! n 1 1 "x")
#<edit 1>
> (exists (lambda (entry) (entry n)) (hook-entries files:unsaved-kept))
#f
> (commands:run files:save-buffers-kill-tuna)
> asked
("Modified buffers exist; exit anyway? ")
; Killing them in a command asks the same way: only about the buffer no
; log holds.
> (set! asked '())
> (set-option! ask:y-or-n-reader (lambda (question) (set! asked (cons question asked)) #f))
> (commands:define-command (kill [buffer (buffers:current)]) "Kills BUFFER." (buffers:kill! buffer))
> (checks:write-text! "~/k.txt" "kill\n")
> (define k (files:visit "~/k.txt"))
> (buffers:with-buffer k (commands:run checks:insert 1 "k "))
#<edit 1>
> (logged "~/k.txt" 4)
(undo-history group saved at)
> (list (commands:run kill k) (commands:run kill n) asked)
(#t #f ("Buffer n.txt has unsaved text; kill anyway? "))
; undo:forget! drops a buffer's history and so its log.
> (undo:forget! r)
> (wait-until (lambda () (not (checks:exists? (checks:log-of "~/r.txt")))))
> (checks:exists? (checks:log-of "~/r.txt"))
#f
> (in-r checks:insert 1 "4 ")
#<edit 4>
> (logged "~/r.txt" 3)
(undo-history group at)
; The log rebuilds unsaved edits from a saved state, so a history with
; none keeps the buffer's edits from no log, and C-x C-c asks about it.
> (list (buffers:modified? r) (cadr (undo:history r)) (exists (lambda (entry) (entry r)) (hook-entries files:unsaved-kept)))
(#t #f #f)
> (checks:write-text! "~/l.txt" "limit\n")
> (define l (files:visit "~/l.txt"))
> (buffers:with-buffer l (set-option-local! undo:limit 100))
> (buffers:replace! l 1 1 (make-string 200 #\x))
#<edit 1>
! (undo) undo:limit: an edit group is larger than the limit, so the buffer's history starts again with irritant "l.txt"
> (list (buffers:modified? l) (cadr (undo:history l)) (exists (lambda (entry) (entry l)) (hook-entries files:unsaved-kept)))
(#t #f #f)
; Reloading this plugin alone writes no log for a buffer that had none
; until its history holds a group, and then with the saved state, from
; which the next visit rebuilds the edits.
> (checks:write-text! "~/f.txt" "fresh\n")
> (define f (files:visit "~/f.txt"))
> (reload! "undo-log")
> (sleep-for 0.2)
> (checks:exists? (checks:log-of "~/f.txt"))
#f
> (buffers:replace! f 1 1 "x")
#<edit 1>
> (logged "~/f.txt" 4)
(undo-history group saved at)
; Nor does it rebuild edits made while the buffer kept no log, as it has
; no saved state for them, so C-x C-c asks about them.
> (set-option! undo-log:keep-log? (lambda (path) (not (string=? (path-extension path) "nolog"))))
> (checks:write-text! "~/m.nolog" "missed\n")
> (define m (files:visit "~/m.nolog"))
> (buffers:replace! m 1 1 "x")
#<edit 1>
> (set-option! undo-log:keep-log? (lambda (path) #t))
> (reload! "undo-log")
> (sleep-for 0.2)
> (list (buffers:modified? m) (cadr (undo:history m)) (exists (lambda (entry) (entry m)) (hook-entries files:unsaved-kept)))
(#t 0 #f)
