; A session at point in a prompt, as M-: has, is drawn by the popup,
; anchored in the prompt's part, and the list leaves the prompt as it is.
> (define (prompt-words)
    (let ([p (minibuffer:current-prompt)])
      (and p (eq? (views:current) (minibuffer:prompt-view p))
           (completion:region (minibuffer:input-start p) (views:point (views:current))
             (list (completion:source (candidates (vector "alpha" "almond"))))))))
> (add-hook! completion:find-region prompt-words)
> (define t (start! (lambda () (minibuffer:read "Eval: " #f))))
