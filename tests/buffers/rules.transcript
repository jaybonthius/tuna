; A buffer whose only node is its root takes a shorter way to its stops;
; it finds the stops that the same text has before another node, away
; from that node.
> (define (stop-answers b n)
    (map (lambda (p) (list (buffers:stop b p) (buffers:next-stop b p) (buffers:previous-stop b p))) (iota n)))
> (define (random-text n)
    (list->string (map (lambda (i) (string-ref "ab \n" (random 4))) (iota n))))
> (random-seed 5)
> (for-all
    (lambda (k)
      (let* ([text (random-text (random 30))]
             [atom (vector 'document:raw-byte '((byte . 200)))]
             [bare (fresh (list 'buffers:text '() text atom text))]
             [other (fresh (list 'buffers:text '() text atom text '(md:link ())))]
             [n (max 0 (- (document:length (buffers:document bare)) 3))])
        (equal? (stop-answers bare n) (stop-answers other n))))
    (iota 50))
#t
; An edit that replaces nothing by nothing is an edit, and moves nothing.
> (define e (fresh "abc\n"))
> (define e-anchor (buffers:anchor-after e 2))
> (buffers:replace! e 2 2 "")
#<edit 1>
> (list (buffers:version e) (buffers:anchor-position e-anchor))
(1 2)
; Replacing a million rows by a new set's moves every position inside
; them to the start; replacing them by the same rows moves none.
> (define (rows generation n)
    (document:repeat (document:from-datum (vector 'row (list (cons 'generation generation)))) n))
> (define listing (fresh (document:replace (document:from-datum '(buffers:text ())) 1 1 (rows 1 1000000))))
> (define new-set (buffers:splice! listing 1 1000001 (rows 2 1000000)))
> (list (buffers:edit-moves? new-set) (buffers:map-position listing 500001 0))
(#t 1)
> (define same-set (buffers:splice! listing 1 1000001 (rows 2 1000000)))
> (list (buffers:edit-moves? same-set) (buffers:map-position listing 500001 1))
(#f 500001)
