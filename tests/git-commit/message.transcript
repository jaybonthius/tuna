> (define repo (fresh! "repo"))
> (sh "cd repo && git config user.name Tuna && git config user.email tuna@example.org")
> (define (log) (git-out "repo" "log" "--format=%s"))
> (define (editing?) (equal? (shown-buffer) "COMMIT_EDITMSG"))
> (define (message!) (wait-until editing?) (take-said!) (views:buffer (view)))
> (define (message-lines m) (let loop ([t (document:text (buffers:document m))] [i 0] [start 0] [acc '()]) (cond [(= i (string-length t)) (reverse acc)] [(char=? (string-ref t i) #\newline) (if (and (< start i) (char=? (string-ref t start) #\#)) (reverse acc) (loop t (+ i 1) (+ i 1) (cons (substring t start i) acc)))] [else (loop t (+ i 1) start acc)])))
; git-commit:mode-hook runs in each message buffer as it opens.
> (define (set-message! m text)
    (let* ([t (document:text (buffers:document m))]
           [end (let loop ([i 0]) (if (or (= i (string-length t)) (char=? (string-ref t i) #\#)) i (loop (+ i 1))))])
      (buffers:replace! m 1 (+ end 1) text)))
> (define hooked 0)
> (add-hook! git-commit:mode-hook (lambda () (set! hooked (+ hooked 1))))
; C-c C-k cancels: the view shows the status buffer, the message
; is saved, and the cancel is no Git error.
> (press! "c" "c")
> (define m (message!))
> hooked
1
> (buffers:replace! m 1 1 "First draft\n")
#<edit 1>
> (press! "C-c" "C-k")
> (settle!)
> (list (shown-buffer) (take-said!) (car (git-commit:messages)) (git:command-canceled? (car (reverse (git:commands repo)))))
