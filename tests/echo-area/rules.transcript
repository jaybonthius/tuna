; A message shows until the next typed key from any client, which clears
; it before its command runs, so the command's own message shows.
> (define seen 'none)
> (commands:define-command (peek) "Notes the message as the command starts." (set! seen (echo-area:current-message)))
> (commands:define-command (say) "Says hello." (echo-area:message! "Hello"))
> (keys:bind! keys:global "C-c p" peek)
> (keys:bind! keys:global "C-c s" say)
> (echo-area:message! "First")
> (press-in! other-client "C-c" "p")
> (list seen (echo-area:current-message))
> (press! "C-c" "s")
> (echo-area:current-message)
; A click does not clear it.
