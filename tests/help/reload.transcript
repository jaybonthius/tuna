; help:keymap is on C-h; C-h e stays the echo area's.
> (map (lambda (keys) (commands:command-name (keys:lookup client keys))) '("C-h k" "C-h f" "C-h v" "C-h o" "C-h a" "C-h e"))
(help:describe-key help:describe-name help:describe-name help:describe-name help:apropos-command echo-area:show-messages)
> (eq? (keys:lookup client "C-h") help:keymap)
#t
; *Help* draws as a div.help with its title, keys and links.
> (define notes (buffers:make "notes" "one\n"))
> (layout:switch-to-buffer notes)
> (in-client (lambda () (help:describe-key "C-x C-f" (view))))
> (let ([html (html->string (views:draw (help-view) client))])
    (map (lambda (s) (contains? html s))
         '("<div class=\"help\">" "<div class=\"help-title\" role=\"heading\" aria-level=\"1\">" "<div class=\"help-text\">" "<kbd class=\"help-key\">"
           "<button class=\"ui-link\" type=\"button\" tabindex=\"-1\">")))
(#t #t #t #t #t)
> (in-client (lambda () (help:describe-bindings (view))))
> (let ([html (html->string (views:draw (help-view) client))])
    (map (lambda (s) (contains? html s)) (quote ("<div class=\"help-heading\" role=\"heading\" aria-level=\"2\">" "<div class=\"help-bindings\">"))))
(#t #t)
> (assq 'help (table-entries web:stylesheets))
(help . "help/help.css")
; Unloading help takes back its keys, its advice and its stylesheet, and
; leaves *Help*; loading it again finds *Help* and starts with no
; history.
> (unload-module! '(help))
> (list (commands:command? (keys:lookup client "C-h k")) (assq 'help (table-entries web:stylesheets))
        (map car (definition-changes keys:undefined)))
(#f #f ((keys)))
> (press! "C-x" "C-h")
! C-x C-h is undefined
> (buffers:live? (buffers:find "*Help*"))
#t
> (load-module! '(help))
> (press! "C-x" "C-h")
> (title)
"Key bindings starting with C-x"
> (layout:select! (help-view))
> (press! "l")
! help:back: no earlier description
