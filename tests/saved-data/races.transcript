; Sets from many threads at once: each file comes to hold its datum's
; last value, and a datum set by them all holds one thread's last.
> (import (testing))
> (define (stored name)
    (let ([file (string-append (getenv "HOME") "/.local/share/tuna/saved/user/repl/" name ".ss")])
      (and (file-exists? file) (guard (c [#t #f]) (call-with-input-file file read)))))
> (saved:define-saved each-0 0 fixnum?)
> (saved:define-saved each-1 0 fixnum?)
> (saved:define-saved each-2 0 fixnum?)
> (saved:define-saved each-3 0 fixnum?)
> (saved:define-saved shared '() list?)
> (define each (list each-0 each-1 each-2 each-3))
> (for-each (lambda (t) (join-task t) (void))
    (map (lambda (s i)
           (fork-task
             (lambda (restore)
               (do ([n 0 (+ n 1)]) ((= n 300))
                 (saved:set! s n)
                 (saved:set! shared (list i n))))))
         each (iota 4)))
> (testing:wait-until (lambda () (equal? (map stored '("each-0" "each-1" "each-2" "each-3")) '(299 299 299 299))))
> (testing:wait-until (lambda () (equal? (stored "shared") (shared))))
> (cadr (shared))
299
; The file holds the value as it was when set, though it changes in place
; after.
> (saved:define-saved changed '() list?)
> (define v (list (string-copy "before") (vector 1)))
> (begin (saved:set! changed v) (string-set! (car v) 0 #\X) (vector-set! (cadr v) 0 2) (void))
> (testing:wait-until (lambda () (stored "changed")))
> (stored "changed")
("before" #(1))
; A reader never sees part of a file: it reads the old value whole or the
; new one whole.
> (saved:define-saved big '() list?)
> (define reading #t)
> (define partial 0)
> (define reads 0)
> (define reader
    (fork-task
      (lambda (restore)
        (let loop ()
          (when reading
            (let ([v (stored "big")])
              (when v
                (set! reads (+ reads 1))
                (unless (and (list? v) (= (length v) 5000) (for-all (lambda (s) (equal? s (car v))) v))
                  (set! partial (+ partial 1)))))
            (loop))))))
> (do ([n 0 (+ n 1)]) ((= n 40))
    (saved:set! big (make-list 5000 (format "version ~a" n)))
    (timers:sleep 0))
> (testing:wait-until (lambda () (equal? (stored "big") (big))))
> (begin (set! reading #f) (join-task reader) (list (> reads 0) partial))
(#t 0)
; Shared structure is written once and read back shared: printed in full,
; this value would take 2^40 conses.
> (saved:define-saved deep '() list?)
> (saved:set! deep (let loop ([i 0] [x '()]) (if (= i 40) x (loop (+ i 1) (cons x x)))))
> (testing:wait-until (lambda () (stored "deep")))
> (let ([back (stored "deep")]) (eq? (car back) (cdr back)))
#t
