; Revert replaces only the part that differs, as one edit; anchors
; outside it stay.
> (disk-checks:write-text! "~/rev.txt" "one\ntwo\nthree\n")
> (define rev (files:visit "~/rev.txt"))
> (define before (buffers:anchor rev 2))
> (define after (buffers:anchor rev 12))
> (disk-checks:write-text! "~/rev.txt" "one\nTWO!\nthree\n")
> (buffers:replace! rev 1 1 "")
#<edit 1>
> (files:revert-buffer rev)
> (list (text rev) (buffers:version rev) (buffers:modified? rev))
("one\nTWO!\nthree\n" 2 #f)
> (map buffers:edit-start (buffers:edits-since rev 1))
(5)
> (list (buffers:anchor-position before) (buffers:anchor-position after))
(2 13)
> (files:revert-buffer rev)
> (buffers:version rev)
2
> (disk-checks:write-bytes! "~/rev.txt" #vu8(111 110 101 13 10 233 13 10))
> (files:revert-buffer rev)
> (list (string=? (text rev) "one\n\xFFFC;\n") (bytes-of rev))
(#t #vu8(111 110 101 13 10 233 13 10))
> (buffers:replace! rev 1 1 "#")
#<edit 4>
