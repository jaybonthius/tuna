; files:directory asks files:directory-finders by depth; files' own
; entry, at -10, answers a file buffer with its file's folder, and a
; buffer no entry answers has the home folder.
> (for-each (lambda (f) (mkdir (string-append (getenv "HOME") f))) '("/src" "/src/d" "/src/e"))
> (disk-checks:write-text! "~/src/d/a.txt" "a\n")
> (define a (files:visit "~/src/d/a.txt"))
> (define plain (buffers:make "plain" "text\n"))
> (map files:directory (list a plain))
("$HOME/src/d/" "$HOME/")
> (list (files:file-directory a) (files:file-directory plain))
("$HOME/src/d/" #f)
; An entry that answers for a buffer that visits no file gives it a
; folder; one placed before files' own, as a folder set by hand would
; be, gives a file buffer another.
> (define chosen (make-eq-hashtable))
> (define (chosen-folder b) (eq-hashtable-ref chosen b #f))
> (hooks:add! files:directory-finders chosen-folder -20)
> (eq-hashtable-set! chosen plain "/tmp")
> (eq-hashtable-set! chosen a "/srv/elsewhere/")
> (map files:directory (list a plain))
("/srv/elsewhere/" "/tmp/")
> (hooks:remove! files:directory-finders chosen-folder)
> (map files:directory (list a plain))
("$HOME/src/d/" "$HOME/")
> (define (nowhere b) 'nowhere)
> (hooks:add! files:directory-finders nowhere)
> (files:directory plain)
! files:directory: a directory finder returned no absolute folder with irritant nowhere
> (hooks:remove! files:directory-finders nowhere)
; A folder that does not start with / is refused at the finder that gave
; it, as the override refuses one, since commands hand it on as absolute.
> (define (relative b) "~/src/")
> (hooks:add! files:directory-finders relative)
> (files:directory plain)
! files:directory: a directory finder returned no absolute folder with irritant "~/src/"
> (hooks:remove! files:directory-finders relative)
; files:directory-override, bound with options:with, gives one buffer a
; folder for what runs inside it, before any entry; another buffer, and
; a file visited inside it, keep their own.
> (disk-checks:write-text! "~/src/e/b.txt" "b\n")
> (define seen #f)
> (define (note-folder b) (set! seen (files:directory)))
> (hooks:add! files:after-visit note-folder)
> (define b #f)
> (options:with ([files:directory-override (cons a "/srv/project")])
    (set! b (files:visit "~/src/e/b.txt"))
    (list (files:directory a) (files:directory plain) (files:directory b)))
("/srv/project/" "$HOME/" "$HOME/src/e/")
> seen
"$HOME/src/e/"
> (files:directory a)
"$HOME/src/d/"
> (options:with ([files:directory-override (cons a "relative/")]) (files:directory a))
! options:with: (#<buffer a.txt> . "relative/") is not a valid value for files:directory-override
> (options:with ([files:directory-override "/srv"]) (files:directory a))
! options:with: "/srv" is not a valid value for files:directory-override
