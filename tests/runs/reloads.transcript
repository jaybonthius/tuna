; An own run stops when its owner unloads: it ends stopped, with its
; footer and entries.
> (import (starter))
> (define own (starter:own!))
> (testing:wait-until (lambda () (string=? (output own) "own\n")))
> (unload-owner! (module-owner '(starter)))
> (list (runs:status own) (taken-ends))
(stopped (("*own*" stopped stopped)))
; The owner's next instance gets an unload action of its own.
> (load-module! '(starter))
#<owner (starter) 2>
> (define own-again (starter:own!))
> (testing:wait-until (lambda () (string=? (output own-again) "own\n")))
> (unload-owner! (module-owner '(starter)))
> (list (runs:status own-again) (taken-ends))
(stopped (("*own*" stopped stopped)))
; The user's run goes on across a reload of the module that started it,
; and of runs, and its output still arrives.
> (load-module! '(starter))
#<owner (starter) 3>
> (define users (starter:users!))
> (testing:wait-until (lambda () (string=? (output users) "users\n")))
> (reload-modules! '((starter)))
> (reload! "runs")
> (runs:status users)
#f
> (with-output-to-file (string-append (getenv "HOME") "/go") void)
> (ended? users)
0
> (output users)
"users\nlater"
; A renamed going run keeps its buffer across a reload of runs.
> (define going (runs:start-for-user "*going*" "echo a; until [ -e went ]; do sleep 0.05; done; echo b" home))
> (testing:wait-until (lambda () (string=? (output going) "a\n")))
> (buffers:rename! going "renamed going")
> (reload! "runs")
> (runs:status going)
#f
> (with-output-to-file (string-append (getenv "HOME") "/went") void)
> (ended? going)
0
> (list (buffers:name going) (output going))
("renamed going" "a\nb")
; A renamed ended run keeps g, its command and its status across a
; reload of processes, which reloads runs.
> (buffers:rename! going "renamed ended")
> (reload! "processes")
> (list (runs:command going) (runs:status going))
("echo a; until [ -e went ]; do sleep 0.05; done; echo b" 0)
> (runs:run-again going)
#<buffer renamed ended>
> (ended? going)
0
> (output going)
"a\nb"
; Renamed while runs is off, a run keeps its buffer; a plain buffer made
; under its old name stays plain.
> (define old (runs:start-for-user "*old*" "echo old" home))
> (ended? old)
0
> (unload-owner! (module-owner '(runs)))
> (buffers:rename! old "*old, renamed*")
> (define plain (buffers:make "*old*" "plain\n"))
> (load-module! '(runs))
#<owner (runs) 5>
> (list (runs:command old) (runs:run-buffer? plain) (text plain))
("echo old" #f "plain\n")
> (taken-ends)
(("*users*" 0 0) ("renamed going" 0 0) ("renamed ended" 0 0) ("*old*" 0 0))
