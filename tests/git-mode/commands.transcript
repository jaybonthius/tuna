; ?, h and C-c C-c show the dispatch menu, one entry per Git
; menu and the commands that act on changes.
> (press! "?")
> (menu)
("Transient and dwim commands" ("Essential commands" ("g" "Refresh current buffer") ("q" "Bury current buffer") ("TAB" "Toggle section at point") ("RET" "Visit thing at point")) (("I" "Init") ("c" "Commit") ("f" "Fetch") ("F" "Pull") ("P" "Push")) ("Applying changes" ("s" "Stage") ("u" "Unstage") ("k" "Discard") ("S" "Stage all") ("U" "Unstage all")))
