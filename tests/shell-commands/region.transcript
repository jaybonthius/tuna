; M-| runs the line once per cursor's region, with the region as input:
; the outputs show as M-!'s, and with a prefix argument each replaces its
; own region, in one undo group.
> (define notes (buffers:make "notes" "c\nb\na\n"))
> (layout:switch-to-buffer notes)
> (views:set-point! (view) 1)
> (press! "C-SPC" "M->")
> (run! shell-commands:shell-command-on-region "sort" #f)
> (text (buffers:find "*Shell Command Output*"))
"a\nb\nc\n"
> (layout:switch-to-buffer notes)
> (views:set-point! (view) 1)
> (press! "C-SPC" "M->")
> (run! shell-commands:shell-command-on-region "sort" '(4))
> (text notes)
"a\nb\nc\n"
> (define (regions! b . ranges)
    (layout:switch-to-buffer b)
    (views:set-cursor! (car (views:cursors (view))) (cadar ranges) (caar ranges))
    (for-each (lambda (r) (views:set-cursor! (views:add-cursor! (view) (cadr r)) (cadr r) (car r))) (cdr ranges))
    (map (lambda (c) (list (views:cursor-mark c) (views:cursor-point c))) (views:cursors (view))))
> (define words (buffers:make "words" "one two three\n"))
> (regions! words '(1 4) '(5 8) '(9 14))
((1 4) (5 8) (9 14))
> (run! shell-commands:shell-command-on-region "tr a-z A-Z" '(4))
> (list (text words) (map (lambda (c) (list (views:cursor-mark c) (views:cursor-point c))) (views:cursors (view))))
("ONE TWO THREE\n" ((#f 4) (#f 8) (#f 14)))
> (press! "C-/")
> (text words)
"one two three\n"
; A cursor with no mark stops the command before any program runs.
> (define unmarked (buffers:make "unmarked" "text\n"))
> (layout:switch-to-buffer unmarked)
> (run! shell-commands:shell-command-on-region "touch ran" #f)
! shell-commands:shell-command-on-region: the mark is not set, so there is no region
> (file-exists? (at "ran"))
#f
; With a prefix argument every region is asked first whether it takes
; text, so in a buffer that refuses the programs never run.
> (define ended-run (runs:start-for-user "*ended*" "echo some output"))
> (ended? ended-run)
0
> (regions! ended-run '(1 5))
((1 5))
> (run! shell-commands:shell-command-on-region "touch $HOME/ran; tr a-z A-Z" '(4))
! shell-commands:shell-command-on-region: the buffer refuses the output with irritant "*ended*"
> (file-exists? (at "ran"))
#f
; The regions are anchors, so text typed before them while the programs
; run moves the replacements with it.
> (define typed (buffers:make "typed" "xx aaa bbb\n"))
> (regions! typed '(4 7) '(8 11))
((4 7) (8 11))
> (define task (spawn-task (lambda () (in-client (lambda () (commands:run shell-commands:shell-command-on-region "until [ -e go ]; do sleep 0.05; done; tr a-z A-Z" '(4)))))))
> (settle)
> (buffers:insert! typed 1 "zz")
3
> (with-output-to-file (at "go") void)
> (testing:wait-until (lambda () (string=? (text typed) "zzxx AAA BBB\n")))
> (text typed)
"zzxx AAA BBB\n"
; C-g during the second of three runs replaces nothing.
> (define three (buffers:make "three" "aa bb cc\n"))
> (regions! three '(1 3) '(4 6) '(7 9))
((1 3) (4 6) (7 9))
> (start! "C-u" "M-|")
> (type! "if [ -e seen ]; then sleep 30; else touch seen; fi; tr a-z A-Z")
> (press! "RET")
> (testing:wait-until (lambda () (file-exists? (at "seen"))))
> (settle)
> (press! "C-g")
! &quit
> (settle)
> (list (text three) (filter (lambda (p) (exists (lambda (a) (search a "sleep 30" 0)) (processes:command-line p))) (processes:all)))
("aa bb cc\n" ())
; With the region a rectangle, M-| takes each cursor's input from
; editing:extract-region, the rectangle's lines with a final line break,
; and with a prefix argument deletes the rectangle and puts the output's
; lines back through editing:insert-region!, so what is replaced is the
; region drawn, as Emacs does for a region of several ranges.
> (import (rectangle))
> (rectangle:on!)
> (define column (buffers:make "column" "xa1\nxb2\nxc3\n"))
> (regions! column '(2 11))
((2 11))
> (views:region-bounds (view))
((2 . 3) (6 . 7) (10 . 11))
> (run! shell-commands:shell-command-on-region "sort -r" #f)
> (text (buffers:find "*Shell Command Output*"))
"c\nb\na\n"
> (regions! column '(2 11))
((2 11))
> (run! shell-commands:shell-command-on-region "sort -r" '(4))
> (list (text column) (map (lambda (c) (list (views:cursor-mark c) (views:cursor-point c))) (views:cursors (view))))
("xc1\nxb2\nxa3\n" ((#f 11)))
> (press! "C-/")
> (text column)
"xa1\nxb2\nxc3\n"
> (rectangle:off!)
