> (define pair (map join-task (map (lambda (p) (spawn-task (lambda () (files:visit p)))) '("~/p/same.txt" "~/q/same.txt"))))
> (map buffers:name pair)
("same.txt<p>" "same.txt<q>")
; Saves of one buffer take turns, so the second does not mistake the
; first's write for another program's.
> (define one (car visited))
> (buffers:replace! one 1 1 "a")
#<edit 1>
> (define savers
    (list (spawn-task (lambda () (files:save-buffer one)))
          (spawn-task (lambda () (buffers:replace! one 1 1 "b") (files:save-buffer one)))
          (spawn-task (lambda () (files:save-buffer one)))))
> (for-each join-task savers)
> (list (disk-checks:read-text "~/one.txt") (buffers:modified? one))
("baone\n" #f)
; A key typed while the job writes leaves the buffer modified: files
; records the version the job wrote. The before-save entry queues the
; edit, which runs while the save waits for its job.
> (define (type-meanwhile b) (spawn-task (lambda () (buffers:replace! b 1 1 "typed "))))
> (add-hook! files:before-save type-meanwhile)
> (buffers:replace! one 1 1 "c")
#<edit 3>
> (files:save-buffer one)
> (list (disk-checks:read-text "~/one.txt") (text one) (buffers:modified? one))
("cbaone\n" "typed cbaone\n" #t)
> (remove-hook! files:before-save type-meanwhile)
; A save whose waiting task is signalled is still recorded, so the next
; save sees no change on disk.
> (define (signal-saver b) (let ([saver (current-task)]) (spawn-task (lambda () (signal-task saver 'stopped)))))
> (add-hook! files:before-save signal-saver)
> (guard (c [(symbol? c) c]) (files:save-buffer one))
stopped
> (remove-hook! files:before-save signal-saver)
> (wait-until (lambda () (not (buffers:modified? one))))
> (list (buffers:modified? one) (disk-checks:read-text "~/one.txt"))
(#f "typed cbaone\n")
