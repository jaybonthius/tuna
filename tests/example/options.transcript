; Each form's basic use.
> (options:define-option column 70 fixnum? "Width of filled lines.")
> (column)
70
> (options:with ([fill:column 100]) (fill:column))
100
> (options:settings fill:column)
(((init) 80) ((prog) 90))
> (options:set! fill:column 80 spell:language "en-GB")
> (fill:column)
80
> (scopes:current (scopes:make))
> (import (corfu))
> (options:set-local! corfu:auto #t corfu:auto-delay 0.1)
> (list (corfu:auto) (corfu:auto-delay))
(#t 0.1)
> (scopes:current #f)
; The configuration's setting wins over a module's, and a module's is in
; effect when the configuration has none.
> (list (fill:column) (corfu:auto-delay) (spell:language) (files:autosave-seconds))
(80 0.2 "en-GB" 30)
; The configuration's mode hook sets a local value, which options:with
; binds over.
> (define s (scopes:make))
> (scopes:current s)
> (prog:mode)
> (fill:column)
100
> (options:with ([fill:column 60]) (fill:column))
60
; A binding wins in every scope, and a setting or local value made inside
; it takes effect when it ends.
> (options:with ([fill:column 61])
    (scopes:current #f)
    (options:set! fill:column 75)
    (list (fill:column) (begin (scopes:current s) (fill:column))))
(61 61)
> (fill:column)
100
> (scopes:current #f)
> (fill:column)
75
> (options:settings fill:column)
(((repl) 75) ((init) 80) ((prog) 90))
; A binding holds on its own thread only: a thread forked in options:with
; starts with no bindings and reads the setting.
> (options:with ([fill:column 62])
    (let ([v #f]) (join-task (fork-task (lambda (restore) (set! v (fill:column))))) (list (fill:column) v)))
(62 75)
> (let ([v #f]) (join-task (fork-task (lambda (restore) (set! v (fill:column))))) v)
75
; options:changed and on-change see each new value once.
> (define changed '())
> (hooks:add! options:changed (lambda (o v) (set! changed (cons (list (eq? o fill:column) v) changed))))
> (options:set! fill:column 76)
> (options:set! fill:column 76)
> changed
((#t 76))
> (define seen '())
> (options:define-option width 10 fixnum? #f (lambda (v) (set! seen (cons (list v (scopes:current)) seen))))
> (options:set! width 12)
> (options:set! width 12)
> (options:unset! width)
> seen
((10 #f) (12 #f))
> (scopes:current s)
> (options:set-local! width 14)
> (eq? (cadar seen) s)
#t
> (options:unset-local! width)
> (map car seen)
(10 14 10 12)
> (scopes:current #f)
; A raise from on-change goes to report, and the setting stays.
> (options:define-option height 1 fixnum? #f (lambda (v) (error 'height "no")))
> (options:set! height 2)
! height: no
> (height)
2
; Evaluating options:define-option again keeps the settings.
> (options:define-option height 1 fixnum? "Rows.")
> (height)
2
; Evaluating it again with another check takes back each setting and
; local value the new check rejects, with a warning; a check that raises
; rejects the value.
> (options:define-option size 5 fixnum?)
> (options:set! size 9)
> (call-as-owner (module-owner '(corfu)) (lambda () (options:set! size 4)))
> (scopes:current s)
> (options:set-local! size 8)
> (scopes:current #f)
> (options:define-option size 5 (lambda (v) (and (fixnum? v) (< v 6))))
! options:define-option: the setting 9 of size made by (repl) fails its check; it is taken back
! options:define-option: the local value 8 of size made by (repl) fails its check; it is taken back
> (list (size) (options:settings size) (begin (scopes:current s) (size)))
(4 (((corfu) 4)) 4)
> (scopes:current #f)
> (options:define-option size 5 (lambda (v) (if (eqv? v 4) (error 'size "four") #t)))
! options:define-option: the setting 4 of size made by (corfu) fails its check; it is taken back
> (list (size) (options:settings size))
(5 ())
; Values are checked, every one before any is stored.
> (options:set! fill:column "wide")
! options:set!: "wide" is not a valid value for fill:column
> (options:set! fill:column 77 spell:language 'en)
! options:set!: en is not a valid value for spell:language
> (fill:column)
76
> (guard (c [#t (condition-message c)]) (options:set! fill:column))
"an option without a value"
> (options:with ([fill:column 'wide]) (fill:column))
! options:with: wide is not a valid value for fill:column
> (options:define-option "width" 1 fixnum?)
! options:define-option: invalid syntax (options:define-option "width" 1 fixnum?)
> (options:define-option depth 'deep fixnum?)
! options:define-option: the default deep is not a valid value for depth
> (options:set! car 1)
! options:set!: not an option with irritant #<procedure car>
; parameterize refuses an option.
> (parameterize ([fill:column 3]) (fill:column))
! fill:column: an option is bound with options:with, not parameterize
> (fill:column)
76
; options:default and options:setting ignore bindings and scopes.
> (scopes:current s)
> (options:with ([fill:column 1])
    (list (options:default fill:column) (options:setting fill:column) (fill:column)))
(70 76 1)
; Removing takes back only the current owner's setting or local value.
> (options:unset! fill:column)
> (fill:column)
100
> (scopes:current #f)
> (fill:column)
80
> (options:unset-local! fill:column)
! options:unset-local!: the current scope is #f
> (options:set-local! fill:column 1)
! options:set-local!: the current scope is #f
> (list (options:option? fill:column) (options:option? files:save!) (options:option? 1))
(#t #f #f)
; Naming an option twice in one call notifies once, of the value in effect.
> (options:define-option twice 1 fixnum? #f (lambda (v) (display (list 'changed v))))
> (options:set! twice 2 twice 3)
(changed 3)
> (twice)
3
> (options:unset! twice)
(changed 1)
; Either the configuration or the REPL evaluating the other's
; options:define-option keeps the settings.
> (import (plugins))
> (call-as-owner (plugins:configuration-owner) (lambda () (plugins:eval-form '(options:define-option shared-width 1 fixnum?))))
> (options:set! shared-width 5)
> (options:define-option shared-width 1 fixnum?)
> (shared-width)
5
> (call-as-owner (plugins:configuration-owner) (lambda () (plugins:eval-form '(options:define-option shared-width 1 fixnum?))))
> (shared-width)
5
; A cancel ends the task that runs on-change or an options:changed entry
; while a change is taken back, by removing it or by unloading the module
; that made it, and the change is still taken back.
> (define looping? #f)
> (import (testing))
> (define (loop-until-quit . _) (when looping? (testing:request-quit!) (let loop () (loop))))
> (options:define-option patient 1 fixnum? #f loop-until-quit)
> (hooks:add! options:changed loop-until-quit)
> (options:set! patient 2)
> (set! looping? #t)
> (options:unset! patient)
! &cancelled
> (set! looping? #f)
> (call-as-owner (module-owner '(corfu)) (lambda () (options:set! patient 3)))
> (set! looping? #t)
> (unload-owner! (module-owner '(corfu)))
! (owned) &cancelled
> (set! looping? #f)
> (list (patient) (options:settings patient))
(1 ())
