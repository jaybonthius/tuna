((ring #<owner (repl) 1> #t))
> (list (timers:live) (owner-changes (plugins:repl-owner)))
(() ())
> (call-as-owner (plugins:configuration-owner) (lambda () (timers:run-after 0 ring)))
#<timer>
> (timers:sleep 0.1)
> (car log)
(ring #<owner (init) 1> #t)
; A repeating timer runs every repeat seconds until it is cancelled.
> (define runs 0)
> (define repeating #f)
> (begin
    (set! repeating (timers:run-after 0.2 (lambda () (set! runs (+ runs 1))) 0.2))
    (timers:sleep 0.5)
    runs)
2
> (timers:cancel! repeating)
> (timers:sleep 0.3)
> (list runs (timers:live) (owner-changes (plugins:repl-owner)))
(2 () ())
; A repeat that falls behind runs once, then keeps its rhythm.
> (define behind-runs 0)
> (define behind #f)
> (begin
    (set! behind (timers:run-after 0.3 (lambda () (set! behind-runs (+ behind-runs 1))) 0.3))
    (chez:sleep (make-time 'time-duration 0 1)))
> behind-runs
1
> (timers:sleep 0.3)
> behind-runs
2
> (timers:cancel! behind)
; A timer cancelled before it runs never runs, even once its run is
; waiting on the main thread.
> (set! log '())
> (timers:cancel! (timers:run-after 0.05 (lambda () (note! 'cancelled))))
> (let ([t (timers:run-after 0 (lambda () (note! 'cancelled-while-waiting)))])
    (chez:sleep (make-time 'time-duration 100000000 0))
    (timers:cancel! t))
> (timers:sleep 0.15)
> log
()
; A timer task that raises is reported, and the next runs.
> (define ticks 0)
> (begin
    (timers:run-after 0.05 (lambda () (error 'timer "failed")))
    (timers:run-after 0.1 (lambda () (set! ticks 1)))
    (timers:sleep 0.2))
! timer: failed
> ticks
1
; Unloading a module stops its timers, and reloading starts them afresh.
> (import (ticker))
> (timers:sleep 0.2)
> (> (ticker:count) 1)
#t
> (map car (owner-changes (module-owner '(ticker))))
(define)
> (define first-timer (car (timers:live)))
> (reload-modules! '((ticker)))
> (list (length (timers:live)) (eq? (car (timers:live)) first-timer))
(1 #f)
> (unload-owner! (module-owner '(ticker)))
