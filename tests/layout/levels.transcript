; The user's windows are notes.org and *pi*. A plugin places the echo
; area at the bottom and another an explorer on the left; the first
; placement wraps the user's windows in a level, M, and both parts sit
; outside it.
> (define c1 (web:add-client! 1))
> (define (search text needle from)
    (let ([n (string-length needle)])
      (let loop ([i from])
        (cond
          [(> (+ i n) (string-length text)) #f]
          [(string=? (substring text i (+ i n)) needle) i]
          [else (loop (+ i 1))]))))
