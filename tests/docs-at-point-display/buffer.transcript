; Where no source answers, C-h . shows *Docs* empty; making *Docs* again
; calls docs-mode-hook in it.
> (remove-hook! docs-at-point:sources faced)
> (define made '())
> (add-hook! docs-at-point-display:docs-mode-hook (lambda () (set! made (cons (buffers:name (buffers:current)) made))))
