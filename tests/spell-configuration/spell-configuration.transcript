; At start-up, spell is installed from another source than its line's, a
; copy put in place by hand, so the line installs it first and says so.
; The configuration then overrides and sets spell's definitions, with no
; other report.
! import: replaced ~/.local/share/tuna/plugins/spell, installed from another source or commit than its line's
> (list (spell:dictionary-path) (spell:language))
("/home/groucho/words" "en-GB")
> (plugin-commit 'spell)
"8f4a7345babf351f103b3a03a5d290d170e5e95e"
> (define (spell:check path) "mine")
! define: spell:check is (spell)'s definition; override it with (set! spell:check value)
; A changed commit does not touch the loaded plugin; the next lookup of its
; modules installs it.
> (import (tuna eval))
> (define (replace-commit! text)
    (let* ([file "~/.config/tuna/init.ss"]
           [old (call-with-input-file file get-string-all)]
           [at (let loop ([i 0]) (if (string=? (substring old i (+ i 7)) "8f4a734") i (loop (+ i 1))))])
      (call-with-output-file file
        (lambda (p) (put-string p (string-append (substring old 0 at) text (substring old (+ at 7) (string-length old)))))
        'replace)))
> (replace-commit! "624c303")
> (eval-file "~/.config/tuna/init.ss")
> (plugin-commit 'spell)
"8f4a7345babf351f103b3a03a5d290d170e5e95e"
> (unload-module! '(spell))
> (load-module! '(spell))
! import: replaced ~/.local/share/tuna/plugins/spell, installed from another source or commit than its line's
> (plugin-commit 'spell)
"624c3038631852c7011bc1be6dfb1aed74fd271a"
