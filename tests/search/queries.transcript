; A query records its rules when it is made: its case rule from
; search:case-fold, its whitespace rule from the lax options by style.
> (define b (text-buffer "q" "Vector vector-ref  vector\tref (car x)\n"))
> (define q (search:make-query "vector-ref"))
> (list (search:query-text q) (search:query-case q) (search:query-spaces q) (search:query-filter q))
("vector-ref" smart lax #f)
> (search:query-spaces (search:make-query "a b" search:regexp))
literal
> (search:make-query "(define|lambda)\\b" search:regexp (search:case exact))
#<query regexp "(define|lambda)\\b">
> (with-options ([search:case-fold (search:case fold)]) (search:query-case (search:make-query "x")))
fold
> (search:make-query "x" search:literal 'loud)
! search:make-query: not a case rule with irritant loud
; The smart rule ignores case unless the text has a capital letter.
> (all-in b (search:make-query "vector "))
((1 8 "Vector ") (20 27 "vector\t"))
> (all-in b (search:make-query "Vector"))
((1 7 "Vector"))
> (all-in b (search:make-query "vector" search:literal (search:case exact)))
((8 14 "vector") (20 26 "vector"))
> (all-in b (search:make-query "VECTOR" search:literal (search:case fold)))
((1 7 "Vector") (8 14 "vector") (20 26 "vector"))
; In a regexp, only a capital the pattern matches counts: not one in an
; escape, an escape's argument, a group name, a reference, a verb or a
; comment; one in a class or \Q...\E does; and a case property or POSIX
; class makes the regexp exact.
> (define (smart? text) (= 3 (length (all-in b (search:make-query text search:regexp)))))
> (map smart? '("vector\\W" "v\\x{65}ctor" "v\\N{U+0065}ctor" "(?<Year>vector)\\k<Year>?" "(*UCP)vector" "vector(?#Note)"))
(#t #t #t #t #t #t)
> (map smart? '("[V]ector" "\\QVector\\E" "vector\\p{Ll}*" "vector[[:lower:]]*" "vector\\p{Lu}?" "[[:upper:]]?vector"))
(#f #f #f #f #f #f)
; Under lax, a run of spaces matches search:whitespace; a regexp's only
; outside brackets and before no quantifier.
> (all-in b (search:make-query "vector ref"))
((20 30 "vector\tref"))
> (all-in b (search:make-query "vector ref" search:literal (search:case smart) (search:spaces literal)))
()
> (all-in b (search:make-query "r  v" search:regexp (search:case smart) (search:spaces lax)))
((6 9 "r v"))
> (all-in b (search:make-query "[ ]+v" search:regexp (search:case smart) (search:spaces lax)))
((7 9 " v") (18 21 "  v"))
> (all-in b (search:make-query "ref +v" search:regexp (search:case smart) (search:spaces lax)))
((15 21 "ref  v"))
> (with-options ([search:regexp-lax-whitespace #t]) (search:query-spaces (search:make-query "a b" search:regexp)))
lax
; A query's own filter, and one added keeping the query's rules.
> (define (after-10? buffer start end) (> start 10))
> (define fq (search:make-query "vector" search:literal (search:case exact) (search:spaces literal) after-10?))
> (all-in b fq)
((20 26 "vector"))
> (define (before-20? buffer start end) (< start 20))
> (define both (search:query-with-filter (search:make-query "vector") before-20?))
> (list (search:query-case both) (search:query-spaces both) (all-in b both))
(smart lax ((1 7 "Vector") (8 14 "vector")))
> (all-in b (search:query-with-filter fq before-20?))
()
; The word style matches whole words, the symbol style whole symbols.
> (all-in b (search:make-query "vector" search:word))
((1 7 "Vector") (8 14 "vector") (20 26 "vector"))
> (all-in b (search:make-query "vector ref" search:word))
((8 18 "vector-ref") (20 30 "vector\tref"))
> (all-in b (search:make-query "vector" search:symbol))
((1 7 "Vector") (20 26 "vector"))
> (all-in b (search:make-query "vector-ref" search:symbol))
((8 18 "vector-ref"))
; A query whose text's end is still being typed asks no boundary after
; its last word, so a word in progress finds the words it starts.
> (all-in b (search:make-query "vec" search:symbol))
> (define typing (search:query-with-partial (search:make-query "vec" search:symbol)))
> (list (search:query-partial? typing) (all-in b typing))
> (all-in b (search:query-with-partial (search:make-query "vector re" search:word)))
> (search:query-partial? (search:query-with-filter typing (lambda (b s e) #t)))
> (map search:style-description (list search:literal search:regexp search:word search:symbol))
()
(#t ((1 4 "Vec") (8 11 "vec") (20 23 "vec")))
((8 17 "vector-re") (20 29 "vector\tre"))
#t
("" "Regexp" "Word" "Symbol")
; A style of one's own receives the text, whether its end is being typed,
; and the buffer's classes.
> (define (flex-pattern text partial? classes)
    (apply string-append
      (map (lambda (c) (string-append (search:regexp-quote (string c)) "[^\\n]*?"))
           (string->list text))))
> (define flex (search:make-style "Flex" flex-pattern))
> (all-in b (search:make-query "vrf" flex))
((1 18 "Vector vector-ref") (20 30 "vector\tref"))
> (search:regexp-quote "a.b*(c)")
"a\\.b\\*\\(c\\)"
; History: newest first, no copies, cut to its length, regexps apart.
> (with-options ([search:history-length 2])
    (for-each (lambda (t) (search:add-to-history! (search:make-query t))) '("one" "two" "one" "three"))
    (search:add-to-history! (search:make-query "a+" search:regexp))
    (list (search:history) (search:regexp-history) (search:prompt-regexp-history)))
(("three" "one") ("a+") ())
; A template's text for a match.
> (define m (search:find b (search:make-query "(\\w+)-(\\w+)" search:regexp) 0 forward))
> (search:expand b m "\\2-\\1 \\& \\# \\\\" 7)
"ref-vector vector-ref 7 \\"
> (search:match-group m 2)
> (search:expand b m "\\3" 0)
15
18
! search:expand: not a group of the match's pattern with irritant 3
> (search:expand b m "\\q" 0)
! search:expand: a backslash before neither &, #, \ nor a digit with irritant "\\q"
> (define g (search:find b (search:make-query "(x)|(car)" search:regexp) 0 forward))
> (search:expand b g "[\\1][\\2]" 0)
"[][car]"
; An invalid pattern raises with PCRE2's message and the offset, at its
; end for an unfinished one.
> (define (pattern-error text)
    (guard (c [(search:pattern-error? c) (list (condition-message c) (search:pattern-error-offset c))])
      (search:find b (search:make-query text search:regexp) 0 forward)))
> (pattern-error "(abc")
("missing closing parenthesis" 4)
> (pattern-error "a)")
("unmatched closing parenthesis" 1)
