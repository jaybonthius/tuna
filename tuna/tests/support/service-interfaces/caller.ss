prelude: :gerbil/core
package: tuna/tests/support/service-interfaces
(import :std/interface :tuna/kernel "./base" "./derived")
(export check-preservation)

(def (expect (value : :t) (label : :string)) => :void
  (unless value (error label)))
(def (through-base (provider : Base) (n : :fixnum)) => :fixnum
  (Base-run provider n))
(def (through-extra (provider : Extra) (n : :fixnum)) => :fixnum
  (Extra-run provider n))
(def (through-diamond (provider : Diamond) (n : :fixnum)) => :fixnum
  (Diamond-run provider n))

(def (check-preservation) => :void
  (check-qualified-preservation)
  (let* ((raw (new-provider))
         (composed [])
         ;; Descriptions are ordinary first-class values.
         (description Diamond-service-view)
         (view ((service-view-build description) raw
                (lambda (operation base)
                  (set! composed (cons operation composed))
                  (if (eq? operation 'run)
                    (lambda (n)
                      (set! events (append events '(service-before)))
                      (let (result (base n))
                        (set! events (append events '(service-after)))
                        (+ result 100)))
                    base)))))
    (expect (and (is-Base? view) (is-Auxiliary? view) (is-Extra? view) (is-Diamond? view))
            "complete facades lost")
    ;; Diamond 13 + Extra 12 + Base 10 + Auxiliary 1 qualified paths.
    (expect (= (length composed) 36) "qualified chain count")
    (expect (= (length (service-view-operations description)) 13) "duplicate operation metadata")
    (expect (= (length (filter (lambda (op) (eq? op 'run)) composed)) 3) "diamond duplicated Base path")
    (for-each
      (lambda (call)
        (reset-events!)
        (call)
        (expect (equal? events '(service-before function-before body function-after service-after))
                "service layer bypassed, duplicated, or not outermost"))
      [(lambda () (expect (= (through-base (Base view) 2) 102) "Base call"))
       (lambda () (expect (= (through-extra (Extra view) 3) 105) "Extra call"))
       (lambda () (expect (= (through-diamond (Diamond (Base view)) 4) 109) "recast call"))])
    (expect (= (Extra-extra (Extra (Base view))) 9) "raw shared state lost")
    (expect (= (Diamond-extra raw) 9) "wrapper copied raw state")
    (expect (string=? (Auxiliary-side view) "side") "second parent lost")
    (expect (eq? (Diamond-leaf view) 'leaf) "leaf lost")
    (reset-defaults!)
    (expect (= (Base-optional view) 1) "optional default")
    (expect (= default-count 1) "optional evaluated twice")
    (expect (= (Diamond-keyword view 10) 12) "keyword default")
    (expect (= default-count 2) "keyword evaluated twice")
    (expect (= (Diamond-keyword view 10 add: 5) 15) "keyword forwarding")
    (expect (= default-count 2) "explicit argument evaluated default")
    (expect (equal? (Base-rest view 1 2 3) '(1 2 3)) "rest forwarding")
    (expect (equal? (Diamond-combined view 10) '(10 3 4)) "combined defaults")
    (expect (= default-count 4) "combined defaults evaluated twice")
    (expect (equal? (Diamond-combined view 10 20 scale: 30 40 50) '(10 20 30 40 50))
            "combined forwarding")
    (expect (= default-count 4) "combined explicit defaults")
    (expect (= (Diamond-predicate view 8) 8) "predicate argument")
    (let (value (new-payload 6))
      (expect (eq? (Diamond-typed view value) value) "inherited record type"))
    (expect (not (Base-nullable view #f)) "nullable false")
    (expect (= (Base-nullable view #t) 7) "nullable value")
    (expect (equal? (call-with-values (lambda () (Diamond-multiple view)) list) '(1 "two"))
            "multiple values lost")
    (expect (eq? (Diamond-loose view 'loose) 'loose) "implicit result contract")
    (for-each
      (lambda (operation)
        (let (bad ((service-view-build description) raw
                   (lambda (name base)
                     (if (eq? name operation) (lambda args "invalid") base))))
          (expect
            (with-catch (lambda (e) #t)
              (lambda ()
                (case operation
                  ((run) (Base-run bad 1))
                  ((nullable) (Base-nullable bad #t))
                  ((typed) (Diamond-typed bad (new-payload 1))))
                #f))
            "dynamic return escaped its checked contract")))
      '(run nullable typed))
    (expect (with-catch (lambda (e) #t)
              (lambda ()
                ((service-view-build description) raw (lambda (operation base) 0))
                #f))
            "nonprocedure composition result accepted")
    (expect (with-catch (lambda (e) #t) (lambda () (Base-run view "invalid") #f))
            "argument contract lost")
    (displayln "SERVICE-VIEW-PRESERVATION-PASS")))

(def (check-qualified-preservation) => :void
  (let* ((raw (new-qualified-provider))
         (special-count 0)
         ;; RUN and CHOOSE stay untouched while SPECIAL is advised.
         (view ((service-view-build QualifiedExtra-service-view) raw
                (lambda (operation base)
                  (if (eq? operation 'special)
                    (lambda ()
                      (set! special-count (fx1+ special-count))
                      (fx+ (base) 10))
                    base)))))
    (expect (eq? (QualifiedBase-run raw) 'base) "raw qualified Base")
    (expect (eq? (QualifiedExtra-run raw) 'extra-run) "raw qualified Extra")
    (expect (eq? (QualifiedSibling-run raw) 'sibling) "raw qualified unrelated parent")
    (expect (eq? (QualifiedBase-run view) 'base) "untouched qualified Base changed")
    (expect (eq? (QualifiedExtra-run view) 'extra-run) "untouched qualified Extra changed")
    (expect (eq? (QualifiedSibling-run view) 'sibling) "untouched qualified unrelated parent changed")
    (expect (= (QualifiedExtra-special view) 17) "extra operation advice lost")
    (expect (= special-count 1) "extra advice did not run once")
    (expect (= (length (service-view-operations QualifiedExtra-service-view)) 4)
            "operation metadata not deduplicated")
    (expect (eq? (QualifiedBase-widen raw 1) 'base-value) "raw narrow signature")
    (expect (eq? (QualifiedExtra-widen raw "string") 'extra-value) "raw widened signature")
    (expect (eq? (QualifiedBase-widen view 1) 'base-value) "narrow signature changed")
    (expect (eq? (QualifiedExtra-widen view "string") 'extra-value) "widened signature changed")
    ;; Gerbil permits different defaults/predicates with compatible argument
    ;; and result types. Every path must use its own source signature.
    (expect (= (QualifiedBase-choose raw) 101) "raw Base default")
    (expect (= (QualifiedExtra-choose raw) -102) "raw Extra default")
    (expect (= (QualifiedSibling-choose raw) 0) "raw sibling default")
    (expect (= (QualifiedBase-choose view) 101) "Base default changed")
    (expect (= (QualifiedExtra-choose view) -102) "Extra default changed")
    (expect (= (QualifiedSibling-choose view) 0) "sibling default changed")
    (expect (= (QualifiedBase-choose view 5) 105) "Base argument changed")
    (expect (= (QualifiedExtra-choose view -5) -105) "Extra argument changed")
    (expect (= (QualifiedSibling-choose view 0) 0) "sibling argument changed")
    (for-each
      (lambda (call)
        (expect (with-catch (lambda (e) #t) (lambda () (call) #f))
                "path argument/return contract lost"))
      [(lambda () (QualifiedBase-widen view "string"))
       (lambda () (QualifiedBase-choose view -1))
       (lambda () (QualifiedExtra-choose view 1))
       (lambda () (QualifiedSibling-choose view 1))
       (lambda ()
         (let (bad ((service-view-build QualifiedExtra-service-view) raw
                    (lambda (operation base)
                      (if (eq? operation 'choose) (lambda args "invalid") base))))
           (QualifiedBase-choose bad)))
       (lambda ()
         (let (bad ((service-view-build QualifiedExtra-service-view) raw
                    (lambda (operation base)
                      (if (eq? operation 'choose) (lambda args "invalid") base))))
           (QualifiedExtra-choose bad)))
       (lambda ()
         (let (bad ((service-view-build QualifiedExtra-service-view) raw
                    (lambda (operation base)
                      (if (eq? operation 'choose) (lambda args "invalid") base))))
           (QualifiedSibling-choose bad)))])
    (let* ((run-count 0)
           (composed-run-count 0)
           (trace [])
           (advised ((service-view-build QualifiedExtra-service-view) raw
                     (lambda (operation base)
                       (if (eq? operation 'run)
                         (begin
                           (set! composed-run-count (fx1+ composed-run-count))
                           (lambda ()
                             (set! run-count (fx1+ run-count))
                             (set! trace (append trace '(before)))
                             (let (result (base))
                               (set! trace (append trace '(after)))
                               result)))
                         base)))))
      (expect (= composed-run-count 3) "qualified bases were collapsed")
      (for-each
        (lambda (call expected)
          (set! trace [])
          (let (before run-count)
            (expect (eq? (call) expected) "advised qualified result changed")
            (expect (= run-count (fx1+ before)) "advice did not run exactly once")
            (expect (equal? trace '(before after)) "advice order changed")))
        [(lambda () (QualifiedBase-run advised))
         (lambda () (QualifiedExtra-run advised))
         (lambda () (QualifiedSibling-run advised))
         (lambda () (QualifiedBase-run (QualifiedBase (QualifiedExtra advised))))
         (lambda () (QualifiedExtra-run (QualifiedExtra (QualifiedBase advised))))
         (lambda () (QualifiedSibling-run (QualifiedSibling (QualifiedBase advised))))]
        '(base extra-run sibling base extra-run sibling)))))
