; A part leads to its most recently used view that is not locked, so a
; Super move, a click, the tab, strip and float commands reach a part
; whose last selected view is locked.
> (define a (view-named "a"))
> (define b (view-named "b"))
> (define p (view-named "p"))
> (reset! (layout-split:container '((direction . row)) (atom a) (layout-split:container '((direction . column)) (atom b) (atom p '(locked . #t)))))
> (for-each layout:select! (list b p a))
> (press! "s-<right>")
> (selected)
"b"
> (layout:select! p)
> (who (layout:part-view (enclosing b)))
"b"
; A click on a column's placeholder or band names the column, whose
; first view here is locked.
> (define a (view-named "a"))
> (define b (view-named "b"))
> (define p (view-named "p"))
> (reset! (layout-scroll:container '() (atom a '(size . 1/2)) (layout-split:container '((direction . column) (size . 1/2)) (atom p '(locked . #t)) (atom b))))
> (for-each layout:select! (list b p a))
> (click-part! (enclosing b))
> (selected)
"b"
> (layout:select! p)
> (layout:select! a)
> (press! "s-<end>")
> (selected)
"b"
> (layout:select! p)
> (press! "s-<home>")
> (selected)
"a"
; Tabs: C-x t o reaches a tab whose last selected view is locked.
> (define a (view-named "a"))
> (define b (view-named "b"))
> (define p (view-named "p"))
> (reset! (layout-tabs:container '() (atom a) (layout-split:container '((direction . column)) (atom b) (atom p '(locked . #t)))))
> (for-each layout:select! (list b p a))
> (press! "C-x" "t" "o")
> (selected)
"b"
; Floats: the float holding the selected view is drawn on top, though the
; view is locked, and s-V goes to the float drawn on top.
> (define a (view-named "a"))
> (define b (view-named "b"))
> (define c (view-named "c"))
> (define p (view-named "p"))
> (reset! (layout-float:container '() (atom a) (layout-split:container '((direction . column) (place box 1/4 1/4)) (atom p '(locked . #t)) (atom b)) (atom c '(place box 3/4 3/4))))
> (for-each layout:select! (list b c p))
> (float-z)
(2 1)
> (layout:select! a)
> (press! "s-V")
> (selected)
"b"
; The part mode's r on a locked part beside the selected view deletes
; the view; its level keeps only the locked part, so the successor comes
; from the level around it.
> (define l (view-named "l"))
> (define a (view-named "a"))
> (define x (view-named "x"))
> (reset! (layout-split:container '((direction . row)) (layout:level '() (layout-split:container '((direction . row)) (atom l '(locked . #t)) (atom a))) (atom x)))
> (for-each layout:select! (list x a))
> (in-client layout:part-mode)
> (in-client layout:select-previous)
> (who (layout:part-view (layout:selected-part)))
"l"
> (in-client layout:raise)
> (in-client layout:part-mode-leave)
> (list (selected) (map who (layout:views)))
("x" ("l" "echo" "x"))
