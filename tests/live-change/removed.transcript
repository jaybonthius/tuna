; A definition that a module's running version no longer makes raises
; after a reload, by name or through the procedure the name gave; other
; owners' advice on it stays with the name, as Emacs keeps advice across
; a defun.
> (put-version! "removed-1.sls" ".config/tuna/lib/removed.sls")
> (import (removed))
> (define held-g removed:g)
> (advice-add! removed:g (lambda (g) (list 'advised (g))))
> (removed:g)
(advised g)
> (put-version! "removed-3.sls" ".config/tuna/lib/removed.sls")
> (reload-modules! '((removed)))
> (removed:f)
3
> (removed:g)
! removed:g: module (removed) no longer defines it
> (held-g)
! removed:g: module (removed) no longer defines it
> (define removed:g (lambda () 'set))
> (owner-changes (module-owner '(removed)))
((define #<procedure removed:f> removed:f))
> (owner-changes (plugins:repl-owner))
((advice #<procedure> #<procedure>))
; Defining it again brings it back, under the advice.
> (put-version! "removed-1.sls" ".config/tuna/lib/removed.sls")
> (reload-modules! '((removed)))
> (removed:g)
(advised g)
> (held-g)
(advised g)
> (owner-changes (module-owner '(removed)))
((define #<procedure> removed:g) (define #<procedure removed:f> removed:f))
; A definition made only by a version whose body raised goes when the
; previous version is loaded again.
> (put-version! "removed-2.sls" ".config/tuna/lib/removed.sls")
> (reload-modules! '((removed)))
! car: () is not a pair
> (removed:f)
1
> (owner-changes (module-owner '(removed)))
((define #<procedure> removed:g) (define #<procedure removed:f> removed:f))
