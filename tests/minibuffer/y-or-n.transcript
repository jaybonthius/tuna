; In a y-or-n question, y, Y and SPC answer yes, n, N, DEL and <delete>
; answer no, and any other one-character key or RET asks again.
> (define t (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (in-client (lambda () (map commands:command-name (map (lambda (k) (keys:lookup client k)) '("y" "Y" "SPC" "n" "N" "DEL" "<delete>" "q" "RET")))))
(minibuffer:answer-yes minibuffer:answer-yes minibuffer:answer-yes minibuffer:answer-no minibuffer:answer-no minibuffer:answer-no minibuffer:answer-no minibuffer:%reject-y-or-n-answer minibuffer:%reject-y-or-n-answer)
> (type! "q")
> (bracket)
"<span class=\"minibuffer-message\" role=\"status\"> [Please answer y or n]</span>"
> (press! "y")
> (result t)
#t
> (define t (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (press! "n")
> (result t)
#f
> (define t (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (press! "Y")
> (result t)
#t
> (define t (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (press! "SPC")
> (result t)
#t
> (define t (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (press! "N")
> (result t)
#f
> (define t (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (press! "DEL")
> (result t)
#f
; The question's keymap is a table the user binds in.
> (keys:bind! minibuffer:y-or-n-keymap "j" minibuffer:answer-yes)
> (define t (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (press! "j")
> (result t)
#t
> (keys:unbind! minibuffer:y-or-n-keymap "j")
; The mode is on in the view while point is in a y-or-n question, so the
; commands marked for it are offered there, and run by name they answer.
> (define t (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (in-client (lambda () (list (minibuffer:y-or-n-mode) (modes:on? minibuffer:y-or-n-mode (view)))))
(#t #t)
> (in-client (lambda () (map (lambda (c) (modes:command-for-view? c (view))) (list minibuffer:answer-yes minibuffer:answer-no))))
(#t #t)
> (in-client (lambda () (commands:run minibuffer:answer-no)))
> (result t)
#f
; In a prompt that is no y-or-n question, and in a view of another
; buffer, the mode is off and the commands are not offered.
> (define t (start! (lambda () (minibuffer:read "Name: "))))
> (in-client (lambda () (list (minibuffer:y-or-n-mode) (modes:command-for-view? minibuffer:answer-yes (view)))))
(#f #f)
> (define notes (buffers:make "notes" "one"))
> (define elsewhere (views:make notes))
> (list (modes:on? minibuffer:y-or-n-mode elsewhere) (modes:command-for-view? minibuffer:answer-no elsewhere))
(#f #f)
; With no y-or-n question waiting, they raise.
> (in-client (lambda () (commands:run minibuffer:answer-yes)))
! minibuffer:answer-yes: no y-or-n question waits
> (press! "C-g")
! &cancelled
> (result t)
(raised #<condition &cancelled>)
; Run where point is in no y-or-n question, they answer the innermost
; one, and the prompt holding point stays.
> (define asked (start! (lambda () (minibuffer:ask-y-or-n "Save it? "))))
> (define named (start! (lambda () (minibuffer:read "Name: "))))
> (in-client (lambda () (minibuffer:y-or-n-mode)))
#f
> (in-client (lambda () (commands:run minibuffer:answer-yes)))
> (list (result asked) (eq? (task-state named) 'done))
(#t #f)
> (type! "y")
> (input)
"y"
> (press! "C-g")
! &cancelled
> (result named)
(raised #<condition &cancelled>)
