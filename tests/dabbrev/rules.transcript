; M-/ replaces the text before point with the nearest word that starts
; with it: before point, then after it, then in friend buffers, of the
; same major mode, then in the others; again right away, with the next
; one; with none left, with the text typed.
> (define here (buffers:make "here" "apricot apple ap application"))
> (define friend (buffers:make "friend" "apex"))
> (define scheme (buffers:make "s.ss" "apology"))
> (modes:set-major-mode chez-scheme:mode scheme)
> (define internal (buffers:make " internal" "apiary"))
> (show! here)
#<buffer here>
> (views:set-point! (view) (+ 1 (string-length "apricot apple ap")))
> (expansions "M-/" "M-/" "M-/")
("apple" "apricot" "application")
> (press! "M-/")
> (list (word-before-point) (echo-area:current-message))
("apex" "Expansion found in ‘friend’")
> (press! "M-/")
> (list (word-before-point) (echo-area:current-message))
("apology" "Expansion found in ‘s.ss’")
> (press! "M-/")
! dabbrev:expand: No further dynamic expansion for ‘ap’ found
> (text here)
"apricot apple ap application"
> (press! "M-/")
> (word-before-point)
"apple"
; After another command M-/ starts afresh, from the text before point.
> (press! "C-b" "C-f" "M-/")
! dabbrev:expand: No dynamic expansion for ‘apple’ found
> (press! "DEL" "DEL" "DEL" "M-/")
> (text here)
"apricot apple apple application"
; Other buffers only with dabbrev:check-other-buffers, and the rest only
; with dabbrev:check-all-buffers.
> (show! (buffers:make "here 2" "apricot apple ap"))
#<buffer here 2>
> (set-option! dabbrev:check-all-buffers #f)
> (expansions "M-/" "M-/" "M-/" "M-/")
("apple" "apricot" "application" "apex")
> (press! "M-/")
! dabbrev:expand: No further dynamic expansion for ‘ap’ found
> (set-option! dabbrev:check-other-buffers #f)
> (expansions "M-/" "M-/")
("apple" "apricot")
> (press! "M-/")
! dabbrev:expand: No further dynamic expansion for ‘ap’ found
> (remove-option! dabbrev:check-all-buffers)
; Case: the expansion takes the case of the text it replaces, unless its
; own case is mixed and it starts as typed; with case-fold-search off,
; only words in the typed case are found.
> (define (cased typed)
    (show! (buffers:make (string-append "cased " typed) (string-append "Apple apTitude\n" typed))))
> (cased "AP")
#<buffer cased AP>
> (expansions "M-/" "M-/")
("APTITUDE" "APPLE")
> (cased "Ap")
#<buffer cased Ap>
> (expansions "M-/" "M-/")
("Aptitude" "Apple")
> (cased "ap")
#<buffer cased ap>
> (expansions "M-/" "M-/")
("apTitude" "apple")
> (set-option! dabbrev:case-fold-search #f)
> (cased "ap ")
#<buffer cased ap >
> (press! "DEL")
> (expansions "M-/")
("apTitude")
> (press! "M-/")
! dabbrev:expand: No further dynamic expansion for ‘ap’ found
> (remove-option! dabbrev:case-fold-search)
> (set-option! dabbrev:case-replace #f)
> (cased "AP ")
#<buffer cased AP >
> (press! "DEL")
> (expansions "M-/" "M-/")
("apTitude" "Apple")
> (remove-option! dabbrev:case-replace)
; In a Scheme buffer the text before point is a Scheme symbol, : and all.
> (define code (buffers:make "code.ss" "(buffers:insert! b)\n(buffers:ins"))
> (modes:set-major-mode chez-scheme:mode code)
> (show! code)
#<buffer code.ss>
> (views:set-point! (view) (document:length (buffers:document code)))
> (expansions "M-/")
("buffers:insert!")
; With no word before point there is nothing to expand.
> (type! " ")
> (press! "M-/")
! dabbrev:expand: No possible abbreviation preceding point
> (remove-option! dabbrev:check-other-buffers)
; C-M-/ completes from this buffer's words; with C-u, from the friend
; buffers' too.
> (define words (buffers:make "words" "alpha almond\n"))
> (define more (buffers:make "more" "alpine"))
> (show! words)
#<buffer words>
> (type! "al")
> (press! "C-M-/")
> (settled-texts)
("alpha" "almond")
> (press! "C-g")
> (press! "C-u" "C-M-/")
> (settled-texts)
("alpha" "almond" "alpine")
> (press! "C-g" "SPC")
> (press! "C-M-/")
! dabbrev:completion: No possible abbreviation preceding point
; With no expansion C-M-/ says so, once its job has looked.
> (type! "qq")
> (press! "C-M-/")
> (testing:wait-until (lambda () (echo-area:current-message)))
> (list (session) (echo-area:current-message))
(#f "No dynamic expansion for ‘qq’ found in this-buffer")
> (press! "C-u" "C-M-/")
> (testing:wait-until (lambda () (echo-area:current-message)))
> (echo-area:current-message)
"No dynamic expansion for ‘qq’ found"
> (press! "DEL" "DEL")
; Only longer words that start with the text are offered, in its case.
> (type! "AL")
> (press! "C-M-/")
> (settled-texts)
("ALPHA" "ALMOND")
> (press! "C-g" "SPC")
> (type! "Al")
> (press! "C-M-/")
> (settled-texts)
("Alpha" "Almond")
> (press! "C-g" "SPC")
; dabbrev:word-region is an entry a configuration adds; it gives way to
; the next entry when no word matches.
> (define (zeds)
    (let* ([v (views:current)] [p (views:point v)])
      (completion:region (- p 2) p (list (completion:source (candidates (vector "zeta" "zero")))))))
> (add-hook! completion:find-region dabbrev:word-region -2)
> (add-hook! completion:find-region zeds -1)
> (type! "alm")
> (press! "C-M-i")
> (settled-texts)
("almond")
> (press! "C-g" "SPC")
> (type! "ze")
> (press! "C-M-i")
> (testing:wait-until (lambda () (let ([s (session)]) (and s (pair? (texts s))))))
> (texts (session))
("zero" "zeta")
> (press! "C-g")
> (set-option! dabbrev:region-buffer-predicate (lambda (b) (eq? b more)))
> (press! "SPC")
> (type! "alpi")
> (press! "C-M-i")
> (settled-texts)
("alpine")
> (press! "C-g")
> (remove-option! dabbrev:region-buffer-predicate)
> (remove-hook! completion:find-region zeds)
> (remove-hook! completion:find-region dabbrev:word-region)
; A numeric prefix of 16 reads every buffer not ignored, as C-u C-u does.
> (define faraway (buffers:make "faraway" "alfalfa"))
> (modes:set-major-mode chez-scheme:mode faraway)
> (press! "SPC")
> (type! "alf")
> (press! "C-u" "C-M-/")
> (settled-texts)
#f
> (press! "C-g")
> (press! "C-u" "1" "6" "C-M-/")
> (settled-texts)
("alfalfa")
> (press! "C-g")
; A minor mode that changes a buffer's characters through
; syntax:buffer-symbol-characters changes the abbreviation and the words
; read from that buffer.
> (define (colon-symbols symbol-characters buffer)
    (if (string=? (buffers:name buffer) "colons")
        (string-append (symbol-characters buffer) ":")
        (symbol-characters buffer)))
> (show! (buffers:make "colons" "pi:menu pi:chat\npi:m"))
#<buffer colons>
> (expansions "M-/")
("menu")
> (press! "C-/" "C-g")
> (advice-add! syntax:buffer-symbol-characters colon-symbols)
> (expansions "M-/")
("pi:menu")
> (advice-remove! syntax:buffer-symbol-characters colon-symbols)
; With dabbrev:backward-only, M-/ looks only before point in the current
; buffer; with dabbrev:upcase-means-case-search, a capital in the
; abbreviation keeps case.
> (set-option! dabbrev:check-other-buffers #f)
> (show! (buffers:make "directions" "Before before  after"))
#<buffer directions>
> (views:set-point! (view) (+ 1 (string-length "Before before ")))
> (type! "b")
> (expansions "M-/")
("before")
> (press! "M-/")
! dabbrev:expand: No further dynamic expansion for ‘b’ found
> (press! "DEL")
> (type! "a")
> (expansions "M-/")
("after")
> (press! "C-/" "C-g")
> (set-option! dabbrev:backward-only #t)
> (press! "M-/")
! dabbrev:expand: No dynamic expansion for ‘a’ found
> (remove-option! dabbrev:backward-only)
> (press! "DEL")
> (type! "B")
> (expansions "M-/")
("BEFORE")
> (press! "M-/")
! dabbrev:expand: No further dynamic expansion for ‘B’ found
> (set-option! dabbrev:upcase-means-case-search #t)
> (press! "C-g")
> (expansions "M-/")
("Before")
> (press! "M-/")
! dabbrev:expand: No further dynamic expansion for ‘B’ found
> (remove-option! dabbrev:upcase-means-case-search)
> (remove-option! dabbrev:check-other-buffers)
; An expansion that arrives after keys typed while M-/ waited for it is
; dropped, so it never lands in the middle of what was typed.
> (define far (buffers:make "far" (string-append (apply string-append (make-list 2000000 "zz ")) "zyzzyva")))
> (show! (buffers:make "waiting" "zyz"))
#<buffer waiting>
> (define tasks
    (list (spawn-task (lambda () (press! "M-/")))
          (spawn-task (lambda () (sleep-for 0.02) (press! "x")))))
> (testing:wait-until (lambda () (for-all task-done? tasks)))
> (list (text (views:buffer (view))) (point))
("zyzx" 5)
> (press! "DEL" "M-/")
> (word-before-point)
"zyzzyva"
; Each M-/ offers the next nearest expansion, across the job's chunks.
; The job sends one chunk's expansions and is asked for more only once
; they have all been offered, so the first press asks nothing.
> (define many (buffers:make "many" (let loop ([k 1] [acc '()]) (if (> k 2000) (apply string-append (reverse (cons "w" acc))) (loop (+ k 1) (cons (format "w~a " k) acc))))))
> (show! many)
#<buffer many>
> (define asked 0)
> (define (count-asks send! job v) (when (eq? v 'more) (set! asked (+ asked 1))) (send! job v))
> (advice-add! jobs:send! count-asks)
> (expansions "M-/" "M-/")
("w2000" "w1999")
> asked
0
> (define (press-times! n) (do ([i 0 (+ i 1)]) ((= i n)) (press! "M-/")))
> (press-times! 1198)
> (list (word-before-point) (< 0 asked 6))
("w801" #t)
> (advice-remove! jobs:send! count-asks)
; While case is ignored, words differing only in case count as one unless
; dabbrev:case-distinction is false.
> (set-option! dabbrev:check-other-buffers #f)
> (show! (buffers:make "cases" "Apple apple ap"))
#<buffer cases>
> (expansions "M-/")
("apple")
> (press! "M-/")
! dabbrev:expand: No further dynamic expansion for ‘ap’ found
> (set-option! dabbrev:case-distinction #f)
> (press! "C-g")
> (expansions "M-/" "M-/")
("apple" "apple")
> (remove-option! dabbrev:case-distinction)
> (remove-option! dabbrev:check-other-buffers)
; An expansion's job holds the documents of the buffers it searches until
; a command other than M-/ ends; then they go.
> (define held (buffers:make "held" "zebra zebrafish"))
> (define held-document (weak-cons (buffers:document held) '()))
> (show! (buffers:make "pressing" "zeb"))
#<buffer pressing>
> (expansions "M-/")
("zebra")
> (buffers:kill! held)
#t
> (set! held #f)
> (define (released?) (collect (collect-maximum-generation)) (bwp-object? (car held-document)))
> (released?)
#f
> (expansions "M-/")
("zebrafish")
> (released?)
#f
> (press! "C-b")
> (sleep-for 0.1)
> (released?)
#t
; Other buffers are searched in the order of buffers:all, the buffer
; used last first, as Emacs's dabbrev walks buffer-list.
> (define older (buffers:make "older" "quokka"))
> (define newer (buffers:make "newer" "quarry"))
> (define asking (buffers:make "asking" "qu"))
> (layout:switch-to-buffer older)
> (layout:switch-to-buffer asking)
> (views:set-point! (view) 3)
> (press! "M-/")
> (word-before-point)
"quokka"
> (press! "C-g")
> (press! "DEL" "DEL" "DEL" "DEL" "DEL" "DEL" "q" "u")
> (layout:switch-to-buffer newer)
> (layout:switch-to-buffer asking)
> (views:set-point! (view) 3)
> (press! "M-/")
> (word-before-point)
"quarry"
