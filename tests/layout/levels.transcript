; Layout gives each part's element the classes kinds draw by: the
; frames holding the user's level or a placed part, the placed parts,
; the locked echo area, and the containers on the way to the selected
; view. Outside a draw there are none.
> (define (classes-in html)
    (let loop ([from 0] [acc '()])
      (let ([i (search html "class=\"" from)])
        (if i
            (let ([end (search html "\"" (+ i 7))])
              (loop end (let ([c (substring html (+ i 7) end)]) (if (member c acc) acc (cons c acc)))))
            (reverse acc)))))
