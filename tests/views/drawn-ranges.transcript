(((211 308)) ((v "long" #t)))
; A taller page asks for more, which moves the range; new columns that
; leave the ask as it was keep it.
> (define taller '(("aboveLines" . 81) ("aboveChars" . 6480) ("belowLines" . 81) ("belowChars" . 6480) ("side" . 160)))
> (report! desktop v 250 0 #f (cons "rows" 40) (cons "wanted" taller))
> (list (ranges v) (told))
(((171 348)) ((v "long" #t)))
> (report! desktop v 250 0 #f (cons "rows" 40) (cons "columns" 60) (cons "wanted" taller))
> (list (ranges v) (told))
(((171 348)) ())
; Each client has a range of its own. Ranges of one view that change in
; one batch run the hook once.
> (show! phone v)
> (list (ranges v) (told))
(((150 350) (171 348)) ((v "long" #t)))
> (report! phone v 250 0 #f)
> (list (ranges v) (told))
(((171 348) (231 278)) ((v "long" #t)))
> (begin (report! desktop v 240 0 #f) (report! phone v 240 0 #f))
> (list (ranges v) (told))
(((201 298) (221 268)) ((v "long" #t)))
; A client that leaves takes its ranges with it.
> (begin (show! phone) (web:client-removed phone))
> (list (ranges v) (told))
(((201 298)) ((v "long" #t)))
; Two clients that draw the same range give it twice.
