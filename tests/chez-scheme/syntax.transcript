; Lexers and lexemes. A mode derived from one with a lexer uses it,
; unless it has an entry of its own; a mode with none has no lexer.
> (tables:define-table derived-keymap)
> (hooks:define-hook derived-hook)
> (modes:define-major-mode derived (parent chez-scheme:mode) (keymap derived-keymap) (hook derived-hook))
> (list (eq? (syntax:lexer derived) chez-scheme:lexer) (syntax:lexer modes:fundamental) (syntax:lexer prog:mode))
(#t #f #f)
> (define calls 0)
> (define (counting-lexer doc) (set! calls (+ calls 1)) (chez-scheme:lexer doc))
> (tables:set! syntax:lexers derived counting-lexer)
> (eq? (syntax:lexer derived) counting-lexer)
#t
; Classes and marks are checked when their forms expand.
> (syntax:class opne)
! universe of class does not include specified symbol opne
> (syntax:lexeme-marks open-ended mismatch)
! universe of %lexeme-mark does not include specified symbol mismatch
> (define l (syntax:make-lexeme (syntax:class string) 3 9 2 (syntax:lexeme-marks open-ended)))
> (list (syntax:lexeme-class l) (syntax:lexeme-start l) (syntax:lexeme-end l) (syntax:lexeme-depth l)
        (syntax:lexeme-open-ended? l) (syntax:lexeme-mismatched? l) (syntax:lexeme? l) (syntax:lexeme? 'string))
(string 3 9 2 #t #f #t #f)
> (raised (lambda () (syntax:make-lexeme 'word 1 2 0 (syntax:lexeme-marks))))
(syntax:make-lexeme "not a lexeme class")
> (raised (lambda () (syntax:make-lexeme "open" 1 2 0 (syntax:lexeme-marks))))
(syntax:make-lexeme "not a lexeme class")
> (raised (lambda () (syntax:make-lexeme (syntax:class atom) 2 2 0 (syntax:lexeme-marks))))
(syntax:make-lexeme "not a range")
> (raised (lambda () (syntax:make-lexeme (syntax:class atom) 1 2 0 '(open-ended))))
(syntax:make-lexeme "not a set of lexeme marks")
> (raised (lambda () (syntax:lexeme-start 'x)))
(syntax:lexeme-start "not a lexeme")
; Questions about sexps and top-level forms lex the whole text once per
; document, on the main thread; an edit makes a new document.
> (define d (buffers:make "d.ss" "(a (b c) d)\n"))
> (modes:set-major-mode derived d)
> (list (syntax:sexp-before d 9) (syntax:sexp-after d 3))
(4 9)
> calls
1
> (buffers:replace! d 1 1 " ")
#<edit 1>
> (list (syntax:sexp-before d 10) (syntax:sexp-after d 4))
(5 10)
> calls
2
; Questions about the text near a position lex the top-level forms
; around it, once per document whatever is asked there.
> (list (length (syntax:openings d 6)) (syntax:lexeme-at d 6) (syntax:lexemes d 6 7))
(2 #f (#<lexeme atom 6 7 2>))
> (define asked calls)
> (list (length (syntax:openings d 6)) (syntax:lexeme-at d 6) (syntax:lexemes d 6 7))
(2 #f (#<lexeme atom 6 7 2>))
> (= calls asked)
#t
; A document's lexemes are kept only while something else holds the
; document.
> (tables:define-table unhighlighted-keymap)
> (hooks:define-hook unhighlighted-hook)
> (modes:define-major-mode unhighlighted (parent prog:mode) (keymap unhighlighted-keymap) (hook unhighlighted-hook))
> (tables:set! syntax:lexers unhighlighted chez-scheme:lexer)
> (define kept (buffers:make "kept.ss" "(a b)\n"))
> (modes:set-major-mode unhighlighted kept)
> (syntax:sexp-before kept 6)
1
> (define old (weak-cons (buffers:document kept) '()))
> (begin (buffers:replace! kept 1 1 " ") (syntax:sexp-before kept 7))
2
> (begin (buffers:replace! kept 1 1 " ") (syntax:sexp-before kept 8))
3
> (collect (collect-maximum-generation))
> (bwp-object? (car old))
#t
; So their cost does not grow with the buffer: in 2,000 forms, the
; openings deep in one read about that form's text, not the buffer's.
> (define lexed 0)
> (tables:set! syntax:lexers unhighlighted (lambda (doc) (set! lexed (+ lexed (document:length doc))) (chez-scheme:lexer doc)))
> (define forms (buffers:make "forms.ss" (apply string-append (map (lambda (k) (format "(define (f~a x)\n  (g x\n     ~a))\n" k k)) (iota 2000)))))
> (modes:set-major-mode unhighlighted forms)
> (define middle (+ (document:line-start (buffers:document forms) 3002) 5))
> (map (lambda (o) (document:text (buffers:document forms) (syntax:lexeme-start o) (+ (syntax:lexeme-start o) 9)))
       (syntax:openings forms middle))
("(define (" "(g x\n    ")
> (< lexed 2000)
#t
> (document:length (buffers:document forms))
71782
; Those forms run from the last line that starts with an opening
; bracket before the position, as Emacs's beginning-of-defun finds it:
; at the start of such a line, the form above holds the position; after
; its bracket, that line starts the forms read.
> (define o (buffers:make "o.ss" "(define (f x)\n(g x))\n"))
> (modes:set-major-mode unhighlighted o)
> (map syntax:lexeme-start (syntax:openings o 15))
(1)
> (map syntax:lexeme-start (syntax:openings o 16))
(15)
; A whitespace edit between lexemes moves the lexemes read rather than
; lexing again; any other edit lexes again.
> (define w (buffers:make "w.ss" "(define (f x)\n  (g x\n    (h x)))\n"))
> (modes:set-major-mode unhighlighted w)
> (map syntax:lexeme-start (syntax:openings w 26))
(1 17)
> (define read lexed)
> (buffers:replace! w 22 22 "  ")
#<edit 1>
> (list (map syntax:lexeme-start (syntax:openings w 28)) (syntax:lexemes w 28 30) (= lexed read))
((1 17) (#<lexeme open 28 29 3> #<lexeme atom 29 30 3>) #t)
> (buffers:replace! w 29 29 "z")
#<edit 2>
> (list (syntax:lexemes w 28 31) (> lexed read))
((#<lexeme open 28 29 3> #<lexeme atom 29 31 3>) #t)
; Deleting the only blank between two atoms joins them, which moving
; the lexemes would not give, so it lexes again.
> (define j (buffers:make "j.ss" "(define (f)\n  (foo bar))\n"))
> (modes:set-major-mode unhighlighted j)
> (syntax:lexemes j 16 23)
(#<lexeme atom 16 19 2> #<lexeme atom 20 23 2>)
> (buffers:replace! j 19 20 "")
#<edit 1>
> (syntax:lexemes j 16 22)
(#<lexeme atom 16 22 2>)
; Indenting the line after an unclosed string makes it stop starting a
; form, so the string runs on past it.
> (define unclosed (buffers:make "unclosed.ss" "(define (f)\n  (g \"abc\n(h y)\n(k z)\n"))
> (modes:set-major-mode unhighlighted unclosed)
> (syntax:lexeme-at unclosed 20)
#<lexeme string 18 23 2>
> (buffers:replace! unclosed 23 23 "  ")
#<edit 1>
> (syntax:lexeme-at unclosed 20)
#<lexeme string 18 31 2>
; Indenting each line of a form whose lines each started a form before
; reads the text about once.
> (define body (buffers:make "body.ss" (string-append "(let ()\n" (apply string-append (map (lambda (k) (format "(define (f~a x)\n  (g x))\n" k)) (iota 500))) "(f0 1))\n")))
> (modes:set-major-mode unhighlighted body)
> (set! lexed 0)
> (let loop ([line 2])
    (when (< line 1002)
      (let ([start (document:line-start (buffers:document body) line)])
        (syntax:openings body start)
        (buffers:replace! body start start "  ")
        (loop (+ line 1)))))
> (< lexed (* 3 (document:length (buffers:document body))))
#t
> (tables:set! syntax:lexers unhighlighted chez-scheme:lexer)
; Questions raise on another thread, past the end of the buffer, and
; for a mode without a lexer.
> (define (on-thread thunk)
    (let ([m (make-mutex)] [c (make-condition)] [result #f])
      (fork-task (lambda (restore) (let ([r (raised thunk)]) (with-mutex m (set! result r) (condition-signal c)))))
      (with-mutex m (let wait () (unless result (condition-wait c m) (wait))))
      result))
> (on-thread (lambda () (syntax:sexp-before d 3)))
(syntax:sexp-before "not on the main thread")
> (raised (lambda () (syntax:openings d 99)))
(syntax:openings "not a position in the buffer")
> (raised (lambda () (syntax:lexemes d 0 99)))
(syntax:lexemes "not a position in the buffer")
> (raised (lambda () (syntax:lexeme-at d 1 modes:fundamental)))
(syntax:lexeme-at "the mode has no lexer")
; A lexer that raises, or returns anything but lexemes in order within
; the document, makes the question raise, naming the lexer.
> (define (broken doc) (car '()))
> (tables:set! syntax:lexers derived broken)
> (define broken-result (raised (lambda () (syntax:sexp-after d 1))))
> (car broken-result)
syntax:sexp-after
> (substring (cadr broken-result) 0 34)
"the lexer of derived raised: Excep"
> (define (overlapping doc)
    (vector (syntax:make-lexeme (syntax:class atom) 1 4 0 (syntax:lexeme-marks))
            (syntax:make-lexeme (syntax:class atom) 3 5 0 (syntax:lexeme-marks))))
> (tables:set! syntax:lexers derived overlapping)
> (raised (lambda () (syntax:sexp-after d 1)))
(syntax:sexp-after "the lexer did not return lexemes in order within the document")
> (tables:set! syntax:lexers derived (lambda (doc) (list)))
> (raised (lambda () (syntax:sexp-after d 1)))
(syntax:sexp-after "the lexer did not return lexemes in order within the document")
> (tables:remove! syntax:lexers derived)
; Sexps: an atom, a string or a list, with the prefixes before it, and
; comments may come between a prefix and what follows it.
> (define s (scheme-buffer "sexps.ss" "(f 'x #;(g) ' ; note\n (h) \"s\" #(1) . y)"))
> (define (sexps b from)
    (let loop ([at from] [acc '()])
      (let ([end (syntax:sexp-after b at)])
        (if end
            (loop end (cons (document:text (buffers:document b) (syntax:sexp-before b end) end) acc))
            (reverse acc)))))
> (sexps s 2)
("f" "'x" "' ; note\n (h)" "\"s\"" "#(1)" "." "y")
; Inside a symbol, sexp-before gives that symbol's start; a position
; between sexps gives the one before; at a list's start, nothing.
> (define t (scheme-buffer "t.ss" "(define (greet name) (string-append \"Hi \" name))\n(greet \"you\")\n"))
> (map (lambda (p) (syntax:sexp-before t p)) (list (after t "(gre") (after t "name)") (after t "(def") (after t "(string-append ")))
(10 9 2 23)
> (syntax:sexp-before t (after t "(define"))
2
> (syntax:sexp-before t (before t "define"))
#f
> (syntax:sexp-after t (before t "(greet \"you"))
63
; The lists holding a position, outermost first, from the end of each
; opening to the start of its match; an unmatched list holds every
; position after its opening, as Emacs's syntax-ppss counts it.
> (map (lambda (o) (syntax:lexeme-start o)) (syntax:openings t (after t "Hi ")))
(1 22)
> (syntax:openings t (before t "(string"))
(#<lexeme open 1 2 1>)
> (syntax:openings t (after t "name))"))
()
> (define u (scheme-buffer "u.ss" "(a (b c\n"))
> (map syntax:lexeme-start (syntax:openings u 8))
(1 4)
> (map syntax:lexeme-start (syntax:openings u 9))
(1 4)
; Comments are not sexps: inside one, the sexps are those around it.
> (define m (scheme-buffer "m.ss" "(a ; (b c)\n d)\n#| (e) |#\n(f)\n"))
> (list (syntax:sexp-after m (after m "(b")) (length (syntax:openings m (after m "(b"))) (syntax:lexeme-class (syntax:lexeme-at m (after m "(b"))))
(14 1 comment)
> (call-with-values (lambda () (syntax:top-level-form m (after m "(e"))) list)
(26 29)
; Except for sexp-before: inside a ; or #| comment, the comment's text
; from its first whitespace or opening bracket reads as code, so the
; example in a comment is the sexp before point, as in Emacs.
> (define e (scheme-buffer "e.ss" "(define x 1)\n;; (greet:text \"x\")\n#|(f (g y)|#\n#;(h (i z) w)\n;; done\n"))
> (define (before-text b position) (document:text (buffers:document b) (syntax:sexp-before b position) position))
> (before-text e (after e "\"x\")"))
"(greet:text \"x\")"
> (before-text e (after e "\"x\""))
"\"x\""
> (before-text e (after e "(g y)"))
"(g y)"
> (before-text e (after e "(i z)"))
"(i z)"
> (before-text e (after e ";; done"))
"done"
> (before-text e (after e ";; "))
"(define x 1)\n;; "
> (syntax:sexp-before e (after e ";; "))
1
; A lexer that is not the buffer's own reads only from the last line at
; or above the position's that starts with an opening bracket, so a lone
; " in prose above does not make the code below a string.
> (define p (buffers:make "notes" "He said \"hi.\n(define (f) 1)\n(f)\n"))
> (modes:major-mode p)
modes:fundamental
> (syntax:sexp-before p (after p "1)\n(f)") chez-scheme:mode)
29
> (call-with-values (lambda () (syntax:top-level-form p (after p "(defi") chez-scheme:mode)) list)
(14 28)
> (define q (scheme-buffer "q.ss" "He said \"hi.\n(define (f) 1)\n(f)\n"))
> (syntax:sexp-before q (after q "1)\n(f)"))
9
; The line found may be far above, with prefix syntax before its
; bracket; a line that a string opened above runs into still counts when
; it starts with an opening bracket of its own.
> (define words (apply string-append (map (lambda (k) (format "w~a\n" k)) (iota 40))))
> (define r (buffers:make "long notes" (string-append "He said \"hi.\n#(outer\n" words "say \"hi\n(g x\nlast\n")))
> (map (lambda (o) (document:text (buffers:document r) (syntax:lexeme-start o) (syntax:lexeme-end o)))
       (syntax:openings r (after r "w30") chez-scheme:mode))
("#(")
> (map (lambda (o) (document:text (buffers:document r) (syntax:lexeme-start o) (syntax:lexeme-end o)))
       (syntax:openings r (after r "las") chez-scheme:mode))
("(")
> (= (syntax:lexeme-start (car (syntax:openings r (after r "las") chez-scheme:mode))) (- (after r "(g") 2))
#t
; With no line at or above that starts with a bracket, the lexer reads
; from the position's own line, so a lone " above hides nothing.
> (define u (buffers:make "prose" (string-append "He said \"hi\n" words "see (editing:forward-word b) here\n")))
> (map (lambda (o) (document:text (buffers:document u) (syntax:lexeme-start o) (syntax:lexeme-end o)))
       (syntax:openings u (after u "forward-word b") chez-scheme:mode))
("(")
> (call-with-values (lambda () (syntax:top-level-form u (after u "forward-word b") chez-scheme:mode))
    (lambda (s e) (document:text (buffers:document u) s e)))
"(editing:forward-word b)"
; Top-level forms: a sexp no list holds, or a list whose opening bracket
; is in column 0, which ends a list left open above; the form holding a
; position, else the first after it, else the last before it.
> (define f (scheme-buffer "f.ss" "; head\n(define (a)\n  (b\n(define (c) 1)\n  (d))\n'(e)\n; tail\n"))
> (define (form b position) (call-with-values (lambda () (syntax:top-level-form b position)) (lambda (s e) (and s (document:text (buffers:document b) s e)))))
> (map (lambda (at) (form f (after f at))) '("; he" "(defi" "(b" "(c) 1" "(d))" "'(e" "; ta"))
("(define (a)\n  (b" "(define (a)\n  (b" "(define (a)\n  (b" "(define (c) 1)" "(define (c) 1)" "(define (c) 1)" "(define (c) 1)")
; Closed, the first form still ends before the column-0 one inside it,
; and the text after that inner form belongs to no form.
> (define g (scheme-buffer "g.ss" "; head\n(define (a)\n  (b\n(define (c) 1)\n  (d)))\n'(e)\n; tail\n"))
> (map (lambda (at) (form g (after g at))) '("(defi" "(c) 1" "(d))" "'(e" "; ta"))
("(define (a)\n  (b" "(define (c) 1)" "'(e)" "'(e)" "'(e)")
> (form (scheme-buffer "empty.ss" "; nothing\n") 3)
#f
