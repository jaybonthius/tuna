> (map summary (diff:parse (string->utf8 "--- a.txt\t2026-01-01 00:00:00\n+++ b.txt\t2026-01-02 00:00:00\n@@ -1,2 +1,2 @@\n one\n--- two\n+++ two\n")))
(("a.txt" "b.txt" modified #f #f 1))
; A removed line that reads like a header is counted as the hunk's.
> (lines-of (car (diff:file-hunks (car (diff:parse (string->utf8 "diff --git a/f b/f\n--- a/f\n+++ b/f\n@@ -1,2 +1,1 @@\n--- a/x\n one\n"))))))
((removed "-" #vu8(45 45 32 97 47 120) #f) (context " " #vu8(111 110 101) #f))
; A conflicted file: its combined diff, and git diff --cached's line.
> (define conflicted (diff:parse (string->utf8 "diff --cc f.txt\nindex 1,2..0\n--- a/f.txt\n+++ b/f.txt\n@@@ -1,3 -1,3 +1,7 @@@\n  one\n++<<<<<<< HEAD\n +MINE\n++=======\n+ OTHER\n++>>>>>>> other\n  three\n* Unmerged path g.txt\n")))
> (map summary conflicted)
(("f.txt" "f.txt" unmerged #f #t 1) ("g.txt" "g.txt" unmerged #f #t 0))
> (lines-of (car (diff:file-hunks (car conflicted))))
((context "  " #vu8(111 110 101) #f) (added "++" #vu8(60 60 60 60 60 60 60 32 72 69 65 68) #f) (added " +" #vu8(77 73 78 69) #f) (added "++" #vu8(61 61 61 61 61 61 61) #f) (added "+ " #vu8(79 84 72 69 82) #f) (added "++" #vu8(62 62 62 62 62 62 62 32 111 116 104 101 114) #f) (context "  " #vu8(116 104 114 101 101) #f))
