; Node state is per view, and goes with its node.
> (import (md))
> (define m (buffers:make "m" (md:doc '() (md:para '() "a\n") (md:para '() "b\n"))))
> (define mv (views:make m))
> (define mw (views:make m))
> (define (para k) (document:token (buffers:document m) (if (= k 1) 1 5)))
