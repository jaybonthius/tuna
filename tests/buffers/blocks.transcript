> (delete (sheet) 18 23)
((md:para () "Hi\n") (grid () (row () (cell () "a\n") (cell () "b\n"))))
> (delete (sheet) 6 18)
((md:para () "Hi\n") (md:para () "Yo\n"))
; Isolating nodes that hold blocks: one the deletion covers keeps its
; last block, emptied; the one holding the end loses its content up to
; it.
> (define boxes (fresh '(md:doc () (md:para () "Hi\n") (grid () (row () (box () (md:para () "x\n") (md:para () "y\n")) (box () (md:para () "z\n")))) (md:para () "Yo\n"))))
> (fit boxes 2 21)
((1 . 6) (9 . 15) (20 . 21))
> (delete boxes 2 21)
((grid () (row () (box () (md:para () "\n")) (box () (md:para () "\n")))) (md:para () "Yo\n"))
; The last block of an isolating node goes with the nodes around it
; only when a node around the isolating node goes too.
> (define (grid-first) (fresh '(md:doc () (grid () (row () (box () (md:para () "x\n")) (box () (md:para () "y\n")))) (md:para () "after\n"))))
> (list (fit (grid-first) 5 23) (fit (grid-first) 5 11))
(((1 . 23)) ((5 . 6)))
> (delete (grid-first) 5 23)
((md:para () "\n"))
> (delete (grid-first) 5 11)
((grid () (row () (box () (md:para () "\n")) (box () (md:para () "y\n")))) (md:para () "after\n"))
> (define alone (fresh '(md:doc () (grid () (row () (box () (md:para () "x\n"))) (row () (box () (md:para () "y\n")))) (md:para () "after\n"))))
> (fit alone 5 7)
((2 . 10))
> (delete alone 5 7)
((grid () (row () (box () (md:para () "y\n")))) (md:para () "after\n"))
; Insertions: blocks put inside a paragraph split it, the first half
; ending with a line break; at a block's first position they go before
; it; inside a cell, or joining a cell's text, they go in as text.
> (define (plan) (fresh '(md:doc () (md:heading () "Plan\n") (md:para () "Buy milk.\n"))))
> (let ([b (plan)]) (buffers:insert! b 12 '(md:heading () "H\n")) (children b))
((md:heading () "Plan\n") (md:para () "Buy\n") (md:heading () "H\n") (md:para () " milk.\n"))
> (let ([b (plan)]) (buffers:insert! b 9 '(md:heading () "H\n")) (children b))
((md:heading () "Plan\n") (md:heading () "H\n") (md:para () "Buy milk.\n"))
> (let ([b (sheet)]) (buffers:insert! b 9 (buffers:piece (plan) 1 8)) (children b))
((md:para () "Hi\n") (grid () (row () (cell () "Plan\na\n") (cell () "b\n"))) (md:para () "Yo\n"))
> (let ([b (sheet)] [cells (buffers:piece (sheet) 9 14)])
    (list (document:open-start (buffers:piece-document cells)) (begin (buffers:insert! b 3 cells) (children b))))
(1 ((md:para () "Ha\nbi\n") (grid () (row () (cell () "a\n") (cell () "b\n"))) (md:para () "Yo\n")))
; Text inserted right after a block's final line break would leave the
; block without it, so it is refused; a block inserted there goes in after
; the block.
> (refusal (lambda () (buffers:insert! (plan) 7 "x")))
(refused "the edit would leave a block without its final line break")
> (let ([b (plan)]) (buffers:insert! b 7 '(md:heading () "H\n")) (children b))
((md:heading () "Plan\n") (md:heading () "H\n") (md:para () "Buy milk.\n"))
; Replacing with content is not fitted, and is refused when a block
; would lose its final line break or the range crosses an isolating
; node's edge; a replacement that gives the line break back is made.
> (refusal (lambda () (buffers:replace! (plan) 2 7 "PLAN")))
(refused "the edit would leave a block without its final line break")
> (refusal (lambda () (buffers:replace! (sheet) 9 13 "x")))
(refused "the edit would cross an isolating node's edge")
> (let ([b (plan)]) (buffers:replace! b 2 7 "PLAN\n") (children b))
((md:heading () "PLAN\n") (md:para () "Buy milk.\n"))
; Typing over a selected heading, deleted first, goes where the deletion
; leaves the cursor.
> (let ([b (plan)]) (buffers:replace! b 2 9 "") (buffers:insert! b (buffers:stop b 1) "x") (children b))
((md:para () "xBuy milk.\n"))
; A consent sees the fitted edit, and a read-only span the fitted range:
; deleting a line break alone joins the next block, which a span over it
; refuses.
> (define seen #f)
> (buffers:define-kind page (content nodes) (consent (lambda (n e) (set! seen (list (buffers:edit-start e) (buffers:piece-length (buffers:edit-removed e)))) #t)))
> (let ([b (fresh '(page () (md:heading () "Plan\n") (md:para () "Buy milk.\n")))]) (buffers:replace! b 2 7 "") seen)
(1 7)
> (define locked-next (fresh '(md:doc () (md:para () "ab\n") (md:para () "cd\n"))))
> (buffers:define-layer fence (read-only))
> (buffers:add-span! (buffers:layer locked-next fence) 6 10 'fence)
> (list (fit locked-next 4 5) (refusal (lambda () (buffers:replace! locked-next 4 5 ""))))
(((4 . 7)) (refused "a read-only span refuses the edit"))
