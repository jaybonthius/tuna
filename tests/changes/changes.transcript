! as-module: not a loaded module with irritant (nothere)
; Only the main thread makes changes.
> (define (on-thread thunk)
    (let ([result #f])
      (thread-join (fork-thread (lambda () (set! result (guard (c [#t (condition-message c)]) (thunk))))))
      result))
> (on-thread (lambda () (set! spell:language (lambda () "thread"))))
"only the main thread makes changes"
