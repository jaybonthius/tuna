; The layout's own drawing is a view of its buffer, so a click on it is a
; mouse key at a position there, found in the kinds of the parts around
; it.
> (define c1 (web:add-client! 1))
> (define notes (buffers:make "notes" "one\ntwo\n"))
> (define a (layout:selected-view))
> (define b (views:make notes))
> (define c (views:make notes))
> (define (atom view . attributes)
    (views:view (cons* (cons 'view (views:id view)) (cons 'buffer (buffers:name (views:buffer view))) attributes)))
> (buffers:replace! layout:buffer 1 2 (document:from-datum (layout-split:container '((direction . row)) (boxes:box '() (atom b) (atom c)) (atom a))))
#<edit 1>
> (define echo (place-echo (buffers:make "*Echo*" "")))
> (tree)
(layout:level () (layout-split:container ((direction . column)) (layout:level () (layout-split:container ((direction . row)) (boxes:box () #(views:view ((view . 3) (buffer . "notes"))) #(views:view ((view . 4) (buffer . "notes")))) #(views:view ((view . 1) (buffer . "*Help*"))))) #(views:view ((view . 5) (buffer . "*Echo*") (depth . 90) (size . content) (locked . #t)))))
; The screen's element names the screen view, and each view atom's
; element names the atom's range.
> (list (views:buffer layout:screen-view) (layout:view-node layout:screen-view))
(#<buffer  *layout*> #f)
> (define html (html->string (layout:screen c1)))
> (substring html 0 (string-length "<div class=\"layout-screen\" data-view=\"2\" data-version=\"2\" data-showing=\"0\">"))
"<div class=\"layout-screen\" data-view=\"2\" data-version=\"2\" data-showing=\"0\">"
> (map (lambda (v) (let ([n (layout:view-node v)]) (list (document:node-start n) (document:node-end n)))) (list b c a echo))
((5 6) (6 7) (8 9) (11 12))
; The layout's keymap takes the layout's clicks, after the kinds'
; keymaps; a container's kind carries its keymap, and a level none.
> (buffers:kind-keymap (buffers:kind 'layout:level))
#f
> (eq? (car (layout:container-keymaps c1 (vector (views:id layout:screen-view) 4))) layout:keymap)
#t
> (eq? (buffers:kind-keymap (buffers:kind 'boxes:box)) boxes:box-keys)
#t
> (define pressed 0)
> (commands:define-command (count-press) "Counts presses that reach the global keymap." (set! pressed (+ pressed 1)))
> (keys:bind! keys:global "<down-mouse-1>" count-press)
> (define (click! . place)
    (let ([s layout:screen-view])
      (parameterize ([web:current-client c1])
        (for-each
          (lambda (action)
            ((table-ref web:input-handlers "mouse") c1
             (append place
                     `(("type" . "mouse") ("action" . ,action) ("button" . 1) ("clicks" . 1) ("modifiers" . #())
                       ("view" . ,(views:id s)) ("version" . ,(buffers:version layout:buffer))
                       ("showing" . ,(views:shown-count s))))))
          '("down" "click")))))
; A click on a view atom's element selects its view; on a container's,
; the part right after its opening, through focused children. The press
; reaches nothing.
> (click! '("token" . 6))
> (list (selected) pressed)
(4 0)
> (layout:select! c)
> (layout:select! a)
> (click! '("token" . 3))
> (selected)
1
> (layout:select! c)
> (click! '("token" . 3))
> (selected)
4
> (click! '("token" . 4))
> (list (selected) pressed)
(3 0)
; A locked part refuses: the echo area stays unselected.
> (click! '("token" . 11))
> (selected)
3
; A click on a part closed since its screen was drawn is stale.
> (define version (buffers:version layout:buffer))
> (layout:delete-part! (layout:view-node c))
> (click! '("token" . 6) (cons "version" version))
! Stale click: what was clicked is gone
> (selected)
3
