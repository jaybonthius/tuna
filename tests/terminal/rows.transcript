; Each edit as its start, the length it removed and the text it put in.
> (define (edits b version)
    (map (lambda (e) (list (buffers:edit-start e) (document:length (buffers:edit-removed e)) (document:text (buffers:edit-inserted e))))
         (buffers:edits-since b version)))
> (define (line-ids)
    (let ([html (html->string (views:draw (view) client))] [key "class=\"line\" id=\""])
      (let loop ([i 0] [acc '()])
        (cond
          [(> (+ i (string-length key)) (string-length html)) (reverse acc)]
          [(string=? (substring html i (+ i (string-length key))) key)
           (let* ([from (+ i (string-length key))]
                  [to (let scan ([j from]) (if (char=? (string-ref html j) #\") j (scan (+ j 1))))])
             (loop to (cons (substring html from to) acc)))]
          [else (loop (+ i 1) acc)]))))
; A row the program changes is written in place, from its start to its
; newline, and the rows it leaves alone are not touched, so each keeps
; its item in the view.
> (define t (start-for-client '("sh" "-c" "stty -echo; printf '\\033[?1049h\\033[H'; seq 1 5; read x; printf '\\033[2;1Hbee\\033[4;1Hdee'; read x")))
> (in-client (lambda () (layout:switch-to-buffer t)))
> (wait-for t "5\n")
> (define ids (line-ids))
> (define version (buffers:version t))
> (terminal:send! t "\r")
> (wait-for t "dee")
> (edits t version)
((10 1 "dee") (6 1 "bee"))
> (list (screen-lines t) (equal? (line-ids) ids))
(("1" "bee" "3" "dee" "5") #t)
> (buffers:kill! t)
#t
; Rows that scroll off the top of the primary screen move into the
; scrollback: the boundary between the two moves past them, and the
; screen gains the new rows at its end.
> (define t (start-for-client '("sh" "-c" "stty -echo; seq 1 23; read x; printf '24\\n25\\n26\\n27\\n'; read x")))
> (in-client (lambda () (layout:switch-to-buffer t)))
> (wait-for t "23\n")
; The scrollback is empty, so the screen's text starts at 4, and row 2
; at 6.
> (define two (buffers:anchor t 6))
> (define version (buffers:version t))
> (terminal:send! t "\r")
> (wait-for t "27\n")
> (edits t version)
((2 2 "") (9 1 "\n") (65 0 "25\n26\n27\n\n") (64 0 "24"))
> (list (buffers:anchor-position two) (buffers:anchor-deleted? two))
(4 #f)
> (list-head (lines (text t)) 6)
("1" "2" "3" "4" "5" "6")
> (list-head (screen-lines t) 2)
("5" "6")
; A view at the cursor follows it, even when the output moves the
; cursor's row into the scrollback. The output is one write, so it
; arrives at once.
> (buffers:kill! t)
#t
> (define t (start-for-client '("sh" "-c" "stty -echo; (echo; seq 25 60) > \"$HOME/out\"; seq 1 23; printf 24; read x; cat \"$HOME/out\"; read x")))
> (in-client (lambda () (layout:switch-to-buffer t)))
> (wait-for t "24")
> (define (at-cursor?) (= (views:point (view)) (- (document:length (buffers:document t)) 3)))
> (at-cursor?)
#t
> (terminal:send! t "\r")
> (wait-for t "60\n")
> (list (at-cursor?) (list-head (lines (text t)) 2))
(#t ("1" "2"))
; A row the program wrapped goes on with the next one in the
; scrollback, whether the next one leaves the screen with it or later.
> (buffers:kill! t)
#t
> (define t (start-for-client '("sh" "-c" "stty -echo; head -c 100 /dev/zero | tr '\\0' a; echo; seq 1 21; read x; echo x; read x; echo y; read x")))
> (wait-for t "21\n")
> (define (scrollback-count) (eval-in-module '(%terminal-scrollback-count (car (%all))) '(terminal)))
> (define version (buffers:version t))
> (terminal:send! t "\r")
> (wait-for t "x\n")
> (list (edits t version) (map string-length (list-head (lines (text t)) 2)) (scrollback-count))
(((2 2 "") (82 1 "\n") (161 0 "\n") (160 0 "x")) (80 20) 1)
> (define version (buffers:version t))
> (terminal:send! t "\r")
> (wait-for t "y\n")
> (list (edits t version) (map string-length (list-head (lines (text t)) 2)) (scrollback-count))
(((83 2 "") (103 1 "\n") (82 1 "") (162 0 "\n") (161 0 "y")) (100 1) 1)
