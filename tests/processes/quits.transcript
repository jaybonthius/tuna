; Quits requested from another thread while output floods in: none
; loses or repeats output, reading goes on, and the exit still arrives.
; A quit can land in a delivery before it holds quits off; such quits
; are counted, not printed, since how many land is chance.
> (import (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (define landed 0)
> (define (count-quits report c)
    (if (quit-condition? c) (set! landed (+ landed 1)) (report c)))
> (advice-add! report count-quits)
> (define (quits-for seconds)
    (suspend
      (lambda (resume)
        (fork-thread
          (lambda ()
            (let ([until (+ (real-time) (* seconds 1000))])
              (let loop ()
                (when (< (real-time) until)
                  (request-quit!)
                  (chez:sleep (make-time 'time-duration 200000 0))
                  (loop))))
            (resume void))))))
> (define holes 0)
> (define last-end 0)
> (define (follow bytes end)
    (cond
      [(eof-object? bytes) (note! 'eof)]
      [else
       (unless (= (- end (bytevector-length bytes)) last-end) (set! holes (+ holes 1)))
       (set! last-end end)]))
> (define (advancing? p)
    (let ([before (processes:output-end p)])
      (testing:wait-until (lambda () (> (processes:output-end p) (+ before 100000))))
      (> (processes:output-end p) (+ before 100000))))
; An own process.
> (define own (processes:start "cat" '("/dev/zero") follow noting-exit))
> (quits-for 2)
> (list holes (advancing? own))
(0 #t)
> (processes:stop! own)
> (testing:wait-until exited?)
> (taken!)
((exit -1))
; A user process that pauses, with a small log, followed as a terminal
; follows its program.
> (set-option! processes:log-size 4096)
> (set! last-end 0)
> (define user
    (processes:start-for-user "cat" '("/dev/zero") (processes:options [full-log (processes:full-log pause)])))
> (processes:attach! user 0 follow noting-exit)
0
> (quits-for 2)
> (list holes (advancing? user))
(0 #t)
> (processes:stop! user)
> (testing:wait-until exited?)
> (list (taken!) (memq user (processes:all)))
(((exit -1)) #f)
> (remove-option! processes:log-size)
> (advice-remove! report count-quits)
