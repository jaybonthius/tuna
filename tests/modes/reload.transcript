; Loading a module runs the mode hooks again where a mode was set, so a
; reloaded plugin's local values come back and a newly loaded plugin's
; entries reach buffers already open. Values set by hand stay.
> (define (reload! name) (reload-modules! (list (list (string->symbol name)))))
> (disk:write-text! "~/a.py" "print(1)\n")
> (disk:write-text! "~/notes.txt" "Buy milk.\n")
> (define a (files:visit "~/a.py"))
> (define notes (files:visit "~/notes.txt"))
> (define plain (buffers:make "plain" "x"))
> (options:define-option probe 0 fixnum? "A value set by hand.")
> (buffers:with-buffer a (options:set-local! probe 33))
> (define (state b) (list (modes:major-mode b) (local fill:mode b) (local fill:column b) (local probe b)))
> (state a)
(python:mode #t 79 33)
> (reload! "python")
> (state a)
(python:mode #t 79 33)
> (map modes:major-mode (list a notes plain))
(python:mode text:mode modes:fundamental)
> (import (indent))
> (list (local indent:width a) (local indent:width notes) (local indent:width plain))
(2 8 8)
; Unloading a mode's module that the configuration imports brings a new
; instance back at once: the old instance's entries go, the new one's
; come, and its buffers keep the mode and the values set by hand.
> (show! a)
#<buffer a.py>
> (define old-python (module-owner '(python)))
> (unload-owner! old-python)
> (list (owner-live? old-python) (eq? old-python (module-owner '(python))) (modes:major-mode a) (modes:ancestry 'python:mode))
(#f #f python:mode (python:mode prog:mode))
> (know! python:keymap 'python:keymap)
> (state a)
(python:mode #t 79 33)
> (active-keymaps)
(fill:keymap python:keymap prog:keymap layout:keymap keys:global)
; Reloading modes keeps each buffer's mode, by name, and runs no reset.
> (reload! "modes")
> (map modes:major-mode (list a notes plain))
(python:mode text:mode modes:fundamental)
> (state a)
(python:mode #t 79 33)
> (local indent:width a)
2
> (active-keymaps)
(fill:keymap python:keymap prog:keymap layout:keymap keys:global)
