; A question's field is isolating too.
> (say! ef (ui-request "q1" "input" '("title" . "Name?")))
> (testing:wait-until (lambda () (node-of edges 'chat:field)))
> (define (field-text) (let ([n (node-of edges 'chat:field)]) (document:text (buffers:document (chat:buffer edges)) (+ (document:node-start n) 1) (- (document:node-end n) 2))))
> (define (on-field offset . keys)
    (in-client
      (lambda ()
        (let ([n (node-of edges 'chat:field)])
          (buffers:replace! (chat:buffer edges) (+ (document:node-start n) 1) (- (document:node-end n) 2) "ab cd"))
        (views:set-point! (view) (+ (document:node-start (node-of edges 'chat:field)) 1 offset))))
    (apply press! keys)
    (list (field-text) (- (views:point (view)) (document:node-start (node-of edges 'chat:field)) 1)))
