; Standard error kept apart reaches on-error-output as it arrives, as
; output reaches on-output: bytes with the offset after them, then the
; end of file, before the exit status.
> (define (noting-errors bytes end)
    (note! (if (eof-object? bytes) (list 'error-eof end) (list 'error (utf8->string bytes) end))))
> (processes:start "sh" '("-c" "printf out; printf err >&2") noting-output noting-exit
    (processes:options) noting-errors)
#<process 1 sh>
> (testing:wait-until exited?)
> (let ([taken (taken!)]) (list (filter (lambda (x) (memq (car x) '(error error-eof))) taken) (car (reverse taken))))
(((error "err" 3) (error-eof 3)) (exit 0))
; Giving it keeps standard error apart, which a terminal cannot.
> (guard (e [(assertion-violation? e) (condition-message e)])
    (processes:start "true" '() noting-output noting-exit (processes:options [terminal '(24 . 80)]) noting-errors))
"a terminal joins standard error to the output"
> (guard (e [(assertion-violation? e) (condition-message e)])
    (processes:start "true" '() noting-output noting-exit (processes:options) 'errors))
"not a procedure"
; processes:error-output still holds the latest standard error.
> (define p (processes:start "sh" '("-c" "printf late >&2") noting-output noting-exit
              (processes:options) noting-errors))
> (testing:wait-until exited?)
> (let ([taken (taken!)]) (list (filter (lambda (x) (memq (car x) '(error error-eof))) taken) (car (reverse taken))))
(((error "late" 4) (error-eof 4)) (exit 0))
> (utf8->string (processes:error-output p))
"late"
; Standard error is not held back for a slow reader: past
; processes:log-size bytes between two deliveries, the oldest are lost.
; A line receiver drops the line the loss cut and passes on the lines
; after it whole.
> (options:set! processes:log-size 64)
; The main thread is kept busy until all of it is written, so nothing is
; delivered before.
> (let ([p (processes:start "sh" '("-c" "i=1; while [ $i -le 40 ]; do echo \"error line $i\" >&2; i=$((i+1)); done")
             noting-output noting-exit (processes:options)
             (processes:line-receiver 0 (lambda (line end) (note! (list 'error-line line end)))))]
        [give-up (+ (real-time) 5000)])
    (let loop ()
      (unless (or (> (real-time) give-up)
                  (let ([text (utf8->string (processes:error-output p))])
                    (and (>= (string-length text) 14)
                         (string=? (substring text (- (string-length text) 14) (string-length text)) "error line 40\n"))))
        (loop))))
> (testing:wait-until exited?)
> (filter (lambda (x) (eq? (car x) 'error-line)) (taken!))
((error-line "error line 37" 509) (error-line "error line 38" 523) (error-line "error line 39" 537) (error-line "error line 40" 551) (error-line #!eof 551))
> (options:unset! processes:log-size)
; Any gap between two pieces is a cut: the line receiver drops what it
; holds and skips to the next separator, and the text receiver skips a
; character the gap cut.
> (define lines '())
> (define receive-line (processes:line-receiver 0 (lambda (line end) (set! lines (cons line lines)))))
> (receive-line (string->utf8 "first line\nhalf of a lo") 23)
> (receive-line (string->utf8 "of another\nnext\n") 5000)
> (reverse lines)
("first line" "next")
> (define texts '())
> (define receive-text (processes:text-receiver 0 (lambda (text end) (set! texts (cons text texts)))))
> (receive-text (bytevector 97 #xC3) 2)
> (receive-text (bytevector #xA9 98 #xC3 #xA9) 10)
> (reverse texts)
("a" "bé")
