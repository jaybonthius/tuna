> (define desktop (web:add-client! 1))
> (define phone (web:add-client! 2))
> (define a (buffers:make "a" "a\n"))
> (define v1 (views:make a))
> (define v2 (views:make a))
> (define v3 (views:make a))
> (define v4 (views:make a))
> (define v5 (views:make a))
> (map views:id (list v1 v2 v3 v4 v5))
(3 4 5 6 7)
> (set-parts! (layout-split:container '((direction . row)) (atom v1) (layout-split:container '((direction . column)) (atom v2) (atom v3) (atom v4)) (atom v5)))
> (layout:select! v3)
; Outside the part mode the selected part is the selected view's atom.
> (list (layout:part-mode?) (part))
(#f 5)
; s-' enters the mode with that part selected, for every client.
> (press! desktop '("'" "super"))
> (list (layout:part-mode?) (part))
(#t 5)
; i selects the container; the selected view stays.
> (type! phone "i")
> (list (part) (selected))
((4 5 6) 5)
; j and l select the part before and after; focus follows the selection
; to the view the part leads to.
> (type! desktop "l")
> (list (part) (selected))
(7 7)
> (type! desktop "j" "j")
> (list (part) (selected))
(3 3)
; From an end, nothing moves.
> (type! desktop "j")
> (part)
3
; k on a container selects its focused child, the one holding the view
; selected last, so i then k comes back where it went up from.
> (type! desktop "l" "k" "l")
> (list (part) (selected))
(6 6)
> (type! desktop "i" "k")
> (list (part) (selected))
(6 6)
; The arrows move as i, j, k and l do.
> (press! desktop '("ArrowUp") '("ArrowRight") '("ArrowLeft") '("ArrowDown"))
> (list (part) (selected))
(6 6)
; 0 and $ select the first and last part of the container.
> (type! desktop "0")
> (part)
4
> (type! desktop "$")
> (part)
6
; The root's part has no parent and no siblings. A level is a part the
; mode visits, and so is a part placed outside it, such as the echo area.
> (define echo ((layout-split:display-at-side (layout:direction down) 90 'content '((locked . #t))) (buffers:make "*Echo*" "")))
> (type! desktop "i" "i" "i" "i")
> (part)
(((3 (4 5 6) 7)) 8)
> (type! desktop "l" "j" "0" "$")
> (part)
(((3 (4 5 6) 7)) 8)
; k on a view does nothing.
> (type! desktop "k" "k" "k" "k")
> (part)
6
; A locked part is selected, but takes no focus.
> (type! desktop "Enter")
> (set-parts! (layout-split:container '((direction . column)) (layout:level '() (layout-split:container '((direction . row)) (atom v1) (atom v2 '(locked . #t)) (atom v3))) (atom echo '(depth . 90) '(size . content) '(locked . #t))))
> (layout:select! v1)
> (press! desktop '("'" "super"))
> (type! desktop "l")
> (list (part) (selected))
(4 3)
> (type! desktop "l")
> (list (part) (selected))
(5 5)
> (type! desktop "j" "j")
> (list (part) (selected))
(3 3)
> (type! desktop "i" "i" "l")
> (list (part) (selected))
(8 3)
; Popups are not parts of the layout and are never selected.
> (type! desktop "Enter")
> (define p (layout-float:show-at! v1 0 a 1/2 1/2))
> (layout:select! p)
> (press! desktop '("'" "super"))
> (part)
(((3 4 5)) 8)
; RET leaves the mode; the selected part is again the selected view's
; atom.
> (layout:select! v3)
> (type! desktop "Enter")
> (list (layout:part-mode?) (part))
(#f 5)
; The commands also work outside the mode, from the selected view's
; atom, as focus moves; the locked part before it takes no focus.
> (layout:select-previous)
> (selected)
5
> (layout:select-parent)
> (list (layout:part-mode?) (part) (selected))
(#f 5 5)
