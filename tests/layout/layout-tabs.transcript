; A press on a tab selects the view the tab leads to, as Emacs's tab
; line selects on the press. The tab's element carries its child's marks
; and layout-tabs:keymap, so the press names the child and is looked up
; there first, even when the tab's first view starts where views places
; the click. The page sends the keymaps marked around the element
; clicked, innermost first.
; The page sends a marked keymap's number, before its state.
> (define (mark-number keymap) (read (open-input-string (views:keymap-mark keymap))))
> (define (mouse! keymaps buttons place . fields)
    (let ([s layout:screen-view])
      (parameterize ([web:current-client c1])
        (for-each
          (lambda (action)
            ((table-ref web:input-handlers "mouse") c1
             (append fields (list place)
                     (if (null? keymaps) '() (list (cons "keymaps" (list->vector (map mark-number keymaps)))))
                     `(("type" . "mouse") ("action" . ,action) ("button" . ,buttons) ("clicks" . 1) ("modifiers" . #())
                       ("view" . ,(views:id s)) ("version" . ,(buffers:version layout:buffer))
                       ("showing" . ,(views:shown-count s))))))
          '("down" "click")))))
> (define (click! . place) (apply mouse! (list layout-tabs:keymap) 1 place))
> (define close-keymaps (list layout-tabs:close-keymap layout-tabs:keymap))
