; By default C-x b previews nothing, as Emacs's switch-to-buffer.
> (define notes (buffers:make "notes" "one\ntwo\nthree\n"))
> (views:set-buffer! (view) notes)
> (define other (buffers:make "other" "x\n"))
> (views:set-point! (view) 5)
> (set-option! buffer-picker:sources (option-default buffer-picker:sources))
> (define t (start! (lambda () (press! "C-x" "b"))))
> (type! "oth")
> (wait-matches (session))
> (texts (session))
("other")
> (views:buffer (car (layout:views)))
#<buffer notes>
> (press! "C-g")
! &quit
> (result t)
> (remove-option! buffer-picker:sources)
; With buffer-picker:buffers given the view, as this configuration sets,
; C-x b previews the selected buffer in the selected view and puts back
; the view's buffer and point when the read is quit.
> (define t (start! (lambda () (press! "C-x" "b"))))
> (wait-matches (session))
> (texts (session))
("*scratch*" "*Messages*" "other" "notes" "sub" "a.txt")
> (views:buffer (car (layout:views)))
#<buffer *scratch*>
> (type! "oth")
> (wait-matches (session))
> (views:buffer (car (layout:views)))
#<buffer other>
> (press! "C-g")
! &quit
> (result t)
> (views:buffer (view))
#<buffer notes>
> (views:point (view))
5
; A name that no candidate names makes a buffer of that name.
> (define t (start! (lambda () (press! "C-x" "b"))))
> (type! "fresh")
> (wait-matches (session))
> (press! "RET")
> (result t)
> (views:buffer (view))
#<buffer fresh>
> (text (views:buffer (view)))
""
; C-x k offers the current buffer by default.
> (define t (start! (lambda () (press! "C-x" "k"))))
> (press! "RET")
> (result t)
> (buffers:find "fresh")
#f
; buffer-picker:read-buffer returns the buffer chosen.
> (define t (start! (lambda () (buffer-picker:read-buffer "Buffer: " buffer-picker:buffer-history other))))
> (press! "RET")
> (result t)
#<buffer other>
; A view left showing no buffer, once every buffer that is not internal
; is killed, still previews in C-x b and quits cleanly.
> (remp buffers:kill! (remp (lambda (b) (buffers:internal-name? (buffers:name b))) (buffers:all)))
()
> (views:buffer (view))
#f
> (define back (buffers:make "back" "b\n"))
> (define t (start! (lambda () (press! "C-x" "b"))))
> (wait-matches (session))
> (press! "C-g")
! &quit
> (result t)
> (define t (start! (lambda () (press! "C-x" "b"))))
> (wait-matches (session))
> (press! "RET")
> (result t)
> (views:buffer (view))
#<buffer back>
