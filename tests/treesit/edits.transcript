; Undo, a revert and a formatter's edit of the whole buffer are edits as
; any other: afterwards the colours are those of a buffer opened on the
; text.
> (define b (python "b.py" "def f(x):\n    return x\n"))
> (faces b)
(("def" keyword.function) ("f" function) ("x" variable.parameter) ("return" keyword.return))
> (buffers:with-buffer b (undo:with-edit-group b (buffers:insert! b (line-start b 2) "class C:\n    \"\"\"Doc.\"\"\"\n")))
35
> (faces b)
(("def" keyword.function) ("f" function) ("x" variable.parameter) ("class" keyword.type) ("C" type) ("\"\"\"Doc.\"\"\"" string.documentation) ("return" keyword.return))
> (buffers:with-buffer b (commands:run undo:undo 1))
> (list (text-of b) (faces b) (as-fresh? b))
("def f(x):\n    return x\n" (("def" keyword.function) ("f" function) ("x" variable.parameter) ("return" keyword.return)) #t)
> (write-file (string-append home "/r.py") "x = 1\n")
> (define r (files:visit (string-append home "/r.py")))
> (list (modes:major-mode r) (faces r))
(python:mode (("x" variable.definition) ("1" number)))
> (write-file (string-append home "/r.py") "import os\n\n\ndef g(y=2):\n    '''Doc.'''\n    return os.sep\n")
> (files:revert-from-file r)
> (list (faces r) (as-fresh? r))
((("import" keyword.import) ("def" keyword.function) ("g" function) ("y" variable.parameter) ("2" number) ("'''Doc.'''" string.documentation) ("return" keyword.return)) #t)
> (buffers:replace! r 1 (- (document:length (buffers:document r)) 1) "import os\n\n\ndef g(y = 2):\n    \"\"\"Doc.\"\"\"\n    return os.sep\n")
#<edit 2>
> (list (faces r) (as-fresh? r))
((("import" keyword.import) ("def" keyword.function) ("g" function) ("y" variable.parameter) ("2" number) ("\"\"\"Doc.\"\"\"" string.documentation) ("return" keyword.return)) #t)
; A kill holds text, not colours: yanked into a buffer with no
; highlighter it stays plain; yanked into a Python buffer it is coloured
; once the job has parsed it.
> (define start (line-start b 1))
> (define end (line-start b 3))
> (kill-ring:push! (list (buffers:piece b start end)))
> (kill-ring:text (kill-ring:current))
"def f(x):\n    return x\n"
> (define plain (buffers:make "plain" "\n"))
> (kill-ring:insert! plain (line-start plain 2) (car (kill-ring:current)))
((2 . 25))
> (settle plain)
> (list (text-of plain) (map (lambda (layer) (buffers:spans layer 0 (document:length (buffers:document plain)))) (buffers:layers plain)))
("\ndef f(x):\n    return x\n" (()))
> (define p (python "p.py" "x = 1\n"))
> (settle p)
> (kill-ring:insert! p (line-start p 2) (car (kill-ring:current)))
((7 . 30))
> (list (faces p) (as-fresh? p))
((("x" variable.definition) ("1" number) ("def" keyword.function) ("f" function) ("x" variable.parameter) ("return" keyword.return)) #t)
; With a syntax error, the text around it keeps its colours and the
; error gets none.
> (define e (python "e.py" "x = 1\ndef f(:\n    pass\ny = \"s\"\n"))
> (faces e)
(("x" variable.definition) ("1" number) ("def" keyword.function) ("f" function) ("pass" keyword) ("y" variable.definition) ("\"s\"" string))
