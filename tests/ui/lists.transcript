; ui:select-row! shows the row it selects, even the row already
; selected: every call sends the view a placement that follows point.
> (define (placement-number)
    (let* ([s (html (view))] [key "data-placement=\""]
           [at (let find ([i 0]) (if (string=? (substring s i (+ i (string-length key))) key) i (find (+ i 1))))]
           [from (+ at (string-length key))])
      (let loop ([i from]) (if (char-numeric? (string-ref s i)) (loop (+ i 1)) (string->number (substring s from i))))))
> (define p0 (placement-number))
> (ui:select-row! (lst) (view) 99)
> (> (placement-number) p0)
#t
