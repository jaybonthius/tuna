; A default and an on-change, as options:define-option takes them.
> (define changes '())
> (modes:define-minor-mode my-mode
    "Whether mine is on."
    (default #t)
    (on-change (lambda (on?) (set! changes (cons on? changes)))))
> (list (my-mode) (options:default my-mode))
(#t #t)
> (options:set! my-mode #f)
> changes
(#f)
