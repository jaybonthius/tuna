; A job started while a module's body runs belongs to the module.
> (import (client))
> (testing:wait-until (lambda () (pair? (client:from-the-body))))
> (client:from-the-body)
(started-in-the-body)
; A job belongs to the current owner, whichever module's code starts it.
; Unloading another module leaves it running.
> (define from-repl (client:start-waiting (lambda (ended) (note! (list 'from-repl ended)))))
> (unload-owner! (module-owner '(client)))
> (jobs:stop! from-repl)
> (testing:wait-until (lambda () (pair? log)))
> (taken!)
((from-repl stopped))
; A raise is reported as the module that started the job.
> (load-module! '(client))
#<owner (client) 2>
> (begin (finished client:fails 1) (void))
! car: 1 is not a pair
> (begin (call-as-owner (module-owner '(client)) (lambda () (finished client:fails 1))) (void))
! (client) car: 1 is not a pair
; Unloading the starter stops its jobs, drops their values not yet run,
; and skips on-end.
> (import (searcher))
> (call-as-owner (module-owner '(searcher)) (lambda () (jobs:start searcher:count-slowly "unloaded" note! (lambda (ended) (note! (list 'ended ended))))))
#<job count-slowly>
> (timers:sleep 0.1)
> (file-exists? "unloaded")
#f
> (define seen #f)
> (begin (unload-owner! (module-owner '(searcher))) (set! seen (length log)) (> seen 0))
#t
> (testing:wait-until (lambda () (file-exists? "unloaded")))
> (timers:sleep 0.05)
> (list (= seen (length log)) (exists pair? log))
(#t #f)
; So does reloading it.
> (set! log '())
> (load-module! '(searcher))
#<owner (searcher) 2>
> (call-as-owner (module-owner '(searcher)) (lambda () (jobs:start searcher:count-slowly "reloaded" note! (lambda (ended) (note! (list 'ended ended))))))
#<job count-slowly>
> (timers:sleep 0.1)
> (begin
    (reload-modules! '((searcher)))
    (set! seen (length log))
    (> seen 0))
#t
> (testing:wait-until (lambda () (file-exists? "reloaded")))
> (timers:sleep 0.05)
> (list (= seen (length log)) (exists pair? log))
(#t #f)
; At most 64 of a job's values wait for the main thread: emit waits
; while the main thread is busy, and every value arrives in order.
> (import (progress) (rename (only (chezscheme) sleep) (sleep chez:sleep)))
> (jobs:define-worker (floods n emit) (import (progress)) (do ([i 0 (+ i 1)]) ((= i n)) (emit i) (count!)))
> (define flood '())
> (begin
    (jobs:start floods 1000 (lambda (v) (set! flood (cons v flood))))
    (chez:sleep (make-time 'time-duration 200000000 0))
    (counted))
64
> (testing:wait-until (lambda () (= (length flood) 1000)))
> (equal? (reverse flood) (iota 1000))
#t
